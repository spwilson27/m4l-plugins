// Harmonic Split core (the gen code is cepstrum_lib + spectral_split_lib + spectral_split_rack + THIS file with the rack template
// src/spectral_split_rack_main.genexpr expanded into it at build time, see scripts/spectral_common.py expand_rack_core).
// Reference of the maths: src/harmsplit_config.js (hsFrame).
//
// Three channels: 1 Nonharmonics, 2 Harmonics A, 3 Harmonics B. ONE instance per rack (the leader, see src/spectral_split_rack_main.genexpr)
// runs the analysis on the input once, applies the masks of the three channels and publishes the channel signals in a ring; the other
// instances read their channel from it. A lone instance (outside a rack) computes only its own channel. The per-bin masks of the three
// channels sum to exactly 1, so the chains sum back to the input delayed by the constant latency (5120 samples: 4096 + the host block).
//
// Per hop (n / 4) on the Mid spectrum amplitude (ms, from spectral_split_lib):
//   hs_prep   (tilt weights and cut-filter attenuation per bin cached in hcf, rebuilt only when n / sr / Low / High / Tilt change)
//             dB spectrum (raw, and the ANALYSIS spectrum = raw + Tilt (dB per decade around 1 kHz, +Tilt at 10 kHz) + the soft
//             attenuation of the detection filters: 4th-order high-pass at Low-cut and low-pass at High-cut, -3 dB at the cutoff),
//             compressed 0..1 salience spectrum hc over the 45 dB below the loudest analysis bin; level = loudest attenuated bin;
//             spectral ripple yd = hc minus its +-8 bin mean; band weight bw of every bin (1 down to -3 dB of cut attenuation, 0 at -12 dB).
//             Low-cut / High-cut say WHERE THE EVIDENCE IS (partials inside the band) and where the ROOT must lie (hs_masks).
//   hs_sal    SERIES estimation: which harmonic series explains the in-band partials. Candidate fundamentals on the FIXED grid
//             19.4 Hz * 2^(i/64), i = 0..641, from max(19.4, Low-cut / 32) up to High-cut * sqrt2 (the fundamental may lie BELOW the band:
//             missing / filtered fundamental). Only partials inside the band are evidence (weighted by bw). Full series (spacing g) or odd-only
//             series (square, triangle, clarinet: spacing 2 g); the effective spacing in bins picks the statistic:
//               >= 4.5 bins   peak / valley comb over 10 positions from the lowest in-band harmonic, weights bw / (1 + 0.12 j), score
//                             sum / (sum of weights + 0.8 + 0.6 clip((3 - sum) / 2)); odd-only: odd harmonics of the first 7 positions, valley
//                             an empty even position away (at least 2.5 bins);
//               2.2 .. 4.5    the partials are not resolved but make a spectral RIPPLE of period S: correlation r of the detrended spectrum with
//                             cos(2 pi f / S) over the first 192 weighted in-band bins, score 0.056 r sqrt(sum bw); S gives a full series g = S
//                             (r > 0) and an odd-only series g = S / 2 (r < 0); the winner's spacing is refined in 0.2 % steps;
//               < 2.2 bins    not scored (a ripple aliases onto longer spacings; a full series needs Size 4k below 51 Hz at 48 kHz).
//             The LOWEST local maximum within 78 % of the best is taken (sub-octave check), refined by a parabola over the three neighbours.
//   hs_decide accept (salience >= 0.36, or 0.198 while already tracking; level >= effective threshold) / hold for 8 hops / a new series (first lock or a jump) only after 2 consistent frames.
//             Effective threshold: the Detection Threshold in dB, or AUTOMATIC when it is at its minimum (-120 dB): the running peak
//             level of the analysis (instant attack, 12 dB per second release) minus 40 dB, never below -100 dB.
//   hs_harm   per harmonic h = 1..404 of the SERIES (odd-only: odd h): resolved series: local spectral peak near h*g (running least-squares
//             estimate of g, window max(2 bins, 15 % g) capped at 0.45 spacing), parabolic peak position, prominence over the mean dB half an
//             effective spacing either side; unresolved series: nominal position, louder of the two bins around it, present at >= 4 dB.
//   hs_post   f0 smoothing, voiced amount v (level gate smoothstep((level - thr) / 4 dB), attack 0.6, release 0.35).
//   hs_masks  ROOT = the lowest PRESENT partial of the series (hp 4) with its centre inside [Low-cut, High-cut]; held while present (3 dB lower
//             bar), a lower one replaces it. Pattern numbering h' = h - hr + 1 counts from the root; series partials below it go to
//             Nonharmonics. Harmonic weight hw[h] = smoothstep((prominence - pmE) / wd) * (h' <= Max, 0 = 404) * v, smoothed over hops
//             (attack 0.7, release 0.4); pmE = 14 - 12 sens, wd = 6, both lowered for an unresolved series (down to 0 / 1 at 2 bins). Each
//             weighted harmonic paints a lobe (flat to w0 bins from its centre, raised cosine to w1, w1 = 0.7 + 1.3 s + 0.7 + 0.5 s capped at
//             0.35 effective spacing, 0.5 when unresolved) into A / B by max; B is clipped to 1 - A; mask(NH) = 1 - A - B: exact sum 1.
//             isA: Pattern P >= 2: (h' - 1) mod P == 0; Pattern 1: only the root (h' == 1).
//   Output  outsel 0 = All (mask 1), 1 = Nonharmonics, 2 = Harmonics A, 3 = Harmonics B.
//
// Data hsd(2049, 10) per-bin channels: 0 NH mask, 1 A mask, 2 B mask, 3 sum (= 1), 4 analysis dB (tilt + cut filters), 5 salience spectrum hc, 6 raw dB,
//   7 cut-filter attenuation dB (<= 0), 8 hc ripple (minus its local mean), 9 band weight (prefix sums of hc while hs_prep runs).
// hp(406, 5) per harmonic h of the series: 0 centre Hz, 1 prominence dB, 2 smoothed weight, 3 weight routed to A, 4 present flag.
// hst(32): 0 series f0 (tracked), 1 pending f0, 2 pending count, 3 hold count, 4 voiced v, 5 last used f0, 8 tilted dB max, 9 level dB,
//   10 raw candidate f0, 11 salience, 12 refined f0, 13 f0 the harmonics are searched with, 14 accepted flag,
//   15 found harmonics, 16 active harmonics (hw > 0.5), 17 running peak level, 18 effective threshold dB, 19 running level initialised,
//   20 ROOT frequency (Hz, 0 = none), 21 root harmonic number hr, 22 odd-only flag of the candidate, 23 odd-only flag of the tracked series,
//   24 effective partial spacing (bins), 25..29 the n / sr / Low / High / Tilt the hcf table was built for (0 = not built).
// hcf(2049, 2) per bin: 0 tilt weight in dB (Tilt * log10(f / 1 kHz)), 1 cut-filter attenuation dB (<= 0); see hs_prep.
// sal(710, 5): 0 candidate salience (index i + 1 for candidate i), 1 odd-only flag, 2 / 3 ripple r / -r by spacing index, 4 fine-search scratch.
//
// Telemetry buffer (bound by the face's `scope <name>` message, resent until the deferred gen~ runs), HS_SCOPE_SAMPS floats:
//   0..127 input (Mid) level per log column, 128..255 Nonharmonics post, 256..383 Harmonics A post, 384..511 Harmonics B post
//   (0..1 over -100..0 dB), 512 ROOT frequency (Hz, 0 = none), 513 salience, 514 voiced amount, 515 level dB, 516 active harmonics,
//   517 effective detection threshold dB (the automatic one when Threshold is at -120), 518 series fundamental (Hz, may lie below the band),
//   519 root harmonic number in the series, 520 odd-only series flag  [the arrays and these slots are written by the computing instance only;
//   a sleeping device zeroes slots 0..527],
//   528 frame counter, 529 samplerate, 530 N, 531 awake, 532 input peak, 534 latency, 535 output selection, 536..545 rack scalars (template:
//   computing, following, aligned, fallback, counter offset, underruns, lag, serve mask, role, alive counter): written by every instance.
//   Mix     out = mixamt * wet + (1 - mixamt) * dry * kdry, kdry = 1 (All / no rack) or 1/3 (one of the 3 chains), so the rack
//           sum is mixamt * wet + (1 - mixamt) * dry (dry delayed by the same latency). mixamt = Mix / 100 (template).
//
// GenExpr rules: functions first, then Buffer / Data / Param / History / Delay, then statements. No identifier e<digit>.

hs_sm(x) {
	c = clip(x, 0, 1);
	return c * c * (3 - 2 * c);
}

hs_reset(hst, hp) {
	for (i = 0; i < 32; i += 1) {
		hst.poke(0, i);
	}
	for (h = 0; h < 406; h += 1) {
		hp.poke(0, h, 0);
		hp.poke(0, h, 1);
		hp.poke(0, h, 2);
		hp.poke(0, h, 3);
		hp.poke(0, h, 4);
	}
	return 0;
}

// dB spectra, cut-filter attenuation (hsd 7), the compressed salience spectrum (hsd 5), its local-mean-removed ripple (hsd 8) and the
// band weight of every bin (hsd 9, 1 down to -3 dB of cut attenuation, 0 at -12 dB); level of the analysis (hst 8 / 9).
// tl = Tilt in dB per decade around 1 kHz (+tl at 10 kHz); flo / fhi = detection low / high cut (4th order, -3 dB at the cutoff).
hs_prep(ms, hsd, hst, hcf, n, sr, flo, fhi, tl) {
	half = n * 0.5;
	df = sr / n;
	dbmx = -200;
	lvl = -200;
	inv45 = 1 / 45;
	inv9 = 1 / 9;
	invFhi = 1 / fhi;
	attK = -4.342944819032518;
	// the tilt weight (hcf 0) and the cut-filter attenuation (hcf 1) of every bin depend only on n, sr, Low-cut, High-cut and Tilt: they are
	// rebuilt only when one of those changed since the last hop (hst 25..29 hold the values they were built for, 0 after hs_reset), which
	// removes three of the four log() per bin from every hop of a steady device
	same = (hst.peek(25) == n && hst.peek(26) == sr && hst.peek(27) == flo && hst.peek(28) == fhi && hst.peek(29) == tl) ? 1 : 0;
	if (same < 0.5) {
		for (k = 0; k <= half; k += 1) {
			f = max(k, 0.5) * df;
			ar = flo / f;
			lr = f * invFhi;
			hcf.poke(tl * log(f * 0.001) * 0.4342944819032518, k, 0);
			hcf.poke(attK * (log(1 + ar * ar * ar * ar) + log(1 + lr * lr * lr * lr)), k, 1);
		}
		hst.poke(n, 25);
		hst.poke(sr, 26);
		hst.poke(flo, 27);
		hst.poke(fhi, 28);
		hst.poke(tl, 29);
	}
	for (k = 0; k <= half; k += 1) {
		a = ms.peek(k, 0);
		d = 8.685889638065035 * log(max(a, 1e-9));
		twt = hcf.peek(k, 0);
		att = hcf.peek(k, 1);
		hsd.poke(d, k, 6);
		hsd.poke(d + twt + att, k, 4);
		hsd.poke(att, k, 7);
		if (k >= 1 && k <= half - 1) {
			dbmx = max(dbmx, d + twt + att);
			lvl = max(lvl, d + att);
		}
	}
	for (k = 0; k <= half; k += 1) {
		hsd.poke(clip((hsd.peek(k, 4) - (dbmx - 45)) * inv45, 0, 1), k, 5);
	}
	hsd.poke(0, 0, 5);
	hsd.poke(0, half, 5);
	acc = 0;
	for (k = 0; k <= half; k += 1) {
		acc += hsd.peek(k, 5);
		hsd.poke(acc, k, 9);
	}
	for (k = 0; k <= half; k += 1) {
		a0 = max(k - 8, 0);
		a1 = min(k + 8, half);
		pre = (a0 > 0 ? 1 : 0) * hsd.peek(max(a0 - 1, 0), 9);
		hsd.poke(hsd.peek(k, 5) - (hsd.peek(a1, 9) - pre) / (a1 - a0 + 1), k, 8);
	}
	for (k = 0; k <= half; k += 1) {
		hsd.poke(clip((hsd.peek(k, 7) + 12) * inv9, 0, 1), k, 9);
	}
	hst.poke(dbmx, 8);
	hst.poke(lvl, 9);
	return half;
}

// Series estimation. Candidate series fundamentals on the FIXED grid 19.4 Hz * 2^(i / 64), i = 0..641, from max(19.4, Low / 32) up to
// High * sqrt2 (so the fundamental may lie BELOW the band: missing or filtered fundamental). Only partials inside the band count as evidence,
// weighted by the band weight of their bin (hsd 9). Effective partial spacing (bins) = g for a full series, 2 g for an odd-only one.
//   >= 4.5 bins: peak / valley comb over HS_JPOS = 10 positions from the lowest in-band harmonic (full: valley half a spacing either side;
//                odd-only: harmonics 1, 3, 5, 7 of the in-band run, valley an empty even position away, at least 2.5 bins);
//   2.2 .. 4.5 bins: ripple correlation (inline cos recurrence), score 0.056 * r * sqrt(sum of band weights); spacing S gives a full series g = S (r > 0) AND an
//                odd-only series g = S / 2 (r < 0, peaks half way); coarse grid with three sub-offsets, then a fine spacing search of the winner;
//   below 2.2 bins: not scored (a ripple aliases onto longer spacings; Size 4k resolves a full series down to 51 Hz, 2k down to 26 Hz odd-only).
// Best candidate: the LOWEST local maximum within 78 % of the best (sub-octave check). Results: hst 10 g, 11 salience, 22 odd-only flag.
// sal channels: 0 salience (index i + 1), 1 odd-only flag, 2 ripple r (peaks at multiples of S), 3 ripple -r (index by S), 4 fine search scratch.
hs_sal(hsd, sal, hst, n, sr, flo, fhi) {
	half = n * 0.5;
	df = sr / n;
	invDf = 1 / df;
	twoPiDf = 6.283185307179586 * df;
	ftop = sr * 0.45;
	for (i = 0; i < 710; i += 1) {
		sal.poke(0, i, 0);
		sal.poke(0, i, 1);
		sal.poke(0, i, 2);
		sal.poke(0, i, 3);
		sal.poke(0, i, 4);
	}
	gmin = max(19.4, flo / 32);
	kst = -1;
	kend = -1;
	for (k = 2; k <= half - 3; k += 1) {
		bwk = hsd.peek(k, 9);
		kst = (kst < 0 && bwk > 0) ? k : kst;
		kend = bwk > 0 ? k : kend;
	}
	kend = min(kend, kst + 191);
	sw = 0;
	sy = 0;
	for (k = max(kst, 0); k <= kend; k += 1) {
		bwk = hsd.peek(k, 9);
		yk = hsd.peek(k, 8);
		sw += bwk;
		sy += bwk * yk * yk;
	}
	cosOk = (flo < fhi && kst >= 0 && sw >= 8) ? 1 : 0;
	sq = sqrt(sw);
	angBase = 6.283185307179586 * kst * df;
	// ripple correlation r of the detrended spectrum (hsd 8, weights hsd 9) with cos(2 pi f / S), bins kst..kend (cos by recurrence),
	// three sub-offsets of every spacing S = 19.4 * 2^(i / 64) with 2.2 <= S / df < 4.5; ch 2 = max r, ch 3 = max -r over the offsets
	for (idx = 0; idx < 706; idx += 1) {
		ss = 19.4 * pow(2, idx / 64);
		pers = ss * invDf;
		doit = (cosOk > 0.5 && pers >= 2.2 && pers < 4.5) ? 1 : 0;
		if (doit > 0.5) {
			for (o = 0; o < 3; o += 1) {
				sq1 = ss * (1 + (o - 1) * 0.0038);
				da = twoPiDf / sq1;
				ang = angBase / sq1;
				cc = cos(ang);
				sn = sin(ang);
				cd = cos(da);
				sd = sin(da);
				sxy = 0;
				sxx = 0;
				for (k = max(kst, 0); k <= kend; k += 1) {
					wgt = hsd.peek(k, 9);
					sxy += wgt * hsd.peek(k, 8) * cc;
					sxx += wgt * cc * cc;
					cnw = cc * cd - sn * sd;
					sn = sn * cd + cc * sd;
					cc = cnw;
				}
				ro = sxy / sqrt(sxx * sy + 1e-12);
				rp0 = sal.peek(idx, 2);
				rn0 = sal.peek(idx, 3);
				sal.poke(o < 0.5 ? ro : max(rp0, ro), idx, 2);
				sal.poke(o < 0.5 ? 0 - ro : max(rn0, 0 - ro), idx, 3);
			}
		}
	}
	smax = 0;
	for (i = 0; i < 642; i += 1) {
		g = 19.4 * pow(2, i / 64);
		act = (flo < fhi && g >= gmin && g <= fhi * 1.4142 && g <= ftop) ? 1 : 0;
		perf = g * invDf;
		pero = 2 * g * invDf;
		svf = 0;
		svo = 0;
		h0 = max(1, 0 - floor(0 - 0.51 * flo / g));
		vodd = min(g, max(0.5 * g, 2.5 * df));
		ssum = 0;
		wt = 0;
		cn = 0;
		osum = 0;
		owt = 0;
		pvOn = (act > 0.5 && pero >= 4.5) ? 1 : 0;
		if (pvOn > 0.5) {
			for (j = 0; j < 10; j += 1) {
				hh = h0 + j;
				fp = hh * g;
				kc = clip(floor(fp * invDf + 0.5), 1, half - 1);
				bwp = (pvOn > 0.5 && fp <= ftop) ? hsd.peek(kc, 9) : 0;
				if (bwp > 0) {
					pk = max(hsd.peek(kc - 1, 5), max(hsd.peek(kc, 5), hsd.peek(kc + 1, 5)));
					kv = clip(floor((hh - 0.5) * g * invDf + 0.5), 1, half - 1);
					ku = clip(floor((hh + 0.5) * g * invDf + 0.5), 1, half - 1);
					term = max(pk - max(hsd.peek(kv, 5), hsd.peek(ku, 5)), 0);
					w = bwp / (1 + 0.12 * j);
					ssum += w * term;
					wt += w;
					cn += 1;
					isod = (j <= 6 && (hh - 2 * floor(hh / 2)) > 0.5) ? 1 : 0;
					kv2 = clip(floor((fp - vodd) * invDf + 0.5), 1, half - 1);
					ku2 = clip(floor((fp + vodd) * invDf + 0.5), 1, half - 1);
					term2 = max(pk - max(hsd.peek(kv2, 5), hsd.peek(ku2, 5)), 0);
					osum += isod * w * term2;
					owt += isod * w;
				}
			}
		}
		sfull = cn > 0.5 ? ssum / (wt + 0.8 + 0.6 * clip((3 - wt) / 2, 0, 1)) : 0;
		sodd = owt > 0 ? osum / (owt + 0.8 + 0.6 * clip((3 - owt) / 2, 0, 1)) : 0;
		svo = pvOn > 0.5 ? sodd : 0;
		svf = (pvOn > 0.5 && perf >= 4.5) ? sfull : 0;
		svf = (act > 0.5 && cosOk > 0.5 && perf >= 2.2 && perf < 4.5) ? max(0.056 * sal.peek(i, 2) * sq, 0) : svf;
		svo = (act > 0.5 && cosOk > 0.5 && pero >= 2.2 && pero < 4.5) ? max(0.056 * sal.peek(i + 64, 3) * sq, 0) : svo;
		sv = max(svf, svo);
		sal.poke(sv, i + 1, 0);
		sal.poke(svo > svf ? 1 : 0, i + 1, 1);
		smax = max(smax, sv);
	}
	bi = 0;
	fnd = 0;
	for (i = 1; i <= 642; i += 1) {
		svq = sal.peek(i, 0);
		cnd = (fnd < 0.5 && smax > 0 && svq >= 0.78 * smax && svq >= sal.peek(i - 1, 0) && svq >= sal.peek(i + 1, 0)) ? 1 : 0;
		bi = cnd > 0.5 ? i : bi;
		fnd = cnd > 0.5 ? 1 : fnd;
	}
	sa = sal.peek(max(bi - 1, 0), 0);
	sb = sal.peek(bi, 0);
	sc = sal.peek(bi + 1, 0);
	dd = sa - 2 * sb + sc;
	dl = dd < -1e-12 ? clip(0.5 * (sa - sc) / dd, -0.5, 0.5) : 0;
	g0 = fnd > 0.5 ? 19.4 * pow(2, (bi - 1 + dl) / 64) : 0;
	conf0 = fnd > 0.5 ? sb : 0;
	flag0 = fnd > 0.5 ? sal.peek(bi, 1) : 0;
	perw = g0 * (flag0 > 0.5 ? 2 : 1) * invDf;
	dofine = (fnd > 0.5 && cosOk > 0.5 && perw >= 2.2 && perw < 4.5) ? 1 : 0;
	s0 = g0 * (flag0 > 0.5 ? 2 : 1);
	sgn = flag0 > 0.5 ? -1 : 1;
	for (m = 0; m < 11; m += 1) {
		sq2 = s0 * (1 + (m - 5) * 0.002);
		da = twoPiDf / sq2;
		ang = angBase / sq2;
		cc = cos(ang);
		sn = sin(ang);
		cd = cos(da);
		sd = sin(da);
		sxy = 0;
		sxx = 0;
		kq = dofine > 0.5 ? kend : -1;
		for (k = max(kst, 0); k <= kq; k += 1) {
			wgt = hsd.peek(k, 9);
			sxy += wgt * hsd.peek(k, 8) * cc;
			sxx += wgt * cc * cc;
			cnw = cc * cd - sn * sd;
			sn = sn * cd + cc * sd;
			cc = cnw;
		}
		rm = dofine > 0.5 ? sgn * sxy / sqrt(sxx * sy + 1e-12) : 0;
		sal.poke(rm, m, 4);
	}
	bm = 0;
	bvr = -9;
	for (m = 0; m < 11; m += 1) {
		rm = sal.peek(m, 4);
		bm = (dofine > 0.5 && rm > bvr) ? m : bm;
		bvr = dofine > 0.5 ? max(bvr, rm) : bvr;
	}
	ra = sal.peek(max(bm - 1, 0), 4);
	rb = sal.peek(min(bm + 1, 10), 4);
	dd3 = ra - 2 * bvr + rb;
	dl3 = (bm > 0 && bm < 10 && dd3 < -1e-12) ? clip(0.5 * (ra - rb) / dd3, -0.5, 0.5) : 0;
	g0 = dofine > 0.5 ? s0 * (1 + (bm - 5 + dl3) * 0.002) / (flag0 > 0.5 ? 2 : 1) : g0;
	conf0 = dofine > 0.5 ? max(conf0, max(0.056 * bvr * sq, 0)) : conf0;
	flag0 = (flag0 > 0.5 && g0 * invDf < 4.5) ? 1 : 0;
	hst.poke(g0, 10);
	hst.poke(conf0, 11);
	hst.poke(flag0, 22);
	return g0;
}

// Accept / hold / jump logic of the series fundamental; hst 13 = the f0 the harmonics are searched with (0 = none), hst 23 = odd-only flag
// of the tracked series, hst 21 = root harmonic (reset when the series is new or lost).
hs_decide(hst, thr, c0, dec) {
	f0c = hst.peek(0);
	pend = hst.peek(1);
	pcn = hst.peek(2);
	hold = hst.peek(3);
	g0 = hst.peek(10);
	conf = hst.peek(11);
	flag0 = hst.peek(22);
	hodd = hst.peek(23);
	hrk = hst.peek(21);
	lvl = hst.peek(9);
	lm = hst.peek(19) > 0.5 ? max(lvl, hst.peek(17) - dec) : lvl;
	te = thr < -119.5 ? max(lm - 40, -100) : thr;
	hst.poke(lm, 17);
	hst.poke(te, 18);
	hst.poke(1, 19);
	c0e = f0c > 0 ? c0 * 0.55 : c0;
	okf = (conf >= c0e && lvl >= te && g0 > 0) ? 1 : 0;
	gs = f0c;
	rj = f0c > 0 ? abs(log(max(g0, 1) / f0c)) * 1.4426950408889634 : 0;
	rp = pend > 0 ? abs(log(max(g0, 1) / pend)) * 1.4426950408889634 : 9;
	if (okf > 0.5) {
		hold = 0;
		if (f0c <= 0) {
			pcn = rp < 0.05 ? pcn + 1 : 1;
			pend = g0;
			if (pcn >= 2) {
				f0c = g0;
				gs = g0;
				pcn = 0;
				hodd = flag0;
				hrk = 0;
			}
		} else if (rj < 0.05) {
			gs = g0;
			pcn = 0;
			hodd = flag0;
		} else {
			pcn = rp < 0.05 ? pcn + 1 : 1;
			pend = g0;
			if (pcn >= 2) {
				f0c = g0;
				gs = g0;
				pcn = 0;
				hodd = flag0;
				hrk = 0;
			}
		}
	} else {
		hold += 1;
		if (f0c <= 0) {
			pcn = 0;
			pend = 0;
		}
		if (hold > 8) {
			f0c = 0;
			gs = 0;
			pcn = 0;
			hrk = 0;
		}
	}
	hst.poke(f0c, 0);
	hst.poke(pend, 1);
	hst.poke(pcn, 2);
	hst.poke(hold, 3);
	hst.poke(gs, 13);
	hst.poke(okf, 14);
	hst.poke(hodd, 23);
	hst.poke(hrk, 21);
	return gs;
}

// Per harmonic h of the SERIES (odd-only: odd h only): spectral peak near h * g, centre in hp 0, prominence in hp 1, presence flag in hp 4.
// Resolved series (effective spacing >= 4.5 bins): running least-squares g, window max(2 bins, 15 % g) capped at 0.45 spacing, valley half an
// effective spacing either side. Unresolved series: nominal positions h * g (g from the ripple search), level = louder of the two bins
// around the position, same valley rule, present at >= 4 dB (the Hann leakage of neighbours 1.4 bins away limits the contrast to 5..15 dB).
hs_harm(hsd, hp, hst, n, sr) {
	half = n * 0.5;
	df = sr / n;
	invDf = 1 / df;
	gs = hst.peek(13);
	hodd = hst.peek(23);
	seff = gs * (hodd > 0.5 ? 2 : 1) * invDf;
	narrow = (gs > 0 && seff < 4.5) ? 1 : 0;
	hst.poke(seff, 24);
	gest = gs;
	num = 0.5 * gs;
	den = 0.5;
	nfd = 0;
	hs2 = 0.5 * seff * df;
	fLim = (half - 3) * df;
	df2 = 2 * df;
	for (h = 1; h <= 404; h += 1) {
		fp = h * gest;
		cen = fp;
		prom = 0;
		prs = 0;
		wn = 0;
		k0 = 2;
		k1 = 2;
		kp = 2;
		bv = -200;
		okp = 0;
		skip = (hodd > 0.5 && (h - 2 * floor(h / 2)) < 0.5) ? 1 : 0;
		if (gs > 0 && fp < fLim && skip < 0.5) {
			if (narrow > 0.5) {
				kk = clip(floor(fp * invDf), 1, half - 2);
				pkd = max(hsd.peek(kk, 6), hsd.peek(kk + 1, 6));
				vl3 = hsd.peek(clip(floor((fp - hs2) * invDf + 0.5), 1, half - 1), 6);
				vr3 = hsd.peek(clip(floor((fp + hs2) * invDf + 0.5), 1, half - 1), 6);
				prom = pkd - 0.5 * (vl3 + vr3);
				prs = prom >= 4 ? 1 : 0;
			} else {
				wn = max(df2, 0.15 * gest);
				wn = max(df, min(wn, 0.45 * seff * df));
				k0 = max(floor((fp - wn) * invDf), 2);
				k1 = min(floor((fp + wn) * invDf) + 1, half - 2);
				kp = k0;
				bv = hsd.peek(k0, 6);
				for (k = k0 + 1; k <= k1; k += 1) {
					v = hsd.peek(k, 6);
					if (v > bv) {
						bv = v;
						kp = k;
					}
				}
				pa = hsd.peek(kp - 1, 6);
				pc = hsd.peek(kp + 1, 6);
				okp = (bv >= pa && bv >= pc && kp > k0 && kp < k1) ? 1 : 0;
				dd = pa - 2 * bv + pc;
				dl = dd < -1e-9 ? clip(0.5 * (pa - pc) / dd, -0.5, 0.5) : 0;
				vl = hsd.peek(clip(floor((fp - hs2) * invDf + 0.5), 1, half - 1), 6);
				vr = hsd.peek(clip(floor((fp + hs2) * invDf + 0.5), 1, half - 1), 6);
				prom = okp > 0.5 ? bv - 0.5 * (vl + vr) : 0;
				cen = okp > 0.5 ? (kp + dl) * df : fp;
				prs = (okp > 0.5 && prom >= 10) ? 1 : 0;
				if (okp > 0.5 && prom >= 10) {
					num += h * cen;
					den += h * h;
					gest = num / den;
					nfd += 1;
				}
			}
		}
		oldc = hp.peek(h, 0);
		moved = (oldc > 30 && cen > 30 && abs(log(cen / oldc)) * 1.4426950408889634 > 0.5) ? 1 : 0;
		hp.poke(cen, h, 0);
		hp.poke(prom, h, 1);
		hp.poke(prs, h, 4);
		if (moved > 0.5) {
			hp.poke(0, h, 2);
			hp.poke(0, h, 3);
		}
	}
	hst.poke(gest, 12);
	hst.poke(nfd, 15);
	return gest;
}

// f0 smoothing, voiced amount, last used f0.
hs_post(hst) {
	f0c = hst.peek(0);
	gr = hst.peek(12);
	gs = hst.peek(13);
	okf = hst.peek(14);
	nfd = hst.peek(15);
	lvl = hst.peek(9);
	thr = hst.peek(18);
	if (gs > 0 && f0c > 0 && (okf > 0.5 || nfd >= 3)) {
		rr = abs(log(gr / f0c)) * 1.4426950408889634;
		f0c = rr < 0.05 ? f0c + (gr - f0c) * 0.6 : gr;
	}
	gl = hs_sm((lvl - thr) / 4);
	vt = f0c > 0 ? gl : 0;
	v = hst.peek(4);
	v = v + (vt - v) * (vt > v ? 0.6 : 0.35);
	hst.poke(f0c, 0);
	hst.poke(v, 4);
	if (gs > 0) {
		hst.poke(gr, 5);
	}
	return v;
}

// Root, harmonic weights (smoothed over hops) and the three per-bin masks.
// ROOT = the lowest PRESENT partial of the series (hp 4) whose centre lies inside [Low-cut, High-cut]; kept while it stays present (3 dB lower bar),
// replaced at once by a lower one. Pattern numbering h' = h - hr + 1 counts from the root; series partials below the root go to Nonharmonics.
// Weights: smoothstep((prominence - pmE) / wd) * v; unresolved series lower pmE / narrow wd (down to 0 / 1 dB at 2.2 bins).
// Masks: every weighted harmonic paints a lobe (flat to w0 bins from its centre, raised cosine to w1, w1 <= 0.5 effective spacing when unresolved)
// into A / B by max; B is clipped to 1 - A; Nonharmonics = 1 - A - B (exact sum 1).
hs_masks(hsd, hp, hst, n, sr, sens, hpat, hmx, flo, fhi) {
	half = n * 0.5;
	df = sr / n;
	invDf = 1 / df;
	gs = hst.peek(13);
	gu = gs > 0 ? hst.peek(12) : hst.peek(5);
	hodd = hst.peek(23);
	seff = hst.peek(24);
	narrow = (gs > 0 && seff < 4.5) ? 1 : 0;
	hrk = hst.peek(21);
	v = hst.peek(4);
	pmin = 14 - 12 * sens;
	rf = clip((seff - 2) / 4, 0, 1);
	pme = narrow > 0.5 ? pmin * rf : pmin;
	wd = narrow > 0.5 ? 1 + 5 * rf : 6;
	invWd = 1 / wd;
	pat = max(hpat, 1);
	pr3 = narrow > 0.5 ? 2.5 : 7;
	hnew = 0;
	hhold = 0;
	for (h = 404; h >= 1; h -= 1) {
		cenh = hp.peek(h, 0);
		inb = (gs > 0 && flo < fhi && cenh >= flo && cenh <= fhi) ? 1 : 0;
		okn = (inb > 0.5 && hp.peek(h, 4) > 0.5) ? 1 : 0;
		hnew = okn > 0.5 ? h : hnew;
		okh = (inb > 0.5 && h == hrk && hp.peek(h, 1) >= pr3 && cenh > 0) ? 1 : 0;
		hhold = okh > 0.5 ? h : hhold;
	}
	hr = hhold > 0 ? (hnew > 0 ? min(hnew, hhold) : hhold) : hnew;
	hst.poke(hr, 21);
	hst.poke(hr > 0 ? hr * gu : 0, 20);
	nact = 0;
	for (h = 1; h <= 404; h += 1) {
		cen = hp.peek(h, 0);
		prom = hp.peek(h, 1);
		hpn = h - hr + 1;
		tw = (gs > 0 && hr > 0 && h >= hr && hpn <= hmx && cen > 0) ? hs_sm((prom - pme) * invWd) * v : 0;
		prev = hp.peek(h, 2);
		cur = prev + (tw - prev) * (tw > prev ? 0.7 : 0.4);
		isA = hpn < 1 ? 0 : (pat < 1.5 ? (hpn < 1.5 ? 1 : 0) : (((hpn - 1) - pat * floor((hpn - 1) / pat)) < 0.5 ? 1 : 0));
		hp.poke(cur, h, 2);
		hp.poke(isA > 0.5 ? cur : 0, h, 3);
		nact += cur > 0.5 ? 1 : 0;
	}
	spe = max(gu * (hodd > 0.5 ? 2 : 1) * invDf, 0.001);
	frl = 0.35 + 0.15 * clip((5 - spe) / 2.2, 0, 1);
	w1c = max(frl * spe, 0.6);
	w1 = min(0.7 + 1.3 * sens + 0.7 + 0.5 * sens, w1c);
	w0 = min(0.7 + 1.3 * sens, w1 - 0.3);
	invLobe = 1 / (w1 - w0);
	for (k = 0; k <= half; k += 1) {
		hsd.poke(0, k, 1);
		hsd.poke(0, k, 2);
	}
	for (h = 1; h <= 404; h += 1) {
		cur2 = hp.peek(h, 2);
		cb = hp.peek(h, 0) * invDf;
		paint = (cur2 > 0 && cb > 0 && gu > 0) ? 1 : 0;
		wa = hp.peek(h, 3);
		wb = cur2 - wa;
		kl = paint > 0.5 ? max(floor(cb - w1), 0) : 1;
		kh = paint > 0.5 ? min(0 - floor(0 - cb - w1), half) : 0;
		for (k = kl; k <= kh; k += 1) {
			dist = abs(k - cb);
			m = dist <= w0 ? 1 : (dist >= w1 ? 0 : 0.5 * (1 + cos(3.141592653589793 * (dist - w0) * invLobe)));
			hsd.poke(max(hsd.peek(k, 1), m * wa), k, 1);
			hsd.poke(max(hsd.peek(k, 2), m * wb), k, 2);
		}
	}
	for (k = 0; k <= half; k += 1) {
		ma = hsd.peek(k, 1);
		mb = min(hsd.peek(k, 2), 1 - ma);
		hsd.poke(1 - ma - mb, k, 0);
		hsd.poke(mb, k, 2);
		hsd.poke(1, k, 3);
	}
	hst.poke(nact, 16);
	return nact;
}

//@SS_DECL

Buffer scope("harmsplitscope");

Data hsd(2049, 10);
Data hp(406, 5);
Data hst(32);
Data sal(710, 5);
Data hcf(2049, 2);

Param hpat(2);
Param hmaxp(64);
Param sensamt(0.5);
Param tiltamt(0);
Param thrdb(-60);
Param flocut(30);
Param fhicut(12000);

History patH(2);
History mxH(64);
History snH(0.5);
History tlH(0);
History thH(-60);
History loH(30);
History hiH(12000);

//@hook ctl
patH = clip(round(hpat), 1, 24);
mxH = hmaxp < 0.5 ? 404 : clip(round(hmaxp), 1, 404);
snH = clip(sensamt, 0, 1);
tlH = clip(tiltamt, -12, 12);
thH = clip(thrdb, -120, 0);
loH = clip(flocut, 19.4, 19900);
hiH = clip(fhicut, 19.4, 19900);
sumOneH = 1;
//@endhook

//@hook frame
if (sAge < 0.5) {
	hs_reset(hst, hp);
}
hs_prep(ms, hsd, hst, hcf, n, sr, loH, hiH, tlH);
hs_sal(hsd, sal, hst, n, sr, loH, hiH);
hs_decide(hst, thH, 0.36, 3 * n / sr);
hs_harm(hsd, hp, hst, n, sr);
hs_post(hst);
hs_masks(hsd, hp, hst, n, sr, snH, patH, mxH, loH, hiH);
//@endhook

//@hook tele
ss_cols(ms, 0, hsd, -1, cols, 0, n, sr, 128, 30, 20000);
ss_cols(ms, 0, hsd, 0, cols, 1, n, sr, 128, 30, 20000);
ss_cols(ms, 0, hsd, 1, cols, 2, n, sr, 128, 30, 20000);
ss_cols(ms, 0, hsd, 2, cols, 3, n, sr, 128, 30, 20000);
ss_tele(cols, scope, 128, 4, 0);
tf0 = hst.peek(20);
tfs = hst.peek(0);
thr0 = hst.peek(21);
tod = hst.peek(23);
tsal = hst.peek(11);
tv = hst.peek(4);
tlv = hst.peek(9);
tnact = hst.peek(16);
tte = hst.peek(18);
poke(scope, tf0, 512, 0);
poke(scope, tsal, 513, 0);
poke(scope, tv, 514, 0);
poke(scope, tlv, 515, 0);
poke(scope, tnact, 516, 0);
poke(scope, tte, 517, 0);
poke(scope, tfs, 518, 0);
poke(scope, thr0, 519, 0);
poke(scope, tod, 520, 0);
//@endhook

//@SS_MAIN
