// Reciprocator — Reciprocal envelope follower & audio-rate dynamics/waveshaper.
// Multiplies the lookahead-delayed input by env^(-amount) * gate so quiet tails
// and textures jump to full ceiling while silence below Gate is cleanly muted
// (or, when Reverse Gate `revgate` is enabled, only quiet signals below Gate
// pass through while loud hits are muted).
//
// CPU Optimizations:
//   - Subnormal/denormal flush (`abs(s) < 1e-15 ? 0 : s`) inside filter & detector
//     History loops so decaying tails never hit subnormal IEEE-754 float penalties.
//   - Fast-path silence bypass: when the input and envelope are silent (or the gate
//     is completely closed), skips `pow(env, -amount)` and `tanh()` waveshaping.
//   - Fast reciprocal path at the default `Amount = 100%` (`1.0 / safeEnv` instead
//     of transcendental `pow()`).
//
// Scope telemetry buffer (buffer~ #0-recipscope, bound via `scope #0-recipscope`):
//   0: input peak (0..1)
//   1: post-detector envelope (0..1)
//   2: gate open state (0..1)
//   3: applied gain normalized (0..1 where 0.25 = 0 dB, 1.0 = +60 dB)
//   4: wet output peak (0..1)
//   5: current gate threshold linear (0..1)
//   6: current ceiling linear (0..1)
//   7: rolling frame counter
//
// GenExpr requires all functions before Buffer/Param/History/Delay declarations,
// and all declarations before expression statements. No variable is named e<digit>.

slew(target, coef) {
	History s(0);
	History init(0);
	s = (init == 0) ? target : mix(target, s, coef);
	init = 1;
	return s;
}

onepole_lp(x, coef) {
	History s(0);
	nxt = mix(x, s, coef);
	s = (abs(nxt) < 1e-15) ? 0 : nxt;
	return s;
}

onepole_hp(x, coef) {
	History s(0);
	nxt = mix(x, s, coef);
	s = (abs(nxt) < 1e-15) ? 0 : nxt;
	return x - s;
}

// Combined Peak + RMS detector with independent attack and release coefficients
// and denormal protection when audio stops.
env_detect(x, atkCoef, relCoef, detectBlend) {
	History pk(0);
	History ms(0);
	ax = abs(x);
	cPk = (ax > pk) ? atkCoef : relCoef;
	nxtPk = mix(ax, pk, cPk);
	pk = (nxtPk < 1e-15) ? 0 : nxtPk;
	x2 = x * x;
	cMs = (x2 > ms) ? atkCoef : relCoef;
	nxtMs = mix(x2, ms, cMs);
	ms = (nxtMs < 1e-24) ? 0 : nxtMs;
	rms = (detectBlend > 0.001) ? sqrt(max(ms, 0)) : pk;
	return mix(pk, rms, clip(detectBlend, 0, 1));
}

// Smooth normal or reverse gate with a 6 dB cubic knee around gateLin.
gate_smooth(envVal, gateLin, relCoef, revMode) {
	History gState(0);
	g = max(gateLin, 0.00001);
	lo = g * 0.5;
	hi = g * 1.41421356;
	t = clip((envVal - lo) / max(hi - lo, 0.00001), 0, 1);
	normalRaw = t * t * (3 - 2 * t);

	// Floor guard for Reverse Gate so pure digital silence does not get boosted to 0 dBFS.
	sLo = 0.00002;
	sHi = max(min(lo * 0.5, 0.00025), 0.00005);
	tf = clip((envVal - sLo) / max(sHi - sLo, 0.00001), 0, 1);
	floorGuard = tf * tf * (3 - 2 * tf);

	revRaw = (1.0 - normalRaw) * floorGuard;
	raw = (revMode > 0.5) ? revRaw : normalRaw;

	c = (raw > gState) ? 0.25 : clip(relCoef, 0.5, 0.9995);
	nxtG = mix(raw, gState, c);
	gState = (nxtG < 1e-9) ? 0 : nxtG;
	return gState;
}

// Output stage (`outmode`):
//   0 = Soft (`tanh` soft saturation to ceilLin)
//   1 = Hard (`clip` to [-ceilLin, +ceilLin])
//   2 = Lim  (Instant-attack, smooth-release peak limiter to ceilLin, preserving waveform shape)
// Skips `tanh()` when the signal is silent or when Hard/Limiter mode is selected.
limit_out(x, ceilLin, outMode) {
	History limEnv(0);
	c = max(ceilLin, 0.05);
	ax = abs(x);
	nxtLim = (ax > limEnv) ? ax : mix(ax, limEnv, 0.9985);
	limEnv = (nxtLim < 1e-12) ? 0 : nxtLim;
	if (ax < 1e-9) {
		return 0;
	}
	if (outMode < 0.5) {
		return c * tanh(x / c);
	}
	if (outMode < 1.5) {
		return clip(x, -c, c);
	}
	limGain = c / max(limEnv, c);
	return clip(x * limGain, -c, c);
}

// Fast reciprocal helper: uses direct 1/x division when amount is at 100% (1.0)
// or 1.0 when amount is 0%, avoiding costly pow() calls in the two most common cases.
recip_pow(safeEnv, amt) {
	if (amt < 0.0005) {
		return 1.0;
	}
	if (abs(amt - 1.0) < 0.0005) {
		return 1.0 / safeEnv;
	}
	return pow(safeEnv, -amt);
}

Buffer scope("recipscope");

Param amount(1.0);
Param gate(-42.0);
Param attack(1.5);
Param release(60.0);
Param wet(1.0);
Param ceiling(-1.0);
Param lookahead(1.5);
Param detect(0.25);
Param schp(60.0);
Param sclp(12000.0);
Param outmode(0.0);
Param revgate(0.0);

History tick(0);
History rollCounter(0);
History peakInHold(0);
History peakEnvHold(0);
History peakOutHold(0);
History idleTicks(0);

Delay lookL(1024);
Delay lookR(1024);

sr = max(samplerate, 1);

amountS = slew(clip(amount, 0, 1.5), 0.999);
gateDbS = slew(clip(gate, -72, -6), 0.999);
atkMsS = slew(clip(attack, 0.05, 250), 0.999);
relMsS = slew(clip(release, 0.5, 1500), 0.999);
wetS = slew(clip(wet, 0, 1), 0.999);
ceilDbS = slew(clip(ceiling, -18, 0), 0.999);
lookMsS = slew(clip(lookahead, 0, 10), 0.999);
detectS = slew(clip(detect, 0, 1), 0.999);
hpHzS = slew(clip(schp, 20, 2000), 0.999);
lpHzS = slew(clip(sclp, 400, 18000), 0.999);
outMode = clip(outmode, 0, 2);
revMode = clip(revgate, 0, 1);

// 1. Write raw stereo input into lookahead delay lines (used for both wet VCA and phase-aligned dry).
lookSamps = clip(lookMsS * sr / 1000, 0, 960);
lookL.write(in1);
lookR.write(in2);
delInL = lookL.read(lookSamps, interp="linear");
delInR = lookR.read(lookSamps, interp="linear");

// 2. Sidechain filter conditioning on the undelayed input so detection leads the delayed audio.
hpCoef = exp(-6.28318530718 * hpHzS / sr);
lpCoef = exp(-6.28318530718 * lpHzS / sr);
scL = onepole_lp(onepole_hp(in1, hpCoef), lpCoef);
scR = onepole_lp(onepole_hp(in2, hpCoef), lpCoef);

// 3. Envelope detection with sub-millisecond to 1.5 s ballistics.
atkCoef = exp(-1000 / (max(atkMsS, 0.05) * sr));
relCoef = exp(-1000 / (max(relMsS, 0.5) * sr));
detL = env_detect(scL, atkCoef, relCoef, detectS);
detR = env_detect(scR, atkCoef, relCoef, detectS);

linkedEnv = max(detL, detR);
linkAmt = 0.35 + 0.65 * detectS;
envL = mix(detL, linkedEnv, linkAmt);
envR = mix(detR, linkedEnv, linkAmt);
envMax = max(envL, envR);

// 4. Gate & Reciprocal gain calculation (with fast-path skip when gate is closed or input is silent).
gateLin = pow(10, gateDbS / 20);
ceilLin = pow(10, ceilDbS / 20);

gateL = gate_smooth(envL, gateLin, relCoef, revMode);
gateR = gate_smooth(envR, gateLin, relCoef, revMode);

gateMix = (revMode > 0.5) ? 1.0 : clip(amountS * 4.0, 0, 1);
effGateL = mix(1.0, gateL, gateMix);
effGateR = mix(1.0, gateR, gateMix);

inAbs = max(abs(delInL), abs(delInR));
isSilent = (inAbs < 1e-8 && envMax < 1e-8) || (effGateL < 1e-7 && effGateR < 1e-7);

gainL = 0;
gainR = 0;
if (isSilent == 0) {
	floorEnv = (revMode > 0.5) ? 0.00005 : max(gateLin * 0.5, 0.00001);
	safeL = max(envL, floorEnv);
	safeR = max(envR, floorEnv);
	overAmt = max(amountS - 1.0, 0.0);
	targetScale = pow(ceilLin, min(amountS, 1.0)) * ((overAmt > 0.0005) ? pow(0.05, overAmt) : 1.0);
	rawGainL = min(recip_pow(safeL, amountS) * targetScale, 1000.0);
	rawGainR = min(recip_pow(safeR, amountS) * targetScale, 1000.0);
	gainL = rawGainL * effGateL;
	gainR = rawGainR * effGateR;
}

// 5. Multiply lookahead-delayed signal by reciprocal gain and apply Soft / Hard / Limiter ceiling.
vcaL = delInL * gainL;
vcaR = delInR * gainR;
wetL = limit_out(vcaL, ceilLin, outMode);
wetR = limit_out(vcaR, ceilLin, outMode);

// 6. Equal-power dry/wet mix (using lookahead-aligned dry signal so parallel blend never comb-filters).
ang = wetS * 1.57079632679;
dryG = cos(ang);
wetG = sin(ang);
outL = delInL * dryG + wetL * wetG;
outR = delInR * dryG + wetR * wetG;

// 7. Update scope telemetry buffer every 64 samples, skipping buffer pokes once the device has settled in silence.
outAbs = max(abs(wetL), abs(wetR));
peakInHold = max(peakInHold, inAbs);
peakEnvHold = max(peakEnvHold, envMax);
peakOutHold = max(peakOutHold, outAbs);

tick = wrap(tick + 1, 0, 64);
if (tick == 0) {
	windowSilent = (peakInHold < 1e-6 && peakEnvHold < 1e-6 && peakOutHold < 1e-6);
	idleTicks = windowSilent ? min(idleTicks + 1, 1000) : 0;
	if (idleTicks <= 4) {
		gainAvg = 0.5 * (gainL + gainR);
		gainDbNorm = clip((20 * log10(max(gainAvg, 0.001)) + 20) / 80, 0, 1);
		rollCounter = wrap(rollCounter + 1, 0, 100000);
		poke(scope, clip(peakInHold, 0, 1.5), 0, 0);
		poke(scope, clip(peakEnvHold, 0, 1.5), 1, 0);
		poke(scope, clip(max(gateL, gateR), 0, 1), 2, 0);
		poke(scope, gainDbNorm, 3, 0);
		poke(scope, clip(peakOutHold, 0, 1.5), 4, 0);
		poke(scope, clip(gateLin, 0, 1), 5, 0);
		poke(scope, clip(ceilLin, 0, 1), 6, 0);
		poke(scope, rollCounter, 7, 0);
	}
	peakInHold = 0;
	peakEnvHold = 0;
	peakOutHold = 0;
}

out1 = fixnan(outL);
out2 = fixnan(outR);
