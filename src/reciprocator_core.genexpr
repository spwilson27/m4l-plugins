// Reciprocator — Reciprocal envelope follower & audio-rate dynamics/waveshaper.
// Multiplies the lookahead-delayed input by env^(-amount) * gate so quiet tails
// and textures jump to full ceiling while silence below Gate is cleanly muted
// (or, when Reverse Gate `revgate` is enabled, only quiet signals below Gate
// pass through while loud hits are muted).
//
// CPU Optimizations:
//   - Subnormal/denormal flush (`abs(s) < 1e-15 ? 0 : s`) inside filter & detector
//     History loops so decaying tails never hit subnormal IEEE-754 float penalties.
//   - Fast-path silence bypass: when the input and envelope are silent (or the gate
//     is completely closed), skips `pow(env, -amount)` and `tanh()` waveshaping.
//   - Fast reciprocal path at the default `Amount = 100%` (`1.0 / safeEnv` instead
//     of transcendental `pow()`).
//   - Control-rate coefficient cache: HP/LP, attack/release, gate/ceiling (and
//     invCeil), lookahead samples, equal-power dry/wet, and the ceiling scale are
//     recomputed only when that Param or samplerate changes.
//   - Soft-clip uses the cached reciprocal `invCeil` (one multiply per channel)
//     instead of dividing by the ceiling on L and R every sample.
//   - `log10` for the gain telemetry runs once per 64-sample scope write, not
//     once per sample.
//
// Scope telemetry buffer (buffer~ ---recipscope, bound via `scope ---recipscope`):
//   0: input peak (0..1)
//   1: post-detector envelope (0..1)
//   2: gate open state (0..1)
//   3: applied gain normalized (0..1 where 0.25 = 0 dB, 1.0 = +60 dB)
//   4: wet output peak (0..1)
//   5: current gate threshold linear (0..1)
//   6: current ceiling linear (0..1)
//   7: rolling frame counter (increments every 64 samples, including silence)
//
// GenExpr requires all functions before Buffer/Param/History/Delay declarations,
// and all declarations before expression statements. No variable is named e<digit>.

onepole_lp(x, coef) {
	History s(0);
	nxt = mix(x, s, coef);
	s = (abs(nxt) < 1e-15) ? 0 : nxt;
	return s;
}

onepole_hp(x, coef) {
	History s(0);
	nxt = mix(x, s, coef);
	s = (abs(nxt) < 1e-15) ? 0 : nxt;
	return x - s;
}

// Combined Peak + RMS detector with independent attack and release coefficients
// and denormal protection when audio stops.
env_detect(x, atkCoef, relCoef, detectBlend) {
	History pk(0);
	History ms(0);
	ax = abs(x);
	cPk = (ax > pk) ? atkCoef : relCoef;
	nxtPk = mix(ax, pk, cPk);
	pk = (nxtPk < 1e-15) ? 0 : nxtPk;
	x2 = x * x;
	cMs = (x2 > ms) ? atkCoef : relCoef;
	nxtMs = mix(x2, ms, cMs);
	ms = (nxtMs < 1e-24) ? 0 : nxtMs;
	rms = (detectBlend > 0.001) ? sqrt(max(ms, 0)) : pk;
	return mix(pk, rms, clip(detectBlend, 0, 1));
}

// Smooth normal or reverse gate with a 6 dB cubic knee around gateLin.
gate_smooth(envVal, gateLin, relCoef, revMode) {
	History gState(0);
	g = max(gateLin, 0.00001);
	lo = g * 0.5;
	hi = g * 1.41421356;
	t = clip((envVal - lo) / max(hi - lo, 0.00001), 0, 1);
	normalRaw = t * t * (3 - 2 * t);

	// Floor guard for Reverse Gate so pure digital silence does not get boosted to 0 dBFS.
	sLo = 0.00002;
	sHi = max(min(lo * 0.5, 0.00025), 0.00005);
	tf = clip((envVal - sLo) / max(sHi - sLo, 0.00001), 0, 1);
	floorGuard = tf * tf * (3 - 2 * tf);

	revRaw = (1.0 - normalRaw) * floorGuard;
	raw = (revMode > 0.5) ? revRaw : normalRaw;

	c = (raw > gState) ? 0.25 : clip(relCoef, 0.5, 0.9995);
	nxtG = mix(raw, gState, c);
	gState = (nxtG < 1e-9) ? 0 : nxtG;
	return gState;
}

// Output stage (`outmode`):
//   0 = Soft (`tanh` soft saturation to ceilLin)
//   1 = Hard (`clip` to [-ceilLin, +ceilLin])
//   2 = Lim  (Instant-attack, smooth-release peak limiter to ceilLin, preserving waveform shape)
// Skips `tanh()` when the signal is silent or when Hard/Limiter mode is selected.
// `invCeil` is `1 / max(ceilLin, 0.05)`, computed when Ceiling changes.
limit_out(x, ceilLin, invCeil, outMode) {
	History limEnv(0);
	c = max(ceilLin, 0.05);
	ax = abs(x);
	nxtLim = (ax > limEnv) ? ax : mix(ax, limEnv, 0.9985);
	limEnv = (nxtLim < 1e-12) ? 0 : nxtLim;
	res = 0;
	if (ax < 1e-9) {
		res = 0;
	} else if (outMode < 0.5) {
		res = c * tanh(x * invCeil);
	} else if (outMode < 1.5) {
		res = clip(x, -c, c);
	} else {
		res = clip(x * (c / max(limEnv, c)), -c, c);
	}
	return res;
}

// Fast reciprocal helper: uses direct 1/x division when amount is at 100% (1.0)
// or 1.0 when amount is 0%, avoiding costly pow() calls in the two most common cases.
recip_pow(safeEnv, amt) {
	res = 1.0;
	if (amt < 0.0005) {
		res = 1.0;
	} else if (abs(amt - 1.0) < 0.0005) {
		res = 1.0 / safeEnv;
	} else {
		res = pow(safeEnv, -amt);
	}
	return res;
}

Buffer scope("recipscope");

Param amount(1.0);
Param gate(-42.0);
Param attack(1.5);
Param release(60.0);
Param wet(1.0);
Param ceiling(-1.0);
Param lookahead(1.5);
Param detect(0.25);
Param schp(60.0);
Param sclp(12000.0);
Param outmode(0.0);
Param revgate(0.0);

History tick(0);
History rollCounter(0);
History peakInHold(0);
History peakEnvHold(0);
History peakOutHold(0);

// Last Param / samplerate that produced each cached coefficient. Sentinels force
// a compute on the first sample. Writes happen only inside the change checks.
History srHold(0);
History hpHzHold(-999);
History lpHzHold(-999);
History atkHold(-999);
History relHold(-999);
History gateDbHold(999);
History ceilDbHold(999);
History lookMsHold(-999);
History wetHold(-999);
History amtHold(-999);
History hpCoefH(0);
History lpCoefH(0);
History atkCoefH(0);
History relCoefH(0);
History gateLinH(0.01);
History ceilLinH(0.891250938);
History invCeilH(1.122018454);
History lookSampsH(0);
History dryGH(0);
History wetGH(1);
History scaleH(1);

Delay lookL(2048);
Delay lookR(2048);

sr = max(samplerate, 1);
srChg = (sr != srHold) ? 1 : 0;
srHold = sr;

amtNow = clip(amount, 0, 1.5);
gateDb = clip(gate, -72, -6);
atkMs = clip(attack, 0.05, 250);
relMs = clip(release, 0.5, 1500);
wetNow = clip(wet, 0, 1);
ceilDb = clip(ceiling, -18, 0);
lookMs = clip(lookahead, 0, 10);
detNow = clip(detect, 0, 1);
hpHz = clip(schp, 20, 2000);
lpHz = clip(sclp, 400, 18000);
outMode = clip(outmode, 0, 2);
revMode = clip(revgate, 0, 1);

// Control-rate coefficients. The expensive exp / pow / cos / sin run only when
// the matching Param (or samplerate) changes; the History keeps the last value.
if ((hpHz != hpHzHold) || (srChg > 0.5)) {
	hpCoefH = exp(-6.28318530718 * hpHz / sr);
	hpHzHold = hpHz;
}
if ((lpHz != lpHzHold) || (srChg > 0.5)) {
	lpCoefH = exp(-6.28318530718 * lpHz / sr);
	lpHzHold = lpHz;
}
if ((atkMs != atkHold) || (srChg > 0.5)) {
	atkCoefH = exp(-1.0 / (atkMs * 0.001 * sr));
	atkHold = atkMs;
}
if ((relMs != relHold) || (srChg > 0.5)) {
	relCoefH = exp(-1.0 / (relMs * 0.001 * sr));
	relHold = relMs;
}
if (gateDb != gateDbHold) {
	gateLinH = pow(10, gateDb / 20);
	gateDbHold = gateDb;
}
ceilChanged = (ceilDb != ceilDbHold) ? 1 : 0;
if (ceilChanged > 0.5) {
	ceilLinH = pow(10, ceilDb / 20);
	invCeilH = 1.0 / max(ceilLinH, 0.05);
	ceilDbHold = ceilDb;
}
if ((lookMs != lookMsHold) || (srChg > 0.5)) {
	lookSampsH = clip(lookMs * 0.001 * sr, 0, 1920);
	lookMsHold = lookMs;
}
if (wetNow != wetHold) {
	ang = wetNow * 1.57079632679;
	dryGH = cos(ang);
	wetGH = sin(ang);
	wetHold = wetNow;
}
amtChanged = (amtNow != amtHold) ? 1 : 0;
if ((amtChanged > 0.5) || (ceilChanged > 0.5)) {
	overAmt = max(amtNow - 1.0, 0);
	scaleH = pow(ceilLinH, min(amtNow, 1.0)) * ((overAmt > 0.0005) ? pow(0.05, overAmt) : 1.0);
	amtHold = amtNow;
}

hpCoef = hpCoefH;
lpCoef = lpCoefH;
atkCoef = atkCoefH;
relCoef = relCoefH;
gateLin = gateLinH;
ceilLin = ceilLinH;
invCeil = invCeilH;
lookSamps = lookSampsH;
dryG = dryGH;
wetG = wetGH;
targetScale = scaleH;

// 1. Write raw stereo input into lookahead delay lines (used for both wet VCA and phase-aligned dry).
lookL.write(in1);
lookR.write(in2);
delInL = lookL.read(lookSamps, interp="linear");
delInR = lookR.read(lookSamps, interp="linear");

// 2. Sidechain filter conditioning on the undelayed input so detection leads the delayed audio.
scL = onepole_lp(onepole_hp(in1, hpCoef), lpCoef);
scR = onepole_lp(onepole_hp(in2, hpCoef), lpCoef);

// 3. Envelope detection with sub-millisecond to 1.5 s ballistics.
detL = env_detect(scL, atkCoef, relCoef, detNow);
detR = env_detect(scR, atkCoef, relCoef, detNow);

linkedEnv = max(detL, detR);
linkAmt = 0.0 + 1.0 * detNow;
envL = mix(detL, linkedEnv, linkAmt);
envR = mix(detR, linkedEnv, linkAmt);
envMax = max(envL, envR);

// 4. Gate & Reciprocal gain calculation (with fast-path skip when gate is closed or input is silent).
gateL = gate_smooth(envL, gateLin, relCoef, revMode);
gateR = gate_smooth(envR, gateLin, relCoef, revMode);

// Gate applies at every Amount (mirror + Gate help); no Amount fade.
effGateL = gateL;
effGateR = gateR;

inAbs = max(abs(delInL), abs(delInR));
isSilent = (inAbs < 1e-8 && envMax < 1e-8) || (effGateL < 1e-7 && effGateR < 1e-7);

gainL = 0;
gainR = 0;
if (isSilent == 0) {
	floorEnv = (revMode > 0.5) ? 0.00005 : max(gateLin * 0.5, 0.00001);
	safeL = max(envL, floorEnv);
	safeR = max(envR, floorEnv);
	rawGainL = min(recip_pow(safeL, amtNow) * targetScale, 1000.0);
	rawGainR = min(recip_pow(safeR, amtNow) * targetScale, 1000.0);
	gainL = rawGainL * effGateL;
	gainR = rawGainR * effGateR;
}

// 5. Multiply lookahead-delayed signal by reciprocal gain and apply Soft / Hard / Limiter ceiling.
vcaL = delInL * gainL;
vcaR = delInR * gainR;
wetL = limit_out(vcaL, ceilLin, invCeil, outMode);
wetR = limit_out(vcaR, ceilLin, invCeil, outMode);

// 6. Equal-power dry/wet mix (using lookahead-aligned dry signal so parallel blend never comb-filters).
outL = delInL * dryG + wetL * wetG;
outR = delInR * dryG + wetR * wetG;

// 7. Scope telemetry every 64 samples. The frame head (slot 7) increments even in
//    silence so a deferred gen~ can be confirmed from the buffer. log10 runs here
//    only, not on the per-sample path. Slots 0..6 stay live so the UI can wake.
outAbs = max(abs(wetL), abs(wetR));
peakInHold = max(peakInHold, inAbs);
peakEnvHold = max(peakEnvHold, envMax);
peakOutHold = max(peakOutHold, outAbs);

tick = wrap(tick + 1, 0, 64);
if (tick == 0) {
	gainAvg = 0.5 * (gainL + gainR);
	gainDbNorm = clip((20 * log10(max(gainAvg, 0.001)) + 20) / 80, 0, 1);
	rollCounter = wrap(rollCounter + 1, 0, 100000);
	poke(scope, clip(peakInHold, 0, 1.5), 0, 0);
	poke(scope, clip(peakEnvHold, 0, 1.5), 1, 0);
	poke(scope, clip(max(gateL, gateR), 0, 1), 2, 0);
	poke(scope, gainDbNorm, 3, 0);
	poke(scope, clip(peakOutHold, 0, 1.5), 4, 0);
	poke(scope, clip(gateLin, 0, 1), 5, 0);
	poke(scope, clip(ceilLin, 0, 1), 6, 0);
	// Frame head moves every 64 samples even in silence (deferred-DSP confirm).
	poke(scope, rollCounter, 7, 0);
	peakInHold = 0;
	peakEnvHold = 0;
	peakOutHold = 0;
}

out1 = fixnan(outL);
out2 = fixnan(outR);
