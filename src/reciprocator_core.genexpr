// Reciprocator — Reciprocal envelope follower & audio-rate dynamics/waveshaper.
// Multiplies the lookahead-delayed input by env^(-amount) * gate so quiet tails
// and textures jump to full ceiling while silence below Gate is cleanly muted.
//
// Scope telemetry buffer (buffer~ #0-recipscope, bound via `scope #0-recipscope`):
//   0: input peak (0..1)
//   1: post-detector envelope (0..1)
//   2: gate open state (0..1)
//   3: applied gain normalized (0..1 where 0.25 = 0 dB, 1.0 = +60 dB)
//   4: wet output peak (0..1)
//   5: current gate threshold linear (0..1)
//   6: current ceiling linear (0..1)
//   7: rolling frame counter
//
// GenExpr requires all functions before Buffer/Param/History/Delay declarations,
// and all declarations before expression statements. No variable is named e<digit>.

slew(target, coef) {
	History s(0);
	History init(0);
	s = (init == 0) ? target : mix(target, s, coef);
	init = 1;
	return s;
}

onepole_lp(x, coef) {
	History s(0);
	s = mix(x, s, coef);
	return s;
}

onepole_hp(x, coef) {
	History s(0);
	s = mix(x, s, coef);
	return x - s;
}

// Combined Peak + RMS detector with independent attack and release coefficients.
// detectBlend = 0 is pure peak |x|; detectBlend = 1 blends in RMS energy and
// slightly smooths ripple for clean sustain leveling.
env_detect(x, atkCoef, relCoef, detectBlend) {
	History pk(0);
	History ms(0);
	ax = abs(x);
	cPk = (ax > pk) ? atkCoef : relCoef;
	pk = mix(ax, pk, cPk);
	x2 = x * x;
	cMs = (x2 > ms) ? atkCoef : relCoef;
	ms = mix(x2, ms, cMs);
	rms = sqrt(max(ms, 0));
	return mix(pk, rms, clip(detectBlend, 0, 1));
}

// Smooth gate with hysteresis-like release smoothing and a 6 dB cubic knee.
gate_smooth(envVal, gateLin, relCoef) {
	History gState(0);
	g = max(gateLin, 0.00001);
	lo = g * 0.5;
	hi = g * 1.41421356;
	t = clip((envVal - lo) / max(hi - lo, 0.00001), 0, 1);
	raw = t * t * (3 - 2 * t);
	// Open quickly when signal crosses threshold; close with release smoothing.
	c = (raw > gState) ? 0.25 : clip(relCoef, 0.5, 0.9995);
	gState = mix(raw, gState, c);
	return gState;
}

// Output ceiling limiter: softclip > 0.5 uses smooth tanh saturation to ceilLin;
// otherwise hard-clips at ceilLin.
limit_out(x, ceilLin, softMode) {
	c = max(ceilLin, 0.05);
	soft = c * tanh(x / c);
	hard = clip(x, -c, c);
	return (softMode > 0.5) ? soft : hard;
}

Buffer scope("recipscope");

Param amount(1.0);
Param gate(-42.0);
Param attack(1.5);
Param release(60.0);
Param wet(1.0);
Param ceiling(-1.0);
Param lookahead(1.5);
Param detect(0.25);
Param schp(60.0);
Param sclp(12000.0);
Param softclip(1.0);

History tick(0);
History rollCounter(0);
History peakInHold(0);
History peakEnvHold(0);
History peakOutHold(0);

Delay lookL(1024);
Delay lookR(1024);

sr = max(samplerate, 1);

amountS = slew(clip(amount, 0, 1.5), 0.999);
gateDbS = slew(clip(gate, -72, -6), 0.999);
atkMsS = slew(clip(attack, 0.05, 250), 0.999);
relMsS = slew(clip(release, 0.5, 1500), 0.999);
wetS = slew(clip(wet, 0, 1), 0.999);
ceilDbS = slew(clip(ceiling, -18, 0), 0.999);
lookMsS = slew(clip(lookahead, 0, 10), 0.999);
detectS = slew(clip(detect, 0, 1), 0.999);
hpHzS = slew(clip(schp, 20, 2000), 0.999);
lpHzS = slew(clip(sclp, 400, 18000), 0.999);
softMode = clip(softclip, 0, 1);

// 1. Write raw stereo input into lookahead delay lines (used for both wet VCA and phase-aligned dry).
lookSamps = clip(lookMsS * sr / 1000, 0, 960);
lookL.write(in1);
lookR.write(in2);
delInL = lookL.read(lookSamps, interp="linear");
delInR = lookR.read(lookSamps, interp="linear");

// 2. Sidechain filter conditioning on the undelayed input so detection leads the delayed audio.
hpCoef = exp(-6.28318530718 * hpHzS / sr);
lpCoef = exp(-6.28318530718 * lpHzS / sr);
scL = onepole_lp(onepole_hp(in1, hpCoef), lpCoef);
scR = onepole_lp(onepole_hp(in2, hpCoef), lpCoef);

// 3. Envelope detection with sub-millisecond to 1.5 s ballistics.
atkCoef = exp(-1000 / ( max(atkMsS, 0.05) * sr ));
relCoef = exp(-1000 / ( max(relMsS, 0.5) * sr ));
detL = env_detect(scL, atkCoef, relCoef, detectS);
detR = env_detect(scR, atkCoef, relCoef, detectS);

// Stereo link: detect knob also blends from tight dual-mono peak (0%) toward linked RMS (100%).
linkedEnv = max(detL, detR);
linkAmt = 0.35 + 0.65 * detectS;
envL = mix(detL, linkedEnv, linkAmt);
envR = mix(detR, linkedEnv, linkAmt);
envMax = max(envL, envR);

// 4. Gate & Reciprocal gain calculation.
gateLin = pow(10, gateDbS / 20);
ceilLin = pow(10, ceilDbS / 20);

gateL = gate_smooth(envL, gateLin, relCoef);
gateR = gate_smooth(envR, gateLin, relCoef);

floorEnv = max(gateLin * 0.5, 0.00001);
safeL = max(envL, floorEnv);
safeR = max(envR, floorEnv);

// Scale target so that at amount = 1.0, x / env lands at ceilLin, and at
// amount > 1.0 loud peaks are ducked down while quiet details rise to ceilLin.
overAmt = max(amountS - 1.0, 0.0);
targetScale = pow(ceilLin, min(amountS, 1.0)) * pow(0.05, overAmt);
rawGainL = min(pow(safeL, -amountS) * targetScale, 1000.0);
rawGainR = min(pow(safeR, -amountS) * targetScale, 1000.0);

// Blend between unity (1.0) at amount = 0 and gated reciprocal gain as amount increases.
// At amount > 0, gateL/gateR mutes background noise below Gate threshold.
gateMix = clip(amountS * 4.0, 0, 1);
effGateL = mix(1.0, gateL, gateMix);
effGateR = mix(1.0, gateR, gateMix);

gainL = rawGainL * effGateL;
gainR = rawGainR * effGateR;

// 5. Multiply lookahead-delayed signal by reciprocal gain and apply ceiling/soft-clip.
vcaL = delInL * gainL;
vcaR = delInR * gainR;
wetL = limit_out(vcaL, ceilLin, softMode);
wetR = limit_out(vcaR, ceilLin, softMode);

// 6. Equal-power dry/wet mix (using lookahead-aligned dry signal so parallel blend never comb-filters).
ang = wetS * 1.57079632679;
dryG = cos(ang);
wetG = sin(ang);
outL = delInL * dryG + wetL * wetG;
outR = delInR * dryG + wetR * wetG;

// 7. Update scope telemetry buffer every 64 samples with peak-held values over the window.
inAbs = max(abs(delInL), abs(delInR));
outAbs = max(abs(wetL), abs(wetR));
peakInHold = max(peakInHold, inAbs);
peakEnvHold = max(peakEnvHold, envMax);
peakOutHold = max(peakOutHold, outAbs);

tick = wrap(tick + 1, 0, 64);
if (tick == 0) {
	gainAvg = 0.5 * (gainL + gainR);
	gainDbNorm = clip((20 * log10(max(gainAvg, 0.001)) + 20) / 80, 0, 1);
	rollCounter = wrap(rollCounter + 1, 0, 100000);
	poke(scope, clip(peakInHold, 0, 1.5), 0, 0);
	poke(scope, clip(peakEnvHold, 0, 1.5), 1, 0);
	poke(scope, clip(max(gateL, gateR), 0, 1), 2, 0);
	poke(scope, gainDbNorm, 3, 0);
	poke(scope, clip(peakOutHold, 0, 1.5), 4, 0);
	poke(scope, clip(gateLin, 0, 1), 5, 0);
	poke(scope, clip(ceilLin, 0, 1), 6, 0);
	poke(scope, rollCounter, 7, 0);
	peakInHold = 0;
	peakEnvHold = 0;
	peakOutHold = 0;
}

out1 = fixnan(outL);
out2 = fixnan(outR);
