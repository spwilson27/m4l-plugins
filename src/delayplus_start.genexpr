// Delay+ (Start) — the tank. Sits first in a rack chain: [Delay+] [user FX ...] [Delay+ End].
//
// Start outputs ONLY the delay tap into the chain. End receives the processed tap, mixes it with
// the dry signal (passed internally through the shared `xfer` ring) and writes the processed tap
// back into `xfer` as the feedback return, which Start adds into its tank.
//
// Cross-device timing (measured in Live: devices in one chain run in lockstep slices, in order):
//   Both devices run a free counter mod M. Start pokes its counter to hdr[0], End to hdr[1].
//   They run in vectors (32 samples in Live 12) but NOT in a fixed order per vector.
//   End:   K = held min of (cS_latest - cE): End's sample cE carries Start's sample cE + K
//          (causal bound), then calibrated from the audio by cross-correlation, hdr[2].
//   Start: Smax = held max of (cS - cE_latest); reads the return at End index s - Smax (always
//          written) and publishes the read lag B = Smax - K, hdr[3].
//   L = chain latency (sum of the FX devices' latency_in_samples, sent by the JS as `lat`).
//
// Latency compensation: a tap emitted at Start sample s comes back from End at Start sample
// s + L + B. Instead of writing that return at the tank head (which would make every repeat
// L + B late), it is added at tank index (s_now - B - L): the sample's original emit position.
// The tap then re-reads it exactly T later, so the first echo and every repeat land on T.
// Requires T > L + B (+ modulation + interpolation margin) -> clamped, flagged in telemetry.
//
// hdr (shared, 64 samples): 0 cS, 1 cE, 2 K, 3 B, 4 L, 5 wet, 6 duck, 7 width,
//   12 End wet peak, 13 freeze, 14 Start sees End, 15 End sees Start, 16 End duck gain.
//   diagnostics per 16384-sample window: 20/21 min/max of (cS - cE_latest) seen by Start,
//   22/23 min/max of (cS_latest - cE) seen by End, 24 Start window count.
// xfer (shared, 5 ch x RING): ch0/1 dry L/R at Start index, ch2/3 return L/R at End index,
//   ch4 first difference of the mono tap at Start index (End's K calibration).
// hdr 27 = LFO rate in Hz, 28 = right / side time in ms, 30 = L (chain latency), 31 = left / mid
// time in ms: all poked by the UI script. 40..42 = End's ducking threshold / release and output gain.
// scope (UI telemetry, Start only), every 64 samples:
//   0 TL eff (samples) 1 TR eff 2 clamped 3 Tmin 4 B 5 K 6 L 8 paired 9 in peak
//   10/11 tap peak L/R 12/13 return peak L/R 14 frame counter 15 sr 16 freeze 17 duck gain
//   18 wet out peak 19 history head 20 TL target 21 TR target 22 tank fill L
//   28 Feedback Clip reduction in dB (<= 0, deepest over the last 2048 samples; the clip LED after the tabs)
//   history ring, one block per 256 samples: 32 + 3 * blk + (in, tapL, tapR) peaks, 512 blocks.
// spec (Filter Display spectrogram): 0 write head (0..8191, every 64 samples), 1 sr, 2 / 3 wet / dry
//   peak of the last 64 samples, then two mono rings of 8192: 32.. the wet (the delay tap after the
//   loop filter, what goes into the chain) and 8224.. the dry input.
//
// GenExpr: functions first, then declarations, then statements. No identifier e<digit>.

wd(x, m) {
	y = x;
	if (y >= m * 0.5) y = y - m;
	if (y < -m * 0.5) y = y + m;
	return y;
}

herm(dat, chn, pos, size) {
	i = floor(pos);
	f = pos - i;
	xm1 = peek(dat, wrap(i - 1, 0, size), chn);
	x0 = peek(dat, wrap(i, 0, size), chn);
	x1 = peek(dat, wrap(i + 1, 0, size), chn);
	x2 = peek(dat, wrap(i + 2, 0, size), chn);
	c1 = 0.5 * (x1 - xm1);
	c2 = xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2;
	c3 = 0.5 * (x2 - xm1) + 1.5 * (x0 - x1);
	return ((c3 * f + c2) * f + c1) * f + x0;
}

lfoshape_val(shp, p, nz) {
	v = 0;
	// sine only for the sine shape; the other five replace v entirely
	if (shp == 0) v = sin(p * twopi);
	if (shp == 1) v = 1 - 4 * abs(p - 0.5);
	if (shp == 2) v = 2 * p - 1;
	if (shp == 3) v = 1 - 2 * p;
	if (shp == 4) v = p < 0.5 ? 1 : -1;
	if (shp == 5) v = nz;
	return v;
}

softsat(x, lim) {
	return lim * tanh(x / lim);
}

Buffer xfer("dpxfer");
Buffer hdr("dphdr");
Buffer scope("dpscope");
Buffer spec("dpspec");

Data tank(524288, 2);

// Times per side in ms (the UI script computes sync / mode / offset / link and pokes hdr[31] /
// hdr[28]; these Params are the fallback for the standalone harness).
Param tmsL(375);
Param tmsR(375);
Param fb(0.5);
Param inv(0);
Param chmode(0);       // 0 Stereo, 1 Ping Pong, 2 Mid/Side (Left time = Mid, Right time = Side)
Param inputdb(0);
Param clipmode(0);     // feedback clip: 0 Soft, 1 Hard, 2 Limit (Options page)
Param cliplevel(0);    // its ceiling in dB, -18..+6
Param clipdry(0);      // Echo's "D": soft clip on the input into the tank
Param filton(1);
Param hp(50);
Param lp(5000);
Param hpres(0);
Param lpres(0);
Param lforate(0.5);    // Hz (the UI converts a synced rate)
Param lfoshape(0);     // 0 sine, 1 triangle, 2 saw up, 3 saw down, 4 square, 5 noise
Param phase(180);      // right-channel LFO phase offset, degrees
Param x4(0);
Param moddelay(0);     // 0..1 -> up to 8 ms (32 ms with x4)
Param modfilt(0);      // 0..1 -> up to +-2 octaves of both cutoffs
Param envmix(0);       // 0 LFO only .. 1 envelope follower only
Param gateon(0);
Param gatethr(0);
Param gaterel(50);
Param noiseon(0);
Param noiseamt(0);
Param noisemorph(0);
Param wobon(0);
Param wobamt(0);
Param wobmorph(0);
Param repitch(0);      // 1: the read head glides to a new time (pitch bends); 0: crossfade
Param repsmooth(120);  // Repitch glide time constant, ms
Param freeze(0);
Param lat(0);
Param wet(0.5);
Param diffuse(0);      // Diffusion amount 0..1 (allpass smear on the feedback return)
Param dsize(0.6);      // Diffusion Size 0..1 (allpass lengths, up to about 37 ms)
Param width(1);
Param duckon(0);
Param duckthr(0);
Param duckrel(100);
Param outdb(0);

History cnt(0);
History lastCe(-1);
History deadCnt(1e9);
History sw1(-1e9);
History sw2(-1e9);
History sw3(-1e9);
History bCur(0);
History bWin(0);
History sLo(1e9);
History sHi(-1e9);
History lastL(-1);
History lastB(-1);
History lastK(-1e9);
History mute(0);
History gLink(0);
History ig(1);
History frzTL(0);      // Freeze: loop period per side in whole samples, latched when Freeze engages
History frzTR(0);
History frzPrev(0);
History fbs(0.4);
History tsL(16537);
History tsR(16537);
History tAL(16537);
History tBL(16537);
History tAR(16537);
History tBR(16537);
History xfL(0);
History xfR(0);
History xtL(0);
History xtR(0);
History lfo(0);
History lfoNz(0);
History lfoNzL(0);
History lfoNzR(0);
History lfoWrapL(0);
History lfoWrapR(0);
History envIn(0);
History gateEnv(0);
History gateG(1);
History wowS(0);
History wowT(0);
History wowC(0);
History flutS(0);
History flutT(0);
History flutC(0);
History rng(22222);
History crackle(0);
History hpL1(0);
History hpL2(0);
History hpR1(0);
History hpR2(0);
History lpL1(0);
History lpL2(0);
History lpR1(0);
History lpR2(0);
History cHp(-1);
History cLp(-1);
History cSr(0);
History hpG(0);
History hpK(1.4142);
History lpG(0);
History lpK(1.4142);
History hpGR(0);
History lpGR(0);
History cFmL(-99);      // filter coefficient cache keys (with cHp, cLp, cSr)
History cFmR(-99);
History tick(0);
History dScale(0);     // smoothed allpass length scale (0 = off, so Diffusion 0 adds no delay)
// Diffusion: four Schroeder allpasses per tank channel on the feedback return (lengths differ per
// side for decorrelation). Sized for 192 kHz at the longest setting.
Delay apL1(4096);
Delay apL2(4096);
Delay apL3(4096);
Delay apL4(4096);
Delay apR1(4096);
Delay apR2(4096);
Delay apR3(4096);
Delay apR4(4096);
History limG(1);
History clipR(1);      // smallest clip out / in ratio in the current 64-sample window
History clipHold(1);   // deepest ratio over the last 32 windows (about 45 ms), what the LED reads
History clipAge(0);
History specPk(0);
History specPkD(0);
History frames(0);
History pkIn(0);
History pkTL(0);
History pkTR(0);
History pkRL(0);
History pkRR(0);
History hBlk(0);
History hIn(0);
History hTL(0);
History hTR(0);
History hHead(0);
History ptap(0);
// Knob / sample-rate caches. A History written this sample reads back its old value, so the fresh
// result is kept in a temp and used the same sample; the next sample reads the History.
History cInDb(-999);
History ingC(1);
History cGateThr(-999);
History gateThrC(0.001);
History cGateRel(-999);
History gateRelC(0);
History gateAtkC(0);
History envRelC(1);
History gateEnvRelC(1);
History cClipDb(-999);
History clipLinC(1);
History clipInvC(1);
History cOutDb(-999);
History outLinC(1);
History cSrCoef(0);
History k50C(0);
History igC(0);
History cRepSm(-999);
History slewC(0);
History wowKC(0);
History flutKC(0);
History wowNC(1);
History flutNC(1);
History cWobOn(-1);
History cWobAmt(-1);
History wobSC(0);
History cNzAmt(-1);
History cNzMorph(-1);
History nzThrC(1);
History nzHissC(0);
History nzCrkC(0);

tmp = 0;
gOpen = 0;
nm = 0;
nz = 0;
actL = 0;
actR = 0;
hb = 0;
dg = 1;
nrm = 1;
M = 4194304;
RING = 65536;
TANK = 524288;
sr = max(samplerate, 1);

// pow / exp / the 50 ms one-pole, only when the knob or the sample rate changed.
srChg = sr != cSrCoef;
ingNow = ingC;
if (inputdb != cInDb) {
	ingNow = dbtoa(clip(inputdb, -36, 12));
	cInDb = inputdb;
	ingC = ingNow;
}
thrNow = gateThrC;
if (gatethr != cGateThr) {
	thrNow = dbtoa(clip(gatethr, -60, 0));
	cGateThr = gatethr;
	gateThrC = thrNow;
}
outNow = outLinC;
if (outdb != cOutDb) {
	outNow = dbtoa(clip(outdb, -36, 12));
	cOutDb = outdb;
	outLinC = outNow;
}
cTnow = clipLinC;
clipInvNow = clipInvC;
if (cliplevel != cClipDb) {
	cTnow = dbtoa(clip(cliplevel, -18, 6));
	clipInvNow = 1 / cTnow;
	cClipDb = cliplevel;
	clipLinC = cTnow;
	clipInvC = clipInvNow;
}
envRelNow = envRelC;
gateEnvRelNow = gateEnvRelC;
gateAtkNow = gateAtkC;
k50Now = k50C;
igNow = igC;
wowKNow = wowKC;
flutKNow = flutKC;
wowNNow = wowNC;
flutNNow = flutNC;
if (srChg) {
	envRelNow = exp(-1 / (0.15 * sr));
	gateEnvRelNow = exp(-1 / (0.01 * sr));
	gateAtkNow = 1 / (0.001 * sr);
	k50Now = 1 / (0.05 * sr);
	igNow = 1 / (0.01 * sr);
	wowKNow = 1 / (0.25 * sr);
	flutKNow = 1 / (0.012 * sr);
	wowNNow = floor(sr * 0.35);
	flutNNow = floor(sr * 0.045);
	envRelC = envRelNow;
	gateEnvRelC = gateEnvRelNow;
	gateAtkC = gateAtkNow;
	k50C = k50Now;
	igC = igNow;
	wowKC = wowKNow;
	flutKC = flutKNow;
	wowNC = wowNNow;
	flutNC = flutNNow;
}
gateRelNow = gateRelC;
if (srChg || gaterel != cGateRel) {
	gateRelNow = exp(-1 / (clip(gaterel, 1, 2000) * 0.001 * sr));
	cGateRel = gaterel;
	gateRelC = gateRelNow;
}
slewNow = slewC;
if (srChg || repsmooth != cRepSm) {
	slewNow = 1 - exp(-1 / (max(repsmooth, 1) * 0.001 * sr));
	cRepSm = repsmooth;
	slewC = slewNow;
}
wobNow = wobSC;
if (srChg || wobon != cWobOn || wobamt != cWobAmt) {
	wobNow = (wobon > 0.5) * clip(wobamt, 0, 1) * 0.003 * sr;
	cWobOn = wobon;
	cWobAmt = wobamt;
	wobSC = wobNow;
}
nmNow = clip(noisemorph, 0, 1);
nzThrNow = nzThrC;
nzHissNow = nzHissC;
nzCrkNow = nzCrkC;
if (noiseamt != cNzAmt || noisemorph != cNzMorph) {
	nzG = clip(noiseamt, 0, 1) * 0.06;
	nzThrNow = 1 - 0.0004 * (0.2 + nmNow);
	nzHissNow = 0.25 * (1 - nmNow) * nzG;
	nzCrkNow = nmNow * nzG;
	cNzAmt = noiseamt;
	cNzMorph = noisemorph;
	nzThrC = nzThrNow;
	nzHissC = nzHissNow;
	nzCrkC = nzCrkNow;
}
if (srChg) cSrCoef = sr;

// ---- counters / link -------------------------------------------------------------------------
cn = wrap(cnt + 1, 0, M);
cnt = cn;
poke(hdr, cn, 0);
ce = peek(hdr, 1);

if (ce != lastCe) {
	deadCnt = 0;
} else {
	deadCnt = deadCnt + 1;
}
lastCe = ce;
paired = deadCnt < 8192;

// Live/Max does not run Start and End in a fixed order per vector: Start may be up to two vectors
// ahead. Smax = max(cS - cE_latest), held over 4 windows (~1.5 s), bounds what End has written:
// the return is read at End index s - Smax, and with End's K the read lag is B = Smax - K.
rS = wd(cn - ce, M);
bCur = max(bCur, rS);
sLo = min(sLo, rS);
sHi = max(sHi, rS);
bWin = bWin + 1;
if (bWin >= 16384) {
	poke(hdr, sLo, 20);
	poke(hdr, sHi, 21);
	poke(hdr, peek(hdr, 24) + 1, 24);
	sLo = 1e9;
	sHi = -1e9;
	sw3 = sw2;
	sw2 = sw1;
	sw1 = bCur;
	bCur = -1e9;
	bWin = 0;
}
// Until End's counter is moving its value is stale (0 or a dead instance's): forget everything.
if (!paired) {
	bCur = -1e9;
	sw1 = -1e9;
	sw2 = -1e9;
	sw3 = -1e9;
}
smax = max(max(bCur, sw1), max(sw2, sw3));
kk = peek(hdr, 2);
bb = clip(smax - kk, 1, 8192);
if (!paired) {
	bb = 32;
	smax = 32;
}
poke(hdr, bb, 3);
// L and the time come from the UI script through hdr[30] / hdr[31] (poked from its own thread);
// the `lat` / `tms` Params are the fallback for the standalone Max harness.
ll = clip(floor(max(lat, peek(hdr, 30))), 0, RING - 16384);
poke(hdr, ll, 4);
poke(hdr, paired, 14);

// Any change of L, B or K moves the return write position: duck the loop for a moment.
if (ll != lastL || bb != lastB || kk != lastK) {
	mute = 2048;
}
lastL = ll;
lastB = bb;
lastK = kk;
mute = max(mute - 1, 0);
gLink = gLink + ((mute > 0 || !paired) ? -1 : 1) * (1 / 256);
gLink = clip(gLink, 0, 1);

// Parameters for End (mix stage lives there).
poke(hdr, clip(wet, 0, 1), 5);
poke(hdr, duckon > 0.5, 6);
poke(hdr, clip(width, 0, 2), 7);
poke(hdr, clip(duckthr, -60, 0), 40);
poke(hdr, clip(duckrel, 1, 2000), 41);
poke(hdr, outNow, 42);
poke(hdr, freeze > 0.5, 13);

// ---- dry into the ring ---------------------------------------------------------------------
ri = wrap(cn, 0, RING);
poke(xfer, in1, ri, 0);
poke(xfer, in2, ri, 1);

// ---- feedback return ------------------------------------------------------------------------
frz = freeze > 0.5;
fbs = fbs + (clip(fb, 0, 1.1) - fbs) * 0.001;
// Freeze takes the chain out of the loop (see the tank write): the return fades out with the input
// (ig), so the Feedback knob does nothing while frozen.
fbg = fbs * ig;
eIdx = wrap(cn - smax, 0, RING);
retL = peek(xfer, eIdx, 2) * gLink;
retR = peek(xfer, eIdx, 3) * gLink;
fsign = inv > 0.5 ? -1 : 1;
fL = softsat(retL * fbg * fsign, 1.5);
fR = softsat(retR * fbg * fsign, 1.5);
mode = floor(clip(chmode, 0, 2) + 0.5);
if (mode == 1) {
	tmp = fL;
	fL = fR;
	fR = tmp;
}
if (mode == 2) {
	// the tank runs in Mid/Side: channel 0 = mid, 1 = side
	tmp = (fL + fR) * 0.5;
	fR = (fL - fR) * 0.5;
	fL = tmp;
}

// ---- Diffusion: allpass smear on the return, timing compensated -------------------------------
// Each repeat passes the four allpasses once more, so later repeats wash out further; the first
// echo is untouched and the level is unchanged (|allpass| = 1). The chain delays the return by
// dTot samples, so the return is written dTot earlier in the tank (see `fi`) and echoes stay on
// n * T. The lengths scale with Size and fade in with the amount, so Diffusion 0 adds no delay
// and is an exact bypass.
fL0 = fL;
fR0 = fR;
dAmt = clip(diffuse, 0, 1);
dTgt = (0.1 + 0.9 * clip(dsize, 0, 1)) * min(1, dAmt * 5) * sr / 48000;
dScale = dScale + (dTgt - dScale) * k50Now;
dScale = dScale < 0.00001 && dTgt == 0 ? 0 : dScale;
dTot = floor(1788 * dScale + 0.5);
dg = 0.7 * dAmt;
// lengths 113 / 337 / 541 / (rest) and 127 / 359 / 563 / (rest), so each side sums to dTot exactly
lA = 113 * dScale;
lB = 337 * dScale;
lC = 541 * dScale;
lD = max(dTot - lA - lB - lC, 0);
lE = 127 * dScale;
lF = 359 * dScale;
lG = 563 * dScale;
lH = max(dTot - lE - lF - lG, 0);
aR1 = apL1.read(lA, interp="linear");
aW1 = fL + dg * aR1;
apL1.write(aW1);
aY1 = aR1 - dg * aW1;
aR2 = apL2.read(lB, interp="linear");
aW2 = aY1 + dg * aR2;
apL2.write(aW2);
aY2 = aR2 - dg * aW2;
aR3 = apL3.read(lC, interp="linear");
aW3 = aY2 + dg * aR3;
apL3.write(aW3);
aY3 = aR3 - dg * aW3;
aR4 = apL4.read(lD, interp="linear");
aW4 = aY3 + dg * aR4;
apL4.write(aW4);
bR1 = apR1.read(lE, interp="linear");
bW1 = fR + dg * bR1;
apR1.write(bW1);
bY1 = bR1 - dg * bW1;
bR2 = apR2.read(lF, interp="linear");
bW2 = bY1 + dg * bR2;
apR2.write(bW2);
bY2 = bR2 - dg * bW2;
bR3 = apR3.read(lG, interp="linear");
bW3 = bY2 + dg * bR3;
apR3.write(bW3);
bY3 = bR3 - dg * bW3;
bR4 = apR4.read(lH, interp="linear");
bW4 = bY3 + dg * bR4;
apR4.write(bW4);
// off (no length yet): the return skips the chain, exactly as before
fL = dTot > 0 ? fixdenorm(aR4 - dg * aW4) : fL0;
fR = dTot > 0 ? fixdenorm(bR4 - dg * bW4) : fR0;

// ---- tank write: input at the head, return at its original emit position ---------------------
ig = ig + (frz ? 0 - ig : 1 - ig) * igNow;
// Input gain and Echo's "D" (soft clip), then the gate (opens above its threshold, closes after
// its release), all on the signal that enters the tank only; the dry path stays untouched.
xL = in1 * ingNow;
xR = in2 * ingNow;
if (clipdry > 0.5) {
	xL = tanh(xL);
	xR = tanh(xR);
}
lvl = max(abs(in1), abs(in2));
envIn = lvl > envIn ? lvl : envIn * envRelNow;
gateEnv = lvl > gateEnv ? lvl : gateEnv * gateEnvRelNow;
if (gateon > 0.5) {
	// gateEnv > dbtoa(threshold) == atodb(gateEnv) > threshold, and the threshold is never below -60 dB
	gOpen = gateEnv > thrNow;
	gateG = gOpen ? gateG + (1 - gateG) * gateAtkNow : gateG * gateRelNow;
} else {
	gateG = 1;
}
inL = xL * ig * gateG;
inR = xR * ig * gateG;
if (mode == 1) {
	inL = (xL + xR) * 0.5 * ig * gateG;
	inR = 0;
}
if (mode == 2) {
	inL = (xL + xR) * 0.5 * ig * gateG;
	inR = (xL - xR) * 0.5 * ig * gateG;
}
wi = wrap(cn, 0, TANK);
// Freeze: the tank repeats itself. The head writes an exact copy of the tank one loop period earlier
// (whole samples, no interpolation, no filter, no clip), so what is in the buffer repeats at the
// same level forever, whatever the chain or the Feedback knob does. Ping Pong copies across sides
// like its return. The copy fades in as the input and the return fade out (ig, 10 ms), and back.
fzW = 1 - ig;
cpL = 0;
cpR = 0;
if (fzW > 0 && frzTL > 0) {
	srcL = mode == 1 ? 1 : 0;
	srcR = mode == 1 ? 0 : 1;
	cpL = peek(tank, wrap(cn - (mode == 1 ? frzTR : frzTL), 0, TANK), srcL);
	cpR = peek(tank, wrap(cn - (mode == 1 ? frzTL : frzTR), 0, TANK), srcR);
}
poke(tank, inL + cpL * fzW, wi, 0);
poke(tank, inR + cpR * fzW, wi, 1);
fi = wrap(cn - bb - ll - dTot, 0, TANK);
// Feedback clip where input and feedback meet (Options page), ceiling T = Clip Level:
//   Soft  linear up to 0.8 T, then a tanh knee that reaches T
//   Hard  clipped at +-T
//   Limit stereo-linked peak limiter, instant attack, 50 ms release, never above T
// (inlined: the same expressions as a helper function with locals broke compilation, see AGENTS.md)
sumL = peek(tank, fi, 0) + fL;
sumR = peek(tank, fi, 1) + fR;
cT = cTnow;
cK = 0.8 * cT;
amL = max(abs(sumL), cK);
amR = max(abs(sumR), cK);
sfL = sumL * (cK + (cT - cK) * tanh((amL - cK) / (cT - cK))) / amL;
sfR = sumR * (cK + (cT - cK) * tanh((amR - cK) / (cT - cK))) / amR;
pkS = max(abs(sumL), abs(sumR));
limT = pkS > cT ? cT / pkS : 1;
limG = limT < limG ? limT : limG + (limT - limG) * k50Now;
cm = floor(clip(clipmode, 0, 2) + 0.5);
cOutL = cm == 1 ? clip(sumL, 0 - cT, cT) : (cm == 2 ? sumL * limG : sfL);
cOutR = cm == 1 ? clip(sumR, 0 - cT, cT) : (cm == 2 ? sumR * limG : sfR);
// Clip telemetry (not while frozen: the held loop skips the clip)
pkC = max(abs(cOutL), abs(cOutR));
clipR = frz ? clipR : min(clipR, pkS > 0.000001 ? min(1, pkC / pkS) : 1);
// frozen: no clip (it would squeeze the held loop a little more on every pass)
cOutL = sumL * fzW + cOutL * ig;
cOutR = sumR * fzW + cOutR * ig;
poke(tank, cOutL, fi, 0);
poke(tank, cOutR, fi, 1);

// ---- delay times ------------------------------------------------------------------------------
tmsHL = peek(hdr, 31);
tmsHR = peek(hdr, 28);
tgL = clip(tmsHL > 0 ? tmsHL : tmsL, 1, 8000) * sr / 1000;
tgR = clip(tmsHR > 0 ? tmsHR : tmsR, 1, 8000) * sr / 1000;
modS = clip(moddelay, 0, 1) * 0.008 * (x4 > 0.5 ? 4 : 1) * sr;
wobS = wobNow;
tmin = bb + ll + dTot + modS + wobS + 4;
tmax = TANK - 8;
clamped = (tgL < tmin) || (tgR < tmin);
tgL = clip(tgL, tmin, tmax);
tgR = clip(tgR, tmin, tmax);

// LFO (shape, right channel offset by `phase`) blended with the input envelope by `envmix`.
lfoH = peek(hdr, 27);
lfo = wrap(lfo + clip(lfoH > 0 ? lfoH : lforate, 0.01, 40) / sr, 0, 1);
pR = wrap(lfo + clip(phase, 0, 360) / 360, 0, 1);
shp = floor(clip(lfoshape, 0, 5) + 0.5);
if (pR < lfoWrapR) lfoNzR = noise();
lfoWrapR = pR;
if (lfo < lfoWrapL) lfoNzL = noise();
lfoWrapL = lfo;
lL = lfoshape_val(shp, lfo, lfoNzL);
lR = lfoshape_val(shp, pR, lfoNzR);
envV = clip((atodb(max(envIn, 0.000001)) + 48) / 48, 0, 1) * 2 - 1;
em = clip(envmix, 0, 1);
lL = lL * (1 - em) + envV * em;
lR = lR * (1 - em) + envV * em;
mL = modS * (0.5 + 0.5 * lL);
mR = modS * (0.5 + 0.5 * lR);
// Wobble: slow random wow and fast flutter of the read head, `wobmorph` blends wow -> flutter.
rng = wrap(rng * 16807, 0, 2147483647);
wowC = wowC + 1;
if (wowC >= wowNNow) {
	wowC = 0;
	wowT = noise();
}
wowS = wowS + (wowT - wowS) * wowKNow;
flutC = flutC + 1;
if (flutC >= flutNNow) {
	flutC = 0;
	flutT = noise();
}
flutS = flutS + (flutT - flutS) * flutKNow;
wm = clip(wobmorph, 0, 1);
wob = wobNow * (0.5 + 0.5 * (wowS * (1 - wm) + flutS * wm));
mL = mL + wob;
mR = mR + wob;

slew = slewNow;
xfRate = k50Now;
if (repitch > 0.5) {
	// Repitch (tape): the read head glides to the new time (pitch bends while it moves).
	tsL = tsL + (tgL - tsL) * slew;
	tsR = tsR + (tgR - tsR) * slew;
	tAL = tsL;
	tAR = tsR;
	xtL = 0;
	xtR = 0;
} else {
	// Fade: when the time changes, crossfade from the old tap to a tap at the new time.
	tsL = tgL;
	tsR = tgR;
	if (xfL == xtL) {
		actL = xtL > 0.5 ? tBL : tAL;
		if (abs(tgL - actL) > 0.5) {
			if (xtL > 0.5) {
				tAL = tgL;
				xtL = 0;
			} else {
				tBL = tgL;
				xtL = 1;
			}
		}
	}
	if (xfR == xtR) {
		actR = xtR > 0.5 ? tBR : tAR;
		if (abs(tgR - actR) > 0.5) {
			if (xtR > 0.5) {
				tAR = tgR;
				xtR = 0;
			} else {
				tBR = tgR;
				xtR = 1;
			}
		}
	}
}
xfL = xtL > xfL ? min(xfL + xfRate, xtL) : max(xfL - xfRate, xtL);
xfR = xtR > xfR ? min(xfR + xfRate, xtR) : max(xfR - xfRate, xtR);

// Freeze latches the loop period (the tap time in use, without the LFO / wobble) when it engages.
if (frz && frzPrev < 0.5) {
	frzTL = floor(max(tAL, tmin) * (1 - xfL) + max(tBL, tmin) * xfL + 0.5);
	frzTR = floor(max(tAR, tmin) * (1 - xfR) + max(tBR, tmin) * xfR + 0.5);
}
frzPrev = frz;

// Taps never read closer than tmin, even mid-glide.
dAL = max(tAL, tmin) + mL;
dBL = max(tBL, tmin) + mL;
dAR = max(tAR, tmin) + mR;
dBR = max(tBR, tmin) + mR;
tapL = herm(tank, 0, cn - dAL, TANK) * (1 - xfL);
if (xfL > 0) tapL = tapL + herm(tank, 0, cn - dBL, TANK) * xfL;
tapR = herm(tank, 1, cn - dAR, TANK) * (1 - xfR);
if (xfR > 0) tapR = tapR + herm(tank, 1, cn - dBR, TANK) * xfR;

// ---- tone: 12 dB/oct TPT SVF high-pass and low-pass with resonance, LFO-modulated cutoffs -----
// (Mid/Side: back to L/R first, so the chain always gets L/R)
if (mode == 2) {
	tmp = tapL + tapR;
	tapR = tapL - tapR;
	tapL = tmp;
}
fmL = clip(modfilt, 0, 1) * 2 * lL;
fmR = clip(modfilt, 0, 1) * 2 * lR;
hpK = 1.4142 * (1 - 0.95 * clip(hpres, 0, 1));
lpK = 1.4142 * (1 - 0.95 * clip(lpres, 0, 1));
// tan / pow only when a cutoff, the filter modulation or the rate changed (every sample only
// while the LFO moves the filter)
if (fmL != cFmL || fmR != cFmR || hp != cHp || lp != cLp || sr != cSr) {
	hpG = tan(pi * clip(hp * pow(2, fmL), 10, sr * 0.45) / sr);
	lpG = tan(pi * clip(lp * pow(2, fmL), 20, sr * 0.45) / sr);
	hpGR = tan(pi * clip(hp * pow(2, fmR), 10, sr * 0.45) / sr);
	lpGR = tan(pi * clip(lp * pow(2, fmR), 20, sr * 0.45) / sr);
	cFmL = fmL;
	cFmR = fmR;
	cHp = hp;
	cLp = lp;
	cSr = sr;
}
hpA1 = 1 / (1 + hpG * (hpG + hpK));
lpA1 = 1 / (1 + lpG * (lpG + lpK));
hpA1R = 1 / (1 + hpGR * (hpGR + hpK));
lpA1R = 1 / (1 + lpGR * (lpGR + lpK));

// high-pass L
v1 = (hpG * (tapL - hpL2) + hpL1) * hpA1;
v2 = hpL2 + hpG * v1;
hpL1 = 2 * v1 - hpL1;
hpL2 = 2 * v2 - hpL2;
yL = tapL - hpK * v1 - v2;
// high-pass R
w1 = (hpGR * (tapR - hpR2) + hpR1) * hpA1R;
w2 = hpR2 + hpGR * w1;
hpR1 = 2 * w1 - hpR1;
hpR2 = 2 * w2 - hpR2;
yR = tapR - hpK * w1 - w2;
// low-pass L
u1 = (lpG * (yL - lpL2) + lpL1) * lpA1;
u2 = lpL2 + lpG * u1;
lpL1 = 2 * u1 - lpL1;
lpL2 = 2 * u2 - lpL2;
zL = u2;
// low-pass R
q1 = (lpGR * (yR - lpR2) + lpR1) * lpA1R;
q2 = lpR2 + lpGR * q1;
lpR1 = 2 * q1 - lpR1;
lpR2 = 2 * q2 - lpR2;
zR = q2;

if (filton < 0.5) {
	zL = tapL;
	zR = tapR;
}
// Noise in the loop: hiss (morph 0) .. vinyl-style crackle (morph 1). Coefficients are cached;
// noise() itself stays per sample (two draws, L and R).
if (noiseon > 0.5 && noiseamt > 0) {
	crackle = crackle * 0.6;
	if (abs(noise()) > nzThrNow) crackle = noise();
	zL = zL + noise() * nzHissNow + crackle * nzCrkNow;
	zR = zR + noise() * nzHissNow + crackle * nzCrkNow;
}
hpL1 = fixdenorm(hpL1);
hpL2 = fixdenorm(hpL2);
hpR1 = fixdenorm(hpR1);
hpR2 = fixdenorm(hpR2);
lpL1 = fixdenorm(lpL1);
lpL2 = fixdenorm(lpL2);
lpR1 = fixdenorm(lpR1);
lpR2 = fixdenorm(lpR2);

outL = zL * gLink;
outR = zR * gLink;

// Spectrogram rings: wet (the tap after the filter) and dry (the input), mono.
specW = (outL + outR) * 0.5;
specD = (in1 + in2) * 0.5;
specI = wrap(cn, 0, 8192);
poke(spec, specW, 32 + specI);
poke(spec, specD, 8224 + specI);
specPk = max(specPk, abs(specW));
specPkD = max(specPkD, abs(specD));

// Whitened (first-difference) mono copy of what goes into the chain: End cross-correlates it with
// what comes out of the chain to find the exact counter offset K.
tapM = (outL + outR) * 0.5;
poke(xfer, tapM - ptap, ri, 4);
ptap = tapM;

// Unpaired (no End to mix): pass the dry signal so the track never goes silent.
out1 = paired ? fixnan(outL) : in1;
out2 = paired ? fixnan(outR) : in2;

// ---- telemetry ------------------------------------------------------------------------------
pkIn = max(pkIn, max(abs(in1), abs(in2)));
pkTL = max(pkTL, abs(outL));
pkTR = max(pkTR, abs(outR));
pkRL = max(pkRL, abs(retL));
pkRR = max(pkRR, abs(retR));
hIn = max(hIn, max(abs(in1), abs(in2)));
hTL = max(hTL, abs(outL));
hTR = max(hTR, abs(outR));
hBlk = hBlk + 1;
if (hBlk >= 256) {
	hb = 32 + 3 * hHead;
	poke(scope, hIn, hb);
	poke(scope, hTL, hb + 1);
	poke(scope, hTR, hb + 2);
	hHead = wrap(hHead + 1, 0, 512);
	poke(scope, hHead, 19);
	hBlk = 0;
	hIn = 0;
	hTL = 0;
	hTR = 0;
}
tick = tick + 1;
if (tick >= 64) {
	tick = 0;
	frames = wrap(frames + 1, 0, 1000000);
	poke(scope, max(tAL, tmin) * (1 - xfL) + max(tBL, tmin) * xfL, 0);
	poke(scope, max(tAR, tmin) * (1 - xfR) + max(tBR, tmin) * xfR, 1);
	poke(scope, clamped, 2);
	poke(scope, tmin, 3);
	poke(scope, bb, 4);
	poke(scope, kk, 5);
	poke(scope, ll, 6);
	poke(scope, paired, 8);
	poke(scope, pkIn, 9);
	poke(scope, pkTL, 10);
	poke(scope, pkTR, 11);
	poke(scope, pkRL, 12);
	poke(scope, pkRR, 13);
	poke(scope, frames, 14);
	poke(scope, sr, 15);
	poke(scope, frz, 16);
	poke(scope, peek(hdr, 16), 17);
	poke(scope, peek(hdr, 12), 18);
	poke(scope, tgL, 20);
	poke(scope, tgR, 21);
	poke(scope, lL, 24);
	poke(scope, lR, 25);
	poke(scope, envV, 26);
	poke(scope, gateG, 27);
	// The LED polls every 33 ms, so a single 64-sample window would mostly be missed: report the
	// deepest reduction of the last 32 windows (2048 samples) instead.
	clipAge = clipAge + 1;
	clipHold = (clipR <= clipHold || clipAge >= 32) ? clipR : clipHold;
	clipAge = clipR <= clipHold ? 0 : clipAge;
	// CLIP_DB: the only telemetry log. Not per sample (the envelope follower's atodb above tracks
	// the signal, so it cannot move onto this tick).
	poke(scope, atodb(max(clipHold, 0.000001)), 28);
	clipR = 1;
	poke(spec, wrap(cn + 1, 0, 8192), 0);
	poke(spec, sr, 1);
	poke(spec, specPk, 2);
	poke(spec, specPkD, 3);
	specPk = 0;
	specPkD = 0;
	pkIn = 0;
	pkTL = 0;
	pkTR = 0;
	pkRL = 0;
	pkRR = 0;
}
