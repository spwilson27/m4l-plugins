// Mega Modulator engine — 16 audio-rate modulators (LFO, Follower, Random, Steps, MSEG, ADSR, XY, Buttons) in one gen.codebox~ (hidden; audio is NOT routed through it).
//
// Inputs : in1/in2 = device audio (mono sum feeds the envelope followers). Transport arrives as Params
//          (hbpm, hppq, hplay) sent from plugsync~, and `rtrg` retrigger events.
// Cost notes: an EMPTY slot (type 0) refreshes only its type / enabled cells; a disabled slot (enabled < 0.5) skips every modulator
//          (LFO, Follower, Random, Steps, MSEG, ADSR, XY, Buttons) and outputs 0. Coefficients (exp / pow / log) are cached per slot in
//          Data ck / per route in Data rk and recomputed only when their inputs change, or on the control tick (every 32 samples) when the
//          input itself moves every sample (ADSR decay / release: a multiply of a cached exp step, resynced to exp(-5 * progress)).
//          The Random hash is cached per step. Telemetry of a slot is written only on the sample that publishes it.
// Outputs: out1..out32 = two signals per slot (out(2 * slot + o + 1), o = 0 output A, 1 output B), normalized -1..1. Only XY (A = X, B = Y) and Buttons (A = button 1,
//          B = button 2) make B different; every other type mirrors A on B.
//   Output convention: every generator yields u in 0..1.
//     bipolar  : out = depth * (2u - 1)
//     unipolar : out = 2 * depth * u - 1        (rests at -1, spans the full table range)
//   A disabled / empty slot outputs 0.
//
// buffer~ layouts (contract with src/megamod_config.js — tests/test_megamod.js parses the constants below):
//   cfg   (megamodcfg, 16 x CFG_STRIDE (32) floats): per slot
//     0 type (1 LFO, 2 Follower, 3 Random, 4 Steps, 5 MSEG, 6 ADSR, 7 XY, 8 Buttons)  1 enabled  2 rate Hz  3 sync  4 syncdiv  5 shape
//     6 phase  7 retrig  8 bipolar  9 depth  10 attack ms  11 release ms  12 gain dB  13 smooth  14 steps
//     15 glide  16 oneshot  17 seed  18 loopon  19 loopstart  20 loopend  21 decay ms  22 sustain  23 threshold dB  24 x  25 y  26 slew
//     ADSR: attack 10, decay 21, sustain 22, release 11, thresh 23, sync 3 = Trig (1 Threshold, 0 MIDI), retrig 7 (1 = restart from 0), oneshot 16 = Vel, bipolar 8.
//     XY: x 24, y 25, slew 26 (tau ms = 2000 * slew^2). Buttons: button 1 = sync (3), button 2 = bipolar (8), slew 26. XY / Buttons are always unipolar: 2 * depth * u - 1.
//   mseg  (megamodmseg, 16 x 1024): MSEG lookup tables, values 0..1
//   steps (megamodsteps, 16 x 32): step values 0..1
//   (Param ratemul = global rate multiplier, default 1)
//   scope (megamodscope, SCOPE_SAMPS = 640): per slot s at 4*s: [out, phase, u, aux] (ADSR: aux = stage + 10 * gate, phase = progress in the stage, u = level); output B of slot s at 576 + s; header from 64:
//     64 frame counter, 65 sample rate, 66 beat, 67 bpm, 68 playing
//     128 + 12*s + [0..4] effective (modulated) normalized value of the slot's generic controls A..E (0 when the type has no such control),
//     128 + 12*s + 5 effective On, 128 + 12*s + 6 + t effective switch t (shape 0..4, toggles 0/1)    (SCOPE_EFF)
//     320 + k effective Depth 0..1 of the mapping in pool slot k < 256                               (SCOPE_DEPTH)
//   ibuf  (megamodint, 512): the INTERNAL modulation matrix (self-mod, schema 9). Route r (0..63) at 4*r: [src + 1 (0 = off), dest code, 0, 0];
//     [256] = highest used route index + 1 (0 = no internal routes: the whole matrix is skipped);
//     [264 + (type*5 + j)*5 + {0..4}] = control descriptor of generic control j for modulator type 0..5: [CF field + 1 (0 = none), lo, hi, log, int];
//     [414 + t] = CF field + 1 of switch t (shape, sync, bipolar, retrig, oneshot, loopOn), [420 + t] = its max value (shape 4, toggles 1).
//   icurve (megamodicurve, 64 * 256): route r's 256-sample transfer table at r*256 (the router convention: index (x+1)/2 * 256, linear interpolation).
//   Dest codes (448): 0..95 = slot*6 + j (j 0..4 generic control A..E, j 5 = On), 96..191 = 96 + slot*6 + t (switch t), 192..447 = 192 + k (Depth of pool slot k, k 0..255:
//     a depth-modulation route, schema 10; the mapper aims it at the pool slot of its target mapping).
//   route (megamodroute, 1024): the router's buffer. [2k] source (routers), for EVERY pool slot k 0..255 (all 8 routers apply the Depth per sample):
//     [2k+1] = EFFECTIVE depth (this engine writes it: base * the PRODUCT of the depth routes' factors m = range * dep * y (unipolar, the mapper bakes the table), clipped 0..1), [512 + k] = base depth (mapper),
//     [768 + k] = Remote CENTRE (min + max) / 2 of that mapping, or -1 for a Mod mapping (the router then computes c + (T - c) * d instead of T * d).
//
// INTERNAL MODULATION (self-mod): per sample, each active route reads its source's PREVIOUS-sample output (the matrix runs before the slots,
// so loops between modulators are stable with one sample of delay), maps it through the route's table (o in -1..1 = the Mod offset in
// normalized knob space) and the offsets of all routes into one destination are SUMMED (a DEPTH destination 192+ instead MULTIPLIES the routes' baked unipolar factors m = range * dep * y (0..range) into the base depth, VCA-like). Numeric controls: normalized = curve(real value) (log
// for rate / attack / release, linear otherwise, the same curves as the UI knob), + offset, clipped 0..1, back to the real value
// (integer controls rounded) -> `cm`, the modulated copy of the config cache that the slots read. Toggles and On: on when the clipped
// normalized value + offset is above 0.5. Shape (enum): round(normalized * 4). All of these are evaluated PER SAMPLE. Depth: the effective
// depth is written per sample to route[2k+1] (the routers read it at their own block: a router sees the engine's last sample of a vector).
//
// Retrigger: Param rtrg = counter * 16 + slot. A changed value restarts that slot.
// MIDI (ADSR Trig = MIDI): Param mgate (any note held, 0 / 1), mtrig (a counter that changes on a note-on with no note held), mvel (that note's velocity 0..1); the v8ui keeps the held-note set.
// GenExpr ordering: helper functions, then Buffer / Param / History / Data, then expressions.
// No identifier is named e<digit>.

frac01(x) {
	return x - floor(x);
}

hash01(seed, idx) {
	return frac01(sin(idx * 12.9898 + seed * 78.233 + 1.2345) * 43758.5453);
}

lfoShape(shape, ph) {
	tri = (ph < 0.25) ? 0.5 + 2 * ph : ((ph < 0.75) ? 1.5 - 2 * ph : 2 * ph - 1.5);
	sq = (ph < 0.5) ? 1 : 0;
	r = 0;
	if (shape < 0.5 || shape > 4.5) {
		r = 0.5 + 0.5 * sin(twopi * ph);
	}
	r = (shape == 1) ? tri : r;
	r = (shape == 2) ? ph : r;
	r = (shape == 3) ? 1 - ph : r;
	r = (shape == 4) ? sq : r;
	return r;
}

glideVal(prev, cur, fr, g) {
	t = clip(fr / max(g, 0.0001), 0, 1);
	sm = t * t * (3 - 2 * t);
	r = (g <= 0.0001) ? cur : prev + (cur - prev) * sm;
	return r;
}

syncBeats(idx) {
	r = 1.0;
	r = (idx == 0) ? 0.0625 : r;
	r = (idx == 1) ? 0.125 : r;
	r = (idx == 2) ? 0.16666667 : r;
	r = (idx == 3) ? 0.25 : r;
	r = (idx == 4) ? 0.375 : r;
	r = (idx == 5) ? 0.33333333 : r;
	r = (idx == 6) ? 0.5 : r;
	r = (idx == 7) ? 0.75 : r;
	r = (idx == 8) ? 0.66666667 : r;
	r = (idx == 9) ? 1.0 : r;
	r = (idx == 10) ? 1.5 : r;
	r = (idx == 11) ? 2.0 : r;
	r = (idx == 12) ? 4.0 : r;
	r = (idx == 13) ? 8.0 : r;
	r = (idx == 14) ? 16.0 : r;
	r = (idx == 15) ? 32.0 : r;
	return r;
}

Buffer cfg("megamodcfg");
Buffer mseg("megamodmseg");
Buffer steps("megamodsteps");
Buffer scope("megamodscope");
Buffer ibuf("megamodint");
Buffer icurve("megamodicurve");
Buffer route("megamodroute");

Param hbpm(120);
Param hppq(0);
Param hplay(0);
Param rtrg(0);
Param ratemul(1);
Param mgate(0);
Param mtrig(0);
Param mvel(1);

Data cf(512);
Data cm(512);
Data dsum(512);
Data dcl(512);
Data dprd(512);
Data st(512);
Data outv(32);
// Per-slot coefficient cache, stride 32 (same index as st). Keyed values recompute when the inputs change; the ADSR
// running exponential resyncs on the control tick. Cells:
//   0..3 ADSR atk / dec / rel / sr keys   4..6 stage increments   7..8 exp(-5 * increment)   9 running exp(-5 * progress)
//   12..15 XY / Buttons slew: time, sample rate, coefficient, valid
//   16..19 free-running phase increment: rate, rate multiplier, sample rate, increment
//   20..21 synced division: index, length in beats
Data ck(512);
// Per internal route, stride 8: cached log/exp range conversion [draw, lo, hi, log, offset, value, valid, integer flag].
Data rk(512);

History beat(0);
History lastPpq(-1);
History lastPlay(0);
History lastRtrg(0);
History lastMtrig(0);
History lastMgate(0);
History prevMul(1);
History tick(0);
History cSr(0);
History cFastRel(0);
History cSlowCoef(0);
History frameCount(0);
History sampleCount(0);

sr = max(samplerate, 1);
mono = 0.5 * (in1 + in2);

// 1. Host transport -> beat position. Playing: re-lock to the host ppq whenever it changes, extrapolate
//    in between. Stopped: free-run at the tempo so synced modulators keep moving.
startEv = (hplay > 0.5 && lastPlay < 0.5) ? 1 : 0;
lastPlay = (hplay > 0.5) ? 1 : 0;
beatInc = max(hbpm, 1) / (60 * sr);
if (hplay > 0.5) {
	if (startEv > 0.5 || hppq != lastPpq) {
		beat = hppq;
		lastPpq = hppq;
	} else {
		beat = beat + beatInc;
	}
} else {
	beat = beat + beatInc;
	lastPpq = hppq;
}

// 2. Retrigger event (counter * 16 + slot).
rtEv = (rtrg != lastRtrg) ? 1 : 0;
rtSlot = rtrg - 16 * floor(rtrg / 16);
lastRtrg = rtrg;

// 2b. MIDI state from the v8ui (ADSR Trig = MIDI): mgate = any note held, mtrig = trigger counter (a note-on with no note held), mvel = that note's velocity 0..1.
mTrigEv = (mtrig != lastMtrig) ? 1 : 0;
lastMtrig = mtrig;
mOffEv = (mgate < 0.5 && lastMgate > 0.5) ? 1 : 0;
lastMgate = (mgate > 0.5) ? 1 : 0;
// ADSR threshold detector coefficients (shared by every ADSR slot): fast envelope release 15 ms, slow baseline 60 ms.
// (cached: recomputed only when the sample rate changes)
if (sr != cSr) {
	cSr = sr;
	cFastRel = exp(-1000 / (15 * sr));
	cSlowCoef = 1 - exp(-1000 / (60 * sr));
}
fastRel = cFastRel;
slowCoef = cSlowCoef;

// Global rate multiplier (Options panel): scales every LFO / Random / Steps / MSEG rate, free and synced; the follower ignores it.
// Free: the per-sample phase increment is rate * rmul / sr (the accumulator is continuous). Synced: phase = (beat - anchor) * rmul / div + off;
// when rmul changes, off absorbs the difference so the phase does not jump.
rmul = clip(ratemul, 0.05, 20);
mulChg = (abs(rmul - prevMul) > 0.0000001) ? 1 : 0;

// 3. Refresh one slot of the config cache per sample (full refresh every 16 samples).
// An EMPTY slot (type 0) only needs its type / enabled cells (every other field is unused until a type is set, and the type itself is refreshed here).
rs = sampleCount - 16 * floor(sampleCount / 16);
if (peek(cfg, rs * 32, 0) > 0.5) {
	for (k = 0; k < 32; k += 1) {
		poke(cf, peek(cfg, rs * 32 + k, 0), rs * 32 + k);
		poke(cm, peek(cfg, rs * 32 + k, 0), rs * 32 + k);
	}
} else {
	poke(cf, peek(cfg, rs * 32, 0), rs * 32);
	poke(cm, peek(cfg, rs * 32, 0), rs * 32);
	poke(cf, peek(cfg, rs * 32 + 1, 0), rs * 32 + 1);
	poke(cm, peek(cfg, rs * 32 + 1, 0), rs * 32 + 1);
}
sampleCount = sampleCount + 1;
// One sample in every 32. Curves whose input moves every sample (ADSR progress) resync here; keyed caches also
// refresh immediately when their inputs change, so a self-modulated rate is not held for a whole tick.
ctlTick = (sampleCount - 32 * floor(sampleCount / 32) < 0.5) ? 1 : 0;

// 3b. Depth refresh: one pool slot (of 256) per sample copies its base depth into the effective-depth cell (modulated slots are overwritten below).
dk = sampleCount - 256 * floor(sampleCount / 256);
poke(route, peek(route, 512 + dk, 0), 2 * dk + 1, 0);

// 3c. Internal modulation matrix (skipped entirely with no routes).
nHi = floor(peek(ibuf, 256, 0) + 0.5);
if (nHi > 0.5) {
	for (rt = 0; rt < 64; rt += 1) {
		if (rt < nHi) {
			dz = peek(ibuf, rt * 4 + 1, 0);
			poke(dsum, 0, dz);
			poke(dcl, 0, dz);
			poke(dprd, 1, dz);
		}
	}
	for (rt = 0; rt < 64; rt += 1) {
		if (rt < nHi) {
			sidx = peek(ibuf, rt * 4, 0);
			if (sidx > 0.5) {
				dst = peek(ibuf, rt * 4 + 1, 0);
				xv = peek(outv, sidx - 1);
				fi = clip((xv + 1) * 128, 0, 256);
				ia = min(floor(fi), 255);
				ib = min(ia + 1, 255);
				va = peek(icurve, rt * 256 + ia, 0);
				vb = peek(icurve, rt * 256 + ib, 0);
				poke(dsum, peek(dsum, dst) + va + (vb - va) * (fi - ia), dst);
				poke(dprd, peek(dprd, dst) * (va + (vb - va) * (fi - ia)), dst);
				poke(dcl, peek(dcl, dst) + 1, dst);
			}
		}
	}
	for (rt = 0; rt < 64; rt += 1) {
		if (rt < nHi) {
			dst = peek(ibuf, rt * 4 + 1, 0);
			if (peek(ibuf, rt * 4, 0) > 0.5 && peek(dcl, dst) > 0.5) {
				poke(dcl, -1, dst);
				dsm = peek(dsum, dst);
				if (dst < 96) {
					msl = floor(dst / 6);
					mjj = dst - msl * 6;
					if (mjj > 4.5) {
						poke(cm, (clip(peek(cf, msl * 32 + 1) + dsm, 0, 1) > 0.5) ? 1 : 0, msl * 32 + 1);
					} else {
						dpos = 264 + (peek(cf, msl * 32) * 5 + mjj) * 5;
						fld = peek(ibuf, dpos, 0) - 1;
						if (fld > -0.5) {
							dlo = peek(ibuf, dpos + 1, 0);
							dhi = peek(ibuf, dpos + 2, 0);
							dlg = peek(ibuf, dpos + 3, 0);
							dit = peek(ibuf, dpos + 4, 0);
							draw = peek(cf, msl * 32 + fld);
							rk0 = rt * 8;
							rkHit = 0;
							if (ctlTick < 0.5 && peek(rk, rk0 + 6) > 0.5) {
								if (peek(rk, rk0) == draw && peek(rk, rk0 + 1) == dlo && peek(rk, rk0 + 2) == dhi && peek(rk, rk0 + 3) == dlg && peek(rk, rk0 + 4) == dsm && peek(rk, rk0 + 7) == dit) {
									rkHit = 1;
								}
							}
							dvv = 0;
							if (rkHit > 0.5) {
								dvv = peek(rk, rk0 + 5);
							} else {
								nr = (dlg > 0.5) ? log(max(draw, dlo) / dlo) / log(dhi / dlo) : (draw - dlo) / (dhi - dlo);
								nr = clip(clip(nr, 0, 1) + dsm, 0, 1);
								dvv = (dlg > 0.5) ? dlo * exp(nr * log(dhi / dlo)) : dlo + (dhi - dlo) * nr;
								dvv = (dit > 0.5) ? floor(dvv + 0.5) : dvv;
								poke(rk, draw, rk0);
								poke(rk, dlo, rk0 + 1);
								poke(rk, dhi, rk0 + 2);
								poke(rk, dlg, rk0 + 3);
								poke(rk, dsm, rk0 + 4);
								poke(rk, dvv, rk0 + 5);
								poke(rk, 1, rk0 + 6);
								poke(rk, dit, rk0 + 7);
							}
							poke(cm, dvv, msl * 32 + fld);
						}
					}
				} else if (dst < 192) {
					mt2 = dst - 96;
					msl = floor(mt2 / 6);
					mtt = mt2 - msl * 6;
					fld = peek(ibuf, 490 + mtt, 0) - 1;
					mxv = peek(ibuf, 496 + mtt, 0);
					nr = clip(peek(cf, msl * 32 + fld) / mxv + dsm, 0, 1);
					poke(cm, (mtt < 0.5) ? floor(nr * mxv + 0.5) : ((nr > 0.5) ? 1 : 0), msl * 32 + fld);
				} else {
					dkk = dst - 192;
					poke(route, clip(peek(route, 512 + dkk, 0) * peek(dprd, dst), 0, 1), 2 * dkk + 1, 0);
				}
			}
		}
	}
}

// 4. Evaluate the slots. Telemetry timing: this sample publishes slot pubSl when pubOn (one slot every 4 samples, each slot every 64); its values are written inside the loop.
tickN = tick + 1;
ts = tickN - 64 * floor(tickN / 64);
pubSl = floor(ts / 4);
pubOn = (ts - 4 * floor(ts / 4) < 0.5) ? 1 : 0;
for (i = 0; i < 16; i += 1) {
	cb = i * 32;
	sb = i * 32;
	typ = peek(cf, cb);
	// enabled < 0.5, or an empty slot: skip LFO, Follower, Random, Steps, MSEG, ADSR, XY and Buttons, and output 0.
	active = (typ > 0.5 && peek(cm, cb + 1) > 0.5) ? 1 : 0;
	outSlot = 0;
	outSlotB = 0;
	uSlot = 0;
	phSlot = 0;
	auxSlot = 0;
	if (active > 0.5) {
		rate = peek(cm, cb + 2);
		syncOn = peek(cm, cb + 3);
		divIdx = peek(cm, cb + 4);
		if (ctlTick > 0.5 || peek(ck, sb + 20) != divIdx) {
			poke(ck, divIdx, sb + 20);
			dv = 1.0;
			dv = (divIdx == 0) ? 0.0625 : dv;
			dv = (divIdx == 1) ? 0.125 : dv;
			dv = (divIdx == 2) ? 0.16666667 : dv;
			dv = (divIdx == 3) ? 0.25 : dv;
			dv = (divIdx == 4) ? 0.375 : dv;
			dv = (divIdx == 5) ? 0.33333333 : dv;
			dv = (divIdx == 6) ? 0.5 : dv;
			dv = (divIdx == 7) ? 0.75 : dv;
			dv = (divIdx == 8) ? 0.66666667 : dv;
			dv = (divIdx == 9) ? 1.0 : dv;
			dv = (divIdx == 10) ? 1.5 : dv;
			dv = (divIdx == 11) ? 2.0 : dv;
			dv = (divIdx == 12) ? 4.0 : dv;
			dv = (divIdx == 13) ? 8.0 : dv;
			dv = (divIdx == 14) ? 16.0 : dv;
			dv = (divIdx == 15) ? 32.0 : dv;
			poke(ck, dv, sb + 21);
		}
		divBeats = peek(ck, sb + 21);
		shape = peek(cm, cb + 5);
		phaseOff = peek(cm, cb + 6);
		retrigOn = peek(cm, cb + 7);
		bipolar = peek(cm, cb + 8);
		depth = peek(cm, cb + 9);
		oneshot = peek(cm, cb + 16);

		// cycle accumulator (cycles, or steps for Steps)
		accFree = peek(st, sb);
		t0 = peek(st, sb + 1);
		restart = ((startEv > 0.5 && (retrigOn > 0.5 || oneshot > 0.5)) || (rtEv > 0.5 && rtSlot == i)) ? 1 : 0;
		if (restart > 0.5) {
			accFree = 0;
			t0 = beat;
			poke(st, 0, sb + 2);
			poke(st, 0, sb + 3);
		}
		if (ctlTick > 0.5 || peek(ck, sb + 16) != rate || peek(ck, sb + 17) != rmul || peek(ck, sb + 18) != sr) {
			poke(ck, rate, sb + 16);
			poke(ck, rmul, sb + 17);
			poke(ck, sr, sb + 18);
			poke(ck, rate * rmul / sr, sb + 19);
		}
		accFree = accFree + peek(ck, sb + 19);
		anchored = (retrigOn > 0.5 || oneshot > 0.5) ? t0 : 0;
		syncOff = peek(st, sb + 3);
		if (mulChg > 0.5) {
			syncOff = syncOff + (beat - anchored) / divBeats * (prevMul - rmul);
			poke(st, syncOff, sb + 3);
		}
		accv = (syncOn > 0.5) ? (beat - anchored) / divBeats * rmul + syncOff : accFree;
		poke(st, accFree, sb);
		poke(st, t0, sb + 1);

		u = 0;
		hasB = 0;
		uB = 0;
		if (typ < 1.5) {
			ph = frac01(accv + phaseOff);
			ph = (oneshot > 0.5 && accv >= 1) ? 0.999999999 : ph;
			u = lfoShape(floor(shape + 0.5), ph);
			phSlot = ph;
		} else if (typ < 2.5) {
			// attack / release coefficients and the gain are cached in st[sb + 16 .. 22] (keys, then values) and recomputed only when their inputs or the sample rate change
			atk = max(peek(cm, cb + 10), 0.05);
			rel = max(peek(cm, cb + 11), 0.5);
			gdbK = peek(cm, cb + 12) + 1000;
			if (peek(st, sb + 16) != atk || peek(st, sb + 17) != rel || peek(st, sb + 18) != gdbK || peek(st, sb + 22) != sr) {
				poke(st, atk, sb + 16);
				poke(st, rel, sb + 17);
				poke(st, gdbK, sb + 18);
				poke(st, sr, sb + 22);
				poke(st, exp(-1000 / (atk * sr)), sb + 19);
				poke(st, exp(-1000 / (rel * sr)), sb + 20);
				poke(st, pow(10, (gdbK - 1000) / 20), sb + 21);
			}
			xin = abs(mono) * peek(st, sb + 21);
			envPrev = peek(st, sb + 2);
			coef = (xin > envPrev) ? peek(st, sb + 19) : peek(st, sb + 20);
			envNow = xin + (envPrev - xin) * coef;
			envNow = (envNow < 1e-9) ? 0 : envNow;
			poke(st, envNow, sb + 2);
			u = clip(envNow, 0, 1);
			phSlot = u;
		} else if (typ < 3.5) {
			sm = peek(cm, cb + 13);
			seed = peek(cm, cb + 17);
			xr = accv + phaseOff;
			idxr = floor(xr);
			fr = xr - idxr;
			// the two hashes (a sin each) are cached per step in st[sb + 23 .. 27] (index, seed, current, previous, valid): hash01(seed, index) is a pure function of them.
			// (inlined, with no function call inside the if blocks: a call there silently broke the gen compile in Max 9)
			hCur = peek(st, sb + 25);
			hPrev = peek(st, sb + 26);
			if (peek(st, sb + 27) < 0.5 || peek(st, sb + 23) != idxr || peek(st, sb + 24) != seed) {
				if (peek(st, sb + 27) > 0.5 && peek(st, sb + 24) == seed && peek(st, sb + 23) == idxr - 1) {
					hPrev = hCur;
				} else {
					hv = sin((idxr - 1) * 12.9898 + seed * 78.233 + 1.2345) * 43758.5453;
					hPrev = hv - floor(hv);
				}
				hv = sin(idxr * 12.9898 + seed * 78.233 + 1.2345) * 43758.5453;
				hCur = hv - floor(hv);
				poke(st, hCur, sb + 25);
				poke(st, hPrev, sb + 26);
				poke(st, idxr, sb + 23);
				poke(st, seed, sb + 24);
				poke(st, 1, sb + 27);
			}
			u = glideVal(hPrev, hCur, fr, sm);
			phSlot = fr;
			auxSlot = idxr;
		} else if (typ < 4.5) {
			nSteps = clip(floor(peek(cm, cb + 14) + 0.5), 1, 32);
			gl = peek(cm, cb + 15);
			xs = accv + phaseOff * nSteps;
			xs = (oneshot > 0.5) ? min(xs, nSteps - 0.000000001) : xs;
			ks = floor(xs);
			fr = xs - ks;
			idxs = ks - nSteps * floor(ks / nSteps);
			prevIdx = (idxs < 0.5) ? nSteps - 1 : idxs - 1;
			curV = peek(steps, i * 32 + idxs, 0);
			prevV = peek(steps, i * 32 + prevIdx, 0);
			u = glideVal(prevV, curV, fr, gl);
			phSlot = (idxs + fr) / nSteps;
			auxSlot = idxs;
		} else if (typ < 5.5) {
			phm = (oneshot > 0.5) ? clip(accv, 0, 1) : frac01(accv + phaseOff);
			loopOn = peek(cm, cb + 18);
			ls = (loopOn > 0.5) ? peek(cm, cb + 19) : 0;
			le = (loopOn > 0.5) ? max(peek(cm, cb + 20), ls + 0.05) : 1;
			xm = ls + phm * (le - ls);
			fi = clip(xm, 0, 1) * 1023;
			i0 = floor(fi);
			i1 = min(1023, i0 + 1);
			v0 = peek(mseg, i * 1024 + i0, 0);
			v1 = peek(mseg, i * 1024 + i1, 0);
			u = v0 + (v1 - v0) * (fi - i0);
			phSlot = phm;
		} else if (typ < 6.5) {
			// ADSR: fixed-duration segments (attack / decay / release ms) with a mild concave attack and exponential decay / release, see src/megamod_config.js adsrStep (K = 5, attack power 1.6). Trigger = threshold onset on the
			// device input (Trig on) or the MIDI state (Trig off). Per-slot state: st[sb + 8..15] detector + envelope, st[sb + 5] release start level.
			aAtk = max(peek(cm, cb + 10), 0.05);
			aDec = max(peek(cm, cb + 21), 1);
			aSus = clip(peek(cm, cb + 22), 0, 1);
			aRel = max(peek(cm, cb + 11), 0.5);
			// Stage increments and exp(-5 * increment), cached until attack / decay / release / the sample rate change (also on the control tick).
			if (ctlTick > 0.5 || peek(ck, sb) != aAtk || peek(ck, sb + 1) != aDec || peek(ck, sb + 2) != aRel || peek(ck, sb + 3) != sr) {
				poke(ck, aAtk, sb);
				poke(ck, aDec, sb + 1);
				poke(ck, aRel, sb + 2);
				poke(ck, sr, sb + 3);
				aAtkInc = 1 / max(aAtk * sr / 1000, 1);
				aDecInc = 1 / max(aDec * sr / 1000, 1);
				aRelInc = 1 / max(aRel * sr / 1000, 1);
				poke(ck, aAtkInc, sb + 4);
				poke(ck, aDecInc, sb + 5);
				poke(ck, aRelInc, sb + 6);
				poke(ck, exp(-5 * aDecInc), sb + 7);
				poke(ck, exp(-5 * aRelInc), sb + 8);
			}
			aAtkInc = peek(ck, sb + 4);
			aDecInc = peek(ck, sb + 5);
			aRelInc = peek(ck, sb + 6);
			thrK = peek(cm, cb + 23) + 1000;
			if (peek(st, sb + 28) != thrK) {
				poke(st, thrK, sb + 28);
				poke(st, pow(10, peek(cm, cb + 23) / 20), sb + 29);
			}
			aThr = peek(st, sb + 29);
			aFast = peek(st, sb + 8);
			aSlow = peek(st, sb + 9);
			aArmed = peek(st, sb + 10);
			aGate = peek(st, sb + 11);
			aStage = peek(st, sb + 12);
			aLvl = peek(st, sb + 13);
			aProg = peek(st, sb + 14);
			aPeak = peek(st, sb + 15);
			aSeg = peek(st, sb + 5);
			aTrig = 0;
			aOff = 0;
			aVel = 1;
			if (syncOn > 0.5) {
				axx = abs(mono);
				aFast = (axx > aFast) ? axx : axx + (aFast - axx) * fastRel;
				aSlow = aSlow + (aFast - aSlow) * slowCoef;
				if (aArmed > 0.5 && aFast > aThr && aFast > aSlow * 2) {
					aTrig = 1;
					aArmed = 0;
					aGate = 1;
				} else if (aArmed < 0.5 && (aFast < aThr * 0.7 || aFast < aSlow * 1.2)) {
					aArmed = 1;
				}
				if (aGate > 0.5 && aFast < aThr * 0.5) {
					aGate = 0;
					aOff = 1;
				}
			} else {
				aTrig = mTrigEv;
				aOff = mOffEv;
				aVel = mvel;
				aGate = (mgate > 0.5) ? 1 : 0;
				aArmed = 1;
			}
			if (aTrig > 0.5) {
				aLvl = (retrigOn > 0.5) ? 0 : aLvl;
				aPeak = max((oneshot > 0.5) ? clip(aVel, 0, 1) : 1, 0.000001);
				aStage = 1;
				aSeg = aLvl;
				aProg = 0;
			} else if (aOff > 0.5 && aStage > 0.5 && aStage < 3.5) {
				aStage = 4;
				aSeg = max(aLvl, 0.000000001);
				aProg = 0;
			}
			if (aStage > 0.5 && aStage < 1.5) {
				aProg = aProg + aAtkInc;
				if (aProg >= 1) {
					aLvl = aPeak;
					aStage = 2;
					aProg = 0;
				} else {
					aLvl = aSeg + (aPeak - aSeg) * (1 - pow(1 - aProg, 1.6));
				}
			} else if (aStage > 1.5 && aStage < 2.5) {
				aTgt = aSus * aPeak;
				aEntered = (aProg < 0.000000001) ? 1 : 0;
				aProg = aProg + aDecInc;
				if (aProg >= 1) {
					aLvl = aTgt;
					aStage = 3;
					aProg = 0;
				} else {
					aRun = 0;
					if (aEntered > 0.5 || ctlTick > 0.5) {
						aRun = exp(-5 * aProg);
					} else {
						aRun = peek(ck, sb + 9) * peek(ck, sb + 7);
					}
					poke(ck, aRun, sb + 9);
					aLvl = aTgt + (aPeak - aTgt) * ((aRun - 0.006737946999085467) / 0.9932620530009145);
				}
			} else if (aStage > 2.5 && aStage < 3.5) {
				aLvl = aSus * aPeak;
			} else if (aStage > 3.5) {
				aEntered = (aProg < 0.000000001) ? 1 : 0;
				aProg = aProg + aRelInc;
				if (aProg >= 1) {
					aLvl = 0;
					aStage = 0;
					aProg = 0;
				} else {
					aRun = 0;
					if (aEntered > 0.5 || ctlTick > 0.5) {
						aRun = exp(-5 * aProg);
					} else {
						aRun = peek(ck, sb + 9) * peek(ck, sb + 8);
					}
					poke(ck, aRun, sb + 9);
					aLvl = aSeg * ((aRun - 0.006737946999085467) / 0.9932620530009145);
				}
			}
			poke(st, aFast, sb + 8);
			poke(st, aSlow, sb + 9);
			poke(st, aArmed, sb + 10);
			poke(st, aGate, sb + 11);
			poke(st, aStage, sb + 12);
			poke(st, aLvl, sb + 13);
			poke(st, aProg, sb + 14);
			poke(st, aPeak, sb + 15);
			poke(st, aSeg, sb + 5);
			u = clip(aLvl, 0, 1);
			phSlot = ((aStage < 0.5) || (aStage > 2.5 && aStage < 3.5)) ? 0 : clip(aProg, 0, 1);
			auxSlot = aStage + 10 * aGate;
		} else {
			// XY (type 7: out A = X, out B = Y) and Buttons (type 8: A = button 1 = Sync, B = button 2 = Bipolar field). One-pole slew, time constant 2000 * slew^2 ms.
			slw = clip(peek(cm, cb + 26), 0, 1);
			slwMs = slw * slw * 2000;
			slwC = 0;
			if (slwMs >= 0.05) {
				if (ctlTick > 0.5 || peek(ck, sb + 12) != slwMs || peek(ck, sb + 13) != sr || peek(ck, sb + 15) < 0.5) {
					poke(ck, slwMs, sb + 12);
					poke(ck, sr, sb + 13);
					poke(ck, exp(-1000 / (slwMs * sr)), sb + 14);
					poke(ck, 1, sb + 15);
				}
				slwC = peek(ck, sb + 14);
			}
			tgtA = (typ < 7.5) ? clip(peek(cm, cb + 24), 0, 1) : ((syncOn > 0.5) ? 1 : 0);
			tgtB = (typ < 7.5) ? clip(peek(cm, cb + 25), 0, 1) : ((peek(cm, cb + 8) > 0.5) ? 1 : 0);
			xyA = peek(st, sb + 8);
			xyB = peek(st, sb + 9);
			xyA = tgtA + (xyA - tgtA) * slwC;
			xyB = tgtB + (xyB - tgtB) * slwC;
			poke(st, xyA, sb + 8);
			poke(st, xyB, sb + 9);
			u = xyA;
			uB = xyB;
			hasB = 1;
			phSlot = xyB;
		}
		uSlot = u;
		bipEff = (typ > 6.5) ? 0 : bipolar;
		outSlot = (bipEff > 0.5) ? depth * (2 * u - 1) : 2 * depth * u - 1;
		outSlotB = (hasB > 0.5) ? 2 * depth * uB - 1 : outSlot;
	}
	// An inactive slot that was inactive on the previous sample leaves its outputs (zeros) alone; the sample it goes inactive writes the zeros once.
	if (active > 0.5 || peek(st, sb + 4) > 0.5) {
		poke(outv, fixnan(outSlot), 2 * i);
		poke(outv, fixnan(outSlotB), 2 * i + 1);
		poke(st, active, sb + 4);
	}
	if (pubOn > 0.5 && i == pubSl) {
		poke(scope, outSlot, i * 4, 0);
		poke(scope, phSlot, i * 4 + 1, 0);
		poke(scope, uSlot, i * 4 + 2, 0);
		poke(scope, auxSlot, i * 4 + 3, 0);
		poke(scope, outSlotB, 576 + i, 0);
	}
}

prevMul = rmul;

// 5. Telemetry: one slot every 4 samples (each slot refreshed every 64), header once per 64 samples.
tick = tickN;
if (pubOn > 0.5) {
	sl = pubSl;
	// effective (modulated) control values for the UI rings: normalized A..E, On, switches
	etyp = peek(cf, sl * 32);
	for (ej = 0; ej < 5; ej += 1) {
		edp = 264 + (etyp * 5 + ej) * 5;
		efp = peek(ibuf, edp, 0);
		effv = 0;
		if (efp > 0.5) {
			elo = peek(ibuf, edp + 1, 0);
			ehi = peek(ibuf, edp + 2, 0);
			eraw = peek(cm, sl * 32 + efp - 1);
			effv = (peek(ibuf, edp + 3, 0) > 0.5) ? log(max(eraw, elo) / elo) / log(ehi / elo) : (eraw - elo) / (ehi - elo);
			effv = clip(effv, 0, 1);
		}
		poke(scope, effv, 128 + sl * 12 + ej, 0);
	}
	poke(scope, peek(cm, sl * 32 + 1), 128 + sl * 12 + 5, 0);
	for (et = 0; et < 6; et += 1) {
		eswp = peek(ibuf, 490 + et, 0);
		poke(scope, (eswp > 0.5) ? peek(cm, sl * 32 + eswp - 1) : 0, 128 + sl * 12 + 6 + et, 0);
	}
}
poke(scope, peek(route, 2 * ts + 1, 0), 320 + ts, 0);
poke(scope, peek(route, 2 * (ts + 64) + 1, 0), 384 + ts, 0);
poke(scope, peek(route, 2 * (ts + 128) + 1, 0), 448 + ts, 0);
poke(scope, peek(route, 2 * (ts + 192) + 1, 0), 512 + ts, 0);
if (ts < 0.5) {
	frameCount = frameCount + 1;
	poke(scope, frameCount, 64, 0);
	poke(scope, sr, 65, 0);
	poke(scope, beat, 66, 0);
	poke(scope, hbpm, 67, 0);
	poke(scope, (hplay > 0.5) ? 1 : 0, 68, 0);
}

out1 = peek(outv, 0);
out2 = peek(outv, 1);
out3 = peek(outv, 2);
out4 = peek(outv, 3);
out5 = peek(outv, 4);
out6 = peek(outv, 5);
out7 = peek(outv, 6);
out8 = peek(outv, 7);
out9 = peek(outv, 8);
out10 = peek(outv, 9);
out11 = peek(outv, 10);
out12 = peek(outv, 11);
out13 = peek(outv, 12);
out14 = peek(outv, 13);
out15 = peek(outv, 14);
out16 = peek(outv, 15);
out17 = peek(outv, 16);
out18 = peek(outv, 17);
out19 = peek(outv, 18);
out20 = peek(outv, 19);
out21 = peek(outv, 20);
out22 = peek(outv, 21);
out23 = peek(outv, 22);
out24 = peek(outv, 23);
out25 = peek(outv, 24);
out26 = peek(outv, 25);
out27 = peek(outv, 26);
out28 = peek(outv, 27);
out29 = peek(outv, 28);
out30 = peek(outv, 29);
out31 = peek(outv, 30);
out32 = peek(outv, 31);
