// Lifter — an EQ for the quefrency axis (stereo).
// scripts/build_lifter.py PREPENDS src/cepstrum_lib.genexpr to this file, so the
// cep_* / fft_* / stft_* functions are already defined above everything here.
//
// Per hop (N / 4 samples), per channel:
//   frame -> FFT -> real cepstrum c[q] -> pitch peak (lft_pitch) ->
//   delta[q] = (gain[q] - 1) * c[q], smoothed over time ->
//   FFT(delta) = change of log|X| (soft-limited) -> scale X by exp(change) ->
//   one per-frame factor restores the frame energy (Whisper keeps its loudness) ->
//   the original phase stays -> inverse FFT -> overlap-add.
// Working on the DELTA (not on the whole cepstrum) keeps a flat curve an exact
// identity at every Smooth setting: delta = 0, exp(0) = 1.
//
// gain[q] = 10^(curve_dB(x) * Depth / 20), x = log(q / (sr * 0.2 ms)) / log(200),
// so the curve spans 0.2 ms .. 40 ms of quefrency whatever the sample rate or Size.
// With Track on, q is scaled by (5 ms / detected pitch period) first, so the
// pitch peak always lands on the 5 ms marker (x = 0.6074).
//
// Latency: the STFT lags N - 1 samples; a Delay pads every Size to a constant 4096
// samples (patcher "latency": 4096). The dry path is delayed by the same 4096.
//
// Buffer lcurve("liftercurve"), bound with `lcurve #0-liftercurve`:
//   frames 0..255, ch 1 = curve in dB (-24..+24) on the log-quefrency axis, written by the v8ui.
// Buffer lscope("lifterscope"), bound with `lscope #0-lifterscope` (1 channel, 512 frames):
//   0..127   |c| input cepstrum, max per display column (display axis = tracked axis)
//   128..255 |c| after the lifter
//   256..319 input spectrum (dB re a full-scale sine), 64 log columns 30 Hz..20 kHz, -999 = no bin
//   320..383 output spectrum, same layout
//   384 pitch period (samples, smoothed) 385 confidence 386 hop counter (not advanced when silent)
//   387 input peak 388 output peak 389 samplerate 390 N 391 Track 392 silent flag 393 quefrency used as marker
//
// Maintenance invariants:
// 1. Every function sits before every Param / Buffer / Data / History / Delay.
// 2. Never name an identifier e + digits (GenExpr reads Euler's constant).
// 3. Work functions are called as bare statements (an unused result is removed).
// 4. `phi` (1.618), `pi`, `e` ... are GenExpr constants: never use them as variable names.
// 5. A variable assigned inside an if block is NOT seen after it (measured in Max 9.1): use
//    ternaries (x = cond ? a : x) for every value that is needed after the block.

// Linear interpolation of the 256-point dB table cvd at x in 0..1.
lft_interp(cvd, x) {
	p = clip(x, 0, 1) * 255;
	i0 = floor(p);
	i1 = min(i0 + 1, 255);
	fr = p - i0;
	return cvd.peek(i0) * (1 - fr) + cvd.peek(i1) * fr;
}

// Gain factor gtab[q] and display column gcol[q] (0..127) for q = 0..n/2.
lft_build(cvd, gtab, gcol, n, sr, scl, depth) {
	half = n * 0.5;
	base = sr * 0.0002;
	for (q = 0; q <= half; q += 1) {
		x = log(max(q, 0.5) * scl / base) * 0.18873916581775485;
		db = lft_interp(cvd, x) * depth;
		gtab.poke(exp(db * 0.11512925464970229), q);
		gcol.poke(clip(floor(x * 128), 0, 127), q);
	}
	return 0;
}

// Replace fc (the real cepstrum) by the smoothed delta cepstrum and keep the
// telemetry maxima for the display (left channel only, wtm = 1).
lft_apply(fc, gtab, gcol, smv, tele, n, a, wtm) {
	half = n * 0.5;
	fc.poke(0, 0, 0);
	fc.poke(0, 0, 1);
	for (q = 1; q <= half; q += 1) {
		c = fc.peek(q, 0);
		sd = a * smv.peek(q) + (1 - a) * (gtab.peek(q) - 1) * c;
		smv.poke(sd, q);
		fc.poke(sd, q, 0);
		fc.poke(0, q, 1);
		if (q < half) {
			fc.poke(sd, n - q, 0);
			fc.poke(0, n - q, 1);
		}
		if (wtm > 0.5) {
			col = gcol.peek(q);
			tele.poke(max(tele.peek(col), abs(c)), col);
			tele.poke(max(tele.peek(128 + col), abs(c + sd)), 128 + col);
		}
	}
	return 0;
}

// fc.re now holds the change of log|X| per bin. Scale the spectrum by its soft-limited
// exponential (phase untouched), then by one factor per frame that restores the frame's
// energy, so Whisper does not get quieter and Robot does not explode (a flat curve
// leaves every bin alone and the factor is exactly 1). Left channel also records the
// input / output spectrum columns. fc channel 1 holds the per-bin change meanwhile.
lft_remag(fx, fc, tele, n, lim, ndb, sr, wtm) {
	half = n * 0.5;
	dfs = sr / n;
	ein = 0;
	eout = 0;
	for (i = 0; i < n; i += 1) {
		xr = fx.peek(i, 0);
		xi = fx.peek(i, 1);
		m2 = xr * xr + xi * xi;
		gd = lim * tanh(fc.peek(i, 0) / lim);
		fc.poke(gd, i, 1);
		ein += m2;
		eout += m2 * exp(2 * gd);
	}
	nf = (ein > 1e-18 && eout > 1e-30) ? clip(sqrt(ein / max(eout, 1e-30)), 0.001, 1000) : 1;
	nfd = log(nf);
	for (i = 0; i < n; i += 1) {
		xr = fx.peek(i, 0);
		xi = fx.peek(i, 1);
		gd = fc.peek(i, 1) + nfd;
		if (wtm > 0.5 && i >= 1 && i <= half) {
			mg = sqrt(xr * xr + xi * xi);
			ldb = log(mg + 1e-9) * 8.685889638065035 - ndb;
			sc = floor(log(i * dfs / 30) * 9.842721836);
			if (sc >= 0 && sc < 64) {
				tele.poke(max(tele.peek(256 + sc), ldb), 256 + sc);
				tele.poke(max(tele.peek(320 + sc), ldb + gd * 8.685889638065035), 320 + sc);
			}
		}
		g = exp(gd);
		fx.poke(xr * g, i, 0);
		fx.poke(xi * g, i, 1);
	}
	return 0;
}

// Everything after the cepstrum (and the pitch measurement, done in the main body with the
// library's cep_peak calls, as in tests/cepstrum_lib_core.genexpr) up to the inverse FFT.
lft_rest(fx, fc, tab, smv, gtab, gcol, tele, n, a, wtm, lim, ndb, sr) {
	lft_apply(fc, gtab, gcol, smv, tele, n, a, wtm);
	cep_to_logmag(fc, tab, n);
	lft_remag(fx, fc, tele, n, lim, ndb, sr, wtm);
	return 0;
}

// Per hop: copy the curve buffer into cvd and reset the telemetry maxima.
// (No for loop may sit in the main body: it breaks fft_init's compile in Max 9.)
lft_prep(cbuf, cvd, tele, n) {
	nc = min(256, n);
	nt = min(384, n);
	for (zi = 0; zi < nc; zi += 1) {
		cvd.poke(peek(cbuf, zi, 0), zi);
		tele.poke(0, zi);
	}
	for (zi = nc; zi < nt; zi += 1) {
		tele.poke(-999, zi);
	}
	return 0;
}

// Write the telemetry traces (frames 0..383) to the scope buffer.
lft_write(sbuf, tele, n) {
	nt = min(384, n);
	for (zi = 0; zi < nt; zi += 1) {
		poke(sbuf, tele.peek(zi), zi, 0);
	}
	return 0;
}

Param sizei(1);
Param depthp(100);
Param smoothp(20);
Param wetp(100);
Param outdb(0);
Param trackp(0);

Buffer lcurve("liftercurve");
Buffer lscope("lifterscope");

Data tab(4096, 3);
Data win(4096);
Data fx(4096, 2);
Data fc(4096, 2);
Data ringL(4096);
Data accL(4096);
Data stL(8);
Data smL(4096);
Data ringR(4096);
Data accR(4096);
Data stR(8);
Data smR(4096);
Data gtab(2049);
Data gcol(2049);
Data cvd(256);
Data tele(512);
Data pst(32);
Delay padL(4096);
Delay padR(4096);
Delay dryL(4200);
Delay dryR(4200);
History hq(0);
History hc(0);
History hr(0);
History qc(0);
History pki(0);
History pko(0);
History hopc(0);
History nprev(0);
History swc(0);
History lwL(0);
History lwR(0);
History efL(0);
History efR(0);

sr = samplerate;
n = pow(2, 9 + clip(round(sizei), 0, 3));
fft_init(tab);
stft_win(win, n);

xin = max(abs(in1), abs(in2));
qc = (xin < 0.000001) ? min(qc + 1, 100000000) : 0;
pki = max(pki, xin);

// A new Size invalidates the stored (smoothed) cepstral delta: stL[5] = 1 makes the next
// processed hop skip the smoothing (it then overwrites every slot it will use). No clear
// loop: in Max 9.1 a loop that pokes a constant into smL / smR fails to compile at random
// ("undeclared identifier 'v_40'").
if (n != stL.peek(4)) {
	stL.poke(1, 5);
	stL.poke(n, 4);
	stR.poke(n, 4);
}

rdyL = stft_in(ringL, stL, in1, n);
rdyR = stft_in(ringR, stR, in2, n);

if (rdyL * rdyR > 0.5) {
	if (qc >= n) {
		// The whole frame is silent: skip all FFT work, output stays exactly 0.
		stL.poke(1, 5);
		poke(lscope, 1, 392, 0);
		poke(lscope, 0, 387, 0);
		poke(lscope, 0, 388, 0);
		poke(lscope, sr, 389, 0);
		poke(lscope, n, 390, 0);
		poke(lscope, trackp, 391, 0);
	} else {
		sm01 = clip(smoothp * 0.01, 0, 1);
		a = (sm01 < 0.001) ? 0 : exp(-(n * 0.25 / sr) / (0.4 * sm01));
		a = (stL.peek(5) > 0.5) ? 0 : a;
		stL.poke(0, 5);
		depth = clip(depthp * 0.01, -1, 1);
		qref = sr * 0.005;
		qp = pst.peek(6);
		qp = (qp < 1) ? qref : qp;
		pst.poke(qp, 6);
		qpuse = (trackp > 0.5) ? qp : qref;
		scl = qref / qpuse;
		ndb = 8.685889638065035 * log(n * 0.25);
		qlo = floor(sr * 0.002);
		qhi = max(min(floor(sr * 0.02), n * 0.5 - 2), qlo + 9);

		lft_prep(lcurve, cvd, tele, n);
		lft_build(cvd, gtab, gcol, n, sr, scl, depth);

		stft_frame(fx, ringL, stL, win, n);
		fft_run(fx, tab, n, 0);
		cep_from_spec(fx, fc, tab, n, 1e-9);
		// pitch peak: lib calls at the main level (same pattern as the lib's real-Max test),
		// results go to persistent Data slots; pst[5] / pst[7] are debug (fc[240], raw argmax)
		hq = cep_peak(fc, qlo, qhi);
		hc = cep_peak_conf(fc, hq, qlo, qhi);
		hr = cep_peak_refine(fc, hq);
		pst.poke(hr, 0);
		pst.poke(hc, 1);
		pst.poke(fc.peek(240, 0), 5);
		pst.poke(hq, 7);
		lft_rest(fx, fc, tab, smL, gtab, gcol, tele, n, a, 1, 4.6, ndb, sr);
		fft_run(fx, tab, n, 1);
		stft_ola(accL, stL, fx, win, n);

		stft_frame(fx, ringR, stR, win, n);
		fft_run(fx, tab, n, 0);
		cep_from_spec(fx, fc, tab, n, 1e-9);
		lft_rest(fx, fc, tab, smR, gtab, gcol, tele, n, a, 0, 4.6, ndb, sr);
		fft_run(fx, tab, n, 1);
		stft_ola(accR, stR, fx, win, n);

		// Pitch for Track: the more confident channel, smoothed, held when unsure.
		cb = pst.peek(1);
		qb = pst.peek(0);
		qp = (cb > 0.25 && qb > 1) ? qp * 0.65 + qb * 0.35 : qp;
		pst.poke(qp, 6);

		lft_write(lscope, tele, n);
		hopc = hopc + 1;
		poke(lscope, qp, 384, 0);
		poke(lscope, cb, 385, 0);
		poke(lscope, hopc, 386, 0);
		poke(lscope, pki, 387, 0);
		poke(lscope, pko, 388, 0);
		poke(lscope, sr, 389, 0);
		poke(lscope, n, 390, 0);
		poke(lscope, trackp, 391, 0);
		poke(lscope, 0, 392, 0);
		poke(lscope, qpuse, 393, 0);
		poke(lscope, pst.peek(7), 394, 0);
		poke(lscope, pst.peek(5), 395, 0);
	}
	pki = 0;
	pko = 0;
}

yl = stft_out(accL, stL, n);
yr = stft_out(accR, stR, n);
padL.write(yl);
padR.write(yr);
wl = padL.read(4096 - (n - 1));
wr = padR.read(4096 - (n - 1));
dryL.write(in1);
dryR.write(in2);
dl = dryL.read(4096);
dr = dryR.read(4096);

// Size change: the STFT restarts (silent for N - 1 samples) and the pad delay
// reads from a new offset, so the wet path is garbage for 4096 samples. Hold the
// last wet sample and fade it to the dry signal over 128 samples, play dry, then
// fade the new wet in over 512 samples. Every step is continuous.
swc = (n != nprev) ? 0 : min(swc + 1, 100000);
nprev = n;
lwL = (swc == 0) ? efL : lwL;
lwR = (swc == 0) ? efR : lwR;
ff = clip(1 - swc / 128, 0, 1);
gg = clip((swc - 4096) / 512, 0, 1);
effL = dl + (lwL - dl) * ff + (wl - dl) * gg;
effR = dr + (lwR - dr) * ff + (wr - dr) * gg;
efL = effL;
efR = effR;

mxv = clip(wetp * 0.01, 0, 1);
og = exp(outdb * 0.11512925464970229);
out1 = (dl + (effL - dl) * mxv) * og;
out2 = (dr + (effR - dr) * mxv) * og;
pko = max(pko, max(abs(out1), abs(out2)));
