// EQ+ — 8-band cascaded biquad equalizer.
//
// The face owns RBJ coefficient design (src/eqplus_config.js eqpBiquadCoeffs)
// and pokes one normalized biquad per band. This core only runs those
// sections, so the DSP magnitude is the same biquad the curve evaluates,
// repeated `sections` times (1, 2 or 4).
//
// Bind on loadbang with the GenExpr names (no `set` prefix):
//   eqcfg ---eqpluscfg, spec ---eqplusspec, irspec ---eqplusir
//
// Processing mode (Param phaseMode): 0 zero latency, 1 natural phase,
// 2 linear phase. Natural phase is the biquad cascade, a 128-tap
// minimum-phase correction (irspec channel 1), then
// floor(322 * samplerate / 44100 + 0.5) samples of delay (7.3 ms).
// Linear phase overlap-adds a 2048-tap IR (irspec channel 0, peak at
// sample 1025) with a 4096-point FFT and a hop of 2048. The peak
// reaches the output at sample 3072, Pro-Q 3's Linear Phase Low figure
// at 44.1 kHz. Bypass and solo use that same delay so PDC matches.
// The FFT runs only while Linear Phase is selected (or still fading
// out). Running it in Zero Latency stalled the audio thread: four
// 4096-point transforms land on one sample every hop, and Live drops
// the channel. irGen bumps when the face pokes a new IR. There is one
// fft_run call site. fft_init / fft_run come from cepstrum_lib.
//
// eqcfg ("eqpluscfg"), 128 floats. Curve A is band b at base = b * 8
// (the left channel, or the mid). Curve B is the same layout at base + 64
// (the right channel, or the side). Param chroute: 0 Stereo, 1 Left,
// 2 Right, 3 Mid, 4 Side. Stereo processes both channels with curve A and
// does not read past sample 63, so a 64-sample buffer still works. Split
// routes slew curve B from sample 64. Mid and Side encode before the
// filters and decode the wet output.
//   +0 sections (0 = bypass, else 1 / 2 / 4 identical biquads)
//   +1 b0  +2 b1  +3 b2  +4 a1  +5 a2     a0 is already 1
//
// Inputs: in1/in2 main L/R (the only samples that reach out1/out2),
// in3/in4 sidechain L/R (reference spectrum only).
//
// spec ("eqplusspec"), 8200 frames:
//   ch 0  pre mono at 8+writeIdx. Frame 0 holds the write index, frame 1 the sample rate.
//   ch 1  post mono at 8+writeIdx. Frame 0 holds the heartbeat.
//   ch 2  metadata: index 0 frameTick, index 1 writeIdx, index 2 samplerate.
//   ch 3  sidechain mono, at writeIdx and at 8+writeIdx.
//
// zstate: 32 sections (8 bands x 4) of Direct Form II Transposed
//   (s1L, s2L, s1R, s2R), index (b * 4 + s) * 4.
// cstate: smoothed coefficients, curve A at base = b * 8 and curve B at base + 64.
//   +0 b0 +1 b1 +2 b2 +3 a1 +4 a2 +5 active (1 once the band has snapped in)
// Linear phase keeps curve B's spectrum in hreB (irspec channel 0 at sample
// 2048). Natural phase reads curve B's 128 taps from irspec channel 1 at
// sample 128. A linked route pokes the same IR at both offsets.
//
// Coefficients slew at 0.995 / 0.005 so a sweep does not zipper. The first
// sample a band turns on snaps to the target and the section state is zero,
// so enable does not fade in from a silent biquad.
//
// Band audition (the speaker icon): Param soloBand is -1 off, or 0..7.
// The face sends the matching eqpSoloBandCoeffs() biquad as soloB0, soloB1,
// soloB2, soloA1, soloA2 (set those before raising soloBand). While solo is
// on, the dry input replaces the EQ output through that one bandpass.
// soloZ holds its DF2T state (s1L, s2L, s1R, s2R). Leaving solo clears it.
//
// Flat tilt (Param tiltOn): nine first-order low shelves, one per octave,
// then a makeup gain so 1 kHz stays at 0 dB. The face designs them
// (eqpTiltCoeffs) and sends tGain plus t0b0, t0b1, t0a1 ... t8b0, t8b1, t8a1.
// tiltC holds 27 coefficients and the gain at index 27. tiltZ holds one
// state per channel per section (18). Coeffs slew at 0.995 / 0.005. Engaging
// the tilt snaps and clears the state. It runs before the solo replacement.
//
// GenExpr rules: helpers (none) would sit above Buffer / Data / Param /
// History; no identifier is e followed by digits; no return inside a block.

Buffer eqcfg("eqpluscfg");
Buffer spec("eqplusspec");
Buffer irspec("eqplusir");

Data zstate(128);
Data cstate(128);
Data yRun(2);
Data soloZ(4);
Data tiltZ(18);
Data tiltC(28);
Data tab(4096, 3);
Data fx(4096, 2);
Data latRingL(8192);
Data latRingR(8192);
Data accL(8192);
Data accR(8192);
Data hre(4096);
Data him(4096);
Data htRe(4096);
Data htIm(4096);
Data hreB(4096);
Data himB(4096);
Data htReB(4096);
Data htImB(4096);
Data nfirL(128);
Data nfirR(128);

Param outgain(0, min=-24, max=24);
Param tiltOn(0, min=0, max=1);
Param tGain(1, min=0.02, max=80);
Param t0b0(1, min=-8, max=8);
Param t0b1(0, min=-8, max=8);
Param t0a1(0, min=-8, max=8);
Param t1b0(1, min=-8, max=8);
Param t1b1(0, min=-8, max=8);
Param t1a1(0, min=-8, max=8);
Param t2b0(1, min=-8, max=8);
Param t2b1(0, min=-8, max=8);
Param t2a1(0, min=-8, max=8);
Param t3b0(1, min=-8, max=8);
Param t3b1(0, min=-8, max=8);
Param t3a1(0, min=-8, max=8);
Param t4b0(1, min=-8, max=8);
Param t4b1(0, min=-8, max=8);
Param t4a1(0, min=-8, max=8);
Param t5b0(1, min=-8, max=8);
Param t5b1(0, min=-8, max=8);
Param t5a1(0, min=-8, max=8);
Param t6b0(1, min=-8, max=8);
Param t6b1(0, min=-8, max=8);
Param t6a1(0, min=-8, max=8);
Param t7b0(1, min=-8, max=8);
Param t7b1(0, min=-8, max=8);
Param t7a1(0, min=-8, max=8);
Param t8b0(1, min=-8, max=8);
Param t8b1(0, min=-8, max=8);
Param t8a1(0, min=-8, max=8);
Param bypass(0, min=0, max=1);
Param soloBand(-1, min=-1, max=7);
Param soloB0(0, min=-4, max=4);
Param soloB1(0, min=-4, max=4);
Param soloB2(0, min=-4, max=4);
Param soloA1(0, min=-4, max=4);
Param soloA2(0, min=-4, max=4);
Param phaseMode(0, min=0, max=2);
Param chroute(0, min=0, max=4);
Param irGen(0, min=0, max=1000000);

History initDone(0);
History writeIdx(0);
History frameTick(0);
History linGain(1);
History soloWas(0);
History soloSb0(0);
History soloSb1(0);
History soloSb2(0);
History soloSa1(0);
History soloSa2(0);
History tiltWas(0);
History hopT(0);
History nfirPos(0);
History irSeen(-1);
History irHave(0);
History g0(1);
History g1(0);
History g2(0);
History mixSnap(0);
History bootMode(-1);
History olaWarm(0);
History fftWas(0);

Delay natDL(4096);
Delay natDR(4096);
Delay dryDL(8192);
Delay dryDR(8192);
Delay audDL(8192);
Delay audDR(8192);

xL = in1;
xR = in2;
preMono = 0.5 * (xL + xR);
scMono = 0.5 * (in3 + in4);

if (initDone < 0.5) {
	for (i = 0; i < 128; i += 1) {
		poke(zstate, 0, i);
	}
	for (i = 0; i < 128; i += 1) {
		poke(cstate, 0, i);
	}
	for (i = 0; i < 4; i += 1) {
		poke(soloZ, 0, i);
	}
	for (i = 0; i < 18; i += 1) {
		poke(tiltZ, 0, i);
	}
	for (i = 0; i < 28; i += 1) {
		poke(tiltC, 0, i);
	}
	for (i = 0; i < 128; i += 1) {
		poke(nfirL, 0, i);
		poke(nfirR, 0, i);
	}
	for (i = 0; i < 4096; i += 1) {
		poke(fx, 0, i, 0);
		poke(fx, 0, i, 1);
	}
	soloWas = 0;
	tiltWas = 0;
	linGain = dbtoa(clip(outgain, -24, 24));
	writeIdx = 0;
	frameTick = 0;
	initDone = 1;
}

gTarget = dbtoa(clip(outgain, -24, 24));
linGain = linGain * 0.995 + gTarget * 0.005;

// A plain `yL = xL` aliases the const inlet, so later writes to yL are
// dropped and the EQ passes the dry signal (or, once a NaN aliases in,
// fixnan turns the whole channel into silence). The running sample lives
// in yRun. Copies go through `* 1` for the same reason.
// Stereo (0) shares curve A. Left/Right/Mid/Side give the right slot curve B.
// The same filter on mid and side is the same filter on L and R, which is
// why Stereo does not encode. dom0/dom1 are copied through `* 1` so they
// are not aliases of the inlets.
msOn = chroute > 2.5;
msG = 0.7071067811865475;
// Assign before the branch. A name first written inside an if is local
// to that block, and the later biquad / convolver reads would not compile.
dom0 = xL * 1;
dom1 = xR * 1;
if (msOn > 0.5) {
	dom0 = (xL + xR) * msG;
	dom1 = (xL - xR) * msG;
}
slot = chroute * 1;
if (msOn > 0.5) {
	slot = chroute - 2;
}
useB = slot > 0.5;
poke(yRun, dom0, 0);
poke(yRun, dom1, 1);

for (band = 0; band < 8; band += 1) {
	base = band * 8;
	baseB = base + 64;
	nSec = fixnan(peek(eqcfg, base, 0));
	tb0 = fixnan(peek(eqcfg, base + 1, 0));
	tb1 = fixnan(peek(eqcfg, base + 2, 0));
	tb2 = fixnan(peek(eqcfg, base + 3, 0));
	ta1 = fixnan(peek(eqcfg, base + 4, 0));
	ta2 = fixnan(peek(eqcfg, base + 5, 0));
	nSecB = nSec * 1;
	tb0B = tb0 * 1;
	tb1B = tb1 * 1;
	tb2B = tb2 * 1;
	ta1B = ta1 * 1;
	ta2B = ta2 * 1;
	if (useB > 0.5) {
		nSecB = fixnan(peek(eqcfg, baseB, 0));
		tb0B = fixnan(peek(eqcfg, baseB + 1, 0));
		tb1B = fixnan(peek(eqcfg, baseB + 2, 0));
		tb2B = fixnan(peek(eqcfg, baseB + 3, 0));
		ta1B = fixnan(peek(eqcfg, baseB + 4, 0));
		ta2B = fixnan(peek(eqcfg, baseB + 5, 0));
	}
	cb0 = 1;
	cb1 = 0;
	cb2 = 0;
	ca1 = 0;
	ca2 = 0;
	cb0B = 1;
	cb1B = 0;
	cb2B = 0;
	ca1B = 0;
	ca2B = 0;
	if (nSec > 0.5) {
		wasOn = peek(cstate, base + 5);
		cb0 = peek(cstate, base) * 1;
		cb1 = peek(cstate, base + 1) * 1;
		cb2 = peek(cstate, base + 2) * 1;
		ca1 = peek(cstate, base + 3) * 1;
		ca2 = peek(cstate, base + 4) * 1;
		if (wasOn < 0.5) {
			cb0 = tb0 * 1;
			cb1 = tb1 * 1;
			cb2 = tb2 * 1;
			ca1 = ta1 * 1;
			ca2 = ta2 * 1;
			zClear = band * 16;
			for (kk = 0; kk < 4; kk += 1) {
				poke(zstate, 0, zClear + kk * 4);
				poke(zstate, 0, zClear + kk * 4 + 1);
			}
		} else {
			cb0 = cb0 * 0.995 + tb0 * 0.005;
			cb1 = cb1 * 0.995 + tb1 * 0.005;
			cb2 = cb2 * 0.995 + tb2 * 0.005;
			ca1 = ca1 * 0.995 + ta1 * 0.005;
			ca2 = ca2 * 0.995 + ta2 * 0.005;
		}
		poke(cstate, cb0, base);
		poke(cstate, cb1, base + 1);
		poke(cstate, cb2, base + 2);
		poke(cstate, ca1, base + 3);
		poke(cstate, ca2, base + 4);
		poke(cstate, 1, base + 5);
	} else {
		if (peek(cstate, base + 5) > 0.5) {
			poke(cstate, 0, base + 5);
			zClear = band * 16;
			for (kk = 0; kk < 4; kk += 1) {
				poke(zstate, 0, zClear + kk * 4);
				poke(zstate, 0, zClear + kk * 4 + 1);
			}
		}
	}
	if (nSecB > 0.5) {
		wasOnB = peek(cstate, baseB + 5);
		cb0B = peek(cstate, baseB) * 1;
		cb1B = peek(cstate, baseB + 1) * 1;
		cb2B = peek(cstate, baseB + 2) * 1;
		ca1B = peek(cstate, baseB + 3) * 1;
		ca2B = peek(cstate, baseB + 4) * 1;
		if (wasOnB < 0.5) {
			cb0B = tb0B * 1;
			cb1B = tb1B * 1;
			cb2B = tb2B * 1;
			ca1B = ta1B * 1;
			ca2B = ta2B * 1;
			zClear = band * 16;
			for (kk = 0; kk < 4; kk += 1) {
				poke(zstate, 0, zClear + kk * 4 + 2);
				poke(zstate, 0, zClear + kk * 4 + 3);
			}
		} else {
			cb0B = cb0B * 0.995 + tb0B * 0.005;
			cb1B = cb1B * 0.995 + tb1B * 0.005;
			cb2B = cb2B * 0.995 + tb2B * 0.005;
			ca1B = ca1B * 0.995 + ta1B * 0.005;
			ca2B = ca2B * 0.995 + ta2B * 0.005;
		}
		poke(cstate, cb0B, baseB);
		poke(cstate, cb1B, baseB + 1);
		poke(cstate, cb2B, baseB + 2);
		poke(cstate, ca1B, baseB + 3);
		poke(cstate, ca2B, baseB + 4);
		poke(cstate, 1, baseB + 5);
	} else {
		if (peek(cstate, baseB + 5) > 0.5) {
			poke(cstate, 0, baseB + 5);
			zClear = band * 16;
			for (kk = 0; kk < 4; kk += 1) {
				poke(zstate, 0, zClear + kk * 4 + 2);
				poke(zstate, 0, zClear + kk * 4 + 3);
			}
		}
	}
	nRun = 0;
	nRunB = 0;
	if (nSec > 0.5) {
		nRun = clip(floor(nSec + 0.5), 1, 4);
	}
	if (nSecB > 0.5) {
		nRunB = clip(floor(nSecB + 0.5), 1, 4);
	}
	if (nRun + nRunB > 0.5) {
		for (sec = 0; sec < 4; sec += 1) {
			runL = sec < nRun;
			runR = sec < nRunB;
			zBase = (band * 4 + sec) * 4;
			s1L = peek(zstate, zBase) * 1;
			s2L = peek(zstate, zBase + 1) * 1;
			s1R = peek(zstate, zBase + 2) * 1;
			s2R = peek(zstate, zBase + 3) * 1;
			xInL = peek(yRun, 0);
			xInR = peek(yRun, 1);
			yOutL = cb0 * xInL + s1L;
			yOutR = cb0B * xInR + s1R;
			s1Ln = cb1 * xInL - ca1 * yOutL + s2L;
			s2Ln = cb2 * xInL - ca2 * yOutL;
			s1Rn = cb1B * xInR - ca1B * yOutR + s2R;
			s2Rn = cb2B * xInR - ca2B * yOutR;
			poke(zstate, runL * fixdenorm(s1Ln), zBase);
			poke(zstate, runL * fixdenorm(s2Ln), zBase + 1);
			poke(zstate, runR * fixdenorm(s1Rn), zBase + 2);
			poke(zstate, runR * fixdenorm(s2Rn), zBase + 3);
			poke(yRun, fixnan(runL * yOutL + (1 - runL) * xInL), 0);
			poke(yRun, fixnan(runR * yOutR + (1 - runR) * xInR), 1);
		}
	}
}
yL = peek(yRun, 0) * 1;
yR = peek(yRun, 1) * 1;

if (tiltOn > 0.5) {
	if (tiltWas < 0.5) {
		poke(tiltC, t0b0, 0);
		poke(tiltC, t0b1, 1);
		poke(tiltC, t0a1, 2);
		poke(tiltC, t1b0, 3);
		poke(tiltC, t1b1, 4);
		poke(tiltC, t1a1, 5);
		poke(tiltC, t2b0, 6);
		poke(tiltC, t2b1, 7);
		poke(tiltC, t2a1, 8);
		poke(tiltC, t3b0, 9);
		poke(tiltC, t3b1, 10);
		poke(tiltC, t3a1, 11);
		poke(tiltC, t4b0, 12);
		poke(tiltC, t4b1, 13);
		poke(tiltC, t4a1, 14);
		poke(tiltC, t5b0, 15);
		poke(tiltC, t5b1, 16);
		poke(tiltC, t5a1, 17);
		poke(tiltC, t6b0, 18);
		poke(tiltC, t6b1, 19);
		poke(tiltC, t6a1, 20);
		poke(tiltC, t7b0, 21);
		poke(tiltC, t7b1, 22);
		poke(tiltC, t7a1, 23);
		poke(tiltC, t8b0, 24);
		poke(tiltC, t8b1, 25);
		poke(tiltC, t8a1, 26);
		poke(tiltC, tGain, 27);
		for (k = 0; k < 18; k += 1) {
			poke(tiltZ, 0, k);
		}
	} else {
		poke(tiltC, peek(tiltC, 0) * 0.995 + t0b0 * 0.005, 0);
		poke(tiltC, peek(tiltC, 1) * 0.995 + t0b1 * 0.005, 1);
		poke(tiltC, peek(tiltC, 2) * 0.995 + t0a1 * 0.005, 2);
		poke(tiltC, peek(tiltC, 3) * 0.995 + t1b0 * 0.005, 3);
		poke(tiltC, peek(tiltC, 4) * 0.995 + t1b1 * 0.005, 4);
		poke(tiltC, peek(tiltC, 5) * 0.995 + t1a1 * 0.005, 5);
		poke(tiltC, peek(tiltC, 6) * 0.995 + t2b0 * 0.005, 6);
		poke(tiltC, peek(tiltC, 7) * 0.995 + t2b1 * 0.005, 7);
		poke(tiltC, peek(tiltC, 8) * 0.995 + t2a1 * 0.005, 8);
		poke(tiltC, peek(tiltC, 9) * 0.995 + t3b0 * 0.005, 9);
		poke(tiltC, peek(tiltC, 10) * 0.995 + t3b1 * 0.005, 10);
		poke(tiltC, peek(tiltC, 11) * 0.995 + t3a1 * 0.005, 11);
		poke(tiltC, peek(tiltC, 12) * 0.995 + t4b0 * 0.005, 12);
		poke(tiltC, peek(tiltC, 13) * 0.995 + t4b1 * 0.005, 13);
		poke(tiltC, peek(tiltC, 14) * 0.995 + t4a1 * 0.005, 14);
		poke(tiltC, peek(tiltC, 15) * 0.995 + t5b0 * 0.005, 15);
		poke(tiltC, peek(tiltC, 16) * 0.995 + t5b1 * 0.005, 16);
		poke(tiltC, peek(tiltC, 17) * 0.995 + t5a1 * 0.005, 17);
		poke(tiltC, peek(tiltC, 18) * 0.995 + t6b0 * 0.005, 18);
		poke(tiltC, peek(tiltC, 19) * 0.995 + t6b1 * 0.005, 19);
		poke(tiltC, peek(tiltC, 20) * 0.995 + t6a1 * 0.005, 20);
		poke(tiltC, peek(tiltC, 21) * 0.995 + t7b0 * 0.005, 21);
		poke(tiltC, peek(tiltC, 22) * 0.995 + t7b1 * 0.005, 22);
		poke(tiltC, peek(tiltC, 23) * 0.995 + t7a1 * 0.005, 23);
		poke(tiltC, peek(tiltC, 24) * 0.995 + t8b0 * 0.005, 24);
		poke(tiltC, peek(tiltC, 25) * 0.995 + t8b1 * 0.005, 25);
		poke(tiltC, peek(tiltC, 26) * 0.995 + t8a1 * 0.005, 26);
		poke(tiltC, peek(tiltC, 27) * 0.995 + tGain * 0.005, 27);
	}
	tiltWas = 1;
	tg = peek(tiltC, 27);
	for (s = 0; s < 9; s += 1) {
		cBase = s * 3;
		cb0 = peek(tiltC, cBase);
		cb1 = peek(tiltC, cBase + 1);
		ca1 = peek(tiltC, cBase + 2);
		zBase = s * 2;
		s1L = peek(tiltZ, zBase);
		s1R = peek(tiltZ, zBase + 1);
		xInL = yL * 1;
		xInR = yR * 1;
		yL = cb0 * xInL + s1L;
		yR = cb0 * xInR + s1R;
		s1Ln = cb1 * xInL - ca1 * yL;
		s1Rn = cb1 * xInR - ca1 * yR;
		poke(tiltZ, fixdenorm(s1Ln), zBase);
		poke(tiltZ, fixdenorm(s1Rn), zBase + 1);
	}
	yL = yL * tg;
	yR = yR * tg;
} else {
	if (tiltWas > 0.5) {
		tiltWas = 0;
		for (k = 0; k < 18; k += 1) {
			poke(tiltZ, 0, k);
		}
	}
}

eqL = yL * 1;
eqR = yR * 1;

if (soloBand > -0.5) {
	ub0 = fixnan(soloB0);
	ub1 = fixnan(soloB1);
	ub2 = fixnan(soloB2);
	ua1 = fixnan(soloA1);
	ua2 = fixnan(soloA2);
	if (soloWas < 0.5) {
		soloSb0 = ub0;
		soloSb1 = ub1;
		soloSb2 = ub2;
		soloSa1 = ua1;
		soloSa2 = ua2;
		for (k = 0; k < 4; k += 1) {
			poke(soloZ, 0, k);
		}
	} else {
		soloSb0 = soloSb0 * 0.995 + ub0 * 0.005;
		soloSb1 = soloSb1 * 0.995 + ub1 * 0.005;
		soloSb2 = soloSb2 * 0.995 + ub2 * 0.005;
		soloSa1 = soloSa1 * 0.995 + ua1 * 0.005;
		soloSa2 = soloSa2 * 0.995 + ua2 * 0.005;
	}
	soloWas = 1;
	s1L = peek(soloZ, 0);
	s2L = peek(soloZ, 1);
	s1R = peek(soloZ, 2);
	s2R = peek(soloZ, 3);
	xInL = dom0 * 1;
	xInR = dom1 * 1;
	yL = soloSb0 * xInL + s1L;
	yR = soloSb0 * xInR + s1R;
	s1Ln = soloSb1 * xInL - soloSa1 * yL + s2L;
	s2Ln = soloSb2 * xInL - soloSa2 * yL;
	s1Rn = soloSb1 * xInR - soloSa1 * yR + s2R;
	s2Rn = soloSb2 * xInR - soloSa2 * yR;
	poke(soloZ, fixdenorm(s1Ln), 0);
	poke(soloZ, fixdenorm(s2Ln), 1);
	poke(soloZ, fixdenorm(s1Rn), 2);
	poke(soloZ, fixdenorm(s2Rn), 3);
} else {
	if (soloWas > 0.5) {
		soloWas = 0;
		for (k = 0; k < 4; k += 1) {
			poke(soloZ, 0, k);
		}
	}
}

audL = yL * 1;
audR = yR * 1;
soloOn = soloBand > -0.5;

nfirPos = mod(nfirPos + 1, 128);
poke(nfirL, eqL, nfirPos);
poke(nfirR, eqR, nfirPos);
firL = eqL * 1;
firR = eqR * 1;
runFir = 0;
if (phaseMode > 0.5 && phaseMode < 1.5) {
	runFir = 1;
}
if (g1 > 0.001) {
	runFir = 1;
}
if (runFir > 0.5 && irGen > 0.5) {
	firL = 0;
	firR = 0;
	for (i = 0; i < 128; i += 1) {
		tap = peek(irspec, i, 1);
		tapR = peek(irspec, 128 + i, 1);
		idx = nfirPos - i;
		if (idx < 0) {
			idx = idx + 128;
		}
		firL = firL + tap * peek(nfirL, idx);
		firR = firR + tapR * peek(nfirR, idx);
	}
}

olaL = 0;
olaR = 0;
doFft = 0;
if (phaseMode >= 1.5) {
	doFft = 1;
}
if (g2 > 0.001) {
	doFft = 1;
}
if (doFft > 0.5) {
	if (fftWas < 0.5) {
		hopT = 0;
		olaWarm = 0;
		irHave = 0;
		for (p = 0; p < 8192; p += 1) {
			poke(accL, 0, p);
			poke(accR, 0, p);
		}
	}
	fftWas = 1;
	fft_init(tab);
	ringAt = mod(hopT, 8192);
	poke(latRingL, dom0 * 1, ringAt);
	poke(latRingR, dom1 * 1, ringAt);
	irChanged = (abs(irGen - irSeen) > 0.5) * (irGen > 0.5);
	needUnity = (irHave < 0.5) * (irChanged < 0.5);
	hopNow = (hopT >= 2047) * (mod(hopT, 2048) == 2047);
	if (hopNow > 0.5 && irHave > 0.5) {
		for (p = 0; p < 4096; p += 1) {
			poke(hre, peek(hre, p) * 0.5 + peek(htRe, p) * 0.5, p);
			poke(him, peek(him, p) * 0.5 + peek(htIm, p) * 0.5, p);
			poke(hreB, peek(hreB, p) * 0.5 + peek(htReB, p) * 0.5, p);
			poke(himB, peek(himB, p) * 0.5 + peek(htImB, p) * 0.5, p);
		}
	}
	// One fft_run call site. job 0 plants a unity impulse, job 1 loads
	// curve A's IR, job 2 loads curve B's IR (irspec channel 0 at sample
	// 2048), jobs 3..6 are the L/R forward and inverse of this hop.
	// The loop counter is not a name fft_run writes.
	firstIr = irHave < 0.5;
	for (job = 0; job < 7; job += 1) {
		go = 0;
		inv = 0;
		kind = 0;
		if (job < 0.5 && needUnity > 0.5) {
			kind = 1;
			go = 1;
			for (p = 0; p < 4096; p += 1) {
				poke(fx, 0, p, 0);
				poke(fx, 0, p, 1);
			}
			poke(fx, 1, 1025, 0);
		}
		if (job > 0.5 && job < 1.5 && irChanged > 0.5) {
			kind = 2;
			go = 1;
			for (p = 0; p < 4096; p += 1) {
				poke(fx, 0, p, 0);
				poke(fx, 0, p, 1);
			}
			for (p = 0; p < 2048; p += 1) {
				poke(fx, peek(irspec, p, 0), p, 0);
			}
		}
		if (job > 1.5 && job < 2.5 && irChanged > 0.5) {
			kind = 7;
			go = 1;
			for (p = 0; p < 4096; p += 1) {
				poke(fx, 0, p, 0);
				poke(fx, 0, p, 1);
			}
			for (p = 0; p < 2048; p += 1) {
				poke(fx, peek(irspec, 2048 + p, 0), p, 0);
			}
		}
		if (job > 2.5 && job < 3.5 && hopNow > 0.5) {
			kind = 3;
			go = 1;
			frm = hopT - 2047;
			for (p = 0; p < 4096; p += 1) {
				poke(fx, 0, p, 0);
				poke(fx, 0, p, 1);
			}
			for (p = 0; p < 2048; p += 1) {
				poke(fx, peek(latRingL, mod(frm + p, 8192)), p, 0);
			}
		}
		if (job > 3.5 && job < 4.5 && hopNow > 0.5) {
			kind = 4;
			go = 1;
			inv = 1;
			for (p = 0; p < 4096; p += 1) {
				reBin = peek(fx, p, 0);
				imBin = peek(fx, p, 1);
				reIr = peek(hre, p);
				imIr = peek(him, p);
				poke(fx, reBin * reIr - imBin * imIr, p, 0);
				poke(fx, reBin * imIr + imBin * reIr, p, 1);
			}
		}
		if (job > 4.5 && job < 5.5 && hopNow > 0.5) {
			kind = 5;
			go = 1;
			frm = hopT - 2047;
			for (p = 0; p < 4096; p += 1) {
				poke(fx, 0, p, 0);
				poke(fx, 0, p, 1);
			}
			for (p = 0; p < 2048; p += 1) {
				poke(fx, peek(latRingR, mod(frm + p, 8192)), p, 0);
			}
		}
		if (job > 5.5 && job < 6.5 && hopNow > 0.5) {
			kind = 6;
			go = 1;
			inv = 1;
			for (p = 0; p < 4096; p += 1) {
				reBin = peek(fx, p, 0);
				imBin = peek(fx, p, 1);
				reIr = peek(hreB, p);
				imIr = peek(himB, p);
				poke(fx, reBin * reIr - imBin * imIr, p, 0);
				poke(fx, reBin * imIr + imBin * reIr, p, 1);
			}
		}
		if (go > 0.5) {
			fft_run(fx, tab, 4096, inv);
		}
		if (go > 0.5 && kind > 0.5 && kind < 1.5) {
			for (p = 0; p < 4096; p += 1) {
				poke(hre, peek(fx, p, 0), p);
				poke(him, peek(fx, p, 1), p);
				poke(htRe, peek(fx, p, 0), p);
				poke(htIm, peek(fx, p, 1), p);
				poke(hreB, peek(fx, p, 0), p);
				poke(himB, peek(fx, p, 1), p);
				poke(htReB, peek(fx, p, 0), p);
				poke(htImB, peek(fx, p, 1), p);
			}
			irHave = 1;
		}
		if (go > 0.5 && kind > 1.5 && kind < 2.5) {
			for (p = 0; p < 4096; p += 1) {
				poke(htRe, peek(fx, p, 0), p);
				poke(htIm, peek(fx, p, 1), p);
			}
			if (irHave < 0.5) {
				for (p = 0; p < 4096; p += 1) {
					poke(hre, peek(htRe, p), p);
					poke(him, peek(htIm, p), p);
				}
				irHave = 1;
			}
			irSeen = irGen;
		}
		if (go > 0.5 && kind > 6.5 && kind < 7.5) {
			for (p = 0; p < 4096; p += 1) {
				poke(htReB, peek(fx, p, 0), p);
				poke(htImB, peek(fx, p, 1), p);
			}
			if (firstIr > 0.5) {
				for (p = 0; p < 4096; p += 1) {
					poke(hreB, peek(htReB, p), p);
					poke(himB, peek(htImB, p), p);
				}
			}
		}
		if (go > 0.5 && kind > 3.5 && kind < 4.5) {
			frm = hopT - 2047;
			for (p = 0; p < 4096; p += 1) {
				accAt = mod(frm + p, 8192);
				poke(accL, peek(accL, accAt) + peek(fx, p, 0), accAt);
			}
		}
		if (go > 0.5 && kind > 5.5 && kind < 6.5) {
			frm = hopT - 2047;
			for (p = 0; p < 4096; p += 1) {
				accAt = mod(frm + p, 8192);
				poke(accR, peek(accR, accAt) + peek(fx, p, 0), accAt);
			}
		}
	}
	if (hopT >= 2047) {
		outAt = mod(hopT - 2047, 8192);
		olaL = peek(accL, outAt) * 1;
		olaR = peek(accR, outAt) * 1;
		poke(accL, 0, outAt);
		poke(accR, 0, outAt);
	}
	if (hopT >= 3072) {
		olaWarm = 1;
	}
	hopT = hopT + 1;
} else {
	fftWas = 0;
	hopT = 0;
	olaWarm = 0;
}

natSamps = floor(322 * samplerate / 44100 + 0.5);
if (natSamps < 1) {
	natSamps = 1;
}
if (natSamps > 4000) {
	natSamps = 4000;
}
nFeedL = firL * 1;
nFeedR = firR * 1;
if (soloOn > 0.5) {
	nFeedL = audL * 1;
	nFeedR = audR * 1;
}
if (bypass > 0.5) {
	nFeedL = xL * 1;
	nFeedR = xR * 1;
}
natDL.write(nFeedL);
natDR.write(nFeedR);
nDelL = natDL.read(natSamps, interp="linear");
nDelR = natDR.read(natSamps, interp="linear");
dryDL.write(xL);
dryDR.write(xR);
dryLatL = dryDL.read(3072, interp="linear");
dryLatR = dryDR.read(3072, interp="linear");
audDL.write(audL);
audDR.write(audR);
audLatL = audDL.read(3072, interp="linear");
audLatR = audDR.read(3072, interp="linear");

if (bootMode < -0.5) {
	bootMode = phaseMode * 1;
}
want0 = phaseMode < 0.5;
want1 = (phaseMode >= 0.5) * (phaseMode < 1.5);
want2 = phaseMode >= 1.5;
// Switching into Linear waits until the convolver's first delayed sample
// exists, so the crossfade does not drop into a cold accumulator.
// A device that loaded already in Linear snaps straight onto that path.
if (want2 > 0.5 && bootMode < 1.5 && olaWarm < 0.5) {
	want2 = 0;
	want0 = 1;
}
if (mixSnap < 0.5) {
	g0 = want0 * 1;
	g1 = want1 * 1;
	g2 = want2 * 1;
	mixSnap = 1;
} else {
	g0 = g0 + (want0 - g0) * 0.08;
	g1 = g1 + (want1 - g1) * 0.08;
	g2 = g2 + (want2 - g2) * 0.08;
}
// Branch-free mix. An if/else that multiplies the three paths does not compile
// in Max 9 (clang: assignment to const inlets in1/in2). Each path is fixnan'd
// first: 0 * NaN is NaN, and that used to silence the whole channel.
wet = bypass < 0.5;
solo = wet * (soloOn > 0.5);
zL = fixnan((1 - wet) * xL + wet * audL * linGain);
zR = fixnan((1 - wet) * xR + wet * audR * linGain);
nL = fixnan((1 - wet) * nDelL + wet * nDelL * linGain);
nR = fixnan((1 - wet) * nDelR + wet * nDelR * linGain);
lL = fixnan((1 - wet) * dryLatL + wet * linGain * (solo * audLatL + (1 - solo) * olaL));
lR = fixnan((1 - wet) * dryLatR + wet * linGain * (solo * audLatR + (1 - solo) * olaR));
yL = fixnan(fixdenorm(g0 * zL + g1 * nL + g2 * lL));
yR = fixnan(fixdenorm(g0 * zR + g1 * nR + g2 * lR));
// Decode only the wet mix. Bypass already holds the dry L/R pair, and
// decoding that would turn a stereo bypass into mid/side.
if (msOn > 0.5 && wet > 0.5) {
	midSig = yL * 1;
	sideSig = yR * 1;
	yL = (midSig + sideSig) * msG;
	yR = (midSig - sideSig) * msG;
}

postMono = 0.5 * (yL + yR);
poke(spec, preMono, 8 + writeIdx, 0);
poke(spec, postMono, 8 + writeIdx, 1);
poke(spec, scMono, 8 + writeIdx, 3, 0);
writeIdx = mod(writeIdx + 1, 8192);
if (mod(writeIdx, 64) == 0) {
	frameTick = mod(frameTick + 1, 16777216);
	poke(spec, writeIdx, 0, 0);
	poke(spec, frameTick, 0, 1);
	poke(spec, samplerate, 1, 0);
	poke(spec, frameTick, 0, 2, 0);
	poke(spec, writeIdx, 1, 2, 0);
	poke(spec, samplerate, 2, 2, 0);
}

out1 = yL;
out2 = yR;
