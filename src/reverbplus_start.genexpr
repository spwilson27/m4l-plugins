// Reverb+ (Start) — the reverb engine. Sits first in a rack chain: [Reverb+] [user FX ...] [Reverb+ End].
//
// Start outputs ONLY the reverb wet (plus the recirculating chain loop below) into the chain when an End is paired. End mixes it
// with the latency-aligned dry (Dry/Wet, Output, Ducking) and writes the processed wet back into `xfer`. Unpaired, the Start is a
// plain reverb: dry and wet are mixed here (Dry/Wet, Output; no ducking).
//
// The chain is truly IN the reverb's feedback (AGENTS.md section 27): the return does NOT go through the tank (its resonance peaks
// would force a tiny gain). It goes through a recirculating path with a FLAT magnitude response:
//   return -> delay (period - B - L) -> 4 Schroeder allpasses per channel (|H| = 1) -> HF damping (one-pole, |H| <= 1)
//          -> bass shelf (FDN algorithms, <= g^(1/bass - 1)) -> gain g -> clip (safety) -> added to the chain input
//   g      = min(10^(-3 period / Decay), 0.97)            (so |loop| <= g^(1/bass) < 1 for a unity chain, at every frequency)
//   period = K[algo] x the tank's characteristic period, never below MIN
//   chain input = wet x sqrt(1 - g^2) + loop   (the tank runs at Decay x 0.3 while paired; the sqrt keeps the wet's total energy that of
//            the tank alone, since the recirculations add 1 / (1 - g^2))
// The tank itself is fed from the input only (feed-forward), so its colour is the first pass and the loop carries the long tail.
//
// Cross-device timing is the Delay+ machinery (src/delayplus_start.genexpr / delayplus_end.genexpr): both
// devices run a free counter mod M; K / B calibration; L = chain latency (poked by the face into hdr[30]).
//   A wet sample emitted at Start sample s returns from End at Start sample s + L + B. The outer loop
//   period is the derived loop time: the return is written into `lpr` when it arrives and read back
//   (period - B - L) samples later, so it enters the tank exactly `period` samples after it was emitted.
//   period >= B + L + 4 ("MIN" in the header).
//
// hdr (shared, 64 samples): 0 cS, 1 cE, 2 K, 3 B, 4 L, 5 Dry/Wet (0..1), 6 Ducking (0..1), 12 End wet peak,
//   13 freeze, 14 Start sees End, 15 End sees Start, 16 End duck gain, 17 / 19 End out peak L / R,
//   18 K calibrated, 20..24 diagnostics, 30 L (poked by the face), 32 IR version, 33 IR bank, 34 head
//   partitions, 35 tail partitions, 36 IR length, 37 IR loaded, 38 IR channels, 39 IR sample-rate mismatch,
//   40 duck release ms, 41 output gain (linear).
// xfer (shared, 5 ch x 65536): ch0/1 dry at Start index, ch2/3 return at End index, ch4 whitened mono wet.
// scope: see RP_SCOPE in src/reverbplus_config.js.
// spec: 0 write head (0..4095), 1 sr, 2 / 3 wet / dry peak, 32.. wet ring, 4128.. dry ring (4096 each).
//
// Algorithms (Algorithm param, index order fixed): 0 Plate (Dattorro figure-8 tank), 1 Hall (16-line FDN),
// 2 Room (8-line FDN + early reflections), 3 Chamber (8-line FDN, dense early cluster), 4 Spring
// (two dispersive allpass loops), 5 Convolution (src/reverbplus_conv.genexpr). Only the selected one runs.
// Algorithm changes: fade out 40 ms, clear (sliced), rebuild the line layout, fade in 40 ms.
//
// GenExpr: functions first, then declarations, then statements. No identifier e<digit>. No early return.
// A user function call is never nested in a poke() argument.

wd(x, m) {
	y = x;
	if (y >= m * 0.5) y = y - m;
	if (y < -m * 0.5) y = y + m;
	return y;
}

softsat(x, lim) {
	return lim * tanh(x / lim);
}

// Linearly interpolated read of delay d (>= 1 sample) from the power-of-two line [base, base + blen).
rp_rd(dl, base, blen, cn, d) {
	dd = clip(d, 1, blen - 2);
	p = cn - dd;
	i0 = floor(p);
	f = p - i0;
	k0 = i0 - blen * floor(i0 / blen);
	k1 = k0 + 1;
	k1 = k1 >= blen ? 0 : k1;
	a = dl.peek(base + k0);
	b = dl.peek(base + k1);
	return a + (b - a) * f;
}

rp_wr(dl, base, blen, cn, v) {
	k = cn - blen * floor(cn / blen);
	dl.poke(v, base + k);
	return 0;
}

// Linearly interpolated read of delay d (>= 0) from channel ch of a power-of-two Data (size n).
rp_rd2(dat, ch, n, cn, d) {
	p = cn - d;
	i0 = floor(p);
	f = p - i0;
	k0 = i0 - n * floor(i0 / n);
	k1 = k0 + 1;
	k1 = k1 >= n ? 0 : k1;
	a = dat.peek(k0, ch);
	b = dat.peek(k1, ch);
	return a + (b - a) * f;
}

// Schroeder allpass (canonical form, |H| = 1 for |a| < 1): reads the line d samples back, writes w, returns the output.
rp_ap(dat, base, blen, cn, d, a, x) {
	w0 = rp_rd(dat, base, blen, cn, d);
	w = x + a * w0;
	rp_wr(dat, base, blen, cn, w);
	return w0 - a * w;
}

// 1 / n-th power of ten: per-pass gain of a loop of `len` samples that decays 60 dB in `rt` seconds.
rp_gain(len, rt, sr) {
	return pow(10, -3 * len / (sr * rt));
}

Buffer xfer("rpxfer");
Buffer hdr("rphdr");
Buffer scope("rpscope");
Buffer spec("rpspec");
Buffer irs("rpirspec");

Data tab(4096, 3);
Data dl(1048576);      // every algorithm's delay lines (one layout at a time)
Data pdl(65536, 2);    // pre-delay
Data lpr(262144, 2);   // outer loop: the return from End
Data apd(65536);       // loop diffusers: 8 allpass lines (L 0..3, R 4..7) of 8192
Data apl(8);           // loop diffuser lengths in samples
Data lb(64, 2);        // line layout: 0 length in samples at the reference rate, 1 scale mode
Data lc(64, 4);        // line state: 0 target length, 1 base, 2 buffer size (0 = unused), 3 current length
Data lg(64, 3);        // per-line loop gain: 0 bass shelf gain s per stage (gl = s^2 gm), 1 mid gain gm, 2 HF shelf gain h
Data ls(64, 3);        // per-line filter states: 0 / 2 the two bass shelf stages, 1 the HF shelf
Data fv(16);           // FDN scratch
Data erp(8);           // early reflection set: 0 first ms, 1 last ms, 2 power, 3 tau ms, 4 level
Data ert(16, 4);       // early reflection taps: 0 target delay, 1 current delay, 2 gain, 3 side (0 L, 1 R)
Data ptp(16, 3);       // plate output taps: 0 slot, 1 delay at the reference rate, 2 sign
Data plp(8);           // plate: 0 / 1 last branch output, 2 / 3 damping states
Data spz(64);          // spring dispersion allpass states (2 x 32)
Data sdz(8);           // spring: 0 / 1 damping states
Data cvr(8192, 2);
Data cxh(256, 2);
Data cxt(4096, 2);
Data fdh(16512);
Data fdt(1163832);
Data ohr(512, 2);
Data otr(8192, 2);
Data ach(256);
Data cout(2);
Data cp(4);

// ---- parameters (the face sends them with `prepend`; the harness sets them by message) ----------------
Param algo(1);
Param predelay(20);    // ms
Param szp(0.6);        // 0..1
Param dcy(2.5);        // s
Param diffp(0.8);      // 0..1
Param dampf(7000);     // Hz
Param bassm(1.2);
Param xoverf(350);     // Hz
Param modrate(0.6);    // Hz
Param moddepth(0.25);  // 0..1
Param erlvl(0);        // dB
Param latelvl(0);      // dB
Param lowcut(60);      // Hz
Param highcut(16000);  // Hz
Param widthp(1);       // 0..1.5
Param freeze(0);
Param clipmode(0);     // loop clip: 0 Soft, 1 Hard, 2 Limit
Param cliplevel(0);    // dB
Param duckamt(0);      // 0..1 (End)
Param duckrel(250);    // ms (End)
Param wetmix(0.35);    // 0..1 Dry/Wet
Param outdb(0);
Param indb(0);       // dB, gain into the reverb only (before pre-delay / tank / convolution)
Param lat(0);          // chain latency fallback for the standalone harness

History cnt(0);
History lastCe(-1);
History deadCnt(1e9);
History sw1(-1e9);
History sw2(-1e9);
History sw3(-1e9);
History bCur(0);
History bWin(0);
History sLo(1e9);
History sHi(-1e9);
History lastL(-1);
History lastB(-1);
History lastK(-1e9);
History mute(0);
History muteN(0);
History muteL(0);
History muteB(0);
History muteK(0);
History gLink(0);
History lkS(0);
History ig(1);
History inS(1);      // smoothed input gain
History lgs(0);
History scs(1);        // wet scale into the chain (smoothed)
History apAs(0.6);     // allpass coefficient (smoothed)
History apAt(0.6);     // allpass coefficient target (block rate)
History apSum(0);      // loop diffusers: summed length (block rate)
History dpL(0);        // loop HF damping states
History dpR(0);
History loL(0);        // loop bass shelf low-band states
History loR(0);
History bshT(1);       // bass shelf gain (block rate)
History dpByp(1);      // damping bypass (Damping 20 kHz)
History limG(1);
History clipR(1);
History clipHold(1);
History clipAge(0);
History tick(63);
History frames(0);
// algorithm state machine
History algoCur(-1);
History asState(3);
History agS(0);
History clrPos(0);
History layoutDirty(0);
History snap(0);
// smoothed controls
History pdCur(0);
History erS(1);
History lateS(1);
History szS(1.12);
History ax(0.04);
History ad(0.5);
History nsC(1);
History mph(0);
History cg(0);
History verCur(-1);
// post filters
History hpL1(0);
History hpL2(0);
History hpR1(0);
History hpR2(0);
History lpL1(0);
History lpL2(0);
History tlW(0);        // outer loop: wanted period in samples (derived at block rate)
History tlCur(0);      // outer loop: period in use (glides)
History lgT(0);        // outer loop: derived gain
History lpR1(0);
History lpR2(0);
History cHp(-1);
History cLp(-1);
History cSr(0);
History hpG(0);
History lpG(0);
History hpA1(0);
History lpA1(0);
History hpByp(0);
History lpByp(0);
// control-rate caches (pow / exp / sin / cos). Refreshed on the 64-sample tick only when the
// parameter or the sample rate changed. Initials match the Param defaults at 48 kHz so the
// samples before the first tick (the tick itself runs on sample 0, after the early uses) are exact.
History inGt(1);
History inDbH(1e9);
History outLin(1);
History outDbH(1e9);
History erGt(1);
History laGt(1);
History erDbH(1e9);
History laDbH(1e9);
History cLin(1);
History cInv(1);
History cKnee(5);
History cDbH(1e9);
History dryC(1);
History wetC(0);
History wetH(1e9);
History sm01(0.00208333333333);
History sm04(0.00052083333333);
History sm05(0.00041666666667);
History sm025(0.00083333333333);
History srH(0);
History adF(1e9);
History axF(1e9);
// telemetry accumulators
History quietCnt(0);
History asleep(0);
History lastWet(0);
History pkIn(0);
History pkWet(0);
History pkRet(0);
History specPk(0);
History specPkD(0);
History ptap(0);

tmp = 0;
tmp2 = 0;
cm = 0;
dL = 0;
dR = 0;
oL = 0;
oR = 0;
erL = 0;
erR = 0;
lateL = 0;
lateR = 0;
nlx = 0;
gd = 0;
v = 0;
ar = 0;
aw = 0;
M = 4194304;
RING = 65536;
sr = max(samplerate, 1);
sfc = min(sr / 48000, 2);
psr = min(sr / 29761, 3.3);

fft_init(tab);

// ---- counters / link -------------------------------------------------------------------------
cn = wrap(cnt + 1, 0, M);
cnt = cn;
poke(hdr, cn, 0);
ce = peek(hdr, 1);
if (ce != lastCe) {
	deadCnt = 0;
} else {
	deadCnt = deadCnt + 1;
}
lastCe = ce;
paired = deadCnt < 8192;

rS = wd(cn - ce, M);
bCur = max(bCur, rS);
sLo = min(sLo, rS);
sHi = max(sHi, rS);
bWin = bWin + 1;
if (bWin >= 16384) {
	poke(hdr, sLo, 20);
	poke(hdr, sHi, 21);
	poke(hdr, peek(hdr, 24) + 1, 24);
	sLo = 1e9;
	sHi = -1e9;
	sw3 = sw2;
	sw2 = sw1;
	sw1 = bCur;
	bCur = -1e9;
	bWin = 0;
}
if (!paired) {
	bCur = -1e9;
	sw1 = -1e9;
	sw2 = -1e9;
	sw3 = -1e9;
}
smax = max(max(bCur, sw1), max(sw2, sw3));
kk = peek(hdr, 2);
bb = clip(smax - kk, 1, 8192);
if (!paired) {
	bb = 32;
	smax = 32;
}
poke(hdr, bb, 3);
ll = clip(floor(max(lat, peek(hdr, 30))), 0, RING - 16384);
poke(hdr, ll, 4);
poke(hdr, paired, 14);

if (ll != lastL || bb != lastB || kk != lastK) {
	// telemetry: count a mute only when it starts (a change that keeps moving, like B settling sample by sample, is one event)
	if (mute <= 0) {
		muteN = muteN + 1;
		muteL = muteL + (ll != lastL ? 1 : 0);
		muteB = muteB + (bb != lastB ? 1 : 0);
		muteK = muteK + (kk != lastK ? 1 : 0);
	}
	mute = 2048;
}
lastL = ll;
lastB = bb;
lastK = kk;
mute = max(mute - 1, 0);
gLink = gLink + ((mute > 0 || !paired) ? -1 : 1) * (1 / 256);
gLink = clip(gLink, 0, 1);
lkS = lkS + ((paired ? 1 : 0) - lkS) * (1 / 512);

// Parameters for End (the mix stage lives there).
poke(hdr, clip(wetmix, 0, 1), 5);
poke(hdr, clip(duckamt, 0, 1), 6);
poke(hdr, clip(duckrel, 10, 2000), 40);
poke(hdr, outLin, 41);
frz = freeze > 0.5;
poke(hdr, frz, 13);

// ---- dry into the ring ---------------------------------------------------------------------
ri = wrap(cn, 0, RING);
poke(xfer, in1, ri, 0);
poke(xfer, in2, ri, 1);

// ---- freeze fade, algorithm request ----------------------------------------------------------
ig = ig + ((frz ? 0 : 1) - ig) * sm01;
fz = 1 - ig;
algoReq = floor(clip(algo, 0, 5) + 0.5);

// ---- pre-delay ---------------------------------------------------------------------------------
// Convolution's engine delays the wet by 256 samples itself: that much of the pre-delay is free, and the
// pre-delay cannot go below it.
pdTgt = clip(predelay, 0, 500) * sr / 1000;
pdTgt = algoReq == 5 ? max(pdTgt, 256) - 256 : pdTgt;
pdTgt = min(pdTgt, 65000);
pdCur = pdCur + (pdTgt - pdCur) * 0.0005;
pdi = wrap(cn, 0, 65536);
poke(pdl, in1, pdi, 0);
poke(pdl, in2, pdi, 1);
xL = rp_rd2(pdl, 0, 65536, cn, pdCur);
xR = rp_rd2(pdl, 1, 65536, cn, pdCur);

// ---- outer loop: the return from End through the flat recirculating path, clipped, into the chain input --------------------
eIdx = wrap(cn - smax, 0, RING);
retL = peek(xfer, eIdx, 2) * gLink;
retR = peek(xfer, eIdx, 3) * gLink;
poke(lpr, retL, wrap(cn, 0, 262144), 0);
poke(lpr, retR, wrap(cn, 0, 262144), 1);
tmin = bb + ll + 4;
tloop = clip(max(tlW, tmin), 1, floor(2 * sr));
loopClamped = tlW < tmin;
tlCur = tlCur + (tloop - tlCur) * 0.0005;
tlCur = max(tlCur, tmin);
rdD = tlCur - bb - ll;
lrL = rp_rd2(lpr, 0, 262144, cn, rdD);
lrR = rp_rd2(lpr, 1, 262144, cn, rdD);
apAs = apAs + (apAt - apAs) * 0.002;
axL = lrL;
axR = lrR;
for (j = 0; j < 4; j += 1) {
	axL = rp_ap(apd, j * 8192, 8192, cn, apl.peek(j), apAs, axL);
	axR = rp_ap(apd, (4 + j) * 8192, 8192, cn, apl.peek(4 + j), apAs, axR);
}
dpL = dpL + ad * (axL - dpL);
dpR = dpR + ad * (axR - dpR);
dpL = fixdenorm(dpL);
dpR = fixdenorm(dpR);
ayL = dpByp > 0.5 ? axL : dpL;
ayR = dpByp > 0.5 ? axR : dpR;
loL = loL + ax * (ayL - loL);
loR = loR + ax * (ayR - loR);
loL = fixdenorm(loL);
loR = fixdenorm(loR);
ayL = ayL + (bshT - 1) * loL;
ayR = ayR + (bshT - 1) * loR;
lgs = lgs + (lgT * ig - lgs) * 0.002;
scs = scs + ((1 + lkS * (sqrt(max(1 - lgT * lgT, 0)) - 1)) - scs) * 0.002;
jL = ayL * lgs;
jR = ayR * lgs;
cK = 0.8 * cLin;
amL = max(abs(jL), cK);
amR = max(abs(jR), cK);
sfL = jL * (cK + (cLin - cK) * tanh((amL - cK) * cKnee)) / amL;
sfR = jR * (cK + (cLin - cK) * tanh((amR - cK) * cKnee)) / amR;
pkS = max(abs(jL), abs(jR));
limT = pkS > cLin ? cLin / pkS : 1;
limG = limT < limG ? limT : limG + (limT - limG) * sm05;
cm = floor(clip(clipmode, 0, 2) + 0.5);
cjL = cm == 1 ? clip(jL, 0 - cLin, cLin) : (cm == 2 ? jL * limG : sfL);
cjR = cm == 1 ? clip(jR, 0 - cLin, cLin) : (cm == 2 ? jR * limG : sfR);
pkC = max(abs(cjL), abs(cjR));
clipR = min(clipR, pkS > 0.000001 ? min(1, pkC / pkS) : 1);
// the tank is fed from the input only (the chain loop does not pass through it)
inS = inS + (inGt - inS) * sm01;
tL = xL * ig * inS;
tR = xR * ig * inS;
pkIn = max(pkIn, max(abs(in1), abs(in2)));
// the tank input follows the algorithm fade too (fading it in avoids a step where a running signal first
// reaches the empty lines of the new algorithm)
tL = tL * agS;
tR = tR * agS;
pkRet = max(pkRet, max(abs(retL), abs(retR)));

// ---- algorithm switch: fade out, clear, rebuild, fade in ---------------------------------------------
if (algoCur < 0) {
	algoCur = algoReq;
	layoutDirty = 1;
	asState = 3;
	agS = 0;
}
if (asState == 0 && algoReq != algoCur) {
	asState = 1;
}
if (asState == 1) {
	agS = max(agS - sm04, 0);
	if (agS <= 0) {
		asState = 2;
		clrPos = 0;
	}
}
if (asState == 2) {
	for (i = 0; i < 16384; i += 1) {
		ix = clrPos + i;
		if (ix < 1048576) {
			dl.poke(0, ix);
		}
		if (ix >= 1048576 && ix < 2212408) {
			fdt.poke(0, ix - 1048576);
		}
	}
	clrPos = clrPos + 16384;
	if (clrPos >= 2212408) {
		for (i = 0; i < 64; i += 1) {
			ls.poke(0, i, 0);
			ls.poke(0, i, 1);
			ls.poke(0, i, 2);
			spz.poke(0, i);
		}
		for (i = 0; i < 16; i += 1) {
			fv.poke(0, i);
		}
		for (i = 0; i < 8; i += 1) {
			plp.poke(0, i);
			sdz.poke(0, i);
		}
		for (i = 0; i < 16512; i += 1) {
			fdh.poke(0, i);
		}
		for (i = 0; i < 8192; i += 1) {
			otr.poke(0, i, 0);
			otr.poke(0, i, 1);
			cvr.poke(0, i, 0);
			cvr.poke(0, i, 1);
		}
		for (i = 0; i < 512; i += 1) {
			ohr.poke(0, i, 0);
			ohr.poke(0, i, 1);
		}
		algoCur = algoReq;
		layoutDirty = 1;
		asState = 3;
	}
}
if (asState == 3) {
	if (algoReq != algoCur) {
		asState = 1;
	} else {
		agS = min(agS + sm04, 1);
		if (agS >= 1) {
			asState = 0;
		}
	}
}
// Idle sleep (all algorithms but Convolution): the tank input and the wet output have both been below -140 dB for
// 32768 samples (longer than any line of the tank), so what is left in the lines is far below audibility and the
// algorithm blocks are skipped (exact zeros) until the input returns. On waking, lengths that glided toward a new
// Size while asleep snap to their targets (the lines are empty).
inQ = max(abs(tL), abs(tR));
quietCnt = (inQ > 0.0000001 || lastWet > 0.0000001) ? 0 : min(quietCnt + 1, 65536);
slp = (quietCnt >= 32768 && algoCur != 5 && asState == 0) ? 1 : 0;
if (asleep > 0.5 && slp < 0.5) {
	for (i = 0; i < 64; i += 1) {
		if (lc.peek(i, 2) > 0 && lb.peek(i, 1) > 0.5 && lb.peek(i, 1) != 3) {
			lc.poke(lc.peek(i, 0), i, 3);
		}
	}
	for (k = 0; k < 16; k += 1) {
		ert.poke(ert.peek(k, 0), k, 1);
	}
}
asleep = slp;
running = asState != 2 && algoCur >= 0 && slp < 0.5;

// ---- layout of the delay lines for the current algorithm ----------------------------------------------
if (layoutDirty > 0.5) {
	layoutDirty = 0;
	for (i = 0; i < 64; i += 1) {
		lb.poke(0, i, 0);
		lb.poke(1, i, 1);
	}
	if (algoCur == 1) {
		// Hall: 16 lines + 2 x 4 input diffusers + the early reflection line
		lb.poke(1031, 0, 0); lb.poke(1327, 1, 0); lb.poke(1559, 2, 0); lb.poke(1823, 3, 0);
		lb.poke(2087, 4, 0); lb.poke(2293, 5, 0); lb.poke(2531, 6, 0); lb.poke(2791, 7, 0);
		lb.poke(3067, 8, 0); lb.poke(3323, 9, 0); lb.poke(3571, 10, 0); lb.poke(3833, 11, 0);
		lb.poke(4093, 12, 0); lb.poke(4339, 13, 0); lb.poke(4591, 14, 0); lb.poke(4861, 15, 0);
		lb.poke(113, 16, 0); lb.poke(337, 17, 0); lb.poke(541, 18, 0); lb.poke(211, 19, 0);
		lb.poke(127, 20, 0); lb.poke(359, 21, 0); lb.poke(563, 22, 0); lb.poke(233, 23, 0);
		lb.poke(3600, 24, 0);
		erp.poke(12, 0); erp.poke(75, 1); erp.poke(1.2, 2); erp.poke(45, 3); erp.poke(0.5, 4);
	}
	if (algoCur == 2) {
		lb.poke(263, 0, 0); lb.poke(349, 1, 0); lb.poke(433, 2, 0); lb.poke(521, 3, 0);
		lb.poke(617, 4, 0); lb.poke(709, 5, 0); lb.poke(811, 6, 0); lb.poke(919, 7, 0);
		lb.poke(37, 16, 0); lb.poke(89, 17, 0); lb.poke(151, 18, 0); lb.poke(61, 19, 0);
		lb.poke(41, 20, 0); lb.poke(97, 21, 0); lb.poke(157, 22, 0); lb.poke(67, 23, 0);
		lb.poke(2400, 24, 0);
		erp.poke(3, 0); erp.poke(38, 1); erp.poke(1, 2); erp.poke(22, 3); erp.poke(0.8, 4);
	}
	if (algoCur == 3) {
		lb.poke(541, 0, 0); lb.poke(673, 1, 0); lb.poke(811, 2, 0); lb.poke(953, 3, 0);
		lb.poke(1103, 4, 0); lb.poke(1249, 5, 0); lb.poke(1399, 6, 0); lb.poke(1553, 7, 0);
		lb.poke(89, 16, 0); lb.poke(211, 17, 0); lb.poke(331, 18, 0); lb.poke(127, 19, 0);
		lb.poke(97, 20, 0); lb.poke(223, 21, 0); lb.poke(347, 22, 0); lb.poke(137, 23, 0);
		lb.poke(3600, 24, 0);
		erp.poke(2, 0); erp.poke(58, 1); erp.poke(0.85, 2); erp.poke(40, 3); erp.poke(1.1, 4);
	}
	if (algoCur == 1 || algoCur == 2 || algoCur == 3) {
		for (i = 0; i < 16; i += 1) {
			lb.poke(1, i, 1);
		}
		for (i = 16; i < 24; i += 1) {
			lb.poke(0, i, 1);
		}
		lb.poke(1, 24, 1);
	}
	if (algoCur == 0) {
		// Plate (Dattorro, lengths at 29761 Hz): 4 input diffusers, then per branch modulated allpass,
		// delay, damping, decay allpass, delay
		lb.poke(142, 16, 0); lb.poke(107, 17, 0); lb.poke(379, 18, 0); lb.poke(277, 19, 0);
		lb.poke(3, 16, 1); lb.poke(3, 17, 1); lb.poke(3, 18, 1); lb.poke(3, 19, 1);
		lb.poke(672, 25, 0); lb.poke(4453, 26, 0); lb.poke(1800, 27, 0); lb.poke(3720, 28, 0);
		lb.poke(908, 29, 0); lb.poke(4217, 30, 0); lb.poke(2656, 31, 0); lb.poke(3163, 32, 0);
		for (i = 25; i < 33; i += 1) {
			lb.poke(2, i, 1);
		}
		ptp.poke(30, 0, 0); ptp.poke(266, 0, 1); ptp.poke(1, 0, 2);
		ptp.poke(30, 1, 0); ptp.poke(2974, 1, 1); ptp.poke(1, 1, 2);
		ptp.poke(31, 2, 0); ptp.poke(1913, 2, 1); ptp.poke(-1, 2, 2);
		ptp.poke(32, 3, 0); ptp.poke(1996, 3, 1); ptp.poke(1, 3, 2);
		ptp.poke(26, 4, 0); ptp.poke(1990, 4, 1); ptp.poke(-1, 4, 2);
		ptp.poke(27, 5, 0); ptp.poke(187, 5, 1); ptp.poke(-1, 5, 2);
		ptp.poke(28, 6, 0); ptp.poke(1066, 6, 1); ptp.poke(-1, 6, 2);
		ptp.poke(26, 7, 0); ptp.poke(353, 7, 1); ptp.poke(1, 7, 2);
		ptp.poke(26, 8, 0); ptp.poke(3627, 8, 1); ptp.poke(1, 8, 2);
		ptp.poke(27, 9, 0); ptp.poke(1228, 9, 1); ptp.poke(-1, 9, 2);
		ptp.poke(28, 10, 0); ptp.poke(2673, 10, 1); ptp.poke(1, 10, 2);
		ptp.poke(30, 11, 0); ptp.poke(2111, 11, 1); ptp.poke(-1, 11, 2);
		ptp.poke(31, 12, 0); ptp.poke(335, 12, 1); ptp.poke(-1, 12, 2);
		ptp.poke(32, 13, 0); ptp.poke(121, 13, 1); ptp.poke(-1, 13, 2);
	}
	if (algoCur == 4) {
		lb.poke(1536, 33, 0);
		lb.poke(2104, 34, 0);
	}
	// allocate: power-of-two buffers sized for the largest scale (1.6 x size, 2 x rate), one after another
	top = 0;
	for (i = 0; i < 64; i += 1) {
		len0 = lb.peek(i, 0);
		md0 = lb.peek(i, 1);
		sc0 = md0 == 2 ? psr * 0.75 * 1.6 * 1.05 : (md0 == 3 ? psr : (md0 == 1 ? sfc * 1.6 : sfc));
		need = len0 * sc0 + 48;
		bl = 16;
		for (j = 0; j < 20; j += 1) {
			if (bl < need) {
				bl = bl * 2;
			}
		}
		if (len0 > 0) {
			lc.poke(0, i, 0);
			lc.poke(top, i, 1);
			lc.poke(bl, i, 2);
			lc.poke(len0 * sfc, i, 3);
			top = top + bl;
		} else {
			lc.poke(0, i, 0);
			lc.poke(0, i, 1);
			lc.poke(0, i, 2);
			lc.poke(0, i, 3);
		}
	}
	snap = 1;
	tick = 63;
}

// ---- block rate (every 64 samples): sizes, gains, coefficients, early reflections, telemetry ---------------
tick = tick + 1;
doTick = tick >= 64;
if (doTick) {
	tick = 0;
	frames = wrap(frames + 1, 0, 1000000);
	// Gains, poles and equal-power coefficients. Transcendentals run here, and only when the
	// parameter or the sample rate actually changed (never on the per-sample path).
	inDb = clip(indb, -36, 12);
	if (inDb != inDbH) {
		inGt = pow(10, inDb * 0.05);
		inDbH = inDb;
	}
	oDb = clip(outdb, -36, 12);
	if (oDb != outDbH) {
		outLin = pow(10, oDb * 0.05);
		outDbH = oDb;
	}
	erDb = clip(erlvl, -70, 6);
	if (erDb != erDbH) {
		erGt = erDb <= -69.9 ? 0 : pow(10, erDb * 0.05);
		erDbH = erDb;
	}
	laDb = clip(latelvl, -70, 6);
	if (laDb != laDbH) {
		laGt = laDb <= -69.9 ? 0 : pow(10, laDb * 0.05);
		laDbH = laDb;
	}
	cDb = clip(cliplevel, -18, 6);
	if (cDb != cDbH) {
		cLin = pow(10, cDb * 0.05);
		cInv = 1 / cLin;
		cKnee = cInv * 5;
		cDbH = cDb;
	}
	wmx = clip(wetmix, 0, 1);
	if (wmx != wetH) {
		dryC = cos(wmx * pi * 0.5);
		wetC = sin(wmx * pi * 0.5);
		wetH = wmx;
	}
	dfc = clip(dampf, 1000, 20000);
	xfc = clip(xoverf, 100, 1000);
	srCh = sr != srH;
	if (dfc != adF || srCh) {
		ad = 1 - exp(-6.283185307179586 * dfc / sr);
		adF = dfc;
	}
	if (xfc != axF || srCh) {
		ax = 1 - exp(-6.283185307179586 * xfc / sr);
		axF = xfc;
	}
	if (srCh) {
		sm01 = 1 / (0.01 * sr);
		sm04 = 1 / (0.04 * sr);
		sm05 = 1 / (0.05 * sr);
		sm025 = 1 / (0.025 * sr);
		srH = sr;
	}
	szS = 0.4 + 1.2 * clip(szp, 0, 1);
	rt = clip(dcy, 0.1, 60);
	// the chain loop carries the long tail while an End is paired: the tank runs at 0.3 x Decay (not for Convolution)
	rtT = rt * (1 - 0.7 * lkS * (algoCur == 5 ? 0 : 1));
	// target lengths of every line
	for (i = 0; i < 64; i += 1) {
		if (lc.peek(i, 2) > 0) {
			md1 = lb.peek(i, 1);
			sc1 = md1 == 2 ? psr * szS * 0.75 : (md1 == 3 ? psr : (md1 == 1 ? sfc * szS : sfc));
			lc.poke(lb.peek(i, 0) * sc1, i, 0);
			if (md1 == 0 || md1 == 3 || snap > 0.5) {
				lc.poke(lb.peek(i, 0) * sc1, i, 3);
			}
		}
	}
	gsum = 0;
	lsum = 0;
	tcL = 0;
	klp = 1;
	nlx = algoCur == 1 ? 16 : 8;
	if (algoCur == 1 || algoCur == 2 || algoCur == 3) {
		bass = clip(bassm, 0.25, 4);
		for (i = 0; i < nlx; i += 1) {
			len2 = lc.peek(i, 3);
			gm2 = rp_gain(len2, rtT, sr);
			gl2 = min(rp_gain(len2, rtT * bass, sr), 1);
			lg.poke(sqrt(gl2 / gm2), i, 0);
			lg.poke(gm2, i, 1);
			// above HF Damping a line decays 5x faster (RT 0.2 x): per pass gm * h = gm^5
			hh2 = pow(gm2, 4);
			lg.poke(hh2, i, 2);
			gsum = gsum + gm2 * gm2;
			lsum = lsum + len2;
		}
		nsC = clip(sqrt(max(1 - gsum / nlx, 0)), 0.12, 1);
		tcL = lsum / nlx;
		klp = algoCur == 1 ? 1.25 : (algoCur == 2 ? 6 : 3.5);
		// early reflections: 16 taps, times spread between the first and last ms (size scaled), each with a
		// deterministic jitter, level falling with tau; unit total energy times the set's level
		enrm = 0;
		for (k = 0; k < 16; k += 1) {
			hj = sin(k * 12.9898 + 1.234) * 43758.5453;
			hj = hj - floor(hj);
			hs = sin(k * 78.233 + 4.321) * 24634.6345;
			hs = hs - floor(hs);
			fr = (k + 0.5 + 0.35 * (hj - 0.5)) / 16;
			ms = erp.peek(0) + (erp.peek(1) - erp.peek(0)) * pow(clip(fr, 0, 1), erp.peek(2));
			ert.poke(ms * sr / 1000 * szS, k, 0);
			if (snap > 0.5) {
				ert.poke(ms * sr / 1000 * szS, k, 1);
			}
			gk = exp(-ms / erp.peek(3));
			ert.poke(gk * (hs > 0.5 ? 1 : -1), k, 2);
			ert.poke(k - 2 * floor(k / 2), k, 3);
			enrm = enrm + gk * gk;
		}
		for (k = 0; k < 16; k += 1) {
			ert.poke(ert.peek(k, 2) * erp.peek(4) / sqrt(enrm), k, 2);
		}
	}
	if (algoCur == 0) {
		tauL = (lc.peek(25, 3) + lc.peek(26, 3) + lc.peek(27, 3) + lc.peek(28, 3));
		tauR = (lc.peek(29, 3) + lc.peek(30, 3) + lc.peek(31, 3) + lc.peek(32, 3));
		gpl = rp_gain(tauL, rtT, sr);
		gpr = rp_gain(tauR, rtT, sr);
		lg.poke(gpl, 0, 1);
		lg.poke(gpr, 1, 1);
		nsC = clip(sqrt(max(1 - pow(lg.peek(0, 1) * lg.peek(1, 1), 2), 0)), 0.12, 1);
		tcL = (tauL + tauR) * 0.5;
		klp = 0.3;
	}
	if (algoCur == 4) {
		gpl = rp_gain(lc.peek(33, 3) + 48, rtT, sr);
		gpr = rp_gain(lc.peek(34, 3) + 48, rtT, sr);
		lg.poke(gpl, 0, 1);
		lg.poke(gpr, 1, 1);
		nsC = clip(sqrt(max(1 - pow(lg.peek(0, 1), 2), 0)), 0.12, 1);
		tcL = (lc.peek(33, 3) + lc.peek(34, 3)) * 0.5 + 48;
		klp = 1.5;
	}
	// ---- outer loop, derived from the tank (period and gain; see the header comment and AGENTS.md section 27)
	irLen = peek(hdr, 36);
	tlN = algoCur == 5 ? clip(0.15 * irLen, 0.04 * sr, 0.15 * sr) : klp * tcL;
	tlN = floor(clip(tlN, 0, 0.25 * sr) + 0.5);
	tlW = tlN;
	tlE = clip(max(tlN, tmin), 1, floor(2 * sr));
	if (snap > 0.5 || tlCur <= 0) {
		tlCur = tlE;
	}
	rtG = algoCur == 5 ? max(0.5 * irLen / sr, 0.1) : rt;
	// loop diffusers (lengths scale with the sample rate); the allpass chain's mean group delay is its summed length, so the time a
	// recirculation takes is the delay period + that sum
	apl.poke(floor(149 * sfc + 0.5), 0);
	apl.poke(floor(233 * sfc + 0.5), 1);
	apl.poke(floor(367 * sfc + 0.5), 2);
	apl.poke(floor(523 * sfc + 0.5), 3);
	apl.poke(floor(163 * sfc + 0.5), 4);
	apl.poke(floor(257 * sfc + 0.5), 5);
	apl.poke(floor(389 * sfc + 0.5), 6);
	apl.poke(floor(547 * sfc + 0.5), 7);
	apSum = 0;
	for (i = 0; i < 8; i += 1) {
		apSum = apSum + apl.peek(i);
	}
	apSum = apSum * 0.75;
	// loop gain: the tail that goes round the chain decays 60 dB in Decay (the loop's magnitude is flat: allpasses, damping and the bass
	// shelf never exceed g max(1, shelf), see the header). Capped at 0.97.
	lgT = min(rp_gain(tlE + apSum, rtG, sr), 0.97);
	bshT = (algoCur == 1 || algoCur == 2 || algoCur == 3) ? pow(lgT, 1 / clip(bassm, 0.25, 4) - 1) : 1;
	dpByp = dampf >= 19999.5 || algoCur == 5;
	apAt = 0.3 + 0.4 * clip(diffp, 0, 1);
	// post filters: 12 dB/oct TPT high-pass (Low Cut) and low-pass (High Cut; Convolution also Damping)
	lpf = algoCur == 5 ? min(clip(highcut, 1000, 20000), clip(dampf, 1000, 20000)) : clip(highcut, 1000, 20000);
	hpf = clip(lowcut, 20, 1000);
	if (hpf != cHp || lpf != cLp || sr != cSr) {
		hpG = tan(pi * clip(hpf, 10, sr * 0.45) / sr);
		lpG = tan(pi * clip(lpf, 20, sr * 0.45) / sr);
		hpA1 = 1 / (1 + hpG * (hpG + 1.4142));
		lpA1 = 1 / (1 + lpG * (lpG + 1.4142));
		cHp = hpf;
		cLp = lpf;
		cSr = sr;
	}
	hpByp = hpf <= 20.5;
	lpByp = lpf >= 19999.5;
	// telemetry
	poke(scope, frames, 0);
	poke(scope, sr, 1);
	poke(scope, algoCur, 2);
	poke(scope, frz, 3);
	poke(scope, paired, 4);
	poke(scope, bb, 5);
	poke(scope, ll, 6);
	poke(scope, kk, 7);
	poke(scope, tmin * 1000 / sr, 8);
	poke(scope, tloop * 1000 / sr, 9);
	poke(scope, (algoReq == 5 ? max(clip(predelay, 0, 500), 256000 / sr) : clip(predelay, 0, 500)), 10);
	poke(scope, loopClamped, 11);
	poke(scope, pkIn, 12);
	poke(scope, asleep, 13);
	poke(scope, pkWet, 14);
	poke(scope, pkRet, 15);
	clipAge = clipAge + 1;
	clipHold = (clipR <= clipHold || clipAge >= 32) ? clipR : clipHold;
	clipAge = clipR <= clipHold ? 0 : clipAge;
	poke(scope, atodb(max(clipHold, 0.000001)), 18);
	bassT = (algoCur == 1 || algoCur == 2 || algoCur == 3) ? clip(bassm, 0.25, 4) : 1;
	hiAtt = 0.2 + 0.8 / (1 + pow(10000 / clip(dampf, 1000, 20000), 2));
	poke(scope, rt * bassT, 22);
	poke(scope, rt, 23);
	poke(scope, rt * hiAtt, 24);
	poke(scope, peek(hdr, 37), 25);
	poke(scope, peek(hdr, 36), 26);
	poke(scope, peek(hdr, 32), 27);
	poke(scope, peek(hdr, 39), 28);
	poke(scope, asState, 29);
	poke(scope, lgT, 30);
	poke(scope, rtT, 31);
	poke(scope, muteN, 32);
	poke(scope, muteL, 33);
	poke(scope, muteB, 34);
	poke(scope, muteK, 35);
	poke(scope, gLink, 36);
	snap = 0;
	pkIn = 0;
	pkWet = 0;
	pkRet = 0;
	clipR = 1;
	poke(spec, wrap(cn + 1, 0, 4096), 0);
	poke(spec, sr, 1);
	poke(spec, specPk, 2);
	poke(spec, specPkD, 3);
	specPk = 0;
	specPkD = 0;
}

// ---- the algorithms --------------------------------------------------------------------------------
oL = 0;
oR = 0;
erL = 0;
erR = 0;
lateL = 0;
lateR = 0;
mph = wrap(mph + clip(modrate, 0.05, 5) / sr, 0, 1);
slew = 0.0005;
md = clip(moddepth, 0, 1) * 6 * sfc * ig;

// line lengths glide to their targets (size changes bend the delays instead of clicking)
if (running && algoCur != 5) {
	for (i = 0; i < 64; i += 1) {
		if (lc.peek(i, 2) > 0 && lb.peek(i, 1) > 0.5 && lb.peek(i, 1) != 3) {
			lc.poke(lc.peek(i, 3) + (lc.peek(i, 0) - lc.peek(i, 3)) * slew, i, 3);
		}
	}
}

// -- Hall / Room / Chamber: input diffusion, FDN, early reflections
if (running && (algoCur == 1 || algoCur == 2 || algoCur == 3)) {
	nlx = algoCur == 1 ? 16 : 8;
	gd = 0.7 * clip(diffp, 0, 1);
	for (ch = 0; ch < 2; ch += 1) {
		v = ch == 0 ? tL : tR;
		for (st = 0; st < 4; st += 1) {
			s = 16 + ch * 4 + st;
			base = lc.peek(s, 1);
			blen = lc.peek(s, 2);
			ar = rp_rd(dl, base, blen, cn, lc.peek(s, 3));
			aw = v + gd * ar;
			rp_wr(dl, base, blen, cn, aw);
			v = ar - gd * aw;
		}
		if (ch == 0) {
			dL = v;
		} else {
			dR = v;
		}
	}
	// early reflections read the (undiffused) tank input
	if (algoCur != 0) {
		eb = lc.peek(24, 1);
		ebl = lc.peek(24, 2);
		em = (tL + tR) * 0.5;
		rp_wr(dl, eb, ebl, cn, em);
		for (k = 0; k < 16; k += 1) {
			ert.poke(ert.peek(k, 1) + (ert.peek(k, 0) - ert.peek(k, 1)) * slew, k, 1);
			ev = rp_rd(dl, eb, ebl, cn, ert.peek(k, 1));
			if (ert.peek(k, 3) < 0.5) {
				erL = erL + ert.peek(k, 2) * ev;
			} else {
				erR = erR + ert.peek(k, 2) * ev;
			}
		}
	}
	// feedback delay network
	adE = ad + (1 - ad) * fz;
	for (i = 0; i < nlx; i += 1) {
		base = lc.peek(i, 1);
		blen = lc.peek(i, 2);
		d = lc.peek(i, 3) + md * sin(6.283185307179586 * (mph + i * 0.382));
		d = d + (floor(lc.peek(i, 3)) - d) * fz;
		x = rp_rd(dl, base, blen, cn, d);
		// bass: two cascaded first-order low shelves (DC gain s each, 1 above the crossover): passive for any
		// gain ratio (a complementary split with different gains on the two bands is not: it can exceed 1 near
		// the crossover and ring), then the mid gain and the HF damping (a first-order HIGH SHELF: gain 1 below HF Damping, h above)
		sh = lg.peek(i, 0);
		sh = sh + (1 - sh) * fz;
		lp = ls.peek(i, 0);
		lp = lp + ax * (x - lp);
		ls.poke(lp, i, 0);
		y1 = x + (sh - 1) * lp;
		lq = ls.peek(i, 2);
		lq = lq + ax * (y1 - lq);
		ls.poke(lq, i, 2);
		y2 = y1 + (sh - 1) * lq;
		gm = lg.peek(i, 1);
		gm = gm + (1 - gm) * fz;
		hh = lg.peek(i, 2);
		hh = hh + (1 - hh) * fz;
		y3 = gm * y2;
		dp = ls.peek(i, 1);
		dp = dp + ad * (y3 - dp);
		ls.poke(dp, i, 1);
		y = hh * y3 + (1 - hh) * dp;
		fv.poke(y, i);
		m1 = i * 7 + floor(i / 2);
		m2 = i * 5 + 1 + floor(i / 3);
		oL = oL + ((m1 - 2 * floor(m1 / 2)) < 0.5 ? y : 0 - y);
		oR = oR + ((m2 - 2 * floor(m2 / 2)) < 0.5 ? y : 0 - y);
	}
	// Hadamard mixing
	for (hs2 = 1; hs2 < nlx; hs2 = hs2 * 2) {
		for (j = 0; j < nlx; j = j + 2 * hs2) {
			for (kq = j; kq < j + hs2; kq += 1) {
				ha = fv.peek(kq);
				hb2 = fv.peek(kq + hs2);
				fv.poke(ha + hb2, kq);
				fv.poke(ha - hb2, kq + hs2);
			}
		}
	}
	hn = 1 / sqrt(nlx);
	ci = sqrt(2 / nlx);
	for (i = 0; i < nlx; i += 1) {
		base = lc.peek(i, 1);
		blen = lc.peek(i, 2);
		wv = fv.peek(i) * hn + ci * ((i - 2 * floor(i / 2)) < 0.5 ? dL : dR);
		rp_wr(dl, base, blen, cn, wv);
	}
	lateL = oL * 0.7071 * nsC;
	lateR = oR * 0.7071 * nsC;
}

// -- Plate (Dattorro)
if (running && algoCur == 0) {
	gd = clip(diffp, 0, 1);
	v = (tL + tR) * 0.5;
	for (st = 0; st < 4; st += 1) {
		s = 16 + st;
		base = lc.peek(s, 1);
		blen = lc.peek(s, 2);
		gq = (st < 2 ? 0.75 : 0.625) * gd;
		ar = rp_rd(dl, base, blen, cn, lc.peek(s, 3));
		aw = v + gq * ar;
		rp_wr(dl, base, blen, cn, aw);
		v = ar - gq * aw;
	}
	adE = ad + (1 - ad) * fz;
	for (br = 0; br < 2; br += 1) {
		s0 = 25 + br * 4;
		gb = lg.peek(br, 1);
		gb = gb + (1 - gb) * fz;
		a = v + gb * plp.peek(1 - br);
		// modulated decay-diffusion allpass
		base = lc.peek(s0, 1);
		blen = lc.peek(s0, 2);
		dm = lc.peek(s0, 3) + md * 2.5 * sin(6.283185307179586 * (mph + br * 0.5));
		dm = dm + (floor(lc.peek(s0, 3)) - dm) * fz;
		ar = rp_rd(dl, base, blen, cn, dm);
		gq = 0.7 * gd;
		aw = a + gq * ar;
		rp_wr(dl, base, blen, cn, aw);
		a = ar - gq * aw;
		// delay 1
		base = lc.peek(s0 + 1, 1);
		blen = lc.peek(s0 + 1, 2);
		x1 = rp_rd(dl, base, blen, cn, lc.peek(s0 + 1, 3) + (floor(lc.peek(s0 + 1, 3)) - lc.peek(s0 + 1, 3)) * fz);
		rp_wr(dl, base, blen, cn, a);
		// damping, decay
		lp = plp.peek(2 + br);
		lp = lp + adE * (x1 - lp);
		plp.poke(lp, 2 + br);
		x1 = lp;
		// decay-diffusion allpass 2
		base = lc.peek(s0 + 2, 1);
		blen = lc.peek(s0 + 2, 2);
		ar = rp_rd(dl, base, blen, cn, lc.peek(s0 + 2, 3) + (floor(lc.peek(s0 + 2, 3)) - lc.peek(s0 + 2, 3)) * fz);
		gq = 0.5 * gd;
		aw = x1 + gq * ar;
		rp_wr(dl, base, blen, cn, aw);
		x1 = ar - gq * aw;
		// delay 2
		base = lc.peek(s0 + 3, 1);
		blen = lc.peek(s0 + 3, 2);
		x2 = rp_rd(dl, base, blen, cn, lc.peek(s0 + 3, 3) + (floor(lc.peek(s0 + 3, 3)) - lc.peek(s0 + 3, 3)) * fz);
		rp_wr(dl, base, blen, cn, x1);
		plp.poke(x2, br);
	}
	pscale = psr * szS * 0.75;
	for (k = 0; k < 14; k += 1) {
		s = ptp.peek(k, 0);
		tv = rp_rd(dl, lc.peek(s, 1), lc.peek(s, 2), cn, ptp.peek(k, 1) * pscale);
		if (k < 7) {
			oL = oL + ptp.peek(k, 2) * tv;
		} else {
			oR = oR + ptp.peek(k, 2) * tv;
		}
	}
	lateL = oL * 0.6 * nsC * 1.4;
	lateR = oR * 0.6 * nsC * 1.4;
}

// -- Spring: two dispersive allpass loops
if (running && algoCur == 4) {
	adE = ad + (1 - ad) * fz;
	aco = 0 - (0.2 + 0.6 * clip(diffp, 0, 1));
	for (sp = 0; sp < 2; sp += 1) {
		s = 33 + sp;
		base = lc.peek(s, 1);
		blen = lc.peek(s, 2);
		d = lc.peek(s, 3) + md * sin(6.283185307179586 * (mph + sp * 0.5));
		d = d + (floor(lc.peek(s, 3)) - d) * fz;
		x = rp_rd(dl, base, blen, cn, d);
		lp = sdz.peek(sp);
		lp = lp + adE * (x - lp);
		sdz.poke(lp, sp);
		gs = lg.peek(sp, 1);
		gs = gs + (1 - gs) * fz;
		v = (sp == 0 ? tL + 0.3 * tR : tR + 0.3 * tL) * 0.7 + gs * lp;
		for (j = 0; j < 32; j += 1) {
			z = spz.peek(sp * 32 + j);
			y = aco * v + z;
			spz.poke(v - aco * y, sp * 32 + j);
			v = y;
		}
		rp_wr(dl, base, blen, cn, v);
		if (sp == 0) {
			oL = oL + x;
			oR = oR + x * 0.35;
		} else {
			oR = oR + x;
			oL = oL + x * 0.35;
		}
	}
	lateL = oL * nsC * 0.9;
	lateR = oR * nsC * 0.9;
}

// -- Convolution
// the IR bank is swapped only while the output is faded out (25 ms), so a new IR never clicks
verNow = peek(hdr, 32);
cg = cg + ((verNow != verCur ? 0 : 1) - cg) * sm025;
if (verNow != verCur && cg <= 0.002) {
	cp.poke(peek(hdr, 33), 0);
	cp.poke(peek(hdr, 34), 1);
	cp.poke(peek(hdr, 35), 2);
	cp.poke(peek(hdr, 37), 3);
	verCur = verNow;
}
if (running && algoCur == 5) {
	rpc_tick(cn, tL, tR, tab, cvr, cxh, cxt, fdh, fdt, ohr, otr, irs, cp, ach, cout);
	lateL = cout.peek(0) * cg;
	lateR = cout.peek(1) * cg;
}

// ---- levels, post filters, width, fades -----------------------------------------------------------
erS = erS + (erGt - erS) * 0.002;
lateS = lateS + (laGt - lateS) * 0.002;
wL = erL * erS + lateL * lateS;
wR = erR * erS + lateR * lateS;
// Low Cut / High Cut
v1 = (hpG * (wL - hpL2) + hpL1) * hpA1;
v2 = hpL2 + hpG * v1;
hpL1 = 2 * v1 - hpL1;
hpL2 = 2 * v2 - hpL2;
yL = hpByp > 0.5 ? wL : wL - 1.4142 * v1 - v2;
w1 = (hpG * (wR - hpR2) + hpR1) * hpA1;
w2 = hpR2 + hpG * w1;
hpR1 = 2 * w1 - hpR1;
hpR2 = 2 * w2 - hpR2;
yR = hpByp > 0.5 ? wR : wR - 1.4142 * w1 - w2;
u1 = (lpG * (yL - lpL2) + lpL1) * lpA1;
u2 = lpL2 + lpG * u1;
lpL1 = 2 * u1 - lpL1;
lpL2 = 2 * u2 - lpL2;
q1 = (lpG * (yR - lpR2) + lpR1) * lpA1;
q2 = lpR2 + lpG * q1;
lpR1 = 2 * q1 - lpR1;
lpR2 = 2 * q2 - lpR2;
hpL1 = fixdenorm(hpL1);
hpL2 = fixdenorm(hpL2);
hpR1 = fixdenorm(hpR1);
hpR2 = fixdenorm(hpR2);
lpL1 = fixdenorm(lpL1);
lpL2 = fixdenorm(lpL2);
lpR1 = fixdenorm(lpR1);
lpR2 = fixdenorm(lpR2);
// width (mid / side), algorithm fade, level safety
zL = lpByp > 0.5 ? yL : u2;
zR = lpByp > 0.5 ? yR : q2;
mid = (zL + zR) * 0.5;
side = (zL - zR) * 0.5 * clip(widthp, 0, 1.5);
wetL = (mid + side) * agS;
wetR = (mid - side) * agS;
wetL = abs(wetL) > 2 ? sign(wetL) * (2 + 4 * tanh((abs(wetL) - 2) / 4)) : wetL;
wetR = abs(wetR) > 2 ? sign(wetR) * (2 + 4 * tanh((abs(wetR) - 2) / 4)) : wetR;
wetL = fixnan(wetL);
wetR = fixnan(wetR);

pkWet = max(pkWet, max(abs(wetL), abs(wetR)));
lastWet = max(abs(wetL), abs(wetR));

// spectrum rings (face FFT)
sp0 = wrap(cn, 0, 4096);
poke(spec, (wetL + wetR) * 0.5, 32 + sp0);
poke(spec, (in1 + in2) * 0.5, 4128 + sp0);
specPk = max(specPk, abs(wetL));
specPkD = max(specPkD, abs(in1));

// whitened mono copy of what goes into the chain (End's K calibration)
cL = wetL * scs + cjL;
cR = wetR * scs + cjR;
tapM = (cL + cR) * 0.5 * gLink;
poke(xfer, tapM - ptap, ri, 4);
ptap = tapM;

// Paired: only the wet goes into the chain. Unpaired: a plain reverb (equal-power Dry/Wet, Output).
solL = in1 * dryC + wetL * wetC * outLin;
solR = in2 * dryC + wetR * wetC * outLin;
out1 = fixnan(cL * gLink * lkS + solL * (1 - lkS));
out2 = fixnan(cR * gLink * lkS + solR * (1 - lkS));
