// Percipitator — 16-Band Scale-Quantized Wavetable Resynthesizer.
//
// Buffers (bound on loadbang via `wt #0-percipwt, scope #0-percipscope`):
//   wt    ("percipwt")   : 8192 samples (4 frames x 2048 samples: Sine -> Triangle -> Saw -> Square)
//   scope ("percipscope"): 36 samples:
//     0..15  : per-band post-sieve/tilt/freeze resynthesis amplitude (0..1.5)
//     16..31 : per-band quantized MIDI note
//     32     : peak output level
//     33     : active partial count
//     34     : current gate linear
//     35     : rolling frame counter
//
// GenExpr rules strictly enforced:
//   - All functions appear before Buffer, Param, History, and expression statements.
//   - No identifier is named e<digit> (Euler's constant lexer bug).

slew(target, coef) {
	History s(0);
	History init(0);
	s = (init == 0) ? target : mix(target, s, coef);
	init = 1;
	return s;
}

// 2-pole zero-delay Chamberlin SVF bandpass + instantaneous frequency tracker + Spectral Freeze latch.
// Optimized:
//   - Polynomial SVF frequency coefficient (eliminates 16 sin() calls per sample).
//   - Zero-crossing log2() pitch update runs ONLY on valid zero crossings (validCross).
//   - Sleeps when input and filter/envelope states are silent.
band_track(x, centerHz, dampVal, atkCoef, relCoef, gateLin, freezeOn, srVal) {
	History lpState(0);
	History bpState(0);
	History envState(0);
	History prevSign(1);
	History periodSamps(100);
	History sampCount(0);
	History targetMidi(60);
	History midiHold(60);
	History frozenAmp(0);
	History frozenMidi(60);

	isFrz = (freezeOn > 0.5);
	if (isFrz) {
		return frozenAmp, frozenMidi;
	}

	activity = abs(x) + abs(bpState) + abs(lpState) + envState;
	if (activity < 0.0000005) {
		bpState = 0;
		lpState = 0;
		envState = 0;
		frozenAmp = 0;
		return 0, midiHold;
	}

	w = 3.14159265359 * clip(centerHz, 40, srVal * 0.42) / srVal;
	f = w * (2.0 - 0.33333333 * w * w);
	hp = x * dampVal - lpState - dampVal * bpState;
	bpNew = bpState + f * hp;
	lpNew = lpState + f * bpNew;
	bpState = clip(bpNew, -2, 2);
	lpState = clip(lpNew, -2, 2);

	// Zero-crossing period estimator on the narrowband signal
	sampCount = sampCount + 1;
	curSign = (bpState >= 0) ? 1 : -1;
	crossed = (curSign > 0) && (prevSign < 0);
	validCross = crossed && (sampCount > 4) && (sampCount < srVal * 0.03);
	if (validCross) {
		periodSamps = mix(sampCount, periodSamps, 0.65);
		estHz = clip(srVal / max(periodSamps, 4), centerHz * 0.72, centerHz * 1.38);
		targetMidi = 69 + 12 * log2(max(estHz, 20) / 440);
	}
	sampCount = crossed ? 0 : sampCount;
	prevSign = curSign;
	midiHold = mix(targetMidi, midiHold, 0.992);

	// Envelope follower with soft-knee precipitation gate
	ax = abs(bpState) * 1.45;
	c = (ax > envState) ? atkCoef : relCoef;
	envState = mix(ax, envState, c);

	gLo = max(gateLin * 0.6, 0.00001);
	gHi = max(gateLin * 1.6, gLo + 0.0001);
	gt = clip((envState - gLo) / (gHi - gLo), 0, 1);
	gateFactor = gt * gt * (3 - 2 * gt);
	liveAmp = envState * gateFactor;

	frozenAmp = liveAmp;
	frozenMidi = midiHold;

	return liveAmp, midiHold;
}

// Quantize a MIDI note number to the active 12-bit scaleMask (bits 0..11 = C..B).
// Searches +/- 11 semitones so even a single-note MIDI sidechain mask snaps every band.
quant_midi(inMidi, scaleMask, snapAmt) {
	mask = int(clip(scaleMask, 0, 4095));
	base = round(inMidi);
	best = base;
	bestDist = 99;

	for (k = -11; k <= 11; k += 1) {
		cand = base + k;
		pc = int(wrap(cand, 0, 12));
		bit = int(floor(mask / pow(2, pc))) % 2;
		dist = abs(cand - inMidi);
		take = (bit > 0) && (dist < bestDist);
		best = take ? cand : best;
		bestDist = take ? dist : bestDist;
	}
	effBest = (mask > 0) ? best : inMidi;
	return mix(inMidi, effBest, clip(snapAmt, 0, 1));
}

// Per-band Partial Sieve + Spectral Tilt weight.
//   sieveMode: 0=All, 1=Odd, 2=Even, 3=Sparse (every 3rd), 4=Rising
band_weight(bandIdx, sieveMode, tiltBipolar) {
	m = round(clip(sieveMode, 0, 4));
	isEven = ((bandIdx % 2) == 0);
	isThird = ((bandIdx % 3) == 0);
	sAll = 1.0;
	sOdd = isEven ? 1.0 : 0.06;
	sEven = isEven ? 0.06 : 1.0;
	sSprs = isThird ? 1.18 : 0.03;
	sRise = 0.22 + 0.98 * (bandIdx / 15.0);
	sieveG = (m == 0) ? sAll : ((m == 1) ? sOdd : ((m == 2) ? sEven : ((m == 3) ? sSprs : sRise)));

	pos = ((bandIdx / 15.0) - 0.5) * 2.0;
	tiltG = pow(2.0, clip(tiltBipolar, -1, 1) * pos * 6.0);
	return sieveG * tiltG;
}

// Phase warp modifier for wavetable oscillators:
//   mode 0 (Bend): exponential phase pinch/stretch (uses precomputed bendExp)
//   mode 1 (Asym): asymmetric duty breakpoint skew
//   mode 2 (Sync): 1x..5x hard sync phase multiplier
//   mode 3 (Fold): 1x..4x triangle wavefold
warp_phase(ph, mode, warpAmt, bendExp) {
	p = wrap(ph, 0, 1);
	w = clip(warpAmt, 0, 1);
	m = round(clip(mode, 0, 3));
	outP = p;
	if (m == 0) {
		outP = (abs(w - 0.5) < 0.003) ? p : pow(max(p, 0.00001), bendExp);
	} else if (m == 1) {
		bp = 0.5 - w * 0.38;
		outP = (p < bp) ? (0.5 * p / max(bp, 0.02)) : (0.5 + 0.5 * (p - bp) / max(1 - bp, 0.02));
	} else if (m == 2) {
		outP = wrap(p * (1 + w * 4.0), 0, 1);
	} else {
		fp = wrap(p * (1 + w * 3.0), 0, 2);
		outP = (fp <= 1) ? fp : (2 - fp);
	}
	return clip(outP, 0, 0.9999);
}

// 4-Frame Wavetable Resynthesis Oscillator + Control-Rate Pitch/Weight Decimator per band.
// Skips all wavetable lookups, phase warp, and pitch quantization when rawAmp <= 0.00001.
// When active, updates quantized MIDI pitch, frequency pow(), and sieve/tilt weight every 16 samples.
voice_osc(wtBuf, bandIdx, rawAmp, rawMidi, pitchSt, stretchVal, fshiftHz, maskInt, snapAmt, sieveMode, tiltVal, wtPos01, warpMode, warpAmt, bendExp, srVal) {
	History ph(0);
	History cTick(0);
	History cInit(0);
	History heldWeight(1.0);
	History heldQm(60.0);
	History heldFreq(440.0);

	if ((rawAmp <= 0.00001) && (cInit > 0)) {
		return 0, 0, heldQm;
	}

	if ((cTick == 0) || (cInit == 0)) {
		heldWeight = band_weight(bandIdx, sieveMode, tiltVal);
		heldQm = quant_midi(69 + (rawMidi - 69) * stretchVal + pitchSt, maskInt, snapAmt);
		heldFreq = clip(440 * pow(2, (heldQm - 69) / 12) + fshiftHz, 20, 18000);
		cInit = 1;
	}
	cTick = wrap(cTick + 1, 0, 16);

	amp = rawAmp * heldWeight;
	if (amp <= 0.00001) {
		return 0, 0, heldQm;
	}

	inc = clip(heldFreq / srVal, 0, 0.45);
	ph = wrap(ph + inc, 0, 1);

	wPh = warp_phase(ph, warpMode, warpAmt, bendExp);
	fScaled = clip(wtPos01, 0, 1) * 3.0;
	f0 = floor(fScaled);
	f1 = min(3, f0 + 1);
	fFrac = fScaled - f0;

	idx = wPh * 2048.0;
	i0 = floor(idx);
	i1 = wrap(i0 + 1, 0, 2048);
	iFrac = idx - i0;

	s00 = peek(wtBuf, f0 * 2048 + i0, 0);
	s01 = peek(wtBuf, f0 * 2048 + i1, 0);
	s10 = peek(wtBuf, f1 * 2048 + i0, 0);
	s11 = peek(wtBuf, f1 * 2048 + i1, 0);
	wt0 = mix(s00, s01, iFrac);
	wt1 = mix(s10, s11, iFrac);
	sig = mix(wt0, wt1, fFrac);

	// Procedural Sine -> Triangle -> Saw -> Square fallback only when buffer is unbound
	hasWt = (abs(s00) + abs(s01) + abs(s10) > 0.000001) ? 1 : 0;
	if (hasWt == 0) {
		pSin = sin(wPh * 6.28318530718);
		pTri = 1.0 - 4.0 * abs(wrap(wPh - 0.25, 0, 1) - 0.5);
		pSaw = 1.0 - 2.0 * wPh;
		pSqr = (wPh < 0.5) ? 0.9 : -0.9;
		sig = (fScaled <= 1.0) ? mix(pSin, pTri, fScaled) : ((fScaled <= 2.0) ? mix(pTri, pSaw, fScaled - 1.0) : mix(pSaw, pSqr, fScaled - 2.0));
	}
	return sig * amp, amp, heldQm;
}

Buffer wt("percipwt");
Buffer scope("percipscope");

Param pitch(0.0);
Param stretch(1.0);
Param fshift(0.0);
Param snap(1.0);
Param scalemask(2741);
Param gate(-42.0);
Param decay(120.0);
Param attack(2.5);
Param blur(0.25);
Param tilt(0.0);
Param sieve(0);
Param freeze(0);
Param wtpos(0.0);
Param wtmode(0);
Param warp(0.5);
Param resynthgain(0.0);
Param wet(1.0);

History tick(0);
History rollCount(0);
History ctrlInit(0);
History gateLin(0.007943);
History resGainLin(1.0);
History atkCoef(0.99);
History relCoef(0.999);
History bendExp(1.0);
History dryG(0.0);
History wetG(1.0);

sr = max(samplerate, 1);

pitchS = slew(clip(pitch, -24, 24), 0.999);
stretchS = slew(clip(stretch, 0.5, 2.0), 0.999);
fshiftS = slew(clip(fshift, -2000, 2000), 0.999);
snapS = slew(clip(snap, 0, 1), 0.999);
gateDbS = slew(clip(gate, -66, -6), 0.999);
decayMsS = slew(clip(decay, 1, 1500), 0.999);
atkMsS = slew(clip(attack, 0.2, 100), 0.999);
blurS = slew(clip(blur, 0, 1), 0.999);
tiltS = slew(clip(tilt, -1, 1), 0.999);
wtPosS = slew(clip(wtpos, 0, 1), 0.999);
warpS = slew(clip(warp, 0, 1), 0.999);
resGainDbS = slew(clip(resynthgain, -36, 18), 0.999);
wetS = slew(clip(wet, 0, 1), 0.999);
modeNow = round(clip(wtmode, 0, 3));
sieveNow = round(clip(sieve, 0, 4));
freezeNow = (freeze > 0.5) ? 1 : 0;
maskNow = round(clip(scalemask, 0, 4095));

// Update shared control-rate transcendentals every 16 samples
if ((tick % 16 == 0) || (ctrlInit == 0)) {
	gateLin = pow(10, gateDbS / 20);
	resGainLin = pow(10, resGainDbS / 20);
	effAtkMs = atkMsS + blurS * 45.0;
	effRelMs = decayMsS + blurS * 350.0;
	atkCoef = exp(-1000 / (max(effAtkMs, 0.2) * sr));
	relCoef = exp(-1000 / (max(effRelMs, 1.0) * sr));
	bendExp = (modeNow == 0) ? pow(3.2, (warpS - 0.5) * 2.0) : 1.0;
	ang = wetS * 1.57079632679;
	dryG = cos(ang);
	wetG = sin(ang);
	ctrlInit = 1;
}

monoIn = (in1 + in2) * 0.70710678;
dampBand = 1.0 / 7.5;

// 1. Track 16 spectral bands (with idle sleep & Spectral Freeze latch)
raw0, m0 = band_track(monoIn, 92.5,   dampBand, atkCoef, relCoef, gateLin, freezeNow, sr);
raw1, m1 = band_track(monoIn, 123.5,  dampBand, atkCoef, relCoef, gateLin, freezeNow, sr);
raw2, m2 = band_track(monoIn, 164.8,  dampBand, atkCoef, relCoef, gateLin, freezeNow, sr);
raw3, m3 = band_track(monoIn, 220.0,  dampBand, atkCoef, relCoef, gateLin, freezeNow, sr);
raw4, m4 = band_track(monoIn, 293.7,  dampBand, atkCoef, relCoef, gateLin, freezeNow, sr);
raw5, m5 = band_track(monoIn, 392.0,  dampBand, atkCoef, relCoef, gateLin, freezeNow, sr);
raw6, m6 = band_track(monoIn, 523.3,  dampBand, atkCoef, relCoef, gateLin, freezeNow, sr);
raw7, m7 = band_track(monoIn, 698.5,  dampBand, atkCoef, relCoef, gateLin, freezeNow, sr);
raw8, m8 = band_track(monoIn, 932.3,  dampBand, atkCoef, relCoef, gateLin, freezeNow, sr);
raw9, m9 = band_track(monoIn, 1244.5, dampBand, atkCoef, relCoef, gateLin, freezeNow, sr);
raw10, m10 = band_track(monoIn, 1661.2, dampBand, atkCoef, relCoef, gateLin, freezeNow, sr);
raw11, m11 = band_track(monoIn, 2217.5, dampBand, atkCoef, relCoef, gateLin, freezeNow, sr);
raw12, m12 = band_track(monoIn, 2960.0, dampBand, atkCoef, relCoef, gateLin, freezeNow, sr);
raw13, m13 = band_track(monoIn, 3951.1, dampBand, atkCoef, relCoef, gateLin, freezeNow, sr);
raw14, m14 = band_track(monoIn, 5274.0, dampBand, atkCoef, relCoef, gateLin, freezeNow, sr);
raw15, m15 = band_track(monoIn, 7040.0, dampBand, atkCoef, relCoef, gateLin, freezeNow, sr);

// 2. Synthesize 16 wavetable partials (skips inactive bands when gated/silent)
v0, amp0, qm0 = voice_osc(wt, 0,  raw0,  m0,  pitchS, stretchS, fshiftS, maskNow, snapS, sieveNow, tiltS, wtPosS, modeNow, warpS, bendExp, sr);
v1, amp1, qm1 = voice_osc(wt, 1,  raw1,  m1,  pitchS, stretchS, fshiftS, maskNow, snapS, sieveNow, tiltS, wtPosS, modeNow, warpS, bendExp, sr);
v2, amp2, qm2 = voice_osc(wt, 2,  raw2,  m2,  pitchS, stretchS, fshiftS, maskNow, snapS, sieveNow, tiltS, wtPosS, modeNow, warpS, bendExp, sr);
v3, amp3, qm3 = voice_osc(wt, 3,  raw3,  m3,  pitchS, stretchS, fshiftS, maskNow, snapS, sieveNow, tiltS, wtPosS, modeNow, warpS, bendExp, sr);
v4, amp4, qm4 = voice_osc(wt, 4,  raw4,  m4,  pitchS, stretchS, fshiftS, maskNow, snapS, sieveNow, tiltS, wtPosS, modeNow, warpS, bendExp, sr);
v5, amp5, qm5 = voice_osc(wt, 5,  raw5,  m5,  pitchS, stretchS, fshiftS, maskNow, snapS, sieveNow, tiltS, wtPosS, modeNow, warpS, bendExp, sr);
v6, amp6, qm6 = voice_osc(wt, 6,  raw6,  m6,  pitchS, stretchS, fshiftS, maskNow, snapS, sieveNow, tiltS, wtPosS, modeNow, warpS, bendExp, sr);
v7, amp7, qm7 = voice_osc(wt, 7,  raw7,  m7,  pitchS, stretchS, fshiftS, maskNow, snapS, sieveNow, tiltS, wtPosS, modeNow, warpS, bendExp, sr);
v8, amp8, qm8 = voice_osc(wt, 8,  raw8,  m8,  pitchS, stretchS, fshiftS, maskNow, snapS, sieveNow, tiltS, wtPosS, modeNow, warpS, bendExp, sr);
v9, amp9, qm9 = voice_osc(wt, 9,  raw9,  m9,  pitchS, stretchS, fshiftS, maskNow, snapS, sieveNow, tiltS, wtPosS, modeNow, warpS, bendExp, sr);
v10, amp10, qm10 = voice_osc(wt, 10, raw10, m10, pitchS, stretchS, fshiftS, maskNow, snapS, sieveNow, tiltS, wtPosS, modeNow, warpS, bendExp, sr);
v11, amp11, qm11 = voice_osc(wt, 11, raw11, m11, pitchS, stretchS, fshiftS, maskNow, snapS, sieveNow, tiltS, wtPosS, modeNow, warpS, bendExp, sr);
v12, amp12, qm12 = voice_osc(wt, 12, raw12, m12, pitchS, stretchS, fshiftS, maskNow, snapS, sieveNow, tiltS, wtPosS, modeNow, warpS, bendExp, sr);
v13, amp13, qm13 = voice_osc(wt, 13, raw13, m13, pitchS, stretchS, fshiftS, maskNow, snapS, sieveNow, tiltS, wtPosS, modeNow, warpS, bendExp, sr);
v14, amp14, qm14 = voice_osc(wt, 14, raw14, m14, pitchS, stretchS, fshiftS, maskNow, snapS, sieveNow, tiltS, wtPosS, modeNow, warpS, bendExp, sr);
v15, amp15, qm15 = voice_osc(wt, 15, raw15, m15, pitchS, stretchS, fshiftS, maskNow, snapS, sieveNow, tiltS, wtPosS, modeNow, warpS, bendExp, sr);

// Alternate stereo spread across even/odd bands and scale by the Resynthesized Partials Volume slider
evenSum = v0 + v2 + v4 + v6 + v8 + v10 + v12 + v14;
oddSum = v1 + v3 + v5 + v7 + v9 + v11 + v13 + v15;
hasWet = (abs(evenSum) + abs(oddSum) > 0.0000001);
wetL = hasWet ? (tanh((evenSum * 0.78 + oddSum * 0.42) * 1.35 * resGainLin) * 0.88) : 0;
wetR = hasWet ? (tanh((oddSum * 0.78 + evenSum * 0.42) * 1.35 * resGainLin) * 0.88) : 0;

// 3. Equal-power dry/wet mix
outL = in1 * dryG + wetL * wetG;
outR = in2 * dryG + wetR * wetG;

// 5. Write scope telemetry every 64 samples
tick = wrap(tick + 1, 0, 64);
if (tick == 0) {
	rollCount = wrap(rollCount + 1, 0, 100000);
	poke(scope, clip(amp0, 0, 1.5), 0, 0);
	poke(scope, clip(amp1, 0, 1.5), 1, 0);
	poke(scope, clip(amp2, 0, 1.5), 2, 0);
	poke(scope, clip(amp3, 0, 1.5), 3, 0);
	poke(scope, clip(amp4, 0, 1.5), 4, 0);
	poke(scope, clip(amp5, 0, 1.5), 5, 0);
	poke(scope, clip(amp6, 0, 1.5), 6, 0);
	poke(scope, clip(amp7, 0, 1.5), 7, 0);
	poke(scope, clip(amp8, 0, 1.5), 8, 0);
	poke(scope, clip(amp9, 0, 1.5), 9, 0);
	poke(scope, clip(amp10, 0, 1.5), 10, 0);
	poke(scope, clip(amp11, 0, 1.5), 11, 0);
	poke(scope, clip(amp12, 0, 1.5), 12, 0);
	poke(scope, clip(amp13, 0, 1.5), 13, 0);
	poke(scope, clip(amp14, 0, 1.5), 14, 0);
	poke(scope, clip(amp15, 0, 1.5), 15, 0);

	poke(scope, qm0, 16, 0);
	poke(scope, qm1, 17, 0);
	poke(scope, qm2, 18, 0);
	poke(scope, qm3, 19, 0);
	poke(scope, qm4, 20, 0);
	poke(scope, qm5, 21, 0);
	poke(scope, qm6, 22, 0);
	poke(scope, qm7, 23, 0);
	poke(scope, qm8, 24, 0);
	poke(scope, qm9, 25, 0);
	poke(scope, qm10, 26, 0);
	poke(scope, qm11, 27, 0);
	poke(scope, qm12, 28, 0);
	poke(scope, qm13, 29, 0);
	poke(scope, qm14, 30, 0);
	poke(scope, qm15, 31, 0);

	outPk = max(abs(wetL), abs(wetR));
	activeN = (amp0 > 0.002) + (amp1 > 0.002) + (amp2 > 0.002) + (amp3 > 0.002) +
	          (amp4 > 0.002) + (amp5 > 0.002) + (amp6 > 0.002) + (amp7 > 0.002) +
	          (amp8 > 0.002) + (amp9 > 0.002) + (amp10 > 0.002) + (amp11 > 0.002) +
	          (amp12 > 0.002) + (amp13 > 0.002) + (amp14 > 0.002) + (amp15 > 0.002);
	poke(scope, outPk, 32, 0);
	poke(scope, activeN, 33, 0);
	poke(scope, gateLin, 34, 0);
	poke(scope, rollCount, 35, 0);
}

out1 = fixnan(outL);
out2 = fixnan(outR);
