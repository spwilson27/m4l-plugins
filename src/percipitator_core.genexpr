// Percipitator — 16-Band Scale-Quantized Wavetable Resynthesizer.
//
// Buffers (bound on loadbang via `wt #0-percipwt, scope #0-percipscope`):
//   wt    ("percipwt")   : 8192 samples (4 frames x 2048 samples: Sine -> Triangle -> Saw -> Square)
//   scope ("percipscope"): 64 samples (indices 0..35 are the telemetry the face reads):
//     0..15  : per-band post-sieve/tilt/freeze resynthesis amplitude (0..1.5)
//     16..31 : per-band quantized MIDI note
//     32     : peak output level
//     33     : active partial count
//     34     : current gate linear
//     35     : rolling frame counter, +1 every 64 samples, including while the input is silent
//              and every band is asleep (deferred-DSP confirm watches this slot)
//
// Compile / CPU:
//   band_track and voice_osc each have one call site, inside `for (b = 0; b < 16; b += 1)`.
//   Per-band filter and oscillator state lives in Data (a call site's History is shared across
//   loop iterations). SVF coefficients are cached when samplerate changes. Attack, decay, gate,
//   tilt, sieve, bend and wet/dry gains update every 16 samples.
//   Silent input with every band asleep skips the band loop; the frame counter still advances.
//
// GenExpr rules strictly enforced:
//   - All functions appear before Buffer, Param, History, and expression statements.
//   - No identifier is named e<digit> (Euler's constant lexer bug).
//   - No return inside an if or a loop. One return, at function level.

slew(target, coef) {
	History s(0);
	History init(0);
	s = (init == 0) ? target : mix(target, s, coef);
	init = 1;
	return s;
}

// Polynomial SVF frequency coefficient (no sin). centerHz is a band constant.
svf_coef(centerHz, srVal) {
	w = 3.14159265359 * clip(centerHz, 40, srVal * 0.42) / srVal;
	return w * (2.0 - 0.33333333 * w * w);
}

// Exact analysis centers. Called only while rebuilding the SVF cache.
band_hz(band) {
	hz = 92.5;
	hz = (band == 1) ? 123.5 : hz;
	hz = (band == 2) ? 164.8 : hz;
	hz = (band == 3) ? 220.0 : hz;
	hz = (band == 4) ? 293.7 : hz;
	hz = (band == 5) ? 392.0 : hz;
	hz = (band == 6) ? 523.3 : hz;
	hz = (band == 7) ? 698.5 : hz;
	hz = (band == 8) ? 932.3 : hz;
	hz = (band == 9) ? 1244.5 : hz;
	hz = (band == 10) ? 1661.2 : hz;
	hz = (band == 11) ? 2217.5 : hz;
	hz = (band == 12) ? 2960.0 : hz;
	hz = (band == 13) ? 3951.1 : hz;
	hz = (band == 14) ? 5274.0 : hz;
	hz = (band == 15) ? 7040.0 : hz;
	return hz;
}

// One bit of a 12-bit scale mask. Used only when the mask changes.
mask_bit(mask, pc) {
	return int(floor(mask / pow(2, pc))) % 2;
}

// Partial sieve gain. sieveMode: 0=All, 1=Odd, 2=Even, 3=Sparse, 4=Rising.
sieve_one(bandIdx, sieveMode) {
	m = round(clip(sieveMode, 0, 4));
	isEven = ((bandIdx % 2) == 0);
	isThird = ((bandIdx % 3) == 0);
	sAll = 1.0;
	sOdd = isEven ? 1.0 : 0.06;
	sEven = isEven ? 0.06 : 1.0;
	sSprs = isThird ? 1.18 : 0.03;
	sRise = 0.22 + 0.98 * (bandIdx / 15.0);
	sieveG = (m == 0) ? sAll : ((m == 1) ? sOdd : ((m == 2) ? sEven : ((m == 3) ? sSprs : sRise)));
	return sieveG;
}

// Spectral tilt. The `* pos * 6.0` term is +/-36 dB at the outer bands.
tilt_one(bandIdx, tiltBipolar) {
	pos = ((bandIdx / 15.0) - 0.5) * 2.0;
	return pow(2.0, clip(tiltBipolar, -1, 1) * pos * 6.0);
}

// Quantize a MIDI note to the active scale. scBits holds the 12 pitch-class bits (no pow in the search).
quant_midi(inMidi, scBits, snapAmt, maskInt) {
	base = round(inMidi);
	best = base;
	bestDist = 99;
	for (k = -11; k <= 11; k += 1) {
		cand = base + k;
		pc = int(wrap(cand, 0, 12));
		bit = scBits.peek(pc);
		dist = abs(cand - inMidi);
		take = (bit > 0) && (dist < bestDist);
		best = take ? cand : best;
		bestDist = take ? dist : bestDist;
	}
	effBest = (maskInt > 0) ? best : inMidi;
	return mix(inMidi, effBest, clip(snapAmt, 0, 1));
}

// Phase warp. mode 0 Bend (precomputed bendExp), 1 Asym, 2 Sync, 3 Fold.
warp_phase(ph, mode, warpAmt, bendExp) {
	p = wrap(ph, 0, 1);
	w = clip(warpAmt, 0, 1);
	m = round(clip(mode, 0, 3));
	outP = p;
	if (m == 0) {
		outP = (abs(w - 0.5) < 0.003) ? p : pow(max(p, 0.00001), bendExp);
	} else if (m == 1) {
		bp = 0.5 - w * 0.38;
		outP = (p < bp) ? (0.5 * p / max(bp, 0.02)) : (0.5 + 0.5 * (p - bp) / max(1 - bp, 0.02));
	} else if (m == 2) {
		outP = wrap(p * (1 + w * 4.0), 0, 1);
	} else {
		fp = wrap(p * (1 + w * 3.0), 0, 2);
		outP = (fp <= 1) ? fp : (2 - fp);
	}
	return clip(outP, 0, 0.9999);
}

// Chamberlin SVF bandpass + zero-crossing pitch tracker + freeze latch.
// State in bandSt, stride 10:
//   0 lp, 1 bp, 2 env, 3 prevSign, 4 periodSamps, 5 sampCount, 6 targetMidi, 7 midiHold, 8 frozenAmp, 9 frozenMidi
// Third result is 1 while the band is awake, 0 when asleep.
band_track(bandSt, band, x, fCoef, centerHz, dampVal, atkC, relC, gLin, freezeOn, srVal) {
	base = band * 10;
	lpState = bandSt.peek(base);
	bpState = bandSt.peek(base + 1);
	envState = bandSt.peek(base + 2);
	prevSign = bandSt.peek(base + 3);
	periodSamps = bandSt.peek(base + 4);
	sampCount = bandSt.peek(base + 5);
	targetMidi = bandSt.peek(base + 6);
	midiHold = bandSt.peek(base + 7);
	frozenAmp = bandSt.peek(base + 8);
	frozenMidi = bandSt.peek(base + 9);

	isFrz = (freezeOn > 0.5);
	outAmp = frozenAmp;
	outMidi = frozenMidi;
	activity = abs(x) + abs(bpState) + abs(lpState) + envState;
	asleep = (activity < 0.0000005);
	alive = 1;

	if (isFrz) {
		outAmp = frozenAmp;
		outMidi = frozenMidi;
		alive = 1;
	} else {
		if (asleep) {
			bpState = 0;
			lpState = 0;
			envState = 0;
			frozenAmp = 0;
			outAmp = 0;
			outMidi = midiHold;
			alive = 0;
		} else {
			hp = x * dampVal - lpState - dampVal * bpState;
			bpNew = bpState + fCoef * hp;
			lpNew = lpState + fCoef * bpNew;
			bpState = clip(bpNew, -2, 2);
			lpState = clip(lpNew, -2, 2);

			sampCount = sampCount + 1;
			curSign = (bpState >= 0) ? 1 : -1;
			crossed = (curSign > 0) && (prevSign < 0);
			validCross = crossed && (sampCount > 4) && (sampCount < srVal * 0.03);
			if (validCross) {
				periodSamps = mix(sampCount, periodSamps, 0.65);
				estHz = clip(srVal / max(periodSamps, 4), centerHz * 0.72, centerHz * 1.38);
				targetMidi = 69 + 12 * log2(max(estHz, 20) / 440);
			}
			sampCount = crossed ? 0 : sampCount;
			prevSign = curSign;
			midiHold = mix(targetMidi, midiHold, 0.992);

			ax = abs(bpState) * 1.45;
			c = (ax > envState) ? atkC : relC;
			envState = mix(ax, envState, c);

			gLo = max(gLin * 0.6, 0.00001);
			gHi = max(gLin * 1.6, gLo + 0.0001);
			gt = clip((envState - gLo) / (gHi - gLo), 0, 1);
			gateFactor = gt * gt * (3 - 2 * gt);
			liveAmp = envState * gateFactor;

			frozenAmp = liveAmp;
			frozenMidi = midiHold;
			outAmp = liveAmp;
			outMidi = midiHold;
			alive = 1;
		}
	}

	bandSt.poke(lpState, base);
	bandSt.poke(bpState, base + 1);
	bandSt.poke(envState, base + 2);
	bandSt.poke(prevSign, base + 3);
	bandSt.poke(periodSamps, base + 4);
	bandSt.poke(sampCount, base + 5);
	bandSt.poke(targetMidi, base + 6);
	bandSt.poke(midiHold, base + 7);
	bandSt.poke(frozenAmp, base + 8);
	bandSt.poke(frozenMidi, base + 9);
	return outAmp, outMidi, alive;
}

// Wavetable voice. Oscillator state in oscSt, stride 6: 0 phase, 1 tick, 2 init, 3 weight, 4 midi, 5 freq.
// Skips the oscillator when the band is gated. Re-quantizes every 16 samples or on the first active sample
// (matching the original 16-sample control rate!).
voice_osc(wtBuf, oscSt, wgt, scBits, bandIdx, rawAmp, rawMidi, pitchSt, stretchVal, fshiftHz, snapAmt, maskInt, wtPos01, warpMode, warpAmt, bendExp, srVal) {
	base = bandIdx * 6;
	ph = oscSt.peek(base);
	cTick = oscSt.peek(base + 1);
	cInit = oscSt.peek(base + 2);
	heldWeight = oscSt.peek(base + 3);
	heldQm = oscSt.peek(base + 4);
	heldFreq = oscSt.peek(base + 5);

	outSig = 0;
	outAmp = 0;
	if (!((rawAmp <= 0.00001) && (cInit > 0))) {
		if ((cTick == 0) || (cInit == 0)) {
			heldWeight = wgt.peek(bandIdx);
			heldQm = quant_midi(69 + (rawMidi - 69) * stretchVal + pitchSt, scBits, snapAmt, maskInt);
			heldFreq = clip(440 * pow(2, (heldQm - 69) / 12) + fshiftHz, 20, 18000);
			cInit = 1;
		}
		cTick = wrap(cTick + 1, 0, 16);

		amp = rawAmp * heldWeight;
		if (amp > 0.00001) {
			inc = clip(heldFreq / srVal, 0, 0.45);
			ph = wrap(ph + inc, 0, 1);

			wPh = warp_phase(ph, warpMode, warpAmt, bendExp);
			fScaled = clip(wtPos01, 0, 1) * 3.0;
			f0 = floor(fScaled);
			f1 = min(3, f0 + 1);
			fFrac = fScaled - f0;

			idx = wPh * 2048.0;
			i0 = floor(idx);
			i1 = wrap(i0 + 1, 0, 2048);
			iFrac = idx - i0;

			s00 = peek(wtBuf, f0 * 2048 + i0);
			s01 = peek(wtBuf, f0 * 2048 + i1);
			s10 = peek(wtBuf, f1 * 2048 + i0);
			s11 = peek(wtBuf, f1 * 2048 + i1);
			wt0 = mix(s00, s01, iFrac);
			wt1 = mix(s10, s11, iFrac);
			sig = mix(wt0, wt1, fFrac);

			hasWt = (abs(s00) + abs(s01) + abs(s10) > 0.000001) ? 1 : 0;
			if (hasWt == 0) {
				pSin = sin(wPh * 6.28318530718);
				pTri = 1.0 - 4.0 * abs(wrap(wPh + 0.25, 0, 1) - 0.5);
				pSaw = 1.0 - 2.0 * wPh;
				pSqr = (wPh < 0.5) ? 0.9 : -0.9;
				sig = (fScaled <= 1.0) ? mix(pSin, pTri, fScaled) : ((fScaled <= 2.0) ? mix(pTri, pSaw, fScaled - 1.0) : mix(pSaw, pSqr, fScaled - 2.0));
			}
			outSig = sig * amp;
			outAmp = amp;
		}
	}

	oscSt.poke(ph, base);
	oscSt.poke(cTick, base + 1);
	oscSt.poke(cInit, base + 2);
	oscSt.poke(heldWeight, base + 3);
	oscSt.poke(heldQm, base + 4);
	oscSt.poke(heldFreq, base + 5);
	return outSig, outAmp, heldQm;
}

Buffer wt("percipwt");
Buffer scope("percipscope");

Data bst(160);
Data ost(96);
Data svfF(16);
Data bhz(16);
Data bwgt(16);
Data scbit(12);
Data vout(32);

Param pitch(0.0);
Param stretch(1.0);
Param fshift(0.0);
Param snap(1.0);
Param scalemask(2741);
Param gate(-42.0);
Param decay(120.0);
Param attack(2.5);
Param blur(0.25);
Param tilt(0.0);
Param sieve(0);
Param freeze(0);
Param wtpos(0.0);
Param wtmode(0);
Param warp(0.5);
Param resynthgain(0.0);
Param wet(1.0);

History tick(0);
History rollCount(0);
History ctrlInit(0);
History gateLin(0.007943);
History resGainLin(1.0);
History atkCoef(0.99);
History relCoef(0.999);
History bendExp(1.0);
History dryG(0.0);
History wetG(1.0);
History boot(0);
History srHeld(0);
History coefInit(0);
History maskHeld(-1);
History bitInit(0);
History awakeLatch(0);

sr = max(samplerate, 1);

if (boot == 0) {
	for (b = 0; b < 16; b += 1) {
		base = b * 10;
		bst.poke(1, base + 3);
		bst.poke(100, base + 4);
		bst.poke(60, base + 6);
		bst.poke(60, base + 7);
		bst.poke(60, base + 9);
		ob = b * 6;
		ost.poke(1, ob + 3);
		ost.poke(60, ob + 4);
		ost.poke(440, ob + 5);
	}
	boot = 1;
}

if ((coefInit == 0) || (srHeld != sr)) {
	for (b = 0; b < 16; b += 1) {
		fc = band_hz(b);
		bhz.poke(fc, b);
		sf = svf_coef(fc, sr);
		svfF.poke(sf, b);
	}
	srHeld = sr;
	coefInit = 1;
}

pitchS = slew(clip(pitch, -24, 24), 0.999);
stretchS = slew(clip(stretch, 0.5, 2.0), 0.999);
fshiftS = slew(clip(fshift, -2000, 2000), 0.999);
snapS = slew(clip(snap, 0, 1), 0.999);
gateDbS = slew(clip(gate, -66, -6), 0.999);
decayMsS = slew(clip(decay, 1, 1500), 0.999);
atkMsS = slew(clip(attack, 0.2, 100), 0.999);
blurS = slew(clip(blur, 0, 1), 0.999);
tiltS = slew(clip(tilt, -1, 1), 0.999);
wtPosS = slew(clip(wtpos, 0, 1), 0.999);
warpS = slew(clip(warp, 0, 1), 0.999);
resGainDbS = slew(clip(resynthgain, -36, 18), 0.999);
wetS = slew(clip(wet, 0, 1), 0.999);
modeNow = round(clip(wtmode, 0, 3));
sieveNow = round(clip(sieve, 0, 4));
freezeNow = (freeze > 0.5) ? 1 : 0;
maskNow = round(clip(scalemask, 0, 4095));

if ((bitInit == 0) || (maskHeld != maskNow)) {
	for (pc = 0; pc < 12; pc += 1) {
		mb = mask_bit(maskNow, pc);
		scbit.poke(mb, pc);
	}
	maskHeld = maskNow;
	bitInit = 1;
}

if ((ctrlInit == 0) || (tick % 16 == 0)) {
	gateLin = pow(10, gateDbS / 20);
	resGainLin = pow(10, resGainDbS / 20);
	effAtkMs = atkMsS + blurS * 45.0;
	effRelMs = decayMsS + blurS * 350.0;
	atkCoef = exp(-1000 / (max(effAtkMs, 0.2) * sr));
	relCoef = exp(-1000 / (max(effRelMs, 1.0) * sr));
	bendExp = (modeNow == 0) ? pow(3.2, (warpS - 0.5) * 2.0) : 1.0;
	ang = wetS * 1.57079632679;
	dryG = cos(ang);
	wetG = sin(ang);
	for (b = 0; b < 16; b += 1) {
		sv1 = sieve_one(b, sieveNow);
		tl1 = tilt_one(b, tiltS);
		bwgt.poke(sv1 * tl1, b);
	}
	ctrlInit = 1;
}

monoIn = (in1 + in2) * 0.70710678;
dampBand = 1.0 / 7.5;

evenSum = 0;
oddSum = 0;
wetL = 0;
wetR = 0;
runBands = (freezeNow > 0.5) || (abs(monoIn) > 0.0000005) || (awakeLatch > 0.5);
if (runBands) {
	anyLive = 0;
	for (b = 0; b < 16; b += 1) {
		sfB = svfF.peek(b);
		hzB = bhz.peek(b);
		rawA, rawM, alive = band_track(bst, b, monoIn, sfB, hzB, dampBand, atkCoef, relCoef, gateLin, freezeNow, sr);
		sig, amp, qm = voice_osc(wt, ost, bwgt, scbit, b, rawA, rawM, pitchS, stretchS, fshiftS, snapS, maskNow, wtPosS, modeNow, warpS, bendExp, sr);
		vout.poke(amp, b);
		vout.poke(qm, 16 + b);
		if ((b % 2) == 0) {
			evenSum = evenSum + sig;
		} else {
			oddSum = oddSum + sig;
		}
		anyLive = (alive > 0.5) ? 1 : anyLive;
	}
	awakeLatch = anyLive;
	hasWet = (abs(evenSum) + abs(oddSum) > 0.0000001);
	wetL = hasWet ? (tanh((evenSum * 0.78 + oddSum * 0.42) * 1.35 * resGainLin) * 0.88) : 0;
	wetR = hasWet ? (tanh((oddSum * 0.78 + evenSum * 0.42) * 1.35 * resGainLin) * 0.88) : 0;
}

outL = in1 * dryG + wetL * wetG;
outR = in2 * dryG + wetR * wetG;

tick = wrap(tick + 1, 0, 64);
if (tick == 0) {
	rollCount = wrap(rollCount + 1, 0, 100000);
	activeN = 0;
	for (b = 0; b < 16; b += 1) {
		ampB = vout.peek(b);
		poke(scope, clip(ampB, 0, 1.5), b, 0);
		poke(scope, vout.peek(16 + b), 16 + b, 0);
		activeN = activeN + ((ampB > 0.002) ? 1 : 0);
	}
	outPk = max(abs(wetL), abs(wetR));
	poke(scope, outPk, 32, 0);
	poke(scope, activeN, 33, 0);
	poke(scope, gateLin, 34, 0);
	poke(scope, rollCount, 35, 0);
}

out1 = fixnan(outL);
out2 = fixnan(outR);
