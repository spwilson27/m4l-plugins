// Multiband Split — Phase-Coherent Linkwitz-Riley (12 / 24 / 48 dB/oct) 2/3/4-Band Crossover Engine
// All parallel bands sum to an exact allpass unity transfer function (0.000 dB flat response).
// Dynamic Phase (dynphase = 1): F1 stays a minimum-phase Linkwitz-Riley split, while F2 / F3 become
// complementary linear-phase FIR splits (Kaiser beta 6 windowed sinc, half-length D = 128 samples at
// 48 kHz) of the F1 high band. Band 1 is the F1 low band delayed by D, so all bands sum to the F1
// allpass delayed by exactly D samples (latency D, reported to Live by the v8ui).
//
// Work sharing (every instance of a rack runs this core on the same input and outputs only its own band):
//  - prune = 1 computes only the filters the bands in bandmask need. The allpass phase compensation of a needed
//    band is the same as in the full tree, so the rack still sums to the exact allpass. prune = 0 (a lone instance)
//    computes every band up to numbands, so the band meters of the face show all of them.
//  - Dynamic Phase only needs stage 1 of the IIR tree (the FIR splits the high band); stages 2 and 3 are skipped.
//  - ringon = 0 stops writing the 8192-sample FFT ring: the face of one instance per rack computes the spectrogram.
//  - Silence sleep: input below 1e-5 for 16384 samples skips all filter work (exact zero output).
//  - Filter coefficients are recomputed only when a smoothed crossover, the slope or the sample rate changes.

slew_step(cur, target, coef) {
    return cur + (target - cur) * coef;
}

calc_tan_g(fc, sr) {
    fClamped = clamp(fc, 20.0, sr * 0.48);
    return tan(3.141592653589793 * fClamped / sr);
}

db_to_lin(db) {
    return pow(10.0, db * 0.05);
}

Buffer scope("splitscope");

Param f1(120.0);
Param f2(800.0);
Param f3(4500.0);
Param numbands(3.0);
Param slope(1.0);
Param bandmask(1.0);
Param gain(0.0);
Param phase(0.0);
Param dynphase(0.0);
Param prune(0.0);
Param ringon(1.0);

// Dynamic Phase FIR state: 6-channel input ring (x, low1, high1 for L / R), Kaiser half-window, F2 / F3 half-kernels
Data firRing(2048, 6);
Data firWin(520);
Data firK2(520);
Data firK3(520);
History firD(128.0);
History firSr(0.0);
History firWp(0.0);
History kF2(-1.0);
History kF3(-1.0);
History kCnt(0.0);
History dynActive(0.0);
History dynFade(1.0);

// Smoothed frequency & gain histories
History smF1(120.0);
History smF2(800.0);
History smF3(4500.0);
History smGain(1.0);
History lastSlope(-1.0);



// --- Stage 1 (Crossover F1) States (L & R) ---
// LR2 (1st-order cascades)
History s1_l1a_L(0.0), s1_l1b_L(0.0), s1_h1a_L(0.0), s1_h1b_L(0.0);
History s1_l1a_R(0.0), s1_l1b_R(0.0), s1_h1a_R(0.0), s1_h1b_R(0.0);
// LR4 / LR8 SVF states for Stage 1 LP (4 stages per channel) & HP (4 stages per channel)
History s1_lp1_ic1L(0.0), s1_lp1_ic2L(0.0), s1_lp2_ic1L(0.0), s1_lp2_ic2L(0.0);
History s1_lp3_ic1L(0.0), s1_lp3_ic2L(0.0), s1_lp4_ic1L(0.0), s1_lp4_ic2L(0.0);
History s1_hp1_ic1L(0.0), s1_hp1_ic2L(0.0), s1_hp2_ic1L(0.0), s1_hp2_ic2L(0.0);
History s1_hp3_ic1L(0.0), s1_hp3_ic2L(0.0), s1_hp4_ic1L(0.0), s1_hp4_ic2L(0.0);

History s1_lp1_ic1R(0.0), s1_lp1_ic2R(0.0), s1_lp2_ic1R(0.0), s1_lp2_ic2R(0.0);
History s1_lp3_ic1R(0.0), s1_lp3_ic2R(0.0), s1_lp4_ic1R(0.0), s1_lp4_ic2R(0.0);
History s1_hp1_ic1R(0.0), s1_hp1_ic2R(0.0), s1_hp2_ic1R(0.0), s1_hp2_ic2R(0.0);
History s1_hp3_ic1R(0.0), s1_hp3_ic2R(0.0), s1_hp4_ic1R(0.0), s1_hp4_ic2R(0.0);

// --- Stage 2 (Crossover F2) States (L & R) ---
History s2_l1a_L(0.0), s2_l1b_L(0.0), s2_h1a_L(0.0), s2_h1b_L(0.0);
History s2_l1a_R(0.0), s2_l1b_R(0.0), s2_h1a_R(0.0), s2_h1b_R(0.0);
History s2_lp1_ic1L(0.0), s2_lp1_ic2L(0.0), s2_lp2_ic1L(0.0), s2_lp2_ic2L(0.0);
History s2_lp3_ic1L(0.0), s2_lp3_ic2L(0.0), s2_lp4_ic1L(0.0), s2_lp4_ic2L(0.0);
History s2_hp1_ic1L(0.0), s2_hp1_ic2L(0.0), s2_hp2_ic1L(0.0), s2_hp2_ic2L(0.0);
History s2_hp3_ic1L(0.0), s2_hp3_ic2L(0.0), s2_hp4_ic1L(0.0), s2_hp4_ic2L(0.0);

History s2_lp1_ic1R(0.0), s2_lp1_ic2R(0.0), s2_lp2_ic1R(0.0), s2_lp2_ic2R(0.0);
History s2_lp3_ic1R(0.0), s2_lp3_ic2R(0.0), s2_lp4_ic1R(0.0), s2_lp4_ic2R(0.0);
History s2_hp1_ic1R(0.0), s2_hp1_ic2R(0.0), s2_hp2_ic1R(0.0), s2_hp2_ic2R(0.0);
History s2_hp3_ic1R(0.0), s2_hp3_ic2R(0.0), s2_hp4_ic1R(0.0), s2_hp4_ic2R(0.0);

// Allpass F2 on Band 1 (for 3-way and 4-way phase alignment)
History ap2_b1_z1L(0.0), ap2_b1_z1R(0.0);
History ap2_b1_1_ic1L(0.0), ap2_b1_1_ic2L(0.0), ap2_b1_2_ic1L(0.0), ap2_b1_2_ic2L(0.0);
History ap2_b1_1_ic1R(0.0), ap2_b1_1_ic2R(0.0), ap2_b1_2_ic1R(0.0), ap2_b1_2_ic2R(0.0);

// --- Stage 3 (Crossover F3) States (L & R) ---
History s3_l1a_L(0.0), s3_l1b_L(0.0), s3_h1a_L(0.0), s3_h1b_L(0.0);
History s3_l1a_R(0.0), s3_l1b_R(0.0), s3_h1a_R(0.0), s3_h1b_R(0.0);
History s3_lp1_ic1L(0.0), s3_lp1_ic2L(0.0), s3_lp2_ic1L(0.0), s3_lp2_ic2L(0.0);
History s3_lp3_ic1L(0.0), s3_lp3_ic2L(0.0), s3_lp4_ic1L(0.0), s3_lp4_ic2L(0.0);
History s3_hp1_ic1L(0.0), s3_hp1_ic2L(0.0), s3_hp2_ic1L(0.0), s3_hp2_ic2L(0.0);
History s3_hp3_ic1L(0.0), s3_hp3_ic2L(0.0), s3_hp4_ic1L(0.0), s3_hp4_ic2L(0.0);

History s3_lp1_ic1R(0.0), s3_lp1_ic2R(0.0), s3_lp2_ic1R(0.0), s3_lp2_ic2R(0.0);
History s3_lp3_ic1R(0.0), s3_lp3_ic2R(0.0), s3_lp4_ic1R(0.0), s3_lp4_ic2R(0.0);
History s3_hp1_ic1R(0.0), s3_hp1_ic2R(0.0), s3_hp2_ic1R(0.0), s3_hp2_ic2R(0.0);
History s3_hp3_ic1R(0.0), s3_hp3_ic2R(0.0), s3_hp4_ic1R(0.0), s3_hp4_ic2R(0.0);

// Allpass F3 on Band 1 and Band 2 (for 4-way phase alignment)
History ap3_b1_z1L(0.0), ap3_b1_z1R(0.0);
History ap3_b1_1_ic1L(0.0), ap3_b1_1_ic2L(0.0), ap3_b1_2_ic1L(0.0), ap3_b1_2_ic2L(0.0);
History ap3_b1_1_ic1R(0.0), ap3_b1_1_ic2R(0.0), ap3_b1_2_ic1R(0.0), ap3_b1_2_ic2R(0.0);

History ap3_b2_z1L(0.0), ap3_b2_z1R(0.0);
History ap3_b2_1_ic1L(0.0), ap3_b2_1_ic2L(0.0), ap3_b2_2_ic1L(0.0), ap3_b2_2_ic2L(0.0);
History ap3_b2_1_ic1R(0.0), ap3_b2_1_ic2R(0.0), ap3_b2_2_ic1R(0.0), ap3_b2_2_ic2R(0.0);

// Cached coefficients (stage s): tan(g), g / (1 + g) and the two SVF damping sets (kStageA, kStageB)
History cF1(-1.0), hg_f1(0.0), hg1_f1(0.0);
History ha1A_1(0.0), ha2A_1(0.0), ha3A_1(0.0), ha1B_1(0.0), ha2B_1(0.0), ha3B_1(0.0);
History cF2(-1.0), hg_f2(0.0), hg1_f2(0.0);
History ha1A_2(0.0), ha2A_2(0.0), ha3A_2(0.0), ha1B_2(0.0), ha2B_2(0.0), ha3B_2(0.0);
History cF3(-1.0), hg_f3(0.0), hg1_f3(0.0);
History ha1A_3(0.0), ha2A_3(0.0), ha3A_3(0.0), ha1B_3(0.0), ha2B_3(0.0), ha3B_3(0.0);
History cSr(0.0), cSl(-1.0);

// Peak telemetry & 8192-sample FFT ring buffer histories
History pkB1(0.0), pkB2(0.0), pkB3(0.0), pkB4(0.0);
History pkIn(0.0), pkOut(0.0);
History scopeCnt(0.0), scopeBeat(0.0);
History ringPos(0.0);
History quietCnt(0.0);

sr = max(samplerate, 1.0);
xL = fixnan(in1);
xR = fixnan(in2);

// Silence sleep: no filter work after 16384 quiet samples (a wake-up is immediate: qc is a local, not the History)
inLevel = max(abs(xL), abs(xR));
qc = (inLevel < 0.00001) ? min(quietCnt + 1.0, 1000000.0) : 0.0;
quietCnt = qc;
asleep = (qc > 16384.0) ? 1.0 : 0.0;

// Parameter smoothing (~3 ms)
smoothCoef = 1.0 - exp(-1.0 / (0.003 * sr));
targetF1 = clamp(f1, 20.0, sr * 0.48);
targetF2 = clamp(max(f2, targetF1 * 1.1892), 24.0, sr * 0.48);
targetF3 = clamp(max(f3, targetF2 * 1.1892), 28.0, sr * 0.48);

smF1 = slew_step(smF1, targetF1, smoothCoef);
smF2 = slew_step(smF2, targetF2, smoothCoef);
smF3 = slew_step(smF3, targetF3, smoothCoef);

targetGainLin = (gain <= -69.5) ? 0.0 : db_to_lin(clamp(gain, -70.0, 18.0));
smGain = slew_step(smGain, targetGainLin, smoothCoef);

nb = clamp(round(numbands), 1.0, 4.0);
slopeMode = clamp(round(slope), 0.0, 2.0);
maskInt = clamp(round(bandmask), 0.0, 15.0);
phaseSign = (phase > 0.5) ? -1.0 : 1.0;

// Decode 4-bit bandmask
en1 = (mod(floor(maskInt), 2.0) >= 0.5) ? 1.0 : 0.0;
en2 = (mod(floor(maskInt * 0.5), 2.0) >= 0.5) ? 1.0 : 0.0;
en3 = (mod(floor(maskInt * 0.25), 2.0) >= 0.5) ? 1.0 : 0.0;
en4 = (mod(floor(maskInt * 0.125), 2.0) >= 0.5) ? 1.0 : 0.0;

// Which bands are computed: with prune only the ones in the mask, otherwise every band up to numbands
pr = (prune > 0.5) ? 1.0 : 0.0;
b1 = (pr > 0.5) ? en1 : 1.0;
b2 = ((pr > 0.5) ? en2 : 1.0) * ((nb > 1.5) ? 1.0 : 0.0);
b3 = ((pr > 0.5) ? en3 : 1.0) * ((nb > 2.5) ? 1.0 : 0.0);
b4 = ((pr > 0.5) ? en4 : 1.0) * ((nb > 3.5) ? 1.0 : 0.0);

// IIR tree: stage 1 serves both phase modes, stages 2 / 3 only the all-IIR mode (Dynamic Phase uses the FIR instead).
// Warm during the 4 ms fade from Dynamic Phase back to IIR (dynphase already 0, dynActive still 1).
runIIR = ((dynActive < 0.5) || (dynphase < 0.5)) ? 1.0 : 0.0;
needLP1 = b1 * ((nb > 1.5) ? 1.0 : 0.0);
needHP1 = max(b2, max(b3, b4));
s2on = ((nb > 2.5) ? 1.0 : 0.0) * runIIR;
s3on = ((nb > 3.5) ? 1.0 : 0.0) * runIIR;
needLP2 = s2on * b2;
needHP2 = s2on * max(b3, b4);
needAP2a = s2on * b1;
needLP3 = s3on * b3;
needHP3 = s3on * b4;
needAP3a = s3on * b1;
needAP3b = s3on * b2;

// Damping constants for Butterworth 2nd-order (LR4) and 4th-order (LR8)
kButter2 = 1.4142135623730951;
kButter4A = 1.8477590650225735;
kButter4B = 0.7653668647301796;

// Effective damping per SVF stage based on slopeMode (1 = LR4 uses kButter2; 2 = LR8 alternates A and B)
kStageA = (slopeMode > 1.5) ? kButter4A : kButter2;
kStageB = (slopeMode > 1.5) ? kButter4B : kButter2;

// Coefficients are cached: recomputed only when a smoothed crossover moved, or the slope mode / rate changed
keyChg = ((slopeMode != cSl) || (sr != cSr)) ? 1.0 : 0.0;

g_f1 = hg_f1; g1_f1 = hg1_f1;
a1A_1 = ha1A_1; a2A_1 = ha2A_1; a3A_1 = ha3A_1;
a1B_1 = ha1B_1; a2B_1 = ha2B_1; a3B_1 = ha3B_1;
if (smF1 != cF1 || keyChg > 0.5) {
    g_f1 = calc_tan_g(smF1, sr);
    g1_f1 = g_f1 / (1.0 + g_f1);
    a1A_1 = 1.0 / (1.0 + g_f1 * (g_f1 + kStageA));
    a2A_1 = g_f1 * a1A_1;
    a3A_1 = g_f1 * a2A_1;
    a1B_1 = 1.0 / (1.0 + g_f1 * (g_f1 + kStageB));
    a2B_1 = g_f1 * a1B_1;
    a3B_1 = g_f1 * a2B_1;
    hg_f1 = g_f1; hg1_f1 = g1_f1;
    ha1A_1 = a1A_1; ha2A_1 = a2A_1; ha3A_1 = a3A_1;
    ha1B_1 = a1B_1; ha2B_1 = a2B_1; ha3B_1 = a3B_1;
    cF1 = smF1;
}

g_f2 = hg_f2; g1_f2 = hg1_f2;
a1A_2 = ha1A_2; a2A_2 = ha2A_2; a3A_2 = ha3A_2;
a1B_2 = ha1B_2; a2B_2 = ha2B_2; a3B_2 = ha3B_2;
if (smF2 != cF2 || keyChg > 0.5) {
    g_f2 = calc_tan_g(smF2, sr);
    g1_f2 = g_f2 / (1.0 + g_f2);
    a1A_2 = 1.0 / (1.0 + g_f2 * (g_f2 + kStageA));
    a2A_2 = g_f2 * a1A_2;
    a3A_2 = g_f2 * a2A_2;
    a1B_2 = 1.0 / (1.0 + g_f2 * (g_f2 + kStageB));
    a2B_2 = g_f2 * a1B_2;
    a3B_2 = g_f2 * a2B_2;
    hg_f2 = g_f2; hg1_f2 = g1_f2;
    ha1A_2 = a1A_2; ha2A_2 = a2A_2; ha3A_2 = a3A_2;
    ha1B_2 = a1B_2; ha2B_2 = a2B_2; ha3B_2 = a3B_2;
    cF2 = smF2;
}

g_f3 = hg_f3; g1_f3 = hg1_f3;
a1A_3 = ha1A_3; a2A_3 = ha2A_3; a3A_3 = ha3A_3;
a1B_3 = ha1B_3; a2B_3 = ha2B_3; a3B_3 = ha3B_3;
if (smF3 != cF3 || keyChg > 0.5) {
    g_f3 = calc_tan_g(smF3, sr);
    g1_f3 = g_f3 / (1.0 + g_f3);
    a1A_3 = 1.0 / (1.0 + g_f3 * (g_f3 + kStageA));
    a2A_3 = g_f3 * a1A_3;
    a3A_3 = g_f3 * a2A_3;
    a1B_3 = 1.0 / (1.0 + g_f3 * (g_f3 + kStageB));
    a2B_3 = g_f3 * a1B_3;
    a3B_3 = g_f3 * a2B_3;
    hg_f3 = g_f3; hg1_f3 = g1_f3;
    ha1A_3 = a1A_3; ha2A_3 = a2A_3; ha3A_3 = a3A_3;
    ha1B_3 = a1B_3; ha2B_3 = a2B_3; ha3B_3 = a3B_3;
    cF3 = smF3;
}

cSl = slopeMode;
cSr = sr;

// Pre-declare stage output variables at outer scope before conditional branches (GenExpr scoping rule)
low1L = 0.0; high1L = 0.0; low1R = 0.0; high1R = 0.0;
low2L = 0.0; high2L = 0.0; low2R = 0.0; high2R = 0.0;
b1_after2L = 0.0; b1_after2R = 0.0;
low3L = 0.0; high3L = 0.0; low3R = 0.0; high3R = 0.0;
b1_after3L = 0.0; b1_after3R = 0.0;
b2_after3L = 0.0; b2_after3R = 0.0;
band1L = 0.0; band1R = 0.0; band2L = 0.0; band2R = 0.0;
band3L = 0.0; band3R = 0.0; band4L = 0.0; band4R = 0.0;

if (asleep < 0.5) {
    // =========================================================================
    // STAGE 1: crossover at smF1
    // =========================================================================
    if (slopeMode < 0.5) {
        // 12 dB/oct (LR2)
        if (needLP1 > 0.5) {
            vL_ = (xL - s1_l1a_L) * g1_f1; lpa_1L = vL_ + s1_l1a_L; s1_l1a_L = lpa_1L + vL_;
            vL2_ = (lpa_1L - s1_l1b_L) * g1_f1; lpb_1L = vL2_ + s1_l1b_L; s1_l1b_L = lpb_1L + vL2_;
            low1L = lpb_1L;
            vL_ = (xR - s1_l1a_R) * g1_f1; lpa_1R = vL_ + s1_l1a_R; s1_l1a_R = lpa_1R + vL_;
            vL2_ = (lpa_1R - s1_l1b_R) * g1_f1; lpb_1R = vL2_ + s1_l1b_R; s1_l1b_R = lpb_1R + vL2_;
            low1R = lpb_1R;
        }
        if (needHP1 > 0.5) {
            vh_ = (xL - s1_h1a_L) * g1_f1; lpHa_1L = vh_ + s1_h1a_L; s1_h1a_L = lpHa_1L + vh_; hpa_1L = xL - lpHa_1L;
            vh2_ = (hpa_1L - s1_h1b_L) * g1_f1; lpHb_1L = vh2_ + s1_h1b_L; s1_h1b_L = lpHb_1L + vh2_; hpb_1L = hpa_1L - lpHb_1L;
            high1L = -hpb_1L;
            vh_ = (xR - s1_h1a_R) * g1_f1; lpHa_1R = vh_ + s1_h1a_R; s1_h1a_R = lpHa_1R + vh_; hpa_1R = xR - lpHa_1R;
            vh2_ = (hpa_1R - s1_h1b_R) * g1_f1; lpHb_1R = vh2_ + s1_h1b_R; s1_h1b_R = lpHb_1R + vh2_; hpb_1R = hpa_1R - lpHb_1R;
            high1R = -hpb_1R;
        }
    } else {
        if (needLP1 > 0.5) {
            if (slopeMode > 1.5) {
                v3 = xL - s1_lp1_ic2L; v1 = a1A_1 * s1_lp1_ic1L + a2A_1 * v3; v2 = s1_lp1_ic2L + a2A_1 * s1_lp1_ic1L + a3A_1 * v3;
                s1_lp1_ic1L = 2.0 * v1 - s1_lp1_ic1L; s1_lp1_ic2L = 2.0 * v2 - s1_lp1_ic2L;
                lpa_1L = v2;
                v3 = lpa_1L - s1_lp2_ic2L; v1 = a1B_1 * s1_lp2_ic1L + a2B_1 * v3; v2 = s1_lp2_ic2L + a2B_1 * s1_lp2_ic1L + a3B_1 * v3;
                s1_lp2_ic1L = 2.0 * v1 - s1_lp2_ic1L; s1_lp2_ic2L = 2.0 * v2 - s1_lp2_ic2L;
                lpb_1L = v2;
                v3 = lpb_1L - s1_lp3_ic2L; v1 = a1A_1 * s1_lp3_ic1L + a2A_1 * v3; v2 = s1_lp3_ic2L + a2A_1 * s1_lp3_ic1L + a3A_1 * v3;
                s1_lp3_ic1L = 2.0 * v1 - s1_lp3_ic1L; s1_lp3_ic2L = 2.0 * v2 - s1_lp3_ic2L;
                lpc_1L = v2;
                v3 = lpc_1L - s1_lp4_ic2L; v1 = a1B_1 * s1_lp4_ic1L + a2B_1 * v3; v2 = s1_lp4_ic2L + a2B_1 * s1_lp4_ic1L + a3B_1 * v3;
                s1_lp4_ic1L = 2.0 * v1 - s1_lp4_ic1L; s1_lp4_ic2L = 2.0 * v2 - s1_lp4_ic2L;
                low1L = v2;
                v3 = xR - s1_lp1_ic2R; v1 = a1A_1 * s1_lp1_ic1R + a2A_1 * v3; v2 = s1_lp1_ic2R + a2A_1 * s1_lp1_ic1R + a3A_1 * v3;
                s1_lp1_ic1R = 2.0 * v1 - s1_lp1_ic1R; s1_lp1_ic2R = 2.0 * v2 - s1_lp1_ic2R;
                lpa_1R = v2;
                v3 = lpa_1R - s1_lp2_ic2R; v1 = a1B_1 * s1_lp2_ic1R + a2B_1 * v3; v2 = s1_lp2_ic2R + a2B_1 * s1_lp2_ic1R + a3B_1 * v3;
                s1_lp2_ic1R = 2.0 * v1 - s1_lp2_ic1R; s1_lp2_ic2R = 2.0 * v2 - s1_lp2_ic2R;
                lpb_1R = v2;
                v3 = lpb_1R - s1_lp3_ic2R; v1 = a1A_1 * s1_lp3_ic1R + a2A_1 * v3; v2 = s1_lp3_ic2R + a2A_1 * s1_lp3_ic1R + a3A_1 * v3;
                s1_lp3_ic1R = 2.0 * v1 - s1_lp3_ic1R; s1_lp3_ic2R = 2.0 * v2 - s1_lp3_ic2R;
                lpc_1R = v2;
                v3 = lpc_1R - s1_lp4_ic2R; v1 = a1B_1 * s1_lp4_ic1R + a2B_1 * v3; v2 = s1_lp4_ic2R + a2B_1 * s1_lp4_ic1R + a3B_1 * v3;
                s1_lp4_ic1R = 2.0 * v1 - s1_lp4_ic1R; s1_lp4_ic2R = 2.0 * v2 - s1_lp4_ic2R;
                low1R = v2;
            } else {
                v3 = xL - s1_lp1_ic2L; v1 = a1A_1 * s1_lp1_ic1L + a2A_1 * v3; v2 = s1_lp1_ic2L + a2A_1 * s1_lp1_ic1L + a3A_1 * v3;
                s1_lp1_ic1L = 2.0 * v1 - s1_lp1_ic1L; s1_lp1_ic2L = 2.0 * v2 - s1_lp1_ic2L;
                lpa_1L = v2;
                v3 = lpa_1L - s1_lp2_ic2L; v1 = a1B_1 * s1_lp2_ic1L + a2B_1 * v3; v2 = s1_lp2_ic2L + a2B_1 * s1_lp2_ic1L + a3B_1 * v3;
                s1_lp2_ic1L = 2.0 * v1 - s1_lp2_ic1L; s1_lp2_ic2L = 2.0 * v2 - s1_lp2_ic2L;
                low1L = v2;
                v3 = xR - s1_lp1_ic2R; v1 = a1A_1 * s1_lp1_ic1R + a2A_1 * v3; v2 = s1_lp1_ic2R + a2A_1 * s1_lp1_ic1R + a3A_1 * v3;
                s1_lp1_ic1R = 2.0 * v1 - s1_lp1_ic1R; s1_lp1_ic2R = 2.0 * v2 - s1_lp1_ic2R;
                lpa_1R = v2;
                v3 = lpa_1R - s1_lp2_ic2R; v1 = a1B_1 * s1_lp2_ic1R + a2B_1 * v3; v2 = s1_lp2_ic2R + a2B_1 * s1_lp2_ic1R + a3B_1 * v3;
                s1_lp2_ic1R = 2.0 * v1 - s1_lp2_ic1R; s1_lp2_ic2R = 2.0 * v2 - s1_lp2_ic2R;
                low1R = v2;
            }
        }
        if (needHP1 > 0.5) {
            if (slopeMode > 1.5) {
                v3 = xL - s1_hp1_ic2L; v1 = a1A_1 * s1_hp1_ic1L + a2A_1 * v3; v2 = s1_hp1_ic2L + a2A_1 * s1_hp1_ic1L + a3A_1 * v3;
                s1_hp1_ic1L = 2.0 * v1 - s1_hp1_ic1L; s1_hp1_ic2L = 2.0 * v2 - s1_hp1_ic2L;
                hpa_1L = xL - kStageA * v1 - v2;
                v3 = hpa_1L - s1_hp2_ic2L; v1 = a1B_1 * s1_hp2_ic1L + a2B_1 * v3; v2 = s1_hp2_ic2L + a2B_1 * s1_hp2_ic1L + a3B_1 * v3;
                s1_hp2_ic1L = 2.0 * v1 - s1_hp2_ic1L; s1_hp2_ic2L = 2.0 * v2 - s1_hp2_ic2L;
                hpb_1L = hpa_1L - kStageB * v1 - v2;
                v3 = hpb_1L - s1_hp3_ic2L; v1 = a1A_1 * s1_hp3_ic1L + a2A_1 * v3; v2 = s1_hp3_ic2L + a2A_1 * s1_hp3_ic1L + a3A_1 * v3;
                s1_hp3_ic1L = 2.0 * v1 - s1_hp3_ic1L; s1_hp3_ic2L = 2.0 * v2 - s1_hp3_ic2L;
                hpc_1L = hpb_1L - kStageA * v1 - v2;
                v3 = hpc_1L - s1_hp4_ic2L; v1 = a1B_1 * s1_hp4_ic1L + a2B_1 * v3; v2 = s1_hp4_ic2L + a2B_1 * s1_hp4_ic1L + a3B_1 * v3;
                s1_hp4_ic1L = 2.0 * v1 - s1_hp4_ic1L; s1_hp4_ic2L = 2.0 * v2 - s1_hp4_ic2L;
                high1L = hpc_1L - kStageB * v1 - v2;
                v3 = xR - s1_hp1_ic2R; v1 = a1A_1 * s1_hp1_ic1R + a2A_1 * v3; v2 = s1_hp1_ic2R + a2A_1 * s1_hp1_ic1R + a3A_1 * v3;
                s1_hp1_ic1R = 2.0 * v1 - s1_hp1_ic1R; s1_hp1_ic2R = 2.0 * v2 - s1_hp1_ic2R;
                hpa_1R = xR - kStageA * v1 - v2;
                v3 = hpa_1R - s1_hp2_ic2R; v1 = a1B_1 * s1_hp2_ic1R + a2B_1 * v3; v2 = s1_hp2_ic2R + a2B_1 * s1_hp2_ic1R + a3B_1 * v3;
                s1_hp2_ic1R = 2.0 * v1 - s1_hp2_ic1R; s1_hp2_ic2R = 2.0 * v2 - s1_hp2_ic2R;
                hpb_1R = hpa_1R - kStageB * v1 - v2;
                v3 = hpb_1R - s1_hp3_ic2R; v1 = a1A_1 * s1_hp3_ic1R + a2A_1 * v3; v2 = s1_hp3_ic2R + a2A_1 * s1_hp3_ic1R + a3A_1 * v3;
                s1_hp3_ic1R = 2.0 * v1 - s1_hp3_ic1R; s1_hp3_ic2R = 2.0 * v2 - s1_hp3_ic2R;
                hpc_1R = hpb_1R - kStageA * v1 - v2;
                v3 = hpc_1R - s1_hp4_ic2R; v1 = a1B_1 * s1_hp4_ic1R + a2B_1 * v3; v2 = s1_hp4_ic2R + a2B_1 * s1_hp4_ic1R + a3B_1 * v3;
                s1_hp4_ic1R = 2.0 * v1 - s1_hp4_ic1R; s1_hp4_ic2R = 2.0 * v2 - s1_hp4_ic2R;
                high1R = hpc_1R - kStageB * v1 - v2;
            } else {
                v3 = xL - s1_hp1_ic2L; v1 = a1A_1 * s1_hp1_ic1L + a2A_1 * v3; v2 = s1_hp1_ic2L + a2A_1 * s1_hp1_ic1L + a3A_1 * v3;
                s1_hp1_ic1L = 2.0 * v1 - s1_hp1_ic1L; s1_hp1_ic2L = 2.0 * v2 - s1_hp1_ic2L;
                hpa_1L = xL - kStageA * v1 - v2;
                v3 = hpa_1L - s1_hp2_ic2L; v1 = a1B_1 * s1_hp2_ic1L + a2B_1 * v3; v2 = s1_hp2_ic2L + a2B_1 * s1_hp2_ic1L + a3B_1 * v3;
                s1_hp2_ic1L = 2.0 * v1 - s1_hp2_ic1L; s1_hp2_ic2L = 2.0 * v2 - s1_hp2_ic2L;
                hpb_1L = hpa_1L - kStageB * v1 - v2;
                high1L = hpb_1L;
                v3 = xR - s1_hp1_ic2R; v1 = a1A_1 * s1_hp1_ic1R + a2A_1 * v3; v2 = s1_hp1_ic2R + a2A_1 * s1_hp1_ic1R + a3A_1 * v3;
                s1_hp1_ic1R = 2.0 * v1 - s1_hp1_ic1R; s1_hp1_ic2R = 2.0 * v2 - s1_hp1_ic2R;
                hpa_1R = xR - kStageA * v1 - v2;
                v3 = hpa_1R - s1_hp2_ic2R; v1 = a1B_1 * s1_hp2_ic1R + a2B_1 * v3; v2 = s1_hp2_ic2R + a2B_1 * s1_hp2_ic1R + a3B_1 * v3;
                s1_hp2_ic1R = 2.0 * v1 - s1_hp2_ic1R; s1_hp2_ic2R = 2.0 * v2 - s1_hp2_ic2R;
                hpb_1R = hpa_1R - kStageB * v1 - v2;
                high1R = hpb_1R;
            }
        }
    }

    // =========================================================================
    // STAGE 2: crossover at smF2 (on the previous high band) + allpass(es) on the lower bands
    // =========================================================================
    if (slopeMode < 0.5) {
        // 12 dB/oct (LR2)
        if (needLP2 > 0.5) {
            vL_ = (high1L - s2_l1a_L) * g1_f2; lpa_2L = vL_ + s2_l1a_L; s2_l1a_L = lpa_2L + vL_;
            vL2_ = (lpa_2L - s2_l1b_L) * g1_f2; lpb_2L = vL2_ + s2_l1b_L; s2_l1b_L = lpb_2L + vL2_;
            low2L = lpb_2L;
            vL_ = (high1R - s2_l1a_R) * g1_f2; lpa_2R = vL_ + s2_l1a_R; s2_l1a_R = lpa_2R + vL_;
            vL2_ = (lpa_2R - s2_l1b_R) * g1_f2; lpb_2R = vL2_ + s2_l1b_R; s2_l1b_R = lpb_2R + vL2_;
            low2R = lpb_2R;
        }
        if (needHP2 > 0.5) {
            vh_ = (high1L - s2_h1a_L) * g1_f2; lpHa_2L = vh_ + s2_h1a_L; s2_h1a_L = lpHa_2L + vh_; hpa_2L = high1L - lpHa_2L;
            vh2_ = (hpa_2L - s2_h1b_L) * g1_f2; lpHb_2L = vh2_ + s2_h1b_L; s2_h1b_L = lpHb_2L + vh2_; hpb_2L = hpa_2L - lpHb_2L;
            high2L = -hpb_2L;
            vh_ = (high1R - s2_h1a_R) * g1_f2; lpHa_2R = vh_ + s2_h1a_R; s2_h1a_R = lpHa_2R + vh_; hpa_2R = high1R - lpHa_2R;
            vh2_ = (hpa_2R - s2_h1b_R) * g1_f2; lpHb_2R = vh2_ + s2_h1b_R; s2_h1b_R = lpHb_2R + vh2_; hpb_2R = hpa_2R - lpHb_2R;
            high2R = -hpb_2R;
        }
        if (needAP2a > 0.5) {
            va_ = (low1L - ap2_b1_z1L) * g1_f2; lpap_ap2_b1L = va_ + ap2_b1_z1L; ap2_b1_z1L = lpap_ap2_b1L + va_;
            b1_after2L = 2.0 * lpap_ap2_b1L - low1L;
            va_ = (low1R - ap2_b1_z1R) * g1_f2; lpap_ap2_b1R = va_ + ap2_b1_z1R; ap2_b1_z1R = lpap_ap2_b1R + va_;
            b1_after2R = 2.0 * lpap_ap2_b1R - low1R;
        }
    } else {
        if (needLP2 > 0.5) {
            if (slopeMode > 1.5) {
                v3 = high1L - s2_lp1_ic2L; v1 = a1A_2 * s2_lp1_ic1L + a2A_2 * v3; v2 = s2_lp1_ic2L + a2A_2 * s2_lp1_ic1L + a3A_2 * v3;
                s2_lp1_ic1L = 2.0 * v1 - s2_lp1_ic1L; s2_lp1_ic2L = 2.0 * v2 - s2_lp1_ic2L;
                lpa_2L = v2;
                v3 = lpa_2L - s2_lp2_ic2L; v1 = a1B_2 * s2_lp2_ic1L + a2B_2 * v3; v2 = s2_lp2_ic2L + a2B_2 * s2_lp2_ic1L + a3B_2 * v3;
                s2_lp2_ic1L = 2.0 * v1 - s2_lp2_ic1L; s2_lp2_ic2L = 2.0 * v2 - s2_lp2_ic2L;
                lpb_2L = v2;
                v3 = lpb_2L - s2_lp3_ic2L; v1 = a1A_2 * s2_lp3_ic1L + a2A_2 * v3; v2 = s2_lp3_ic2L + a2A_2 * s2_lp3_ic1L + a3A_2 * v3;
                s2_lp3_ic1L = 2.0 * v1 - s2_lp3_ic1L; s2_lp3_ic2L = 2.0 * v2 - s2_lp3_ic2L;
                lpc_2L = v2;
                v3 = lpc_2L - s2_lp4_ic2L; v1 = a1B_2 * s2_lp4_ic1L + a2B_2 * v3; v2 = s2_lp4_ic2L + a2B_2 * s2_lp4_ic1L + a3B_2 * v3;
                s2_lp4_ic1L = 2.0 * v1 - s2_lp4_ic1L; s2_lp4_ic2L = 2.0 * v2 - s2_lp4_ic2L;
                low2L = v2;
                v3 = high1R - s2_lp1_ic2R; v1 = a1A_2 * s2_lp1_ic1R + a2A_2 * v3; v2 = s2_lp1_ic2R + a2A_2 * s2_lp1_ic1R + a3A_2 * v3;
                s2_lp1_ic1R = 2.0 * v1 - s2_lp1_ic1R; s2_lp1_ic2R = 2.0 * v2 - s2_lp1_ic2R;
                lpa_2R = v2;
                v3 = lpa_2R - s2_lp2_ic2R; v1 = a1B_2 * s2_lp2_ic1R + a2B_2 * v3; v2 = s2_lp2_ic2R + a2B_2 * s2_lp2_ic1R + a3B_2 * v3;
                s2_lp2_ic1R = 2.0 * v1 - s2_lp2_ic1R; s2_lp2_ic2R = 2.0 * v2 - s2_lp2_ic2R;
                lpb_2R = v2;
                v3 = lpb_2R - s2_lp3_ic2R; v1 = a1A_2 * s2_lp3_ic1R + a2A_2 * v3; v2 = s2_lp3_ic2R + a2A_2 * s2_lp3_ic1R + a3A_2 * v3;
                s2_lp3_ic1R = 2.0 * v1 - s2_lp3_ic1R; s2_lp3_ic2R = 2.0 * v2 - s2_lp3_ic2R;
                lpc_2R = v2;
                v3 = lpc_2R - s2_lp4_ic2R; v1 = a1B_2 * s2_lp4_ic1R + a2B_2 * v3; v2 = s2_lp4_ic2R + a2B_2 * s2_lp4_ic1R + a3B_2 * v3;
                s2_lp4_ic1R = 2.0 * v1 - s2_lp4_ic1R; s2_lp4_ic2R = 2.0 * v2 - s2_lp4_ic2R;
                low2R = v2;
            } else {
                v3 = high1L - s2_lp1_ic2L; v1 = a1A_2 * s2_lp1_ic1L + a2A_2 * v3; v2 = s2_lp1_ic2L + a2A_2 * s2_lp1_ic1L + a3A_2 * v3;
                s2_lp1_ic1L = 2.0 * v1 - s2_lp1_ic1L; s2_lp1_ic2L = 2.0 * v2 - s2_lp1_ic2L;
                lpa_2L = v2;
                v3 = lpa_2L - s2_lp2_ic2L; v1 = a1B_2 * s2_lp2_ic1L + a2B_2 * v3; v2 = s2_lp2_ic2L + a2B_2 * s2_lp2_ic1L + a3B_2 * v3;
                s2_lp2_ic1L = 2.0 * v1 - s2_lp2_ic1L; s2_lp2_ic2L = 2.0 * v2 - s2_lp2_ic2L;
                low2L = v2;
                v3 = high1R - s2_lp1_ic2R; v1 = a1A_2 * s2_lp1_ic1R + a2A_2 * v3; v2 = s2_lp1_ic2R + a2A_2 * s2_lp1_ic1R + a3A_2 * v3;
                s2_lp1_ic1R = 2.0 * v1 - s2_lp1_ic1R; s2_lp1_ic2R = 2.0 * v2 - s2_lp1_ic2R;
                lpa_2R = v2;
                v3 = lpa_2R - s2_lp2_ic2R; v1 = a1B_2 * s2_lp2_ic1R + a2B_2 * v3; v2 = s2_lp2_ic2R + a2B_2 * s2_lp2_ic1R + a3B_2 * v3;
                s2_lp2_ic1R = 2.0 * v1 - s2_lp2_ic1R; s2_lp2_ic2R = 2.0 * v2 - s2_lp2_ic2R;
                low2R = v2;
            }
        }
        if (needHP2 > 0.5) {
            if (slopeMode > 1.5) {
                v3 = high1L - s2_hp1_ic2L; v1 = a1A_2 * s2_hp1_ic1L + a2A_2 * v3; v2 = s2_hp1_ic2L + a2A_2 * s2_hp1_ic1L + a3A_2 * v3;
                s2_hp1_ic1L = 2.0 * v1 - s2_hp1_ic1L; s2_hp1_ic2L = 2.0 * v2 - s2_hp1_ic2L;
                hpa_2L = high1L - kStageA * v1 - v2;
                v3 = hpa_2L - s2_hp2_ic2L; v1 = a1B_2 * s2_hp2_ic1L + a2B_2 * v3; v2 = s2_hp2_ic2L + a2B_2 * s2_hp2_ic1L + a3B_2 * v3;
                s2_hp2_ic1L = 2.0 * v1 - s2_hp2_ic1L; s2_hp2_ic2L = 2.0 * v2 - s2_hp2_ic2L;
                hpb_2L = hpa_2L - kStageB * v1 - v2;
                v3 = hpb_2L - s2_hp3_ic2L; v1 = a1A_2 * s2_hp3_ic1L + a2A_2 * v3; v2 = s2_hp3_ic2L + a2A_2 * s2_hp3_ic1L + a3A_2 * v3;
                s2_hp3_ic1L = 2.0 * v1 - s2_hp3_ic1L; s2_hp3_ic2L = 2.0 * v2 - s2_hp3_ic2L;
                hpc_2L = hpb_2L - kStageA * v1 - v2;
                v3 = hpc_2L - s2_hp4_ic2L; v1 = a1B_2 * s2_hp4_ic1L + a2B_2 * v3; v2 = s2_hp4_ic2L + a2B_2 * s2_hp4_ic1L + a3B_2 * v3;
                s2_hp4_ic1L = 2.0 * v1 - s2_hp4_ic1L; s2_hp4_ic2L = 2.0 * v2 - s2_hp4_ic2L;
                high2L = hpc_2L - kStageB * v1 - v2;
                v3 = high1R - s2_hp1_ic2R; v1 = a1A_2 * s2_hp1_ic1R + a2A_2 * v3; v2 = s2_hp1_ic2R + a2A_2 * s2_hp1_ic1R + a3A_2 * v3;
                s2_hp1_ic1R = 2.0 * v1 - s2_hp1_ic1R; s2_hp1_ic2R = 2.0 * v2 - s2_hp1_ic2R;
                hpa_2R = high1R - kStageA * v1 - v2;
                v3 = hpa_2R - s2_hp2_ic2R; v1 = a1B_2 * s2_hp2_ic1R + a2B_2 * v3; v2 = s2_hp2_ic2R + a2B_2 * s2_hp2_ic1R + a3B_2 * v3;
                s2_hp2_ic1R = 2.0 * v1 - s2_hp2_ic1R; s2_hp2_ic2R = 2.0 * v2 - s2_hp2_ic2R;
                hpb_2R = hpa_2R - kStageB * v1 - v2;
                v3 = hpb_2R - s2_hp3_ic2R; v1 = a1A_2 * s2_hp3_ic1R + a2A_2 * v3; v2 = s2_hp3_ic2R + a2A_2 * s2_hp3_ic1R + a3A_2 * v3;
                s2_hp3_ic1R = 2.0 * v1 - s2_hp3_ic1R; s2_hp3_ic2R = 2.0 * v2 - s2_hp3_ic2R;
                hpc_2R = hpb_2R - kStageA * v1 - v2;
                v3 = hpc_2R - s2_hp4_ic2R; v1 = a1B_2 * s2_hp4_ic1R + a2B_2 * v3; v2 = s2_hp4_ic2R + a2B_2 * s2_hp4_ic1R + a3B_2 * v3;
                s2_hp4_ic1R = 2.0 * v1 - s2_hp4_ic1R; s2_hp4_ic2R = 2.0 * v2 - s2_hp4_ic2R;
                high2R = hpc_2R - kStageB * v1 - v2;
            } else {
                v3 = high1L - s2_hp1_ic2L; v1 = a1A_2 * s2_hp1_ic1L + a2A_2 * v3; v2 = s2_hp1_ic2L + a2A_2 * s2_hp1_ic1L + a3A_2 * v3;
                s2_hp1_ic1L = 2.0 * v1 - s2_hp1_ic1L; s2_hp1_ic2L = 2.0 * v2 - s2_hp1_ic2L;
                hpa_2L = high1L - kStageA * v1 - v2;
                v3 = hpa_2L - s2_hp2_ic2L; v1 = a1B_2 * s2_hp2_ic1L + a2B_2 * v3; v2 = s2_hp2_ic2L + a2B_2 * s2_hp2_ic1L + a3B_2 * v3;
                s2_hp2_ic1L = 2.0 * v1 - s2_hp2_ic1L; s2_hp2_ic2L = 2.0 * v2 - s2_hp2_ic2L;
                hpb_2L = hpa_2L - kStageB * v1 - v2;
                high2L = hpb_2L;
                v3 = high1R - s2_hp1_ic2R; v1 = a1A_2 * s2_hp1_ic1R + a2A_2 * v3; v2 = s2_hp1_ic2R + a2A_2 * s2_hp1_ic1R + a3A_2 * v3;
                s2_hp1_ic1R = 2.0 * v1 - s2_hp1_ic1R; s2_hp1_ic2R = 2.0 * v2 - s2_hp1_ic2R;
                hpa_2R = high1R - kStageA * v1 - v2;
                v3 = hpa_2R - s2_hp2_ic2R; v1 = a1B_2 * s2_hp2_ic1R + a2B_2 * v3; v2 = s2_hp2_ic2R + a2B_2 * s2_hp2_ic1R + a3B_2 * v3;
                s2_hp2_ic1R = 2.0 * v1 - s2_hp2_ic1R; s2_hp2_ic2R = 2.0 * v2 - s2_hp2_ic2R;
                hpb_2R = hpa_2R - kStageB * v1 - v2;
                high2R = hpb_2R;
            }
        }
        if (needAP2a > 0.5) {
            if (slopeMode > 1.5) {
                v3 = low1L - ap2_b1_1_ic2L; v1 = a1A_2 * ap2_b1_1_ic1L + a2A_2 * v3; v2 = ap2_b1_1_ic2L + a2A_2 * ap2_b1_1_ic1L + a3A_2 * v3;
                ap2_b1_1_ic1L = 2.0 * v1 - ap2_b1_1_ic1L; ap2_b1_1_ic2L = 2.0 * v2 - ap2_b1_1_ic2L;
                aps_ap2_b1L = low1L - 2.0 * kStageA * v1;
                v3 = aps_ap2_b1L - ap2_b1_2_ic2L; v1 = a1B_2 * ap2_b1_2_ic1L + a2B_2 * v3; v2 = ap2_b1_2_ic2L + a2B_2 * ap2_b1_2_ic1L + a3B_2 * v3;
                ap2_b1_2_ic1L = 2.0 * v1 - ap2_b1_2_ic1L; ap2_b1_2_ic2L = 2.0 * v2 - ap2_b1_2_ic2L;
                b1_after2L = aps_ap2_b1L - 2.0 * kStageB * v1;
                v3 = low1R - ap2_b1_1_ic2R; v1 = a1A_2 * ap2_b1_1_ic1R + a2A_2 * v3; v2 = ap2_b1_1_ic2R + a2A_2 * ap2_b1_1_ic1R + a3A_2 * v3;
                ap2_b1_1_ic1R = 2.0 * v1 - ap2_b1_1_ic1R; ap2_b1_1_ic2R = 2.0 * v2 - ap2_b1_1_ic2R;
                aps_ap2_b1R = low1R - 2.0 * kStageA * v1;
                v3 = aps_ap2_b1R - ap2_b1_2_ic2R; v1 = a1B_2 * ap2_b1_2_ic1R + a2B_2 * v3; v2 = ap2_b1_2_ic2R + a2B_2 * ap2_b1_2_ic1R + a3B_2 * v3;
                ap2_b1_2_ic1R = 2.0 * v1 - ap2_b1_2_ic1R; ap2_b1_2_ic2R = 2.0 * v2 - ap2_b1_2_ic2R;
                b1_after2R = aps_ap2_b1R - 2.0 * kStageB * v1;
            } else {
                v3 = low1L - ap2_b1_1_ic2L; v1 = a1A_2 * ap2_b1_1_ic1L + a2A_2 * v3; v2 = ap2_b1_1_ic2L + a2A_2 * ap2_b1_1_ic1L + a3A_2 * v3;
                ap2_b1_1_ic1L = 2.0 * v1 - ap2_b1_1_ic1L; ap2_b1_1_ic2L = 2.0 * v2 - ap2_b1_1_ic2L;
                b1_after2L = low1L - 2.0 * kStageA * v1;
                v3 = low1R - ap2_b1_1_ic2R; v1 = a1A_2 * ap2_b1_1_ic1R + a2A_2 * v3; v2 = ap2_b1_1_ic2R + a2A_2 * ap2_b1_1_ic1R + a3A_2 * v3;
                ap2_b1_1_ic1R = 2.0 * v1 - ap2_b1_1_ic1R; ap2_b1_1_ic2R = 2.0 * v2 - ap2_b1_1_ic2R;
                b1_after2R = low1R - 2.0 * kStageA * v1;
            }
        }
    }

    // =========================================================================
    // STAGE 3: crossover at smF3 (on the previous high band) + allpass(es) on the lower bands
    // =========================================================================
    if (slopeMode < 0.5) {
        // 12 dB/oct (LR2)
        if (needLP3 > 0.5) {
            vL_ = (high2L - s3_l1a_L) * g1_f3; lpa_3L = vL_ + s3_l1a_L; s3_l1a_L = lpa_3L + vL_;
            vL2_ = (lpa_3L - s3_l1b_L) * g1_f3; lpb_3L = vL2_ + s3_l1b_L; s3_l1b_L = lpb_3L + vL2_;
            low3L = lpb_3L;
            vL_ = (high2R - s3_l1a_R) * g1_f3; lpa_3R = vL_ + s3_l1a_R; s3_l1a_R = lpa_3R + vL_;
            vL2_ = (lpa_3R - s3_l1b_R) * g1_f3; lpb_3R = vL2_ + s3_l1b_R; s3_l1b_R = lpb_3R + vL2_;
            low3R = lpb_3R;
        }
        if (needHP3 > 0.5) {
            vh_ = (high2L - s3_h1a_L) * g1_f3; lpHa_3L = vh_ + s3_h1a_L; s3_h1a_L = lpHa_3L + vh_; hpa_3L = high2L - lpHa_3L;
            vh2_ = (hpa_3L - s3_h1b_L) * g1_f3; lpHb_3L = vh2_ + s3_h1b_L; s3_h1b_L = lpHb_3L + vh2_; hpb_3L = hpa_3L - lpHb_3L;
            high3L = -hpb_3L;
            vh_ = (high2R - s3_h1a_R) * g1_f3; lpHa_3R = vh_ + s3_h1a_R; s3_h1a_R = lpHa_3R + vh_; hpa_3R = high2R - lpHa_3R;
            vh2_ = (hpa_3R - s3_h1b_R) * g1_f3; lpHb_3R = vh2_ + s3_h1b_R; s3_h1b_R = lpHb_3R + vh2_; hpb_3R = hpa_3R - lpHb_3R;
            high3R = -hpb_3R;
        }
        if (needAP3a > 0.5) {
            va_ = (b1_after2L - ap3_b1_z1L) * g1_f3; lpap_ap3_b1L = va_ + ap3_b1_z1L; ap3_b1_z1L = lpap_ap3_b1L + va_;
            b1_after3L = 2.0 * lpap_ap3_b1L - b1_after2L;
            va_ = (b1_after2R - ap3_b1_z1R) * g1_f3; lpap_ap3_b1R = va_ + ap3_b1_z1R; ap3_b1_z1R = lpap_ap3_b1R + va_;
            b1_after3R = 2.0 * lpap_ap3_b1R - b1_after2R;
        }
        if (needAP3b > 0.5) {
            va_ = (low2L - ap3_b2_z1L) * g1_f3; lpap_ap3_b2L = va_ + ap3_b2_z1L; ap3_b2_z1L = lpap_ap3_b2L + va_;
            b2_after3L = 2.0 * lpap_ap3_b2L - low2L;
            va_ = (low2R - ap3_b2_z1R) * g1_f3; lpap_ap3_b2R = va_ + ap3_b2_z1R; ap3_b2_z1R = lpap_ap3_b2R + va_;
            b2_after3R = 2.0 * lpap_ap3_b2R - low2R;
        }
    } else {
        if (needLP3 > 0.5) {
            if (slopeMode > 1.5) {
                v3 = high2L - s3_lp1_ic2L; v1 = a1A_3 * s3_lp1_ic1L + a2A_3 * v3; v2 = s3_lp1_ic2L + a2A_3 * s3_lp1_ic1L + a3A_3 * v3;
                s3_lp1_ic1L = 2.0 * v1 - s3_lp1_ic1L; s3_lp1_ic2L = 2.0 * v2 - s3_lp1_ic2L;
                lpa_3L = v2;
                v3 = lpa_3L - s3_lp2_ic2L; v1 = a1B_3 * s3_lp2_ic1L + a2B_3 * v3; v2 = s3_lp2_ic2L + a2B_3 * s3_lp2_ic1L + a3B_3 * v3;
                s3_lp2_ic1L = 2.0 * v1 - s3_lp2_ic1L; s3_lp2_ic2L = 2.0 * v2 - s3_lp2_ic2L;
                lpb_3L = v2;
                v3 = lpb_3L - s3_lp3_ic2L; v1 = a1A_3 * s3_lp3_ic1L + a2A_3 * v3; v2 = s3_lp3_ic2L + a2A_3 * s3_lp3_ic1L + a3A_3 * v3;
                s3_lp3_ic1L = 2.0 * v1 - s3_lp3_ic1L; s3_lp3_ic2L = 2.0 * v2 - s3_lp3_ic2L;
                lpc_3L = v2;
                v3 = lpc_3L - s3_lp4_ic2L; v1 = a1B_3 * s3_lp4_ic1L + a2B_3 * v3; v2 = s3_lp4_ic2L + a2B_3 * s3_lp4_ic1L + a3B_3 * v3;
                s3_lp4_ic1L = 2.0 * v1 - s3_lp4_ic1L; s3_lp4_ic2L = 2.0 * v2 - s3_lp4_ic2L;
                low3L = v2;
                v3 = high2R - s3_lp1_ic2R; v1 = a1A_3 * s3_lp1_ic1R + a2A_3 * v3; v2 = s3_lp1_ic2R + a2A_3 * s3_lp1_ic1R + a3A_3 * v3;
                s3_lp1_ic1R = 2.0 * v1 - s3_lp1_ic1R; s3_lp1_ic2R = 2.0 * v2 - s3_lp1_ic2R;
                lpa_3R = v2;
                v3 = lpa_3R - s3_lp2_ic2R; v1 = a1B_3 * s3_lp2_ic1R + a2B_3 * v3; v2 = s3_lp2_ic2R + a2B_3 * s3_lp2_ic1R + a3B_3 * v3;
                s3_lp2_ic1R = 2.0 * v1 - s3_lp2_ic1R; s3_lp2_ic2R = 2.0 * v2 - s3_lp2_ic2R;
                lpb_3R = v2;
                v3 = lpb_3R - s3_lp3_ic2R; v1 = a1A_3 * s3_lp3_ic1R + a2A_3 * v3; v2 = s3_lp3_ic2R + a2A_3 * s3_lp3_ic1R + a3A_3 * v3;
                s3_lp3_ic1R = 2.0 * v1 - s3_lp3_ic1R; s3_lp3_ic2R = 2.0 * v2 - s3_lp3_ic2R;
                lpc_3R = v2;
                v3 = lpc_3R - s3_lp4_ic2R; v1 = a1B_3 * s3_lp4_ic1R + a2B_3 * v3; v2 = s3_lp4_ic2R + a2B_3 * s3_lp4_ic1R + a3B_3 * v3;
                s3_lp4_ic1R = 2.0 * v1 - s3_lp4_ic1R; s3_lp4_ic2R = 2.0 * v2 - s3_lp4_ic2R;
                low3R = v2;
            } else {
                v3 = high2L - s3_lp1_ic2L; v1 = a1A_3 * s3_lp1_ic1L + a2A_3 * v3; v2 = s3_lp1_ic2L + a2A_3 * s3_lp1_ic1L + a3A_3 * v3;
                s3_lp1_ic1L = 2.0 * v1 - s3_lp1_ic1L; s3_lp1_ic2L = 2.0 * v2 - s3_lp1_ic2L;
                lpa_3L = v2;
                v3 = lpa_3L - s3_lp2_ic2L; v1 = a1B_3 * s3_lp2_ic1L + a2B_3 * v3; v2 = s3_lp2_ic2L + a2B_3 * s3_lp2_ic1L + a3B_3 * v3;
                s3_lp2_ic1L = 2.0 * v1 - s3_lp2_ic1L; s3_lp2_ic2L = 2.0 * v2 - s3_lp2_ic2L;
                low3L = v2;
                v3 = high2R - s3_lp1_ic2R; v1 = a1A_3 * s3_lp1_ic1R + a2A_3 * v3; v2 = s3_lp1_ic2R + a2A_3 * s3_lp1_ic1R + a3A_3 * v3;
                s3_lp1_ic1R = 2.0 * v1 - s3_lp1_ic1R; s3_lp1_ic2R = 2.0 * v2 - s3_lp1_ic2R;
                lpa_3R = v2;
                v3 = lpa_3R - s3_lp2_ic2R; v1 = a1B_3 * s3_lp2_ic1R + a2B_3 * v3; v2 = s3_lp2_ic2R + a2B_3 * s3_lp2_ic1R + a3B_3 * v3;
                s3_lp2_ic1R = 2.0 * v1 - s3_lp2_ic1R; s3_lp2_ic2R = 2.0 * v2 - s3_lp2_ic2R;
                low3R = v2;
            }
        }
        if (needHP3 > 0.5) {
            if (slopeMode > 1.5) {
                v3 = high2L - s3_hp1_ic2L; v1 = a1A_3 * s3_hp1_ic1L + a2A_3 * v3; v2 = s3_hp1_ic2L + a2A_3 * s3_hp1_ic1L + a3A_3 * v3;
                s3_hp1_ic1L = 2.0 * v1 - s3_hp1_ic1L; s3_hp1_ic2L = 2.0 * v2 - s3_hp1_ic2L;
                hpa_3L = high2L - kStageA * v1 - v2;
                v3 = hpa_3L - s3_hp2_ic2L; v1 = a1B_3 * s3_hp2_ic1L + a2B_3 * v3; v2 = s3_hp2_ic2L + a2B_3 * s3_hp2_ic1L + a3B_3 * v3;
                s3_hp2_ic1L = 2.0 * v1 - s3_hp2_ic1L; s3_hp2_ic2L = 2.0 * v2 - s3_hp2_ic2L;
                hpb_3L = hpa_3L - kStageB * v1 - v2;
                v3 = hpb_3L - s3_hp3_ic2L; v1 = a1A_3 * s3_hp3_ic1L + a2A_3 * v3; v2 = s3_hp3_ic2L + a2A_3 * s3_hp3_ic1L + a3A_3 * v3;
                s3_hp3_ic1L = 2.0 * v1 - s3_hp3_ic1L; s3_hp3_ic2L = 2.0 * v2 - s3_hp3_ic2L;
                hpc_3L = hpb_3L - kStageA * v1 - v2;
                v3 = hpc_3L - s3_hp4_ic2L; v1 = a1B_3 * s3_hp4_ic1L + a2B_3 * v3; v2 = s3_hp4_ic2L + a2B_3 * s3_hp4_ic1L + a3B_3 * v3;
                s3_hp4_ic1L = 2.0 * v1 - s3_hp4_ic1L; s3_hp4_ic2L = 2.0 * v2 - s3_hp4_ic2L;
                high3L = hpc_3L - kStageB * v1 - v2;
                v3 = high2R - s3_hp1_ic2R; v1 = a1A_3 * s3_hp1_ic1R + a2A_3 * v3; v2 = s3_hp1_ic2R + a2A_3 * s3_hp1_ic1R + a3A_3 * v3;
                s3_hp1_ic1R = 2.0 * v1 - s3_hp1_ic1R; s3_hp1_ic2R = 2.0 * v2 - s3_hp1_ic2R;
                hpa_3R = high2R - kStageA * v1 - v2;
                v3 = hpa_3R - s3_hp2_ic2R; v1 = a1B_3 * s3_hp2_ic1R + a2B_3 * v3; v2 = s3_hp2_ic2R + a2B_3 * s3_hp2_ic1R + a3B_3 * v3;
                s3_hp2_ic1R = 2.0 * v1 - s3_hp2_ic1R; s3_hp2_ic2R = 2.0 * v2 - s3_hp2_ic2R;
                hpb_3R = hpa_3R - kStageB * v1 - v2;
                v3 = hpb_3R - s3_hp3_ic2R; v1 = a1A_3 * s3_hp3_ic1R + a2A_3 * v3; v2 = s3_hp3_ic2R + a2A_3 * s3_hp3_ic1R + a3A_3 * v3;
                s3_hp3_ic1R = 2.0 * v1 - s3_hp3_ic1R; s3_hp3_ic2R = 2.0 * v2 - s3_hp3_ic2R;
                hpc_3R = hpb_3R - kStageA * v1 - v2;
                v3 = hpc_3R - s3_hp4_ic2R; v1 = a1B_3 * s3_hp4_ic1R + a2B_3 * v3; v2 = s3_hp4_ic2R + a2B_3 * s3_hp4_ic1R + a3B_3 * v3;
                s3_hp4_ic1R = 2.0 * v1 - s3_hp4_ic1R; s3_hp4_ic2R = 2.0 * v2 - s3_hp4_ic2R;
                high3R = hpc_3R - kStageB * v1 - v2;
            } else {
                v3 = high2L - s3_hp1_ic2L; v1 = a1A_3 * s3_hp1_ic1L + a2A_3 * v3; v2 = s3_hp1_ic2L + a2A_3 * s3_hp1_ic1L + a3A_3 * v3;
                s3_hp1_ic1L = 2.0 * v1 - s3_hp1_ic1L; s3_hp1_ic2L = 2.0 * v2 - s3_hp1_ic2L;
                hpa_3L = high2L - kStageA * v1 - v2;
                v3 = hpa_3L - s3_hp2_ic2L; v1 = a1B_3 * s3_hp2_ic1L + a2B_3 * v3; v2 = s3_hp2_ic2L + a2B_3 * s3_hp2_ic1L + a3B_3 * v3;
                s3_hp2_ic1L = 2.0 * v1 - s3_hp2_ic1L; s3_hp2_ic2L = 2.0 * v2 - s3_hp2_ic2L;
                hpb_3L = hpa_3L - kStageB * v1 - v2;
                high3L = hpb_3L;
                v3 = high2R - s3_hp1_ic2R; v1 = a1A_3 * s3_hp1_ic1R + a2A_3 * v3; v2 = s3_hp1_ic2R + a2A_3 * s3_hp1_ic1R + a3A_3 * v3;
                s3_hp1_ic1R = 2.0 * v1 - s3_hp1_ic1R; s3_hp1_ic2R = 2.0 * v2 - s3_hp1_ic2R;
                hpa_3R = high2R - kStageA * v1 - v2;
                v3 = hpa_3R - s3_hp2_ic2R; v1 = a1B_3 * s3_hp2_ic1R + a2B_3 * v3; v2 = s3_hp2_ic2R + a2B_3 * s3_hp2_ic1R + a3B_3 * v3;
                s3_hp2_ic1R = 2.0 * v1 - s3_hp2_ic1R; s3_hp2_ic2R = 2.0 * v2 - s3_hp2_ic2R;
                hpb_3R = hpa_3R - kStageB * v1 - v2;
                high3R = hpb_3R;
            }
        }
        if (needAP3a > 0.5) {
            if (slopeMode > 1.5) {
                v3 = b1_after2L - ap3_b1_1_ic2L; v1 = a1A_3 * ap3_b1_1_ic1L + a2A_3 * v3; v2 = ap3_b1_1_ic2L + a2A_3 * ap3_b1_1_ic1L + a3A_3 * v3;
                ap3_b1_1_ic1L = 2.0 * v1 - ap3_b1_1_ic1L; ap3_b1_1_ic2L = 2.0 * v2 - ap3_b1_1_ic2L;
                aps_ap3_b1L = b1_after2L - 2.0 * kStageA * v1;
                v3 = aps_ap3_b1L - ap3_b1_2_ic2L; v1 = a1B_3 * ap3_b1_2_ic1L + a2B_3 * v3; v2 = ap3_b1_2_ic2L + a2B_3 * ap3_b1_2_ic1L + a3B_3 * v3;
                ap3_b1_2_ic1L = 2.0 * v1 - ap3_b1_2_ic1L; ap3_b1_2_ic2L = 2.0 * v2 - ap3_b1_2_ic2L;
                b1_after3L = aps_ap3_b1L - 2.0 * kStageB * v1;
                v3 = b1_after2R - ap3_b1_1_ic2R; v1 = a1A_3 * ap3_b1_1_ic1R + a2A_3 * v3; v2 = ap3_b1_1_ic2R + a2A_3 * ap3_b1_1_ic1R + a3A_3 * v3;
                ap3_b1_1_ic1R = 2.0 * v1 - ap3_b1_1_ic1R; ap3_b1_1_ic2R = 2.0 * v2 - ap3_b1_1_ic2R;
                aps_ap3_b1R = b1_after2R - 2.0 * kStageA * v1;
                v3 = aps_ap3_b1R - ap3_b1_2_ic2R; v1 = a1B_3 * ap3_b1_2_ic1R + a2B_3 * v3; v2 = ap3_b1_2_ic2R + a2B_3 * ap3_b1_2_ic1R + a3B_3 * v3;
                ap3_b1_2_ic1R = 2.0 * v1 - ap3_b1_2_ic1R; ap3_b1_2_ic2R = 2.0 * v2 - ap3_b1_2_ic2R;
                b1_after3R = aps_ap3_b1R - 2.0 * kStageB * v1;
            } else {
                v3 = b1_after2L - ap3_b1_1_ic2L; v1 = a1A_3 * ap3_b1_1_ic1L + a2A_3 * v3; v2 = ap3_b1_1_ic2L + a2A_3 * ap3_b1_1_ic1L + a3A_3 * v3;
                ap3_b1_1_ic1L = 2.0 * v1 - ap3_b1_1_ic1L; ap3_b1_1_ic2L = 2.0 * v2 - ap3_b1_1_ic2L;
                b1_after3L = b1_after2L - 2.0 * kStageA * v1;
                v3 = b1_after2R - ap3_b1_1_ic2R; v1 = a1A_3 * ap3_b1_1_ic1R + a2A_3 * v3; v2 = ap3_b1_1_ic2R + a2A_3 * ap3_b1_1_ic1R + a3A_3 * v3;
                ap3_b1_1_ic1R = 2.0 * v1 - ap3_b1_1_ic1R; ap3_b1_1_ic2R = 2.0 * v2 - ap3_b1_1_ic2R;
                b1_after3R = b1_after2R - 2.0 * kStageA * v1;
            }
        }
        if (needAP3b > 0.5) {
            if (slopeMode > 1.5) {
                v3 = low2L - ap3_b2_1_ic2L; v1 = a1A_3 * ap3_b2_1_ic1L + a2A_3 * v3; v2 = ap3_b2_1_ic2L + a2A_3 * ap3_b2_1_ic1L + a3A_3 * v3;
                ap3_b2_1_ic1L = 2.0 * v1 - ap3_b2_1_ic1L; ap3_b2_1_ic2L = 2.0 * v2 - ap3_b2_1_ic2L;
                aps_ap3_b2L = low2L - 2.0 * kStageA * v1;
                v3 = aps_ap3_b2L - ap3_b2_2_ic2L; v1 = a1B_3 * ap3_b2_2_ic1L + a2B_3 * v3; v2 = ap3_b2_2_ic2L + a2B_3 * ap3_b2_2_ic1L + a3B_3 * v3;
                ap3_b2_2_ic1L = 2.0 * v1 - ap3_b2_2_ic1L; ap3_b2_2_ic2L = 2.0 * v2 - ap3_b2_2_ic2L;
                b2_after3L = aps_ap3_b2L - 2.0 * kStageB * v1;
                v3 = low2R - ap3_b2_1_ic2R; v1 = a1A_3 * ap3_b2_1_ic1R + a2A_3 * v3; v2 = ap3_b2_1_ic2R + a2A_3 * ap3_b2_1_ic1R + a3A_3 * v3;
                ap3_b2_1_ic1R = 2.0 * v1 - ap3_b2_1_ic1R; ap3_b2_1_ic2R = 2.0 * v2 - ap3_b2_1_ic2R;
                aps_ap3_b2R = low2R - 2.0 * kStageA * v1;
                v3 = aps_ap3_b2R - ap3_b2_2_ic2R; v1 = a1B_3 * ap3_b2_2_ic1R + a2B_3 * v3; v2 = ap3_b2_2_ic2R + a2B_3 * ap3_b2_2_ic1R + a3B_3 * v3;
                ap3_b2_2_ic1R = 2.0 * v1 - ap3_b2_2_ic1R; ap3_b2_2_ic2R = 2.0 * v2 - ap3_b2_2_ic2R;
                b2_after3R = aps_ap3_b2R - 2.0 * kStageB * v1;
            } else {
                v3 = low2L - ap3_b2_1_ic2L; v1 = a1A_3 * ap3_b2_1_ic1L + a2A_3 * v3; v2 = ap3_b2_1_ic2L + a2A_3 * ap3_b2_1_ic1L + a3A_3 * v3;
                ap3_b2_1_ic1L = 2.0 * v1 - ap3_b2_1_ic1L; ap3_b2_1_ic2L = 2.0 * v2 - ap3_b2_1_ic2L;
                b2_after3L = low2L - 2.0 * kStageA * v1;
                v3 = low2R - ap3_b2_1_ic2R; v1 = a1A_3 * ap3_b2_1_ic1R + a2A_3 * v3; v2 = ap3_b2_1_ic2R + a2A_3 * ap3_b2_1_ic1R + a3A_3 * v3;
                ap3_b2_1_ic1R = 2.0 * v1 - ap3_b2_1_ic1R; ap3_b2_1_ic2R = 2.0 * v2 - ap3_b2_1_ic2R;
                b2_after3R = low2R - 2.0 * kStageA * v1;
            }
        }
    }
}

// =========================================================================
// DYNAMIC PHASE: IIR F1 + COMPLEMENTARY LINEAR-PHASE FIR F2 / F3
// =========================================================================
needF2 = ((nb > 2.5) ? 1.0 : 0.0) * max(b2, b3);
needF3 = ((nb > 3.5) ? 1.0 : 0.0) * max(b3, b4);

if (sr != firSr) {
    firSr = sr;
    firD = clamp(128.0 * round(sr / 48000.0), 128.0, 512.0);
    // Kaiser window, beta 6: I0(6 sqrt(1 - (j/D)^2)) / I0(6), I0 by its power series.
    // (A GenExpr function containing a for loop does not compile in Max, so the series is inline.)
    i0beta = 1.0;
    i0term = 1.0;
    for (k = 1; k < 30; k += 1) {
        qk = 6.0 / (2.0 * k);
        i0term = i0term * qk * qk;
        i0beta = i0beta + i0term;
    }
    for (j = 0; j <= firD; j += 1) {
        rr = j / firD;
        xw = 6.0 * sqrt(max(1.0 - rr * rr, 0.0));
        wsum = 1.0;
        wterm = 1.0;
        for (k = 1; k < 30; k += 1) {
            qw = xw / (2.0 * k);
            wterm = wterm * qw * qw;
            wsum = wsum + wterm;
        }
        poke(firWin, wsum / i0beta, j);
    }
    kF2 = -1.0;
    kF3 = -1.0;
}
Dn = firD;

// Kernels follow the smoothed crossovers every 32 samples. Any kernel keeps the bands complementary,
// so a redesign mid-sweep never breaks the flat sum.
kCnt = kCnt + 1.0;
if (kCnt >= 32.0 || (needF2 > 0.5 && kF2 < 0.0) || (needF3 > 0.5 && kF3 < 0.0)) {
    kCnt = 0.0;
    if (needF2 > 0.5 && abs(smF2 - kF2) > 0.01) {
        kF2 = smF2;
        wc2 = 2.0 * pi * smF2 / sr;
        ksum2 = 0.0;
        for (j = 0; j <= Dn; j += 1) {
            hv2 = (j < 0.5) ? (wc2 / pi) : (sin(wc2 * j) / (pi * max(j, 1.0)));
            hv2 = hv2 * peek(firWin, j);
            poke(firK2, hv2, j);
            ksum2 = ksum2 + ((j < 0.5) ? hv2 : 2.0 * hv2);
        }
        inv2 = 1.0 / max(ksum2, 1e-9);
        for (j = 0; j <= Dn; j += 1) {
            poke(firK2, peek(firK2, j) * inv2, j);
        }
    }
    if (needF3 > 0.5 && abs(smF3 - kF3) > 0.01) {
        kF3 = smF3;
        wc3 = 2.0 * pi * smF3 / sr;
        ksum3 = 0.0;
        for (j = 0; j <= Dn; j += 1) {
            hv3 = (j < 0.5) ? (wc3 / pi) : (sin(wc3 * j) / (pi * max(j, 1.0)));
            hv3 = hv3 * peek(firWin, j);
            poke(firK3, hv3, j);
            ksum3 = ksum3 + ((j < 0.5) ? hv3 : 2.0 * hv3);
        }
        inv3 = 1.0 / max(ksum3, 1e-9);
        for (j = 0; j <= Dn; j += 1) {
            poke(firK3, peek(firK3, j) * inv3, j);
        }
    }
}

// Rings always run so a mode switch starts with valid history
wp = firWp;
poke(firRing, xL, wp, 0);
poke(firRing, xR, wp, 1);
poke(firRing, low1L, wp, 2);
poke(firRing, low1R, wp, 3);
poke(firRing, high1L, wp, 4);
poke(firRing, high1R, wp, 5);
firWp = (wp + 1.0 >= 2048.0) ? 0.0 : wp + 1.0;

// 4 ms fade out -> switch -> 4 ms fade in, so the latency jump never clicks
dynTarget = (dynphase > 0.5) ? 1.0 : 0.0;
fadeStep = 1.0 / max(0.004 * sr, 1.0);
if (dynTarget != dynActive) {
    dynFade = max(dynFade - fadeStep, 0.0);
    if (dynFade <= 0.0) {
        dynActive = dynTarget;
    }
} else {
    dynFade = min(dynFade + fadeStep, 1.0);
}

if (asleep < 0.5) {
if (dynActive > 0.5) {
    iD = wp - Dn;
    iD = (iD < 0.0) ? iD + 2048.0 : iD;
    dxL = peek(firRing, iD, 0);
    dxR = peek(firRing, iD, 1);
    dlowL = peek(firRing, iD, 2);
    dlowR = peek(firRing, iD, 3);
    dhiL = peek(firRing, iD, 4);
    dhiR = peek(firRing, iD, 5);

    lp2L = 0.0; lp2R = 0.0; lp3L = 0.0; lp3R = 0.0;
    if (needF2 > 0.5 || needF3 > 0.5) {
        c20 = peek(firK2, 0);
        c30 = peek(firK3, 0);
        lp2L = c20 * dhiL;
        lp2R = c20 * dhiR;
        lp3L = c30 * dhiL;
        lp3R = c30 * dhiR;
        // Symmetric (type I) kernel: fold the taps D-j and D+j before multiplying
        for (j = 1; j <= Dn; j += 1) {
            ia = wp - Dn + j;
            ia = (ia < 0.0) ? ia + 2048.0 : ia;
            ib = wp - Dn - j;
            ib = (ib < 0.0) ? ib + 2048.0 : ib;
            sumTL = peek(firRing, ia, 4) + peek(firRing, ib, 4);
            sumTR = peek(firRing, ia, 5) + peek(firRing, ib, 5);
            if (needF2 > 0.5) {
                c2 = peek(firK2, j);
                lp2L = lp2L + c2 * sumTL;
                lp2R = lp2R + c2 * sumTR;
            }
            if (needF3 > 0.5) {
                c3 = peek(firK3, j);
                lp3L = lp3L + c3 * sumTL;
                lp3R = lp3R + c3 * sumTR;
            }
        }
    }

    band1L = (nb < 1.5) ? dxL : dlowL;
    band1R = (nb < 1.5) ? dxR : dlowR;
    band2L = (nb < 1.5) ? 0.0 : ((nb < 2.5) ? dhiL : lp2L);
    band2R = (nb < 1.5) ? 0.0 : ((nb < 2.5) ? dhiR : lp2R);
    band3L = (nb < 2.5) ? 0.0 : ((nb < 3.5) ? dhiL - lp2L : lp3L - lp2L);
    band3R = (nb < 2.5) ? 0.0 : ((nb < 3.5) ? dhiR - lp2R : lp3R - lp2R);
    band4L = (nb < 3.5) ? 0.0 : dhiL - lp3L;
    band4R = (nb < 3.5) ? 0.0 : dhiR - lp3R;
} else {
    // =========================================================================
    // SELECT 1-WAY (FULL), 2-WAY, 3-WAY, OR 4-WAY PHASE-ALIGNED BANDS
    // =========================================================================
    band1L = (nb < 1.5) ? xL : ((nb < 2.5) ? low1L : ((nb < 3.5) ? b1_after2L : b1_after3L));
    band1R = (nb < 1.5) ? xR : ((nb < 2.5) ? low1R : ((nb < 3.5) ? b1_after2R : b1_after3R));

    band2L = (nb < 1.5) ? 0.0 : ((nb < 2.5) ? high1L : ((nb < 3.5) ? low2L : b2_after3L));
    band2R = (nb < 1.5) ? 0.0 : ((nb < 2.5) ? high1R : ((nb < 3.5) ? low2R : b2_after3R));

    band3L = (nb < 2.5) ? 0.0 : ((nb < 3.5) ? high2L : low3L);
    band3R = (nb < 2.5) ? 0.0 : ((nb < 3.5) ? high2R : low3R);

    band4L = (nb < 3.5) ? 0.0 : high3L;
    band4R = (nb < 3.5) ? 0.0 : high3R;
}
}

sumL = en1 * band1L + en2 * band2L + en3 * band3L + en4 * band4L;
sumR = en1 * band1R + en2 * band2R + en3 * band3R + en4 * band4R;

outL = fixnan(sumL * smGain * phaseSign * dynFade);
outR = fixnan(sumR * smGain * phaseSign * dynFade);

out1 = outL;
out2 = outR;

// =========================================================================
// TELEMETRY (poked to Buffer scope every 64 samples) + 8192-sample input ring for the face's FFT
// =========================================================================
monoIn = 0.5 * (xL + xR);
envDecay = 0.9992;

pkB1 = max(0.5 * (abs(band1L) + abs(band1R)), pkB1 * envDecay);
pkB2 = max(0.5 * (abs(band2L) + abs(band2R)), pkB2 * envDecay);
pkB3 = max(0.5 * (abs(band3L) + abs(band3R)), pkB3 * envDecay);
pkB4 = max(0.5 * (abs(band4L) + abs(band4R)), pkB4 * envDecay);
pkIn = max(max(abs(xL), abs(xR)), pkIn * envDecay);
pkOut = max(max(abs(outL), abs(outR)), pkOut * envDecay);

// The ring is only written by the instance whose face runs the FFT (ringon = 1)
if (ringon > 0.5) {
    poke(scope, monoIn, 32.0 + ringPos, 0, 0);
    ringPos = mod(ringPos + 1.0, 8192.0);
}

scopeCnt = scopeCnt + 1.0;
if (scopeCnt >= 64.0) {
    scopeCnt = 0.0;
    scopeBeat = mod(scopeBeat + 1.0, 1024.0);
    // slots 0..15 (old 16-band analyzer) and 22 are no longer written: the face never read them
    poke(scope, pkB1, 16, 0, 0);
    poke(scope, pkB2, 17, 0, 0);
    poke(scope, pkB3, 18, 0, 0);
    poke(scope, pkB4, 19, 0, 0);
    poke(scope, pkIn, 20, 0, 0);
    poke(scope, pkOut, 21, 0, 0);
    poke(scope, scopeBeat, 23, 0, 0);
    poke(scope, ringPos, 24, 0, 0);
    poke(scope, sr, 25, 0, 0);
    poke(scope, firD, 26, 0, 0);
    poke(scope, dynActive, 27, 0, 0);
    // work-sharing state for the face / tests: bands computed (bit 0..3), prune (bit 4), asleep, ring on
    poke(scope, b1 + 2.0 * b2 + 4.0 * b3 + 8.0 * b4 + 16.0 * pr, 28, 0, 0);
    poke(scope, asleep, 29, 0, 0);
    poke(scope, ringon, 30, 0, 0);
}
