// Multiband Split — Phase-Coherent Linkwitz-Riley (12 / 24 / 48 dB/oct) 2/3/4-Band Crossover Engine
// All parallel bands sum to an exact allpass unity transfer function (0.000 dB flat response).

slew_step(cur, target, coef) {
    return cur + (target - cur) * coef;
}

calc_tan_g(fc, sr) {
    fClamped = clamp(fc, 20.0, sr * 0.48);
    return tan(3.141592653589793 * fClamped / sr);
}

db_to_lin(db) {
    return pow(10.0, db * 0.05);
}

Buffer scope("splitscope");

Param f1(120.0);
Param f2(800.0);
Param f3(4500.0);
Param numbands(3.0);
Param slope(1.0);
Param bandmask(1.0);
Param gain(0.0);
Param phase(0.0);

// Smoothed frequency & gain histories
History smF1(120.0);
History smF2(800.0);
History smF3(4500.0);
History smGain(1.0);
History lastSlope(-1.0);

// --- Stage 1 (Crossover F1) States (L & R) ---
// LR2 (1st-order cascades)
History s1_l1a_L(0.0), s1_l1b_L(0.0), s1_h1a_L(0.0), s1_h1b_L(0.0);
History s1_l1a_R(0.0), s1_l1b_R(0.0), s1_h1a_R(0.0), s1_h1b_R(0.0);
// LR4 / LR8 SVF states for Stage 1 LP (4 stages per channel) & HP (4 stages per channel)
History s1_lp1_ic1L(0.0), s1_lp1_ic2L(0.0), s1_lp2_ic1L(0.0), s1_lp2_ic2L(0.0);
History s1_lp3_ic1L(0.0), s1_lp3_ic2L(0.0), s1_lp4_ic1L(0.0), s1_lp4_ic2L(0.0);
History s1_hp1_ic1L(0.0), s1_hp1_ic2L(0.0), s1_hp2_ic1L(0.0), s1_hp2_ic2L(0.0);
History s1_hp3_ic1L(0.0), s1_hp3_ic2L(0.0), s1_hp4_ic1L(0.0), s1_hp4_ic2L(0.0);

History s1_lp1_ic1R(0.0), s1_lp1_ic2R(0.0), s1_lp2_ic1R(0.0), s1_lp2_ic2R(0.0);
History s1_lp3_ic1R(0.0), s1_lp3_ic2R(0.0), s1_lp4_ic1R(0.0), s1_lp4_ic2R(0.0);
History s1_hp1_ic1R(0.0), s1_hp1_ic2R(0.0), s1_hp2_ic1R(0.0), s1_hp2_ic2R(0.0);
History s1_hp3_ic1R(0.0), s1_hp3_ic2R(0.0), s1_hp4_ic1R(0.0), s1_hp4_ic2R(0.0);

// --- Stage 2 (Crossover F2) States (L & R) ---
History s2_l1a_L(0.0), s2_l1b_L(0.0), s2_h1a_L(0.0), s2_h1b_L(0.0);
History s2_l1a_R(0.0), s2_l1b_R(0.0), s2_h1a_R(0.0), s2_h1b_R(0.0);
History s2_lp1_ic1L(0.0), s2_lp1_ic2L(0.0), s2_lp2_ic1L(0.0), s2_lp2_ic2L(0.0);
History s2_lp3_ic1L(0.0), s2_lp3_ic2L(0.0), s2_lp4_ic1L(0.0), s2_lp4_ic2L(0.0);
History s2_hp1_ic1L(0.0), s2_hp1_ic2L(0.0), s2_hp2_ic1L(0.0), s2_hp2_ic2L(0.0);
History s2_hp3_ic1L(0.0), s2_hp3_ic2L(0.0), s2_hp4_ic1L(0.0), s2_hp4_ic2L(0.0);

History s2_lp1_ic1R(0.0), s2_lp1_ic2R(0.0), s2_lp2_ic1R(0.0), s2_lp2_ic2R(0.0);
History s2_lp3_ic1R(0.0), s2_lp3_ic2R(0.0), s2_lp4_ic1R(0.0), s2_lp4_ic2R(0.0);
History s2_hp1_ic1R(0.0), s2_hp1_ic2R(0.0), s2_hp2_ic1R(0.0), s2_hp2_ic2R(0.0);
History s2_hp3_ic1R(0.0), s2_hp3_ic2R(0.0), s2_hp4_ic1R(0.0), s2_hp4_ic2R(0.0);

// Allpass F2 on Band 1 (for 3-way and 4-way phase alignment)
History ap2_b1_z1L(0.0), ap2_b1_z1R(0.0);
History ap2_b1_1_ic1L(0.0), ap2_b1_1_ic2L(0.0), ap2_b1_2_ic1L(0.0), ap2_b1_2_ic2L(0.0);
History ap2_b1_1_ic1R(0.0), ap2_b1_1_ic2R(0.0), ap2_b1_2_ic1R(0.0), ap2_b1_2_ic2R(0.0);

// --- Stage 3 (Crossover F3) States (L & R) ---
History s3_l1a_L(0.0), s3_l1b_L(0.0), s3_h1a_L(0.0), s3_h1b_L(0.0);
History s3_l1a_R(0.0), s3_l1b_R(0.0), s3_h1a_R(0.0), s3_h1b_R(0.0);
History s3_lp1_ic1L(0.0), s3_lp1_ic2L(0.0), s3_lp2_ic1L(0.0), s3_lp2_ic2L(0.0);
History s3_lp3_ic1L(0.0), s3_lp3_ic2L(0.0), s3_lp4_ic1L(0.0), s3_lp4_ic2L(0.0);
History s3_hp1_ic1L(0.0), s3_hp1_ic2L(0.0), s3_hp2_ic1L(0.0), s3_hp2_ic2L(0.0);
History s3_hp3_ic1L(0.0), s3_hp3_ic2L(0.0), s3_hp4_ic1L(0.0), s3_hp4_ic2L(0.0);

History s3_lp1_ic1R(0.0), s3_lp1_ic2R(0.0), s3_lp2_ic1R(0.0), s3_lp2_ic2R(0.0);
History s3_lp3_ic1R(0.0), s3_lp3_ic2R(0.0), s3_lp4_ic1R(0.0), s3_lp4_ic2R(0.0);
History s3_hp1_ic1R(0.0), s3_hp1_ic2R(0.0), s3_hp2_ic1R(0.0), s3_hp2_ic2R(0.0);
History s3_hp3_ic1R(0.0), s3_hp3_ic2R(0.0), s3_hp4_ic1R(0.0), s3_hp4_ic2R(0.0);

// Allpass F3 on Band 1 and Band 2 (for 4-way phase alignment)
History ap3_b1_z1L(0.0), ap3_b1_z1R(0.0);
History ap3_b1_1_ic1L(0.0), ap3_b1_1_ic2L(0.0), ap3_b1_2_ic1L(0.0), ap3_b1_2_ic2L(0.0);
History ap3_b1_1_ic1R(0.0), ap3_b1_1_ic2R(0.0), ap3_b1_2_ic1R(0.0), ap3_b1_2_ic2R(0.0);

History ap3_b2_z1L(0.0), ap3_b2_z1R(0.0);
History ap3_b2_1_ic1L(0.0), ap3_b2_1_ic2L(0.0), ap3_b2_2_ic1L(0.0), ap3_b2_2_ic2L(0.0);
History ap3_b2_1_ic1R(0.0), ap3_b2_1_ic2R(0.0), ap3_b2_2_ic1R(0.0), ap3_b2_2_ic2R(0.0);

// --- 16-Band Spectrum Analyzer States (32 Hz .. 16 kHz) ---
History sp_ic1_0(0.0), sp_ic2_0(0.0), sp_env_0(0.0);
History sp_ic1_1(0.0), sp_ic2_1(0.0), sp_env_1(0.0);
History sp_ic1_2(0.0), sp_ic2_2(0.0), sp_env_2(0.0);
History sp_ic1_3(0.0), sp_ic2_3(0.0), sp_env_3(0.0);
History sp_ic1_4(0.0), sp_ic2_4(0.0), sp_env_4(0.0);
History sp_ic1_5(0.0), sp_ic2_5(0.0), sp_env_5(0.0);
History sp_ic1_6(0.0), sp_ic2_6(0.0), sp_env_6(0.0);
History sp_ic1_7(0.0), sp_ic2_7(0.0), sp_env_7(0.0);
History sp_ic1_8(0.0), sp_ic2_8(0.0), sp_env_8(0.0);
History sp_ic1_9(0.0), sp_ic2_9(0.0), sp_env_9(0.0);
History sp_ic1_10(0.0), sp_ic2_10(0.0), sp_env_10(0.0);
History sp_ic1_11(0.0), sp_ic2_11(0.0), sp_env_11(0.0);
History sp_ic1_12(0.0), sp_ic2_12(0.0), sp_env_12(0.0);
History sp_ic1_13(0.0), sp_ic2_13(0.0), sp_env_13(0.0);
History sp_ic1_14(0.0), sp_ic2_14(0.0), sp_env_14(0.0);
History sp_ic1_15(0.0), sp_ic2_15(0.0), sp_env_15(0.0);

// Peak telemetry & 8192-sample FFT ring buffer histories
History pkB1(0.0), pkB2(0.0), pkB3(0.0), pkB4(0.0);
History pkIn(0.0), pkOut(0.0);
History scopeCnt(0.0), scopeBeat(0.0);
History ringPos(0.0);

sr = max(samplerate, 1.0);
xL = fixnan(in1);
xR = fixnan(in2);

// Parameter smoothing (~3 ms)
smoothCoef = 1.0 - exp(-1.0 / (0.003 * sr));
targetF1 = clamp(f1, 20.0, sr * 0.48);
targetF2 = clamp(max(f2, targetF1 * 1.1892), 24.0, sr * 0.48);
targetF3 = clamp(max(f3, targetF2 * 1.1892), 28.0, sr * 0.48);

smF1 = slew_step(smF1, targetF1, smoothCoef);
smF2 = slew_step(smF2, targetF2, smoothCoef);
smF3 = slew_step(smF3, targetF3, smoothCoef);

targetGainLin = (gain <= -69.5) ? 0.0 : db_to_lin(clamp(gain, -70.0, 18.0));
smGain = slew_step(smGain, targetGainLin, smoothCoef);

nb = clamp(round(numbands), 1.0, 4.0);
slopeMode = clamp(round(slope), 0.0, 2.0);
maskInt = clamp(round(bandmask), 0.0, 15.0);
phaseSign = (phase > 0.5) ? -1.0 : 1.0;

// Damping constants for Butterworth 2nd-order (LR4) and 4th-order (LR8)
kButter2 = 1.4142135623730951;
kButter4A = 1.8477590650225735;
kButter4B = 0.7653668647301796;

// Effective damping per SVF stage based on slopeMode (1 = LR4 uses kButter2; 2 = LR8 alternates A and B)
kStageA = (slopeMode > 1.5) ? kButter4A : kButter2;
kStageB = (slopeMode > 1.5) ? kButter4B : kButter2;

// Pre-declare stage output variables at outer scope before conditional branches (GenExpr scoping rule)
low1L = 0.0; high1L = 0.0; low1R = 0.0; high1R = 0.0;
low2L = 0.0; high2L = 0.0; low2R = 0.0; high2R = 0.0;
b1_after2L = 0.0; b1_after2R = 0.0;
low3L = 0.0; high3L = 0.0; low3R = 0.0; high3R = 0.0;
b1_after3L = 0.0; b1_after3R = 0.0;
b2_after3L = 0.0; b2_after3R = 0.0;

// =========================================================================
// STAGE 1: Crossover at smF1
// =========================================================================
g_f1 = calc_tan_g(smF1, sr);
g1_f1 = g_f1 / (1.0 + g_f1);

if (slopeMode < 0.5) {
    // 12 dB/oct (LR2)
    vL = (xL - s1_l1a_L) * g1_f1; lp1aL = vL + s1_l1a_L; s1_l1a_L = lp1aL + vL;
    vL2 = (lp1aL - s1_l1b_L) * g1_f1; lp1bL = vL2 + s1_l1b_L; s1_l1b_L = lp1bL + vL2;
    vhL = (xL - s1_h1a_L) * g1_f1; lpHaL = vhL + s1_h1a_L; s1_h1a_L = lpHaL + vhL; hp1aL = xL - lpHaL;
    vhL2 = (hp1aL - s1_h1b_L) * g1_f1; lpHbL = vhL2 + s1_h1b_L; s1_h1b_L = lpHbL + vhL2; hp1bL = hp1aL - lpHbL;

    vR = (xR - s1_l1a_R) * g1_f1; lp1aR = vR + s1_l1a_R; s1_l1a_R = lp1aR + vR;
    vR2 = (lp1aR - s1_l1b_R) * g1_f1; lp1bR = vR2 + s1_l1b_R; s1_l1b_R = lp1bR + vR2;
    vhR = (xR - s1_h1a_R) * g1_f1; lpHaR = vhR + s1_h1a_R; s1_h1a_R = lpHaR + vhR; hp1aR = xR - lpHaR;
    vhR2 = (hp1aR - s1_h1b_R) * g1_f1; lpHbR = vhR2 + s1_h1b_R; s1_h1b_R = lpHbL * 0.0 + lpHbR + vhR2; hp1bR = hp1aR - lpHbR;

    low1L = lp1bL;
    high1L = -hp1bL;
    low1R = lp1bR;
    high1R = -hp1bR;
} else {
    a1A_1 = 1.0 / (1.0 + g_f1 * (g_f1 + kStageA));
    a2A_1 = g_f1 * a1A_1;
    a3A_1 = g_f1 * a2A_1;

    a1B_1 = 1.0 / (1.0 + g_f1 * (g_f1 + kStageB));
    a2B_1 = g_f1 * a1B_1;
    a3B_1 = g_f1 * a2B_1;

    // LP cascade Stage 1 & 2 (L)
    v3 = xL - s1_lp1_ic2L; v1 = a1A_1 * s1_lp1_ic1L + a2A_1 * v3; v2 = s1_lp1_ic2L + a2A_1 * s1_lp1_ic1L + a3A_1 * v3;
    s1_lp1_ic1L = 2.0 * v1 - s1_lp1_ic1L; s1_lp1_ic2L = 2.0 * v2 - s1_lp1_ic2L;
    lp_s1L = v2;

    v3 = lp_s1L - s1_lp2_ic2L; v1 = a1B_1 * s1_lp2_ic1L + a2B_1 * v3; v2 = s1_lp2_ic2L + a2B_1 * s1_lp2_ic1L + a3B_1 * v3;
    s1_lp2_ic1L = 2.0 * v1 - s1_lp2_ic1L; s1_lp2_ic2L = 2.0 * v2 - s1_lp2_ic2L;
    lp_s2L = v2;

    // HP cascade Stage 1 & 2 (L)
    v3 = xL - s1_hp1_ic2L; v1 = a1A_1 * s1_hp1_ic1L + a2A_1 * v3; v2 = s1_hp1_ic2L + a2A_1 * s1_hp1_ic1L + a3A_1 * v3;
    s1_hp1_ic1L = 2.0 * v1 - s1_hp1_ic1L; s1_hp1_ic2L = 2.0 * v2 - s1_hp1_ic2L;
    hp_s1L = xL - kStageA * v1 - v2;

    v3 = hp_s1L - s1_hp2_ic2L; v1 = a1B_1 * s1_hp2_ic1L + a2B_1 * v3; v2 = s1_hp2_ic2L + a2B_1 * s1_hp2_ic1L + a3B_1 * v3;
    s1_hp2_ic1L = 2.0 * v1 - s1_hp2_ic1L; s1_hp2_ic2L = 2.0 * v2 - s1_hp2_ic2L;
    hp_s2L = hp_s1L - kStageB * v1 - v2;

    // LP cascade Stage 1 & 2 (R)
    v3 = xR - s1_lp1_ic2R; v1 = a1A_1 * s1_lp1_ic1R + a2A_1 * v3; v2 = s1_lp1_ic2R + a2A_1 * s1_lp1_ic1R + a3A_1 * v3;
    s1_lp1_ic1R = 2.0 * v1 - s1_lp1_ic1R; s1_lp1_ic2R = 2.0 * v2 - s1_lp1_ic2R;
    lp_s1R = v2;

    v3 = lp_s1R - s1_lp2_ic2R; v1 = a1B_1 * s1_lp2_ic1R + a2B_1 * v3; v2 = s1_lp2_ic2R + a2B_1 * s1_lp2_ic1R + a3B_1 * v3;
    s1_lp2_ic1R = 2.0 * v1 - s1_lp2_ic1R; s1_lp2_ic2R = 2.0 * v2 - s1_lp2_ic2R;
    lp_s2R = v2;

    // HP cascade Stage 1 & 2 (R)
    v3 = xR - s1_hp1_ic2R; v1 = a1A_1 * s1_hp1_ic1R + a2A_1 * v3; v2 = s1_hp1_ic2R + a2A_1 * s1_hp1_ic1R + a3A_1 * v3;
    s1_hp1_ic1R = 2.0 * v1 - s1_hp1_ic1R; s1_hp1_ic2R = 2.0 * v2 - s1_hp1_ic2R;
    hp_s1R = xR - kStageA * v1 - v2;

    v3 = hp_s1R - s1_hp2_ic2R; v1 = a1B_1 * s1_hp2_ic1R + a2B_1 * v3; v2 = s1_hp2_ic2R + a2B_1 * s1_hp2_ic1R + a3B_1 * v3;
    s1_hp2_ic1R = 2.0 * v1 - s1_hp2_ic1R; s1_hp2_ic2R = 2.0 * v2 - s1_hp2_ic2R;
    hp_s2R = hp_s1R - kStageB * v1 - v2;

    if (slopeMode > 1.5) {
        // LR8 (48 dB/oct): Stages 3 & 4
        v3 = lp_s2L - s1_lp3_ic2L; v1 = a1A_1 * s1_lp3_ic1L + a2A_1 * v3; v2 = s1_lp3_ic2L + a2A_1 * s1_lp3_ic1L + a3A_1 * v3;
        s1_lp3_ic1L = 2.0 * v1 - s1_lp3_ic1L; s1_lp3_ic2L = 2.0 * v2 - s1_lp3_ic2L;
        lp_s3L = v2;
        v3 = lp_s3L - s1_lp4_ic2L; v1 = a1B_1 * s1_lp4_ic1L + a2B_1 * v3; v2 = s1_lp4_ic2L + a2B_1 * s1_lp4_ic1L + a3B_1 * v3;
        s1_lp4_ic1L = 2.0 * v1 - s1_lp4_ic1L; s1_lp4_ic2L = 2.0 * v2 - s1_lp4_ic2L;
        low1L = v2;

        v3 = hp_s2L - s1_hp3_ic2L; v1 = a1A_1 * s1_hp3_ic1L + a2A_1 * v3; v2 = s1_hp3_ic2L + a2A_1 * s1_hp3_ic1L + a3A_1 * v3;
        s1_hp3_ic1L = 2.0 * v1 - s1_hp3_ic1L; s1_hp3_ic2L = 2.0 * v2 - s1_hp3_ic2L;
        hp_s3L = hp_s2L - kStageA * v1 - v2;
        v3 = hp_s3L - s1_hp4_ic2L; v1 = a1B_1 * s1_hp4_ic1L + a2B_1 * v3; v2 = s1_hp4_ic2L + a2B_1 * s1_hp4_ic1L + a3B_1 * v3;
        s1_hp4_ic1L = 2.0 * v1 - s1_hp4_ic1L; s1_hp4_ic2L = 2.0 * v2 - s1_hp4_ic2L;
        high1L = hp_s3L - kStageB * v1 - v2;

        v3 = lp_s2R - s1_lp3_ic2R; v1 = a1A_1 * s1_lp3_ic1R + a2A_1 * v3; v2 = s1_lp3_ic2R + a2A_1 * s1_lp3_ic1R + a3A_1 * v3;
        s1_lp3_ic1R = 2.0 * v1 - s1_lp3_ic1R; s1_lp3_ic2R = 2.0 * v2 - s1_lp3_ic2R;
        lp_s3R = v2;
        v3 = lp_s3R - s1_lp4_ic2R; v1 = a1B_1 * s1_lp4_ic1R + a2B_1 * v3; v2 = s1_lp4_ic2R + a2B_1 * s1_lp4_ic1R + a3B_1 * v3;
        s1_lp4_ic1R = 2.0 * v1 - s1_lp4_ic1R; s1_lp4_ic2R = 2.0 * v2 - s1_lp4_ic2R;
        low1R = v2;

        v3 = hp_s2R - s1_hp3_ic2R; v1 = a1A_1 * s1_hp3_ic1R + a2A_1 * v3; v2 = s1_hp3_ic2R + a2A_1 * s1_hp3_ic1R + a3A_1 * v3;
        s1_hp3_ic1R = 2.0 * v1 - s1_hp3_ic1R; s1_hp3_ic2R = 2.0 * v2 - s1_hp3_ic2R;
        hp_s3R = hp_s2R - kStageA * v1 - v2;
        v3 = hp_s3R - s1_hp4_ic2R; v1 = a1B_1 * s1_hp4_ic1R + a2B_1 * v3; v2 = s1_hp4_ic2R + a2B_1 * s1_hp4_ic1R + a3B_1 * v3;
        s1_hp4_ic1R = 2.0 * v1 - s1_hp4_ic1R; s1_hp4_ic2R = 2.0 * v2 - s1_hp4_ic2R;
        high1R = hp_s3R - kStageB * v1 - v2;
    } else {
        low1L = lp_s2L;
        high1L = hp_s2L;
        low1R = lp_s2R;
        high1R = hp_s2R;
    }
}

// =========================================================================
// STAGE 2: Crossover at smF2 (on high1) + Allpass at smF2 (on low1)
// =========================================================================
g_f2 = calc_tan_g(smF2, sr);
g1_f2 = g_f2 / (1.0 + g_f2);

if (slopeMode < 0.5) {
    // 12 dB/oct (LR2) Split on high1
    vL = (high1L - s2_l1a_L) * g1_f2; lp2aL = vL + s2_l1a_L; s2_l1a_L = lp2aL + vL;
    vL2 = (lp2aL - s2_l1b_L) * g1_f2; lp2bL = vL2 + s2_l1b_L; s2_l1b_L = lp2bL + vL2;
    vhL = (high1L - s2_h1a_L) * g1_f2; lp2HaL = vhL + s2_h1a_L; s2_h1a_L = lp2HaL + vhL; hp2aL = high1L - lp2HaL;
    vhL2 = (hp2aL - s2_h1b_L) * g1_f2; lp2HbL = vhL2 + s2_h1b_L; s2_h1b_L = lp2HbL + vhL2; hp2bL = hp2aL - lp2HbL;

    vR = (high1R - s2_l1a_R) * g1_f2; lp2aR = vR + s2_l1a_R; s2_l1a_R = lp2aR + vR;
    vR2 = (lp2aR - s2_l1b_R) * g1_f2; lp2bR = vR2 + s2_l1b_R; s2_l1b_R = lp2bR + vR2;
    vhR = (high1R - s2_h1a_R) * g1_f2; lp2HaR = vhR + s2_h1a_R; s2_h1a_R = lp2HaR + vhR; hp2aR = high1R - lp2HaR;
    vhR2 = (hp2aR - s2_h1b_R) * g1_f2; lp2HbR = vhR2 + s2_h1b_R; s2_h1b_R = lp2HbR + vhR2; hp2bR = hp2aR - lp2HbR;

    low2L = lp2bL;
    high2L = -hp2bL;
    low2R = lp2bR;
    high2R = -hp2bR;

    // 1st-order Allpass at F2 on low1
    vaL = (low1L - ap2_b1_z1L) * g1_f2; lpaL = vaL + ap2_b1_z1L; ap2_b1_z1L = lpaL + vaL;
    b1_after2L = 2.0 * lpaL - low1L;
    vaR = (low1R - ap2_b1_z1R) * g1_f2; lpaR = vaR + ap2_b1_z1R; ap2_b1_z1R = lpaR + vaR;
    b1_after2R = 2.0 * lpaR - low1R;
} else {
    a1A_2 = 1.0 / (1.0 + g_f2 * (g_f2 + kStageA));
    a2A_2 = g_f2 * a1A_2;
    a3A_2 = g_f2 * a2A_2;

    a1B_2 = 1.0 / (1.0 + g_f2 * (g_f2 + kStageB));
    a2B_2 = g_f2 * a1B_2;
    a3B_2 = g_f2 * a2B_2;

    // LP cascade Stage 1 & 2 (L)
    v3 = high1L - s2_lp1_ic2L; v1 = a1A_2 * s2_lp1_ic1L + a2A_2 * v3; v2 = s2_lp1_ic2L + a2A_2 * s2_lp1_ic1L + a3A_2 * v3;
    s2_lp1_ic1L = 2.0 * v1 - s2_lp1_ic1L; s2_lp1_ic2L = 2.0 * v2 - s2_lp1_ic2L;
    lp2_s1L = v2;
    v3 = lp2_s1L - s2_lp2_ic2L; v1 = a1B_2 * s2_lp2_ic1L + a2B_2 * v3; v2 = s2_lp2_ic2L + a2B_2 * s2_lp2_ic1L + a3B_2 * v3;
    s2_lp2_ic1L = 2.0 * v1 - s2_lp2_ic1L; s2_lp2_ic2L = 2.0 * v2 - s2_lp2_ic2L;
    lp2_s2L = v2;

    // HP cascade Stage 1 & 2 (L)
    v3 = high1L - s2_hp1_ic2L; v1 = a1A_2 * s2_hp1_ic1L + a2A_2 * v3; v2 = s2_hp1_ic2L + a2A_2 * s2_hp1_ic1L + a3A_2 * v3;
    s2_hp1_ic1L = 2.0 * v1 - s2_hp1_ic1L; s2_hp1_ic2L = 2.0 * v2 - s2_hp1_ic2L;
    hp2_s1L = high1L - kStageA * v1 - v2;
    v3 = hp2_s1L - s2_hp2_ic2L; v1 = a1B_2 * s2_hp2_ic1L + a2B_2 * v3; v2 = s2_hp2_ic2L + a2B_2 * s2_hp2_ic1L + a3B_2 * v3;
    s2_hp2_ic1L = 2.0 * v1 - s2_hp2_ic1L; s2_hp2_ic2L = 2.0 * v2 - s2_hp2_ic2L;
    hp2_s2L = hp2_s1L - kStageB * v1 - v2;

    // LP cascade Stage 1 & 2 (R)
    v3 = high1R - s2_lp1_ic2R; v1 = a1A_2 * s2_lp1_ic1R + a2A_2 * v3; v2 = s2_lp1_ic2R + a2A_2 * s2_lp1_ic1R + a3A_2 * v3;
    s2_lp1_ic1R = 2.0 * v1 - s2_lp1_ic1R; s2_lp1_ic2R = 2.0 * v2 - s2_lp1_ic2R;
    lp2_s1R = v2;
    v3 = lp2_s1R - s2_lp2_ic2R; v1 = a1B_2 * s2_lp2_ic1R + a2B_2 * v3; v2 = s2_lp2_ic2R + a2B_2 * s2_lp2_ic1R + a3B_2 * v3;
    s2_lp2_ic1R = 2.0 * v1 - s2_lp2_ic1R; s2_lp2_ic2R = 2.0 * v2 - s2_lp2_ic2R;
    lp2_s2R = v2;

    // HP cascade Stage 1 & 2 (R)
    v3 = high1R - s2_hp1_ic2R; v1 = a1A_2 * s2_hp1_ic1R + a2A_2 * v3; v2 = s2_hp1_ic2R + a2A_2 * s2_hp1_ic1R + a3A_2 * v3;
    s2_hp1_ic1R = 2.0 * v1 - s2_hp1_ic1R; s2_hp1_ic2R = 2.0 * v2 - s2_hp1_ic2R;
    hp2_s1R = high1R - kStageA * v1 - v2;
    v3 = hp2_s1R - s2_hp2_ic2R; v1 = a1B_2 * s2_hp2_ic1R + a2B_2 * v3; v2 = s2_hp2_ic2R + a2B_2 * s2_hp2_ic1R + a3B_2 * v3;
    s2_hp2_ic1R = 2.0 * v1 - s2_hp2_ic1R; s2_hp2_ic2R = 2.0 * v2 - s2_hp2_ic2R;
    hp2_s2R = hp2_s1R - kStageB * v1 - v2;

    // Allpass at F2 on low1 (Stage A)
    v3 = low1L - ap2_b1_1_ic2L; v1 = a1A_2 * ap2_b1_1_ic1L + a2A_2 * v3; v2 = ap2_b1_1_ic2L + a2A_2 * ap2_b1_1_ic1L + a3A_2 * v3;
    ap2_b1_1_ic1L = 2.0 * v1 - ap2_b1_1_ic1L; ap2_b1_1_ic2L = 2.0 * v2 - ap2_b1_1_ic2L;
    ap2_s1L = low1L - 2.0 * kStageA * v1;

    v3 = low1R - ap2_b1_1_ic2R; v1 = a1A_2 * ap2_b1_1_ic1R + a2A_2 * v3; v2 = ap2_b1_1_ic2R + a2A_2 * ap2_b1_1_ic1R + a3A_2 * v3;
    ap2_b1_1_ic1R = 2.0 * v1 - ap2_b1_1_ic1R; ap2_b1_1_ic2R = 2.0 * v2 - ap2_b1_1_ic2R;
    ap2_s1R = low1R - 2.0 * kStageA * v1;

    if (slopeMode > 1.5) {
        // LR8 (48 dB/oct): Stages 3 & 4
        v3 = lp2_s2L - s2_lp3_ic2L; v1 = a1A_2 * s2_lp3_ic1L + a2A_2 * v3; v2 = s2_lp3_ic2L + a2A_2 * s2_lp3_ic1L + a3A_2 * v3;
        s2_lp3_ic1L = 2.0 * v1 - s2_lp3_ic1L; s2_lp3_ic2L = 2.0 * v2 - s2_lp3_ic2L;
        lp2_s3L = v2;
        v3 = lp2_s3L - s2_lp4_ic2L; v1 = a1B_2 * s2_lp4_ic1L + a2B_2 * v3; v2 = s2_lp4_ic2L + a2B_2 * s2_lp4_ic1L + a3B_2 * v3;
        s2_lp4_ic1L = 2.0 * v1 - s2_lp4_ic1L; s2_lp4_ic2L = 2.0 * v2 - s2_lp4_ic2L;
        low2L = v2;

        v3 = hp2_s2L - s2_hp3_ic2L; v1 = a1A_2 * s2_hp3_ic1L + a2A_2 * v3; v2 = s2_hp3_ic2L + a2A_2 * s2_hp3_ic1L + a3A_2 * v3;
        s2_hp3_ic1L = 2.0 * v1 - s2_hp3_ic1L; s2_hp3_ic2L = 2.0 * v2 - s2_hp3_ic2L;
        hp2_s3L = hp2_s2L - kStageA * v1 - v2;
        v3 = hp2_s3L - s2_hp4_ic2L; v1 = a1B_2 * s2_hp4_ic1L + a2B_2 * v3; v2 = s2_hp4_ic2L + a2B_2 * s2_hp4_ic1L + a3B_2 * v3;
        s2_hp4_ic1L = 2.0 * v1 - s2_hp4_ic1L; s2_hp4_ic2L = 2.0 * v2 - s2_hp4_ic2L;
        high2L = hp2_s3L - kStageB * v1 - v2;

        v3 = lp2_s2R - s2_lp3_ic2R; v1 = a1A_2 * s2_lp3_ic1R + a2A_2 * v3; v2 = s2_lp3_ic2R + a2A_2 * s2_lp3_ic1R + a3A_2 * v3;
        s2_lp3_ic1R = 2.0 * v1 - s2_lp3_ic1R; s2_lp3_ic2R = 2.0 * v2 - s2_lp3_ic2R;
        lp2_s3R = v2;
        v3 = lp2_s3R - s2_lp4_ic2R; v1 = a1B_2 * s2_lp4_ic1R + a2B_2 * v3; v2 = s2_lp4_ic2R + a2B_2 * s2_lp4_ic1R + a3B_2 * v3;
        s2_lp4_ic1R = 2.0 * v1 - s2_lp4_ic1R; s2_lp4_ic2R = 2.0 * v2 - s2_lp4_ic2R;
        low2R = v2;

        v3 = hp2_s2R - s2_hp3_ic2R; v1 = a1A_2 * s2_hp3_ic1R + a2A_2 * v3; v2 = s2_hp3_ic2R + a2A_2 * s2_hp3_ic1R + a3A_2 * v3;
        s2_hp3_ic1R = 2.0 * v1 - s2_hp3_ic1R; s2_hp3_ic2R = 2.0 * v2 - s2_hp3_ic2R;
        hp2_s3R = hp2_s2R - kStageA * v1 - v2;
        v3 = hp2_s3R - s2_hp4_ic2R; v1 = a1B_2 * s2_hp4_ic1R + a2B_2 * v3; v2 = s2_hp4_ic2R + a2B_2 * s2_hp4_ic1R + a3B_2 * v3;
        s2_hp4_ic1R = 2.0 * v1 - s2_hp4_ic1R; s2_hp4_ic2R = 2.0 * v2 - s2_hp4_ic2R;
        high2R = hp2_s3R - kStageB * v1 - v2;

        // 2nd Allpass SVF stage (kStageB) for LR8 allpass on low1
        v3 = ap2_s1L - ap2_b1_2_ic2L; v1 = a1B_2 * ap2_b1_2_ic1L + a2B_2 * v3; v2 = ap2_b1_2_ic2L + a2B_2 * ap2_b1_2_ic1L + a3B_2 * v3;
        ap2_b1_2_ic1L = 2.0 * v1 - ap2_b1_2_ic1L; ap2_b1_2_ic2L = 2.0 * v2 - ap2_b1_2_ic2L;
        b1_after2L = ap2_s1L - 2.0 * kStageB * v1;

        v3 = ap2_s1R - ap2_b1_2_ic2R; v1 = a1B_2 * ap2_b1_2_ic1R + a2B_2 * v3; v2 = ap2_b1_2_ic2R + a2B_2 * ap2_b1_2_ic1R + a3B_2 * v3;
        ap2_b1_2_ic1R = 2.0 * v1 - ap2_b1_2_ic1R; ap2_b1_2_ic2R = 2.0 * v2 - ap2_b1_2_ic2R;
        b1_after2R = ap2_s1R - 2.0 * kStageB * v1;
    } else {
        low2L = lp2_s2L;
        high2L = hp2_s2L;
        low2R = lp2_s2R;
        high2R = hp2_s2R;
        b1_after2L = ap2_s1L;
        b1_after2R = ap2_s1R;
    }
}

// =========================================================================
// STAGE 3: Crossover at smF3 (on high2) + Allpass at smF3 (on b1_after2 & low2)
// =========================================================================
g_f3 = calc_tan_g(smF3, sr);
g1_f3 = g_f3 / (1.0 + g_f3);

if (slopeMode < 0.5) {
    // 12 dB/oct (LR2) Split on high2
    vL = (high2L - s3_l1a_L) * g1_f3; lp3aL = vL + s3_l1a_L; s3_l1a_L = lp3aL + vL;
    vL2 = (lp3aL - s3_l1b_L) * g1_f3; lp3bL = vL2 + s3_l1b_L; s3_l1b_L = lp3bL + vL2;
    vhL = (high2L - s3_h1a_L) * g1_f3; lp3HaL = vhL + s3_h1a_L; s3_h1a_L = lp3HaL + vhL; hp3aL = high2L - lp3HaL;
    vhL2 = (hp3aL - s3_h1b_L) * g1_f3; lp3HbL = vhL2 + s3_h1b_L; s3_h1b_L = lp3HbL + vhL2; hp3bL = hp3aL - lp3HbL;

    vR = (high2R - s3_l1a_R) * g1_f3; lp3aR = vR + s3_l1a_R; s3_l1a_R = lp3aR + vR;
    vR2 = (lp3aR - s3_l1b_R) * g1_f3; lp3bR = vR2 + s3_l1b_R; s3_l1b_R = lp3bR + vR2;
    vhR = (high2R - s3_h1a_R) * g1_f3; lp3HaR = vhR + s3_h1a_R; s3_h1a_R = lp3HaR + vhR; hp3aR = high2R - lp3HaR;
    vhR2 = (hp3aR - s3_h1b_R) * g1_f3; lp3HbR = vhR2 + s3_h1b_R; s3_h1b_R = lp3HbR + vhR2; hp3bR = hp3aR - lp3HbR;

    low3L = lp3bL;
    high3L = -hp3bL;
    low3R = lp3bR;
    high3R = -hp3bR;

    // 1st-order Allpass at F3 on b1_after2 and low2
    va1L = (b1_after2L - ap3_b1_z1L) * g1_f3; lpa1L = va1L + ap3_b1_z1L; ap3_b1_z1L = lpa1L + va1L;
    b1_after3L = 2.0 * lpa1L - b1_after2L;
    va1R = (b1_after2R - ap3_b1_z1R) * g1_f3; lpa1R = va1R + ap3_b1_z1R; ap3_b1_z1R = lpa1R + va1R;
    b1_after3R = 2.0 * lpa1R - b1_after2R;

    va2L = (low2L - ap3_b2_z1L) * g1_f3; lpa2L = va2L + ap3_b2_z1L; ap3_b2_z1L = lpa2L + va2L;
    b2_after3L = 2.0 * lpa2L - low2L;
    va2R = (low2R - ap3_b2_z1R) * g1_f3; lpa2R = va2R + ap3_b2_z1R; ap3_b2_z1R = lpa2R + va2R;
    b2_after3R = 2.0 * lpa2R - low2R;
} else {
    a1A_3 = 1.0 / (1.0 + g_f3 * (g_f3 + kStageA));
    a2A_3 = g_f3 * a1A_3;
    a3A_3 = g_f3 * a2A_3;

    a1B_3 = 1.0 / (1.0 + g_f3 * (g_f3 + kStageB));
    a2B_3 = g_f3 * a1B_3;
    a3B_3 = g_f3 * a2B_3;

    // LP cascade Stage 1 & 2 (L)
    v3 = high2L - s3_lp1_ic2L; v1 = a1A_3 * s3_lp1_ic1L + a2A_3 * v3; v2 = s3_lp1_ic2L + a2A_3 * s3_lp1_ic1L + a3A_3 * v3;
    s3_lp1_ic1L = 2.0 * v1 - s3_lp1_ic1L; s3_lp1_ic2L = 2.0 * v2 - s3_lp1_ic2L;
    lp3_s1L = v2;
    v3 = lp3_s1L - s3_lp2_ic2L; v1 = a1B_3 * s3_lp2_ic1L + a2B_3 * v3; v2 = s3_lp2_ic2L + a2B_3 * s3_lp2_ic1L + a3B_3 * v3;
    s3_lp2_ic1L = 2.0 * v1 - s3_lp2_ic1L; s3_lp2_ic2L = 2.0 * v2 - s3_lp2_ic2L;
    lp3_s2L = v2;

    // HP cascade Stage 1 & 2 (L)
    v3 = high2L - s3_hp1_ic2L; v1 = a1A_3 * s3_hp1_ic1L + a2A_3 * v3; v2 = s3_hp1_ic2L + a2A_3 * s3_hp1_ic1L + a3A_3 * v3;
    s3_hp1_ic1L = 2.0 * v1 - s3_hp1_ic1L; s3_hp1_ic2L = 2.0 * v2 - s3_hp1_ic2L;
    hp3_s1L = high2L - kStageA * v1 - v2;
    v3 = hp3_s1L - s3_hp2_ic2L; v1 = a1B_3 * s3_hp2_ic1L + a2B_3 * v3; v2 = s3_hp2_ic2L + a2B_3 * s3_hp2_ic1L + a3B_3 * v3;
    s3_hp2_ic1L = 2.0 * v1 - s3_hp2_ic1L; s3_hp2_ic2L = 2.0 * v2 - s3_hp2_ic2L;
    hp3_s2L = hp3_s1L - kStageB * v1 - v2;

    // LP cascade Stage 1 & 2 (R)
    v3 = high2R - s3_lp1_ic2R; v1 = a1A_3 * s3_lp1_ic1R + a2A_3 * v3; v2 = s3_lp1_ic2R + a2A_3 * s3_lp1_ic1R + a3A_3 * v3;
    s3_lp1_ic1R = 2.0 * v1 - s3_lp1_ic1R; s3_lp1_ic2R = 2.0 * v2 - s3_lp1_ic2R;
    lp3_s1R = v2;
    v3 = lp3_s1R - s3_lp2_ic2R; v1 = a1B_3 * s3_lp2_ic1R + a2B_3 * v3; v2 = s3_lp2_ic2R + a2B_3 * s3_lp2_ic1R + a3B_3 * v3;
    s3_lp2_ic1R = 2.0 * v1 - s3_lp2_ic1R; s3_lp2_ic2R = 2.0 * v2 - s3_lp2_ic2R;
    lp3_s2R = v2;

    // HP cascade Stage 1 & 2 (R)
    v3 = high2R - s3_hp1_ic2R; v1 = a1A_3 * s3_hp1_ic1R + a2A_3 * v3; v2 = s3_hp1_ic2R + a2A_3 * s3_hp1_ic1R + a3A_3 * v3;
    s3_hp1_ic1R = 2.0 * v1 - s3_hp1_ic1R; s3_hp1_ic2R = 2.0 * v2 - s3_hp1_ic2R;
    hp3_s1R = high2R - kStageA * v1 - v2;
    v3 = hp3_s1R - s3_hp2_ic2R; v1 = a1B_3 * s3_hp2_ic1R + a2B_3 * v3; v2 = s3_hp2_ic2R + a2B_3 * s3_hp2_ic1R + a3B_3 * v3;
    s3_hp2_ic1R = 2.0 * v1 - s3_hp2_ic1R; s3_hp2_ic2R = 2.0 * v2 - s3_hp2_ic2R;
    hp3_s2R = hp3_s1R - kStageB * v1 - v2;

    // Allpass at F3 on b1_after2 (Stage A)
    v3 = b1_after2L - ap3_b1_1_ic2L; v1 = a1A_3 * ap3_b1_1_ic1L + a2A_3 * v3; v2 = ap3_b1_1_ic2L + a2A_3 * ap3_b1_1_ic1L + a3A_3 * v3;
    ap3_b1_1_ic1L = 2.0 * v1 - ap3_b1_1_ic1L; ap3_b1_1_ic2L = 2.0 * v2 - ap3_b1_1_ic2L;
    ap3_b1_s1L = b1_after2L - 2.0 * kStageA * v1;

    v3 = b1_after2R - ap3_b1_1_ic2R; v1 = a1A_3 * ap3_b1_1_ic1R + a2A_3 * v3; v2 = ap3_b1_1_ic2R + a2A_3 * ap3_b1_1_ic1R + a3A_3 * v3;
    ap3_b1_1_ic1R = 2.0 * v1 - ap3_b1_1_ic1R; ap3_b1_1_ic2R = 2.0 * v2 - ap3_b1_1_ic2R;
    ap3_b1_s1R = b1_after2R - 2.0 * kStageA * v1;

    // Allpass at F3 on low2 (Stage A)
    v3 = low2L - ap3_b2_1_ic2L; v1 = a1A_3 * ap3_b2_1_ic1L + a2A_3 * v3; v2 = ap3_b2_1_ic2L + a2A_3 * ap3_b2_1_ic1L + a3A_3 * v3;
    ap3_b2_1_ic1L = 2.0 * v1 - ap3_b2_1_ic1L; ap3_b2_1_ic2L = 2.0 * v2 - ap3_b2_1_ic2L;
    ap3_b2_s1L = low2L - 2.0 * kStageA * v1;

    v3 = low2R - ap3_b2_1_ic2R; v1 = a1A_3 * ap3_b2_1_ic1R + a2A_3 * v3; v2 = ap3_b2_1_ic2R + a2A_3 * ap3_b2_1_ic1R + a3A_3 * v3;
    ap3_b2_1_ic1R = 2.0 * v1 - ap3_b2_1_ic1R; ap3_b2_1_ic2R = 2.0 * v2 - ap3_b2_1_ic2R;
    ap3_b2_s1R = low2R - 2.0 * kStageA * v1;

    if (slopeMode > 1.5) {
        // LR8 (48 dB/oct): Stages 3 & 4
        v3 = lp3_s2L - s3_lp3_ic2L; v1 = a1A_3 * s3_lp3_ic1L + a2A_3 * v3; v2 = s3_lp3_ic2L + a2A_3 * s3_lp3_ic1L + a3A_3 * v3;
        s3_lp3_ic1L = 2.0 * v1 - s3_lp3_ic1L; s3_lp3_ic2L = 2.0 * v2 - s3_lp3_ic2L;
        lp3_s3L = v2;
        v3 = lp3_s3L - s3_lp4_ic2L; v1 = a1B_3 * s3_lp4_ic1L + a2B_3 * v3; v2 = s3_lp4_ic2L + a2B_3 * s3_lp4_ic1L + a3B_3 * v3;
        s3_lp4_ic1L = 2.0 * v1 - s3_lp4_ic1L; s3_lp4_ic2L = 2.0 * v2 - s3_lp4_ic2L;
        low3L = v2;

        v3 = hp3_s2L - s3_hp3_ic2L; v1 = a1A_3 * s3_hp3_ic1L + a2A_3 * v3; v2 = s3_hp3_ic2L + a2A_3 * s3_hp3_ic1L + a3A_3 * v3;
        s3_hp3_ic1L = 2.0 * v1 - s3_hp3_ic1L; s3_hp3_ic2L = 2.0 * v2 - s3_hp3_ic2L;
        hp3_s3L = hp3_s2L - kStageA * v1 - v2;
        v3 = hp3_s3L - s3_hp4_ic2L; v1 = a1B_3 * s3_hp4_ic1L + a2B_3 * v3; v2 = s3_hp4_ic2L + a2B_3 * s3_hp4_ic1L + a3B_3 * v3;
        s3_hp4_ic1L = 2.0 * v1 - s3_hp4_ic1L; s3_hp4_ic2L = 2.0 * v2 - s3_hp4_ic2L;
        high3L = hp3_s3L - kStageB * v1 - v2;

        v3 = lp3_s2R - s3_lp3_ic2R; v1 = a1A_3 * s3_lp3_ic1R + a2A_3 * v3; v2 = s3_lp3_ic2R + a2A_3 * s3_lp3_ic1R + a3A_3 * v3;
        s3_lp3_ic1R = 2.0 * v1 - s3_lp3_ic1R; s3_lp3_ic2R = 2.0 * v2 - s3_lp3_ic2R;
        lp3_s3R = v2;
        v3 = lp3_s3R - s3_lp4_ic2R; v1 = a1B_3 * s3_lp4_ic1R + a2B_3 * v3; v2 = s3_lp4_ic2R + a2B_3 * s3_lp4_ic1R + a3B_3 * v3;
        s3_lp4_ic1R = 2.0 * v1 - s3_lp4_ic1R; s3_lp4_ic2R = 2.0 * v2 - s3_lp4_ic2R;
        low3R = v2;

        v3 = hp3_s2R - s3_hp3_ic2R; v1 = a1A_3 * s3_hp3_ic1R + a2A_3 * v3; v2 = s3_hp3_ic2R + a2A_3 * s3_hp3_ic1R + a3A_3 * v3;
        s3_hp3_ic1R = 2.0 * v1 - s3_hp3_ic1R; s3_hp3_ic2R = 2.0 * v2 - s3_hp3_ic2R;
        hp3_s3R = hp3_s2R - kStageA * v1 - v2;
        v3 = hp3_s3R - s3_hp4_ic2R; v1 = a1B_3 * s3_hp4_ic1R + a2B_3 * v3; v2 = s3_hp4_ic2R + a2B_3 * s3_hp4_ic1R + a3B_3 * v3;
        s3_hp4_ic1R = 2.0 * v1 - s3_hp4_ic1R; s3_hp4_ic2R = 2.0 * v2 - s3_hp4_ic2R;
        high3R = hp3_s3R - kStageB * v1 - v2;

        // 2nd Allpass SVF stage (kStageB) for LR8 allpass on b1_after2 & low2
        v3 = ap3_b1_s1L - ap3_b1_2_ic2L; v1 = a1B_3 * ap3_b1_2_ic1L + a2B_3 * v3; v2 = ap3_b1_2_ic2L + a2B_3 * ap3_b1_2_ic1L + a3B_3 * v3;
        ap3_b1_2_ic1L = 2.0 * v1 - ap3_b1_2_ic1L; ap3_b1_2_ic2L = 2.0 * v2 - ap3_b1_2_ic2L;
        b1_after3L = ap3_b1_s1L - 2.0 * kStageB * v1;

        v3 = ap3_b1_s1R - ap3_b1_2_ic2R; v1 = a1B_3 * ap3_b1_2_ic1R + a2B_3 * v3; v2 = ap3_b1_2_ic2R + a2B_3 * ap3_b1_2_ic1R + a3B_3 * v3;
        ap3_b1_2_ic1R = 2.0 * v1 - ap3_b1_2_ic1R; ap3_b1_2_ic2R = 2.0 * v2 - ap3_b1_2_ic2R;
        b1_after3R = ap3_b1_s1R - 2.0 * kStageB * v1;

        v3 = ap3_b2_s1L - ap3_b2_2_ic2L; v1 = a1B_3 * ap3_b2_2_ic1L + a2B_3 * v3; v2 = ap3_b2_2_ic2L + a2B_3 * ap3_b2_2_ic1L + a3B_3 * v3;
        ap3_b2_2_ic1L = 2.0 * v1 - ap3_b2_2_ic1L; ap3_b2_2_ic2L = 2.0 * v2 - ap3_b2_2_ic2L;
        b2_after3L = ap3_b2_s1L - 2.0 * kStageB * v1;

        v3 = ap3_b2_s1R - ap3_b2_2_ic2R; v1 = a1B_3 * ap3_b2_2_ic1R + a2B_3 * v3; v2 = ap3_b2_2_ic2R + a2B_3 * ap3_b2_2_ic1R + a3B_3 * v3;
        ap3_b2_2_ic1R = 2.0 * v1 - ap3_b2_2_ic1R; ap3_b2_2_ic2R = 2.0 * v2 - ap3_b2_2_ic2R;
        b2_after3R = ap3_b2_s1R - 2.0 * kStageB * v1;
    } else {
        low3L = lp3_s2L;
        high3L = hp3_s2L;
        low3R = lp3_s2R;
        high3R = hp3_s2R;
        b1_after3L = ap3_b1_s1L;
        b1_after3R = ap3_b1_s1R;
        b2_after3L = ap3_b2_s1L;
        b2_after3R = ap3_b2_s1R;
    }
}

// =========================================================================
// SELECT 1-WAY (FULL), 2-WAY, 3-WAY, OR 4-WAY PHASE-ALIGNED BANDS
// =========================================================================
band1L = (nb < 1.5) ? xL : ((nb < 2.5) ? low1L : ((nb < 3.5) ? b1_after2L : b1_after3L));
band1R = (nb < 1.5) ? xR : ((nb < 2.5) ? low1R : ((nb < 3.5) ? b1_after2R : b1_after3R));

band2L = (nb < 1.5) ? 0.0 : ((nb < 2.5) ? high1L : ((nb < 3.5) ? low2L : b2_after3L));
band2R = (nb < 1.5) ? 0.0 : ((nb < 2.5) ? high1R : ((nb < 3.5) ? low2R : b2_after3R));

band3L = (nb < 2.5) ? 0.0 : ((nb < 3.5) ? high2L : low3L);
band3R = (nb < 2.5) ? 0.0 : ((nb < 3.5) ? high2R : low3R);

band4L = (nb < 3.5) ? 0.0 : high3L;
band4R = (nb < 3.5) ? 0.0 : high3R;

// Decode 4-bit bandmask
en1 = (mod(floor(maskInt), 2.0) >= 0.5) ? 1.0 : 0.0;
en2 = (mod(floor(maskInt * 0.5), 2.0) >= 0.5) ? 1.0 : 0.0;
en3 = (mod(floor(maskInt * 0.25), 2.0) >= 0.5) ? 1.0 : 0.0;
en4 = (mod(floor(maskInt * 0.125), 2.0) >= 0.5) ? 1.0 : 0.0;

sumL = en1 * band1L + en2 * band2L + en3 * band3L + en4 * band4L;
sumR = en1 * band1R + en2 * band2R + en3 * band3R + en4 * band4R;

outL = fixnan(sumL * smGain * phaseSign);
outR = fixnan(sumR * smGain * phaseSign);

out1 = outL;
out2 = outR;

// =========================================================================
// 16-BAND SPECTRUM ANALYZER & TELEMETRY (poked to Buffer scope every 64 samps)
// =========================================================================
monoIn = 0.5 * (xL + xR);
envDecay = 0.9992;
kSpec = 0.45; // Q ~ 2.2 bandpass analysis bank

// Band 0: 32 Hz
g0 = calc_tan_g(32.0, sr); a1_0 = 1.0 / (1.0 + g0 * (g0 + kSpec)); a2_0 = g0 * a1_0; a3_0 = g0 * a2_0;
v3 = monoIn - sp_ic2_0; v1 = a1_0 * sp_ic1_0 + a2_0 * v3; v2 = sp_ic2_0 + a2_0 * sp_ic1_0 + a3_0 * v3;
sp_ic1_0 = 2.0 * v1 - sp_ic1_0; sp_ic2_0 = 2.0 * v2 - sp_ic2_0;
sp_env_0 = max(abs(kSpec * v1), sp_env_0 * envDecay);

// Band 1: 48 Hz
g1s = calc_tan_g(48.0, sr); a1_1 = 1.0 / (1.0 + g1s * (g1s + kSpec)); a2_1 = g1s * a1_1; a3_1 = g1s * a2_1;
v3 = monoIn - sp_ic2_1; v1 = a1_1 * sp_ic1_1 + a2_1 * v3; v2 = sp_ic2_1 + a2_1 * sp_ic1_1 + a3_1 * v3;
sp_ic1_1 = 2.0 * v1 - sp_ic1_1; sp_ic2_1 = 2.0 * v2 - sp_ic2_1;
sp_env_1 = max(abs(kSpec * v1), sp_env_1 * envDecay);

// Band 2: 72 Hz
g2s = calc_tan_g(72.0, sr); a1_2 = 1.0 / (1.0 + g2s * (g2s + kSpec)); a2_2 = g2s * a1_2; a3_2 = g2s * a2_2;
v3 = monoIn - sp_ic2_2; v1 = a1_2 * sp_ic1_2 + a2_2 * v3; v2 = sp_ic2_2 + a2_2 * sp_ic1_2 + a3_2 * v3;
sp_ic1_2 = 2.0 * v1 - sp_ic1_2; sp_ic2_2 = 2.0 * v2 - sp_ic2_2;
sp_env_2 = max(abs(kSpec * v1), sp_env_2 * envDecay);

// Band 3: 110 Hz
g3s = calc_tan_g(110.0, sr); a1_3 = 1.0 / (1.0 + g3s * (g3s + kSpec)); a2_3 = g3s * a1_3; a3_3 = g3s * a2_3;
v3 = monoIn - sp_ic2_3; v1 = a1_3 * sp_ic1_3 + a2_3 * v3; v2 = sp_ic2_3 + a2_3 * sp_ic1_3 + a3_3 * v3;
sp_ic1_3 = 2.0 * v1 - sp_ic1_3; sp_ic2_3 = 2.0 * v2 - sp_ic2_3;
sp_env_3 = max(abs(kSpec * v1), sp_env_3 * envDecay);

// Band 4: 165 Hz
g4s = calc_tan_g(165.0, sr); a1_4 = 1.0 / (1.0 + g4s * (g4s + kSpec)); a2_4 = g4s * a1_4; a3_4 = g4s * a2_4;
v3 = monoIn - sp_ic2_4; v1 = a1_4 * sp_ic1_4 + a2_4 * v3; v2 = sp_ic2_4 + a2_4 * sp_ic1_4 + a3_4 * v3;
sp_ic1_4 = 2.0 * v1 - sp_ic1_4; sp_ic2_4 = 2.0 * v2 - sp_ic2_4;
sp_env_4 = max(abs(kSpec * v1), sp_env_4 * envDecay);

// Band 5: 250 Hz
g5s = calc_tan_g(250.0, sr); a1_5 = 1.0 / (1.0 + g5s * (g5s + kSpec)); a2_5 = g5s * a1_5; a3_5 = g5s * a2_5;
v3 = monoIn - sp_ic2_5; v1 = a1_5 * sp_ic1_5 + a2_5 * v3; v2 = sp_ic2_5 + a2_5 * sp_ic1_5 + a3_5 * v3;
sp_ic1_5 = 2.0 * v1 - sp_ic1_5; sp_ic2_5 = 2.0 * v2 - sp_ic2_5;
sp_env_5 = max(abs(kSpec * v1), sp_env_5 * envDecay);

// Band 6: 375 Hz
g6s = calc_tan_g(375.0, sr); a1_6 = 1.0 / (1.0 + g6s * (g6s + kSpec)); a2_6 = g6s * a1_6; a3_6 = g6s * a2_6;
v3 = monoIn - sp_ic2_6; v1 = a1_6 * sp_ic1_6 + a2_6 * v3; v2 = sp_ic2_6 + a2_6 * sp_ic1_6 + a3_6 * v3;
sp_ic1_6 = 2.0 * v1 - sp_ic1_6; sp_ic2_6 = 2.0 * v2 - sp_ic2_6;
sp_env_6 = max(abs(kSpec * v1), sp_env_6 * envDecay);

// Band 7: 560 Hz
g7s = calc_tan_g(560.0, sr); a1_7 = 1.0 / (1.0 + g7s * (g7s + kSpec)); a2_7 = g7s * a1_7; a3_7 = g7s * a2_7;
v3 = monoIn - sp_ic2_7; v1 = a1_7 * sp_ic1_7 + a2_7 * v3; v2 = sp_ic2_7 + a2_7 * sp_ic1_7 + a3_7 * v3;
sp_ic1_7 = 2.0 * v1 - sp_ic1_7; sp_ic2_7 = 2.0 * v2 - sp_ic2_7;
sp_env_7 = max(abs(kSpec * v1), sp_env_7 * envDecay);

// Band 8: 840 Hz
g8s = calc_tan_g(840.0, sr); a1_8 = 1.0 / (1.0 + g8s * (g8s + kSpec)); a2_8 = g8s * a1_8; a3_8 = g8s * a2_8;
v3 = monoIn - sp_ic2_8; v1 = a1_8 * sp_ic1_8 + a2_8 * v3; v2 = sp_ic2_8 + a2_8 * sp_ic1_8 + a3_8 * v3;
sp_ic1_8 = 2.0 * v1 - sp_ic1_8; sp_ic2_8 = 2.0 * v2 - sp_ic2_8;
sp_env_8 = max(abs(kSpec * v1), sp_env_8 * envDecay);

// Band 9: 1260 Hz
g9s = calc_tan_g(1260.0, sr); a1_9 = 1.0 / (1.0 + g9s * (g9s + kSpec)); a2_9 = g9s * a1_9; a3_9 = g9s * a2_9;
v3 = monoIn - sp_ic2_9; v1 = a1_9 * sp_ic1_9 + a2_9 * v3; v2 = sp_ic2_9 + a2_9 * sp_ic1_9 + a3_9 * v3;
sp_ic1_9 = 2.0 * v1 - sp_ic1_9; sp_ic2_9 = 2.0 * v2 - sp_ic2_9;
sp_env_9 = max(abs(kSpec * v1), sp_env_9 * envDecay);

// Band 10: 1900 Hz
g10s = calc_tan_g(1900.0, sr); a1_10 = 1.0 / (1.0 + g10s * (g10s + kSpec)); a2_10 = g10s * a1_10; a3_10 = g10s * a2_10;
v3 = monoIn - sp_ic2_10; v1 = a1_10 * sp_ic1_10 + a2_10 * v3; v2 = sp_ic2_10 + a2_10 * sp_ic1_10 + a3_10 * v3;
sp_ic1_10 = 2.0 * v1 - sp_ic1_10; sp_ic2_10 = 2.0 * v2 - sp_ic2_10;
sp_env_10 = max(abs(kSpec * v1), sp_env_10 * envDecay);

// Band 11: 2850 Hz
g11s = calc_tan_g(2850.0, sr); a1_11 = 1.0 / (1.0 + g11s * (g11s + kSpec)); a2_11 = g11s * a1_11; a3_11 = g11s * a2_11;
v3 = monoIn - sp_ic2_11; v1 = a1_11 * sp_ic1_11 + a2_11 * v3; v2 = sp_ic2_11 + a2_11 * sp_ic1_11 + a3_11 * v3;
sp_ic1_11 = 2.0 * v1 - sp_ic1_11; sp_ic2_11 = 2.0 * v2 - sp_ic2_11;
sp_env_11 = max(abs(kSpec * v1), sp_env_11 * envDecay);

// Band 12: 4300 Hz
g12s = calc_tan_g(4300.0, sr); a1_12 = 1.0 / (1.0 + g12s * (g12s + kSpec)); a2_12 = g12s * a1_12; a3_12 = g12s * a2_12;
v3 = monoIn - sp_ic2_12; v1 = a1_12 * sp_ic1_12 + a2_12 * v3; v2 = sp_ic2_12 + a2_12 * sp_ic1_12 + a3_12 * v3;
sp_ic1_12 = 2.0 * v1 - sp_ic1_12; sp_ic2_12 = 2.0 * v2 - sp_ic2_12;
sp_env_12 = max(abs(kSpec * v1), sp_env_12 * envDecay);

// Band 13: 6450 Hz
g13s = calc_tan_g(6450.0, sr); a1_13 = 1.0 / (1.0 + g13s * (g13s + kSpec)); a2_13 = g13s * a1_13; a3_13 = g13s * a2_13;
v3 = monoIn - sp_ic2_13; v1 = a1_13 * sp_ic1_13 + a2_13 * v3; v2 = sp_ic2_13 + a2_13 * sp_ic1_13 + a3_13 * v3;
sp_ic1_13 = 2.0 * v1 - sp_ic1_13; sp_ic2_13 = 2.0 * v2 - sp_ic2_13;
sp_env_13 = max(abs(kSpec * v1), sp_env_13 * envDecay);

// Band 14: 9700 Hz
g14s = calc_tan_g(9700.0, sr); a1_14 = 1.0 / (1.0 + g14s * (g14s + kSpec)); a2_14 = g14s * a1_14; a3_14 = g14s * a2_14;
v3 = monoIn - sp_ic2_14; v1 = a1_14 * sp_ic1_14 + a2_14 * v3; v2 = sp_ic2_14 + a2_14 * sp_ic1_14 + a3_14 * v3;
sp_ic1_14 = 2.0 * v1 - sp_ic1_14; sp_ic2_14 = 2.0 * v2 - sp_ic2_14;
sp_env_14 = max(abs(kSpec * v1), sp_env_14 * envDecay);

// Band 15: 14500 Hz
g15s = calc_tan_g(14500.0, sr); a1_15 = 1.0 / (1.0 + g15s * (g15s + kSpec)); a2_15 = g15s * a1_15; a3_15 = g15s * a2_15;
v3 = monoIn - sp_ic2_15; v1 = a1_15 * sp_ic1_15 + a2_15 * v3; v2 = sp_ic2_15 + a2_15 * sp_ic1_15 + a3_15 * v3;
sp_ic1_15 = 2.0 * v1 - sp_ic1_15; sp_ic2_15 = 2.0 * v2 - sp_ic2_15;
sp_env_15 = max(abs(kSpec * v1), sp_env_15 * envDecay);

// Per-band & I/O peak tracking
pkB1 = max(0.5 * (abs(band1L) + abs(band1R)), pkB1 * envDecay);
pkB2 = max(0.5 * (abs(band2L) + abs(band2R)), pkB2 * envDecay);
pkB3 = max(0.5 * (abs(band3L) + abs(band3R)), pkB3 * envDecay);
pkB4 = max(0.5 * (abs(band4L) + abs(band4R)), pkB4 * envDecay);
pkIn = max(max(abs(xL), abs(xR)), pkIn * envDecay);
pkOut = max(max(abs(outL), abs(outR)), pkOut * envDecay);

// Write mono input into 8192-sample circular audio ring buffer (indices 32..8223) for 8192-block FFT spectrogram
poke(scope, monoIn, 32.0 + ringPos, 0, 0);
ringPos = mod(ringPos + 1.0, 8192.0);

scopeCnt = scopeCnt + 1.0;
if (scopeCnt >= 64.0) {
    scopeCnt = 0.0;
    scopeBeat = mod(scopeBeat + 1.0, 1024.0);
    poke(scope, sp_env_0, 0, 0, 0);
    poke(scope, sp_env_1, 1, 0, 0);
    poke(scope, sp_env_2, 2, 0, 0);
    poke(scope, sp_env_3, 3, 0, 0);
    poke(scope, sp_env_4, 4, 0, 0);
    poke(scope, sp_env_5, 5, 0, 0);
    poke(scope, sp_env_6, 6, 0, 0);
    poke(scope, sp_env_7, 7, 0, 0);
    poke(scope, sp_env_8, 8, 0, 0);
    poke(scope, sp_env_9, 9, 0, 0);
    poke(scope, sp_env_10, 10, 0, 0);
    poke(scope, sp_env_11, 11, 0, 0);
    poke(scope, sp_env_12, 12, 0, 0);
    poke(scope, sp_env_13, 13, 0, 0);
    poke(scope, sp_env_14, 14, 0, 0);
    poke(scope, sp_env_15, 15, 0, 0);
    poke(scope, pkB1, 16, 0, 0);
    poke(scope, pkB2, 17, 0, 0);
    poke(scope, pkB3, 18, 0, 0);
    poke(scope, pkB4, 19, 0, 0);
    poke(scope, pkIn, 20, 0, 0);
    poke(scope, pkOut, 21, 0, 0);
    poke(scope, maskInt, 22, 0, 0);
    poke(scope, scopeBeat, 23, 0, 0);
    poke(scope, ringPos, 24, 0, 0);
    poke(scope, sr, 25, 0, 0);
}
