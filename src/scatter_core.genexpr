// Scatter core — DSP for the Scatter Max for Live effect (one-shot drum-hit timbre randomizer).
//
// DEFERRED DSP (AGENTS 1d, Fill pattern) — what face/build must do, exactly as for Fill:
//   The device ships WITHOUT gen~. scripts/build_scatter.py reads this file, prepends nothing
//   (this core is self-contained), hashes the result, and inlines it into src/scatter_ui.js.
//   At load, the face (init_dsp via live.thisdevice) writes the inlined core to
//   /tmp/scatter_core_<hash>.gendsp (a gen~ patcher JSON whose codebox holds this code),
//   then creates gen~ on the existing hub: hub inlet 1 = stereo audio in (plugin~),
//   hub inlet 2 = face messages (sens, seed, master, mix, splitmode, lock, reroll and the
//   macro pairs snap/snapr ... ring/ringr, all /100 except seed, splitmode, lock, reroll),
//   hub outlets 1-2 = stereo audio out (plugout~). The face resends all parameters until the
//   gen~ answers alive, and shows the DSP loading... / DSP failed pill meanwhile.
//   The patcher also owns buffer~ #0-scatterscope (this code refers to it by the plain name
//   scatterscope; #0 is substituted by Max when the .gendsp is instantiated, as in transplit).
//   Reported latency is 5120 samples in BOTH split modes and the patcher must declare
//   "latency": 5120; the dry is delayed by exactly 5120 below (fill_core pattern: write
//   first, then read(5120) on a Delay(8192)) and the wet totals 5120 too: 1023 of feed
//   alignment (the STFT latency, padded into BOTH modes; see Signal flow) + read(4097).
//
// Draw math mirrors src/scatter_config.js bit-for-bit: stream seed from (seed, hit),
// LCG state = (state * 1664525 + 1013904223) % 4294967296, u = state / 4294967296, consumed
// first by the 8 macros (snap, body, metal, motion, space, grit, warp, ring), then by the 21
// underlying parameters in SCATTER_UNDERLYING order. Macro draw:
// clamp(centre + (u*2-1) * depth * master, 0, 100), centre/depth 0..100, master 0..1;
// depth 0 or master 0 holds the centre. Underlying draw: drawn macro mapped to the parameter
// centre (log mapping where scatter_config marks log), offset by
// (u*2-1) * spread * (hi-lo) * (depth/100) * master, clamped to [lo, hi].
// Ring centre maps exponentially to 0.05 * (2.0/0.05)^(m/100) seconds, hard cap 2.0 s.
//
// Onset: fast/slow envelope comparison (scatterOnset): Sens 100% fires on any rise over the
// slow envelope, Sens 0% needs +12 dB, 40 ms holdoff. On a hit (or a reroll message) with
// Lock = 0 the hit counter increments and a new draw is taken; Lock = 1 keeps the draw (the
// tail envelope still re-triggers). Drawn values glide ~10 ms (one-pole) to their targets.
//
// Signal flow: input -> split -> Transient chain + Tail chain -> sum -> Mix (dry delayed 5120).
//   Envelope split: gT = transient envelope (attack portion), gL = 1 - gT (complementary).
//   Spectral split (splitmode = 1): the packed-stereo STFT below (FFT 1024, hop 256, Hann;
//   re = L, im = R in one scFft, the spectral_split_lib pattern, reimplemented here because
//   this core is self-contained) classifies every bin transplit-style (scSpecFrame: Perc
//   evidence = smoothstep of 20*log10(A/H) over 4.5..10 dB at neutral bias, A the +-2-bin
//   RMS Mid magnitude, H its 14 ms rise / 40 ms fall history; transient decay 8 hops; tone
//   leak with Smoothing 1.5 hops) into a tone amount q in 0..1 per bin. Two masked copies
//   of the same spectrum (maskT = 1 - q, maskL = q; maskT + maskL = 1 per bin exactly, so
//   the pair has no holes and no double-counting) go through dual inverse FFTs and Hann
//   overlap-add (synthesis window scaled by 2/3: the hop-256 overlap sum of Hann^2 is 1.5,
//   so a flat mask pair reconstructs the input) delayed by the STFT latency 1023.
//   Feed alignment: BOTH feed pairs reach the chains delayed by exactly 1023 (the envelope
//   products take the ring-oldest input times the gT delayed by gDly), splitmode crossfades
//   between them over ~15 ms (snapped at the ends, so a steady mode is a pure feed), and
//   the wet Delay reads 4097: total wet latency 1023 + 4097 = 5120 in both modes, dry 5120.
//   The onset trigger (draw + Ring restart) is applied 1023 after detection, so draw,
//   glide and Ring timing against the audio are identical in both modes.
//   Transient chain: drive (Snap), snap highpass, short phaser, pitch blip. No ring.
//   Tail chain: body resonator (Body), tuned feedback-comb resonator bank (Metal), grit
//   saturation, modulated delay (Motion), 4-comb algorithmic reverb (Space), frequency
//   shifter + pitch/granular tap (Warp); the whole tail is multiplied by the Ring envelope.
//
// Telemetry: Buffer scatterscope slots 0 in peak, 1 out peak, 2 transient envelope,
// 3 hit count, 4 tail envelope, 5 frame counter, 6..21 sixteen display energies.
//
// GenExpr notes: poke() and Delay.write() are used as bare statements (the fill_core /
// spectral-lib pattern); returns of user helper functions are always accumulated; no GenExpr
// operator names are used as identifiers.

// ---------- pure helpers (functions precede all declarations) ----------

scClamp(x, lo, hi) {
    return max(lo, min(hi, x));
}

scStreamSeed(seed, hit) {
    s = (floor(abs(seed)) % 100000) * 2654435761;
    h = (floor(abs(hit)) % 100000) + 1;
    return (s + h * 2246822519) % 4294967296;
}

scStreamNext(state) {
    return (state * 1664525 + 1013904223) % 4294967296;
}

scCentre(idx, m) {
    outv = 0;
    if (idx == 0) { outv = 1 + (m / 100) * 3; }
    if (idx == 1) { outv = 800 * pow(14000 / 800, m / 100); }
    if (idx == 2) { outv = (m / 100) * 0.8; }
    if (idx == 3) { outv = (m / 100) * 12; }
    if (idx == 4) { outv = 60 * pow(420 / 60, m / 100); }
    if (idx == 5) { outv = 0.05 + (m / 100) * 0.85; }
    if (idx == 6) { outv = m / 100; }
    if (idx == 7) { outv = 800 * pow(9000 / 800, m / 100); }
    if (idx == 8) { outv = 0.1 + (m / 100) * 2.4; }
    if (idx == 9) { outv = m / 100; }
    if (idx == 10) { outv = 40 + (m / 100) * 440; }
    if (idx == 11) { outv = 0.05 * pow(7 / 0.05, m / 100); }
    if (idx == 12) { outv = m / 100; }
    if (idx == 13) { outv = 0.25 + (m / 100) * 4.75; }
    if (idx == 14) { outv = 0.2 + (m / 100) * 0.8; }
    if (idx == 15) { outv = m / 100; }
    if (idx == 16) { outv = (m / 100) * 24; }
    if (idx == 17) { outv = (m / 50) - 1; }
    if (idx == 18) { outv = ((m / 50) - 1) * 300; }
    if (idx == 19) { outv = ((m / 50) - 1) * 6; }
    if (idx == 20) { outv = 0.05 * pow(2.0 / 0.05, m / 100); }
    return outv;
}

scLo(idx) {
    v = 0;
    if (idx == 0) { v = 1; } if (idx == 1) { v = 800; } if (idx == 2) { v = 0; } if (idx == 3) { v = -12; }
    if (idx == 4) { v = 60; } if (idx == 5) { v = 0.05; } if (idx == 6) { v = 0; } if (idx == 7) { v = 800; }
    if (idx == 8) { v = 0.1; } if (idx == 9) { v = 0; } if (idx == 10) { v = 40; } if (idx == 11) { v = 0.05; }
    if (idx == 12) { v = 0; } if (idx == 13) { v = 0.25; } if (idx == 14) { v = 0.2; } if (idx == 15) { v = 0; }
    if (idx == 16) { v = 0; } if (idx == 17) { v = -1; } if (idx == 18) { v = -600; } if (idx == 19) { v = -12; }
    if (idx == 20) { v = 0.05; }
    return v;
}

scHi(idx) {
    v = 1;
    if (idx == 0) { v = 4; } if (idx == 1) { v = 14000; } if (idx == 2) { v = 0.8; } if (idx == 3) { v = 12; }
    if (idx == 4) { v = 420; } if (idx == 5) { v = 0.9; } if (idx == 6) { v = 1; } if (idx == 7) { v = 9000; }
    if (idx == 8) { v = 2.5; } if (idx == 9) { v = 1; } if (idx == 10) { v = 480; } if (idx == 11) { v = 7; }
    if (idx == 12) { v = 1; } if (idx == 13) { v = 5; } if (idx == 14) { v = 1; } if (idx == 15) { v = 1; }
    if (idx == 16) { v = 24; } if (idx == 17) { v = 1; } if (idx == 18) { v = 600; } if (idx == 19) { v = 12; }
    if (idx == 20) { v = 2.0; }
    return v;
}

scSpread(idx) {
    v = 0.25;
    if (idx == 0) { v = 0.20; } if (idx == 1) { v = 0.25; } if (idx == 2) { v = 0.25; } if (idx == 3) { v = 0.30; }
    if (idx == 4) { v = 0.20; } if (idx == 5) { v = 0.25; } if (idx == 6) { v = 0.20; } if (idx == 7) { v = 0.25; }
    if (idx == 8) { v = 0.25; } if (idx == 9) { v = 0.20; } if (idx == 10) { v = 0.30; } if (idx == 11) { v = 0.30; }
    if (idx == 12) { v = 0.25; } if (idx == 13) { v = 0.25; } if (idx == 14) { v = 0.25; } if (idx == 15) { v = 0.20; }
    if (idx == 16) { v = 0.25; } if (idx == 17) { v = 0.25; } if (idx == 18) { v = 0.30; } if (idx == 19) { v = 0.30; }
    if (idx == 20) { v = 0.15; }
    return v;
}

scMacroOf(idx) {
    v = 0;
    if (idx >= 4 && idx <= 6) { v = 1; } if (idx >= 7 && idx <= 9) { v = 2; }
    if (idx >= 10 && idx <= 12) { v = 3; } if (idx >= 13 && idx <= 15) { v = 4; }
    if (idx >= 16 && idx <= 17) { v = 5; } if (idx >= 18 && idx <= 19) { v = 6; }
    if (idx == 20) { v = 7; }
    return v;
}

// One draw: fills Data tgt (targets at 0..20, drawn macros parked at 32..39) for (seedVal, hit).
// cfg is Data (8 x 2: col 0 centre 0..100, col 1 depth 0..100). Returns 1 (result is consumed).
scDraw(cfg, tgt, seedVal, hit, master01) {
    st = scStreamSeed(seedVal, hit);
    for (mi = 0; mi < 8; mi += 1) {
        st = scStreamNext(st);
        u = st / 4294967296;
        cen = peek(cfg, mi, 0);
        dep = peek(cfg, mi, 1);
        dm = (dep == 0 || master01 == 0) ? cen : scClamp(cen + (u * 2 - 1) * dep * master01, 0, 100);
        poke(tgt, dm, mi + 32, 0);
    }
    for (pi = 0; pi < 21; pi += 1) {
        st = scStreamNext(st);
        u = st / 4294967296;
        mo = scMacroOf(pi);
        dep = peek(cfg, mo, 1);
        base = scCentre(pi, peek(tgt, mo + 32, 0));
        off = (u * 2 - 1) * scSpread(pi) * (scHi(pi) - scLo(pi)) * (dep / 100) * master01;
        val = (dep == 0 || master01 == 0) ? base : scClamp(base + off, scLo(pi), scHi(pi));
        poke(tgt, val, pi, 0);
    }
    poke(tgt, scClamp(peek(tgt, 20, 0), 0.05, 2.0), 20, 0);
    return 1;
}

// Iterative radix-2 FFT over Data fx (1024 x 2: col 0 re, col 1 im). inv=1 scales by 1/1024.
scFft(fx, inv) {
    j = 0;
    for (i = 1; i < 1024; i += 1) {
        bit = 512;
        while (j >= bit) { j -= bit; bit = bit / 2; }
        j += bit;
        if (i < j) {
            tr = peek(fx, i, 0); ti = peek(fx, i, 1);
            poke(fx, peek(fx, j, 0), i, 0);
            poke(fx, peek(fx, j, 1), i, 1);
            poke(fx, tr, j, 0);
            poke(fx, ti, j, 1);
        }
    }
    len = 2;
    while (len <= 1024) {
        ang = (inv > 0.5 ? 6.283185307179586 : -6.283185307179586) / len;
        wpr = cos(ang); wpi = sin(ang);
        for (base = 0; base < 1024; base += len) {
            wr = 1; wi = 0;
            half = len / 2;
            for (k = 0; k < half; k += 1) {
                a = base + k; b = a + half;
                xr = peek(fx, b, 0); xi = peek(fx, b, 1);
                vr = xr * wr - xi * wi; vi = xr * wi + xi * wr;
                ur = peek(fx, a, 0); ui = peek(fx, a, 1);
                poke(fx, ur + vr, a, 0);
                poke(fx, ui + vi, a, 1);
                poke(fx, ur - vr, b, 0);
                poke(fx, ui - vi, b, 1);
                nwr = wr * wpr - wi * wpi; wi = wr * wpi + wi * wpr; wr = nwr;
            }
        }
        len = len * 2;
    }
    if (inv > 0.5) {
        for (i = 0; i < 1024; i += 1) {
            poke(fx, peek(fx, i, 0) / 1024, i, 0);
            poke(fx, peek(fx, i, 1) / 1024, i, 1);
        }
    }
    return 1;
}

// Smoothstep 0..1 (transplit ts_sm pattern, via scClamp).
scSm(x) {
    c = scClamp(x, 0, 1);
    return c * c * (3 - 2 * c);
}

// One spectral frame, called on a hop boundary AFTER scFft(fx, 0) has run on the packed
// spectrum fx (re = hann * L, im = hann * R, oldest first; head = ring slot of the oldest
// sample of the frame). Steps: (1) Mid magnitudes (Mid = (XL + XR) / 2 out of the packed
// spectrum, the same quantities the old mono analysis produced) -> telemetry smoothing in
// mag (col 0 smoothed magnitude, col 1 display energy), raw magnitudes parked in tx rows
// 0..512 col 0 as scratch; (2) transplit-style per-bin classification into msk (col 0
// history H, col 1 A prev, col 2 tx transient amount, col 3 q tone amount), neutral bias:
// Perc evidence ev = scSm((20*log10(A/H) - 4.5) / 5.5), A the +-2-bin RMS Mid magnitude,
// H following A with 14 ms rise / 40 ms fall per hop; tx = max(ev, txPrev * exp(-1/8));
// q = max(1 - tx, min(1, qPrev * exp(-1/1.5) * Aprev / A)); age < 0.5 (first frame) seeds
// H = A, tx = 0, q = 1, Aprev = A; (3) masked copies tx = fx * (1 - q) and lx = fx * q
// (Hermitian: bin 1024-k takes bin k mask), so maskT + maskL = 1 per bin exactly and the
// two resyntheses sum back to the input; (4) dual inverse FFT (scFft inv, 1/1024 scaling
// inside) and Hann overlap-add into ola (0 transient L, 1 transient R, 2 tail L, 3 tail R)
// with the synthesis window scaled by 2/3: at hop 256 the overlap sum of Hann^2 is 1.5,
// so 1.5 * (2/3) = 1 and a flat mask pair reconstructs the input at a delay of 1023.
// Returns the accumulated scFft results (the caller consumes the return).
scSpecFrame(fx, tx, lx, mag, msk, ola, win, head, age, sr) {
    rsK = 1 - exp(-256 / (sr * 0.014));
    flK = 1 - exp(-256 / (sr * 0.040));
    dk = exp(-1 / 8);
    dtn = exp(-1 / 1.5);
    for (k = 0; k <= 512; k += 1) {
        k2 = (k == 0) ? 0 : 1024 - k;
        ar = peek(fx, k, 0); ai = peek(fx, k, 1);
        br = peek(fx, k2, 0); bi = peek(fx, k2, 1);
        xlr = (ar + br) * 0.5; xli = (ai - bi) * 0.5;
        xrr = (ai + bi) * 0.5; xri = (br - ar) * 0.5;
        mr = (xlr + xrr) * 0.5; mi = (xli + xri) * 0.5;
        poke(tx, sqrt(mr * mr + mi * mi), k, 0);
    }
    for (k = 0; k <= 512; k += 1) {
        sq = 0;
        for (j = -2; j <= 2; j += 1) {
            kk = scClamp(k + j, 0, 512);
            mv = peek(tx, kk, 0);
            sq += mv * mv;
        }
        av = sqrt(sq * 0.2);
        mgv = peek(tx, k, 0);
        smv = peek(mag, k, 0) + (mgv - peek(mag, k, 0)) * 0.35;
        poke(mag, smv, k, 0);
        poke(mag, scClamp(smv * 4, 0, 1), k, 1);
        hh = (age < 0.5) ? av : peek(msk, k, 0);
        dbv = 8.685889638065035 * log((av + 1e-9) / (hh + 1e-9));
        ev = (age < 0.5) ? 0 : scSm((dbv - 4.5) / 5.5);
        poke(msk, hh + (av - hh) * (av > hh ? rsK : flK), k, 0);
        txp = (age < 0.5) ? 0 : peek(msk, k, 2);
        qxp = (age < 0.5) ? 1 : peek(msk, k, 3);
        app = (age < 0.5) ? av : peek(msk, k, 1);
        txn = max(ev, txp * dk);
        leak = min(1, qxp * dtn * app / (av + 1e-9));
        qxn = scClamp(max(1 - txn, leak), 0, 1);
        poke(msk, txn, k, 2);
        poke(msk, qxn, k, 3);
        poke(msk, av, k, 1);
    }
    for (k = 0; k <= 512; k += 1) {
        q = peek(msk, k, 3);
        mt = 1 - q;
        poke(tx, peek(fx, k, 0) * mt, k, 0);
        poke(tx, peek(fx, k, 1) * mt, k, 1);
        poke(lx, peek(fx, k, 0) * q, k, 0);
        poke(lx, peek(fx, k, 1) * q, k, 1);
    }
    for (k = 1; k < 512; k += 1) {
        q = peek(msk, k, 3);
        mt = 1 - q;
        poke(tx, peek(fx, 1024 - k, 0) * mt, 1024 - k, 0);
        poke(tx, peek(fx, 1024 - k, 1) * mt, 1024 - k, 1);
        poke(lx, peek(fx, 1024 - k, 0) * q, 1024 - k, 0);
        poke(lx, peek(fx, 1024 - k, 1) * q, 1024 - k, 1);
    }
    acc2 = scFft(tx, 1);
    acc2 += scFft(lx, 1);
    for (i = 0; i < 1024; i += 1) {
        j = head + i;
        if (j >= 1024) { j -= 1024; }
        w = peek(win, i, 0) * 0.6666666666666666;
        poke(ola, peek(ola, j, 0) + peek(tx, i, 0) * w, j, 0);
        poke(ola, peek(ola, j, 1) + peek(tx, i, 1) * w, j, 1);
        poke(ola, peek(ola, j, 2) + peek(lx, i, 0) * w, j, 2);
        poke(ola, peek(ola, j, 3) + peek(lx, i, 1) * w, j, 3);
    }
    return acc2;
}

// ---------- declarations ----------

Buffer scope("scatterscope");
Data sfx(1024, 2);
Data smag(513, 2);
Data scfg(8, 2);
Data stgt(64, 1);
Data sdel(65536, 2);
Data sres(8192, 4);
Data swin(1024, 1);
Data sring(1024, 2);
Data stx(1024, 2);
Data slx(1024, 2);
Data smsk(513, 4);
Data sola(1024, 4);

Param sens(0.45);
Param seed(0);
Param master(0.5);
Param mix(1);
Param splitmode(0);
Param lock(0);
Param reroll(0);
Param snap(0.5); Param snapr(0.25);
Param body(0.5); Param bodyr(0.25);
Param metal(0.3); Param metalr(0.25);
Param motion(0.35); Param motionr(0.25);
Param space(0.3); Param spacer(0.20);
Param grit(0.2); Param gritr(0.15);
Param warp(0.25); Param warpr(0.20);
Param ring(0.4); Param ringr(0.20);

History hitH(0);
History tailEnvH(0);
History fastH(0);
History slowH(0);
History sinceH(1000000);
History prevRerollH(0);
History dlyHeadH(0);
History resHeadH(0);
History frameH(0);
History hopH(0);
History phH(0);
History bodyH(0); History bodyLpH(0);
History rv1H(0); History rv2H(0); History rv3H(0); History rv4H(0);
History hpL(0); History hpR(0);
History inPkH(0); History outPkH(0);
History initH(0);
History fftAccH(0);
History anaHeadH(0);
History pendH(0);
History xfH(0);

Delay dryLd(8192);
Delay dryRd(8192);
Delay wetLd(8192);
Delay wetRd(8192);
Delay gDly(2048);

// ---------- per-sample main ----------

acc = 0;
if (initH < 0.5) {
    for (wi = 0; wi < 1024; wi += 1) {
        poke(swin, 0.5 - 0.5 * cos(6.283185307179586 * wi / 1024), wi, 0);
    }
    initH = 1;
}

poke(scfg, snap * 100, 0, 0); poke(scfg, snapr * 100, 0, 1);
poke(scfg, body * 100, 1, 0); poke(scfg, bodyr * 100, 1, 1);
poke(scfg, metal * 100, 2, 0); poke(scfg, metalr * 100, 2, 1);
poke(scfg, motion * 100, 3, 0); poke(scfg, motionr * 100, 3, 1);
poke(scfg, space * 100, 4, 0); poke(scfg, spacer * 100, 4, 1);
poke(scfg, grit * 100, 5, 0); poke(scfg, gritr * 100, 5, 1);
poke(scfg, warp * 100, 6, 0); poke(scfg, warpr * 100, 6, 1);
poke(scfg, ring * 100, 7, 0); poke(scfg, ringr * 100, 7, 1);

xl = in1; xr = in2;
mono = (xl + xr) * 0.5;
aMono = abs(mono);
fastH = fastH + (aMono - fastH) * (aMono > fastH ? 0.9 : 0.05);
slowH = slowH + (aMono - slowH) * 0.002;
sinceH = sinceH + 1;
holdN = max(1, round(0.040 * samplerate));
ratio = pow(10, ((1 - scClamp(sens, 0, 1)) * 12) / 20);
onset = (sinceH >= holdN && fastH > 0.00001 && fastH > slowH * ratio) ? 1 : 0;
rerollEdge = (reroll > 0.5 && prevRerollH < 0.5) ? 1 : 0;
prevRerollH = reroll;
trig = max(onset, rerollEdge);
trigFire = 0;
if (pendH > 0) {
    pendH = pendH - 1;
    if (pendH <= 0) { trigFire = 1; }
}
if (trig > 0.5) {
    sinceH = 0;
    pendH = 1023;
}
if (trigFire > 0.5) {
    tailEnvH = 1;
    if (lock < 0.5) {
        hitH = hitH + 1;
        acc += scDraw(scfg, stgt, seed, hitH, scClamp(master, 0, 1));
    }
}
if (hitH < 0.5 && initH > 0.5) {
    acc += scDraw(scfg, stgt, seed, 1, scClamp(master, 0, 1));
    hitH = 0;
    initH = 2;
}

glide = 1 - exp(-1 / (0.010 * samplerate));
for (gi = 0; gi < 21; gi += 1) {
    cur = peek(stgt, gi + 40, 0);
    cur = cur + (peek(stgt, gi, 0) - cur) * glide;
    poke(stgt, cur, gi + 40, 0);
}
pDrive = peek(stgt, 40, 0); pFilHz = peek(stgt, 41, 0); pPhMix = peek(stgt, 42, 0); pBlip = peek(stgt, 43, 0);
pBodyHz = peek(stgt, 44, 0); pBodyDec = peek(stgt, 45, 0); pBodyMix = peek(stgt, 46, 0);
pMetHz = peek(stgt, 47, 0); pMetDec = peek(stgt, 48, 0); pMetMix = peek(stgt, 49, 0);
pDelMs = peek(stgt, 50, 0); pRateHz = peek(stgt, 51, 0); pModDep = peek(stgt, 52, 0);
pSpDec = peek(stgt, 53, 0); pSpSize = peek(stgt, 54, 0); pSpMix = peek(stgt, 55, 0);
pGritDb = peek(stgt, 56, 0); pGritTone = peek(stgt, 57, 0);
pShiftHz = peek(stgt, 58, 0); pPitchSt = peek(stgt, 59, 0); pRingS = peek(stgt, 60, 0);
if (pRingS < 0.05) { pRingS = 0.05; }

tailEnvH = tailEnvH * exp(-1 / (pRingS * 0.35 * samplerate));

// Spectral engine (always on, both modes): ring the stereo input; on each hop boundary
// pack the last 1024 samples (oldest first, Hann) as re = L, im = R into sfx, forward
// FFT, then scSpecFrame (Mid telemetry magnitudes + masks + dual masked IFFT + OLA).
// After the frame block, the accumulators at the ring head hold the finished resynthesis
// of the input sample from 1023 ago (read and clear, the ss_out pattern).
poke(sring, xl, anaHeadH, 0);
poke(sring, xr, anaHeadH, 1);
anaHeadH = (anaHeadH + 1) % 1024;
hopH = hopH + 1;
if (hopH >= 256) {
    hopH = 0;
    frameH = frameH + 1;
    for (fi = 0; fi < 1024; fi += 1) {
        ri = (anaHeadH + fi) % 1024;
        poke(sfx, peek(sring, ri, 0) * peek(swin, fi, 0), fi, 0);
        poke(sfx, peek(sring, ri, 1) * peek(swin, fi, 0), fi, 1);
    }
    fftAccH = scFft(sfx, 0);
    fftAccH += scSpecFrame(sfx, stx, slx, smag, smsk, sola, swin, anaHeadH, frameH - 1, samplerate);
}
spTL = peek(sola, anaHeadH, 0); poke(sola, 0, anaHeadH, 0);
spTR = peek(sola, anaHeadH, 1); poke(sola, 0, anaHeadH, 1);
spLL = peek(sola, anaHeadH, 2); poke(sola, 0, anaHeadH, 2);
spLR = peek(sola, anaHeadH, 3); poke(sola, 0, anaHeadH, 3);

gT = scClamp(fastH * 2.2, 0, 1);
gL = 1 - gT;

// Feed alignment + mode crossfade: the envelope products are delayed by the same 1023
// as the STFT path (ring-oldest input, gain through gDly), so both modes reach the
// chains time-aligned; splitmode crossfades the feeds over ~15 ms (snapped at the ends,
// so a steady mode is one pure feed, never a blend).
gDly.write(gT);
gTd = gDly.read(1023);
envL = peek(sring, anaHeadH, 0);
envR = peek(sring, anaHeadH, 1);
envM = (envL + envR) * 0.5;
xfTgt = (splitmode > 0.5) ? 1 : 0;
xfH = xfH + (xfTgt - xfH) * (1 - exp(-1 / (0.015 * samplerate)));
if (abs(xfTgt - xfH) < 0.0001) { xfH = xfTgt; }
feedTL = envL * gTd * (1 - xfH) + spTL * xfH;
feedTR = envR * gTd * (1 - xfH) + spTR * xfH;
feedLM = envM * (1 - gTd) * (1 - xfH) + (spLL + spLR) * 0.5 * xfH;

// Transient chain (no ring).
tInL = feedTL; tInR = feedTR;
drv = max(0.05, pDrive);
tDrL = (tInL * drv) / (1 + abs(tInL * drv));
tDrR = (tInR * drv) / (1 + abs(tInR * drv));
fcHp = scClamp(pFilHz / samplerate, 0.001, 0.45);
hpL = hpL + (tDrL - hpL) * fcHp;
hpR = hpR + (tDrR - hpR) * fcHp;
tHpL = tDrL - hpL; tHpR = tDrR - hpR;
phH = phH + 6.283185307179586 * 0.7 / samplerate;
phMod = 0.5 + 0.5 * sin(phH);
head = dlyHeadH;
poke(sdel, tHpL, head, 0);
poke(sdel, tHpR, head, 1);
phTap = 24 + phMod * 60;
phL = peek(sdel, (head - round(phTap) + 65536) % 65536, 0);
phR = peek(sdel, (head - round(phTap) + 65536) % 65536, 1);
blipTap = max(4, 30 + scClamp(pBlip, -12, 12) * 4);
blL = peek(sdel, (head - round(blipTap) + 65536) % 65536, 0) * tailEnvH;
blR = peek(sdel, (head - round(blipTap) + 65536) % 65536, 1) * tailEnvH;
transL = tHpL * (1 - pPhMix * 0.5) + phL * pPhMix + blL * 0.4;
transR = tHpR * (1 - pPhMix * 0.5) + phR * pPhMix + blR * 0.4;

// Tail chain.
lMono = feedLM;
bodyCoef = scClamp(pBodyHz / samplerate, 0.001, 0.4);
bodyLpH = bodyLpH + (lMono - bodyLpH) * bodyCoef;
bodyFb = exp(-1 / (max(0.05, pBodyDec) * samplerate));
bodyH = bodyLpH + bodyH * bodyFb * 0.55;
bodySig = bodyH * pBodyMix + lMono * (1 - pBodyMix * 0.5);
per = round(scClamp(samplerate / max(50, pMetHz), 4, 4096));
metFb = scClamp(exp(-1 / (max(0.1, pMetDec) * samplerate)) * 1.6, 0, 0.92);
rh = resHeadH;
c0 = bodySig * 0.3 + peek(sres, (rh - per + 8192) % 8192, 0) * metFb;
c1 = bodySig * 0.3 + peek(sres, (rh - min(8191, round(per * 1.5)) + 8192) % 8192, 1) * metFb;
c2 = bodySig * 0.3 + peek(sres, (rh - min(8191, round(per * 2.02)) + 8192) % 8192, 2) * metFb;
c3 = bodySig * 0.3 + peek(sres, (rh - min(8191, round(per * 2.94)) + 8192) % 8192, 3) * metFb;
poke(sres, c0, rh, 0);
poke(sres, c1, rh, 1);
poke(sres, c2, rh, 2);
poke(sres, c3, rh, 3);
resHeadH = (rh + 1) % 8192;
metSig = (c0 + c1 + c2 + c3) * 0.25;
tailPre = bodySig * (1 - pMetMix * 0.6) + metSig * pMetMix;
gAmt = pow(10, pGritDb / 20);
gSat = (tailPre * gAmt) / (1 + abs(tailPre * gAmt));
tailPre = tailPre * 0.65 + gSat * 0.35 * (1 + pGritTone * 0.3);
modPh = phH * (pRateHz / 0.7);
delBase = scClamp(pDelMs * samplerate / 1000, 8, 20000);
delMod = delBase * (1 + pModDep * 0.25 * sin(modPh));
mdL = peek(sdel, (head - round(delMod) + 65536) % 65536, 0);
mdR = peek(sdel, (head - round(delMod * 1.003) + 65536) % 65536, 1);
rvFb = scClamp(exp(-1 / (max(0.25, pSpDec) * samplerate)) * (0.55 + pSpSize * 0.4), 0, 0.92);
rv1H = tailPre * 0.2 + rv1H * rvFb; rv2H = tailPre * 0.2 + rv2H * rvFb;
rv3H = tailPre * 0.2 + rv3H * rvFb; rv4H = tailPre * 0.2 + rv4H * rvFb;
rvSig = (rv1H + rv2H + rv3H + rv4H) * 0.25;
shPh = phH * (pShiftHz / 0.7);
shTap = peek(sdel, (head - 128 + 65536) % 65536, 0);
shSig = shTap * cos(shPh) * 0.3;
grTap = scClamp(delBase * (0.5 + 0.5 * pow(2, pPitchSt / 12)), 8, 20000);
grL = peek(sdel, (head - round(grTap) + 65536) % 65536, 0);
grR = peek(sdel, (head - round(grTap) + 65536) % 65536, 1);
tailL = (tailPre * 0.8 + mdL * 0.35 + rvSig * pSpMix + shSig + grL * 0.25) * tailEnvH;
tailR = (tailPre * 0.8 + mdR * 0.35 + rvSig * pSpMix + shSig + grR * 0.25) * tailEnvH;
dlyHeadH = (head + 1) % 65536;

wetRawL = transL + tailL;
wetRawR = transR + tailR;

// Mix, constant 5120 latency in both modes (write first, then read: fill_core pattern).
// Wet total = 1023 feed delay + 4097 here; dry = 5120 here, so wet and dry stay aligned.
wetLd.write(wetRawL);
wetRd.write(wetRawR);
dryLd.write(xl);
dryRd.write(xr);
wetDL = wetLd.read(4097);
wetDR = wetRd.read(4097);
dryDL = dryLd.read(5120);
dryDR = dryRd.read(5120);
mix01 = scClamp(mix, 0, 1);
outL = wetDL * mix01 + dryDL * (1 - mix01) + acc * 0 + fftAccH * 0;
outR = wetDR * mix01 + dryDR * (1 - mix01);

inPkH = max(inPkH * 0.999, aMono);
outPkH = max(outPkH * 0.999, abs((outL + outR) * 0.5));
poke(scope, inPkH, 0, 0);
poke(scope, outPkH, 1, 0);
poke(scope, gT, 2, 0);
poke(scope, hitH, 3, 0);
poke(scope, tailEnvH, 4, 0);
poke(scope, frameH, 5, 0);
for (ei = 0; ei < 16; ei += 1) {
    poke(scope, peek(smag, ei * 32, 1), 6 + ei, 0);
}

out1 = outL;
out2 = outR;
