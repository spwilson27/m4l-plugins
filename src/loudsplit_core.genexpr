// Loud Split core (appended after src/cepstrum_lib.genexpr + src/spectral_split_lib.genexpr at build time, so every
// library function sits ahead of everything here). Reference of the mask maths: src/loudsplit_config.js (lsMasks).
//
// Three channels, 1 Loud, 2 Mid, 3 Quiet. ONE instance per rack (the leader, see src/spectral_split_rack_main.genexpr) runs the analysis on the
// input, applies the masks of all three channels and publishes the channel signals in a ring; the other instances read their channel from
// it. A lone instance (outside a rack) computes only its own channel. The per-bin masks of the three channels sum to exactly 1 for every
// setting, so the chains sum back to the input delayed by the constant latency (5120 samples: 4096 + the host block, see the template).
//
// Per hop (n / 4) and bin k of the Mid spectrum amplitude A[k]:
//   lv  = 20 log10(max(A, 1e-6)) + Tilt * log2(f / 1 kHz)            instantaneous level, Tilt in dB/oct (analysis only)
//   lev = Relative ? lv - max_k lv : lv                                 (the loudest bin of the frame is 0 dB)
//   ls  = one-pole smoothing of lev in dB, per bin: coefficient 1 - exp(-1 / Rise) when lev > ls (louder), 1 - exp(-1 / Fall)
//         when lev < ls (softer); Rise / Fall are fractional blocks 0.13..125 (blocks = hops of N / 4 samples).
//   sH  = smoothstep((ls - (Hi - KneeHi / 2)) / KneeHi)  (Knee 1..24 dB)   Hi, Lo = absolute or relative thresholds,
//   sL  = same around Lo (clamped to <= Hi), sH is limited to sL so the masks stay non negative.
//   Quiet = 1 - sL,  Mid = sL - sH,  Loud = sH      (exact sum 1)
//   Mix     out = mixamt * wet + (1 - mixamt) * dry5120 * kdry, kdry = 1 (All / no rack) or 1/3 (one of the 3 chains), so the
//           rack sum is mixamt * wet + (1 - mixamt) * dry (dry delayed by the same 5120). mixamt = Mix / 100 (template).
//   Output  outsel 0 = sum of all masks (All; identity), 1 = Loud, 2 = Mid, 3 = Quiet.
//
// Data lsd(2049, 8) per-bin channels: 0 instantaneous tilted level (dB), 1 smoothed level ls, 2 Loud, 3 Mid, 4 Quiet (the rack template's
//   channel rows MKB + c, c = chain index - 1), 5 their sum (row MKB + K), 6 (bin 0 only) loudest bin level of the frame,
//   7 tilt table log2(f / 1 kHz) for the current n and sample rate (ls_tilttab).
//
// Telemetry buffer (bound by the face's `scope <name>` message, resent until the deferred gen~ runs), LS_SCOPE_SAMPS floats:
//   0..127 input (Mid) level per log column, 128..255 Quiet post, 256..383 Mid post, 384..511 Loud post (0..1 over -100..0 dB)
//   [written by the computing instance only],
//   512 frame counter, 513 samplerate, 514 N, 515 awake, 516 input peak, 517 mean Loud mask (amplitude weighted), 518 latency,
//   519 output selection, 520..529 rack scalars (template: computing, following, aligned, fallback, counter offset, underruns, lag, serve mask,
//   role, alive counter), 530 effective Higher Threshold (dB at 1 kHz; relative mode: frame max + value), 531 effective Lower
//   Threshold, 532 loudest bin level of the frame (dB).
//
// GenExpr rules: functions first, then Buffer / Data / Param / History / Delay, then statements. No identifier e<digit>,
// no Param or argument named after an operator (rise, fall, noise, bias ...).

ls_sm(x) {
	c = clip(x, 0, 1);
	return c * c * (3 - 2 * c);
}

// Tilt table for n and sr: lsd channel 7 = log2(f / 1 kHz), f = max(bin frequency, 20 Hz). Rebuilt only when n or the rate changes.
ls_tilttab(lsd, n, sr) {
	half = n * 0.5;
	for (k = 0; k <= half; k += 1) {
		f = max(k * sr / n, 20);
		lsd.poke(log(f * 0.001) * 1.4426950408889634, k, 7);
	}
	return half;
}

// One analysis frame: ms (Mid amplitude from ss_mid) -> masks in lsd channels 2 (Loud) / 3 (Mid) / 4 (Quiet) and their sum in 5.
// thi / tlo are the effective thresholds (absolute or relative), age = frames since the state was (re)started (0 resets).
ls_masks(ms, lsd, n, sr, relm, thi, tlo, khi, klo, riseb, fallb, tlt, age) {
	half = n * 0.5;
	lmax = -200;
	for (k = 0; k <= half; k += 1) {
		lv = 20 * log10(max(ms.peek(k, 0), 1e-6)) + tlt * lsd.peek(k, 7);
		lsd.poke(lv, k, 0);
		lmax = (k >= 1 && k < half) ? max(lmax, lv) : lmax;
	}
	lsd.poke(lmax, 0, 6);
	lo = min(tlo, thi);
	kdh = max(khi, 0.01);
	kdl = max(klo, 0.01);
	riseK = 1 - exp(-1 / clip(riseb, 0.13, 125));
	fallK = 1 - exp(-1 / clip(fallb, 0.13, 125));
	invKneeHi = 1 / kdh;
	invKneeLo = 1 / kdl;
	for (k = 0; k <= half; k += 1) {
		lev = relm > 0.5 ? lsd.peek(k, 0) - lmax : lsd.peek(k, 0);
		lev = max(lev, -150);
		prev = age < 0.5 ? lev : lsd.peek(k, 1);
		ls = prev + (lev - prev) * (lev > prev ? riseK : fallK);
		lsd.poke(ls, k, 1);
		sh = khi > 0.01 ? ls_sm((ls - (thi - khi * 0.5)) * invKneeHi) : (ls >= thi ? 1 : 0);
		sl = klo > 0.01 ? ls_sm((ls - (lo - klo * 0.5)) * invKneeLo) : (ls >= lo ? 1 : 0);
		sh = min(sh, sl);
		mq = 1 - sl;
		mm = sl - sh;
		lsd.poke(sh, k, 2);
		lsd.poke(mm, k, 3);
		lsd.poke(mq, k, 4);
		lsd.poke(mq + mm + sh, k, 5);
	}
	return half;
}

// Amplitude weighted mean of the Loud mask (telemetry).
ls_mean(ms, lsd, n) {
	half = n * 0.5;
	sw = 0;
	sm = 0;
	for (k = 1; k < half; k += 1) {
		a = ms.peek(k, 0);
		sw += a;
		sm += a * lsd.peek(k, 2);
	}
	return sw > 1e-9 ? sm / sw : 0;
}

//@SS_DECL

Buffer scope("loudsplitscope");

Data lsd(2049, 8);

Param thrhi(-30);
Param thrlo(-85);
Param rthrhi(-12);
Param rthrlo(-36);
Param kneehi(6);
Param kneelo(6);
Param relmode(0);
Param risebl(2);
Param fallbl(8);
Param tiltdb(0);

History lnN(0);
History lnSr(0);
History hiH(-30);
History loH(-85);
History khH(6);
History klH(6);
History relH(0);
History rsH(2);
History flH(8);
History tlH(0);

//@hook ctl
relH = relmode > 0.5 ? 1 : 0;
hiH = relH > 0.5 ? clip(rthrhi, -110, 0) : clip(thrhi, -110, 0);
loH = relH > 0.5 ? clip(rthrlo, -110, 0) : clip(thrlo, -110, 0);
khH = clip(kneehi, 1, 24);
klH = clip(kneelo, 1, 24);
rsH = clip(risebl, 0.13, 125);
flH = clip(fallbl, 0.13, 125);
tlH = clip(tiltdb, -6, 6);
sumOneH = 1;
if ((cmpH > 0.5 || nChg > 0.5) && (lnN != n || lnSr != sr)) {
	lnN = n;
	lnSr = sr;
	ls_tilttab(lsd, n, sr);
}
//@endhook

//@hook frame
ls_masks(ms, lsd, n, sr, relH, hiH, loH, khH, klH, rsH, flH, tlH, sAge);
//@endhook

//@hook tele
ss_cols(ms, 0, lsd, -1, cols, 0, n, sr, 128, 30, 20000);
ss_cols(ms, 0, lsd, 4, cols, 1, n, sr, 128, 30, 20000);
ss_cols(ms, 0, lsd, 3, cols, 2, n, sr, 128, 30, 20000);
ss_cols(ms, 0, lsd, 2, cols, 3, n, sr, 128, 30, 20000);
ss_tele(cols, scope, 128, 4, 0);
lmean = ls_mean(ms, lsd, n);
lmx = lsd.peek(0, 6);
thEff = relH > 0.5 ? lmx + hiH : hiH;
tlEff = relH > 0.5 ? lmx + min(loH, hiH) : min(loH, hiH);
poke(scope, lmean, 517, 0);
poke(scope, thEff, 530, 0);
poke(scope, tlEff, 531, 0);
poke(scope, lmx, 532, 0);
//@endhook

//@SS_MAIN
