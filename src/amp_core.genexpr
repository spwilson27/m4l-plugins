// Amp gen core template. src/amp_config.js ampGenCode() fills //@NAM_DECL / //@NAM_BODY with the
// generated network for one architecture, @@RF@@ with its receptive field and @@NLAYERS@@ with
// its layer count. The engine writes the weights into buffer~ ---ampw (bank offset `wbase`), the
// tone stack / cab biquads into ---ampcf (slot 50 = 1 once valid) and reads ---ampscope.
//
// Signal: Mono = (in1 + in2) / 2, Stereo = in1 and in2 -> Gain -> gate (linked) -> model (once per
// channel) -> Normalize -> DC block -> 10 biquads -> Volume -> Dry/Wet with the dry stereo input. Model or mode
// switch: fade out 128 samples, take the new bank / mode, stay muted for the receptive field (so the
// history is the new model's) and fade in.

Param indb(0);
Param gatedb(-100);
Param outdb(0);
Param mixamt(1);
Param stmode(0);
Param normdb(0);
Param wbase(-1);
Param mok(0);
Param tapraw(0);
Param testamp(0);
Buffer w("ampw");
Buffer cf("ampcf");
Buffer scope("ampscope");
History tpH(0);
History wcur(-1);
History scur(0);
History fadeG(0);
History muteN(0);
History gEnv(0);
History gGain(1);
History gOpen(0);
History dcx(0);
History dcy(0);
History dcx2(0);
History dcy2(0);
History quiet(0);
History inG(1);
History outG(1);
History nG(1);
History blk(0);
History frames(0);
History alive(0);
History pkIn(0);
History pkOut(0);
History pkNam(0);
History sIn(0);
History sOut(0);
History satS(0);
History satA(0);
History xyc(0);
History xyh(0);
History oh(0);
History tph(0);
Data bz(40);
Data nib(2);
Data nob(2);
Data yb(2);
Data lsm(48);
//@NAM_DECL

dry1 = in1;
dry2 = in2;
// Test hook (the Live check): a 110 Hz tone with two harmonics, plucked every 1.5 s, replaces the input.
tph = tph + 1 >= samplerate * 1.5 ? 0 : tph + 1;
tsig = (sin(tph * 6.283185307 * 110 / samplerate) + 0.4 * sin(tph * 6.283185307 * 220 / samplerate) + 0.2 * sin(tph * 6.283185307 * 330 / samplerate)) * exp(-tph / samplerate * 1.5);
xm = (in1 + in2) * 0.5;
xL = testamp > 0 ? testamp * tsig : (scur > 0.5 ? in1 : xm);
xR = testamp > 0 ? testamp * tsig : (scur > 0.5 ? in2 : xm);
inG = inG + (dbtoa(indb) - inG) * 0.002;
xg = xL * inG;
xgR = xR * inG;

// Noise gate on the input (after Gain, linked across channels): peak follower, 6 dB hysteresis, 1 ms open, 60 ms close.
ax = max(abs(xg), abs(xgR));
relc = exp(-1 / (0.03 * samplerate));
gEnv = ax > gEnv ? ax : gEnv * relc;
thr = dbtoa(gatedb);
gOpen = gEnv > thr ? 1 : (gEnv < thr * 0.5 ? 0 : gOpen);
gtgt = gatedb <= -99.9 ? 1 : gOpen;
gk = gtgt > gGain ? 1 - exp(-1 / (0.001 * samplerate)) : 1 - exp(-1 / (0.06 * samplerate));
gGain = gGain + (gtgt - gGain) * gk;

// Model switch.
nin = xg * gGain;
ninR = xgR * gGain;
tgt = wbase;
stp = stmode > 0.5 ? 1 : 0;
ninit = 0;
if ((tgt != wcur) || (stp != scur)) {
    fadeG = max(0, fadeG - 1 / 128);
    if (fadeG <= 0) {
        wcur = tgt;
        scur = stp;
        muteN = @@RF@@ + 512;
        ninit = 1;
    }
} else {
    if (muteN > 0) {
        muteN = muteN - 1;
    } else {
        fadeG = min(1, fadeG + 1 / 256);
    }
}
wb = wcur < 0 ? 0 : wcur;

// Idle sleep: input silent for longer than the receptive field.
quiet = max(abs(nin), abs(ninR)) < 0.000001 ? min(quiet + 1, 10000000) : 0;
asleep = (quiet > @@RF@@ + 8192) && (muteN <= 0) && (tgt == wcur) && (stp == scur);

nout = 0;
nsat = 0;
s = 0; c = 0; i = 0; o = 0; h = 0; j = 0; g = 0; pos = 0; acc = 0; sat = 0; wo = 0; rr = 0;
zv = 0; av = 0; row = 0; pb = 0; gi = 0; gf = 0; gg = 0; go = 0; cc = 0; hh = 0;
chn = 0; xin = 0; so = 0;
nch = scur > 0.5 ? 2 : 1;
poke(nib, nin, 0);
poke(nib, ninR, 1);
poke(nob, 0, 0);
poke(nob, 0, 1);
tp = tpH;
run = (mok > 0.5) && (wcur >= 0) && (asleep < 0.5);
if (run) {
//@NAM_BODY
    tpH = tp + 1 >= 1048576 ? 0 : tp + 1;
}
nout = clip(fixnan(peek(nob, 0)), -8, 8);
noutR = scur > 0.5 ? clip(fixnan(peek(nob, 1)), -8, 8) : nout;
yn = nout;
nG = nG + (dbtoa(normdb) - nG) * 0.002;
nzL = nout * nG;
nzR = noutR * nG;

// DC block (about 4 Hz) per channel, then tone stack + cab (biquad state per channel).
dcy = fixdenorm(nzL - dcx + 0.9995 * dcy);
dcx = nzL;
dcy2 = fixdenorm(nzR - dcx2 + 0.9995 * dcy2);
dcx2 = nzR;
poke(yb, dcy, 0);
poke(yb, dcy2, 1);
cfok = peek(cf, 50, 0);
if (cfok > 0.5) {
    for (cn = 0; cn < nch; cn += 1) {
        yy = peek(yb, cn);
        for (q = 0; q < 10; q += 1) {
            b0 = peek(cf, q * 5, 0);
            b1 = peek(cf, q * 5 + 1, 0);
            b2 = peek(cf, q * 5 + 2, 0);
            a1 = peek(cf, q * 5 + 3, 0);
            a2 = peek(cf, q * 5 + 4, 0);
            z1 = peek(bz, cn * 20 + q * 2);
            z2 = peek(bz, cn * 20 + q * 2 + 1);
            yq = b0 * yy + z1;
            poke(bz, fixdenorm(b1 * yy - a1 * yq + z2), cn * 20 + q * 2);
            poke(bz, fixdenorm(b2 * yy - a2 * yq), cn * 20 + q * 2 + 1);
            yy = yq;
        }
        poke(yb, yy, cn);
    }
}
yL = fixnan(peek(yb, 0));
yR = scur > 0.5 ? fixnan(peek(yb, 1)) : yL;

outG = outG + (dbtoa(outdb) - outG) * 0.002;
wet = clip(yL * outG * fadeG, -4, 4);
wetR = clip(yR * outG * fadeG, -4, 4);
mx = clip(mixamt, 0, 1);
o1 = dry1 * (1 - mx) + wet * mx;
o2 = dry2 * (1 - mx) + wetR * mx;
// Test hook tapraw: 1 = out 2 is the raw (left) model output, 2 = out 1 / out 2 are the raw L / R outputs.
out1 = tapraw > 1.5 ? nout : o1;
out2 = tapraw > 1.5 ? noutR : (tapraw > 0.5 ? nout : o2);

// GenExpr has no bitwise &: it silently kills the compile (measured), so counters wrap by compare.
// Telemetry. (tapraw is a test hook: out 2 = the raw model output.)
pkIn = max(pkIn, abs(xg));
pkOut = max(pkOut, max(abs(wet), abs(wetR)));
pkNam = max(pkNam, abs(yn));
sIn = sIn + xg * xg;
sOut = sOut + (wet * wet + wetR * wetR) * 0.5;
satA = satA + nsat;
xyc = xyc + 1;
if (xyc >= 4) {
    xyc = 0;
    xyh = xyh + 1 >= 512 ? 0 : xyh + 1;
    poke(scope, nin, 64 + xyh * 2, 0);
    poke(scope, yn, 64 + xyh * 2 + 1, 0);
    poke(scope, xyh, 12, 0);
}
oh = oh + 1 >= 2048 ? 0 : oh + 1;
poke(scope, (wet + wetR) * 0.5, 1088 + oh, 0);
blk = blk + 1;
if (blk >= 64) {
    blk = 0;
    frames = frames + 1;
    if (frames >= 1000000) {
        frames = 0;
    }
    alive = alive + 1;
    if (alive >= 1000000) {
        alive = 0;
    }
    satS = satS + (satA / 64 - satS) * 0.25;
    poke(scope, frames, 0, 0);
    poke(scope, samplerate, 1, 0);
    poke(scope, pkIn, 2, 0);
    poke(scope, pkOut, 3, 0);
    poke(scope, gGain, 4, 0);
    poke(scope, satS, 5, 0);
    poke(scope, sqrt(sIn / 64), 6, 0);
    poke(scope, sqrt(sOut / 64), 7, 0);
    poke(scope, run ? 1 : 0, 8, 0);
    poke(scope, @@NLAYERS@@, 9, 0);
    poke(scope, pkNam, 10, 0);
    poke(scope, asleep ? 1 : 0, 11, 0);
    poke(scope, oh, 13, 0);
    poke(scope, (tgt != wcur) || (muteN > 0) ? 1 : 0, 14, 0);
    poke(scope, alive, 15, 0);
    for (q = 0; q < @@NLAYERS@@; q += 1) {
        lv = peek(lsm, q) + (peek(lact, q) - peek(lsm, q)) * 0.3;
        poke(lsm, run ? lv : peek(lsm, q) * 0.8, q);
        poke(scope, peek(lsm, q), 16 + q, 0);
    }
    pkIn = 0;
    pkOut = 0;
    pkNam = 0;
    sIn = 0;
    sOut = 0;
    satA = 0;
}
