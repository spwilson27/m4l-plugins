// Amp gen core template. src/amp_config.js ampGenCode() fills //@NAM_DECL / //@NAM_LOCALS / //@NAM_BODY with
// the generated network for one architecture, @@RF@@ with its receptive field, @@NLAYERS@@ with its
// layer count and @@NW@@ with its weight count. The engine writes the weights into buffer~ ---ampw (bank offset `wbase`), the
// tone stack / cab biquads into ---ampcf (slot 50 = 1 once valid) and reads ---ampscope.
//
// Signal: Mono = (in1 + in2) / 2, Stereo = in1 and in2 -> Gain -> gate (linked) -> sag input gain -> [Pre-EQ: tone stack] -> model (once per
// channel) -> Normalize, sag output gain -> DC block -> 10 biquads -> Volume -> Dry/Wet with the dry stereo input. Model or mode
// switch: fade out 128 samples, take the new bank / mode, copy the bank into Data wd (128 weights per
// sample, so no single sample copies a whole model), stay muted for the receptive field (so the history
// is the new model's) and fade in.
// The same template carries the analog engine (src/amp_analog.js aaGenCode): its circuit functions are put in front, and
// //@NAM_DRY (dry path; the analog chain's oversampling delays the wet by 23 samples), //@NAM_Q0 (first post biquad) and
// the SLEEP token (silent samples before the model sleeps) are filled per engine. `active` crossfades between the
// Neural and the Analog gen~, which sit side by side on the same plugout~ (the inactive one outputs zeros).
// Per-sample cost: everything that does not change per sample (gate / smoothing coefficients, dB targets,
// biquad coefficients) is computed at control rate or copied once when the engine changes it.

Param indb(0);
Param gatedb(-100);
Param outdb(0);
Param mixamt(1);
Param stmode(0);
Param normdb(0);
Param eqpre(0);
Param wbase(-1);
Param mok(0);
Param tapraw(0);
Param testamp(0);
Param active(1);
Param sagamt(0);
Param sagref(0);
Buffer w("ampw");
Buffer cf("ampcf");
Buffer scope("ampscope");
History tpH(0);
History wcur(-1);
History scur(0);
History ecur(0);
History fadeG(0);
History muteN(0);
History gEnv(0);
History gGain(1);
History gOpen(0);
History dcx(0);
History dcy(0);
History dcx2(0);
History dcy2(0);
History quiet(0);
History inG(1);
History outG(1);
History nG(1);
History blk(0);
History frames(0);
History alive(0);
History pkIn(0);
History pkOut(0);
History pkNam(0);
History sIn(0);
History sOut(0);
History satS(0);
History satA(0);
History xyc(0);
History xyh(0);
History oh(0);
History tph(0);
History cpN(-1);
History cblk(0);
History cRel(0);
History cThr(0);
History cGkO(0);
History cGkC(0);
History cIn(1);
History cNrm(1);
History cOut(1);
History cfv(0);
History actG(0);
History sgA(0);
History sgP(0);
History sgD(0);
History sgQ(0);
History cSp(0);
History cSa(0);
History cSr(0);
History cSref(1);
Data bz(40);
Data nib(2);
Data nob(2);
Data yb(2);
Data bzp(16);
Data lsm(48);
Data cfd(50);
//@NAM_DECL

//@NAM_DRY
// Test hook (the Live check): a 110 Hz tone with two harmonics, plucked every 1.5 s, replaces the input.
tsig = 0;
if (testamp > 0) {
    tph = tph + 1 >= samplerate * 1.5 ? 0 : tph + 1;
    tsig = (sin(tph * 6.283185307 * 110 / samplerate) + 0.4 * sin(tph * 6.283185307 * 220 / samplerate) + 0.2 * sin(tph * 6.283185307 * 330 / samplerate)) * exp(-tph / samplerate * 1.5);
}
// Control rate (every 32 samples, and on the first sample): coefficients and dB targets.
if (cblk <= 0) {
    cblk = 32;
    cRel = exp(-1 / (0.03 * samplerate));
    cThr = dbtoa(gatedb);
    cGkO = 1 - exp(-1 / (0.001 * samplerate));
    cGkC = 1 - exp(-1 / (0.06 * samplerate));
    cIn = dbtoa(indb);
    cNrm = dbtoa(normdb);
    cOut = dbtoa(outdb);
    cSp = 1 - exp(-1 / (0.005 * samplerate));
    cSa = 1 - exp(-1 / (0.02 * samplerate));
    cSr = 1 - exp(-1 / ((0.12 + 0.28 * clip(sagamt, 0, 1)) * samplerate));
    cSref = dbtoa(2 * sagref);
}
cblk = cblk - 1;
xm = (in1 + in2) * 0.5;
xL = testamp > 0 ? testamp * tsig : (scur > 0.5 ? in1 : xm);
xR = testamp > 0 ? testamp * tsig : (scur > 0.5 ? in2 : xm);
inG = inG + (cIn - inG) * 0.002;
xg = xL * inG;
xgR = xR * inG;

// Noise gate on the input (after Gain, linked across channels): peak follower, 6 dB hysteresis, 1 ms open, 60 ms close.
ax = max(abs(xg), abs(xgR));
gEnv = ax > gEnv ? ax : gEnv * cRel;
thr = cThr;
gOpen = gEnv > thr ? 1 : (gEnv < thr * 0.5 ? 0 : gOpen);
gtgt = gatedb <= -99.9 ? 1 : gOpen;
gk = gtgt > gGain ? cGkO : cGkC;
gGain = gGain + (gtgt - gGain) * gk;

// Power-supply sag (src/amp_config.js ampSagStep is the reference): the previous sample's model output power,
// made level-independent with sagref, drives the supply droop; the droop lowers the model's input (up to 12 dB)
// and output (up to 4 dB), times Sag. Sag 0 = gains exactly 1 (the output is bit-identical to no sag).
sgA = sgA + (clip(sagamt, 0, 1) - sgA) * 0.002;
sgA = (sagamt <= 0) && (sgA < 0.0001) ? 0 : sgA;
sgP = sgP + (sgQ * cSref - sgP) * cSp;
sgT = min(sqrt(sgP) * 7.943282347, 2) * 0.5;
sgD = sgD + (sgT - sgD) * (sgT > sgD ? cSa : cSr);
sgIn = sgA > 0 ? dbtoa(-sgA * 12 * sgD) : 1;
sgOut = sgA > 0 ? dbtoa(-sgA * 4 * sgD) : 1;

// Model switch.
nin = xg * gGain * sgIn;
ninR = xgR * gGain * sgIn;
tgt = wbase;
stp = stmode > 0.5 ? 1 : 0;
ep = eqpre > 0.5 ? 1 : 0;
ninit = 0;
if ((tgt != wcur) || (stp != scur) || (ep != ecur)) {
    fadeG = max(0, fadeG - 1 / 128);
    if (fadeG <= 0) {
        wcur = tgt;
        scur = stp;
        ecur = ep;
        muteN = @@RF@@ + 512;
        cpN = 0;
    }
} else {
    if (muteN > 0) {
        muteN = cpN >= 0 ? muteN : muteN - 1;
    } else {
        fadeG = min(1, fadeG + 1 / 256);
    }
}
wb = wcur < 0 ? 0 : wcur;

// Idle sleep: input silent for longer than the receptive field.
quiet = max(abs(nin), abs(ninR)) < 0.000001 ? min(quiet + 1, 10000000) : 0;
actG = active > 0.5 ? min(1, actG + 1 / 1024) : max(0, actG - 1 / 1024);
asleep = (quiet > @@SLEEP@@) && (muteN <= 0) && (tgt == wcur) && (stp == scur) && (ep == ecur);

nout = 0;
nsat = 0;
s = 0; c = 0; i = 0; o = 0; h = 0; j = 0; g = 0; pos = 0; acc = 0; sat = 0; wo = 0; rr = 0;
zv = 0; av = 0; row = 0; pb = 0; gi = 0; gf = 0; gg = 0; go = 0; cc = 0; hh = 0;
chn = 0; xin = 0; so = 0; jj = 0;
//@NAM_LOCALS
nch = scur > 0.5 ? 2 : 1;
cn = 0; q = 0; yy = 0; yq = 0; b0 = 0; b1 = 0; b2 = 0; a1 = 0; a2 = 0; z1 = 0; z2 = 0;
poke(nib, nin, 0);
poke(nib, ninR, 1);
// Weight copy after a switch: 128 per sample from the bank into wd; the network starts (ninit) once it is done.
if (cpN >= 0) {
    for (j = 0; j < 128; j += 1) {
        jj = cpN + j;
        if (jj < @@NW@@) {
            poke(wd, peek(w, wb + jj, 0), jj);
        }
    }
    cpN = cpN + 128;
    if (cpN >= @@NW@@) {
        cpN = -1;
        ninit = 1;
    }
}
// Biquad coefficients: the engine bumps slot 50 (a counter, > 0.5 = valid) after writing them; copied once per change.
cv = peek(cf, 50, 0);
if (cv != cfv) {
    cfv = cv;
    for (q = 0; q < 50; q += 1) {
        poke(cfd, peek(cf, q, 0), q);
    }
}
cfok = cfv > 0.5;
// Pre-EQ: the tone stack (biquads 0..3) runs on the model's input instead of its output, so it changes
// how hard each band drives the model (a real amp's tone stack before its power stage).
if ((ecur > 0.5) && (cfok > 0.5)) {
    for (cn = 0; cn < nch; cn += 1) {
        yy = peek(nib, cn);
        for (q = 0; q < 4; q += 1) {
            b0 = peek(cfd, q * 5);
            b1 = peek(cfd, q * 5 + 1);
            b2 = peek(cfd, q * 5 + 2);
            a1 = peek(cfd, q * 5 + 3);
            a2 = peek(cfd, q * 5 + 4);
            z1 = peek(bzp, cn * 8 + q * 2);
            z2 = peek(bzp, cn * 8 + q * 2 + 1);
            yq = b0 * yy + z1;
            poke(bzp, fixdenorm(b1 * yy - a1 * yq + z2), cn * 8 + q * 2);
            poke(bzp, fixdenorm(b2 * yy - a2 * yq), cn * 8 + q * 2 + 1);
            yy = yq;
        }
        poke(nib, fixnan(yy), cn);
    }
}
poke(nob, 0, 0);
poke(nob, 0, 1);
tp = tpH;
run = (mok > 0.5) && (wcur >= 0) && (asleep < 0.5) && (cpN < 0) && ((actG > 0) || (active > 0.5));
if (run) {
//@NAM_BODY
    tpH = tp + 1 >= 1048576 ? 0 : tp + 1;
}
nout = clip(fixnan(peek(nob, 0)), -8, 8);
noutR = scur > 0.5 ? clip(fixnan(peek(nob, 1)), -8, 8) : nout;
yn = nout;
sgQ = (nout * nout + noutR * noutR) * 0.5;
nG = nG + (cNrm - nG) * 0.002;
nzL = nout * nG * sgOut;
nzR = noutR * nG * sgOut;

// DC block (about 4 Hz) per channel, then tone stack + cab (biquad state per channel).
dcy = fixdenorm(nzL - dcx + 0.9995 * dcy);
dcx = nzL;
dcy2 = fixdenorm(nzR - dcx2 + 0.9995 * dcy2);
dcx2 = nzR;
poke(yb, dcy, 0);
poke(yb, dcy2, 1);
//@NAM_Q0
if (cfok > 0.5) {
    for (cn = 0; cn < nch; cn += 1) {
        yy = peek(yb, cn);
        for (q = q0; q < 10; q += 1) {
            b0 = peek(cfd, q * 5);
            b1 = peek(cfd, q * 5 + 1);
            b2 = peek(cfd, q * 5 + 2);
            a1 = peek(cfd, q * 5 + 3);
            a2 = peek(cfd, q * 5 + 4);
            z1 = peek(bz, cn * 20 + q * 2);
            z2 = peek(bz, cn * 20 + q * 2 + 1);
            yq = b0 * yy + z1;
            poke(bz, fixdenorm(b1 * yy - a1 * yq + z2), cn * 20 + q * 2);
            poke(bz, fixdenorm(b2 * yy - a2 * yq), cn * 20 + q * 2 + 1);
            yy = yq;
        }
        poke(yb, yy, cn);
    }
}
yL = fixnan(peek(yb, 0));
yR = scur > 0.5 ? fixnan(peek(yb, 1)) : yL;

outG = outG + (cOut - outG) * 0.002;
wet = clip(yL * outG * fadeG, -4, 4);
wetR = clip(yR * outG * fadeG, -4, 4);
mx = clip(mixamt, 0, 1);
o1 = (dry1 * (1 - mx) + wet * mx) * actG;
o2 = (dry2 * (1 - mx) + wetR * mx) * actG;
// Test hook tapraw: 1 = out 2 is the raw (left) model output, 2 = out 1 / out 2 are the raw L / R outputs,
// 3 = out 1 is the sag input gain and out 2 the raw (left) model output.
out1 = tapraw > 2.5 ? sgIn : (tapraw > 1.5 ? nout : o1);
out2 = tapraw > 1.5 ? (tapraw > 2.5 ? nout : noutR) : (tapraw > 0.5 ? nout : o2);

// GenExpr has no bitwise &: it silently kills the compile (measured), so counters wrap by compare.
// Telemetry. (tapraw is a test hook: out 2 = the raw model output.)
pkIn = max(pkIn, abs(xg));
pkOut = max(pkOut, max(abs(wet), abs(wetR)));
pkNam = max(pkNam, abs(yn));
sIn = sIn + xg * xg;
sOut = sOut + (wet * wet + wetR * wetR) * 0.5;
satA = satA + nsat;
xyc = xyc + 1;
if (xyc >= 4) {
    xyc = 0;
    xyh = xyh + 1 >= 512 ? 0 : xyh + 1;
    poke(scope, nin, 64 + xyh * 2, 0);
    poke(scope, yn, 64 + xyh * 2 + 1, 0);
    poke(scope, xyh, 12, 0);
}
oh = oh + 1 >= 2048 ? 0 : oh + 1;
poke(scope, (wet + wetR) * 0.5, 1088 + oh, 0);
blk = blk + 1;
if (blk >= 64) {
    blk = 0;
    frames = frames + 1;
    if (frames >= 1000000) {
        frames = 0;
    }
    alive = alive + 1;
    if (alive >= 1000000) {
        alive = 0;
    }
    satS = satS + (satA / 64 - satS) * 0.25;
    poke(scope, frames, 0, 0);
    poke(scope, samplerate, 1, 0);
    poke(scope, pkIn, 2, 0);
    poke(scope, pkOut, 3, 0);
    poke(scope, gGain, 4, 0);
    poke(scope, satS, 5, 0);
    poke(scope, sqrt(sIn / 64), 6, 0);
    poke(scope, sqrt(sOut / 64), 7, 0);
    poke(scope, run ? 1 : 0, 8, 0);
    poke(scope, @@NLAYERS@@, 9, 0);
    poke(scope, pkNam, 10, 0);
    poke(scope, asleep ? 1 : 0, 11, 0);
    poke(scope, oh, 13, 0);
    poke(scope, (tgt != wcur) || (muteN > 0) || (cpN >= 0) ? 1 : 0, 14, 0);
    poke(scope, alive, 15, 0);
    for (q = 0; q < @@NLAYERS@@; q += 1) {
        lv = peek(lsm, q) + (peek(lact, q) - peek(lsm, q)) * 0.3;
        poke(lsm, run ? lv : peek(lsm, q) * 0.8, q);
        poke(scope, peek(lsm, q), 16 + q, 0);
    }
    pkIn = 0;
    pkOut = 0;
    pkNam = 0;
    sIn = 0;
    sOut = 0;
    satA = 0;
}
