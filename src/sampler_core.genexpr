// Better Sampler — 16-Voice Polyphonic + Up to 8-Voice Stereo Unison Multi-Engine Sampler.
//
// Engines (mode: 0..4) and Single / Sliced (sliced: 0 / 1, orthogonal to the engine):
//   0 = REPITCH   : Varispeed playback. Forward loops use an equal-power sin/cos crossfade,
//                   ping-pong folds the read position (sample-continuous). Characters (rp_char):
//                   Clean, Analog (rp_dist saturation with pre/post EQ, rp_color stereo tape),
//                   Digital (rp_dist bit reduction, rp_color sample-rate reduction, rp_vsr,
//                   rp_imaging).
//   1 = CYCLES    : Dual overlap-add Hann grains locked to the note pitch, with formant stretch.
//                   Characters (cy_char): Pulse (cy_width), Partials (cy_split, cy_fund) and
//                   Phase (cy_mod, cy_harm). cy_xfade latches two anchors (duophonic smoothing).
//   2 = TEXTURES  : Dual overlap-add Hann granular cloud with spray, unison detune and pan.
//   3 = SPECTRAL  : Phase-vocoder stretching: Speed (grain_motion) is decoupled from pitch.
//                   Computed OUTSIDE voice_proc by spec_voice() for voices 0..3 only (see below).
//
// Compile time: GenExpr inlines every call, so voice_proc and spec_voice are each called from ONE loop
// (16 voices / 4 spectral voices). A function cannot hold per-call-site state in a loop, so all their
// History lives in Data: vhist (256 slots per voice: voice_proc 0..37, analog 64..79, tape 80..84,
// digital 96..110) and sdat (one block per spectral voice: FFT work arrays, jp and 22 History slots).
// Released, silent voices skip voice_proc altogether.
//   4 = FRAGMENTS : Playful granular: a pool of up to 32 grains per voice (fr_max_grains is
//                   capped at 32), density, repeats, envelope shape, motion randomisation.
//
// Sliced (sliced = 1): every engine plays the voice's slice bounds. They are read live from vdata
// slots 4/5, and `slice_play` picks the behaviour: 0 to slice end (once), 1 to sample end
// (slice start .. samp_end), 2 one-way loop, 3 ping-pong loop. Pitch ignores the MIDI note (the note
// picks the slice). Pos (`play_pos`) only matters while Freeze is on.
//
// Spectral limits (CPU budget): at most 4 Spectral voices (vdata voices 0..3, the rest are silent in
// Spectral mode). FFT 1024 / 2048 / 4096 by sp_quality (Low / Medium / High), 75% overlap, one FFT
// pass or one O(N) slice of work per sample (the Cepstra pattern, time-sliced across each hop).
// sp_live = On bursts the first 4 frames at note-on (no latency, one CPU spike); Off ramps in.
//
// Buffers (bound on loadbang via `samp #0-bsamp, vdata #0-bsvoices, scope #0-bsscope`):
//   samp   ("bsamp")    : Audio sample buffer (1 or 2 channels; mono plays on both outputs)
//   vdata  ("bsvoices") : 128-sample control table (16 voices x 8 slots):
//     slot + 0 : gate (0 = released, 1 = held)
//     slot + 1 : target MIDI note (0..127)
//     slot + 2 : velocity (0..1)
//     slot + 3 : trigger counter (increments on note-on retrigger; legato pitch changes keep counter)
//     slot + 4 : slice start normalized (0..1)
//     slot + 5 : slice end normalized (0..1)
//     slot + 6 : voice stereo pan seed (-1..+1)
//     slot + 7 : voice random seed (0..1)
//   scope  ("bsscope")  : 64-sample UI telemetry buffer:
//     0..15  : per-voice normalized playhead position (0..1)
//     16..31 : per-voice amplitude envelope level (0..1)
//     32 / 33: output peak L / R
//     34     : active voice count (0..16)
//     35     : current LFO value (-1..+1)
//     36     : current Mod Env value (0..1)
//     37     : effective filter cutoff in Hz
//     38     : loaded sample frame count (dim(samp))
//     39     : rolling telemetry frame counter
//     48     : Fragments grains started (all voices, cumulative; test telemetry)
//
// GenExpr rules strictly enforced:
//   - All helper functions appear before Buffer, Data, Param, History, and expression statements.
//   - No identifier is named e<digit> (Euler's constant lexer bug).
//   - No Param is named after a GenExpr builtin.

slew_val(target, coef) {
	History s(0);
	History is_init(0);
	s = (is_init == 0) ? target : mix(target, s, coef);
	is_init = 1;
	return s;
}

peek_lr(sampBuf, idx, maxIdx) {
	iClamped = clip(idx, 0, maxIdx);
	// channelmode="clamp": a 1-channel (mono) buffer returns channel 0 for the
	// right read too, so mono samples play identically on both outputs.
	smpL = peek(sampBuf, iClamped, 0, interp="linear", boundmode="clamp", channelmode="clamp");
	smpR = peek(sampBuf, iClamped, 1, interp="linear", boundmode="clamp", channelmode="clamp");
	return smpL, smpR;
}

rnd01(sd) {
	return fract(sin(sd * 12.9898 + 78.233) * 43758.5453);
}

// One-pole coefficient for a cutoff in Hz.
op_coef(fc, sr) {
	return 1.0 - exp(-6.28318530718 * clip(fc, 5, sr * 0.45) / sr);
}

// Folded read position of a ping-pong phase that lives in [ps, ps + 2 * span).
pp_pos(ph, ps, pe) {
	spn = max(pe - ps, 4);
	mm = wrap(ph - ps, 0, spn * 2.0);
	return (mm <= spn) ? (ps + mm) : (ps + spn - (mm - spn));
}

// Re-express a ping-pong phase for new slice bounds so the folded position and travel
// direction stay put. A position outside the new bounds restarts at the new slice start
// (forward) or end (reverse).
pp_remap(ph, oldS, oldE, newS, newE, dirS) {
	oSpn = max(oldE - oldS, 4);
	nSpn = max(newE - newS, 4);
	mm = wrap(ph - oldS, 0, oSpn * 2.0);
	oldPos = (mm <= oSpn) ? (oldS + mm) : (oldS + oSpn - (mm - oSpn));
	upward = (mm <= oSpn) ? (dirS > 0) : (dirS < 0);
	firstHalf = (upward == (dirS > 0));
	inside = (oldPos >= newS) && (oldPos <= newS + nSpn);
	nm = firstHalf ? (oldPos - newS) : (nSpn + newS + nSpn - oldPos);
	nm = clip(nm, 0, nSpn * 2.0);
	return inside ? (newS + nm) : (newS + ((dirS > 0) ? 0.0 : nSpn));
}

// uFrac in [-1, 1] and a pitch ratio. Detune breathes with driftPhs so the stack is not static.
unison_spread(u, uCount, unisonDetune, driftPhs, vSeed) {
	uFrac = (uCount > 1) ? ((u / (uCount - 1.0)) * 2.0 - 1.0) : 0.0;
	uDrift = sin(6.28318530718 * fract(driftPhs + u * 0.125 + vSeed * 0.41));
	detSemi = uFrac * unisonDetune * 0.72 + uDrift * unisonDetune * 0.16;
	detRatio = pow(2.0, clip(detSemi, -1.25, 1.25) / 12.0);
	return uFrac, detRatio;
}

// Effective play region (normalised). Sliced: the voice's slice bounds, extended to the sample
// start / end for "to sample end". Single: start .. end.
slice_region(voS, vE, startNorm, endNorm, slicedFlag, slicePlay, reverseOn) {
	slicePlayId = round(clip(slicePlay, 0, 3));
	revSlice = (reverseOn > 0.5);
	toSampleEnd = (slicePlayId > 0.5) && (slicePlayId < 1.5);
	sampStartN = clip(min(startNorm, endNorm - 0.005), 0, 0.995);
	sampEndN = clip(max(endNorm, sampStartN + 0.005), 0.005, 1.0);
	sliceEndN = max(vE, voS + 0.005);
	sliceLoN = (toSampleEnd && revSlice) ? min(sampStartN, sliceEndN - 0.005) : voS;
	sliceHiN = (toSampleEnd && (revSlice == 0)) ? max(sampEndN, voS + 0.005) : sliceEndN;
	effS = (slicedFlag > 0.5) ? sliceLoN : sampStartN;
	effE = (slicedFlag > 0.5) ? sliceHiN : sampEndN;
	return effS, effE, sampStartN, sampEndN;
}

// Playhead step for the non-Repitch engines. wm: 0 stop at lo / hi, 1 wrap in [rlo, rhi], 2 ping-pong in
// [rlo, rhi]. Returns the new position, the new direction and a done flag (reached lo / hi while stopping).
head_step(pos, dir, stepN, lo, hi, rlo, rhi, wm) {
	p = pos + dir * stepN;
	d2 = dir;
	done = 0;
	if (wm > 1.5) {
		if ((dir > 0) && (p >= rhi) && (pos >= rlo)) {
			p = rhi - (p - rhi);
			d2 = -1;
		} else if ((dir < 0) && (p <= rlo) && (pos <= rhi)) {
			p = rlo + (rlo - p);
			d2 = 1;
		}
	} else if (wm > 0.5) {
		if ((dir > 0) && (p >= rhi) && (pos >= rlo)) {
			p = rlo + wrap(p - rhi, 0, max(rhi - rlo, 0.0001));
		} else if ((dir < 0) && (p <= rlo) && (pos <= rhi)) {
			p = rhi - wrap(rlo - p, 0, max(rhi - rlo, 0.0001));
		}
	}
	if (p >= hi) {
		p = hi;
		done = (d2 > 0) ? 1 : 0;
	}
	if (p <= lo) {
		p = lo;
		done = (d2 < 0) ? 1 : 0;
	}
	return p, d2, done;
}

// Stereo reader. Forward loops (loopMode == 1) equal-power crossfade the tail
// into the head: cos fades the outgoing pass, sin fades the restart.
// The audible period is (span - xfLen); the first pass still plays the head.
read_repitch(sampBuf, posFrames, startF, endF, loopStartF, loopEndF, loopMode, xfadeFrac, numFrames) {
	maxIdx = max(numFrames - 1, 1);
	outL = 0;
	outR = 0;
	handled = 0;

	if (loopMode > 0.5) {
		lStart = clip(min(loopStartF, loopEndF - 4), 0, maxIdx);
		lEnd = clip(max(loopEndF, lStart + 4), 1, maxIdx);
		span = max(lEnd - lStart, 4);

		if (posFrames >= lStart) {
			handled = 1;
			if (loopMode >= 1.5) {
				period2 = span * 2.0;
				m = wrap(posFrames - lStart, 0, period2);
				readF = (m <= span) ? (lStart + m) : (lEnd - (m - span));
				pL, pR = peek_lr(sampBuf, readF, maxIdx);
				outL = pL;
				outR = pR;
			} else {
				xfLen = min(span * clip(xfadeFrac, 0, 0.45), span * 0.5);
				if (xfLen <= 2.0) {
					readF = lStart + wrap(posFrames - lStart, 0, span);
					hL, hR = peek_lr(sampBuf, readF, maxIdx);
					outL = hL;
					outR = hR;
				} else {
					period = max(span - xfLen, 4);
					relAbs = posFrames - lStart;
					if (relAbs >= span) {
						relAbs = xfLen + wrap(relAbs - span, 0, period);
					}
					if (relAbs >= (span - xfLen)) {
						fadeT = clip((relAbs - (span - xfLen)) / xfLen, 0, 1);
						gTail = cos(fadeT * 1.5707963);
						gHead = sin(fadeT * 1.5707963);
						posTail = lStart + relAbs;
						posHead = lStart + (relAbs - (span - xfLen));
						tL, tR = peek_lr(sampBuf, posTail, maxIdx);
						hL, hR = peek_lr(sampBuf, posHead, maxIdx);
						outL = tL * gTail + hL * gHead;
						outR = tR * gTail + hR * gHead;
					} else {
						linL, linR = peek_lr(sampBuf, lStart + relAbs, maxIdx);
						outL = linL;
						outR = linR;
					}
				}
			}
		}
	}

	if (handled == 0) {
		if ((posFrames >= startF) && (posFrames <= endF)) {
			spanR = max(endF - startF, 1);
			edgeSamps = min(24.0, spanR * 0.25);
			distIn = min(posFrames - startF, endF - posFrames);
			edgeG = (edgeSamps <= 1.0) ? 1.0 : sin(clip(distIn / edgeSamps, 0, 1) * 1.5707963);
			oL, oR = peek_lr(sampBuf, posFrames, maxIdx);
			outL = oL * edgeG;
			outR = oR * edgeG;
		}
	}
	return outL, outR;
}

// ---------------------------------------------------------------------------------------------
// Repitch characters
// ---------------------------------------------------------------------------------------------

// Analog, one channel. dist: saturator with pre / post EQ (even + odd harmonics via an asymmetric tanh).
// colorV > 0: brighter shelf and tape hiss (scales with the playback rate). colorV < 0: low-mid
// emphasis and softer transients (lowpass + gentle saturation).
analog_chan(x, dist, colorV, rate, sr, vhist, stBase) {
	lpLo = peek(vhist, stBase + 0);
	lpHi = peek(vhist, stBase + 1);
	lpSoft = peek(vhist, stBase + 2);
	lpNz = peek(vhist, stBase + 3);
	lpPre = peek(vhist, stBase + 4);
	lpPost = peek(vhist, stBase + 5);
	dcX = peek(vhist, stBase + 6);
	dcY = peek(vhist, stBase + 7);
	y = x;
	posC = max(colorV, 0.0);
	negC = max(0.0 - colorV, 0.0);
	if (negC > 0.0005) {
		lpLo = lpLo + op_coef(320, sr) * (y - lpLo);
		y = (y + negC * 1.3 * lpLo) / (1.0 + 0.45 * negC);
		lpSoft = lpSoft + op_coef(18000 * pow(0.18, negC), sr) * (y - lpSoft);
		y = mix(lpSoft, tanh(lpSoft * 1.3) / 1.3, negC * 0.5);
	}
	if (posC > 0.0005) {
		lpHi = lpHi + op_coef(2500 * clip(rate, 0.5, 2.0), sr) * (y - lpHi);
		y = y + posC * 1.6 * (y - lpHi);
		nz = noise();
		lpNz = lpNz + op_coef(1500, sr) * (nz - lpNz);
		y = y + (nz - lpNz) * posC * 0.012 * clip(rate, 0.25, 3.0);
	}
	if (dist > 0.0005) {
		lpPre = lpPre + op_coef(250, sr) * (y - lpPre);
		pre = y + dist * 1.2 * (y - lpPre);
		drv = 1.0 + 2.0 * dist + 9.0 * dist * dist;
		sat = tanh(drv * pre + 0.35 * dist) - tanh(0.35 * dist);
		dcY = sat - dcX + 0.995 * dcY;
		dcX = sat;
		lpPost = lpPost + op_coef(9000 - 5000 * dist, sr) * (dcY - lpPost);
		y = mix(y, lpPost / (1.0 + 0.5 * (drv - 1.0)), clip(dist * 8.0, 0, 1));
	}
	poke(vhist, lpLo, stBase + 0);
	poke(vhist, lpHi, stBase + 1);
	poke(vhist, lpSoft, stBase + 2);
	poke(vhist, lpNz, stBase + 3);
	poke(vhist, lpPre, stBase + 4);
	poke(vhist, lpPost, stBase + 5);
	poke(vhist, dcX, stBase + 6);
	poke(vhist, dcY, stBase + 7);
	return y;
}

// Analog tape stereo: decalibrated heads (L and R warble out of phase, plus a head azimuth offset).
// Wow / flutter rate and depth scale with the playback rate. The delay lines live in the shared tbuf
// table (gen shares a function-level Data between every call site, so each voice gets its own slice).
tape_st(xl, xr, colorV, rate, sr, tbuf, tbase, vhist, stBase) {
	wp = peek(vhist, stBase + 0);
	p1 = peek(vhist, stBase + 1);
	p2 = peek(vhist, stBase + 2);
	p3 = peek(vhist, stBase + 3);
	p4 = peek(vhist, stBase + 4);
	posC = max(colorV, 0.0);
	rt = sqrt(clip(rate, 0.25, 4.0));
	p1 = fract(p1 + 0.9 * rt / sr);
	p2 = fract(p2 + 1.13 * rt / sr);
	p3 = fract(p3 + 7.3 * rt / sr);
	p4 = fract(p4 + 9.1 * rt / sr);
	wowA = 26.0 * posC * rt;
	flA = 3.5 * posC * rt;
	az = 18.0 * posC;
	dlS = 2.0 + wowA * (1.0 + sin(6.28318530718 * p1)) + flA * (1.0 + sin(6.28318530718 * p3));
	drS = 2.0 + az + wowA * (1.0 + sin(6.28318530718 * p2)) + flA * (1.0 + sin(6.28318530718 * p4));
	poke(tbuf, xl, tbase + wp);
	poke(tbuf, xr, tbase + 4096 + wp);
	rl = wrap(wp - dlS, 0, 4096);
	rr = wrap(wp - drS, 0, 4096);
	il0 = int(floor(rl));
	ir0 = int(floor(rr));
	il1 = int(wrap(il0 + 1, 0, 4096));
	ir1 = int(wrap(ir0 + 1, 0, 4096));
	yl = mix(peek(tbuf, tbase + il0), peek(tbuf, tbase + il1), rl - il0);
	yr = mix(peek(tbuf, tbase + 4096 + ir0), peek(tbuf, tbase + 4096 + ir1), rr - ir0);
	wp = wrap(wp + 1, 0, 4096);
	poke(vhist, wp, stBase + 0);
	poke(vhist, p1, stBase + 1);
	poke(vhist, p2, stBase + 2);
	poke(vhist, p3, stBase + 3);
	poke(vhist, p4, stBase + 4);
	return yl, yr;
}

// Digital: bit reduction (13 bits at dist 0 down to 2), sample-rate reduction (positive colour = raw
// sample-and-hold aliasing, negative = band-limited first), VSR (rate follows the playback rate) and an
// imaging filter that follows the voice's sample rate.
digital_st(xl, xr, dist, colorV, rate, vsr, imaging, sr, vhist, stBase) {
	acc = peek(vhist, stBase + 0);
	hL = peek(vhist, stBase + 1);
	hR = peek(vhist, stBase + 2);
	a1L = peek(vhist, stBase + 3);
	a2L = peek(vhist, stBase + 4);
	a3L = peek(vhist, stBase + 5);
	a1R = peek(vhist, stBase + 6);
	a2R = peek(vhist, stBase + 7);
	a3R = peek(vhist, stBase + 8);
	b1L = peek(vhist, stBase + 9);
	b2L = peek(vhist, stBase + 10);
	b3L = peek(vhist, stBase + 11);
	b1R = peek(vhist, stBase + 12);
	b2R = peek(vhist, stBase + 13);
	b3R = peek(vhist, stBase + 14);
	bits = 13.0 - 11.0 * clip(dist, 0, 1);
	q = pow(2.0, bits - 1.0);
	ql = floor(xl * q + 0.5) / q;
	qr = floor(xr * q + 0.5) / q;
	srBase = sr * pow(2.0, 0.0 - 5.0 * abs(colorV));
	srEff = (vsr > 0.5) ? (srBase * clip(rate, 0.05, 8.0)) : srBase;
	srEff = clip(srEff, 400.0, sr * 4.0);
	byp = (srEff >= sr * 0.999) ? 1 : 0;
	outL = ql;
	outR = qr;
	if (byp == 0) {
		inL = ql;
		inR = qr;
		if (colorV < -0.0005) {
			cf = op_coef(srEff * 0.36, sr);
			a1L = a1L + cf * (ql - a1L);
			a2L = a2L + cf * (a1L - a2L);
			a3L = a3L + cf * (a2L - a3L);
			a1R = a1R + cf * (qr - a1R);
			a2R = a2R + cf * (a1R - a2R);
			a3R = a3R + cf * (a2R - a3R);
			inL = a3L;
			inR = a3R;
		}
		acc = acc + srEff / sr;
		if (acc >= 1.0) {
			acc = acc - floor(acc);
			hL = inL;
			hR = inR;
		}
		outL = hL;
		outR = hR;
		if (imaging > 0.5) {
			ci = op_coef(srEff * 0.30, sr);
			b1L = b1L + ci * (hL - b1L);
			b2L = b2L + ci * (b1L - b2L);
			b3L = b3L + ci * (b2L - b3L);
			b1R = b1R + ci * (hR - b1R);
			b2R = b2R + ci * (b1R - b2R);
			b3R = b3R + ci * (b2R - b3R);
			outL = b3L;
			outR = b3R;
		}
	}
	poke(vhist, acc, stBase + 0);
	poke(vhist, hL, stBase + 1);
	poke(vhist, hR, stBase + 2);
	poke(vhist, a1L, stBase + 3);
	poke(vhist, a2L, stBase + 4);
	poke(vhist, a3L, stBase + 5);
	poke(vhist, a1R, stBase + 6);
	poke(vhist, a2R, stBase + 7);
	poke(vhist, a3R, stBase + 8);
	poke(vhist, b1L, stBase + 9);
	poke(vhist, b2L, stBase + 10);
	poke(vhist, b3L, stBase + 11);
	poke(vhist, b1R, stBase + 12);
	poke(vhist, b2R, stBase + 13);
	poke(vhist, b3R, stBase + 14);
	return outL, outR;
}

// ---------------------------------------------------------------------------------------------
// Cycles
// ---------------------------------------------------------------------------------------------

cyc_read(sampBuf, anc, cycLen, form, ph, maxIdx) {
	rdp = (ph - 0.5) * form + 0.5;
	return peek_lr(sampBuf, anc + rdp * cycLen, maxIdx);
}

// One cycle read at phase ph with the character applied.
//   charId 0 Pulse   : phase distortion with duty dutyD (0.5 = unchanged)
//   charId 1 Partials: the cycle and its half-period shift give odd / even harmonics (splitV -1 odd .. +1 even)
//   charId 2 Phase   : the read phase is offset by pmV (phase modulation)
cyc_wave(sampBuf, anc, cycLen, form, ph, charId, dutyD, splitV, pmV, maxIdx) {
	phw = ph;
	if (charId < 0.5) {
		phw = (ph < dutyD) ? (0.5 * ph / max(dutyD, 0.01)) : (0.5 + 0.5 * (ph - dutyD) / max(1.0 - dutyD, 0.01));
	} else if (charId > 1.5) {
		phw = ph + pmV;
	}
	xl, xr = cyc_read(sampBuf, anc, cycLen, form, phw, maxIdx);
	if ((charId > 0.5) && (charId < 1.5)) {
		pl, pr = cyc_read(sampBuf, anc, cycLen, form, ph + 0.5, maxIdx);
		wOdd = 1.0 - max(splitV, 0.0);
		wEven = 1.0 - max(0.0 - splitV, 0.0);
		oddL = 0.5 * (xl - pl);
		evenL = 0.5 * (xl + pl);
		oddR = 0.5 * (xr - pr);
		evenR = 0.5 * (xr + pr);
		xl = wOdd * oddL + wEven * evenL;
		xr = wOdd * oddR + wEven * evenR;
	}
	return xl, xr;
}

// ---------------------------------------------------------------------------------------------
// Fragments
// ---------------------------------------------------------------------------------------------

// Grain envelope: peak at pk (0..1). 0.5 is a symmetric Hann; 0 / 1 click on purpose.
fr_win(t, pk) {
	rise = 0.5 - 0.5 * cos(3.14159265359 * clip(t / max(pk, 0.0001), 0, 1));
	fall = 0.5 + 0.5 * cos(3.14159265359 * clip((t - pk) / max(1.0 - pk, 0.0001), 0, 1));
	return (t < pk) ? rise : fall;
}

// ---------------------------------------------------------------------------------------------
// Spectral (phase vocoder, time-sliced). All helpers read frame parameters from the jp table:
//   0 N, 1 N/2, 2 Hs, 3 pitch ratio, 4 formant ratio, 5 formant on, 6 source fundamental bin,
//   7 bend ratio, 8 reharm, 9 quant mode, 10 quant amount, 11 key, 12 scale, 13 sr, 14 output f0 Hz,
//   15 dispersion, 16 onsets on, 17 first frame, 18 Ha (analysis hop), 19 onset flag (this frame),
//   20 seed, 21 capture centre (frames), 22 capture dir, 23 lo (frames), 24 hi (frames),
//   25 numFrames, 26 stride, 27 OLA start, 28 OLA first index, 29 stretch (1 / speed)
// ---------------------------------------------------------------------------------------------

// In-place radix-2 DIT pass `s` (1..log2 n) over bit-reversed input. sgn = +1 forward, -1 inverse (unscaled).
fft_pass(sdat, sb, twr, twi, n, s, sgn) {
	hlf = pow(2, s - 1);
	blk = hlf * 2;
	tstep = 4096 / blk;
	nb = n * 0.5;
	for (b = 0; b < nb; b += 1) {
		grp = floor(b / hlf);
		j = b - grp * hlf;
		i0 = grp * blk + j;
		i1 = i0 + hlf;
		tIdx = j * tstep;
		wr = peek(twr, tIdx);
		wi = sgn * peek(twi, tIdx);
		ar = peek(sdat, sb + i0);
		ai = peek(sdat, sb + 4096 + i0);
		br = peek(sdat, sb + i1);
		bi = peek(sdat, sb + 4096 + i1);
		tr = br * wr - bi * wi;
		tm = br * wi + bi * wr;
		poke(sdat, ar - tr, sb + i1);
		poke(sdat, ai - tm, sb + 4096 + i1);
		poke(sdat, ar + tr, sb + i0);
		poke(sdat, ai + tm, sb + 4096 + i0);
	}
	return 0;
}

// One-time tables: twiddles exp(-2*pi*i*k/4096) for k = 0..2048 and the 12-bit bit-reversal table.
init_tables(twr, twi, brv) {
	for (k = 0; k <= 2048; k += 1) {
		a = 6.28318530718 * k / 4096;
		poke(twr, cos(a), k);
		poke(twi, 0 - sin(a), k);
	}
	for (i = 0; i < 4096; i += 1) {
		t = i;
		r = 0;
		for (q = 0; q < 12; q += 1) {
			r = r * 2 + (t % 2);
			t = floor(t / 2);
		}
		poke(brv, r, i);
	}
	return 0;
}

// Job: Hann-window N source frames around the capture centre (L real, R imaginary), bit-reversed.
// Frames outside [lo, hi] are silent, so slices and the start / end points cut the analysis window.
job_capture(sdat, sb, brv, twr, sampBuf) {
	n = peek(sdat, sb + 55328 + 0);
	nh = n * 0.5;
	stride = peek(sdat, sb + 55328 + 26);
	centre = peek(sdat, sb + 55328 + 21);
	dirc = peek(sdat, sb + 55328 + 22);
	lo = peek(sdat, sb + 55328 + 23);
	hi = peek(sdat, sb + 55328 + 24);
	maxIdx = max(peek(sdat, sb + 55328 + 25) - 1, 1);
	wmc = peek(sdat, sb + 55328 + 30);
	for (i = 0; i < n; i += 1) {
		ci = (i <= nh) ? i : (n - i);
		w = 0.5 - 0.5 * peek(twr, ci * stride);
		idx = centre + dirc * (i - nh);
		if (wmc > 1.5) {
			idx = pp_pos(idx, lo, hi);
		} else if (wmc > 0.5) {
			idx = lo + wrap(idx - lo, 0, max(hi - lo, 4));
		}
		xl = 0;
		xr = 0;
		if ((idx >= lo) && (idx <= hi)) {
			xl, xr = peek_lr(sampBuf, idx, maxIdx);
		}
		r = floor(peek(brv, i) / stride);
		poke(sdat, w * xl, sb + r);
		poke(sdat, w * xr, sb + 4096 + r);
	}
	return 0;
}

// Job: magnitude, instantaneous frequency (phase advance over the analysis hop Ha) and the running sum
// of magnitudes (for the formant envelope) of channel ch from the packed FFT. Channel 0 also measures
// the spectral flux used to detect onsets.
job_analyze(sdat, sb, ch) {
	n = peek(sdat, sb + 55328 + 0);
	nh = peek(sdat, sb + 55328 + 1);
	ha = peek(sdat, sb + 55328 + 18);
	first = peek(sdat, sb + 55328 + 17);
	off = ch * 2049;
	tau = 6.28318530718;
	csum = 0;
	flux = 0;
	tot = 0;
	poke(sdat, 0, sb + 12290 + 0);
	for (k = 0; k <= nh; k += 1) {
		kk = (n - k) % n;
		ar = peek(sdat, sb + k);
		ai = peek(sdat, sb + 4096 + k);
		br = peek(sdat, sb + kk);
		bi = peek(sdat, sb + 4096 + kk);
		xr = (ch < 0.5) ? (0.5 * (ar + br)) : (0.5 * (ai + bi));
		xi = (ch < 0.5) ? (0.5 * (ai - bi)) : (0.5 * (br - ar));
		am = sqrt(xr * xr + xi * xi);
		ph = atan2(xi, xr);
		prv = peek(sdat, sb + 22536 + (off + k));
		wk = tau * k / n;
		dv = ph - prv - wk * ha;
		dv = dv - tau * round(dv / tau);
		inst = wk;
		if ((first < 0.5) && (ha >= 1.0)) {
			inst = wk + dv / ha;
		}
		poke(sdat, am, sb + 8192 + k);
		poke(sdat, inst, sb + 10241 + k);
		poke(sdat, ph, sb + 22536 + (off + k));
		csum = csum + am;
		poke(sdat, csum, sb + 12290 + (k + 1));
		if (ch < 0.5) {
			flux = flux + max(am - peek(sdat, sb + 20487 + k), 0.0);
			tot = tot + am;
			poke(sdat, am, sb + 20487 + k);
		}
	}
	if (ch < 0.5) {
		poke(sdat, flux / (tot + 0.000000001), sb + 55312 + 0);
	}
	return 0;
}

// Spectral envelope (moving average of the magnitudes, wide enough to bridge harmonics) at bin kpos.
env_at(sdat, sb, kpos, nh, n, sr) {
	ki = round(clip(kpos, 0, nh));
	w = max(4, floor(150.0 * n / sr + 0.08 * ki));
	lo = max(ki - w, 0);
	hi = min(ki + w, nh);
	return (peek(sdat, sb + 12290 + (hi + 1)) - peek(sdat, sb + 12290 + lo)) / (hi - lo + 1);
}

// Job: remap the analysed bins of channel ch to the output spectrum (pitch ratio, optional harmonic bend and
// quantise for Reharm), apply the formant envelope, and advance the synthesis phases by the shifted true
// frequency times the synthesis hop.
job_map(sdat, sb, ch) {
	n = peek(sdat, sb + 55328 + 0);
	nh = peek(sdat, sb + 55328 + 1);
	hs = peek(sdat, sb + 55328 + 2);
	pr = peek(sdat, sb + 55328 + 3);
	fEff = peek(sdat, sb + 55328 + 4);
	formOn = peek(sdat, sb + 55328 + 5);
	kf = peek(sdat, sb + 55328 + 6);
	bendR = peek(sdat, sb + 55328 + 7);
	reharm = peek(sdat, sb + 55328 + 8);
	qMode = peek(sdat, sb + 55328 + 9);
	qAmt = peek(sdat, sb + 55328 + 10);
	keyV = peek(sdat, sb + 55328 + 11);
	scaleV = peek(sdat, sb + 55328 + 12);
	srv = peek(sdat, sb + 55328 + 13);
	fNote = peek(sdat, sb + 55328 + 14);
	disp = peek(sdat, sb + 55328 + 15);
	first = peek(sdat, sb + 55328 + 17);
	onset = peek(sdat, sb + 55328 + 19);
	seed = peek(sdat, sb + 55328 + 20);
	stretch = peek(sdat, sb + 55328 + 29);
	off = ch * 2049;
	tau = 6.28318530718;
	scaleMask = (scaleV < 0.5) ? 2741 : 1453;
	for (j = 0; j <= nh; j += 1) {
		poke(sdat, 0, sb + 14340 + j);
	}
	for (k = 0; k <= nh; k += 1) {
		am = peek(sdat, sb + 8192 + k);
		if (am > 0.000000001) {
			wk = peek(sdat, sb + 10241 + k);
			rk = pr;
			if ((reharm > 0.5) && (k > 1.5 * kf)) {
				rk = rk * bendR;
				if (qMode > 0.5) {
					fOut = max(wk * rk * srv / tau, 1.0);
					rel = 12.0 * log2(fOut / fNote);
					tgt = 12.0 * round(rel / 12.0);
					if (qMode > 1.5) {
						midiAbs = 69.0 + 12.0 * log2(fOut / 440.0);
						rel12 = midiAbs - keyV;
						baseO = floor(rel12 / 12.0) * 12.0;
						xo = rel12 - baseO;
						bestD = 99.0;
						bestM = 0.0;
						for (mm = 0; mm <= 12; mm += 1) {
							okm = floor(scaleMask / pow(2, mm % 12)) % 2;
							dd = abs(xo - mm);
							if ((okm > 0.5) && (dd < bestD)) {
								bestD = dd;
								bestM = mm;
							}
						}
						tgt = (baseO + bestM + keyV) - (midiAbs - rel);
					}
					rk = rk * pow(2.0, (tgt - rel) * qAmt / 12.0);
				}
			}
			j = k + round(wk * (rk - 1.0) * n / tau);
			if ((j >= 0) && (j <= nh)) {
				ex = am;
				if (formOn > 0.5) {
					ex = am / (env_at(sdat, sb, k, nh, n, srv) + 0.000000001);
				}
				if (ex > peek(sdat, sb + 14340 + j)) {
					poke(sdat, ex, sb + 14340 + j);
					poke(sdat, wk * rk, sb + 16389 + j);
					poke(sdat, peek(sdat, sb + 22536 + (off + k)), sb + 18438 + j);
				}
			}
		}
	}
	jit = disp * clip((stretch - 1.0) / 6.0, 0, 1) * 3.14159265359;
	rs = seed;
	for (j = 0; j <= nh; j += 1) {
		a = peek(sdat, sb + 14340 + j);
		wj = (a > 0) ? peek(sdat, sb + 16389 + j) : (tau * j / n);
		ph = peek(sdat, sb + 26634 + (off + j));
		if (((first > 0.5) || (onset > 0.5)) && (a > 0)) {
			ph = peek(sdat, sb + 18438 + j);
		} else {
			rs = fract(rs * 7.31 + j * 0.6180339 + 0.137);
			ph = ph + wj * hs + (rs - 0.5) * 2.0 * jit;
		}
		ph = ph - tau * round(ph / tau);
		poke(sdat, ph, sb + 26634 + (off + j));
		amp = a;
		if ((formOn > 0.5) && (a > 0)) {
			amp = a * env_at(sdat, sb, j / fEff, nh, n, srv);
		}
		yr = amp * cos(ph);
		yi = amp * sin(ph);
		if ((j == 0) || (j == nh)) {
			yi = 0;
		}
		poke(sdat, yr, sb + 30732 + (off + j));
		poke(sdat, yi, sb + 34830 + (off + j));
	}
	return 0;
}

// Job: pack the two hermitian channel spectra into one complex spectrum (L + jR), bit-reversed for the IFFT.
job_pack(sdat, sb, brv) {
	n = peek(sdat, sb + 55328 + 0);
	nh = peek(sdat, sb + 55328 + 1);
	stride = peek(sdat, sb + 55328 + 26);
	for (k = 0; k <= nh; k += 1) {
		kk = (n - k) % n;
		lr = peek(sdat, sb + 30732 + k);
		li = peek(sdat, sb + 34830 + k);
		rr = peek(sdat, sb + 30732 + (2049 + k));
		ri = peek(sdat, sb + 34830 + (2049 + k));
		r1 = floor(peek(brv, k) / stride);
		r2 = floor(peek(brv, kk) / stride);
		poke(sdat, lr - ri, sb + r1);
		poke(sdat, li + rr, sb + 4096 + r1);
		poke(sdat, lr + ri, sb + r2);
		poke(sdat, rr - li, sb + 4096 + r2);
	}
	return 0;
}

// Job: synthesis Hann window and overlap-add into the L / R output rings (Hann^2 at 75% overlap = 1.5).
job_ola(sdat, sb, twr) {
	n = peek(sdat, sb + 55328 + 0);
	nh = peek(sdat, sb + 55328 + 1);
	stride = peek(sdat, sb + 55328 + 26);
	startPos = peek(sdat, sb + 55328 + 27);
	i0 = peek(sdat, sb + 55328 + 28);
	scl = 1.0 / (n * 1.5);
	for (i = i0; i < n; i += 1) {
		ci = (i <= nh) ? i : (n - i);
		w = (0.5 - 0.5 * peek(twr, ci * stride)) * scl;
		pos = wrap(startPos + i, 0, 8192);
		poke(sdat, peek(sdat, sb + 38928 + pos) + w * peek(sdat, sb + i), sb + 38928 + pos);
		poke(sdat, peek(sdat, sb + 47120 + pos) + w * peek(sdat, sb + 4096 + i), sb + 47120 + pos);
	}
	return 0;
}

// Spectral voice: phase-vocoder stretcher for one of the first 4 voices. Returns the stereo output, the
// normalised playhead and 0. Runs only while mode == 3 and the voice is held or releasing.
spec_voice(sampBuf, vdataBuf, twr, twi, brv, prm, sdat, vIdx, modeVal, freezeOn, playPosNorm, startNorm, endNorm, loopMode, loopStartNorm, loopEndNorm, reverseOn, rootMidi, pitchSt, fineCents, glideCoef, formantSt, speedIn, slicePlay, lfoSig, lfoPitchAmt, lfoPosAmt, menvPitchAmt, menvPosAmt, modEnvPrev, ampEnvPrev, numFrames, srVal) {
	sb = vIdx * 55392;
	prevTrig = peek(sdat, sb + 55360 + 0);
	wasOn = peek(sdat, sb + 55360 + 1);
	nCur = peek(sdat, sb + 55360 + 2);
	llog = peek(sdat, sb + 55360 + 3);
	hopN = peek(sdat, sb + 55360 + 4);
	jobCount = peek(sdat, sb + 55360 + 5);
	spacing = peek(sdat, sb + 55360 + 6);
	jobId = peek(sdat, sb + 55360 + 7);
	jobWait = peek(sdat, sb + 55360 + 8);
	hopCtr = peek(sdat, sb + 55360 + 9);
	rd = peek(sdat, sb + 55360 + 10);
	headN = peek(sdat, sb + 55360 + 11);
	dirS = peek(sdat, sb + 55360 + 12);
	stepPrev = peek(sdat, sb + 55360 + 13);
	finished = peek(sdat, sb + 55360 + 14);
	firstFrame = peek(sdat, sb + 55360 + 15);
	burstLeft = peek(sdat, sb + 55360 + 16);
	frameBurst = peek(sdat, sb + 55360 + 17);
	onsetHold = peek(sdat, sb + 55360 + 18);
	curNote = peek(sdat, sb + 55360 + 19);
	frameNo = peek(sdat, sb + 55360 + 20);
	onsetNow = peek(sdat, sb + 55360 + 21);

	nFr = max(numFrames, 1);
	baseSlot = vIdx * 8;
	vGate = peek(vdataBuf, baseSlot + 0);
	vNote = peek(vdataBuf, baseSlot + 1);
	vTrig = peek(vdataBuf, baseSlot + 3);
	voS = clip(peek(vdataBuf, baseSlot + 4), 0, 1);
	vE = clip(peek(vdataBuf, baseSlot + 5), 0, 1);
	vSeed = clip(peek(vdataBuf, baseSlot + 7), 0, 1);
	slicedFlag = peek(prm, 0);
	isOn = (round(clip(modeVal, 0, 4)) == 3) ? 1 : 0;
	effS, effE, sampS, sampE = slice_region(voS, vE, startNorm, endNorm, slicedFlag, slicePlay, reverseOn);
	act = ((isOn > 0.5) && ((vGate > 0.5) || (ampEnvPrev > 0.0004))) ? 1 : 0;
	isNewTrig = ((vTrig != prevTrig) && (vGate > 0.5)) ? 1 : 0;
	prevTrig = vTrig;
	qIdx = round(clip(peek(prm, 50), 0, 2));
	nWant = 1024 * pow(2, qIdx);
	dirSign = (reverseOn > 0.5) ? -1.0 : 1.0;
	posMod = lfoSig * lfoPosAmt * 0.45 + modEnvPrev * menvPosAmt * 0.45;
	speedUse = clip(speedIn, 0, 2);

	// Pitch (same recipe as voice_proc, one frame late for the Mod Env)
	curNote = mix(vNote, curNote, glideCoef);
	pSemis = pitchSt + fineCents * 0.01 + lfoSig * lfoPitchAmt * 24.0 + modEnvPrev * menvPitchAmt * 24.0;
	semis = ((slicedFlag > 0.5) ? 0.0 : (curNote - rootMidi)) + pSemis;
	pr = pow(2.0, clip(semis, -48, 48) / 12.0);
	noteSemi = ((slicedFlag > 0.5) ? rootMidi : curNote) + pSemis;
	fNote = 440.0 * pow(2.0, (noteSemi - 69.0) / 12.0);
	rootHz = 440.0 * pow(2.0, (rootMidi - 69.0) / 12.0);
	fmtSemi = formantSt * peek(prm, 41);
	fEff = pow(2.0, clip(fmtSemi, -48, 48) / 12.0) * ((peek(prm, 52) > 0.5) ? pr : 1.0);
	reharm = (peek(prm, 40) > 0.5) ? 1 : 0;
	bendR = (reharm > 0.5) ? pow(2.0, clip(peek(prm, 42), -24, 24) / 12.0) : 1.0;

	// Playhead behaviour: slice_play (Sliced) or the loop mode (Single).
	slicePlayId = round(clip(slicePlay, 0, 3));
	wmSl = (slicePlayId > 2.5) ? 2 : ((slicePlayId > 1.5) ? 1 : 0);
	wmLp = (loopMode > 1.5) ? 2 : ((loopMode > 0.5) ? 1 : 0);
	wmEff = (slicedFlag > 0.5) ? wmSl : wmLp;
	rlo = (slicedFlag > 0.5) ? effS : clip(loopStartNorm, effS, effE - 0.002);
	rhi = (slicedFlag > 0.5) ? effE : clip(loopEndNorm, rlo + 0.002, effE);

	doReset = ((isOn > 0.5) && ((isNewTrig > 0.5) || (nWant != nCur) || (wasOn < 0.5))) ? 1 : 0;
	wasOn = isOn;
	if (doReset > 0.5) {
		nCur = nWant;
		llog = 10 + qIdx;
		hopN = nCur * 0.25;
		jobCount = 2 * llog + 7;
		spacing = max(0, floor((hopN - 1) / (jobCount - 1)) - 1);
		for (ci = 0; ci < 8192; ci += 1) {
			poke(sdat, 0, sb + 38928 + ci);
			poke(sdat, 0, sb + 47120 + ci);
		}
		for (ci = 0; ci < 2049; ci += 1) {
			poke(sdat, 0, sb + 20487 + ci);
		}
		for (ci = 0; ci < 4098; ci += 1) {
			poke(sdat, 0, sb + 22536 + ci);
			poke(sdat, 0, sb + 26634 + ci);
		}
		rd = 0;
		jobId = jobCount;
		jobWait = 0;
		firstFrame = 1;
		finished = 0;
		stepPrev = 0;
		onsetHold = 0;
		curNote = vNote;
		dirS = dirSign;
		initN = (reverseOn > 0.5) ? effE : effS;
		liveOn = (peek(prm, 51) > 0.5) ? 1 : 0;
		burstLeft = (liveOn > 0.5) ? 4 : 0;
		headN = (liveOn > 0.5) ? (initN - dirSign * hopN * speedUse / nFr) : initN;
		hopCtr = hopN;
	}

	// Frame parameters for the jobs
	poke(sdat, nCur, sb + 55328 + 0);
	poke(sdat, nCur * 0.5, sb + 55328 + 1);
	poke(sdat, hopN, sb + 55328 + 2);
	poke(sdat, pr, sb + 55328 + 3);
	poke(sdat, fEff, sb + 55328 + 4);
	poke(sdat, peek(prm, 48), sb + 55328 + 5);
	poke(sdat, rootHz * nCur / srVal, sb + 55328 + 6);
	poke(sdat, bendR, sb + 55328 + 7);
	poke(sdat, reharm, sb + 55328 + 8);
	poke(sdat, round(clip(peek(prm, 43), 0, 2)), sb + 55328 + 9);
	poke(sdat, clip(peek(prm, 46), 0, 1), sb + 55328 + 10);
	poke(sdat, round(clip(peek(prm, 44), 0, 11)), sb + 55328 + 11);
	poke(sdat, round(clip(peek(prm, 45), 0, 1)), sb + 55328 + 12);
	poke(sdat, srVal, sb + 55328 + 13);
	poke(sdat, fNote, sb + 55328 + 14);
	poke(sdat, clip(peek(prm, 49), 0, 1), sb + 55328 + 15);
	poke(sdat, peek(prm, 47), sb + 55328 + 16);
	poke(sdat, onsetNow, sb + 55328 + 19);
	poke(sdat, fract(vSeed * 3.1 + frameNo * 0.137), sb + 55328 + 20);
	poke(sdat, effS * nFr, sb + 55328 + 23);
	poke(sdat, effE * nFr, sb + 55328 + 24);
	poke(sdat, nFr, sb + 55328 + 25);
	poke(sdat, 4096 / nCur, sb + 55328 + 26);
	poke(sdat, 1.0 / max(speedUse, 0.05), sb + 55328 + 29);
	poke(sdat, ((slicedFlag > 0.5) && (wmEff > 0.5)) ? wmEff : 0, sb + 55328 + 30);

	marginN = (nCur * 0.5 + hopN * 4.0 + 64.0) / nFr;
	if (jobWait > 0) {
		jobWait = jobWait - 1;
	}
	nrun = (act > 0.5) ? ((burstLeft > 0) ? (4 * jobCount + 4) : 1) : 0;
	for (q = 0; q < nrun; q += 1) {
		if (jobId >= jobCount) {
			due = ((burstLeft > 0) || (hopCtr >= hopN)) ? 1 : 0;
			if ((due > 0.5) && (finished < 0.5)) {
				startOff = hopN;
				frameBurst = 0;
				if (burstLeft > 0) {
					bk = 4 - burstLeft;
					burstLeft = burstLeft - 1;
					startOff = (bk - 3) * hopN;
					frameBurst = 1;
					hopCtr = (burstLeft == 0) ? hopN : 0;
				} else {
					hopCtr = 0;
				}
				stepF = hopN * ((onsetHold > 0.5) ? 1.0 : speedUse);
				cN = headN;
				haNow = stepPrev;
				if (freezeOn > 0.5) {
					cN = clip(effS + playPosNorm * (effE - effS) + posMod, effS, effE);
					haNow = 0;
				}
				poke(sdat, cN * nFr, sb + 55328 + 21);
				poke(sdat, dirS, sb + 55328 + 22);
				poke(sdat, firstFrame, sb + 55328 + 17);
				poke(sdat, haNow, sb + 55328 + 18);
				poke(sdat, wrap(rd + startOff, 0, 8192), sb + 55328 + 27);
				poke(sdat, max(0.0 - startOff, 0.0), sb + 55328 + 28);
				if (freezeOn < 0.5) {
					hn, dn, dd = head_step(headN, dirS, stepF / nFr, effS - marginN, effE + marginN, rlo, rhi, wmEff);
					headN = hn;
					dirS = dn;
					stepPrev = stepF;
					if ((dd > 0.5) && (wmEff < 0.5)) {
						finished = 1;
					}
				}
				firstFrame = 0;
				onsetHold = max(onsetHold - 1, 0);
				onsetNow = 0;
				frameNo = wrap(frameNo + 1, 0, 100000);
				jobId = 0;
				jobWait = 0;
			}
		}
		if (jobId < jobCount) {
			if ((frameBurst > 0.5) || (jobWait <= 0)) {
				jj = jobId;
				isFwd = ((jj >= 1) && (jj <= llog)) ? 1 : 0;
				isInv = ((jj >= llog + 6) && (jj <= 2 * llog + 5)) ? 1 : 0;
				if (jj == 0) {
					job_capture(sdat, sb, brv, twr, sampBuf);
				}
				if ((isFwd > 0.5) || (isInv > 0.5)) {
					sIdx = (isFwd > 0.5) ? jj : (jj - llog - 5);
					sg = (isFwd > 0.5) ? 1 : -1;
					fft_pass(sdat, sb, twr, twi, nCur, sIdx, sg);
				}
				if ((jj == llog + 1) || (jj == llog + 3)) {
					chA = (jj == llog + 1) ? 0 : 1;
					job_analyze(sdat, sb, chA);
					if (jj == llog + 1) {
						onsetNow = ((peek(prm, 47) > 0.5) && (peek(sdat, sb + 55328 + 17) < 0.5) && (peek(sdat, sb + 55312 + 0) > 0.35)) ? 1 : 0;
						if (onsetNow > 0.5) {
							onsetHold = 3;
						}
						poke(sdat, onsetNow, sb + 55328 + 19);
					}
				}
				if ((jj == llog + 2) || (jj == llog + 4)) {
					chM = (jj == llog + 2) ? 0 : 1;
					job_map(sdat, sb, chM);
				}
				if (jj == llog + 5) {
					job_pack(sdat, sb, brv);
				}
				if (jj == 2 * llog + 6) {
					job_ola(sdat, sb, twr);
				}
				jobId = jobId + 1;
				jobWait = spacing;
			}
		}
	}

	outL = 0;
	outR = 0;
	if (act > 0.5) {
		outL = peek(sdat, sb + 38928 + rd);
		outR = peek(sdat, sb + 47120 + rd);
		poke(sdat, 0, sb + 38928 + rd);
		poke(sdat, 0, sb + 47120 + rd);
		rd = wrap(rd + 1, 0, 8192);
		hopCtr = hopCtr + 1;
	}
	poke(sdat, prevTrig, sb + 55360 + 0);
	poke(sdat, wasOn, sb + 55360 + 1);
	poke(sdat, nCur, sb + 55360 + 2);
	poke(sdat, llog, sb + 55360 + 3);
	poke(sdat, hopN, sb + 55360 + 4);
	poke(sdat, jobCount, sb + 55360 + 5);
	poke(sdat, spacing, sb + 55360 + 6);
	poke(sdat, jobId, sb + 55360 + 7);
	poke(sdat, jobWait, sb + 55360 + 8);
	poke(sdat, hopCtr, sb + 55360 + 9);
	poke(sdat, rd, sb + 55360 + 10);
	poke(sdat, headN, sb + 55360 + 11);
	poke(sdat, dirS, sb + 55360 + 12);
	poke(sdat, stepPrev, sb + 55360 + 13);
	poke(sdat, finished, sb + 55360 + 14);
	poke(sdat, firstFrame, sb + 55360 + 15);
	poke(sdat, burstLeft, sb + 55360 + 16);
	poke(sdat, frameBurst, sb + 55360 + 17);
	poke(sdat, onsetHold, sb + 55360 + 18);
	poke(sdat, curNote, sb + 55360 + 19);
	poke(sdat, frameNo, sb + 55360 + 20);
	poke(sdat, onsetNow, sb + 55360 + 21);
	return fixnan(outL), fixnan(outR), clip(headN, 0, 1), 0;
}

// Single polyphonic voice processor (up to 8-voice stereo unison, Amp ADSR, Mod ADSR, 5 engines).
// Engine 3 (Spectral) takes its audio from spec_voice (extL / extR / extPos). New parameters come in
// through the prm table (see the main section for the layout).
voice_proc(
	sampBuf,
	vdataBuf,
	vIdx,
	modeVal,
	freezeOn,
	rootMidi,
	pitchSt,
	fineCents,
	playPosNorm,
	startNorm,
	endNorm,
	loopMode,
	loopStartNorm,
	loopEndNorm,
	xfadeNorm,
	reverseOn,
	grainSizeMs,
	grainMotion,
	grainSpray,
	formantSt,
	unisonCount,
	unisonDetune,
	unisonWidth,
	glideCoef,
	atkCoef,
	decCoef,
	susLevel,
	relCoef,
	matkCoef,
	mdecCoef,
	msusLevel,
	mrelCoef,
	velSens,
	lfoSig,
	lfoPitchAmt,
	lfoPosAmt,
	menvPitchAmt,
	menvPosAmt,
	numFrames,
	srVal,
	slicePlay,
	prm,
	vst,
	tbuf,
	vhist,
	extL,
	extR,
	extPos
) {
	stB = vIdx * 256;
	prevTrig = peek(vhist, stB + 0);
	envStage = peek(vhist, stB + 1);
	ampEnv = peek(vhist, stB + 2);
	modStage = peek(vhist, stB + 3);
	modEnv = peek(vhist, stB + 4);
	curNote = peek(vhist, stB + 5);
	playheadNorm = peek(vhist, stB + 6);
	grainPhs = peek(vhist, stB + 7);
	rndA = peek(vhist, stB + 8);
	rndB = peek(vhist, stB + 9);
	cycPhs0 = peek(vhist, stB + 10);
	cycPhs1 = peek(vhist, stB + 11);
	cycPhs2 = peek(vhist, stB + 12);
	cycPhs3 = peek(vhist, stB + 13);
	cycPhs4 = peek(vhist, stB + 14);
	cycPhs5 = peek(vhist, stB + 15);
	cycPhs6 = peek(vhist, stB + 16);
	cycPhs7 = peek(vhist, stB + 17);
	driftPhs = peek(vhist, stB + 18);
	formSm = peek(vhist, stB + 19);
	lastMode = peek(vhist, stB + 20);
	scanDir = peek(vhist, stB + 21);
	prevBS = peek(vhist, stB + 22);
	prevBE = peek(vhist, stB + 23);
	tailL = peek(vhist, stB + 24);
	tailR = peek(vhist, stB + 25);
	xfG = peek(vhist, stB + 26);
	lastSigL = peek(vhist, stB + 27);
	lastSigR = peek(vhist, stB + 28);
	headDone = peek(vhist, stB + 29);
	doneG = peek(vhist, stB + 30);
	spawnTmr = peek(vhist, stB + 31);
	spawnCnt = peek(vhist, stB + 32);
	altFlip = peek(vhist, stB + 33);
	rndCtr = peek(vhist, stB + 34);
	survG = peek(vhist, stB + 35);
	allocIdx = peek(vhist, stB + 36);
	survTimer = peek(vhist, stB + 37);

	gB = vIdx * 344;
	latB = gB + 320;
	mpB = gB + 336;
	baseSlot = vIdx * 8;
	vGate = peek(vdataBuf, baseSlot + 0);
	vNote = peek(vdataBuf, baseSlot + 1);
	vVel = clip(peek(vdataBuf, baseSlot + 2), 0, 1);
	vTrig = peek(vdataBuf, baseSlot + 3);
	vSliceStart = clip(peek(vdataBuf, baseSlot + 4), 0, 1);
	vSliceEnd = clip(peek(vdataBuf, baseSlot + 5), 0, 1);
	vPanSeed = clip(peek(vdataBuf, baseSlot + 6), -1, 1);
	vSeed = clip(peek(vdataBuf, baseSlot + 7), 0, 1);

	isNewTrig = (vTrig != prevTrig) && (vGate > 0.5);
	modeId = round(clip(modeVal, 0, 4));
	isSlice = (peek(prm, 0) > 0.5);

	// Play region. Sliced: the voice's slice bounds, read live from vdata every sample.
	slicePlayId = round(clip(slicePlay, 0, 3));
	revSlice = (reverseOn > 0.5);
	wmSlice = (slicePlayId > 2.5) ? 2 : ((slicePlayId > 1.5) ? 1 : 0);
	effStartNorm, effEndNorm, sampStartN, sampEndN = slice_region(vSliceStart, vSliceEnd, startNorm, endNorm, peek(prm, 0), slicePlay, reverseOn);

	hn = 0;
	dn = 1;
	dd = 0;

	if (isNewTrig) {
		prevTrig = vTrig;
		envStage = 1;
		modStage = 1;
		curNote = vNote;
		// Pos (play_pos) only matters while Freeze is on, which overrides the playhead anyway.
		initNorm = (reverseOn > 0.5) ? effEndNorm : effStartNorm;
		playheadNorm = initNorm;
		headDone = 0;
		doneG = 1;
		spawnTmr = 0;
	}

	if (vGate < 0.5) {
		envStage = 0;
		modStage = 0;
	}

	if ((envStage == 0) && (ampEnv < 0.00002)) {
		ampEnv = 0;
		modEnv = 0;
	}

	if (envStage == 1) {
		ampEnv = ampEnv + (1.05 - ampEnv) * (1.0 - atkCoef);
		if (ampEnv >= 1.0) {
			ampEnv = 1.0;
			envStage = 2;
		}
	} else if (envStage == 2) {
		ampEnv = susLevel + (ampEnv - susLevel) * decCoef;
	} else {
		ampEnv = ampEnv * relCoef;
	}
	ampEnv = clip(ampEnv, 0, 1);

	if (modStage == 1) {
		modEnv = modEnv + (1.05 - modEnv) * (1.0 - matkCoef);
		if (modEnv >= 1.0) {
			modEnv = 1.0;
			modStage = 2;
		}
	} else if (modStage == 2) {
		modEnv = msusLevel + (modEnv - msusLevel) * mdecCoef;
	} else {
		modEnv = modEnv * mrelCoef;
	}
	modEnv = clip(modEnv, 0, 1);

	curNote = mix(vNote, curNote, glideCoef);
	pitchSemiOffset = (isSlice ? 0 : (curNote - rootMidi))
		+ pitchSt
		+ fineCents * 0.01
		+ lfoSig * lfoPitchAmt * 24.0
		+ modEnv * menvPitchAmt * 24.0;
	baseRatio = pow(2.0, clip(pitchSemiOffset, -48, 48) / 12.0);
	// Sliced: the MIDI note picks the slice, so the pitch tracks the root key.
	hzNote = isSlice ? rootMidi : curNote;
	baseHz = 440.0 * pow(2.0, (hzNote - 69.0 + pitchSt + fineCents * 0.01 + lfoSig * lfoPitchAmt * 24.0 + modEnv * menvPitchAmt * 24.0) / 12.0);

	posMod = lfoSig * lfoPosAmt * 0.45 + modEnv * menvPosAmt * 0.45;
	startF = effStartNorm * numFrames;
	endF = effEndNorm * numFrames;
	spanNorm = max(effEndNorm - effStartNorm, 0.002);
	lStartF = clip(loopStartNorm, effStartNorm, effEndNorm - 0.002) * numFrames;
	lEndF = clip(loopEndNorm, loopStartNorm + 0.002, effEndNorm) * numFrames;

	uCount = int(clip(round(unisonCount), 1, 8));
	uNormGain = 1.0 / sqrt(max(uCount, 1));
	dirSign = (reverseOn > 0.5) ? -1.0 : 1.0;
	driftPhs = fract(driftPhs + (0.22 + vSeed * 0.18) / max(srVal, 1));

	formTarget = pow(2.0, clip(formantSt, -24, 24) / 12.0);
	needInit = isNewTrig || (lastMode != modeId);
	if (needInit) {
		scanDir = (dirSign < 0.0) ? -1.0 : 1.0;
		driftPhs = fract(vSeed + 0.17);
		formSm = formTarget;
		grainPhs = fract(vSeed * 3.71);
		rndA = fract(vSeed * 17.31 + 0.13);
		rndB = fract(vSeed * 43.19 + 0.57);
		if (((isNewTrig) && (peek(prm, 30) < 0.5)) || (lastMode != modeId)) {
			for (gi = 0; gi < 320; gi += 1) {
				poke(vst, 0, gB + gi);
			}
		}
	} else {
		formSm = formSm + (formTarget - formSm) * 0.0018;
	}
	lastMode = modeId;

	// Slice behaviour of the Repitch engine: 0 to slice end and 1 to sample end play once, 2 loops, 3 ping-pongs.
	effLoopMode = isSlice ? ((slicePlayId > 2.5) ? 2 : ((slicePlayId > 1.5) ? 1 : 0)) : loopMode;
	effLStart = isSlice ? startF : lStartF;
	effLEnd = isSlice ? endF : lEndF;
	xfEff = isSlice ? max(xfadeNorm, 0.02) : xfadeNorm;

	// Live slice bounds: the UI may re-poke slots 4/5 of a held voice without a new trigger.
	// Repitch: a playhead that ends up outside the new bounds restarts at the new slice start
	// (end when reversed) through a short held-tail crossfade; one-shots that already passed the end
	// simply stay finished. The other engines jump to the new start when the bounds changed and the
	// playhead is outside them.
	jumped = 0;
	ppRemap = 0;
	curF = playheadNorm * numFrames;
	oldBsF = 0;
	oldBeF = 0;
	oldFold = 0;
	jumpTo = 0;
	liveSlice = isSlice && (needInit == 0) && (vGate > 0.5) && (freezeOn < 0.5);
	if (liveSlice) {
		if (modeId < 0.5) {
			if (effLoopMode > 1.5) {
				if (abs(effStartNorm - prevBS) + abs(effEndNorm - prevBE) > 0.0000001) {
					ppRemap = 1;
					oldBsF = prevBS * numFrames;
					oldBeF = prevBE * numFrames;
					oldFold = pp_pos(curF, oldBsF, oldBeF);
					jumped = ((oldFold < startF - 1.0) || (oldFold > endF + 1.0)) ? 1 : 0;
					playheadNorm = pp_remap(curF, oldBsF, oldBeF, startF, endF, dirSign) / max(numFrames, 1);
				}
			} else {
				jumpTo = (revSlice ? endF : startF);
				farSide = (revSlice ? (curF < startF - 1.0) : (curF > endF + 1.0));
				nearSide = (revSlice ? (curF > endF + 1.0) : (curF < startF - 1.0));
				if (nearSide || (farSide && (effLoopMode > 0.5))) {
					jumped = 1;
					playheadNorm = jumpTo / max(numFrames, 1);
				}
			}
		} else if ((modeId < 2.5) || (modeId > 3.5)) {
			if (abs(effStartNorm - prevBS) + abs(effEndNorm - prevBE) > 0.0000001) {
				if ((playheadNorm < effStartNorm - 0.0001) || (playheadNorm > effEndNorm + 0.0001)) {
					jumped = 1;
					headDone = 0;
					scanDir = dirSign;
					playheadNorm = revSlice ? effEndNorm : effStartNorm;
				}
			}
		}
	}
	prevBS = effStartNorm;
	prevBE = effEndNorm;
	origin = playheadNorm * numFrames;

	sigL = 0;
	sigR = 0;
	aliveCnt = 0;

	if (modeId < 0.5) {
		// ---------------- REPITCH ----------------
		spanF = max(effLEnd - effLStart, 4);
		xfF = min(spanF * clip(xfEff, 0, 0.45), spanF * 0.5);
		// Gen scopes a name to the if that first assigns it. Seed both so the
		// loop below can read them on every path.
		periodF = spanF;
		loopBottom = effLStart;
		if (xfF > 2.0) {
			periodF = max(spanF - xfF, 4);
			loopBottom = effLStart + xfF;
		}
		posModFrames = posMod * numFrames;
		playFrames = playheadNorm * numFrames;

		if (freezeOn > 0.5) {
			playFrames = clip(effStartNorm + playPosNorm * spanNorm + posMod, effStartNorm, effEndNorm) * numFrames;
		} else {
			prevFrames = playheadNorm * numFrames;
			playFrames = prevFrames + dirSign * baseRatio;
			if (effLoopMode > 1.5) {
				if (isSlice || (playFrames >= effLStart)) {
					playFrames = effLStart + wrap(playFrames - effLStart, 0, spanF * 2.0);
				}
			} else if (effLoopMode > 0.5) {
				if ((dirSign > 0.0) && (playFrames >= effLEnd) && (prevFrames >= effLStart)) {
					playFrames = loopBottom + wrap(playFrames - effLEnd, 0, periodF);
				} else if ((dirSign < 0.0) && (playFrames < loopBottom) && (prevFrames >= loopBottom)) {
					playFrames = effLEnd - (loopBottom - playFrames);
					if (playFrames < loopBottom) {
						playFrames = loopBottom + wrap(playFrames - loopBottom, 0, periodF);
					}
				}
			} else {
				playFrames = clip(playFrames, -8, numFrames + 8);
			}
		}
		playheadNorm = playFrames / max(numFrames, 1);

		for (u = 0; u < 8; u += 1) {
			pCur = (u == 0) ? cycPhs0 : ((u == 1) ? cycPhs1 : ((u == 2) ? cycPhs2 : ((u == 3) ? cycPhs3 : ((u == 4) ? cycPhs4 : ((u == 5) ? cycPhs5 : ((u == 6) ? cycPhs6 : cycPhs7))))));
			if (needInit || (jumped > 0.5)) {
				pCur = origin;
			} else if (ppRemap > 0.5) {
				pCur = pp_remap(pCur, oldBsF, oldBeF, startF, endF, dirSign);
			}
			pNext = pCur;
			if (u < uCount) {
				uFrac, detRatio = unison_spread(u, uCount, unisonDetune, driftPhs, vSeed);
				pan = clip(uFrac * unisonWidth + vPanSeed * 0.15, -1, 1);
				gL = sqrt(0.5 * (1.0 - pan));
				gR = sqrt(0.5 * (1.0 + pan));
				uChorus = sin(6.28318530718 * fract(driftPhs * 1.37 + u * 0.125 + vSeed)) * unisonDetune * 12.0;
				readPos = pCur;

				if (freezeOn > 0.5) {
					pNext = playFrames;
					readPos = playFrames + uFrac * unisonDetune * 28.0;
				} else {
					stepped = pCur + dirSign * baseRatio * detRatio;
					pNext = stepped;
					readPos = stepped + uChorus + posModFrames;
					if (effLoopMode > 1.5) {
						if (isSlice || (readPos >= effLStart)) {
							readPos = effLStart + wrap(readPos - effLStart, 0, spanF * 2.0);
							pNext = readPos - uChorus - posModFrames;
						}
					} else if (effLoopMode > 0.5) {
						if ((dirSign > 0.0) && (readPos >= effLEnd) && (pCur >= effLStart)) {
							readPos = loopBottom + wrap(readPos - effLEnd, 0, periodF);
							pNext = readPos - uChorus - posModFrames;
						} else if ((dirSign < 0.0) && (readPos < loopBottom) && (pCur >= loopBottom)) {
							readPos = effLEnd - (loopBottom - readPos);
							if (readPos < loopBottom) {
								readPos = loopBottom + wrap(readPos - loopBottom, 0, periodF);
							}
							pNext = readPos - uChorus - posModFrames;
						}
					} else {
						pNext = clip(stepped, -8, numFrames + 8);
						readPos = pNext + uChorus + posModFrames;
					}
				}

				uL, uR = read_repitch(sampBuf, readPos, startF, endF, effLStart, effLEnd, effLoopMode, xfEff, numFrames);
				sigL = sigL + uL * gL * uNormGain;
				sigR = sigR + uR * gR * uNormGain;
			}
			cycPhs0 = (u == 0) ? pNext : cycPhs0;
			cycPhs1 = (u == 1) ? pNext : cycPhs1;
			cycPhs2 = (u == 2) ? pNext : cycPhs2;
			cycPhs3 = (u == 3) ? pNext : cycPhs3;
			cycPhs4 = (u == 4) ? pNext : cycPhs4;
			cycPhs5 = (u == 5) ? pNext : cycPhs5;
			cycPhs6 = (u == 6) ? pNext : cycPhs6;
			cycPhs7 = (u == 7) ? pNext : cycPhs7;
		}

		// Repitch characters: 1 Analog, 2 Digital
		rpChar = round(clip(peek(prm, 1), 0, 2));
		if (rpChar > 0.5) {
			rpDist = clip(peek(prm, 2), 0, 1);
			rpColor = clip(peek(prm, 3), -1, 1);
			if (rpChar < 1.5) {
				aL = analog_chan(sigL, rpDist, rpColor, baseRatio, srVal, vhist, stB + 64);
				aR = analog_chan(sigR, rpDist, rpColor, baseRatio, srVal, vhist, stB + 72);
				sigL, sigR = tape_st(aL, aR, rpColor, baseRatio, srVal, tbuf, vIdx * 8192, vhist, stB + 80);
			} else {
				sigL, sigR = digital_st(sigL, sigR, rpDist, rpColor, baseRatio, peek(prm, 4), peek(prm, 5), srVal, vhist, stB + 96);
			}
		}
	} else if (modeId < 1.5) {
		// ---------------- CYCLES ----------------
		if (freezeOn > 0.5) {
			playheadNorm = clip(effStartNorm + playPosNorm * spanNorm + posMod, effStartNorm, effEndNorm);
		} else if (isSlice) {
			// Sliced: natural-speed scan, with the slice_play end behaviour.
			hn, dn, dd = head_step(playheadNorm, scanDir, abs(grainMotion) / max(numFrames, 1), effStartNorm, effEndNorm, effStartNorm, effEndNorm, wmSlice);
			playheadNorm = hn;
			scanDir = dn;
			if ((dd > 0.5) && (wmSlice < 0.5)) {
				headDone = 1;
			}
		} else {
			playheadNorm = playheadNorm + scanDir * abs(grainMotion) * 0.35 / max(srVal, 1);
			if (playheadNorm >= effEndNorm) {
				playheadNorm = effEndNorm - (playheadNorm - effEndNorm);
				scanDir = -1;
			} else if (playheadNorm < effStartNorm) {
				playheadNorm = effStartNorm + (effStartNorm - playheadNorm);
				scanDir = 1;
			}
			playheadNorm = clip(playheadNorm, effStartNorm, effEndNorm);
		}
		anchorNorm = clip(playheadNorm + ((freezeOn > 0.5) ? 0.0 : posMod), effStartNorm, effEndNorm);
		rootHz = 440.0 * pow(2.0, (rootMidi - 69.0) / 12.0);
		cycleLenF = clip(srVal / max(rootHz, 20.0), 32.0, 8192.0);
		halfRead = cycleLenF * max(formSm, 1.0) * 0.5;
		anchorTop = max(numFrames - 1 - halfRead, 0);
		anchorF = max(numFrames - 1, 1) * 0.5;
		if (anchorTop > halfRead) {
			anchorF = clip(anchorNorm * max(numFrames - 1, 1), halfRead, anchorTop);
		}
		cyChar = round(clip(peek(prm, 6), 0, 2));
		cyDuty = 0.5 + 0.45 * clip(peek(prm, 7), -1, 1);
		cySplit = clip(peek(prm, 8), -1, 1);
		cyFund = clip(peek(prm, 9), 0, 1);
		cyMod = clip(peek(prm, 10), 0, 1);
		cyHarm = clip(peek(prm, 11), -1, 1);
		cyXf = peek(prm, 12);
		harmRatio = (cyHarm >= 0) ? (1.0 + round(cyHarm * 7.0)) : (1.0 / (1.0 + round(0.0 - cyHarm * 3.0)));
		maxIdxC = max(numFrames - 1, 1);

		for (u = 0; u < 8; u += 1) {
			pCur = (u == 0) ? cycPhs0 : ((u == 1) ? cycPhs1 : ((u == 2) ? cycPhs2 : ((u == 3) ? cycPhs3 : ((u == 4) ? cycPhs4 : ((u == 5) ? cycPhs5 : ((u == 6) ? cycPhs6 : cycPhs7))))));
			if (needInit) {
				pCur = (u == 0) ? 0.0 : ((u == 1) ? 0.02 : ((u == 2) ? 0.05 : ((u == 3) ? 0.09 : ((u == 4) ? 0.14 : ((u == 5) ? 0.20 : ((u == 6) ? 0.27 : 0.35))))));
				poke(vst, anchorF, latB + u);
				poke(vst, anchorF, latB + 8 + u);
				poke(vst, 0, mpB + u);
			}
			pCur = fract(pCur);
			pNext = pCur;
			if (u < uCount) {
				uFrac, detRatio = unison_spread(u, uCount, unisonDetune, driftPhs, vSeed);
				pan = clip(uFrac * unisonWidth + vPanSeed * 0.15, -1, 1);
				gL = sqrt(0.5 * (1.0 - pan));
				gR = sqrt(0.5 * (1.0 + pan));
				phsInc = clip((baseHz * detRatio) / max(srVal, 1), 0, 0.45);
				pNext = fract(pCur + phsInc);
				pB = fract(pNext + 0.5);
				pBprev = fract(pCur + 0.5);
				wA = 0.5 - 0.5 * cos(6.28318530718 * pNext);
				wB = 0.5 - 0.5 * cos(6.28318530718 * pB);
				// Both grains read the SAME phase (pNext); only the window (offset 0.5) and the latched anchor differ.
					// Reading B at pNext + 0.5 made a periodic source sum to -sin(2x) (an octave up).
					// Crossfade two voices: each window latches the anchor at its own cycle start.
				ancA = anchorF;
				ancB = anchorF;
				if (cyXf > 0.5) {
					if (pNext < pCur) {
						poke(vst, anchorF, latB + u);
					}
					if (pB < pBprev) {
						poke(vst, anchorF, latB + 8 + u);
					}
					ancA = peek(vst, latB + u);
					ancB = peek(vst, latB + 8 + u);
				}
				// Phase character: dirty-sine modulator at a stepped multiple of the pitch.
				pmV = 0;
				if (cyChar > 1.5) {
					mph = fract(peek(vst, mpB + u) + phsInc * harmRatio);
					poke(vst, mph, mpB + u);
					pmV = cyMod * 0.5 * (sin(6.28318530718 * mph) + 0.28 * sin(6.28318530718 * 3.0 * mph + 0.9) + 0.12 * sin(6.28318530718 * 5.0 * mph));
				}
				aL, aR = cyc_wave(sampBuf, ancA, cycleLenF, formSm, pNext, cyChar, cyDuty, cySplit, pmV, maxIdxC);
				bL, bR = cyc_wave(sampBuf, ancB, cycleLenF, formSm, pNext, cyChar, cyDuty, cySplit, pmV, maxIdxC);
				cL = aL * wA + bL * wB;
				cR = aR * wA + bR * wB;
				if ((cyChar > 0.5) && (cyChar < 1.5)) {
					fundS = sin(6.28318530718 * pNext) * 0.5;
					cL = mix(cL, fundS, cyFund);
					cR = mix(cR, fundS, cyFund);
				}
				sigL = sigL + cL * gL * uNormGain;
				sigR = sigR + cR * gR * uNormGain;
			}
			cycPhs0 = (u == 0) ? pNext : cycPhs0;
			cycPhs1 = (u == 1) ? pNext : cycPhs1;
			cycPhs2 = (u == 2) ? pNext : cycPhs2;
			cycPhs3 = (u == 3) ? pNext : cycPhs3;
			cycPhs4 = (u == 4) ? pNext : cycPhs4;
			cycPhs5 = (u == 5) ? pNext : cycPhs5;
			cycPhs6 = (u == 6) ? pNext : cycPhs6;
			cycPhs7 = (u == 7) ? pNext : cycPhs7;
		}
	} else if (modeId < 2.5) {
		// ---------------- TEXTURES ----------------
		if (freezeOn > 0.5) {
			playheadNorm = clip(effStartNorm + playPosNorm * spanNorm + posMod, effStartNorm, effEndNorm);
		} else if (isSlice) {
			hn, dn, dd = head_step(playheadNorm, scanDir, abs(grainMotion * baseRatio) / max(numFrames, 1), effStartNorm, effEndNorm, effStartNorm, effEndNorm, wmSlice);
			playheadNorm = hn;
			scanDir = dn;
			if ((dd > 0.5) && (wmSlice < 0.5)) {
				headDone = 1;
			}
		} else {
			motionStep = dirSign * grainMotion * baseRatio / max(numFrames, 1);
			playheadNorm = playheadNorm + motionStep;
			if (playheadNorm >= effEndNorm) {
				playheadNorm = effEndNorm - (playheadNorm - effEndNorm);
			} else if (playheadNorm < effStartNorm) {
				playheadNorm = effStartNorm + (effStartNorm - playheadNorm);
			}
			playheadNorm = clip(playheadNorm, effStartNorm, effEndNorm);
		}
		centerNorm = clip(playheadNorm + ((freezeOn > 0.5) ? 0.0 : posMod), effStartNorm, effEndNorm);
		centerF = centerNorm * numFrames;

		gLenSamps = max(grainSizeMs * 0.001 * srVal, 8.0);
		gRate = baseRatio / gLenSamps;
		if (gRate > 0.45) {
			gRate = 0.45;
		}
		if (gRate < 0.0) {
			gRate = 0.0;
		}
		prevG = grainPhs;
		grainPhs = fract(grainPhs + gRate);
		if (grainPhs < prevG) {
			rndA = fract(rndA * 29.17 + 0.31 + vSeed * 0.07);
		}
		grainPhsB = fract(grainPhs + 0.5);
		if (abs(grainPhs - 0.5) < gRate) {
			rndB = fract(rndB * 37.91 + 0.19 + vSeed * 0.11);
		}
		winA = 0.5 - 0.5 * cos(6.28318530718 * grainPhs);
		winB = 0.5 - 0.5 * cos(6.28318530718 * grainPhsB);
		spraySpanF = grainSpray * 0.65 * max(endF - startF, 0);
		maxIdxG = max(numFrames - 1, 1);

		for (u = 0; u < 8; u += 1) {
			if (u < uCount) {
				uFrac, detRatio = unison_spread(u, uCount, unisonDetune, driftPhs, vSeed);
				pan = clip(uFrac * unisonWidth + vPanSeed * 0.15, -1, 1);
				gL = sqrt(0.5 * (1.0 - pan));
				gR = sqrt(0.5 * (1.0 + pan));
				uChorus = sin(6.28318530718 * fract(driftPhs * 1.37 + u * 0.125 + vSeed)) * unisonDetune * 18.0;
				sprA = (fract(rndA + u * 0.173 + vSeed * 0.31) - 0.5) * spraySpanF;
				sprB = (fract(rndB + u * 0.271 + vSeed * 0.47) - 0.5) * spraySpanF;
				travelA = (grainPhs - 0.5) * gLenSamps * dirSign * detRatio;
				travelB = (grainPhsB - 0.5) * gLenSamps * dirSign * detRatio;
				idxA = clip(centerF + uChorus + travelA + sprA, startF, endF);
				idxB = clip(centerF + uChorus + travelB + sprB, startF, endF);
				aL, aR = peek_lr(sampBuf, idxA, maxIdxG);
				bL, bR = peek_lr(sampBuf, idxB, maxIdxG);
				sigL = sigL + (aL * winA + bL * winB) * gL * uNormGain;
				sigR = sigR + (aR * winA + bR * winB) * gR * uNormGain;
			}
		}
	} else if (modeId < 3.5) {
		// ---------------- SPECTRAL (audio computed by spec_voice) ----------------
		playheadNorm = extPos;
		sigL = extL;
		sigR = extR;
	} else {
		// ---------------- FRAGMENTS ----------------
		frLenS = max(grainSizeMs * 0.001 * srVal, 16.0);
		if (peek(prm, 26) > 0.5) {
			// Sync: snap the grain size to a power-of-two fraction / multiple of a beat.
			beatMs = 60000.0 / clip(peek(prm, 31), 20, 999);
			frLenS = max(beatMs * pow(2.0, round(log2(max(grainSizeMs, 1.0) / beatMs))) * 0.001 * srVal, 16.0);
		}
		frDens = (peek(prm, 23) > 0.5) ? clip(peek(prm, 22), 0.1, 100) : 1.0;
		frRep = floor(clip(peek(prm, 21), 1, 16) + 0.5);
		frMaxGr = floor(clip(peek(prm, 25), 1, 32) + 0.5);
		frMot = clip(peek(prm, 24), 0, 8);
		frPk = clip(peek(prm, 20), 0, 1);
		frDirMode = round(clip(peek(prm, 27), 0, 3));
		frLatch = peek(prm, 28);
		frRepInit = peek(prm, 29);
		frSurv = peek(prm, 30);
		maxIdxF = max(numFrames - 1, 1);

		// Playhead
		if (freezeOn > 0.5) {
			playheadNorm = clip(effStartNorm + playPosNorm * spanNorm + posMod, effStartNorm, effEndNorm);
		} else {
			wmFr = isSlice ? wmSlice : ((loopMode > 1.5) ? 2 : ((loopMode > 0.5) ? 1 : 0));
			rloF = isSlice ? effStartNorm : clip(loopStartNorm, effStartNorm, effEndNorm - 0.002);
			rhiF = isSlice ? effEndNorm : clip(loopEndNorm, rloF + 0.002, effEndNorm);
			hn, dn, dd = head_step(playheadNorm, scanDir, abs(grainMotion) / max(numFrames, 1), effStartNorm, effEndNorm, rloF, rhiF, wmFr);
			playheadNorm = hn;
			scanDir = dn;
			if ((dd > 0.5) && (wmFr < 0.5)) {
				headDone = 1;
			}
		}

		// Spawn
		spawnTmr = spawnTmr - 1;
		if ((spawnTmr <= 0) && (vGate > 0.5) && (headDone < 0.5)) {
			spawnTmr = spawnTmr + max(frLenS / frDens, 1.0);
			if (spawnTmr < 1.0) {
				spawnTmr = 1.0;
			}
			baseP = playheadNorm * numFrames + ((freezeOn > 0.5) ? 0.0 : posMod * numFrames);
			gScale = 1.0 / sqrt(max(1.0, 0.5 * min(frDens * frRep, frMaxGr)));
			for (rp = 0; rp < 16; rp += 1) {
				if (rp < frRep - 0.5) {
					// Round-robin pool: when it is full the oldest grain is replaced.
					slot = floor(allocIdx - frMaxGr * floor(allocIdx / frMaxGr));
					allocIdx = allocIdx + 1;
					rndCtr = rndCtr + 3;
					rA = rnd01(rndCtr + vSeed * 91.7);
					rB = rnd01(rndCtr + 1.0 + vSeed * 17.3);
					rC = rnd01(rndCtr + 2.0 + vSeed * 53.9);
					if (slot >= 0) {
						altFlip = 0.0 - altFlip;
						dsel = (frDirMode < 0.5) ? dirSign : ((frDirMode < 1.5) ? scanDir : ((frDirMode < 2.5) ? ((rC < 0.5) ? -1.0 : 1.0) : altFlip));
						uIdx = spawnCnt % uCount;
						uFrac, detRatio = unison_spread(uIdx, uCount, unisonDetune, driftPhs, vSeed);
						pan = clip(uFrac * unisonWidth + vPanSeed * 0.15 + (rB - 0.5) * 2.0 * clip(frMot, 0, 1), -1, 1);
						jitterP = (rA - 0.5) * 2.0 * frMot * frLenS * abs(baseRatio);
						pStart = baseP + jitterP;
						if ((frRepInit < 0.5) && (rp > 0)) {
							pStart = pStart + dsel * rp * frLenS * abs(baseRatio);
						}
						b = slot * 10;
						poke(vst, 1, gB + b + 0);
						poke(vst, 0.0 - rp * frLenS, gB + b + 1);
						poke(vst, frLenS, gB + b + 2);
						poke(vst, pStart, gB + b + 3);
						poke(vst, dsel * detRatio, gB + b + 4);
						poke(vst, sqrt(0.5 * (1.0 - pan)) * gScale, gB + b + 5);
						poke(vst, sqrt(0.5 * (1.0 + pan)) * gScale, gB + b + 6);
						poke(vst, frPk, gB + b + 7);
						poke(vst, abs(baseRatio), gB + b + 8);
						spawnCnt = spawnCnt + 1;
					}
				}
			}
			survTimer = max(survTimer, frRep * frLenS);
		}

		survTimer = max(survTimer - 1, 0);

		// Render the pool
		for (gi = 0; gi < 32; gi += 1) {
			b = gi * 10;
			if (peek(vst, gB + b) > 0.5) {
				ageG = peek(vst, gB + b + 1);
				lenG = peek(vst, gB + b + 2);
				if (ageG >= 0) {
					if (ageG >= lenG) {
						poke(vst, 0, gB + b);
					} else {
						wG = fr_win(ageG / lenG, peek(vst, gB + b + 7));
						rateG = peek(vst, gB + b + 4) * ((frLatch > 0.5) ? peek(vst, gB + b + 8) : abs(baseRatio));
						rpos = peek(vst, gB + b + 3) + rateG * ageG;
						if ((rpos >= startF) && (rpos <= endF)) {
							gl, gr = peek_lr(sampBuf, rpos, maxIdxF);
							sigL = sigL + gl * wG * peek(vst, gB + b + 5);
							sigR = sigR + gr * wG * peek(vst, gB + b + 6);
						}
					}
				}
				poke(vst, ageG + 1, gB + b + 1);
			}
		}
	}

	// Held-tail crossfade after a live jump: the last output decays while the new read fades in.
	if (jumped > 0.5) {
		tailL = lastSigL;
		tailR = lastSigR;
		xfG = 0;
	}
	sigL = sigL * xfG + tailL;
	sigR = sigR * xfG + tailR;
	tailL = tailL * 0.94;
	tailR = tailR * 0.94;
	xfG = min(1.0, xfG + 0.01);
	lastSigL = sigL;
	lastSigR = sigR;

	// Sliced one-shots end: fade out once the playhead has reached the end (Fragments let their grains finish).
	doneG = doneG + (((headDone > 0.5) ? 0.0 : 1.0) - doneG) * 0.01;
	endGain = (modeId > 3.5) ? 1.0 : doneG;

	velGain = mix(1.0, vVel, clip(velSens, 0, 1));
	// Fragments "survive": the grains in flight keep the level the voice had at release.
	if ((vGate > 0.5) || (modeId < 3.5) || (peek(prm, 30) < 0.5)) {
		survG = ampEnv;
	} else if (survTimer <= 0) {
		survG = 0;
	}
	envOut = ((modeId > 3.5) && (peek(prm, 30) > 0.5)) ? max(ampEnv, survG) : ampEnv;
	finalGain = envOut * velGain * endGain;
	// Ping-pong slices keep an unfolded phase; report the folded position.
	ppTele = isSlice && (modeId < 0.5) && (effLoopMode > 1.5) && (freezeOn < 0.5);
	outPosNorm = clip(ppTele ? (pp_pos(playheadNorm * numFrames, startF, endF) / max(numFrames, 1)) : playheadNorm, 0, 1);
	poke(vhist, prevTrig, stB + 0);
	poke(vhist, envStage, stB + 1);
	poke(vhist, ampEnv, stB + 2);
	poke(vhist, modStage, stB + 3);
	poke(vhist, modEnv, stB + 4);
	poke(vhist, curNote, stB + 5);
	poke(vhist, playheadNorm, stB + 6);
	poke(vhist, grainPhs, stB + 7);
	poke(vhist, rndA, stB + 8);
	poke(vhist, rndB, stB + 9);
	poke(vhist, cycPhs0, stB + 10);
	poke(vhist, cycPhs1, stB + 11);
	poke(vhist, cycPhs2, stB + 12);
	poke(vhist, cycPhs3, stB + 13);
	poke(vhist, cycPhs4, stB + 14);
	poke(vhist, cycPhs5, stB + 15);
	poke(vhist, cycPhs6, stB + 16);
	poke(vhist, cycPhs7, stB + 17);
	poke(vhist, driftPhs, stB + 18);
	poke(vhist, formSm, stB + 19);
	poke(vhist, lastMode, stB + 20);
	poke(vhist, scanDir, stB + 21);
	poke(vhist, prevBS, stB + 22);
	poke(vhist, prevBE, stB + 23);
	poke(vhist, tailL, stB + 24);
	poke(vhist, tailR, stB + 25);
	poke(vhist, xfG, stB + 26);
	poke(vhist, lastSigL, stB + 27);
	poke(vhist, lastSigR, stB + 28);
	poke(vhist, headDone, stB + 29);
	poke(vhist, doneG, stB + 30);
	poke(vhist, spawnTmr, stB + 31);
	poke(vhist, spawnCnt, stB + 32);
	poke(vhist, altFlip, stB + 33);
	poke(vhist, rndCtr, stB + 34);
	poke(vhist, survG, stB + 35);
	poke(vhist, allocIdx, stB + 36);
	poke(vhist, survTimer, stB + 37);
	return fixnan(sigL * finalGain), fixnan(sigR * finalGain), outPosNorm, ampEnv, modEnv, spawnCnt;
}

// Buffers
Buffer samp("bsamp");
Buffer vdata("bsvoices");
Buffer scope("bsscope");

// Shared tables and the new-parameter table (layout below)
Data twr(2049);
Data twi(2049);
Data brv(4096);
Data prm(64);
Data vst(5504);
Data vhist(4096);
Data sext(12);
Data vres(48);
Data tbuf(131072);
Data sdat(221568);

// Parameters
Param mode(0, min=0, max=4);
Param sliced(0, min=0, max=1);
Param freeze(0, min=0, max=1);
Param root_note(60, min=0, max=127);
Param pitch_st(0, min=-36, max=36);
Param fine_cents(0, min=-100, max=100);
Param play_pos(0, min=0, max=1);
Param samp_start(0, min=0, max=1);
Param samp_end(1, min=0, max=1);
Param loop_mode(0, min=0, max=2);
Param loop_start(0.1, min=0, max=1);
Param loop_end(0.9, min=0, max=1);
Param loop_xfade(0.05, min=0, max=0.45);
Param reverse(0, min=0, max=1);
Param slice_play(0, min=0, max=3);

// Granular / Cycles parameters
Param grain_size(65, min=5, max=500);
Param grain_motion(1.0, min=0, max=2);
Param grain_spray(0.15, min=0, max=1);
Param formant(0, min=-24, max=24);

// Repitch characters
Param rp_char(0, min=0, max=2);
Param rp_dist(0, min=0, max=1);
Param rp_color(0, min=-1, max=1);
Param rp_vsr(0, min=0, max=1);
Param rp_imaging(1, min=0, max=1);

// Cycles characters
Param cy_char(0, min=0, max=2);
Param cy_width(0, min=-1, max=1);
Param cy_split(0, min=-1, max=1);
Param cy_fund(0, min=0, max=1);
Param cy_mod(0, min=0, max=1);
Param cy_harm(0, min=-1, max=1);
Param cy_xfade(0, min=0, max=1);

// Spectral
Param sp_char(0, min=0, max=1);
Param sp_shift(1.0, min=0.01, max=1.22);
Param sp_bend(0, min=-24, max=24);
Param sp_quant(0, min=0, max=2);
Param sp_key(0, min=0, max=11);
Param sp_scale(0, min=0, max=1);
Param sp_quant_amt(1.0, min=0.01, max=1);
Param sp_onsets(0, min=0, max=1);
Param sp_formant_on(1, min=0, max=1);
Param sp_dispersion(0.667, min=0, max=1);
Param sp_quality(1, min=0, max=2);
Param sp_live(1, min=0, max=1);
Param sp_rel_formant(0, min=0, max=1);

// Fragments
Param fr_env(0.5, min=0, max=1);
Param fr_repeats(1, min=1, max=16);
Param fr_density(4.0, min=0.1, max=100);
Param fr_use_density(1, min=0, max=1);
Param fr_motion(0, min=0, max=8);
Param fr_max_grains(256, min=1, max=256);
Param fr_sync(0, min=0, max=1);
Param fr_direction(1, min=0, max=3);
Param fr_latch(1, min=0, max=1);
Param fr_repeat_init(0, min=0, max=1);
Param fr_survive(0, min=0, max=1);
Param tempo(120, min=20, max=999);

// Unison & Voicing
Param unison_voices(1, min=1, max=8);
Param unison_detune(0.15, min=0, max=1);
Param unison_width(0.65, min=0, max=1);
Param glide_ms(0, min=0, max=1000);
Param vel_sens(0.7, min=0, max=1);

// Amp ADSR (ms & 0..1)
Param atk_ms(2.5, min=0.2, max=5000);
Param dec_ms(250, min=1, max=10000);
Param sus_lvl(0.85, min=0, max=1);
Param rel_ms(140, min=1, max=10000);

// Mod / Filter ADSR (ms & 0..1)
Param matk_ms(5.0, min=0.2, max=5000);
Param mdec_ms(320, min=1, max=10000);
Param msus_lvl(0.25, min=0, max=1);
Param mrel_ms(220, min=1, max=10000);

// Multimode SVF Filter + Drive
Param filt_on(1, min=0, max=1);
Param filt_type(0, min=0, max=2);
Param filt_cutoff(18000, min=20, max=20000);
Param filt_res(0.15, min=0, max=0.95);
Param filt_drive(0.0, min=0, max=1);
Param filt_env_amt(0.0, min=-1, max=1);

// Internal LFO & Mod Matrix
Param lfo_rate(2.0, min=0.05, max=30);
Param lfo_shape(0, min=0, max=3);
Param lfo_pitch(0.0, min=-1, max=1);
Param lfo_filt(0.0, min=-1, max=1);
Param lfo_pos(0.0, min=-1, max=1);
Param menv_pitch(0.0, min=-1, max=1);
Param menv_pos(0.0, min=-1, max=1);

// Master Output
Param out_gain(0.0, min=-36, max=18);

// Global state histories
History initDone(0);
History lfoPhs(0);
History lfoSH(0);
History svfLpL(0);
History svfBpL(0);
History svfLpR(0);
History svfBpR(0);
History scopeCount(0);
History scopeFrame(0);
History peakHoldL(0);
History peakHoldR(0);

if (initDone == 0) {
	init_tables(twr, twi, brv);
	// Spectral voice History initial values.
	for (isv = 0; isv < 4; isv += 1) {
		poke(sdat, -1, isv * 55392 + 55360 + 0);
		poke(sdat, 2048, isv * 55392 + 55360 + 2);
		poke(sdat, 11, isv * 55392 + 55360 + 3);
		poke(sdat, 512, isv * 55392 + 55360 + 4);
		poke(sdat, 29, isv * 55392 + 55360 + 5);
		poke(sdat, 99, isv * 55392 + 55360 + 7);
		poke(sdat, 1, isv * 55392 + 55360 + 12);
		poke(sdat, 1, isv * 55392 + 55360 + 14);
		poke(sdat, 1, isv * 55392 + 55360 + 15);
		poke(sdat, 60, isv * 55392 + 55360 + 19);
	}
	// Per-voice History initial values (the vhist table starts at 0).
	for (ivx = 0; ivx < 16; ivx += 1) {
		poke(vhist, -1, ivx * 256 + 0);
		poke(vhist, 60, ivx * 256 + 5);
		poke(vhist, 0.17, ivx * 256 + 8);
		poke(vhist, 0.63, ivx * 256 + 9);
		poke(vhist, 0.13, ivx * 256 + 11);
		poke(vhist, 0.29, ivx * 256 + 12);
		poke(vhist, 0.47, ivx * 256 + 13);
		poke(vhist, 0.61, ivx * 256 + 14);
		poke(vhist, 0.73, ivx * 256 + 15);
		poke(vhist, 0.83, ivx * 256 + 16);
		poke(vhist, 0.97, ivx * 256 + 17);
		poke(vhist, 0.2, ivx * 256 + 18);
		poke(vhist, 1, ivx * 256 + 19);
		poke(vhist, -1, ivx * 256 + 20);
		poke(vhist, 1, ivx * 256 + 21);
		poke(vhist, -1, ivx * 256 + 22);
		poke(vhist, -1, ivx * 256 + 23);
		poke(vhist, 1, ivx * 256 + 26);
		poke(vhist, 1, ivx * 256 + 30);
		poke(vhist, 1, ivx * 256 + 33);
		poke(vhist, 0.31, ivx * 256 + 82);
		poke(vhist, 0.17, ivx * 256 + 83);
		poke(vhist, 0.64, ivx * 256 + 84);
	}
	initDone = 1;
}

srVal = max(samplerate, 8000);
numFrames = max(dim(samp), 1);

// New-parameter table (read by voice_proc / spec_voice):
//   0 sliced, 1 rp_char, 2 rp_dist, 3 rp_color, 4 rp_vsr, 5 rp_imaging,
//   6 cy_char, 7 cy_width, 8 cy_split, 9 cy_fund, 10 cy_mod, 11 cy_harm, 12 cy_xfade,
//   20 fr_env, 21 fr_repeats, 22 fr_density, 23 fr_use_density, 24 fr_motion, 25 fr_max_grains,
//   26 fr_sync, 27 fr_direction, 28 fr_latch, 29 fr_repeat_init, 30 fr_survive, 31 tempo,
//   40 sp_char, 41 sp_shift, 42 sp_bend, 43 sp_quant, 44 sp_key, 45 sp_scale, 46 sp_quant_amt,
//   47 sp_onsets, 48 sp_formant_on, 49 sp_dispersion, 50 sp_quality, 51 sp_live, 52 sp_rel_formant
poke(prm, sliced, 0);
poke(prm, rp_char, 1);
poke(prm, rp_dist, 2);
poke(prm, rp_color, 3);
poke(prm, rp_vsr, 4);
poke(prm, rp_imaging, 5);
poke(prm, cy_char, 6);
poke(prm, cy_width, 7);
poke(prm, cy_split, 8);
poke(prm, cy_fund, 9);
poke(prm, cy_mod, 10);
poke(prm, cy_harm, 11);
poke(prm, cy_xfade, 12);
poke(prm, fr_env, 20);
poke(prm, fr_repeats, 21);
poke(prm, fr_density, 22);
poke(prm, fr_use_density, 23);
poke(prm, fr_motion, 24);
poke(prm, fr_max_grains, 25);
poke(prm, fr_sync, 26);
poke(prm, fr_direction, 27);
poke(prm, fr_latch, 28);
poke(prm, fr_repeat_init, 29);
poke(prm, fr_survive, 30);
poke(prm, tempo, 31);
poke(prm, sp_char, 40);
poke(prm, sp_shift, 41);
poke(prm, sp_bend, 42);
poke(prm, sp_quant, 43);
poke(prm, sp_key, 44);
poke(prm, sp_scale, 45);
poke(prm, sp_quant_amt, 46);
poke(prm, sp_onsets, 47);
poke(prm, sp_formant_on, 48);
poke(prm, sp_dispersion, 49);
poke(prm, sp_quality, 50);
poke(prm, sp_live, 51);
poke(prm, sp_rel_formant, 52);

// Compute global LFO (-1..+1): 0=Sine, 1=Triangle, 2=Saw, 3=S&H
prevLfoPhs = lfoPhs;
lfoPhs = fract(lfoPhs + clip(lfo_rate, 0.02, 40) / srVal);
if (lfoPhs < prevLfoPhs) {
	lfoSH = fract(sin(scopeFrame * 12.9898 + 78.233) * 43758.5453) * 2.0 - 1.0;
}
lfoSin = sin(6.28318530718 * lfoPhs);
lfoTri = 1.0 - 4.0 * abs(fract(lfoPhs + 0.25) - 0.5);
lfoSaw = 2.0 * lfoPhs - 1.0;
shIdx = round(clip(lfo_shape, 0, 3));
lfoSig = (shIdx == 0) ? lfoSin : ((shIdx == 1) ? lfoTri : ((shIdx == 2) ? lfoSaw : lfoSH));

// Envelope & Glide coefficients
atkCoef = exp(-1000.0 / (max(atk_ms, 0.2) * srVal));
decCoef = exp(-1000.0 / (max(dec_ms, 1.0) * srVal));
relCoef = exp(-1000.0 / (max(rel_ms, 1.0) * srVal));
matkCoef = exp(-1000.0 / (max(matk_ms, 0.2) * srVal));
mdecCoef = exp(-1000.0 / (max(mdec_ms, 1.0) * srVal));
mrelCoef = exp(-1000.0 / (max(mrel_ms, 1.0) * srVal));
glideCoef = (glide_ms <= 0.5) ? 0.0 : exp(-1000.0 / (glide_ms * srVal));

// Spectral voices (voices 0..3 only), one loop so the phase vocoder compiles once. The Mod / Amp envelope of
// the previous sample comes from vres (written by the voice loop below).
for (svx = 0; svx < 4; svx += 1) {
	sL, sR, sP, sZ = spec_voice(samp, vdata, twr, twi, brv, prm, sdat, svx, mode, freeze, play_pos, samp_start, samp_end, loop_mode, loop_start, loop_end, reverse, root_note, pitch_st, fine_cents, glideCoef, formant, grain_motion, slice_play, lfoSig, lfo_pitch, lfo_pos, menv_pitch, menv_pos, peek(vres, svx * 3 + 2), peek(vres, svx * 3 + 1), numFrames, srVal);
	poke(sext, sL, svx * 3);
	poke(sext, sR, svx * 3 + 1);
	poke(sext, sP, svx * 3 + 2);
}


// Evaluate all 16 polyphonic voices in ONE loop, so the voice engine is compiled once. Per-voice state
// lives in the vhist table (voice_proc) and per-voice results in vres (P, A, M at 3 * voice).
sumL = 0;
sumR = 0;
spawnSum = 0;
maxModEnv = 0;
for (vox = 0; vox < 16; vox += 1) {
	exL = 0;
	exR = 0;
	exP = 0;
	if (vox < 3.5) {
		exL = peek(sext, vox * 3);
		exR = peek(sext, vox * 3 + 1);
		exP = peek(sext, vox * 3 + 2);
	}
	// A voice that is released, silent and has no Fragments tail left produces exact zeros, so skip its engine
	// (state is frozen until the next note-on, which re-initialises it). vhist slots: 1 envStage, 2 ampEnv,
	// 4 modEnv, 6 playheadNorm, 32 spawnCnt, 35 survG, 37 survTimer.
	hsB = vox * 256;
	idleV = (peek(vdata, vox * 8) < 0.5) && (peek(vhist, hsB + 1) == 0) && (peek(vhist, hsB + 2) == 0) && (peek(vhist, hsB + 4) == 0) && (peek(vhist, hsB + 35) <= 0) && (peek(vhist, hsB + 37) <= 0);
	if (idleV) {
		voL = 0;
		voR = 0;
		voP = peek(vhist, hsB + 6);
		voA = 0;
		voM = 0;
		voS = peek(vhist, hsB + 32);
	} else {
		voL, voR, voP, voA, voM, voS = voice_proc(samp, vdata, vox, mode, freeze, root_note, pitch_st, fine_cents, play_pos, samp_start, samp_end, loop_mode, loop_start, loop_end, loop_xfade, reverse, grain_size, grain_motion, grain_spray, formant, unison_voices, unison_detune, unison_width, glideCoef, atkCoef, decCoef, sus_lvl, relCoef, matkCoef, mdecCoef, msus_lvl, mrelCoef, vel_sens, lfoSig, lfo_pitch, lfo_pos, menv_pitch, menv_pos, numFrames, srVal, slice_play, prm, vst, tbuf, vhist, exL, exR, exP);
	}
	sumL = sumL + voL;
	sumR = sumR + voR;
	spawnSum = spawnSum + voS;
	maxModEnv = max(maxModEnv, voM);
	poke(vres, voP, vox * 3);
	poke(vres, voA, vox * 3 + 1);
	poke(vres, voM, vox * 3 + 2);
}

// Cytomic / Andrew Simper trapezoidal SVF. g = tan(pi * fc / sr).
// k falls from 2 (no resonance) toward 0 as filt_res rises, and stays positive.
targetCut = filt_cutoff * pow(2.0, clip(filt_env_amt * maxModEnv * 5.0 + lfoSig * lfo_filt * 3.5, -6, 6));
targetCut = clip(targetCut, 20.0, srVal * 0.45);
cutCoef = exp(-1.0 / (0.002 * srVal));
effCutHz = clip(slew_val(targetCut, cutCoef), 20.0, srVal * 0.44);
filtCoef = exp(-1.0 / (0.006 * srVal));
filtMix = clip(slew_val((filt_on > 0.5) ? 1.0 : 0.0, filtCoef), 0, 1);

driveAmt = clip(filt_drive, 0, 1);
driveGain = 1.0 + driveAmt * 5.0;
satL = tanh(sumL * driveGain);
satR = tanh(sumR * driveGain);
drivenL = sumL + (satL - sumL) * driveAmt;
drivenR = sumR + (satR - sumR) * driveAmt;

g = tan(3.141592653589793 * effCutHz / srVal);
k = 2.0 - 1.92 * pow(clip(filt_res, 0, 0.96), 0.7);
k = max(k, 0.05);
g = clip(g, 0.0001, 80.0);
a1 = 1.0 / (1.0 + g * (g + k));
a2 = g * a1;
a3 = g * a2;

v3 = drivenL - svfLpL;
v1 = a1 * svfBpL + a2 * v3;
v2 = svfLpL + a2 * svfBpL + a3 * v3;
svfBpL = fixnan(2.0 * v1 - svfBpL);
svfLpL = fixnan(2.0 * v2 - svfLpL);
lpL = v2;
bpL = v1 * k;
hpL = drivenL - k * v1 - v2;

v3 = drivenR - svfLpR;
v1 = a1 * svfBpR + a2 * v3;
v2 = svfLpR + a2 * svfBpR + a3 * v3;
svfBpR = fixnan(2.0 * v1 - svfBpR);
svfLpR = fixnan(2.0 * v2 - svfLpR);
lpR = v2;
bpR = v1 * k;
hpR = drivenR - k * v1 - v2;

fType = round(clip(filt_type, 0, 2));
wetL = (fType == 0) ? lpL : ((fType == 1) ? bpL : hpL);
wetR = (fType == 0) ? lpR : ((fType == 1) ? bpR : hpR);
wetL = fixnan(wetL);
wetR = fixnan(wetR);
sumL = sumL + (wetL - sumL) * filtMix;
sumR = sumR + (wetR - sumR) * filtMix;

// Master Output Gain + Soft Ceiling
masterGain = pow(10.0, clip(out_gain, -36, 18) / 20.0);
outL = fixnan(tanh(sumL * masterGain));
outR = fixnan(tanh(sumR * masterGain));

out1 = outL;
out2 = outR;

// Telemetry buffer write every 64 samples
peakHoldL = max(peakHoldL * 0.9985, abs(outL));
peakHoldR = max(peakHoldR * 0.9985, abs(outR));
scopeCount = scopeCount + 1;
if (scopeCount >= 64) {
	scopeCount = 0;
	scopeFrame = scopeFrame + 1;

	activeCnt = 0;
	for (tix = 0; tix < 16; tix += 1) {
		poke(scope, peek(vres, tix * 3), tix);
		poke(scope, peek(vres, tix * 3 + 1), 16 + tix);
		activeCnt = activeCnt + (peek(vres, tix * 3 + 1) > 0.002);
	}

	poke(scope, peakHoldL, 32);
	poke(scope, peakHoldR, 33);
	poke(scope, activeCnt, 34);
	poke(scope, lfoSig, 35);
	poke(scope, maxModEnv, 36);
	poke(scope, effCutHz, 37);
	poke(scope, numFrames, 38);
	poke(scope, scopeFrame, 39);
	poke(scope, spawnSum, 48);
}
