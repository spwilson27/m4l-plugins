// Better Sampler — 16-Voice Polyphonic + Up to 8-Voice Stereo Unison Multi-Engine Sampler.
//
// Engines (mode: 0..4) and Single / Sliced (sliced: 0 / 1, orthogonal to the engine):
//   0 = REPITCH   : Varispeed playback. Forward loops use an equal-power sin/cos crossfade,
//                   ping-pong folds the read position (sample-continuous). Characters (rp_char):
//                   Clean, Analog (rp_dist saturation with pre/post EQ, rp_color stereo tape),
//                   Digital (rp_dist bit reduction, rp_color sample-rate reduction, rp_vsr,
//                   rp_imaging).
//   1 = CYCLES    : One source period per cycle, resampled to the note period (pitch locked to the key, time
//                   independent), with formant stretch. Consecutive cycles are joined by an overlap-add crossfade
//                   (the old cycle keeps reading the source past its end while the new one fades in; the new
//                   start is searched for the best match), not a switch. cy_xfade lengthens the overlap (0.5 -> 0.6).
//                   Characters (cy_char): Pulse (cy_width), Partials (cy_split, cy_fund) and Phase (cy_mod, cy_harm).
//   2 = TEXTURES  : Dual overlap-add Hann granular cloud with spray, unison detune and pan.
//   3 = SPECTRAL  : Phase-vocoder stretching: Speed (grain_motion) is decoupled from pitch.
//                   Computed OUTSIDE voice_proc by spec_voice() for voices 0..3 only (see below).
//
// Compile time: GenExpr inlines every call, so voice_proc and spec_voice are each called from ONE loop
// (16 voices / 4 spectral voices). A function cannot hold per-call-site state in a loop, so all their
// History lives in Data: vhist (256 slots per voice: voice_proc 0..37, frozen Repitch 40..42, analog 64..79, tape 80..84,
// digital 96..110) and sdat (one block per spectral voice: FFT work arrays, jp and 22 History slots). vst is 400 slots per
// voice: 0..319 Fragments grain pool, 320..359 Cycles / Textures latches (anchors, lengths, phase modulator), 360..391 Cycles
// overlap state (match, overlap fraction, how the previous cycle continues, closed flag; 8 unison voices each).
// Released, silent voices skip voice_proc altogether.
//   4 = FRAGMENTS : Playful granular: a pool of up to 32 grains per voice (fr_max_grains is
//                   capped at 32), density, repeats, envelope shape, motion randomisation.
//
// Sliced (sliced = 1): every engine plays the voice's slice bounds. They are read live from vdata
// slots 4/5, and `slice_play` picks the behaviour: 0 to slice end (once), 1 to sample end
// (slice start .. samp_end), 2 one-way loop, 3 ping-pong loop. Pitch ignores the MIDI note (the note
// picks the slice). Pos (`play_pos`) only matters while Freeze is on.
//
// Single (sliced = 0): `loop_mode` (0 Off, 1 Fwd, 2 Ping-Pong) applies to EVERY engine. Off plays start .. end once
// and the voice goes silent (the playhead stops and the voice fades), Fwd wraps inside loop_start .. loop_end,
// Ping-Pong bounces there. Cycles and Textures scan their playhead the same way (Cycles slowly, Textures at
// the note's speed). Textures grains latch the playhead when their window starts, so the scan speed does not add to
// the grain's own read speed (natural speed once sounded an octave high).
//
// Spectral limits (CPU budget): at most 4 Spectral voices (vdata voices 0..3, the rest are silent in
// Spectral mode). FFT 1024 / 2048 / 4096 by sp_quality (Low / Medium / High), 75% overlap, one FFT
// pass or one O(N) slice of work per sample (the Cepstra pattern, time-sliced across each hop).
// sp_live = On bursts the first 4 frames at note-on (no latency, one CPU spike); Off ramps in.
//
// Buffers (bound on loadbang via `samp #0-bsamp, vdata #0-bsvoices, scope #0-bsscope`):
//   samp   ("bsamp")    : Audio sample buffer (1 or 2 channels; mono plays on both outputs)
//   vdata  ("bsvoices") : 128-sample control table (16 voices x 8 slots):
//     slot + 0 : gate (0 = released, 1 = held)
//     slot + 1 : target MIDI note (0..127)
//     slot + 2 : velocity (0..1)
//     slot + 3 : trigger counter (increments on note-on retrigger; legato pitch changes keep counter)
//     slot + 4 : slice start normalized (0..1)
//     slot + 5 : slice end normalized (0..1)
//     slot + 6 : voice stereo pan seed (-1..+1)
//     slot + 7 : voice random seed (0..1)
//   scope  ("bsscope")  : 128-sample UI telemetry buffer:
//     0..15  : per-voice normalized playhead position (0..1)
//     16..31 : per-voice amplitude envelope level (0..1)
//     32 / 33: output peak L / R
//     34     : active voice count (0..16)
//     35     : current LFO value (-1..+1)
//     36     : current Mod Env value (0..1)
//     37     : effective filter cutoff in Hz
//     38     : loaded sample frame count (dim(samp))
//     39     : rolling telemetry frame counter
//     40..47 : the running values of sliced, loop_mode, slice_play, mode, freeze, reverse, root_note, loop_start
//              (test telemetry: proves the device's parameter messages reached the gen)
//     48     : Fragments grains started (all voices, cumulative; test telemetry)
//     49     : Analyzed Root Key active (root_dyn on and the pitch buffer bound; test telemetry)
//     64..95 : grain lines: read position (0..1 of the whole sample, -1 = unused slot) of the up to 32 loudest grains of all
//              voices (Textures and Fragments)
//     96..127: their window level times the voice gain (0..1)
//
// GenExpr rules strictly enforced:
//   - All helper functions appear before Buffer, Data, Param, History, and expression statements.
//   - No identifier is named e<digit> (Euler's constant lexer bug).
//   - No Param is named after a GenExpr builtin.

slew_val(target, coef) {
	History s(0);
	History is_init(0);
	s = (is_init == 0) ? target : mix(target, s, coef);
	is_init = 1;
	return s;
}

peek_lr(sampBuf, idx, maxIdx) {
	iClamped = clip(idx, 0, maxIdx);
	// channelmode="clamp": a 1-channel (mono) buffer returns channel 0 for the
	// right read too, so mono samples play identically on both outputs.
	smpL = peek(sampBuf, iClamped, 0, interp="linear", boundmode="clamp", channelmode="clamp");
	smpR = peek(sampBuf, iClamped, 1, interp="linear", boundmode="clamp", channelmode="clamp");
	return smpL, smpR;
}

rnd01(sd) {
	// fract() of a negative number is negative in GenExpr (x - trunc(x)): use x - floor(x) so the result is 0..1
	hx = sin(sd * 12.9898 + 78.233) * 43758.5453;
	return hx - floor(hx);
}

// One-pole coefficient for a cutoff in Hz.
op_coef(fc, sr) {
	return 1.0 - exp(-6.28318530718 * clip(fc, 5, sr * 0.45) / sr);
}

// Wavetable 4-frame morph (Sine -> Triangle -> Saw -> Square)
wt_base(ph, pos01) {
	wbP = fract(ph);
	wSin = sin(6.28318530718 * wbP);
	wTri = 1.0 - 4.0 * abs(fract(wbP + 0.25) - 0.5);
	wSaw = 2.0 * wbP - 1.0;
	wSqr = (wbP < 0.5) ? 1.0 : -1.0;
	wbM = clip(pos01, 0, 1) * 3.0;
	wbOut = wSin;
	if (wbM <= 1.0) {
		wbOut = wSin + (wTri - wSin) * wbM;
	} else if (wbM <= 2.0) {
		wbOut = wTri + (wSaw - wTri) * (wbM - 1.0);
	} else {
		wbOut = wSaw + (wSqr - wSaw) * (wbM - 2.0);
	}
	return wbOut;
}

// Wavetable oscillator with native Wavetable wave effects:
//   fxMode: 0 = None, 1 = Fm (Tune / Amt), 2 = Classic (PW / Sync), 3 = Modern (Warp / Fold)
wt_osc_eval(ph, pos01, fxMode, fx1, fx2) {
	woP = fract(ph);
	effP = woP;
	woM = round(clip(fxMode, 0, 3));
	if (woM == 1) {
		modRatio = pow(2.0, clip(fx1, -1, 1) * 2.0);
		effP = fract(woP + clip(fx2, 0, 1) * 0.65 * sin(6.28318530718 * fract(woP * modRatio)));
	} else if (woM == 2) {
		duty = clip(0.5 + 0.45 * clip(fx1, -1, 1), 0.05, 0.95);
		pPw = (woP < duty) ? (0.5 * woP / duty) : (0.5 + 0.5 * (woP - duty) / (1.0 - duty));
		syncR = 1.0 + clip(fx2, 0, 1) * 7.0;
		effP = fract(pPw * syncR);
	} else if (woM == 3) {
		warpAmt = clip(fx1, -1, 1);
		if (abs(warpAmt) > 0.0005) {
			effP = pow(clip(woP, 0.0, 1.0), pow(3.0, 0.0 - warpAmt));
		}
	}
	woVal = wt_base(effP, pos01);
	if (woM == 3) {
		foldAmt = clip(fx2, 0, 1);
		if (foldAmt > 0.0005) {
			woVal = sin(1.57079632679 * woVal * (1.0 + foldAmt * 5.0));
		}
	}
	return woVal;
}

// Analyzed Root Key: the MIDI root at normalised sample position `pos`. With the curve on (dynOn 1: root_dyn on and
// #0-bspitch bound, set in the main section) it is the linearly interpolated 4096-point pitch curve; otherwise, or
// where the curve holds no pitch (an unfilled buffer reads 0), the static root_note.
root_at(pbuf, pos, rootMidi, dynOn) {
	rt = rootMidi;
	if (dynOn > 0.5) {
		cv = peek(pbuf, clip(pos, 0, 1) * 4095.0, 0, interp="linear", boundmode="clamp");
		if (cv > 0.5) {
			rt = cv;
		}
	}
	return rt;
}

// Folded read position of a ping-pong phase that lives in [ps, ps + 2 * span).
pp_pos(ph, ps, pe) {
	spn = max(pe - ps, 4);
	mm = wrap(ph - ps, 0, spn * 2.0);
	return (mm <= spn) ? (ps + mm) : (ps + spn - (mm - spn));
}

// Re-express a ping-pong phase for new slice bounds so the folded position and travel
// direction stay put. A position outside the new bounds restarts at the new slice start
// (forward) or end (reverse).
pp_remap(ph, oldS, oldE, newS, newE, dirS) {
	oSpn = max(oldE - oldS, 4);
	nSpn = max(newE - newS, 4);
	mm = wrap(ph - oldS, 0, oSpn * 2.0);
	oldPos = (mm <= oSpn) ? (oldS + mm) : (oldS + oSpn - (mm - oSpn));
	upward = (mm <= oSpn) ? (dirS > 0) : (dirS < 0);
	firstHalf = (upward == (dirS > 0));
	inside = (oldPos >= newS) && (oldPos <= newS + nSpn);
	nm = firstHalf ? (oldPos - newS) : (nSpn + newS + nSpn - oldPos);
	nm = clip(nm, 0, nSpn * 2.0);
	return inside ? (newS + nm) : (newS + ((dirS > 0) ? 0.0 : nSpn));
}

// uFrac in [-1, 1] and a pitch ratio. Detune breathes with driftPhs so the stack is not static.
unison_spread(u, uCount, unisonDetune, driftPhs, vSeed) {
	uFrac = (uCount > 1) ? ((u / (uCount - 1.0)) * 2.0 - 1.0) : 0.0;
	uDrift = sin(6.28318530718 * fract(driftPhs + u * 0.125 + vSeed * 0.41));
	detSemi = uFrac * unisonDetune * 0.72 + uDrift * unisonDetune * 0.16;
	detRatio = pow(2.0, clip(detSemi, -1.25, 1.25) / 12.0);
	return uFrac, detRatio;
}

// Effective play region (normalised). Sliced: the voice's slice bounds, extended to the sample
// start / end for "to sample end". Single: start .. end.
slice_region(voS, vE, startNorm, endNorm, slicedFlag, slicePlay, reverseOn) {
	slicePlayId = round(clip(slicePlay, 0, 3));
	revSlice = (reverseOn > 0.5);
	toSampleEnd = (slicePlayId > 0.5) && (slicePlayId < 1.5);
	sampStartN = clip(min(startNorm, endNorm - 0.005), 0, 0.995);
	sampEndN = clip(max(endNorm, sampStartN + 0.005), 0.005, 1.0);
	sliceEndN = max(vE, voS + 0.005);
	sliceLoN = (toSampleEnd && revSlice) ? min(sampStartN, sliceEndN - 0.005) : voS;
	sliceHiN = (toSampleEnd && (revSlice == 0)) ? max(sampEndN, voS + 0.005) : sliceEndN;
	effS = (slicedFlag > 0.5) ? sliceLoN : sampStartN;
	effE = (slicedFlag > 0.5) ? sliceHiN : sampEndN;
	return effS, effE, sampStartN, sampEndN;
}

// Playhead step for the non-Repitch engines. wm: 0 stop at lo / hi, 1 wrap in [rlo, rhi], 2 ping-pong in
// [rlo, rhi]. Returns the new position, the new direction and a done flag (reached lo / hi while stopping).
head_step(pos, dir, stepN, lo, hi, rlo, rhi, wm) {
	p = pos + dir * stepN;
	d2 = dir;
	done = 0;
	if (wm > 1.5) {
		if ((dir > 0) && (p >= rhi) && (pos >= rlo)) {
			p = rhi - (p - rhi);
			d2 = -1;
		} else if ((dir < 0) && (p <= rlo) && (pos <= rhi)) {
			p = rlo + (rlo - p);
			d2 = 1;
		}
	} else if (wm > 0.5) {
		if ((dir > 0) && (p >= rhi) && (pos >= rlo)) {
			p = rlo + wrap(p - rhi, 0, max(rhi - rlo, 0.0001));
		} else if ((dir < 0) && (p <= rlo) && (pos <= rhi)) {
			p = rhi - wrap(rlo - p, 0, max(rhi - rlo, 0.0001));
		}
	}
	if (p >= hi) {
		p = hi;
		done = (d2 > 0) ? 1 : 0;
	}
	if (p <= lo) {
		p = lo;
		done = (d2 < 0) ? 1 : 0;
	}
	return p, d2, done;
}

// Stereo reader. Forward loops (loopMode == 1) equal-power crossfade the tail
// into the head: cos fades the outgoing pass, sin fades the restart.
// The audible period is (span - xfLen); the first pass still plays the head.
read_repitch(sampBuf, posFrames, startF, endF, loopStartF, loopEndF, loopMode, xfadeFrac, numFrames) {
	maxIdx = max(numFrames - 1, 1);
	outL = 0;
	outR = 0;
	handled = 0;

	if (loopMode > 0.5) {
		lStart = clip(min(loopStartF, loopEndF - 4), 0, maxIdx);
		lEnd = clip(max(loopEndF, lStart + 4), 1, maxIdx);
		span = max(lEnd - lStart, 4);

		if (posFrames >= lStart) {
			handled = 1;
			if (loopMode >= 1.5) {
				period2 = span * 2.0;
				m = wrap(posFrames - lStart, 0, period2);
				readF = (m <= span) ? (lStart + m) : (lEnd - (m - span));
				pL, pR = peek_lr(sampBuf, readF, maxIdx);
				outL = pL;
				outR = pR;
			} else {
				xfLen = min(span * clip(xfadeFrac, 0, 0.45), span * 0.5);
				if (xfLen <= 2.0) {
					readF = lStart + wrap(posFrames - lStart, 0, span);
					hL, hR = peek_lr(sampBuf, readF, maxIdx);
					outL = hL;
					outR = hR;
				} else {
					period = max(span - xfLen, 4);
					relAbs = posFrames - lStart;
					if (relAbs >= span) {
						relAbs = xfLen + wrap(relAbs - span, 0, period);
					}
					if (relAbs >= (span - xfLen)) {
						fadeT = clip((relAbs - (span - xfLen)) / xfLen, 0, 1);
						gTail = cos(fadeT * 1.5707963);
						gHead = sin(fadeT * 1.5707963);
						posTail = lStart + relAbs;
						posHead = lStart + (relAbs - (span - xfLen));
						tL, tR = peek_lr(sampBuf, posTail, maxIdx);
						hL, hR = peek_lr(sampBuf, posHead, maxIdx);
						outL = tL * gTail + hL * gHead;
						outR = tR * gTail + hR * gHead;
					} else {
						linL, linR = peek_lr(sampBuf, lStart + relAbs, maxIdx);
						outL = linL;
						outR = linR;
					}
				}
			}
		}
	}

	if (handled == 0) {
		if ((posFrames >= startF) && (posFrames <= endF)) {
			spanR = max(endF - startF, 1);
			edgeSamps = min(24.0, spanR * 0.25);
			distIn = min(posFrames - startF, endF - posFrames);
			edgeG = (edgeSamps <= 1.0) ? 1.0 : sin(clip(distIn / edgeSamps, 0, 1) * 1.5707963);
			oL, oR = peek_lr(sampBuf, posFrames, maxIdx);
			outL = oL * edgeG;
			outR = oR * edgeG;
		}
	}
	return outL, outR;
}

// Frozen Repitch loop reader: the loop window starts at ls, its audible period is `period` and the last xfLen of the window
// (phase phi in [period, period + xfLen)) crossfade the tail into the head one period earlier. The two reads are one period
// apart, so for a pitched source that fits the period they coincide: the fade is linear (the weights sum to 1, no level bump).
frz_read(sampBuf, winS, winPh, winPer, winXf, maxIdx) {
	tapL, tapR = peek_lr(sampBuf, winS + winPh, maxIdx);
	fadeT = clip((winPh - winPer) / max(winXf, 1.0), 0, 1);
	if (fadeT > 0.0) {
		wHead = 0.5 - 0.5 * cos(3.14159265359 * fadeT);
		headL, headR = peek_lr(sampBuf, winS + winPh - winPer, maxIdx);
		tapL = tapL + (headL - tapL) * wHead;
		tapR = tapR + (headR - tapR) * wHead;
	}
	return tapL, tapR;
}

// ---------------------------------------------------------------------------------------------
// Repitch characters
// ---------------------------------------------------------------------------------------------

// Analog, one channel. dist: saturator with pre / post EQ (even + odd harmonics via an asymmetric tanh).
// colorV > 0: brighter shelf and tape hiss (scales with the playback rate). colorV < 0: low-mid
// emphasis and softer transients (lowpass + gentle saturation).
analog_chan(x, dist, colorV, rate, sr, vhist, stBase) {
	lpLo = peek(vhist, stBase + 0);
	lpHi = peek(vhist, stBase + 1);
	lpSoft = peek(vhist, stBase + 2);
	lpNz = peek(vhist, stBase + 3);
	lpPre = peek(vhist, stBase + 4);
	lpPost = peek(vhist, stBase + 5);
	dcX = peek(vhist, stBase + 6);
	dcY = peek(vhist, stBase + 7);
	y = x;
	posC = max(colorV, 0.0);
	negC = max(0.0 - colorV, 0.0);
	if (negC > 0.0005) {
		lpLo = lpLo + op_coef(320, sr) * (y - lpLo);
		y = (y + negC * 1.3 * lpLo) / (1.0 + 0.45 * negC);
		lpSoft = lpSoft + op_coef(18000 * pow(0.18, negC), sr) * (y - lpSoft);
		y = mix(lpSoft, tanh(lpSoft * 1.3) / 1.3, negC * 0.5);
	}
	if (posC > 0.0005) {
		lpHi = lpHi + op_coef(2500 * clip(rate, 0.5, 2.0), sr) * (y - lpHi);
		y = y + posC * 1.6 * (y - lpHi);
		nz = noise();
		lpNz = lpNz + op_coef(1500, sr) * (nz - lpNz);
		y = y + (nz - lpNz) * posC * 0.012 * clip(rate, 0.25, 3.0);
	}
	if (dist > 0.0005) {
		lpPre = lpPre + op_coef(250, sr) * (y - lpPre);
		pre = y + dist * 1.2 * (y - lpPre);
		drv = 1.0 + 2.0 * dist + 9.0 * dist * dist;
		sat = tanh(drv * pre + 0.35 * dist) - tanh(0.35 * dist);
		dcY = sat - dcX + 0.995 * dcY;
		dcX = sat;
		lpPost = lpPost + op_coef(9000 - 5000 * dist, sr) * (dcY - lpPost);
		y = mix(y, lpPost / (1.0 + 0.5 * (drv - 1.0)), clip(dist * 8.0, 0, 1));
	}
	poke(vhist, lpLo, stBase + 0);
	poke(vhist, lpHi, stBase + 1);
	poke(vhist, lpSoft, stBase + 2);
	poke(vhist, lpNz, stBase + 3);
	poke(vhist, lpPre, stBase + 4);
	poke(vhist, lpPost, stBase + 5);
	poke(vhist, dcX, stBase + 6);
	poke(vhist, dcY, stBase + 7);
	return y;
}

// Analog tape stereo: decalibrated heads (L and R warble out of phase, plus a head azimuth offset).
// Wow / flutter rate and depth scale with the playback rate. The delay lines live in the shared tbuf
// table (gen shares a function-level Data between every call site, so each voice gets its own slice).
tape_st(xl, xr, colorV, rate, sr, tbuf, tbase, vhist, stBase) {
	wp = peek(vhist, stBase + 0);
	p1 = peek(vhist, stBase + 1);
	p2 = peek(vhist, stBase + 2);
	p3 = peek(vhist, stBase + 3);
	p4 = peek(vhist, stBase + 4);
	posC = max(colorV, 0.0);
	rt = sqrt(clip(rate, 0.25, 4.0));
	p1 = fract(p1 + 0.9 * rt / sr);
	p2 = fract(p2 + 1.13 * rt / sr);
	p3 = fract(p3 + 7.3 * rt / sr);
	p4 = fract(p4 + 9.1 * rt / sr);
	wowA = 26.0 * posC * rt;
	flA = 3.5 * posC * rt;
	az = 18.0 * posC;
	dlS = 2.0 + wowA * (1.0 + sin(6.28318530718 * p1)) + flA * (1.0 + sin(6.28318530718 * p3));
	drS = 2.0 + az + wowA * (1.0 + sin(6.28318530718 * p2)) + flA * (1.0 + sin(6.28318530718 * p4));
	poke(tbuf, xl, tbase + wp);
	poke(tbuf, xr, tbase + 4096 + wp);
	rl = wrap(wp - dlS, 0, 4096);
	rr = wrap(wp - drS, 0, 4096);
	il0 = int(floor(rl));
	ir0 = int(floor(rr));
	il1 = int(wrap(il0 + 1, 0, 4096));
	ir1 = int(wrap(ir0 + 1, 0, 4096));
	yl = mix(peek(tbuf, tbase + il0), peek(tbuf, tbase + il1), rl - il0);
	yr = mix(peek(tbuf, tbase + 4096 + ir0), peek(tbuf, tbase + 4096 + ir1), rr - ir0);
	wp = wrap(wp + 1, 0, 4096);
	poke(vhist, wp, stBase + 0);
	poke(vhist, p1, stBase + 1);
	poke(vhist, p2, stBase + 2);
	poke(vhist, p3, stBase + 3);
	poke(vhist, p4, stBase + 4);
	return yl, yr;
}

// Digital: bit reduction (13 bits at dist 0 down to 2), sample-rate reduction (positive colour = raw
// sample-and-hold aliasing, negative = band-limited first), VSR (rate follows the playback rate) and an
// imaging filter that follows the voice's sample rate.
digital_st(xl, xr, dist, colorV, rate, vsr, imaging, sr, vhist, stBase) {
	acc = peek(vhist, stBase + 0);
	hL = peek(vhist, stBase + 1);
	hR = peek(vhist, stBase + 2);
	a1L = peek(vhist, stBase + 3);
	a2L = peek(vhist, stBase + 4);
	a3L = peek(vhist, stBase + 5);
	a1R = peek(vhist, stBase + 6);
	a2R = peek(vhist, stBase + 7);
	a3R = peek(vhist, stBase + 8);
	b1L = peek(vhist, stBase + 9);
	b2L = peek(vhist, stBase + 10);
	b3L = peek(vhist, stBase + 11);
	b1R = peek(vhist, stBase + 12);
	b2R = peek(vhist, stBase + 13);
	b3R = peek(vhist, stBase + 14);
	bits = 13.0 - 11.0 * clip(dist, 0, 1);
	q = pow(2.0, bits - 1.0);
	ql = floor(xl * q + 0.5) / q;
	qr = floor(xr * q + 0.5) / q;
	srBase = sr * pow(2.0, 0.0 - 5.0 * abs(colorV));
	srEff = (vsr > 0.5) ? (srBase * clip(rate, 0.05, 8.0)) : srBase;
	srEff = clip(srEff, 400.0, sr * 4.0);
	byp = (srEff >= sr * 0.999) ? 1 : 0;
	outL = ql;
	outR = qr;
	if (byp == 0) {
		inL = ql;
		inR = qr;
		if (colorV < -0.0005) {
			cf = op_coef(srEff * 0.36, sr);
			a1L = a1L + cf * (ql - a1L);
			a2L = a2L + cf * (a1L - a2L);
			a3L = a3L + cf * (a2L - a3L);
			a1R = a1R + cf * (qr - a1R);
			a2R = a2R + cf * (a1R - a2R);
			a3R = a3R + cf * (a2R - a3R);
			inL = a3L;
			inR = a3R;
		}
		acc = acc + srEff / sr;
		if (acc >= 1.0) {
			acc = acc - floor(acc);
			hL = inL;
			hR = inR;
		}
		outL = hL;
		outR = hR;
		if (imaging > 0.5) {
			ci = op_coef(srEff * 0.30, sr);
			b1L = b1L + ci * (hL - b1L);
			b2L = b2L + ci * (b1L - b2L);
			b3L = b3L + ci * (b2L - b3L);
			b1R = b1R + ci * (hR - b1R);
			b2R = b2R + ci * (b1R - b2R);
			b3R = b3R + ci * (b2R - b3R);
			outL = b3L;
			outR = b3R;
		}
	}
	poke(vhist, acc, stBase + 0);
	poke(vhist, hL, stBase + 1);
	poke(vhist, hR, stBase + 2);
	poke(vhist, a1L, stBase + 3);
	poke(vhist, a2L, stBase + 4);
	poke(vhist, a3L, stBase + 5);
	poke(vhist, a1R, stBase + 6);
	poke(vhist, a2R, stBase + 7);
	poke(vhist, a3R, stBase + 8);
	poke(vhist, b1L, stBase + 9);
	poke(vhist, b2L, stBase + 10);
	poke(vhist, b3L, stBase + 11);
	poke(vhist, b1R, stBase + 12);
	poke(vhist, b2R, stBase + 13);
	poke(vhist, b3R, stBase + 14);
	return outL, outR;
}

// ---------------------------------------------------------------------------------------------
// Cycles
// ---------------------------------------------------------------------------------------------

// One cycle read at phase ph (0..1 is the cycle itself, 1..1+q its continuation into the next cycle's crossfade, where
// the same cycle keeps reading the source past its end, so the join is an overlap-add of two reads of the same signal).
// A closed cycle (closedF 1: the source pitch steps inside it, so its continuation would be a different period) instead
// fades its last 15 % into its own head, one period earlier, and loops back to that head past its end (ph - 1).
cyc_read(sampBuf, anc, cycLen, form, ph, closedF, maxIdx) {
	posC = anc + ((ph - 0.5) * form + 0.5) * cycLen;
	pcl = clip(posC, 0, maxIdx);
	yl = peek(sampBuf, pcl, 0, interp="cubic", boundmode="clamp", channelmode="clamp");
	yr = peek(sampBuf, pcl, 1, interp="cubic", boundmode="clamp", channelmode="clamp");
	wcl = clip((ph - 0.85) / 0.15, 0, 1) * closedF;
	if ((wcl > 0.0) && (ph <= 1.0)) {
		wcl = wcl * wcl * (3.0 - 2.0 * wcl);
		ph2 = clip(posC - form * cycLen, 0, maxIdx);
		hl = peek(sampBuf, ph2, 0, interp="cubic", boundmode="clamp", channelmode="clamp");
		hr = peek(sampBuf, ph2, 1, interp="cubic", boundmode="clamp", channelmode="clamp");
		yl = yl + (hl - yl) * wcl;
		yr = yr + (hr - yr) * wcl;
	}
	return yl, yr;
}

// One cycle read at phase ph with the character applied.
//   charId 0 Pulse   : phase distortion with duty dutyD (0.5 = unchanged); the continuation past the cycle end keeps the warp
//   charId 1 Partials: the cycle and its half-period shift give odd / even harmonics (splitV -1 odd .. +1 even)
//   charId 2 Phase   : the read phase is offset by pmV (phase modulation)
cyc_wave(sampBuf, anc, cycLen, form, ph, closedF, charId, dutyD, splitV, pmV, maxIdx) {
	phw = ph;
	if (charId < 0.5) {
		bsW = (ph >= 1.0) ? 1.0 : 0.0;
		pfW = ph - bsW;
		phw = bsW + ((pfW < dutyD) ? (0.5 * pfW / max(dutyD, 0.01)) : (0.5 + 0.5 * (pfW - dutyD) / max(1.0 - dutyD, 0.01)));
	} else if (charId > 1.5) {
		phw = ph + pmV;
	}
	xl, xr = cyc_read(sampBuf, anc, cycLen, form, phw, closedF, maxIdx);
	if ((charId > 0.5) && (charId < 1.5)) {
		pl, pr = cyc_read(sampBuf, anc, cycLen, form, fract(ph + 0.5), closedF, maxIdx);
		wOdd = 1.0 - max(splitV, 0.0);
		wEven = 1.0 - max(0.0 - splitV, 0.0);
		oddL = 0.5 * (xl - pl);
		evenL = 0.5 * (xl + pl);
		oddR = 0.5 * (xr - pr);
		evenR = 0.5 * (xr + pr);
		xl = wOdd * oddL + wEven * evenL;
		xr = wOdd * oddR + wEven * evenR;
	}
	return xl, xr;
}

// Cycle length (frames) of the source at frame position `frm`: one period of the root pitch there (the Analyzed Root
// Key curve with root_dyn on, root_note otherwise).
cyc_len(pbuf, frm, numFrames, rootMidi, dynOn, sr) {
	rtHz = 440.0 * pow(2.0, (root_at(pbuf, frm / max(numFrames - 1, 1), rootMidi, dynOn) - 69.0) / 12.0);
	return clip(sr / max(rtHz, 20.0), 32.0, 8192.0);
}

// How well a cycle (start c, length cl) matches the continuation of the reference cycle (start r, length rl) over the
// crossfade between them: 8 mono taps at phases 0 .. q of the candidate against phases 1 .. 1 + q of the reference (what the
// reference is still reading while the candidate fades in; extPh 0 compares with the reference's own head instead). Returns the squared difference and the energy of the reference taps.
// A candidate that is congruent with the reference (a whole number of source periods away) costs about 0.
cyc_cost(sampBuf, c, cl, r, rl, qOv, extPh, form, maxIdx) {
	cstSum = 0.0;
	cstEn = 1e-12;
	for (jj = 0; jj < 8; jj += 1) {
		pj = qOv * (jj + 0.5) * 0.125;
		dv = peek(sampBuf, clip(c + ((pj - 0.5) * form + 0.5) * cl, 0, maxIdx), 0, interp="linear", boundmode="clamp", channelmode="clamp");
		rv = peek(sampBuf, clip(r + ((pj + extPh - 0.5) * form + 0.5) * rl, 0, maxIdx), 0, interp="linear", boundmode="clamp", channelmode="clamp");
		cstSum += (dv - rv) * (dv - rv);
		cstEn += rv * rv;
	}
	return cstSum, cstEn;
}

// The source's own period (frames) near frame r, for a root that is not exactly right: the shift d within +-20 % of the nominal
// period lcs for which 16 mono taps over 0.6 of a period at r match the same taps at r + d best (a YIN-style difference
// function: coarse over the range, then fine around the best). Returns d and how periodic the source is there (1 = exact
// repeat, 0 = unrelated); the caller trusts d only as far as it is periodic. One loop = one cost site.
cyc_period(sampBuf, r, lcs, maxIdx) {
	pBest = 1e30;
	pEn = 1.0;
	pD = lcs;
	pCen = lcs;
	stpP = lcs * 0.0167;
	for (ip = 0; ip < 44; ip += 1) {
		// 0: nominal; 1..25: coarse +-20 %; 26..43: fine, +-9 steps of an eighth of the coarse step around the best
		if (ip == 26) {
			pCen = pD;
		}
		cdD = lcs;
		if (ip > 0) {
			cdD = (ip < 26) ? (lcs + (ip - 13) * stpP) : (pCen + (ip - 35) * stpP * 0.125);
		}
		if ((ip == 0) || (pBest > 0.002 * pEn)) {
			sumP = 0.0;
			enP = 1e-12;
			for (jp = 0; jp < 16; jp += 1) {
				tp = jp * lcs * 0.0375;
				xa = peek(sampBuf, clip(r + tp, 0, maxIdx), 0, interp="linear", boundmode="clamp", channelmode="clamp");
				xb = peek(sampBuf, clip(r + cdD + tp, 0, maxIdx), 0, interp="linear", boundmode="clamp", channelmode="clamp");
				sumP += (xa - xb) * (xa - xb);
				enP += xa * xa;
			}
			farP = (cdD - lcs) / lcs;
			cdS = sumP + enP * 0.02 * farP * farP;
			if (cdS < pBest) {
				pBest = cdS;
				pD = cdD;
				pEn = enP;
			}
		}
	}
	return pD, clip(1.0 - pBest / (2.0 * pEn), 0, 1);
}

// Pitch-synchronous anchor: where the next cycle starts. The scan target moves continuously, but a cycle may only start
// a whole number of source periods (d) from the reference cycle, otherwise the output reads the source at the scan speed
// plus its own (the pitch drifts) and the two overlapping reads sit at different phases (they cancel).
//   - Period: with Analyzed Root Key it comes from the curve; without it the root can be a little off, so it is measured
//     (cyc_period) and the cycle length follows it (the continuation of one cycle and the start of the next then coincide,
//     and the output period still is the note period).
//   - Search: around the lattice point (coarse over +-a period, then fine around the best) for the start whose first q of a
//     cycle best matches the reference's continuation. A candidate pays for its distance from the lattice point (8 % of the
//     match energy per period squared), so a tie between equal matches goes to the closest one and the alignment cannot jump
//     back or ahead by a whole period for nothing. A cycle that spans a pitch step (the curve moves by more than 0.2 st inside
//     it) is penalised, so cycles end before the step and restart after it. The search only runs while the lattice point (and
//     then each better candidate) does not match. One loop = one cyc_cost call site.
// Returns the start, the match quality rho (1 = the two reads coincide, 0 = unrelated), the period / cycle length, the overlap
// fraction used, how the reference continues (extPh) and whether the new cycle is closed (it spans a step).
cyc_align(sampBuf, pbuf, target, lc0, r, rl, qBase, prevClosed, form, loB, hiB, maxIdx, numFrames, rootMidi, dynOn, sr) {
	lcs = max(lc0, 8.0);
	dUse = lcs;
	// The reference keeps reading past its end while the next cycle fades in; if it is closed (the pitch curve steps inside it
	// or just after it) it loops back to its own head instead (extPh 0) and the next cycle is matched to that head.
	nrm = max(numFrames - 1, 1);
	qOv = (prevClosed > 0.5) ? 0.12 : qBase;
	extPh = (prevClosed > 0.5) ? 0.0 : 1.0;
	if (dynOn < 0.5) {
		dMeas, rhoP = cyc_period(sampBuf, r, lcs, maxIdx);
		dUse = lcs + clip((rhoP - 0.4) / 0.4, 0, 1) * (dMeas - lcs);
	}
	c0 = clip(r + floor((target - r) / dUse + 0.5) * dUse, loB, hiB);
	bestC = c0;
	bestS = 1e30;
	bestE = 1.0;
	bestRho = 0.0;
	cenF = c0;
	stpC = dUse / 24.0;
	stpF = stpC / 8.0;
	for (it = 0; it < 67; it += 1) {
		// it 0: the lattice point; 1..49: coarse, +-a period around it; 50..66: fine, +-8 steps around the coarse best
		if (it == 50) {
			cenF = bestC;
		}
		cndC = c0;
		if (it > 0) {
			cndC = (it < 50) ? (c0 + (it - 25) * stpC) : (cenF + (it - 58) * stpF);
		}
		cndC = clip(cndC, loB, hiB);
		if ((it == 0) || (bestS > 0.0003 * bestE)) {
			cndL = (dynOn > 0.5) ? cyc_len(pbuf, cndC + 0.5 * lcs, numFrames, rootMidi, dynOn, sr) : dUse;
			rawS, cndE = cyc_cost(sampBuf, cndC, cndL, r, rl, (extPh < 0.5) ? max(qOv, 0.5) : qOv, extPh, form, maxIdx);
			m0 = root_at(pbuf, cndC / nrm, rootMidi, dynOn);
			m1 = root_at(pbuf, (cndC + 0.5 * cndL) / nrm, rootMidi, dynOn);
			m2 = root_at(pbuf, (cndC + cndL) / nrm, rootMidi, dynOn);
			dmv = max(max(m0, m1), m2) - min(min(m0, m1), m2);
			spanPen = max(dmv - 0.2, 0.0);
			farF = (cndC - c0) / dUse;
			cndS = rawS + cndE * (min(400.0 * spanPen * spanPen, 60.0) + 0.08 * farF * farF);
			if (cndS < bestS) {
				bestS = cndS;
				bestC = cndC;
				bestE = cndE;
				bestRho = clip(1.0 - rawS / (2.0 * cndE), 0, 1);
			}
		}
	}
	// does the chosen cycle (or its continuation) span a step of the pitch curve? Then it is closed.
	clsF = 0.0;
	if (dynOn > 0.5) {
		dLen = cyc_len(pbuf, bestC + 0.5 * lcs, numFrames, rootMidi, dynOn, sr);
		k0 = root_at(pbuf, bestC / nrm, rootMidi, dynOn);
		k1 = root_at(pbuf, (bestC + 0.5 * dLen) / nrm, rootMidi, dynOn);
		k2 = root_at(pbuf, (bestC + dLen) / nrm, rootMidi, dynOn);
		k3 = root_at(pbuf, (bestC + (1.0 + qBase) * dLen) / nrm, rootMidi, dynOn);
		if (max(max(k0, k1), max(k2, k3)) - min(min(k0, k1), min(k2, k3)) > 0.2) {
			clsF = 1.0;
		}
	}
	return bestC, bestRho, dUse, qOv, extPh, clsF;
}

// ---------------------------------------------------------------------------------------------
// Fragments
// ---------------------------------------------------------------------------------------------

// Grain envelope: peak at pk (0..1). 0.5 is a symmetric Hann; 0 / 1 click on purpose.
fr_win(t, pk) {
	rise = 0.5 - 0.5 * cos(3.14159265359 * clip(t / max(pk, 0.0001), 0, 1));
	fall = 0.5 + 0.5 * cos(3.14159265359 * clip((t - pk) / max(1.0 - pk, 0.0001), 0, 1));
	return (t < pk) ? rise : fall;
}

// ---------------------------------------------------------------------------------------------
// Spectral (phase vocoder, time-sliced). All helpers read frame parameters from the jp table:
//   0 N, 1 N/2, 2 Hs, 3 pitch ratio, 4 formant ratio, 5 formant on, 6 source fundamental bin,
//   7 bend ratio, 8 reharm, 9 quant mode, 10 quant amount, 11 key, 12 scale, 13 sr, 14 output f0 Hz,
//   15 dispersion, 16 onsets on, 17 first frame, 18 Ha (analysis hop), 19 onset flag (this frame),
//   20 seed, 21 capture centre (frames), 22 capture dir, 23 lo (frames), 24 hi (frames),
//   25 numFrames, 26 stride, 27 OLA start, 28 OLA first index, 29 stretch (1 / speed)
// ---------------------------------------------------------------------------------------------

// 2^n for a small integer n (0..12). A doubling loop stays exact; pow(2, n) is a real pow.
pow2n(n) {
	p2n = 1;
	n2 = clip(floor(n + 0.5), 0, 12);
	for (k2 = 0; k2 < n2; k2 += 1) {
		p2n = p2n * 2;
	}
	return p2n;
}

// In-place radix-2 DIT pass `s` (1..log2 n) over bit-reversed input. sgn = +1 forward, -1 inverse (unscaled).
fft_pass(sdat, sb, twr, twi, n, s, sgn) {
	hlf = pow2n(s - 1);
	blk = hlf * 2;
	tstep = 4096 / blk;
	nb = n * 0.5;
	for (b = 0; b < nb; b += 1) {
		grp = floor(b / hlf);
		j = b - grp * hlf;
		i0 = grp * blk + j;
		i1 = i0 + hlf;
		tIdx = j * tstep;
		wr = peek(twr, tIdx);
		wi = sgn * peek(twi, tIdx);
		ar = peek(sdat, sb + i0);
		ai = peek(sdat, sb + 4096 + i0);
		br = peek(sdat, sb + i1);
		bi = peek(sdat, sb + 4096 + i1);
		tr = br * wr - bi * wi;
		tm = br * wi + bi * wr;
		poke(sdat, ar - tr, sb + i1);
		poke(sdat, ai - tm, sb + 4096 + i1);
		poke(sdat, ar + tr, sb + i0);
		poke(sdat, ai + tm, sb + 4096 + i0);
	}
	return 0;
}

// One-time tables: twiddles exp(-2*pi*i*k/4096) for k = 0..2048 and the 12-bit bit-reversal table.
init_tables(twr, twi, brv) {
	for (k = 0; k <= 2048; k += 1) {
		a = 6.28318530718 * k / 4096;
		poke(twr, cos(a), k);
		poke(twi, 0 - sin(a), k);
	}
	for (i = 0; i < 4096; i += 1) {
		t = i;
		r = 0;
		for (q = 0; q < 12; q += 1) {
			r = r * 2 + (t % 2);
			t = floor(t / 2);
		}
		poke(brv, r, i);
	}
	return 0;
}

// Job: Hann-window N source frames around the capture centre (L real, R imaginary), bit-reversed.
// Frames outside [lo, hi] are silent, so slices and the start / end points cut the analysis window.
job_capture(sdat, sb, brv, twr, sampBuf) {
	n = peek(sdat, sb + 55328 + 0);
	nh = n * 0.5;
	stride = peek(sdat, sb + 55328 + 26);
	centre = peek(sdat, sb + 55328 + 21);
	dirc = peek(sdat, sb + 55328 + 22);
	lo = peek(sdat, sb + 55328 + 23);
	hi = peek(sdat, sb + 55328 + 24);
	maxIdx = max(peek(sdat, sb + 55328 + 25) - 1, 1);
	wmc = peek(sdat, sb + 55328 + 30);
	for (i = 0; i < n; i += 1) {
		ci = (i <= nh) ? i : (n - i);
		w = 0.5 - 0.5 * peek(twr, ci * stride);
		idx = centre + dirc * (i - nh);
		if (wmc > 1.5) {
			idx = pp_pos(idx, lo, hi);
		} else if (wmc > 0.5) {
			idx = lo + wrap(idx - lo, 0, max(hi - lo, 4));
		}
		xl = 0;
		xr = 0;
		if ((idx >= lo) && (idx <= hi)) {
			xl, xr = peek_lr(sampBuf, idx, maxIdx);
		}
		r = floor(peek(brv, i) / stride);
		poke(sdat, w * xl, sb + r);
		poke(sdat, w * xr, sb + 4096 + r);
	}
	return 0;
}

// Job: magnitude, instantaneous frequency (phase advance over the analysis hop Ha) and the running sum
// of the spectral envelope (for the formant stage) of channel ch from the packed FFT. The envelope is the upper envelope
// through the partials: a running maximum over one fundamental spacing (van Herk, in senv), cumulated here so that env_at
// can smooth it with a short moving average. Channel 0 also measures the spectral flux used to detect onsets.
job_analyze(sdat, senv, sb, ch) {
	n = peek(sdat, sb + 55328 + 0);
	nh = peek(sdat, sb + 55328 + 1);
	ha = peek(sdat, sb + 55328 + 18);
	first = peek(sdat, sb + 55328 + 17);
	off = ch * 2049;
	tau = 6.28318530718;
	flux = 0;
	tot = 0;
	for (k = 0; k <= nh; k += 1) {
		kk = (n - k) % n;
		ar = peek(sdat, sb + k);
		ai = peek(sdat, sb + 4096 + k);
		br = peek(sdat, sb + kk);
		bi = peek(sdat, sb + 4096 + kk);
		xr = (ch < 0.5) ? (0.5 * (ar + br)) : (0.5 * (ai + bi));
		xi = (ch < 0.5) ? (0.5 * (ai - bi)) : (0.5 * (br - ar));
		am = sqrt(xr * xr + xi * xi);
		ph = atan2(xi, xr);
		prv = peek(sdat, sb + 22536 + (off + k));
		wk = tau * k / n;
		dv = ph - prv - wk * ha;
		dv = dv - tau * round(dv / tau);
		inst = wk;
		if ((first < 0.5) && (ha >= 1.0)) {
			inst = wk + dv / ha;
		}
		poke(sdat, am, sb + 8192 + k);
		poke(sdat, inst, sb + 10241 + k);
		poke(sdat, ph, sb + 22536 + (off + k));
		if (ch < 0.5) {
			flux = flux + max(am - peek(sdat, sb + 20487 + k), 0.0);
			tot = tot + am;
			poke(sdat, am, sb + 20487 + k);
		}
	}
	kfA = peek(sdat, sb + 55328 + 6);
	hwA = clip(floor(0.5 * kfA + 0.5), 3, 60);
	wnA = 2 * hwA + 1;
	vbA = floor(sb / 55392) * 4112;
	for (k = 0; k <= nh; k += 1) {
		av = peek(sdat, sb + 8192 + k);
		gv = av;
		if ((k - wnA * floor(k / wnA)) > 0.5) {
			gv = max(peek(senv, vbA + k - 1), av);
		}
		poke(senv, gv, vbA + k);
	}
	for (qe = 0; qe <= nh; qe += 1) {
		k = nh - qe;
		av = peek(sdat, sb + 8192 + k);
		hv = av;
		if ((qe > 0) && ((k - wnA * floor(k / wnA)) < wnA - 1.5)) {
			hv = max(peek(senv, vbA + 2056 + k + 1), av);
		}
		poke(senv, hv, vbA + 2056 + k);
	}
	csum = 0;
	poke(sdat, 0, sb + 12290 + 0);
	for (k = 0; k <= nh; k += 1) {
		loA = max(k - hwA, 0);
		hiA = min(k + hwA, nh);
		mv = peek(senv, vbA + hiA);
		if (loA > 0) {
			mv = max(mv, peek(senv, vbA + 2056 + loA));
		}
		csum = csum + mv;
		poke(sdat, csum, sb + 12290 + (k + 1));
	}
	if (ch < 0.5) {
		poke(sdat, flux / (tot + 0.000000001), sb + 55312 + 0);
	}
	return 0;
}

// Spectral envelope at (fractional) bin kpos: a short moving average (about a third of the fundamental spacing) of the
// upper envelope that job_analyze cumulated, linearly interpolated between bins.
env_at(sdat, sb, kpos, nh, n, sr) {
	wv = max(2, floor(0.35 * peek(sdat, sb + 55328 + 6) + 0.5));
	kc = clip(kpos, 0, nh);
	k0 = floor(kc);
	fr = kc - k0;
	k1 = min(k0 + 1, nh);
	lo0 = max(k0 - wv, 0);
	hi0 = min(k0 + wv, nh);
	lo1 = max(k1 - wv, 0);
	hi1 = min(k1 + wv, nh);
	v0 = (peek(sdat, sb + 12290 + (hi0 + 1)) - peek(sdat, sb + 12290 + lo0)) / (hi0 - lo0 + 1);
	v1 = (peek(sdat, sb + 12290 + (hi1 + 1)) - peek(sdat, sb + 12290 + lo1)) / (hi1 - lo1 + 1);
	return v0 + (v1 - v0) * fr;
}

// Job: remap the analysed bins of channel ch to the output spectrum (pitch ratio, optional harmonic bend and
// quantise for Reharm), apply the formant envelope, and advance the synthesis phases by the shifted true
// frequency times the synthesis hop.
job_map(sdat, sb, ch) {
	n = peek(sdat, sb + 55328 + 0);
	nh = peek(sdat, sb + 55328 + 1);
	hs = peek(sdat, sb + 55328 + 2);
	pr = peek(sdat, sb + 55328 + 3);
	fEff = peek(sdat, sb + 55328 + 4);
	formOn = peek(sdat, sb + 55328 + 5);
	kf = peek(sdat, sb + 55328 + 6);
	bendR = peek(sdat, sb + 55328 + 7);
	reharm = peek(sdat, sb + 55328 + 8);
	qMode = peek(sdat, sb + 55328 + 9);
	qAmt = peek(sdat, sb + 55328 + 10);
	keyV = peek(sdat, sb + 55328 + 11);
	scaleV = peek(sdat, sb + 55328 + 12);
	srv = peek(sdat, sb + 55328 + 13);
	fNote = peek(sdat, sb + 55328 + 14);
	disp = peek(sdat, sb + 55328 + 15);
	first = peek(sdat, sb + 55328 + 17);
	onset = peek(sdat, sb + 55328 + 19);
	seed = peek(sdat, sb + 55328 + 20);
	stretch = peek(sdat, sb + 55328 + 29);
	off = ch * 2049;
	tau = 6.28318530718;
	scaleMask = (scaleV < 0.5) ? 2741 : 1453;
	qDiv = qAmt * (1.0 / 12.0);
	// Shadow phases (sdat 221568 + 4098 per voice, per channel and source bin): the phase a bend-free, quantise-free mapping gives
	// each source bin (analysis phase at a lock, then advanced by the true frequency times the pitch ratio times the synthesis hop).
	// Bend / Quantize / dispersion offset the synthesis phases from it. While the mapping is neutral the synthesis phases are pulled back
	// onto it, so a control that has been moved and returned leaves nothing behind (the harmonics' relative phases come back).
	shb = 221568 + floor(sb / 55392) * 4098 + off;
	ha = peek(sdat, sb + 55328 + 18);
	// identity (no pitch shift, no stretch): the analysis phase itself is the reference, so the shadow snaps to it every frame
	idMap = ((abs(pr - 1.0) < 0.0001) && (abs(ha - hs) < 0.5)) ? 1 : 0;
	fresh = ((first > 0.5) || (onset > 0.5) || (idMap > 0.5)) ? 1 : 0;
	lockHard = ((first > 0.5) || (onset > 0.5)) ? 1 : 0;
	neutralMap = ((reharm < 0.5) || ((abs(bendR - 1.0) < 0.000001) && (qMode < 0.5))) ? 1 : 0;
	for (j = 0; j <= nh; j += 1) {
		poke(sdat, 0, sb + 14340 + j);
	}
	for (k = 0; k <= nh; k += 1) {
		am = peek(sdat, sb + 8192 + k);
		psh = peek(sdat, sb + 22536 + (off + k));
		if (fresh < 0.5) {
			psh = peek(sdat, shb + k) + peek(sdat, sb + 10241 + k) * pr * hs;
			psh = psh - tau * round(psh / tau);
		}
		poke(sdat, psh, shb + k);
		if (am > 0.000000001) {
			wk = peek(sdat, sb + 10241 + k);
			rk = pr;
			if ((reharm > 0.5) && (k > 1.5 * kf)) {
				rk = rk * bendR;
				if (qMode > 0.5) {
					fOut = max(wk * rk * srv / tau, 1.0);
					rel = 12.0 * log2(fOut / fNote);
					tgt = 12.0 * round(rel / 12.0);
					if (qMode > 1.5) {
						midiAbs = 69.0 + 12.0 * log2(fOut / 440.0);
						rel12 = midiAbs - keyV;
						baseO = floor(rel12 / 12.0) * 12.0;
						xo = rel12 - baseO;
						bestD = 99.0;
						bestM = 0.0;
						for (mm = 0; mm <= 12; mm += 1) {
							okm = floor(scaleMask / pow2n(mm - 12 * floor(mm / 12))) % 2;
							dd = abs(xo - mm);
							if ((okm > 0.5) && (dd < bestD)) {
								bestD = dd;
								bestM = mm;
							}
						}
						tgt = (baseO + bestM + keyV) - (midiAbs - rel);
					}
					rk = rk * pow(2.0, (tgt - rel) * qDiv);
				}
			}
			j = k + round(wk * (rk - 1.0) * n / tau);
			if ((j >= 0) && (j <= nh)) {
				ex = am;
				if (formOn > 0.5) {
					ex = am / (env_at(sdat, sb, k, nh, n, srv) + 0.000000001);
				}
				if (ex > peek(sdat, sb + 14340 + j)) {
					poke(sdat, ex, sb + 14340 + j);
					poke(sdat, wk * rk, sb + 16389 + j);
					poke(sdat, psh, sb + 18438 + j);
				}
			}
		}
	}
	jit = disp * clip((stretch - 1.0) / 6.0, 0, 1) * 3.14159265359;
	rs = seed;
	for (j = 0; j <= nh; j += 1) {
		a = peek(sdat, sb + 14340 + j);
		wj = (a > 0) ? peek(sdat, sb + 16389 + j) : (tau * j / n);
		ph = peek(sdat, sb + 26634 + (off + j));
		if ((lockHard > 0.5) && (a > 0)) {
			ph = peek(sdat, sb + 18438 + j);
		} else {
			rs = fract(rs * 7.31 + j * 0.6180339 + 0.137);
			ph = ph + wj * hs + (rs - 0.5) * 2.0 * jit;
			if ((neutralMap > 0.5) && (jit < 0.0000001) && (a > 0)) {
				phT = peek(sdat, sb + 18438 + j);
				eR = ph - phT;
				eR = eR - tau * round(eR / tau);
				ph = phT + eR * 0.35;
			}
		}
		ph = ph - tau * round(ph / tau);
		poke(sdat, ph, sb + 26634 + (off + j));
		amp = a;
		if ((formOn > 0.5) && (a > 0)) {
			amp = a * env_at(sdat, sb, j / fEff, nh, n, srv);
		}
		yr = amp * cos(ph);
		yi = amp * sin(ph);
		if ((j == 0) || (j == nh)) {
			yi = 0;
		}
		poke(sdat, yr, sb + 30732 + (off + j));
		poke(sdat, yi, sb + 34830 + (off + j));
	}
	return 0;
}

// Job: pack the two hermitian channel spectra into one complex spectrum (L + jR), bit-reversed for the IFFT.
job_pack(sdat, sb, brv) {
	n = peek(sdat, sb + 55328 + 0);
	nh = peek(sdat, sb + 55328 + 1);
	stride = peek(sdat, sb + 55328 + 26);
	for (k = 0; k <= nh; k += 1) {
		kk = (n - k) % n;
		lr = peek(sdat, sb + 30732 + k);
		li = peek(sdat, sb + 34830 + k);
		rr = peek(sdat, sb + 30732 + (2049 + k));
		ri = peek(sdat, sb + 34830 + (2049 + k));
		r1 = floor(peek(brv, k) / stride);
		r2 = floor(peek(brv, kk) / stride);
		poke(sdat, lr - ri, sb + r1);
		poke(sdat, li + rr, sb + 4096 + r1);
		poke(sdat, lr + ri, sb + r2);
		poke(sdat, rr - li, sb + 4096 + r2);
	}
	return 0;
}

// Job: synthesis Hann window and overlap-add into the L / R output rings (Hann^2 at 75% overlap = 1.5).
job_ola(sdat, sb, twr) {
	n = peek(sdat, sb + 55328 + 0);
	nh = peek(sdat, sb + 55328 + 1);
	stride = peek(sdat, sb + 55328 + 26);
	startPos = peek(sdat, sb + 55328 + 27);
	i0 = peek(sdat, sb + 55328 + 28);
	scl = 1.0 / (n * 1.5);
	for (i = i0; i < n; i += 1) {
		ci = (i <= nh) ? i : (n - i);
		w = (0.5 - 0.5 * peek(twr, ci * stride)) * scl;
		pos = wrap(startPos + i, 0, 8192);
		poke(sdat, peek(sdat, sb + 38928 + pos) + w * peek(sdat, sb + i), sb + 38928 + pos);
		poke(sdat, peek(sdat, sb + 47120 + pos) + w * peek(sdat, sb + 4096 + i), sb + 47120 + pos);
	}
	return 0;
}

// Spectral voice: phase-vocoder stretcher for one of the first 4 voices. Returns the stereo output, the
// normalised playhead and 0. Runs only while mode == 3 and the voice is held or releasing.
spec_voice(sampBuf, vdataBuf, twr, twi, brv, prm, sdat, vIdx, modeVal, freezeOn, playPosNorm, startNorm, endNorm, loopMode, loopStartNorm, loopEndNorm, reverseOn, rootMidi, pitchSt, fineCents, glideCoef, formantSt, speedIn, slicePlay, lfoSig, lfoPitchAmt, lfoPosAmt, menvPitchAmt, menvPosAmt, modEnvPrev, ampEnvPrev, numFrames, srVal, pitchBuf, senv) {
	sb = vIdx * 55392;
	prevTrig = peek(sdat, sb + 55360 + 0);
	wasOn = peek(sdat, sb + 55360 + 1);
	nCur = peek(sdat, sb + 55360 + 2);
	llog = peek(sdat, sb + 55360 + 3);
	hopN = peek(sdat, sb + 55360 + 4);
	jobCount = peek(sdat, sb + 55360 + 5);
	spacing = peek(sdat, sb + 55360 + 6);
	jobId = peek(sdat, sb + 55360 + 7);
	jobWait = peek(sdat, sb + 55360 + 8);
	hopCtr = peek(sdat, sb + 55360 + 9);
	rd = peek(sdat, sb + 55360 + 10);
	headN = peek(sdat, sb + 55360 + 11);
	dirS = peek(sdat, sb + 55360 + 12);
	stepPrev = peek(sdat, sb + 55360 + 13);
	finished = peek(sdat, sb + 55360 + 14);
	firstFrame = peek(sdat, sb + 55360 + 15);
	burstLeft = peek(sdat, sb + 55360 + 16);
	frameBurst = peek(sdat, sb + 55360 + 17);
	onsetHold = peek(sdat, sb + 55360 + 18);
	curNote = peek(sdat, sb + 55360 + 19);
	frameNo = peek(sdat, sb + 55360 + 20);
	onsetNow = peek(sdat, sb + 55360 + 21);

	nFr = max(numFrames, 1);
	baseSlot = vIdx * 8;
	vGate = peek(vdataBuf, baseSlot + 0);
	vNote = peek(vdataBuf, baseSlot + 1);
	vTrig = peek(vdataBuf, baseSlot + 3);
	voS = clip(peek(vdataBuf, baseSlot + 4), 0, 1);
	vE = clip(peek(vdataBuf, baseSlot + 5), 0, 1);
	vSeed = clip(peek(vdataBuf, baseSlot + 7), 0, 1);
	slicedFlag = peek(prm, 0);
	isOn = (round(clip(modeVal, 0, 4)) == 3) ? 1 : 0;
	effS, effE, sampS, sampE = slice_region(voS, vE, startNorm, endNorm, slicedFlag, slicePlay, reverseOn);
	act = ((isOn > 0.5) && ((vGate > 0.5) || (ampEnvPrev > 0.0004))) ? 1 : 0;
	isNewTrig = ((vTrig != prevTrig) && (vGate > 0.5)) ? 1 : 0;
	prevTrig = vTrig;
	qIdx = round(clip(peek(prm, 50), 0, 2));
	nWant = peek(prm, 35);
	dirSign = (reverseOn > 0.5) ? -1.0 : 1.0;
	posMod = lfoSig * lfoPosAmt * 0.45 + modEnvPrev * menvPosAmt * 0.45;
	speedUse = clip(speedIn, 0, 2);
	srRat = peek(prm, 54);

	// Pitch (same recipe as voice_proc, one frame late for the Mod Env)
	curNote = mix(vNote, curNote, glideCoef);
	pSemis = pitchSt + fineCents * 0.01 + lfoSig * lfoPitchAmt * 24.0 + modEnvPrev * menvPitchAmt * 24.0;
	// Analyzed Root Key: the root at the analysis position (rootMidi when root_dyn is off).
	// While frozen the analysis sits at Pos, not at the (parked) playhead.
	rootPos = (freezeOn > 0.5) ? clip(effS + playPosNorm * (effE - effS) + posMod, effS, effE) : headN;
	rootHere = root_at(pitchBuf, rootPos, rootMidi, peek(prm, 53));
	semis = (((slicedFlag > 0.5) ? rootMidi : curNote) - rootHere) + pSemis;
	pr = pow(2.0, clip(semis, -48, 48) / 12.0);
	noteSemi = ((slicedFlag > 0.5) ? rootMidi : curNote) + pSemis;
	fNote = 440.0 * pow(2.0, (noteSemi - 69.0) / 12.0);
	rootHz = 440.0 * pow(2.0, (rootHere - 69.0) / 12.0);
	fEff = peek(prm, 37) * ((peek(prm, 52) > 0.5) ? pr : 1.0);
	reharm = (peek(prm, 40) > 0.5) ? 1 : 0;
	bendR = peek(prm, 36);

	// Playhead behaviour: slice_play (Sliced) or the loop mode (Single).
	slicePlayId = round(clip(slicePlay, 0, 3));
	wmSl = (slicePlayId > 2.5) ? 2 : ((slicePlayId > 1.5) ? 1 : 0);
	wmLp = (loopMode > 1.5) ? 2 : ((loopMode > 0.5) ? 1 : 0);
	wmEff = (slicedFlag > 0.5) ? wmSl : wmLp;
	rlo = (slicedFlag > 0.5) ? effS : clip(loopStartNorm, effS, effE - 0.002);
	rhi = (slicedFlag > 0.5) ? effE : clip(loopEndNorm, rlo + 0.002, effE);

	doReset = ((isOn > 0.5) && ((isNewTrig > 0.5) || (nWant != nCur) || (wasOn < 0.5))) ? 1 : 0;
	wasOn = isOn;
	if (doReset > 0.5) {
		nCur = nWant;
		llog = 10 + qIdx;
		hopN = nCur * 0.25;
		jobCount = 2 * llog + 7;
		spacing = max(0, floor((hopN - 1) / (jobCount - 1)) - 1);
		for (ci = 0; ci < 8192; ci += 1) {
			poke(sdat, 0, sb + 38928 + ci);
			poke(sdat, 0, sb + 47120 + ci);
		}
		for (ci = 0; ci < 2049; ci += 1) {
			poke(sdat, 0, sb + 20487 + ci);
		}
		for (ci = 0; ci < 4098; ci += 1) {
			poke(sdat, 0, sb + 22536 + ci);
			poke(sdat, 0, sb + 26634 + ci);
		}
		rd = 0;
		jobId = jobCount;
		jobWait = 0;
		firstFrame = 1;
		finished = 0;
		stepPrev = 0;
		onsetHold = 0;
		curNote = vNote;
		dirS = dirSign;
		initN = (reverseOn > 0.5) ? effE : effS;
		liveOn = (peek(prm, 51) > 0.5) ? 1 : 0;
		burstLeft = (liveOn > 0.5) ? 4 : 0;
		headN = (liveOn > 0.5) ? (initN - dirSign * hopN * speedUse * srRat / nFr) : initN;
		hopCtr = hopN;
	}

	// Frame parameters for the jobs
	poke(sdat, nCur, sb + 55328 + 0);
	poke(sdat, nCur * 0.5, sb + 55328 + 1);
	poke(sdat, hopN, sb + 55328 + 2);
	poke(sdat, pr * srRat, sb + 55328 + 3);
	poke(sdat, fEff * srRat, sb + 55328 + 4);
	poke(sdat, peek(prm, 48), sb + 55328 + 5);
	poke(sdat, rootHz * nCur / (srVal * srRat), sb + 55328 + 6);
	poke(sdat, bendR, sb + 55328 + 7);
	poke(sdat, reharm, sb + 55328 + 8);
	poke(sdat, round(clip(peek(prm, 43), 0, 2)), sb + 55328 + 9);
	poke(sdat, clip(peek(prm, 46), 0, 1), sb + 55328 + 10);
	poke(sdat, round(clip(peek(prm, 44), 0, 11)), sb + 55328 + 11);
	poke(sdat, round(clip(peek(prm, 45), 0, 1)), sb + 55328 + 12);
	poke(sdat, srVal, sb + 55328 + 13);
	poke(sdat, fNote, sb + 55328 + 14);
	poke(sdat, clip(peek(prm, 49), 0, 1), sb + 55328 + 15);
	poke(sdat, peek(prm, 47), sb + 55328 + 16);
	poke(sdat, onsetNow, sb + 55328 + 19);
	poke(sdat, fract(vSeed * 3.1 + frameNo * 0.137), sb + 55328 + 20);
	poke(sdat, effS * nFr, sb + 55328 + 23);
	poke(sdat, effE * nFr, sb + 55328 + 24);
	poke(sdat, nFr, sb + 55328 + 25);
	poke(sdat, 4096 / nCur, sb + 55328 + 26);
	poke(sdat, 1.0 / max(speedUse, 0.05), sb + 55328 + 29);
	poke(sdat, ((slicedFlag > 0.5) && (wmEff > 0.5)) ? wmEff : 0, sb + 55328 + 30);

	marginN = (nCur * 0.5 + hopN * 4.0 + 64.0) / nFr;
	if (jobWait > 0) {
		jobWait = jobWait - 1;
	}
	nrun = (act > 0.5) ? ((burstLeft > 0) ? (4 * jobCount + 4) : 1) : 0;
	for (q = 0; q < nrun; q += 1) {
		if (jobId >= jobCount) {
			due = ((burstLeft > 0) || (hopCtr >= hopN)) ? 1 : 0;
			if ((due > 0.5) && (finished < 0.5)) {
				startOff = hopN;
				frameBurst = 0;
				if (burstLeft > 0) {
					bk = 4 - burstLeft;
					burstLeft = burstLeft - 1;
					startOff = (bk - 3) * hopN;
					frameBurst = 1;
					hopCtr = (burstLeft == 0) ? hopN : 0;
				} else {
					hopCtr = 0;
				}
				stepF = hopN * srRat * ((onsetHold > 0.5) ? 1.0 : speedUse);
				cN = headN;
				haNow = stepPrev;
				if (freezeOn > 0.5) {
					cN = clip(effS + playPosNorm * (effE - effS) + posMod, effS, effE);
					haNow = 0;
				}
				poke(sdat, cN * nFr, sb + 55328 + 21);
				poke(sdat, dirS, sb + 55328 + 22);
				poke(sdat, firstFrame, sb + 55328 + 17);
				poke(sdat, haNow, sb + 55328 + 18);
				poke(sdat, wrap(rd + startOff, 0, 8192), sb + 55328 + 27);
				poke(sdat, max(0.0 - startOff, 0.0), sb + 55328 + 28);
				if (freezeOn < 0.5) {
					hn, dn, dd = head_step(headN, dirS, stepF / nFr, effS - marginN, effE + marginN, rlo, rhi, wmEff);
					headN = hn;
					dirS = dn;
					stepPrev = stepF;
					if ((dd > 0.5) && (wmEff < 0.5)) {
						finished = 1;
					}
				}
				firstFrame = 0;
				onsetHold = max(onsetHold - 1, 0);
				onsetNow = 0;
				frameNo = wrap(frameNo + 1, 0, 100000);
				jobId = 0;
				jobWait = 0;
			}
		}
		if (jobId < jobCount) {
			if ((frameBurst > 0.5) || (jobWait <= 0)) {
				jj = jobId;
				isFwd = ((jj >= 1) && (jj <= llog)) ? 1 : 0;
				isInv = ((jj >= llog + 6) && (jj <= 2 * llog + 5)) ? 1 : 0;
				if (jj == 0) {
					job_capture(sdat, sb, brv, twr, sampBuf);
				}
				if ((isFwd > 0.5) || (isInv > 0.5)) {
					sIdx = (isFwd > 0.5) ? jj : (jj - llog - 5);
					sg = (isFwd > 0.5) ? 1 : -1;
					fft_pass(sdat, sb, twr, twi, nCur, sIdx, sg);
				}
				if ((jj == llog + 1) || (jj == llog + 3)) {
					chA = (jj == llog + 1) ? 0 : 1;
					job_analyze(sdat, senv, sb, chA);
					if (jj == llog + 1) {
						onsetNow = ((peek(prm, 47) > 0.5) && (peek(sdat, sb + 55328 + 17) < 0.5) && (peek(sdat, sb + 55312 + 0) > 0.35)) ? 1 : 0;
						if (onsetNow > 0.5) {
							onsetHold = 3;
						}
						poke(sdat, onsetNow, sb + 55328 + 19);
					}
				}
				if ((jj == llog + 2) || (jj == llog + 4)) {
					chM = (jj == llog + 2) ? 0 : 1;
					job_map(sdat, sb, chM);
				}
				if (jj == llog + 5) {
					job_pack(sdat, sb, brv);
				}
				if (jj == 2 * llog + 6) {
					job_ola(sdat, sb, twr);
				}
				jobId = jobId + 1;
				jobWait = spacing;
			}
		}
	}

	outL = 0;
	outR = 0;
	if (act > 0.5) {
		outL = peek(sdat, sb + 38928 + rd);
		outR = peek(sdat, sb + 47120 + rd);
		poke(sdat, 0, sb + 38928 + rd);
		poke(sdat, 0, sb + 47120 + rd);
		rd = wrap(rd + 1, 0, 8192);
		hopCtr = hopCtr + 1;
	}
	poke(sdat, prevTrig, sb + 55360 + 0);
	poke(sdat, wasOn, sb + 55360 + 1);
	poke(sdat, nCur, sb + 55360 + 2);
	poke(sdat, llog, sb + 55360 + 3);
	poke(sdat, hopN, sb + 55360 + 4);
	poke(sdat, jobCount, sb + 55360 + 5);
	poke(sdat, spacing, sb + 55360 + 6);
	poke(sdat, jobId, sb + 55360 + 7);
	poke(sdat, jobWait, sb + 55360 + 8);
	poke(sdat, hopCtr, sb + 55360 + 9);
	poke(sdat, rd, sb + 55360 + 10);
	poke(sdat, headN, sb + 55360 + 11);
	poke(sdat, dirS, sb + 55360 + 12);
	poke(sdat, stepPrev, sb + 55360 + 13);
	poke(sdat, finished, sb + 55360 + 14);
	poke(sdat, firstFrame, sb + 55360 + 15);
	poke(sdat, burstLeft, sb + 55360 + 16);
	poke(sdat, frameBurst, sb + 55360 + 17);
	poke(sdat, onsetHold, sb + 55360 + 18);
	poke(sdat, curNote, sb + 55360 + 19);
	poke(sdat, frameNo, sb + 55360 + 20);
	poke(sdat, onsetNow, sb + 55360 + 21);
	return fixnan(outL), fixnan(outR), clip(headN, 0, 1), 0;
}

// Single polyphonic voice processor (up to 8-voice stereo unison, Amp ADSR, Mod ADSR, 5 engines).
// Engine 3 (Spectral) takes its audio from spec_voice (extL / extR / extPos). New parameters come in
// through the prm table (see the main section for the layout).
voice_proc(
	sampBuf,
	vdataBuf,
	vIdx,
	modeVal,
	freezeOn,
	rootMidi,
	pitchSt,
	fineCents,
	playPosNorm,
	startNorm,
	endNorm,
	loopMode,
	loopStartNorm,
	loopEndNorm,
	xfadeNorm,
	reverseOn,
	grainSizeMs,
	grainMotion,
	grainSpray,
	formantSt,
	unisonCount,
	unisonDetune,
	unisonWidth,
	glideCoef,
	atkCoef,
	decCoef,
	susLevel,
	relCoef,
	matkCoef,
	mdecCoef,
	msusLevel,
	mrelCoef,
	velSens,
	lfoSig,
	lfoPitchAmt,
	lfoPosAmt,
	menvPitchAmt,
	menvPosAmt,
	numFrames,
	srVal,
	slicePlay,
	prm,
	vst,
	tbuf,
	vhist,
	extL,
	extR,
	extPos,
	pitchBuf,
	gtel,
	telTick
) {
	stB = vIdx * 256;
	// Grain telemetry: on a telemetry tick every voice rewrites its 32 grain slots (position -1 = unused, level 0).
	gtB = vIdx * 64;
	if (telTick > 0.5) {
		for (gx = 0; gx < 32; gx += 1) {
			poke(gtel, -1, gtB + gx);
			poke(gtel, 0, gtB + 32 + gx);
		}
	}
	prevTrig = peek(vhist, stB + 0);
	envStage = peek(vhist, stB + 1);
	ampEnv = peek(vhist, stB + 2);
	modStage = peek(vhist, stB + 3);
	modEnv = peek(vhist, stB + 4);
	curNote = peek(vhist, stB + 5);
	playheadNorm = peek(vhist, stB + 6);
	grainPhs = peek(vhist, stB + 7);
	rndA = peek(vhist, stB + 8);
	rndB = peek(vhist, stB + 9);
	cycPhs0 = peek(vhist, stB + 10);
	// Envelope slopes: relInt/relOut = internal level and output level at the start of the release (amp 44/45, mod 48/49).
	relIntA = peek(vhist, stB + 44);
	relOutA = peek(vhist, stB + 45);
	relIntM = peek(vhist, stB + 48);
	relOutM = peek(vhist, stB + 49);
	cycPhs1 = peek(vhist, stB + 11);
	cycPhs2 = peek(vhist, stB + 12);
	cycPhs3 = peek(vhist, stB + 13);
	cycPhs4 = peek(vhist, stB + 14);
	cycPhs5 = peek(vhist, stB + 15);
	cycPhs6 = peek(vhist, stB + 16);
	cycPhs7 = peek(vhist, stB + 17);
	driftPhs = peek(vhist, stB + 18);
	formSm = peek(vhist, stB + 19);
	lastMode = peek(vhist, stB + 20);
	scanDir = peek(vhist, stB + 21);
	prevBS = peek(vhist, stB + 22);
	prevBE = peek(vhist, stB + 23);
	tailL = peek(vhist, stB + 24);
	tailR = peek(vhist, stB + 25);
	xfG = peek(vhist, stB + 26);
	lastSigL = peek(vhist, stB + 27);
	lastSigR = peek(vhist, stB + 28);
	headDone = peek(vhist, stB + 29);
	doneG = peek(vhist, stB + 30);
	spawnTmr = peek(vhist, stB + 31);
	spawnCnt = peek(vhist, stB + 32);
	altFlip = peek(vhist, stB + 33);
	rndCtr = peek(vhist, stB + 34);
	survG = peek(vhist, stB + 35);
	allocIdx = peek(vhist, stB + 36);
	survTimer = peek(vhist, stB + 37);
	frzPrev = peek(vhist, stB + 40);
	frzWinS = peek(vhist, stB + 41);

	gB = vIdx * 400;
	latB = gB + 320;
	mpB = gB + 336;
	lenB = gB + 344;
	ovB = gB + 360;
	baseSlot = vIdx * 8;
	vGate = peek(vdataBuf, baseSlot + 0);
	vNote = peek(vdataBuf, baseSlot + 1);
	vVel = clip(peek(vdataBuf, baseSlot + 2), 0, 1);
	vTrig = peek(vdataBuf, baseSlot + 3);
	vSliceStart = clip(peek(vdataBuf, baseSlot + 4), 0, 1);
	vSliceEnd = clip(peek(vdataBuf, baseSlot + 5), 0, 1);
	vPanSeed = clip(peek(vdataBuf, baseSlot + 6), -1, 1);
	vSeed = clip(peek(vdataBuf, baseSlot + 7), 0, 1);

	isNewTrig = (vTrig != prevTrig) && (vGate > 0.5);
	modeId = round(clip(modeVal, 0, 4));
	isSlice = (peek(prm, 0) > 0.5);

	// Play region. Sliced: the voice's slice bounds, read live from vdata every sample.
	slicePlayId = round(clip(slicePlay, 0, 3));
	revSlice = (reverseOn > 0.5);
	wmSlice = (slicePlayId > 2.5) ? 2 : ((slicePlayId > 1.5) ? 1 : 0);
	effStartNorm, effEndNorm, sampStartN, sampEndN = slice_region(vSliceStart, vSliceEnd, startNorm, endNorm, peek(prm, 0), slicePlay, reverseOn);

	hn = 0;
	dn = 1;
	dd = 0;

	if (isNewTrig) {
		prevTrig = vTrig;
		envStage = 1;
		modStage = 1;
		curNote = vNote;
		// Pos (play_pos) only matters while Freeze is on, which overrides the playhead anyway.
		initNorm = (reverseOn > 0.5) ? effEndNorm : effStartNorm;
		playheadNorm = initNorm;
		headDone = 0;
		doneG = 1;
		spawnTmr = 0;
	}

	if (vGate < 0.5) {
		if (envStage != 0) {
			relIntA = ampEnv;
			relOutA = peek(vhist, stB + 46);
		}
		if (modStage != 0) {
			relIntM = modEnv;
			relOutM = peek(vhist, stB + 47);
		}
		envStage = 0;
		modStage = 0;
	}

	if ((envStage == 0) && (ampEnv < 0.00002)) {
		ampEnv = 0;
		modEnv = 0;
	}

	if (envStage == 1) {
		ampEnv = ampEnv + (1.05 - ampEnv) * (1.0 - atkCoef);
		if (ampEnv >= 1.0) {
			ampEnv = 1.0;
			envStage = 2;
		}
	} else if (envStage == 2) {
		ampEnv = susLevel + (ampEnv - susLevel) * decCoef;
	} else {
		ampEnv = ampEnv * relCoef;
	}
	ampEnv = clip(ampEnv, 0, 1);

	if (modStage == 1) {
		modEnv = modEnv + (1.05 - modEnv) * (1.0 - matkCoef);
		if (modEnv >= 1.0) {
			modEnv = 1.0;
			modStage = 2;
		}
	} else if (modStage == 2) {
		modEnv = msusLevel + (modEnv - msusLevel) * mdecCoef;
	} else {
		modEnv = modEnv * mrelCoef;
	}
	modEnv = clip(modEnv, 0, 1);

	// Slope-shaped and Initial / Peak / Final-scaled OUTPUT levels (ampEnv / modEnv stay the internal progress state).
	// bend(p, s) = p ^ 4^-s; with default init=0, peak=1, final=0 and slope=0 the output equals the internal level.
	slA = peek(prm, 56);
	slD = peek(prm, 57);
	slR = peek(prm, 58);
	slMA = peek(prm, 59);
	slMD = peek(prm, 60);
	slMR = peek(prm, 61);
	aInit = peek(prm, 62);
	aPeak = peek(prm, 63);
	mInit = peek(prm, 64);
	mPeak = peek(prm, 65);
	mFin = peek(prm, 66);
	aOut = 0;
	mOut = 0;
	// Decay / release bends blend back to the unbent progress over the last 2 % (smoothstep end-window), so every segment ends
	// exactly where the internal envelope does (sus / final) and the idle cutoff never sees a step.
	if (envStage == 1) {
		esB = (slA != 0) ? pow(ampEnv, peek(prm, 17)) : ampEnv;
		aOut = aInit + (aPeak - aInit) * esB;
	} else if (envStage == 2) {
		esP = clip((ampEnv - susLevel) / max(1.0 - susLevel, 0.000001), 0, 1);
		esB = esP;
		if (slD != 0) {
			esT = clip(esP / 0.02, 0, 1);
			esW = esT * esT * (3.0 - 2.0 * esT);
			esB = esP + (pow(esP, peek(prm, 18)) - esP) * esW;
		}
		aOut = susLevel + (aPeak - susLevel) * esB;
	} else if (ampEnv > 0.00002) {
		esP = clip(ampEnv / max(relIntA, 0.000001), 0, 1);
		esB = esP;
		if (slR != 0) {
			esT = clip(esP / 0.02, 0, 1);
			esW = esT * esT * (3.0 - 2.0 * esT);
			esB = esP + (pow(esP, peek(prm, 19)) - esP) * esW;
		}
		aOut = relOutA * esB;
	}
	if (modStage == 1) {
		emB = (slMA != 0) ? pow(modEnv, peek(prm, 32)) : modEnv;
		mOut = mInit + (mPeak - mInit) * emB;
	} else if (modStage == 2) {
		emP = clip((modEnv - msusLevel) / max(1.0 - msusLevel, 0.000001), 0, 1);
		emB = emP;
		if (slMD != 0) {
			emT = clip(emP / 0.02, 0, 1);
			emW = emT * emT * (3.0 - 2.0 * emT);
			emB = emP + (pow(emP, peek(prm, 33)) - emP) * emW;
		}
		mOut = msusLevel + (mPeak - msusLevel) * emB;
	} else if (modEnv > 0.00002) {
		emP = clip(modEnv / max(relIntM, 0.000001), 0, 1);
		emB = emP;
		if (slMR != 0) {
			emT = clip(emP / 0.02, 0, 1);
			emW = emT * emT * (3.0 - 2.0 * emT);
			emB = emP + (pow(emP, peek(prm, 34)) - emP) * emW;
		}
		mOut = mFin + (relOutM - mFin) * emB;
	}

	curNote = mix(vNote, curNote, glideCoef);
	// Sliced: the MIDI note picks the slice, so the pitch tracks the root key.
	hzNote = isSlice ? rootMidi : curNote;
	baseHz = 440.0 * pow(2.0, (hzNote - 69.0 + pitchSt + fineCents * 0.01 + lfoSig * lfoPitchAmt * 24.0 + mOut * menvPitchAmt * 24.0) / 12.0);

	posMod = lfoSig * lfoPosAmt * 0.45 + mOut * menvPosAmt * 0.45;
	startF = effStartNorm * numFrames;
	endF = effEndNorm * numFrames;
	spanNorm = max(effEndNorm - effStartNorm, 0.002);
	lStartF = clip(loopStartNorm, effStartNorm, effEndNorm - 0.002) * numFrames;
	lEndF = clip(loopEndNorm, loopStartNorm + 0.002, effEndNorm) * numFrames;

	uCount = int(clip(round(unisonCount), 1, 8));
	sampG = peek(prm, 55);
	uNormGain = peek(prm, 15);
	dirSign = (reverseOn > 0.5) ? -1.0 : 1.0;
	driftPhs = fract(driftPhs + (0.22 + vSeed * 0.18) / max(srVal, 1));

	formTarget = peek(prm, 13);
	needInit = isNewTrig || (lastMode != modeId);
	if (needInit) {
		scanDir = (dirSign < 0.0) ? -1.0 : 1.0;
		driftPhs = fract(vSeed + 0.17);
		formSm = formTarget;
		grainPhs = fract(vSeed * 3.71);
		rndA = fract(vSeed * 17.31 + 0.13);
		rndB = fract(vSeed * 43.19 + 0.57);
		if (((isNewTrig) && (peek(prm, 30) < 0.5)) || (lastMode != modeId)) {
			for (gi = 0; gi < 320; gi += 1) {
				poke(vst, 0, gB + gi);
			}
		}
	} else {
		formSm = formSm + (formTarget - formSm) * 0.0018;
	}
	lastMode = modeId;
	// A note that starts frozen puts the read head on Pos at once (a held note glides there, like tape).
	if (needInit && (freezeOn > 0.5)) {
		playheadNorm = clip(effStartNorm + playPosNorm * spanNorm + posMod, effStartNorm, effEndNorm);
	}

	// Slice behaviour of the Repitch engine: 0 to slice end and 1 to sample end play once, 2 loops, 3 ping-pongs.
	effLoopMode = isSlice ? ((slicePlayId > 2.5) ? 2 : ((slicePlayId > 1.5) ? 1 : 0)) : loopMode;
	effLStart = isSlice ? startF : lStartF;
	effLEnd = isSlice ? endF : lEndF;
	xfEff = isSlice ? max(xfadeNorm, 0.02) : xfadeNorm;

	// Live slice bounds: the UI may re-poke slots 4/5 of a held voice without a new trigger.
	// Repitch: a playhead that ends up outside the new bounds restarts at the new slice start
	// (end when reversed) through a short held-tail crossfade; one-shots that already passed the end
	// simply stay finished. The other engines jump to the new start when the bounds changed and the
	// playhead is outside them.
	jumped = 0;
	ppRemap = 0;
	curF = playheadNorm * numFrames;
	oldBsF = 0;
	oldBeF = 0;
	oldFold = 0;
	jumpTo = 0;
	liveSlice = isSlice && (needInit == 0) && (vGate > 0.5) && (freezeOn < 0.5);
	if (liveSlice) {
		if (modeId < 0.5) {
			if (effLoopMode > 1.5) {
				if (abs(effStartNorm - prevBS) + abs(effEndNorm - prevBE) > 0.0000001) {
					ppRemap = 1;
					oldBsF = prevBS * numFrames;
					oldBeF = prevBE * numFrames;
					oldFold = pp_pos(curF, oldBsF, oldBeF);
					jumped = ((oldFold < startF - 1.0) || (oldFold > endF + 1.0)) ? 1 : 0;
					playheadNorm = pp_remap(curF, oldBsF, oldBeF, startF, endF, dirSign) / max(numFrames, 1);
				}
			} else {
				jumpTo = (revSlice ? endF : startF);
				farSide = (revSlice ? (curF < startF - 1.0) : (curF > endF + 1.0));
				nearSide = (revSlice ? (curF > endF + 1.0) : (curF < startF - 1.0));
				if (nearSide || (farSide && (effLoopMode > 0.5))) {
					jumped = 1;
					playheadNorm = jumpTo / max(numFrames, 1);
				}
			}
		} else if ((modeId < 2.5) || (modeId > 3.5)) {
			if (abs(effStartNorm - prevBS) + abs(effEndNorm - prevBE) > 0.0000001) {
				if ((playheadNorm < effStartNorm - 0.0001) || (playheadNorm > effEndNorm + 0.0001)) {
					jumped = 1;
					headDone = 0;
					scanDir = dirSign;
					playheadNorm = revSlice ? effEndNorm : effStartNorm;
				}
			}
		}
	}
	prevBS = effStartNorm;
	prevBE = effEndNorm;
	origin = playheadNorm * numFrames;

	// Analyzed Root Key: the root at the voice's read position (folded for a ping-pong loop), so the ratio follows the
	// pitch curve while the playhead moves. Sliced keys play the root pitch (the note picks the slice). With root_dyn
	// off root_at returns rootMidi and this is the plain note - root ratio.
	rootPosF = playheadNorm * numFrames;
	if ((modeId < 0.5) && (effLoopMode > 1.5) && (isSlice || (rootPosF >= effLStart))) {
		rootPosF = pp_pos(rootPosF, effLStart, effLEnd);
	}
	rootNow = root_at(pitchBuf, rootPosF / max(numFrames, 1), rootMidi, peek(prm, 53));
	pitchSemiOffset = ((isSlice ? rootMidi : curNote) - rootNow)
		+ pitchSt
		+ fineCents * 0.01
		+ lfoSig * lfoPitchAmt * 24.0
		+ mOut * menvPitchAmt * 24.0;
	baseRatio = pow(2.0, clip(pitchSemiOffset, -48, 48) / 12.0);
	// Source frames per output sample: a file at another rate than the DSP advances by its rate ratio too.
	srRat = peek(prm, 54);
	stepRatio = baseRatio * srRat;
	srFile = srVal * srRat;

	sigL = 0;
	sigR = 0;
	aliveCnt = 0;

	// One unison_spread call site (it inlines pow + sin). Sub-voice pan gains are the same formula for
	// Repitch, Cycles and Textures; Fragments adds its own motion on top of uFrac / detRatio.
	for (u = 0; u < 8; u += 1) {
		if (u < uCount) {
			uf0, dr0 = unison_spread(u, uCount, unisonDetune, driftPhs, vSeed);
			poke(vhist, uf0, stB + 160 + u);
			poke(vhist, dr0, stB + 168 + u);
			if (modeId < 2.5) {
				pan0 = clip(uf0 * unisonWidth + vPanSeed * 0.15, -1, 1);
				gl0 = sqrt(0.5 * (1.0 - pan0));
				gr0 = sqrt(0.5 * (1.0 + pan0));
				poke(vhist, gl0, stB + 176 + u);
				poke(vhist, gr0, stB + 184 + u);
			}
			if ((modeId < 0.5) || ((modeId > 1.5) && (modeId < 2.5))) {
				chPh = driftPhs * 1.37 + u * 0.125 + vSeed;
				chS = sin(6.28318530718 * (chPh - floor(chPh)));
				poke(vhist, chS, stB + 192 + u);
			}
		}
	}

	if (modeId < 0.5) {
		// ---------------- REPITCH ----------------
		spanF = max(effLEnd - effLStart, 4);
		xfF = min(spanF * clip(xfEff, 0, 0.45), spanF * 0.5);
		// Gen scopes a name to the if that first assigns it. Seed both so the
		// loop below can read them on every path.
		periodF = spanF;
		loopBottom = effLStart;
		if (xfF > 2.0) {
			periodF = max(spanF - xfF, 4);
			loopBottom = effLStart + xfF;
		}
		posModFrames = posMod * numFrames;
		playFrames = playheadNorm * numFrames;
		frzOn = (freezeOn > 0.5) ? 1 : 0;
		// Frozen: a smooth, continuous read head. Pos is a target the head glides to (two cascaded one-pole slews of 18 ms:
		// the head has some inertia and steps of Pos do not make its speed jump; the speed is limited), so moving Pos drags
		// the read position like tape: the head speed adds to the playback speed (a Doppler bend) and nothing jumps. While the
		// head rests it plays a seamless loop around itself: a whole number of root cycles of about 75 ms, with a 25 % linear
		// crossfade at the loop seam (the window rides with the head, its loop phase is relative to the window start).
		fzLS = effLStart;
		fzSpan = 4.0;
		fzPer = 4.0;
		if (frzOn > 0.5) {
			tgtF = clip(effStartNorm + playPosNorm * spanNorm + posMod, effStartNorm, effEndNorm) * numFrames;
			slewC = peek(prm, 16);
			headMid = peek(vhist, stB + 42);
			if (needInit || (frzPrev < 0.5)) {
				headMid = playFrames;
			}
			headMid = headMid + (tgtF - headMid) * slewC;
			poke(vhist, headMid, stB + 42);
			playFrames = playFrames + clip((headMid - playFrames) * slewC, -6.0, 6.0);
			cycFz = cyc_len(pitchBuf, playFrames / max(numFrames, 1), numFrames, rootMidi, peek(prm, 53), srFile);
			fzPer = max(floor(0.075 * srFile / cycFz + 0.5), 1.0) * cycFz;
			fzSpan = min(fzPer / 0.75, max(endF - startF, 16.0));
			fzPer = fzSpan * 0.75;
			fzLS = clip(playFrames - fzSpan * 0.5, startF, max(endF - fzSpan, startF));
		} else {
			prevFrames = playheadNorm * numFrames;
			playFrames = prevFrames + dirSign * stepRatio;
			if (effLoopMode > 1.5) {
				if (isSlice || (playFrames >= effLStart)) {
					playFrames = effLStart + wrap(playFrames - effLStart, 0, spanF * 2.0);
				}
			} else if (effLoopMode > 0.5) {
				if ((dirSign > 0.0) && (playFrames >= effLEnd) && (prevFrames >= effLStart)) {
					playFrames = loopBottom + wrap(playFrames - effLEnd, 0, periodF);
				} else if ((dirSign < 0.0) && (playFrames < loopBottom) && (prevFrames >= loopBottom)) {
					playFrames = effLEnd - (loopBottom - playFrames);
					if (playFrames < loopBottom) {
						playFrames = loopBottom + wrap(playFrames - loopBottom, 0, periodF);
					}
				}
			} else {
				playFrames = clip(playFrames, -8, numFrames + 8);
			}
		}
		frzXfLen = fzSpan * 0.25;
		frzWinS = fzLS;
		playheadNorm = playFrames / max(numFrames, 1);

		for (u = 0; u < uCount; u += 1) {
			pCur = (u == 0) ? cycPhs0 : ((u == 1) ? cycPhs1 : ((u == 2) ? cycPhs2 : ((u == 3) ? cycPhs3 : ((u == 4) ? cycPhs4 : ((u == 5) ? cycPhs5 : ((u == 6) ? cycPhs6 : cycPhs7))))));
			if (frzOn > 0.5) {
				// window-relative loop phase; entering the freeze starts it at the head of the loop
				if (needInit || (jumped > 0.5) || (frzPrev < 0.5)) {
					pCur = frzXfLen;
				}
			} else if (frzPrev > 0.5) {
				// leaving the freeze: back to an absolute position inside the window it was playing
				pCur = peek(vhist, stB + 41) + pCur;
			} else if (needInit || (jumped > 0.5)) {
				pCur = origin;
			} else if (ppRemap > 0.5) {
				pCur = pp_remap(pCur, oldBsF, oldBeF, startF, endF, dirSign);
			}
			pNext = pCur;
			if (u < uCount) {
				detRatio = peek(vhist, stB + 168 + u);
				gL = peek(vhist, stB + 176 + u);
				gR = peek(vhist, stB + 184 + u);
				uChorus = peek(vhist, stB + 192 + u) * unisonDetune * 12.0;
				readPos = pCur;

				if (frzOn > 0.5) {
					phiN = pCur + dirSign * stepRatio * detRatio;
					if (dirSign > 0.0) {
						if (phiN >= fzSpan) {
							phiN = frzXfLen + wrap(phiN - fzSpan, 0, fzPer);
						}
					} else if (phiN < frzXfLen) {
						phiN = fzSpan - (frzXfLen - phiN);
						if (phiN < frzXfLen) {
							phiN = frzXfLen + wrap(phiN - frzXfLen, 0, fzPer);
						}
					}
					pNext = phiN;
					readPos = fzLS + phiN;
				} else {
					stepped = pCur + dirSign * stepRatio * detRatio;
					pNext = stepped;
					readPos = stepped + uChorus + posModFrames;
					if (effLoopMode > 1.5) {
						if (isSlice || (readPos >= effLStart)) {
							readPos = effLStart + wrap(readPos - effLStart, 0, spanF * 2.0);
							pNext = readPos - uChorus - posModFrames;
						}
					} else if (effLoopMode > 0.5) {
						if ((dirSign > 0.0) && (readPos >= effLEnd) && (pCur >= effLStart)) {
							readPos = loopBottom + wrap(readPos - effLEnd, 0, periodF);
							pNext = readPos - uChorus - posModFrames;
						} else if ((dirSign < 0.0) && (readPos < loopBottom) && (pCur >= loopBottom)) {
							readPos = effLEnd - (loopBottom - readPos);
							if (readPos < loopBottom) {
								readPos = loopBottom + wrap(readPos - loopBottom, 0, periodF);
							}
							pNext = readPos - uChorus - posModFrames;
						}
					} else {
						pNext = clip(stepped, -8, numFrames + 8);
						readPos = pNext + uChorus + posModFrames;
					}
				}

				uL = 0;
				uR = 0;
				if (frzOn > 0.5) {
					uL, uR = frz_read(sampBuf, fzLS, pNext, fzPer, frzXfLen, max(numFrames - 1, 1));
				} else {
					uL, uR = read_repitch(sampBuf, readPos, startF, endF, effLStart, effLEnd, effLoopMode, xfEff, numFrames);
				}
				sigL = sigL + uL * gL * uNormGain;
				sigR = sigR + uR * gR * uNormGain;
			}
			cycPhs0 = (u == 0) ? pNext : cycPhs0;
			cycPhs1 = (u == 1) ? pNext : cycPhs1;
			cycPhs2 = (u == 2) ? pNext : cycPhs2;
			cycPhs3 = (u == 3) ? pNext : cycPhs3;
			cycPhs4 = (u == 4) ? pNext : cycPhs4;
			cycPhs5 = (u == 5) ? pNext : cycPhs5;
			cycPhs6 = (u == 6) ? pNext : cycPhs6;
			cycPhs7 = (u == 7) ? pNext : cycPhs7;
		}

		// Repitch characters: 1 Analog, 2 Digital
		rpChar = round(clip(peek(prm, 1), 0, 2));
		if (rpChar > 0.5) {
			rpDist = clip(peek(prm, 2), 0, 1);
			rpColor = clip(peek(prm, 3), -1, 1);
			if (rpChar < 1.5) {
				aL = analog_chan(sigL, rpDist, rpColor, baseRatio, srVal, vhist, stB + 64);
				aR = analog_chan(sigR, rpDist, rpColor, baseRatio, srVal, vhist, stB + 72);
				sigL, sigR = tape_st(aL, aR, rpColor, baseRatio, srVal, tbuf, vIdx * 8192, vhist, stB + 80);
			} else {
				sigL, sigR = digital_st(sigL, sigR, rpDist, rpColor, baseRatio, peek(prm, 4), peek(prm, 5), srVal, vhist, stB + 96);
			}
		}
	} else if (modeId < 1.5) {
		// ---------------- CYCLES ----------------
		if (freezeOn > 0.5) {
			playheadNorm = clip(effStartNorm + playPosNorm * spanNorm + posMod, effStartNorm, effEndNorm);
		} else {
			// The playhead moves by elapsed time x Speed (grain_motion 1.0 = real time, one source frame per output
			// sample) whatever note is played: pitch is locked to the key, time is independent. Sliced ends like
			// slice_play, Single like the Loop mode (Off stops at the end, Fwd wraps inside the loop region, Ping-Pong bounces).
			wmCy = isSlice ? wmSlice : ((loopMode > 1.5) ? 2 : ((loopMode > 0.5) ? 1 : 0));
			rloCy = isSlice ? effStartNorm : clip(loopStartNorm, effStartNorm, effEndNorm - 0.002);
			rhiCy = isSlice ? effEndNorm : clip(loopEndNorm, rloCy + 0.002, effEndNorm);
			stepCy = abs(grainMotion) * srRat / max(numFrames, 1);
			hn, dn, dd = head_step(playheadNorm, scanDir, stepCy, effStartNorm, effEndNorm, rloCy, rhiCy, wmCy);
			playheadNorm = hn;
			scanDir = dn;
			if ((dd > 0.5) && (wmCy < 0.5)) {
				headDone = 1;
			}
		}
		anchorNorm = clip(playheadNorm + ((freezeOn > 0.5) ? 0.0 : posMod), effStartNorm, effEndNorm);
		rootHz = 440.0 * pow(2.0, (root_at(pitchBuf, anchorNorm, rootMidi, peek(prm, 53)) - 69.0) / 12.0);
		cycleLenF = clip(srFile / max(rootHz, 20.0), 32.0, 8192.0);
		halfRead = cycleLenF * max(formSm, 1.0) * 0.5;
		anchorTop = max(numFrames - 1 - halfRead, 0);
		anchorF = max(numFrames - 1, 1) * 0.5;
		if (anchorTop > halfRead) {
			anchorF = clip(anchorNorm * max(numFrames - 1, 1), halfRead, anchorTop);
		}
		cyChar = round(clip(peek(prm, 6), 0, 2));
		cyDuty = 0.5 + 0.45 * clip(peek(prm, 7), -1, 1);
		cySplit = clip(peek(prm, 8), -1, 1);
		cyFund = clip(peek(prm, 9), 0, 1);
		cyMod = clip(peek(prm, 10), 0, 1);
		cyHarm = clip(peek(prm, 11), -1, 1);
		cyXf = peek(prm, 12);
		harmRatio = (cyHarm >= 0) ? (1.0 + round(cyHarm * 7.0)) : (1.0 / (1.0 + round(0.0 - cyHarm * 3.0)));
		maxIdxC = max(numFrames - 1, 1);
		ovQ = (cyXf > 0.5) ? 0.6 : 0.5;

		for (u = 0; u < uCount; u += 1) {
			pCur = (u == 0) ? cycPhs0 : ((u == 1) ? cycPhs1 : ((u == 2) ? cycPhs2 : ((u == 3) ? cycPhs3 : ((u == 4) ? cycPhs4 : ((u == 5) ? cycPhs5 : ((u == 6) ? cycPhs6 : cycPhs7))))));
			if (needInit) {
				pCur = (u == 0) ? 0.0 : ((u == 1) ? 0.02 : ((u == 2) ? 0.05 : ((u == 3) ? 0.09 : ((u == 4) ? 0.14 : ((u == 5) ? 0.20 : ((u == 6) ? 0.27 : 0.35))))));
				poke(vst, anchorF, latB + u);
				poke(vst, anchorF, latB + 8 + u);
				poke(vst, cycleLenF, lenB + u);
				poke(vst, cycleLenF, lenB + 8 + u);
				poke(vst, 0, mpB + u);
				poke(vst, -1, ovB + u);
				poke(vst, ovQ, ovB + 8 + u);
				poke(vst, 1, ovB + 16 + u);
				poke(vst, 0, ovB + 24 + u);
			}
			pCur = fract(pCur);
			pNext = pCur;
			if (u < uCount) {
				detRatio = peek(vhist, stB + 168 + u);
				gL = peek(vhist, stB + 176 + u);
				gR = peek(vhist, stB + 184 + u);
				phsInc = clip((baseHz * detRatio) / max(srVal, 1), 0, 0.45);
				pNext = fract(pCur + phsInc);
				// Overlap-add: the current cycle fades in over its first q while the previous one, still reading the source past
				// its end at phase 1 + p, fades out. Both read the SAME phase, only the latched anchor / length differ. At the seam
				// the current cycle becomes the previous one and the next is latched at the start that best matches its
				// continuation (cyc_align, close to the whole-period lattice), so the join is a crossfade of two
				// reads of the same signal instead of a switch, and the output period stays exactly the note period while the
				// playhead scans. cy_xfade only lengthens the overlap (q 0.5 -> 0.6).
				if (pNext < pCur) {
					oldA = peek(vst, latB + u);
					oldL = peek(vst, lenB + u);
					poke(vst, oldA, latB + 8 + u);
					poke(vst, oldL, lenB + 8 + u);
					lat1 = cyc_len(pitchBuf, anchorF + 0.5 * cycleLenF, numFrames, rootMidi, peek(prm, 53), srFile);
					latC, latQ, latD, latOv, latExt, latCls = cyc_align(sampBuf, pitchBuf, anchorF, lat1, oldA, oldL, ovQ, peek(vst, ovB + 24 + u), formSm, (anchorTop > halfRead) ? halfRead : anchorF, (anchorTop > halfRead) ? anchorTop : anchorF, maxIdxC, numFrames, rootMidi, peek(prm, 53), srFile);
					latL = (peek(prm, 53) > 0.5) ? cyc_len(pitchBuf, latC + 0.5 * lat1, numFrames, rootMidi, peek(prm, 53), srFile) : latD;
					poke(vst, latC, latB + u);
					poke(vst, latL, lenB + u);
					poke(vst, latQ, ovB + u);
					poke(vst, latOv, ovB + 8 + u);
					poke(vst, latExt, ovB + 16 + u);
					poke(vst, latCls, ovB + 24 + u);
				}
				ancA = peek(vst, latB + u);
				ancB = peek(vst, latB + 8 + u);
				lenA = max(peek(vst, lenB + u), 32.0);
				lenBv = max(peek(vst, lenB + 8 + u), 32.0);
				rhoU = peek(vst, ovB + u);
				ovU = max(peek(vst, ovB + 8 + u), 0.02);
				extU = peek(vst, ovB + 16 + u);
				clsU = peek(vst, ovB + 24 + u);
				clsPrv = (extU < 0.5) ? 1.0 : 0.0;
				// Window of the current cycle: a raised cosine 0 -> 1 over its first ovU, the previous cycle gets the complement
				// (they sum to 1: no level change where the two reads coincide). rhoU < 0 = no previous cycle yet (note start).
				wCur = 1.0;
				wPrv = 0.0;
				if ((pNext < ovU) && (rhoU >= 0.0)) {
					hwT = 0.5 - 0.5 * cos(3.14159265359 * pNext / ovU);
					wCur = hwT;
					wPrv = 1.0 - hwT;
				}
				// Phase character: dirty-sine modulator at a stepped multiple of the pitch.
				pmV = 0;
				if (cyChar > 1.5) {
					mph = fract(peek(vst, mpB + u) + phsInc * harmRatio);
					poke(vst, mph, mpB + u);
					pmV = cyMod * 0.5 * (sin(6.28318530718 * mph) + 0.28 * sin(6.28318530718 * 3.0 * mph + 0.9) + 0.12 * sin(6.28318530718 * 5.0 * mph));
				}
				aL, aR = cyc_wave(sampBuf, ancA, lenA, formSm, pNext, clsU, cyChar, cyDuty, cySplit, pmV, maxIdxC);
				cL = aL * wCur;
				cR = aR * wCur;
				if (wPrv > 0.0) {
					bL, bR = cyc_wave(sampBuf, ancB, lenBv, formSm, pNext + extU, clsPrv, cyChar, cyDuty, cySplit, pmV, maxIdxC);
					cL = cL + bL * wPrv;
					cR = cR + bR * wPrv;
				}
				if ((cyChar > 0.5) && (cyChar < 1.5)) {
					fundS = sin(6.28318530718 * pNext) * 0.5;
					cL = mix(cL, fundS, cyFund);
					cR = mix(cR, fundS, cyFund);
				}
				sigL = sigL + cL * gL * uNormGain;
				sigR = sigR + cR * gR * uNormGain;
			}
			cycPhs0 = (u == 0) ? pNext : cycPhs0;
			cycPhs1 = (u == 1) ? pNext : cycPhs1;
			cycPhs2 = (u == 2) ? pNext : cycPhs2;
			cycPhs3 = (u == 3) ? pNext : cycPhs3;
			cycPhs4 = (u == 4) ? pNext : cycPhs4;
			cycPhs5 = (u == 5) ? pNext : cycPhs5;
			cycPhs6 = (u == 6) ? pNext : cycPhs6;
			cycPhs7 = (u == 7) ? pNext : cycPhs7;
		}
	} else if (modeId < 2.5) {
		// ---------------- TEXTURES ----------------
		if (freezeOn > 0.5) {
			playheadNorm = clip(effStartNorm + playPosNorm * spanNorm + posMod, effStartNorm, effEndNorm);
		} else {
			// The scan ends like the other engines: Sliced follows slice_play, Single follows the Loop mode.
			wmTx = isSlice ? wmSlice : ((loopMode > 1.5) ? 2 : ((loopMode > 0.5) ? 1 : 0));
			rloTx = isSlice ? effStartNorm : clip(loopStartNorm, effStartNorm, effEndNorm - 0.002);
			rhiTx = isSlice ? effEndNorm : clip(loopEndNorm, rloTx + 0.002, effEndNorm);
			hn, dn, dd = head_step(playheadNorm, scanDir, abs(grainMotion * stepRatio) / max(numFrames, 1), effStartNorm, effEndNorm, rloTx, rhiTx, wmTx);
			playheadNorm = hn;
			scanDir = dn;
			if ((dd > 0.5) && (wmTx < 0.5)) {
				headDone = 1;
			}
		}
		centerNorm = clip(playheadNorm + ((freezeOn > 0.5) ? 0.0 : posMod), effStartNorm, effEndNorm);
		centerF = centerNorm * numFrames;

		gLenSamps = max(grainSizeMs * 0.001 * srVal, 8.0);
		gRate = baseRatio / gLenSamps;
		if (gRate > 0.45) {
			gRate = 0.45;
		}
		if (gRate < 0.0) {
			gRate = 0.0;
		}
		// (`prevG = grainPhs; grainPhs = ...` would make prevG follow the new value: a plain `a = b` is an alias in GenExpr, so
		// the wrap was never seen and the grains kept the playhead position of the note start.)
		grainNew = fract(grainPhs + gRate);
		wrapA = (grainNew < grainPhs);
		wrapB = (fract(grainNew + 0.5) < fract(grainPhs + 0.5));
		grainPhs = grainNew;
		if (wrapA) {
			rndA = fract(rndA * 29.17 + 0.31 + vSeed * 0.07);
		}
		grainPhsB = fract(grainPhs + 0.5);
		if (abs(grainPhs - 0.5) < gRate) {
			rndB = fract(rndB * 37.91 + 0.19 + vSeed * 0.11);
		}
		// Each grain reads around the playhead position latched when its window starts (plus half a grain of scan,
		// so the grain is centred on where the playhead is at the middle of its window). Reading around the live
		// playhead added the scan speed to the grain's own read speed: natural speed sounded an octave high.
		leadF = (freezeOn > 0.5) ? 0.0 : (scanDir * abs(grainMotion * stepRatio) * 0.5 * gLenSamps);
		if (needInit) {
			poke(vst, centerF, latB);
			poke(vst, centerF, latB + 1);
		}
		// A looping slice can be shorter than a grain: its grains then wrap around inside the slice instead of
		// sticking to the slice edge (a sine sample is exactly 0 there).
		wrapGrain = (isSlice && (freezeOn < 0.5) && (wmSlice > 0.5)) ? 1 : 0;
		spanGF = max(endF - startF, 1);
		if (wrapA) {
			poke(vst, (wrapGrain > 0.5) ? (centerF + leadF) : clip(centerF + leadF, startF, endF), latB);
		}
		if (wrapB) {
			poke(vst, (wrapGrain > 0.5) ? (centerF + leadF) : clip(centerF + leadF, startF, endF), latB + 1);
		}
		cenA = (freezeOn > 0.5) ? centerF : peek(vst, latB);
		cenB = (freezeOn > 0.5) ? centerF : peek(vst, latB + 1);
		winA = 0.5 - 0.5 * cos(6.28318530718 * grainPhs);
		winB = 0.5 - 0.5 * cos(6.28318530718 * grainPhsB);
		spraySpanF = grainSpray * 0.65 * max(endF - startF, 0);
		maxIdxG = max(numFrames - 1, 1);

		for (u = 0; u < uCount; u += 1) {
			if (u < uCount) {
				detRatio = peek(vhist, stB + 168 + u);
				gL = peek(vhist, stB + 176 + u);
				gR = peek(vhist, stB + 184 + u);
				uChorus = peek(vhist, stB + 192 + u) * unisonDetune * 18.0;
				sprA = (fract(rndA + u * 0.173 + vSeed * 0.31) - 0.5) * spraySpanF;
				sprB = (fract(rndB + u * 0.271 + vSeed * 0.47) - 0.5) * spraySpanF;
				travelA = (grainPhs - 0.5) * gLenSamps * srRat * dirSign * detRatio;
				travelB = (grainPhsB - 0.5) * gLenSamps * srRat * dirSign * detRatio;
				rawA = cenA + uChorus + travelA + sprA;
				rawB = cenB + uChorus + travelB + sprB;
				idxA = (wrapGrain > 0.5) ? (startF + wrap(rawA - startF, 0, spanGF)) : clip(rawA, startF, endF);
				idxB = (wrapGrain > 0.5) ? (startF + wrap(rawB - startF, 0, spanGF)) : clip(rawB, startF, endF);
				aL, aR = peek_lr(sampBuf, idxA, maxIdxG);
				bL, bR = peek_lr(sampBuf, idxB, maxIdxG);
				if (telTick > 0.5) {
					poke(gtel, clip(idxA / max(numFrames, 1), 0, 1), gtB + 2 * u);
					poke(gtel, winA, gtB + 32 + 2 * u);
					poke(gtel, clip(idxB / max(numFrames, 1), 0, 1), gtB + 2 * u + 1);
					poke(gtel, winB, gtB + 32 + 2 * u + 1);
				}
				sigL = sigL + (aL * winA + bL * winB) * gL * uNormGain;
				sigR = sigR + (aR * winA + bR * winB) * gR * uNormGain;
			}
		}
	} else if (modeId < 3.5) {
		// ---------------- SPECTRAL (audio computed by spec_voice) ----------------
		playheadNorm = extPos;
		sigL = extL * sampG;
		sigR = extR * sampG;
	} else {
		// ---------------- FRAGMENTS ----------------
		frLenS = peek(prm, 38);
		frDens = (peek(prm, 23) > 0.5) ? clip(peek(prm, 22), 0.1, 100) : 1.0;
		frRep = floor(clip(peek(prm, 21), 1, 16) + 0.5);
		frMaxGr = floor(clip(peek(prm, 25), 1, 32) + 0.5);
		frMot = clip(peek(prm, 24), 0, 8);
		frPk = clip(peek(prm, 20), 0, 1);
		frDirMode = round(clip(peek(prm, 27), 0, 3));
		frLatch = peek(prm, 28);
		frRepInit = peek(prm, 29);
		frSurv = peek(prm, 30);
		maxIdxF = max(numFrames - 1, 1);

		// Playhead
		if (freezeOn > 0.5) {
			playheadNorm = clip(effStartNorm + playPosNorm * spanNorm + posMod, effStartNorm, effEndNorm);
		} else {
			wmFr = isSlice ? wmSlice : ((loopMode > 1.5) ? 2 : ((loopMode > 0.5) ? 1 : 0));
			rloF = isSlice ? effStartNorm : clip(loopStartNorm, effStartNorm, effEndNorm - 0.002);
			rhiF = isSlice ? effEndNorm : clip(loopEndNorm, rloF + 0.002, effEndNorm);
			hn, dn, dd = head_step(playheadNorm, scanDir, abs(grainMotion) * srRat / max(numFrames, 1), effStartNorm, effEndNorm, rloF, rhiF, wmFr);
			playheadNorm = hn;
			scanDir = dn;
			if ((dd > 0.5) && (wmFr < 0.5)) {
				headDone = 1;
			}
		}

		// Spawn
		spawnTmr = spawnTmr - 1;
		if ((spawnTmr <= 0) && (vGate > 0.5) && (headDone < 0.5)) {
			spawnTmr = spawnTmr + max(frLenS / frDens, 1.0);
			if (spawnTmr < 1.0) {
				spawnTmr = 1.0;
			}
			baseP = playheadNorm * numFrames + ((freezeOn > 0.5) ? 0.0 : posMod * numFrames);
			gScale = 1.0 / sqrt(max(1.0, 0.5 * min(frDens * frRep, frMaxGr)));
			for (rp = 0; rp < frRep; rp += 1) {
				if (rp < frRep - 0.5) {
					// Round-robin pool: when it is full the oldest grain is replaced.
					slot = floor(allocIdx - frMaxGr * floor(allocIdx / frMaxGr));
					allocIdx = allocIdx + 1;
					rndCtr = rndCtr + 3;
					rA = rnd01(rndCtr + vSeed * 91.7);
					rB = rnd01(rndCtr + 1.0 + vSeed * 17.3);
					rC = rnd01(rndCtr + 2.0 + vSeed * 53.9);
					if (slot >= 0) {
						altFlip = 0.0 - altFlip;
						dsel = (frDirMode < 0.5) ? dirSign : ((frDirMode < 1.5) ? scanDir : ((frDirMode < 2.5) ? ((rC < 0.5) ? -1.0 : 1.0) : altFlip));
						uIdx = spawnCnt % uCount;
						uFrac = peek(vhist, stB + 160 + uIdx);
						detRatio = peek(vhist, stB + 168 + uIdx);
						pan = clip(uFrac * unisonWidth + vPanSeed * 0.15 + (rB - 0.5) * 2.0 * clip(frMot, 0, 1), -1, 1);
						jitterP = (rA - 0.5) * 2.0 * frMot * frLenS * abs(stepRatio);
						pStart = baseP + jitterP;
						if ((frRepInit < 0.5) && (rp > 0)) {
							pStart = pStart + dsel * rp * frLenS * abs(stepRatio);
						}
						b = slot * 10;
						poke(vst, 1, gB + b + 0);
						poke(vst, 0.0 - rp * frLenS, gB + b + 1);
						poke(vst, frLenS, gB + b + 2);
						poke(vst, pStart, gB + b + 3);
						poke(vst, dsel * detRatio, gB + b + 4);
						poke(vst, sqrt(0.5 * (1.0 - pan)) * gScale, gB + b + 5);
						poke(vst, sqrt(0.5 * (1.0 + pan)) * gScale, gB + b + 6);
						poke(vst, frPk, gB + b + 7);
						poke(vst, abs(stepRatio), gB + b + 8);
						spawnCnt = spawnCnt + 1;
					}
				}
			}
			survTimer = max(survTimer, frRep * frLenS);
		}

		survTimer = max(survTimer - 1, 0);

		// Render the pool
		for (gi = 0; gi < 32; gi += 1) {
			b = gi * 10;
			if (peek(vst, gB + b) > 0.5) {
				ageG = peek(vst, gB + b + 1);
				lenG = peek(vst, gB + b + 2);
				if (ageG >= 0) {
					if (ageG >= lenG) {
						poke(vst, 0, gB + b);
					} else {
						wG = fr_win(ageG / lenG, peek(vst, gB + b + 7));
						rateG = peek(vst, gB + b + 4) * ((frLatch > 0.5) ? peek(vst, gB + b + 8) : abs(stepRatio));
						rpos = peek(vst, gB + b + 3) + rateG * ageG;
						if ((rpos >= startF) && (rpos <= endF)) {
							gl, gr = peek_lr(sampBuf, rpos, maxIdxF);
							sigL = sigL + gl * wG * peek(vst, gB + b + 5) * sampG;
							sigR = sigR + gr * wG * peek(vst, gB + b + 6) * sampG;
							if (telTick > 0.5) {
								poke(gtel, clip(rpos / max(numFrames, 1), 0, 1), gtB + gi);
								poke(gtel, wG, gtB + 32 + gi);
							}
						}
					}
				}
				poke(vst, ageG + 1, gB + b + 1);
			}
		}
	}

	// Held-tail crossfade after a live jump: the last output decays while the new read fades in.
	if (jumped > 0.5) {
		tailL = lastSigL;
		tailR = lastSigR;
		xfG = 0;
	}
	sigL = sigL * xfG + tailL;
	sigR = sigR * xfG + tailR;
	tailL = tailL * 0.94;
	tailR = tailR * 0.94;
	xfG = min(1.0, xfG + 0.01);
	lastSigL = sigL;
	lastSigR = sigR;

	// Cross-synthesis parameters (scaled by master Cross-Synth Depth prm 101 and gated by modulator oscillator enable)
	xsDepth = clip(peek(prm, 101), 0, 1);
	o1EnGate = (peek(prm, 84) > 0.5) ? 1.0 : 0.0;
	o2EnGate = (peek(prm, 70) > 0.5) ? 1.0 : 0.0;
	subEnGate = (peek(prm, 76) > 0.5) ? 1.0 : 0.0;
	xsFm21 = clip(peek(prm, 86), -1, 1) * xsDepth * o2EnGate;
	xsFm12 = clip(peek(prm, 87), -1, 1) * xsDepth * o1EnGate;
	xsRm21 = clip(peek(prm, 88), -1, 1) * xsDepth * o2EnGate;
	xsRm12 = clip(peek(prm, 89), -1, 1) * xsDepth * o1EnGate;
	xsSync21 = clip(peek(prm, 92), 0, 1) * xsDepth * o2EnGate;
	xsSync12 = clip(peek(prm, 93), 0, 1) * xsDepth * o1EnGate;
	xsFold21 = clip(peek(prm, 94), -1, 1) * xsDepth * o2EnGate;
	xsFold12 = clip(peek(prm, 95), -1, 1) * xsDepth * o1EnGate;
	xsSubFm = clip(peek(prm, 96), -1, 1) * xsDepth * subEnGate;
	xsSubRm = clip(peek(prm, 97), -1, 1) * xsDepth * subEnGate;
	xsSubSync = clip(peek(prm, 99), 0, 1) * xsDepth * subEnGate;
	xsSubFold = clip(peek(prm, 100), -1, 1) * xsDepth * subEnGate;
	prevO2Mod = peek(vhist, stB + 56) * o2EnGate;
	prevSubMod = peek(vhist, stB + 57) * subEnGate;
	prevO2Wrap = peek(vhist, stB + 58) * o2EnGate;
	prevSubWrap = peek(vhist, stB + 59) * subEnGate;

	// Osc 1 Wavetable mode override (when osc1_type > 0.5) and Osc 1 enable (osc1_on)
	o1Wrap = 0;
	if (peek(prm, 80) > 0.5) {
		wt1Pos = clip(playPosNorm + posMod, 0, 1);
		wt1Fx = peek(prm, 67);
		wt1A = peek(prm, 68);
		wt1B = peek(prm, 69);
		wt1Phs = peek(vhist, stB + 55);
		if (needInit) {
			wt1Phs = 0.0;
		}
		if ((xsSync21 > 0.001) && (prevO2Wrap > 0.5)) {
			wt1Phs = wt1Phs * (1.0 - xsSync21);
		}
		if ((xsSubSync > 0.001) && (prevSubWrap > 0.5)) {
			wt1Phs = wt1Phs * (1.0 - xsSubSync);
		}
		wt1Next = wt1Phs + clip(baseHz / max(srVal, 1), 0.00001, 0.48);
		o1Wrap = (wt1Next >= 1.0) ? 1 : 0;
		wt1Phs = fract(wt1Next);
		poke(vhist, wt1Phs, stB + 55);
		wt1EvalPhs = fract(wt1Phs + (prevO2Mod * xsFm21 + prevSubMod * xsSubFm) * 0.85 + 4.0);
		wt1Val = wt_osc_eval(wt1EvalPhs, wt1Pos, wt1Fx, wt1A, wt1B) * 0.55 * sampG;
		sigL = wt1Val;
		sigR = wt1Val;
		} else {
			fm1TapL = 0;
			fm1TapR = 0;
			o1Wrap = ((lastSigL <= 0.0) && (sigL > 0.0)) ? 1 : 0;
			if (abs(xsFm21) + abs(xsSubFm) > 0.001) {
				// Audio-rate phase/delay FM modulation on sample playback (only when modulator signal is non-zero)
				fm1Smp = clip((prevO2Mod * xsFm21 + prevSubMod * xsSubFm) * 28.0, -32.0, 32.0);
				if (abs(fm1Smp) > 0.0001) {
					fm1TapL, fm1TapR = peek_lr(sampBuf, clip(playheadNorm * numFrames + fm1Smp, startF, endF), max(numFrames - 1, 1));
					fm1Mix = clip(abs(xsFm21) + abs(xsSubFm), 0, 1);
					sigL = mix(sigL, fm1TapL * sampG, fm1Mix * 0.75);
					sigR = mix(sigR, fm1TapR * sampG, fm1Mix * 0.75);
				}
			}
		}
	if (peek(prm, 84) < 0.5) {
		sigL = 0;
		sigR = 0;
		o1Wrap = 0;
	}
	o1RawMono = 0.5 * (sigL + sigR);

	// Sliced one-shots end: fade out once the playhead has reached the end (Fragments let their grains finish).
	doneG = doneG + (((headDone > 0.5) ? 0.0 : 1.0) - doneG) * 0.01;
	endGain = (modeId > 3.5) ? 1.0 : doneG;

	velGain = mix(1.0, vVel, clip(velSens, 0, 1));
	// Fragments "survive": the grains in flight keep the level the voice had at release.
	if ((vGate > 0.5) || (modeId < 3.5) || (peek(prm, 30) < 0.5)) {
		survG = aOut;
	} else if (survTimer <= 0) {
		survG = 0;
	}
	envOut = ((modeId > 3.5) && (peek(prm, 30) > 0.5)) ? max(aOut, survG) : aOut;
	finalGain = envOut * velGain * endGain;
	if (telTick > 0.5) {
		for (gx = 0; gx < 32; gx += 1) {
			poke(gtel, peek(gtel, gtB + 32 + gx) * finalGain, gtB + 32 + gx);
		}
	}
	// Additional Oscillator 2 (Sampler slot or Wavetable) + Sub Oscillator
	osc2SigL = 0;
	osc2SigR = 0;
	o2RawL = 0;
	o2RawR = 0;
	o2Wrap = 0;
	subSig = 0;
	subRaw = 0;
	subWrap = 0;
	o2On = peek(prm, 70);
	if (o2On > 0.5) {
		o2Type = round(clip(peek(prm, 71), 0, 1));
		o2Semi = peek(prm, 72) + peek(prm, 73) * 0.01 + lfoSig * lfoPitchAmt * 24.0 + mOut * menvPitchAmt * 24.0;
		o2Pos = clip(peek(prm, 74) + posMod, 0, 1);
		o2Gain = pow(10.0, clip(peek(prm, 75), -48, 24) / 20.0);
		o2Phs = peek(vhist, stB + 50);
		if (needInit) {
			o2Phs = (o2Type < 0.5) ? (o2Pos * numFrames) : 0.0;
		}
		if (o2Type < 0.5) {
			// Osc 2 Type 0: Sampler slot (varispeed playback from loaded sample with forward loop)
			if ((xsSync12 > 0.001) && (o1Wrap > 0.5)) {
				o2Phs = mix(o2Phs, o2Pos * numFrames, xsSync12);
			}
			o2Ratio = pow(2.0, clip(((isSlice ? rootMidi : curNote) - rootNow) + o2Semi, -48, 48) / 12.0) * srRat;
			o2Phs = o2Phs + dirSign * o2Ratio + o1RawMono * xsFm12 * 18.0;
			if (effLoopMode > 0.5) {
				if ((dirSign > 0.0) && (o2Phs >= effLEnd)) {
					o2Phs = effLStart + wrap(o2Phs - effLEnd, 0, max(effLEnd - effLStart, 4));
					o2Wrap = 1;
				} else if ((dirSign < 0.0) && (o2Phs < effLStart)) {
					o2Phs = effLStart + wrap(o2Phs - effLStart, 0, max(effLEnd - effLStart, 4));
					o2Wrap = 1;
				}
			} else {
				o2Phs = clip(o2Phs, startF, endF);
			}
			s2L = 0;
			s2R = 0;
			s2L, s2R = peek_lr(sampBuf, o2Phs, max(numFrames - 1, 1));
			osc2SigL = s2L * o2Gain;
			osc2SigR = s2R * o2Gain;
			o2RawL = osc2SigL;
			o2RawR = osc2SigR;
			if (abs(osc2SigL) + abs(osc2SigR) < 0.00001) {
				o2Wrap = 0;
			}
		} else {
			// Osc 2 Type 1: Wavetable oscillator with Fm / Classic / Modern wave effects
			if ((xsSync12 > 0.001) && (o1Wrap > 0.5)) {
				o2Phs = o2Phs * (1.0 - xsSync12);
			}
			o2Hz = 440.0 * pow(2.0, ((isSlice ? rootMidi : curNote) - 69.0 + o2Semi) / 12.0);
			o2Next = o2Phs + clip(o2Hz / max(srVal, 1), 0.00001, 0.48);
			o2Wrap = (o2Next >= 1.0) ? 1 : 0;
			o2Phs = fract(o2Next);
			o2EvalPhs = fract(o2Phs + o1RawMono * xsFm12 * 0.85 + 4.0);
			wt2Fx = peek(prm, 81);
			wt2A = peek(prm, 82);
			wt2B = peek(prm, 83);
			wtVal = wt_osc_eval(o2EvalPhs, o2Pos, wt2Fx, wt2A, wt2B);
			osc2SigL = wtVal * 0.55 * o2Gain;
			osc2SigR = osc2SigL;
			o2RawL = osc2SigL;
			o2RawR = osc2SigR;
		}
		poke(vhist, o2Phs, stB + 50);
	}
	subOnVal = peek(prm, 76);
	if (subOnVal > 0.5) {
		subOctVal = round(clip(peek(prm, 77), 0, 2));
		subToneVal = clip(peek(prm, 78), 0, 1);
		subGainVal = pow(10.0, clip(peek(prm, 79), -48, 24) / 20.0);
		subPhs = peek(vhist, stB + 51);
		if (needInit) {
			subPhs = 0.0;
		}
		subDiv = (subOctVal < 0.5) ? 1.0 : ((subOctVal < 1.5) ? 0.5 : 0.25);
		subHz = baseHz * subDiv;
		subNext = subPhs + clip(subHz / max(srVal, 1), 0.00001, 0.48);
		subWrap = (subNext >= 1.0) ? 1 : 0;
		subPhs = fract(subNext);
		poke(vhist, subPhs, stB + 51);
		subS = sin(6.28318530718 * subPhs);
		subRich = tanh(subS * (1.0 + subToneVal * 4.5));
		subSig = (subS + (subRich - subS) * subToneVal) * 0.55 * subGainVal;
		subRaw = subSig;
	}
	// Apply per-voice RM/AM and Cross-Wavefold only when the modulator oscillator is enabled and producing audio
	if ((abs(xsRm21) > 0.001) && (abs(o2RawL) + abs(o2RawR) > 0.00001)) {
		rmModL = (xsRm21 > 0.0) ? (sigL * o2RawL * 1.6) : (sigL * clip(0.5 + 0.5 * o2RawL * 1.5, 0, 1.5));
		rmModR = (xsRm21 > 0.0) ? (sigR * o2RawR * 1.6) : (sigR * clip(0.5 + 0.5 * o2RawR * 1.5, 0, 1.5));
		sigL = mix(sigL, rmModL, abs(xsRm21));
		sigR = mix(sigR, rmModR, abs(xsRm21));
	}
	if ((abs(xsSubRm) > 0.001) && (abs(subRaw) > 0.00001)) {
		rmSubL = (xsSubRm > 0.0) ? (sigL * subRaw * 1.6) : (sigL * clip(0.5 + 0.5 * subRaw * 1.5, 0, 1.5));
		rmSubR = (xsSubRm > 0.0) ? (sigR * subRaw * 1.6) : (sigR * clip(0.5 + 0.5 * subRaw * 1.5, 0, 1.5));
		sigL = mix(sigL, rmSubL, abs(xsSubRm));
		sigR = mix(sigR, rmSubR, abs(xsSubRm));
	}
	if ((abs(xsRm12) > 0.001) && (abs(o1RawMono) > 0.00001)) {
		rm12L = (xsRm12 > 0.0) ? (osc2SigL * o1RawMono * 1.6) : (osc2SigL * clip(0.5 + 0.5 * o1RawMono * 1.5, 0, 1.5));
		rm12R = (xsRm12 > 0.0) ? (osc2SigR * o1RawMono * 1.6) : (osc2SigR * clip(0.5 + 0.5 * o1RawMono * 1.5, 0, 1.5));
		osc2SigL = mix(osc2SigL, rm12L, abs(xsRm12));
		osc2SigR = mix(osc2SigR, rm12R, abs(xsRm12));
	}
	if (abs(xsFold21) + abs(xsSubFold) > 0.001) {
		fdModL = o2RawL * xsFold21 + subRaw * xsSubFold;
		fdModR = o2RawR * xsFold21 + subRaw * xsSubFold;
		fdMixL = clip(abs(fdModL) * 2.5, 0, 1);
		fdMixR = clip(abs(fdModR) * 2.5, 0, 1);
		sigL = mix(sigL, sin(clip(sigL * (1.0 + abs(fdModL) * 2.5) + fdModL * 2.0, -3.14159, 3.14159) * 1.5707963), fdMixL);
		sigR = mix(sigR, sin(clip(sigR * (1.0 + abs(fdModR) * 2.5) + fdModR * 2.0, -3.14159, 3.14159) * 1.5707963), fdMixR);
	}
	if (abs(xsFold12) > 0.001) {
		fd12Mod = o1RawMono * xsFold12;
		fd12Mix = clip(abs(fd12Mod) * 2.5, 0, 1);
		osc2SigL = mix(osc2SigL, sin(clip(osc2SigL * (1.0 + abs(fd12Mod) * 2.5) + fd12Mod * 2.0, -3.14159, 3.14159) * 1.5707963), fd12Mix);
		osc2SigR = mix(osc2SigR, sin(clip(osc2SigR * (1.0 + abs(fd12Mod) * 2.5) + fd12Mod * 2.0, -3.14159, 3.14159) * 1.5707963), fd12Mix);
	}
	poke(vhist, fixnan(0.5 * (o2RawL + o2RawR)), stB + 56);
	poke(vhist, fixnan(subRaw), stB + 57);
	poke(vhist, o2Wrap, stB + 58);
	poke(vhist, subWrap, stB + 59);
	poke(vhist, fixnan(osc2SigL * finalGain), stB + 52);
	poke(vhist, fixnan(osc2SigR * finalGain), stB + 53);
	poke(vhist, fixnan(subSig * finalGain), stB + 54);

	// Ping-pong slices keep an unfolded phase; report the folded position.
	ppTele = isSlice && (modeId < 0.5) && (effLoopMode > 1.5) && (freezeOn < 0.5);
	outPosNorm = clip(ppTele ? (pp_pos(playheadNorm * numFrames, startF, endF) / max(numFrames, 1)) : playheadNorm, 0, 1);
	poke(vhist, prevTrig, stB + 0);
	poke(vhist, envStage, stB + 1);
	poke(vhist, ampEnv, stB + 2);
	poke(vhist, modStage, stB + 3);
	poke(vhist, modEnv, stB + 4);
	poke(vhist, relIntA, stB + 44);
	poke(vhist, relOutA, stB + 45);
	poke(vhist, aOut, stB + 46);
	poke(vhist, mOut, stB + 47);
	poke(vhist, relIntM, stB + 48);
	poke(vhist, relOutM, stB + 49);
	poke(vhist, curNote, stB + 5);
	poke(vhist, playheadNorm, stB + 6);
	poke(vhist, grainPhs, stB + 7);
	poke(vhist, rndA, stB + 8);
	poke(vhist, rndB, stB + 9);
	poke(vhist, cycPhs0, stB + 10);
	poke(vhist, cycPhs1, stB + 11);
	poke(vhist, cycPhs2, stB + 12);
	poke(vhist, cycPhs3, stB + 13);
	poke(vhist, cycPhs4, stB + 14);
	poke(vhist, cycPhs5, stB + 15);
	poke(vhist, cycPhs6, stB + 16);
	poke(vhist, cycPhs7, stB + 17);
	poke(vhist, driftPhs, stB + 18);
	poke(vhist, formSm, stB + 19);
	poke(vhist, lastMode, stB + 20);
	poke(vhist, scanDir, stB + 21);
	poke(vhist, prevBS, stB + 22);
	poke(vhist, prevBE, stB + 23);
	poke(vhist, tailL, stB + 24);
	poke(vhist, tailR, stB + 25);
	poke(vhist, xfG, stB + 26);
	poke(vhist, lastSigL, stB + 27);
	poke(vhist, lastSigR, stB + 28);
	poke(vhist, headDone, stB + 29);
	poke(vhist, doneG, stB + 30);
	poke(vhist, spawnTmr, stB + 31);
	poke(vhist, spawnCnt, stB + 32);
	poke(vhist, altFlip, stB + 33);
	poke(vhist, rndCtr, stB + 34);
	poke(vhist, survG, stB + 35);
	poke(vhist, allocIdx, stB + 36);
	poke(vhist, survTimer, stB + 37);
	poke(vhist, (freezeOn > 0.5) ? 1 : 0, stB + 40);
	poke(vhist, frzWinS, stB + 41);
	return fixnan(sigL * finalGain), fixnan(sigR * finalGain), outPosNorm, aOut, mOut, spawnCnt;
}

// Buffers
Buffer samp("bsamp");
Buffer vdata("bsvoices");
Buffer scope("bsscope");
Buffer pitch("bspitch");

// Shared tables and the new-parameter table (layout below)
Data twr(2049);
Data twi(2049);
Data brv(4096);
Data prm(112);
Data vst(6400);
Data gtel(1024);
Data gtout(72);
Data vhist(4096);
Data sext(12);
Data vres(48);
Data tbuf(131072);
Data sdat(237960);
Data senv(16448);
Data tvrel(32);
Data fstate(64);

// Parameters
Param mode(0, min=0, max=4);
Param sliced(0, min=0, max=1);
Param freeze(0, min=0, max=1);
Param root_note(60, min=0, max=127);
Param root_dyn(0, min=0, max=1);
Param pitch_st(0, min=-36, max=36);
Param fine_cents(0, min=-100, max=100);
Param play_pos(0, min=0, max=1);
Param samp_start(0, min=0, max=1);
Param samp_end(1, min=0, max=1);
Param loop_mode(0, min=0, max=2);
Param loop_start(0.1, min=0, max=1);
Param loop_end(0.9, min=0, max=1);
Param loop_xfade(0.05, min=0, max=0.45);
Param reverse(0, min=0, max=1);
Param slice_play(0, min=0, max=3);

// Granular / Cycles parameters
Param grain_size(65, min=5, max=500);
Param grain_motion(1.0, min=0, max=2);
Param grain_spray(0.15, min=0, max=1);
Param formant(0, min=-24, max=24);

// Repitch characters
Param rp_char(0, min=0, max=2);
Param rp_dist(0, min=0, max=1);
Param rp_color(0, min=-1, max=1);
Param rp_vsr(0, min=0, max=1);
Param rp_imaging(1, min=0, max=1);

// Cycles characters
Param cy_char(0, min=0, max=2);
Param cy_width(0, min=-1, max=1);
Param cy_split(0, min=-1, max=1);
Param cy_fund(0, min=0, max=1);
Param cy_mod(0, min=0, max=1);
Param cy_harm(0, min=-1, max=1);
Param cy_xfade(0, min=0, max=1);

// Spectral
Param sp_char(0, min=0, max=1);
Param sp_shift(1.0, min=0.01, max=1.22);
Param sp_bend(0, min=-24, max=24);
Param sp_quant(0, min=0, max=2);
Param sp_key(0, min=0, max=11);
Param sp_scale(0, min=0, max=1);
Param sp_quant_amt(1.0, min=0.01, max=1);
Param sp_onsets(0, min=0, max=1);
Param sp_formant_on(1, min=0, max=1);
Param sp_dispersion(0.667, min=0, max=1);
Param sp_quality(1, min=0, max=2);
Param sp_live(1, min=0, max=1);
Param sp_rel_formant(0, min=0, max=1);

// Fragments
Param fr_env(0.5, min=0, max=1);
Param fr_repeats(1, min=1, max=16);
Param fr_density(4.0, min=0.1, max=100);
Param fr_use_density(1, min=0, max=1);
Param fr_motion(0, min=0, max=8);
Param fr_max_grains(256, min=1, max=256);
Param fr_sync(0, min=0, max=1);
Param fr_direction(1, min=0, max=3);
Param fr_latch(1, min=0, max=1);
Param fr_repeat_init(0, min=0, max=1);
Param fr_survive(0, min=0, max=1);
Param tempo(120, min=20, max=999);
// Sample rate (Hz) of the loaded file, 0 = unknown. Every playhead step is scaled by file rate / DSP rate (prm 54).
Param samp_rate(0, min=0, max=400000);

// Unison & Voicing
Param unison_voices(1, min=1, max=8);
Param unison_detune(0.15, min=0, max=1);
Param unison_width(0.65, min=0, max=1);
Param glide_ms(0, min=0, max=1000);
Param vel_sens(0.7, min=0, max=1);

// Amp ADSR (ms & 0..1)
Param atk_ms(2.5, min=0, max=60000);
Param dec_ms(250, min=1, max=60000);
Param sus_lvl(0.85, min=0, max=1);
Param rel_ms(140, min=1, max=60000);

// Mod / Filter ADSR (ms & 0..1)
Param matk_ms(5.0, min=0, max=60000);
Param mdec_ms(320, min=1, max=60000);
Param msus_lvl(0.25, min=0, max=1);
Param mrel_ms(220, min=1, max=60000);

// Multimode SVF Filter + Drive
Param filt_on(1, min=0, max=1);
Param filt_type(0, min=0, max=4);
Param filt_cutoff(18000, min=20, max=20000);
Param filt_res(0.15, min=0, max=0.95);
Param filt_drive(0.0, min=0, max=1);
Param filt_env_amt(0.0, min=-1, max=1);
Param filt_slope(0, min=0, max=1);
Param filt_circuit(0, min=0, max=4);
Param filt_morph(0.0, min=0, max=1);
Param filt2_on(0, min=0, max=1);
Param filt2_type(0, min=0, max=4);
Param filt2_slope(0, min=0, max=1);
Param filt2_circuit(0, min=0, max=4);
Param filt2_cutoff(18000, min=20, max=20000);
Param filt2_res(0.15, min=0, max=0.95);
Param filt2_drive(0.0, min=0, max=1);
Param filt2_morph(0.0, min=0, max=1);
Param filt_route(0, min=0, max=2);
Param osc1_on(1, min=0, max=1);
Param osc1_type(0, min=0, max=1);
Param wt1_fx(3, min=0, max=3);
Param wt1_fx1(0, min=-1, max=1);
Param wt1_fx2(0, min=0, max=1);
Param osc2_on(0, min=0, max=1);
Param osc2_type(0, min=0, max=1);
Param osc2_mode(0, min=0, max=4);
Param wt2_fx(3, min=0, max=3);
Param wt2_fx1(0, min=-1, max=1);
Param wt2_fx2(0, min=0, max=1);
Param osc2_pitch(0, min=-36, max=36);
Param osc2_detune(0, min=-100, max=100);
Param osc2_pos(0, min=0, max=1);
Param osc2_gain(0, min=-48, max=24);
Param sub_on(0, min=0, max=1);
Param sub_oct(0, min=0, max=2);
Param sub_tone(0, min=0, max=1);
Param sub_gain(-6, min=-48, max=24);

// Oscillator Cross-Synthesis Matrix parameters
Param xs_fm_21(0, min=-1, max=1);
Param xs_fm_12(0, min=-1, max=1);
Param xs_rm_21(0, min=-1, max=1);
Param xs_rm_12(0, min=-1, max=1);
Param xs_cep_21(0, min=-1, max=1);
Param xs_cep_12(0, min=-1, max=1);
Param xs_sync_21(0, min=0, max=1);
Param xs_sync_12(0, min=0, max=1);
Param xs_fold_21(0, min=-1, max=1);
Param xs_fold_12(0, min=-1, max=1);
Param xs_sub_fm(0, min=-1, max=1);
Param xs_sub_rm(0, min=-1, max=1);
Param xs_sub_cep(0, min=-1, max=1);
Param xs_sub_sync(0, min=0, max=1);
Param xs_sub_fold(0, min=-1, max=1);
Param xs_quef(0.5, min=0, max=1);
Param xs_tilt(0, min=-1, max=1);
Param xs_depth(1.0, min=0, max=1);

// Internal LFO & Mod Matrix
Param lfo_rate(2.0, min=0.05, max=30);
Param lfo_shape(0, min=0, max=3);
Param lfo_pitch(0.0, min=-1, max=1);
Param lfo_filt(0.0, min=-1, max=1);
Param lfo_pos(0.0, min=-1, max=1);
Param menv_pitch(0.0, min=-1, max=1);
Param menv_pos(0.0, min=-1, max=1);

// Master Output
Param out_gain(0.0, min=-36, max=18);

// Sample gain (dB): a smoothed linear gain on every engine's sample signal, before the character / drive and the filter
Param samp_gain(0.0, min=-48, max=24);

// Envelope slopes (-1..1): bend the amp / mod envelope segments (read by voice_proc as prm 56..61; 0 = exact old shape)
Param atk_slope(0.0, min=-1, max=1);
Param dec_slope(0.0, min=-1, max=1);
Param rel_slope(0.0, min=-1, max=1);
Param matk_slope(0.0, min=-1, max=1);
Param mdec_slope(0.0, min=-1, max=1);
Param mrel_slope(0.0, min=-1, max=1);

// Envelope Value stage levels (0..1): Initial and Peak for Amp (prm 62..63); Initial, Peak, and Final for Env 2 (prm 64..66)
Param amp_init(0.0, min=0, max=1);
Param amp_peak(1.0, min=0, max=1);
Param env2_init(0.0, min=0, max=1);
Param env2_peak(1.0, min=0, max=1);
Param env2_final(0.0, min=0, max=1);

// Global state histories
History initDone(0);
History lfoPhs(0);
History lfoSH(0);
History svfLpL(0);
History svfBpL(0);
History svfLpR(0);
History svfBpR(0);
History scopeCount(0);
History scopeFrame(0);
History peakHoldL(0);
History peakHoldR(0);
History hCutC(0);
History hFiltC(0);
History hFrzS(0);
History hSgC(0);
History srCoefs(0);

if (initDone == 0) {
	init_tables(twr, twi, brv);
	// Spectral voice History initial values.
	for (isv = 0; isv < 4; isv += 1) {
		poke(sdat, -1, isv * 55392 + 55360 + 0);
		poke(sdat, 2048, isv * 55392 + 55360 + 2);
		poke(sdat, 11, isv * 55392 + 55360 + 3);
		poke(sdat, 512, isv * 55392 + 55360 + 4);
		poke(sdat, 29, isv * 55392 + 55360 + 5);
		poke(sdat, 99, isv * 55392 + 55360 + 7);
		poke(sdat, 1, isv * 55392 + 55360 + 12);
		poke(sdat, 1, isv * 55392 + 55360 + 14);
		poke(sdat, 1, isv * 55392 + 55360 + 15);
		poke(sdat, 60, isv * 55392 + 55360 + 19);
	}
	// Per-voice History initial values (the vhist table starts at 0).
	for (ivx = 0; ivx < 16; ivx += 1) {
		poke(vhist, -1, ivx * 256 + 0);
		poke(vhist, 60, ivx * 256 + 5);
		poke(vhist, 0.17, ivx * 256 + 8);
		poke(vhist, 0.63, ivx * 256 + 9);
		poke(vhist, 0.13, ivx * 256 + 11);
		poke(vhist, 0.29, ivx * 256 + 12);
		poke(vhist, 0.47, ivx * 256 + 13);
		poke(vhist, 0.61, ivx * 256 + 14);
		poke(vhist, 0.73, ivx * 256 + 15);
		poke(vhist, 0.83, ivx * 256 + 16);
		poke(vhist, 0.97, ivx * 256 + 17);
		poke(vhist, 0.2, ivx * 256 + 18);
		poke(vhist, 1, ivx * 256 + 19);
		poke(vhist, -1, ivx * 256 + 20);
		poke(vhist, 1, ivx * 256 + 21);
		poke(vhist, -1, ivx * 256 + 22);
		poke(vhist, -1, ivx * 256 + 23);
		poke(vhist, 1, ivx * 256 + 26);
		poke(vhist, 1, ivx * 256 + 30);
		poke(vhist, 1, ivx * 256 + 33);
		poke(vhist, 0.31, ivx * 256 + 82);
		poke(vhist, 0.17, ivx * 256 + 83);
		poke(vhist, 0.64, ivx * 256 + 84);
	}
	initDone = 1;
}

srVal = max(samplerate, 8000);
numFrames = max(dim(samp), 1);

// New-parameter table (read by voice_proc / spec_voice):
//   0 sliced, 1 rp_char, 2 rp_dist, 3 rp_color, 4 rp_vsr, 5 rp_imaging,
//   6 cy_char, 7 cy_width, 8 cy_split, 9 cy_fund, 10 cy_mod, 11 cy_harm, 12 cy_xfade,
//   20 fr_env, 21 fr_repeats, 22 fr_density, 23 fr_use_density, 24 fr_motion, 25 fr_max_grains,
//   26 fr_sync, 27 fr_direction, 28 fr_latch, 29 fr_repeat_init, 30 fr_survive, 31 tempo,
//   40 sp_char, 41 sp_shift, 42 sp_bend, 43 sp_quant, 44 sp_key, 45 sp_scale, 46 sp_quant_amt,
//   47 sp_onsets, 48 sp_formant_on, 49 sp_dispersion, 50 sp_quality, 51 sp_live, 52 sp_rel_formant,
//   53 effective Analyzed Root Key flag (root_dyn on and #0-bspitch bound)
//   54 file rate / DSP rate (samp_rate): source frames per output sample at pitch ratio 1
//   13 formant ratio, 15 unison norm gain, 16 freeze-head slew, 17..19 / 32..34 slope exponents pow(4,-s),
//   35 spectral FFT size, 36 bend ratio, 37 formant pow, 38 fragments grain length (samples)
poke(prm, sliced, 0);
poke(prm, rp_char, 1);
poke(prm, rp_dist, 2);
poke(prm, rp_color, 3);
poke(prm, rp_vsr, 4);
poke(prm, rp_imaging, 5);
poke(prm, cy_char, 6);
poke(prm, cy_width, 7);
poke(prm, cy_split, 8);
poke(prm, cy_fund, 9);
poke(prm, cy_mod, 10);
poke(prm, cy_harm, 11);
poke(prm, cy_xfade, 12);
poke(prm, fr_env, 20);
poke(prm, fr_repeats, 21);
poke(prm, fr_density, 22);
poke(prm, fr_use_density, 23);
poke(prm, fr_motion, 24);
poke(prm, fr_max_grains, 25);
poke(prm, fr_sync, 26);
poke(prm, fr_direction, 27);
poke(prm, fr_latch, 28);
poke(prm, fr_repeat_init, 29);
poke(prm, fr_survive, 30);
poke(prm, tempo, 31);
poke(prm, sp_char, 40);
poke(prm, sp_shift, 41);
poke(prm, sp_bend, 42);
poke(prm, sp_quant, 43);
poke(prm, sp_key, 44);
poke(prm, sp_scale, 45);
poke(prm, sp_quant_amt, 46);
poke(prm, sp_onsets, 47);
poke(prm, sp_formant_on, 48);
poke(prm, sp_dispersion, 49);
poke(prm, sp_quality, 50);
poke(prm, sp_live, 51);
poke(prm, sp_rel_formant, 52);
// Analyzed Root Key: on only with root_dyn set and a bound pitch curve (dim >= 2); else every engine uses root_note.
rootDynOn = ((root_dyn > 0.5) && (dim(pitch) >= 2)) ? 1 : 0;
poke(prm, rootDynOn, 53);
srRatio = (samp_rate > 1000) ? clip(samp_rate / srVal, 0.05, 20.0) : 1.0;
poke(prm, srRatio, 54);
// Sample-rate constants (filter slew, freeze-head slew, sample-gain slew).
if (srCoefs < 0.5) {
	hCutC = exp(-1.0 / (0.002 * srVal));
	hFiltC = exp(-1.0 / (0.006 * srVal));
	hFrzS = 1.0 - exp(-1.0 / (0.018 * srVal));
	hSgC = exp(-1.0 / (0.01 * srVal));
	srCoefs = 1;
}
cutNow = (srCoefs < 0.5) ? exp(-1.0 / (0.002 * srVal)) : hCutC;
filtNow = (srCoefs < 0.5) ? exp(-1.0 / (0.006 * srVal)) : hFiltC;
frzNow = (srCoefs < 0.5) ? (1.0 - exp(-1.0 / (0.018 * srVal))) : hFrzS;
sgNow = (srCoefs < 0.5) ? exp(-1.0 / (0.01 * srVal)) : hSgC;
// Sample gain, smoothed (10 ms); read by voice_proc as prm 55 (exactly 1.0 at 0 dB)
sampGainLin = slew_val(pow(10.0, clip(samp_gain, -48, 24) / 20.0), sgNow);
poke(prm, sampGainLin, 55);
uCountG = int(clip(round(unison_voices), 1, 8));
fmRatG = pow(2.0, clip(formant, -24, 24) / 12.0);
uNormG = sampGainLin / sqrt(max(uCountG, 1));
slpAG = pow(4.0, 0.0 - clip(atk_slope, -1, 1));
slpDG = pow(4.0, 0.0 - clip(dec_slope, -1, 1));
slpRG = pow(4.0, 0.0 - clip(rel_slope, -1, 1));
slpMAG = pow(4.0, 0.0 - clip(matk_slope, -1, 1));
slpMDG = pow(4.0, 0.0 - clip(mdec_slope, -1, 1));
slpMRG = pow(4.0, 0.0 - clip(mrel_slope, -1, 1));
qIdxG = round(clip(sp_quality, 0, 2));
nWantG = 1024 * pow2n(qIdxG);
bendRG = (sp_char > 0.5) ? pow(2.0, clip(sp_bend, -24, 24) / 12.0) : 1.0;
fmtEffG = pow(2.0, clip(formant * sp_shift, -48, 48) / 12.0);
beatMsG = 60000.0 / clip(tempo, 20, 999);
frLenG = (fr_sync > 0.5) ? max(beatMsG * pow(2.0, round(log2(max(grain_size, 1.0) / beatMsG))) * 0.001 * srVal, 16.0) : max(grain_size * 0.001 * srVal, 16.0);
poke(prm, fmRatG, 13);
poke(prm, uNormG, 15);
poke(prm, frzNow, 16);
poke(prm, slpAG, 17);
poke(prm, slpDG, 18);
poke(prm, slpRG, 19);
poke(prm, slpMAG, 32);
poke(prm, slpMDG, 33);
poke(prm, slpMRG, 34);
poke(prm, nWantG, 35);
poke(prm, bendRG, 36);
poke(prm, fmtEffG, 37);
poke(prm, frLenG, 38);
poke(prm, clip(atk_slope, -1, 1), 56);
poke(prm, clip(dec_slope, -1, 1), 57);
poke(prm, clip(rel_slope, -1, 1), 58);
poke(prm, clip(matk_slope, -1, 1), 59);
poke(prm, clip(mdec_slope, -1, 1), 60);
poke(prm, clip(mrel_slope, -1, 1), 61);
poke(prm, clip(amp_init, 0, 1), 62);
poke(prm, clip(amp_peak, 0, 1), 63);
poke(prm, clip(env2_init, 0, 1), 64);
poke(prm, clip(env2_peak, 0, 1), 65);
poke(prm, clip(env2_final, 0, 1), 66);
poke(prm, wt1_fx, 67);
poke(prm, clip(wt1_fx1, -1, 1), 68);
poke(prm, clip(wt1_fx2, 0, 1), 69);
poke(prm, osc2_on, 70);
poke(prm, osc2_type, 71);
poke(prm, osc2_pitch, 72);
poke(prm, osc2_detune, 73);
poke(prm, osc2_pos, 74);
poke(prm, osc2_gain, 75);
poke(prm, sub_on, 76);
poke(prm, sub_oct, 77);
poke(prm, sub_tone, 78);
poke(prm, sub_gain, 79);
poke(prm, osc1_type, 80);
poke(prm, wt2_fx, 81);
poke(prm, clip(wt2_fx1, -1, 1), 82);
poke(prm, clip(wt2_fx2, 0, 1), 83);
poke(prm, osc1_on, 84);
poke(prm, osc2_mode, 85);
poke(prm, clip(xs_fm_21, -1, 1), 86);
poke(prm, clip(xs_fm_12, -1, 1), 87);
poke(prm, clip(xs_rm_21, -1, 1), 88);
poke(prm, clip(xs_rm_12, -1, 1), 89);
poke(prm, clip(xs_cep_21, -1, 1), 90);
poke(prm, clip(xs_cep_12, -1, 1), 91);
poke(prm, clip(xs_sync_21, 0, 1), 92);
poke(prm, clip(xs_sync_12, 0, 1), 93);
poke(prm, clip(xs_fold_21, -1, 1), 94);
poke(prm, clip(xs_fold_12, -1, 1), 95);
poke(prm, clip(xs_sub_fm, -1, 1), 96);
poke(prm, clip(xs_sub_rm, -1, 1), 97);
poke(prm, clip(xs_sub_cep, -1, 1), 98);
poke(prm, clip(xs_sub_sync, 0, 1), 99);
poke(prm, clip(xs_sub_fold, -1, 1), 100);
poke(prm, clip(xs_depth, 0, 1), 101);
poke(prm, clip(xs_quef, 0, 1), 102);
poke(prm, clip(xs_tilt, -1, 1), 103);

// Compute global LFO (-1..+1): 0=Sine, 1=Triangle, 2=Saw, 3=S&H (or 3=Sq, 4=S&H when 5-shape enum is used)
prevLfoPhs = lfoPhs;
lfoPhs = fract(lfoPhs + clip(lfo_rate, 0.02, 40) / srVal);
if (lfoPhs < prevLfoPhs) {
	shHash = sin(scopeFrame * 12.9898 + 78.233) * 43758.5453;
	lfoSH = (shHash - floor(shHash)) * 2.0 - 1.0;
}
lfoSin = sin(6.28318530718 * lfoPhs);
lfoTri = 1.0 - 4.0 * abs(fract(lfoPhs + 0.25) - 0.5);
lfoSaw = 2.0 * lfoPhs - 1.0;
lfoSq = (lfoPhs < 0.5) ? 1.0 : -1.0;
shIdx = round(clip(lfo_shape, 0, 4));
lfoSig = (shIdx == 0) ? lfoSin : ((shIdx == 1) ? lfoTri : ((shIdx == 2) ? lfoSaw : ((shIdx == 4) ? lfoSq : lfoSH)));

// Envelope & Glide coefficients (when attack is 0 ms, coefficient is 0 so envelope reaches peak on the first sample)
atkCoef = (atk_ms <= 0.05) ? 0.0 : exp(-1000.0 / (atk_ms * srVal));
decCoef = exp(-1000.0 / (max(dec_ms, 1.0) * srVal));
relCoef = exp(-1000.0 / (max(rel_ms, 1.0) * srVal));
matkCoef = (matk_ms <= 0.05) ? 0.0 : exp(-1000.0 / (matk_ms * srVal));
mdecCoef = exp(-1000.0 / (max(mdec_ms, 1.0) * srVal));
mrelCoef = exp(-1000.0 / (max(mrel_ms, 1.0) * srVal));
glideCoef = (glide_ms <= 0.5) ? 0.0 : exp(-1000.0 / (glide_ms * srVal));

// Spectral voices (voices 0..3 only), one loop so the phase vocoder compiles once. The Mod / Amp envelope of
// the previous sample comes from vres (written by the voice loop below).
for (svx = 0; svx < 4; svx += 1) {
	sL, sR, sP, sZ = spec_voice(samp, vdata, twr, twi, brv, prm, sdat, svx, mode, freeze, play_pos, samp_start, samp_end, loop_mode, loop_start, loop_end, reverse, root_note, pitch_st, fine_cents, glideCoef, formant, grain_motion, slice_play, lfoSig, lfo_pitch, lfo_pos, menv_pitch, menv_pos, peek(vres, svx * 3 + 2), peek(vres, svx * 3 + 1), numFrames, srVal, pitch, senv);
	poke(sext, sL, svx * 3);
	poke(sext, sR, svx * 3 + 1);
	poke(sext, sP, svx * 3 + 2);
}


// Evaluate all 16 polyphonic voices in ONE loop, so the voice engine is compiled once. Per-voice state
// lives in the vhist table (voice_proc) and per-voice results in vres (P, A, M at 3 * voice).
sumL = 0;
sumR = 0;
osc2SumL = 0;
osc2SumR = 0;
subSum = 0;
modO2Sum = 0;
modSubSum = 0;
spawnSum = 0;
maxModEnv = 0;
telTick = (scopeCount >= 63) ? 1 : 0;
for (vox = 0; vox < 16; vox += 1) {
	exL = 0;
	exR = 0;
	exP = 0;
	if (vox < 3.5) {
		exL = peek(sext, vox * 3);
		exR = peek(sext, vox * 3 + 1);
		exP = peek(sext, vox * 3 + 2);
	}
	// A voice that is released, silent and has no Fragments tail left produces exact zeros, so skip its engine
	// (state is frozen until the next note-on, which re-initialises it). vhist slots: 1 envStage, 2 ampEnv,
	// 4 modEnv, 6 playheadNorm, 32 spawnCnt, 35 survG, 37 survTimer.
	vhOff = vox * 256;
	voIdle = (peek(vdata, vox * 8) < 0.5) && (peek(vhist, vhOff + 1) == 0) && (peek(vhist, vhOff + 2) == 0) && (peek(vhist, vhOff + 4) == 0) && (peek(vhist, vhOff + 35) <= 0) && (peek(vhist, vhOff + 37) <= 0);
	voL = 0;
	voR = 0;
	voP = peek(vhist, vhOff + 6);
	voA = 0;
	voM = 0;
	voS = peek(vhist, vhOff + 32);
	if ((voIdle > 0.5) && (telTick > 0.5)) {
		for (gz = 0; gz < 32; gz += 1) {
			poke(gtel, -1, vox * 64 + gz);
			poke(gtel, 0, vox * 64 + 32 + gz);
		}
	}
	if (voIdle < 0.5) {
		voL, voR, voP, voA, voM, voS = voice_proc(samp, vdata, vox, mode, freeze, root_note, pitch_st, fine_cents, play_pos, samp_start, samp_end, loop_mode, loop_start, loop_end, loop_xfade, reverse, grain_size, grain_motion, grain_spray, formant, unison_voices, unison_detune, unison_width, glideCoef, atkCoef, decCoef, sus_lvl, relCoef, matkCoef, mdecCoef, msus_lvl, mrelCoef, vel_sens, lfoSig, lfo_pitch, lfo_pos, menv_pitch, menv_pos, numFrames, srVal, slice_play, prm, vst, tbuf, vhist, exL, exR, exP, pitch, gtel, telTick);
		osc2SumL = osc2SumL + peek(vhist, vhOff + 52);
		osc2SumR = osc2SumR + peek(vhist, vhOff + 53);
		subSum = subSum + peek(vhist, vhOff + 54);
		modO2Sum = modO2Sum + peek(vhist, vhOff + 56) * voA;
		modSubSum = modSubSum + peek(vhist, vhOff + 57) * voA;
	}
	sumL = sumL + voL;
	sumR = sumR + voR;
	spawnSum = spawnSum + voS;
	maxModEnv = max(maxModEnv, voM);
	poke(vres, voP, vox * 3);
	poke(vres, voA, vox * 3 + 1);
	poke(vres, voM, vox * 3 + 2);
}

// 4-Band Log-Cepstral Spectral Envelope Cross-Synthesis (2->1, 1->2, Sub->1) with Quefrency Liftering & Spectral Tilt
cepD = clip(xs_depth, 0, 1);
cep21 = ((osc2_on > 0.5) ? clip(xs_cep_21, -1, 1) : 0.0) * cepD;
cep12 = ((osc1_on > 0.5) ? clip(xs_cep_12, -1, 1) : 0.0) * cepD;
cepS1 = ((sub_on > 0.5) ? clip(xs_sub_cep, -1, 1) : 0.0) * cepD;
if (abs(cep21) + abs(cep12) + abs(cepS1) > 0.001) {
	// 3-split crossover frequencies (~250 Hz, ~900 Hz, ~3200 Hz)
	ca0 = clip(1570.0 / srVal, 0.01, 0.45);
	ca1 = clip(5650.0 / srVal, 0.02, 0.65);
	ca2 = clip(20100.0 / srVal, 0.05, 0.85);
	cEnvA = clip(400.0 / srVal, 0.002, 0.15);

	// Carrier 1 (Osc 1) 4-band split (L & R)
	lp10L = peek(fstate, 16) + ca0 * (sumL - peek(fstate, 16)); poke(fstate, fixnan(lp10L), 16);
	lp11L = peek(fstate, 17) + ca1 * (sumL - peek(fstate, 17)); poke(fstate, fixnan(lp11L), 17);
	lp12L = peek(fstate, 18) + ca2 * (sumL - peek(fstate, 18)); poke(fstate, fixnan(lp12L), 18);
	lp10R = peek(fstate, 19) + ca0 * (sumR - peek(fstate, 19)); poke(fstate, fixnan(lp10R), 19);
	lp11R = peek(fstate, 20) + ca1 * (sumR - peek(fstate, 20)); poke(fstate, fixnan(lp11R), 20);
	lp12R = peek(fstate, 21) + ca2 * (sumR - peek(fstate, 21)); poke(fstate, fixnan(lp12R), 21);
	b10L = lp10L; b11L = lp11L - lp10L; b12L = lp12L - lp11L; b13L = sumL - lp12L;
	b10R = lp10R; b11R = lp11R - lp10R; b12R = lp12R - lp11R; b13R = sumR - lp12R;

	// Osc 2 / Sub modulator 4-band split
	o2ModIn = 0.5 * (osc2SumL + osc2SumR);
	subModIn = subSum;
	lp20 = peek(fstate, 22) + ca0 * (o2ModIn - peek(fstate, 22)); poke(fstate, fixnan(lp20), 22);
	lp21 = peek(fstate, 23) + ca1 * (o2ModIn - peek(fstate, 23)); poke(fstate, fixnan(lp21), 23);
	lp22 = peek(fstate, 24) + ca2 * (o2ModIn - peek(fstate, 24)); poke(fstate, fixnan(lp22), 24);
	b20 = lp20; b21 = lp21 - lp20; b22 = lp22 - lp21; b23 = o2ModIn - lp22;

	lps0 = peek(fstate, 25) + ca0 * (subModIn - peek(fstate, 25)); poke(fstate, fixnan(lps0), 25);
	lps1 = peek(fstate, 26) + ca1 * (subModIn - peek(fstate, 26)); poke(fstate, fixnan(lps1), 26);
	lps2 = peek(fstate, 27) + ca2 * (subModIn - peek(fstate, 27)); poke(fstate, fixnan(lps2), 27);
	bs0 = lps0; bs1 = lps1 - lps0; bs2 = lps2 - lps1; bs3 = subModIn - lps2;

	// Band envelope followers (slots 28..39)
	ev10 = peek(fstate, 28) + cEnvA * (0.5 * (abs(b10L) + abs(b10R)) - peek(fstate, 28)); poke(fstate, fixnan(ev10), 28);
	ev11 = peek(fstate, 29) + cEnvA * (0.5 * (abs(b11L) + abs(b11R)) - peek(fstate, 29)); poke(fstate, fixnan(ev11), 29);
	ev12 = peek(fstate, 30) + cEnvA * (0.5 * (abs(b12L) + abs(b12R)) - peek(fstate, 30)); poke(fstate, fixnan(ev12), 30);
	ev13 = peek(fstate, 31) + cEnvA * (0.5 * (abs(b13L) + abs(b13R)) - peek(fstate, 31)); poke(fstate, fixnan(ev13), 31);

	ev20 = peek(fstate, 32) + cEnvA * (abs(b20) - peek(fstate, 32)); poke(fstate, fixnan(ev20), 32);
	ev21 = peek(fstate, 33) + cEnvA * (abs(b21) - peek(fstate, 33)); poke(fstate, fixnan(ev21), 33);
	ev22 = peek(fstate, 34) + cEnvA * (abs(b22) - peek(fstate, 34)); poke(fstate, fixnan(ev22), 34);
	ev23 = peek(fstate, 35) + cEnvA * (abs(b23) - peek(fstate, 35)); poke(fstate, fixnan(ev23), 35);

	evs0 = peek(fstate, 36) + cEnvA * (abs(bs0) - peek(fstate, 36)); poke(fstate, fixnan(evs0), 36);
	evs1 = peek(fstate, 37) + cEnvA * (abs(bs1) - peek(fstate, 37)); poke(fstate, fixnan(evs1), 37);
	evs2 = peek(fstate, 38) + cEnvA * (abs(bs2) - peek(fstate, 38)); poke(fstate, fixnan(evs2), 38);
	evs3 = peek(fstate, 39) + cEnvA * (abs(bs3) - peek(fstate, 39)); poke(fstate, fixnan(evs3), 39);

	// Gate Cepstral transfer by whether the modulator actually has signal energy
	cAct2 = clip((ev20 + ev21 + ev22 + ev23) * 25.0, 0, 1);
	cActS = clip((evs0 + evs1 + evs2 + evs3) * 25.0, 0, 1);
	cAct1 = clip((ev10 + ev11 + ev12 + ev13) * 25.0, 0, 1);
	effCep21 = cep21 * cAct2;
	effCepS1 = cepS1 * cActS;
	effCep12 = cep12 * cAct1;

	// Log-magnitude cepstral liftering: xs_quef blends from broad hull (0) to sharp formant peaks (1)
	qf = clip(xs_quef, 0, 1);
	tl = clip(xs_tilt, -1, 1) * 0.85;
	lg10 = log(max(ev10, 0.002)); lg11 = log(max(ev11, 0.002)); lg12 = log(max(ev12, 0.002)); lg13 = log(max(ev13, 0.002));
	lg20 = log(max(ev20, 0.002)); lg21 = log(max(ev21, 0.002)); lg22 = log(max(ev22, 0.002)); lg23 = log(max(ev23, 0.002));
	lgs0 = log(max(evs0, 0.002)); lgs1 = log(max(evs1, 0.002)); lgs2 = log(max(evs2, 0.002)); lgs3 = log(max(evs3, 0.002));
	lg1Avg = 0.25 * (lg10 + lg11 + lg12 + lg13);
	lg2Avg = 0.25 * (lg20 + lg21 + lg22 + lg23);
	lgsAvg = 0.25 * (lgs0 + lgs1 + lgs2 + lgs3);

	if (abs(effCep21) + abs(effCepS1) > 0.001) {
		cd0 = mix(lg2Avg - lg1Avg, lg20 - lg10, qf) * effCep21 + mix(lgsAvg - lg1Avg, lgs0 - lg10, qf) * effCepS1 - tl * 1.5;
		cd1 = mix(lg2Avg - lg1Avg, lg21 - lg11, qf) * effCep21 + mix(lgsAvg - lg1Avg, lgs1 - lg11, qf) * effCepS1 - tl * 0.5;
		cd2 = mix(lg2Avg - lg1Avg, lg22 - lg12, qf) * effCep21 + mix(lgsAvg - lg1Avg, lgs2 - lg12, qf) * effCepS1 + tl * 0.5;
		cd3 = mix(lg2Avg - lg1Avg, lg23 - lg13, qf) * effCep21 + mix(lgsAvg - lg1Avg, lgs3 - lg13, qf) * effCepS1 + tl * 1.5;
		cg0 = exp(clip(cd0, -2.5, 2.5)); cg1 = exp(clip(cd1, -2.5, 2.5)); cg2 = exp(clip(cd2, -2.5, 2.5)); cg3 = exp(clip(cd3, -2.5, 2.5));
		w1Mix = clip(abs(effCep21) + abs(effCepS1), 0, 1);
		sumL = mix(sumL, b10L * cg0 + b11L * cg1 + b12L * cg2 + b13L * cg3, w1Mix);
		sumR = mix(sumR, b10R * cg0 + b11R * cg1 + b12R * cg2 + b13R * cg3, w1Mix);
	}
	if (abs(effCep12) > 0.001) {
		cd20 = mix(lg1Avg - lg2Avg, lg10 - lg20, qf) * effCep12 - tl * 1.5;
		cd21 = mix(lg1Avg - lg2Avg, lg11 - lg21, qf) * effCep12 - tl * 0.5;
		cd22 = mix(lg1Avg - lg2Avg, lg12 - lg22, qf) * effCep12 + tl * 0.5;
		cd23 = mix(lg1Avg - lg2Avg, lg13 - lg23, qf) * effCep12 + tl * 1.5;
		ch0 = exp(clip(cd20, -2.5, 2.5)); ch1 = exp(clip(cd21, -2.5, 2.5)); ch2 = exp(clip(cd22, -2.5, 2.5)); ch3 = exp(clip(cd23, -2.5, 2.5));
		cep2Out = b20 * ch0 + b21 * ch1 + b22 * ch2 + b23 * ch3;
		osc2SumL = mix(osc2SumL, cep2Out, abs(effCep12));
		osc2SumR = mix(osc2SumR, cep2Out, abs(effCep12));
	}
}

// Wavetable Filter Routing:
//   Serial (0)  : all oscillators (Osc 1 + Osc 2 + Sub) -> Filter 1 -> Filter 2
//   Parallel (1): all oscillators (Osc 1 + Osc 2 + Sub) -> Filter 1 & Filter 2 -> 0.5 * (F1 + F2)
//   Split (2)   : Osc 1 + 0.5 * Sub -> Filter 1; Osc 2 + 0.5 * Sub -> Filter 2; output = F1 + F2
fRouteMode = round(clip(filt_route, 0, 2));
if ((osc2_on > 0.5) || (sub_on > 0.5)) {
	if (fRouteMode < 1.5) {
		sumL = sumL + osc2SumL + subSum;
		sumR = sumR + osc2SumR + subSum;
	} else {
		sumL = sumL + 0.5 * subSum;
		sumR = sumR + 0.5 * subSum;
	}
}

// Cytomic / Andrew Simper trapezoidal SVF. g = tan(pi * fc / sr).
// k falls from 2 (no resonance) toward 0 as filt_res rises, and stays positive.
targetCut = filt_cutoff * pow(2.0, clip(filt_env_amt * maxModEnv * 5.0 + lfoSig * lfo_filt * 3.5, -6, 6));
targetCut = clip(targetCut, 20.0, srVal * 0.45);
cutCoef = cutNow;
effCutHz = clip(slew_val(targetCut, cutCoef), 20.0, srVal * 0.44);
filtCoef = filtNow;
filtMix = clip(slew_val((filt_on > 0.5) ? 1.0 : 0.0, filtCoef), 0, 1);

driveAmt = clip(filt_drive, 0, 1);
driveGain = 1.0 + driveAmt * 5.0;
satL = tanh(sumL * driveGain);
satR = tanh(sumR * driveGain);
drivenL = sumL + (satL - sumL) * driveAmt;
drivenR = sumR + (satR - sumR) * driveAmt;

g = tan(3.141592653589793 * effCutHz / srVal);
k = 2.0 - 1.92 * pow(clip(filt_res, 0, 0.96), 0.7);
k = max(k, 0.05);
g = clip(g, 0.0001, 80.0);
a1 = 1.0 / (1.0 + g * (g + k));
a2 = g * a1;
a3 = g * a2;

v3 = drivenL - svfLpL;
v1 = a1 * svfBpL + a2 * v3;
v2 = svfLpL + a2 * svfBpL + a3 * v3;
svfBpL = fixnan(2.0 * v1 - svfBpL);
svfLpL = fixnan(2.0 * v2 - svfLpL);
lpL = v2;
bpL = v1 * k;
hpL = drivenL - k * v1 - v2;

v3 = drivenR - svfLpR;
v1 = a1 * svfBpR + a2 * v3;
v2 = svfLpR + a2 * svfBpR + a3 * v3;
svfBpR = fixnan(2.0 * v1 - svfBpR);
svfLpR = fixnan(2.0 * v2 - svfLpR);
lpR = v2;
bpR = v1 * k;
hpR = drivenR - k * v1 - v2;

fType = round(clip(filt_type, 0, 4));
wetL = lpL;
wetR = lpR;
if (fType < 2.5) {
	wetL = (fType == 0) ? lpL : ((fType == 1) ? bpL : hpL);
	wetR = (fType == 0) ? lpR : ((fType == 1) ? bpR : hpR);
} else if (fType < 3.5) {
	wetL = lpL + hpL;
	wetR = lpR + hpR;
} else {
	mph = clip(filt_morph, 0, 1) * 4.0;
	if (mph <= 1.0) {
		wetL = lpL + (bpL - lpL) * mph;
		wetR = lpR + (bpR - lpR) * mph;
	} else if (mph <= 2.0) {
		wetL = bpL + (hpL - bpL) * (mph - 1.0);
		wetR = bpR + (hpR - bpR) * (mph - 1.0);
	} else if (mph <= 3.0) {
		wetL = hpL + (lpL + hpL - hpL) * (mph - 2.0);
		wetR = hpR + (lpR + hpR - hpR) * (mph - 2.0);
	} else {
		wetL = (lpL + hpL) + (lpL - (lpL + hpL)) * (mph - 3.0);
		wetR = (lpR + hpR) + (lpR - (lpR + hpR)) * (mph - 3.0);
	}
}
if ((filt_slope > 0.5) || (filt_circuit > 0.5)) {
	f1c = round(clip(filt_circuit, 0, 4));
	if (f1c > 0.5) {
		cBoost = (f1c == 1) ? 1.35 : ((f1c == 2) ? 1.65 : ((f1c == 3) ? 1.45 : 1.55));
		wetL = tanh(wetL * cBoost) / tanh(cBoost);
		wetR = tanh(wetR * cBoost) / tanh(cBoost);
	}
	if (filt_slope > 0.5) {
		s1bL = peek(fstate, 0);
		s1pL = peek(fstate, 1);
		s1bR = peek(fstate, 2);
		s1pR = peek(fstate, 3);
		u3L = wetL - s1pL;
		u1L = a1 * s1bL + a2 * u3L;
		u2L = s1pL + a2 * s1bL + a3 * u3L;
		s1bL = fixnan(2.0 * u1L - s1bL);
		s1pL = fixnan(2.0 * u2L - s1pL);
		uHpL = wetL - k * u1L - u2L;
		u3R = wetR - s1pR;
		u1R = a1 * s1bR + a2 * u3R;
		u2R = s1pR + a2 * s1bR + a3 * u3R;
		s1bR = fixnan(2.0 * u1R - s1bR);
		s1pR = fixnan(2.0 * u2R - s1pR);
		uHpR = wetR - k * u1R - u2R;
		poke(fstate, s1bL, 0);
		poke(fstate, s1pL, 1);
		poke(fstate, s1bR, 2);
		poke(fstate, s1pR, 3);
		if (fType < 2.5) {
			wetL = (fType == 0) ? u2L : ((fType == 1) ? (u1L * k) : uHpL);
			wetR = (fType == 0) ? u2R : ((fType == 1) ? (u1R * k) : uHpR);
		} else {
			wetL = u2L + uHpL;
			wetR = u2R + uHpR;
		}
	}
}
wetL = fixnan(wetL);
wetR = fixnan(wetR);
f1OutL = sumL + (wetL - sumL) * filtMix;
f1OutR = sumR + (wetR - sumR) * filtMix;
if ((filt2_on > 0.5) || (fRouteMode > 1.5)) {
	fRoute = fRouteMode;
	in2L = (fRoute == 0) ? f1OutL : ((fRoute == 1) ? sumL : (osc2SumL + 0.5 * subSum));
	in2R = (fRoute == 0) ? f1OutR : ((fRoute == 1) ? sumR : (osc2SumR + 0.5 * subSum));
	drv2 = clip(filt2_drive, 0, 1);
	if (drv2 > 0.0001) {
		dg2 = 1.0 + drv2 * 5.0;
		in2L = in2L + (tanh(in2L * dg2) - in2L) * drv2;
		in2R = in2R + (tanh(in2R * dg2) - in2R) * drv2;
	}
	tc2 = clip(filt2_cutoff * pow(2.0, clip(filt_env_amt * maxModEnv * 5.0 + lfoSig * lfo_filt * 3.5, -6, 6)), 20.0, srVal * 0.44);
	g2 = clip(tan(3.141592653589793 * tc2 / srVal), 0.0001, 80.0);
	k2 = max(2.0 - 1.92 * pow(clip(filt2_res, 0, 0.96), 0.7), 0.05);
	b1 = 1.0 / (1.0 + g2 * (g2 + k2));
	b2 = g2 * b1;
	b3 = g2 * b2;
	s2bL = peek(fstate, 4);
	s2pL = peek(fstate, 5);
	s2bR = peek(fstate, 6);
	s2pR = peek(fstate, 7);
	w3L = in2L - s2pL;
	w1L = b1 * s2bL + b2 * w3L;
	w2L = s2pL + b2 * s2bL + b3 * w3L;
	s2bL = fixnan(2.0 * w1L - s2bL);
	s2pL = fixnan(2.0 * w2L - s2pL);
	wHpL = in2L - k2 * w1L - w2L;
	wBpL = w1L * k2;
	w3R = in2R - s2pR;
	w1R = b1 * s2bR + b2 * w3R;
	w2R = s2pR + b2 * s2bR + b3 * w3R;
	s2bR = fixnan(2.0 * w1R - s2bR);
	s2pR = fixnan(2.0 * w2R - s2pR);
	wHpR = in2R - k2 * w1R - w2R;
	wBpR = w1R * k2;
	poke(fstate, s2bL, 4);
	poke(fstate, s2pL, 5);
	poke(fstate, s2bR, 6);
	poke(fstate, s2pR, 7);
	f2Type = round(clip(filt2_type, 0, 4));
	w2OutL = w2L;
	w2OutR = w2R;
	if (f2Type < 2.5) {
		w2OutL = (f2Type == 0) ? w2L : ((f2Type == 1) ? wBpL : wHpL);
		w2OutR = (f2Type == 0) ? w2R : ((f2Type == 1) ? wBpR : wHpR);
	} else if (f2Type < 3.5) {
		w2OutL = w2L + wHpL;
		w2OutR = w2R + wHpR;
	} else {
		mph2 = clip(filt2_morph, 0, 1) * 4.0;
		if (mph2 <= 1.0) {
			w2OutL = w2L + (wBpL - w2L) * mph2;
			w2OutR = w2R + (wBpR - w2R) * mph2;
		} else if (mph2 <= 2.0) {
			w2OutL = wBpL + (wHpL - wBpL) * (mph2 - 1.0);
			w2OutR = wBpR + (wHpR - wBpR) * (mph2 - 1.0);
		} else if (mph2 <= 3.0) {
			w2OutL = wHpL + (w2L + wHpL - wHpL) * (mph2 - 2.0);
			w2OutR = wHpR + (w2R + wHpR - wHpR) * (mph2 - 2.0);
		} else {
			w2OutL = (w2L + wHpL) + (w2L - (w2L + wHpL)) * (mph2 - 3.0);
			w2OutR = (w2R + wHpR) + (w2R - (w2R + wHpR)) * (mph2 - 3.0);
		}
	}
	if ((filt2_slope > 0.5) || (filt2_circuit > 0.5)) {
		f2c = round(clip(filt2_circuit, 0, 4));
		if (f2c > 0.5) {
			cBoost2 = (f2c == 1) ? 1.35 : ((f2c == 2) ? 1.65 : ((f2c == 3) ? 1.45 : 1.55));
			w2OutL = tanh(w2OutL * cBoost2) / tanh(cBoost2);
			w2OutR = tanh(w2OutR * cBoost2) / tanh(cBoost2);
		}
		if (filt2_slope > 0.5) {
			s2b2L = peek(fstate, 8);
			s2p2L = peek(fstate, 9);
			s2b2R = peek(fstate, 10);
			s2p2R = peek(fstate, 11);
			z3L = w2OutL - s2p2L;
			z1L = b1 * s2b2L + b2 * z3L;
			z2L = s2p2L + b2 * s2b2L + b3 * z3L;
			s2b2L = fixnan(2.0 * z1L - s2b2L);
			s2p2L = fixnan(2.0 * z2L - s2p2L);
			zHpL = w2OutL - k2 * z1L - z2L;
			z3R = w2OutR - s2p2R;
			z1R = b1 * s2b2R + b2 * z3R;
			z2R = s2p2R + b2 * s2b2R + b3 * z3R;
			s2b2R = fixnan(2.0 * z1R - s2b2R);
			s2p2R = fixnan(2.0 * z2R - s2p2R);
			zHpR = w2OutR - k2 * z1R - z2R;
			poke(fstate, s2b2L, 8);
			poke(fstate, s2p2L, 9);
			poke(fstate, s2b2R, 10);
			poke(fstate, s2p2R, 11);
			if (f2Type < 2.5) {
				w2OutL = (f2Type == 0) ? z2L : ((f2Type == 1) ? (z1L * k2) : zHpL);
				w2OutR = (f2Type == 0) ? z2R : ((f2Type == 1) ? (z1R * k2) : zHpR);
			} else {
				w2OutL = z2L + zHpL;
				w2OutR = z2R + zHpR;
			}
		}
	}
	w2OutL = fixnan(w2OutL);
	w2OutR = fixnan(w2OutR);
	f2FinalL = (filt2_on > 0.5) ? w2OutL : in2L;
	f2FinalR = (filt2_on > 0.5) ? w2OutR : in2R;
	if (fRoute == 0) {
		sumL = f2FinalL;
		sumR = f2FinalR;
	} else if (fRoute == 1) {
		sumL = 0.5 * (f1OutL + f2FinalL);
		sumR = 0.5 * (f1OutR + f2FinalR);
	} else {
		sumL = f1OutL + f2FinalL;
		sumR = f1OutR + f2FinalR;
	}
} else {
	sumL = f1OutL;
	sumR = f1OutR;
}

// Master Output Gain + Soft Ceiling
masterGain = pow(10.0, clip(out_gain, -36, 18) / 20.0);
outL = fixnan(tanh(sumL * masterGain));
outR = fixnan(tanh(sumR * masterGain));

out1 = outL;
out2 = outR;

// Telemetry buffer write every 64 samples
peakHoldL = max(peakHoldL * 0.9985, abs(outL));
peakHoldR = max(peakHoldR * 0.9985, abs(outR));
scopeCount = scopeCount + 1;
if (scopeCount >= 64) {
	scopeCount = 0;
	scopeFrame = scopeFrame + 1;

	activeCnt = 0;
	for (tix = 0; tix < 16; tix += 1) {
		poke(scope, peek(vres, tix * 3), tix);
		poke(scope, peek(vres, tix * 3 + 1), 16 + tix);
		activeCnt = activeCnt + (peek(vres, tix * 3 + 1) > 0.002);
	}

	poke(scope, peakHoldL, 32);
	poke(scope, peakHoldR, 33);
	poke(scope, activeCnt, 34);
	poke(scope, lfoSig, 35);
	poke(scope, maxModEnv, 36);
	poke(scope, effCutHz, 37);
	poke(scope, numFrames, 38);
	poke(scope, scopeFrame, 39);
	// Grain lines (Textures / Fragments): the 32 loudest grains of all voices. 64..95 the read position in the whole sample
	// (0..1, -1 unused), 96..127 the window level times the voice gain (0..1). gtout is the working copy (slots 0..31 position,
	// 32..63 level): the weakest slot is replaced whenever a louder grain turns up.
	for (gs = 0; gs < 32; gs += 1) {
		poke(gtout, -1, gs);
		poke(gtout, 0, 32 + gs);
	}
	poke(gtout, 0, 64);
	poke(gtout, 0, 65);
	for (gv = 0; gv < 16; gv += 1) {
		for (gj = 0; gj < 32; gj += 1) {
			gtP = peek(gtel, gv * 64 + gj);
			gtL = peek(gtel, gv * 64 + 32 + gj);
			if ((gtP >= 0) && (gtL > 0.0005) && (gtL > peek(gtout, 64))) {
				gtSlot = peek(gtout, 65);
				poke(gtout, gtP, gtSlot);
				poke(gtout, min(gtL, 1.0), 32 + gtSlot);
				poke(gtout, 2, 64);
				poke(gtout, 0, 65);
				for (gs2 = 0; gs2 < 32; gs2 += 1) {
					gtV = peek(gtout, 32 + gs2);
					if (gtV < peek(gtout, 64)) {
						poke(gtout, gtV, 64);
						poke(gtout, gs2, 65);
					}
				}
			}
		}
	}
	for (gs = 0; gs < 32; gs += 1) {
		poke(scope, peek(gtout, gs), 64 + gs);
		poke(scope, peek(gtout, 32 + gs), 96 + gs);
	}
	// Per-voice envelope / filter telemetry (128..207). Stage + fraction as one float: 0 off, 1 attack (frac = level),
	// 2 decay (frac = (1 - level) / (1 - sus)), 3 sustain (frac 0), 4 release (frac = 1 - level / level at release start).
	// 128..143 amp code, 144..159 amp level, 160..175 mod code, 176..191 mod level, 192..207 per-voice cutoff in Hz.
	for (tvi = 0; tvi < 16; tvi += 1) {
		tvB = tvi * 256;
		tvAS = peek(vhist, tvB + 1);
		tvAL = peek(vhist, tvB + 2);
		tvMS = peek(vhist, tvB + 3);
		tvML = peek(vhist, tvB + 4);
		tvSa = peek(tvrel, tvi);
		tvSm = peek(tvrel, 16 + tvi);
		tvRelA = peek(vhist, tvB + 44);
		tvRelM = peek(vhist, tvB + 48);
		tvOutA = peek(vhist, tvB + 46);
		tvOutM = peek(vhist, tvB + 47);
		tvRa = (tvAS < 0.5) * (tvAL > 0.00002);
		tvRm = (tvMS < 0.5) * (tvML > 0.00002);
		tvSa = tvRa > 0.5 ? max(tvRelA, 0.000001) : 0;
		tvSm = tvRm > 0.5 ? max(tvRelM, 0.000001) : 0;
		poke(tvrel, tvSa, tvi);
		poke(tvrel, tvSm, 16 + tvi);
		tvFa = (sus_lvl >= 0.999) ? 1 : clip((1 - tvAL) / max(1 - sus_lvl, 0.001), 0, 1);
		tvFm = (msus_lvl >= 0.999) ? 1 : clip((1 - tvML) / max(1 - msus_lvl, 0.001), 0, 1);
		tvSusA = (tvAS > 1.5) * (abs(tvAL - sus_lvl) < 0.01 * (1 - sus_lvl) + 0.001);
		tvSusM = (tvMS > 1.5) * (abs(tvML - msus_lvl) < 0.01 * (1 - msus_lvl) + 0.001);
		tvCa = 0;
		tvCm = 0;
		if (tvAS < 0.5) {
			tvCa = tvRa * (4 + min(clip(1 - tvAL / max(tvSa, 0.000001), 0, 1), 0.999));
		} else if (tvAS < 1.5) {
			tvCa = 1 + min(clip(tvAL, 0, 1), 0.999);
		} else {
			tvCa = tvSusA > 0.5 ? 3 : (2 + min(tvFa, 0.999));
		}
		if (tvMS < 0.5) {
			tvCm = tvRm * (4 + min(clip(1 - tvML / max(tvSm, 0.000001), 0, 1), 0.999));
		} else if (tvMS < 1.5) {
			tvCm = 1 + min(clip(tvML, 0, 1), 0.999);
		} else {
			tvCm = tvSusM > 0.5 ? 3 : (2 + min(tvFm, 0.999));
		}
		tvOn = (tvCa > 0.5) || (tvAL > 0.00002);
		tvCut = filt_cutoff * pow(2.0, clip(filt_env_amt * tvOutM * 5.0 + lfoSig * lfo_filt * 3.5, -6, 6));
		tvCut = clip(tvCut, 20.0, srVal * 0.44);
		poke(scope, tvCa, 128 + tvi);
		poke(scope, tvOutA, 144 + tvi);
		poke(scope, tvCm, 160 + tvi);
		poke(scope, tvOutM, 176 + tvi);
		poke(scope, tvOn > 0.5 ? tvCut : 0, 192 + tvi);
	}
	poke(scope, spawnSum, 48);
	poke(scope, rootDynOn, 49);
	// The parameter values the gen is actually running with (40..47), so a test or the bridge can tell whether the
	// device's messages reached it: sliced, loop_mode, slice_play, mode, freeze, reverse, root_note, loop_start.
	poke(scope, sliced, 40);
	poke(scope, loop_mode, 41);
	poke(scope, slice_play, 42);
	poke(scope, mode, 43);
	poke(scope, freeze, 44);
	poke(scope, reverse, 45);
	poke(scope, root_note, 46);
	poke(scope, loop_start, 47);
}
