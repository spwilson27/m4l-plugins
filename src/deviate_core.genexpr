// Deviate gen core: detector, seeded draw, windows, the three effect chains, the Ring envelope, Mix, telemetry.
// Built as  fft_init + deviate_conv.genexpr + deviate_fx.genexpr + deviate_core.genexpr  (scripts/build_deviate.py gen_code) with the line `//@hidden`
// below replaced by the generated function dv_hidden(mE, mT, hv, mp) (dvHiddenGen() in src/deviate_config.js): the hidden map is a table
// (Architecture) the engine writes into ---deviatemap, copied into dvMp. Contract: src/deviate_config.js
// (DV_SCOPE, DV_ECHO, DV_CTL, DV_PARAMS gen messages, dvStep, dvRingEnv, dvWindows, dvHiddenFromMetas). Inputs: in1 / in2 the audio, in3 / in4 the
// Spectral stage's transient signal (src/deviate_spec.genexpr, a separate gen~ shell; zero until it is loaded).
// One call site per helper: the Glitch helpers keep a coefficient cache in a History that every call site would share.
//
// Signal flow:
//   in1/in2 -> mono -> DETECT (envelope trigger model: fast env 15 ms release, slow 60 ms baseline, onset when armed && fast > thr && fast > slow * ratio;
//                      a MIDI counter change (dvmtrig) is the second source; one shared lockout so an audio onset next to a MIDI hit is deduped)
//           t0 -> DRAW (dv_draw, mirrors dvStep) -> page E/T; the page is APPLIED at t0 + LAT - 96 (dv_hidden -> dv_pg1..3 -> parameter targets;
//                 Ring envelope, windows, click and sends restart); a Reroll applies its page at once.
//   xd = input delayed by LAT (256 Envelope, 1279 Spectral). Windows after the hit (measured from the hit's arrival at the output): gT 1 -> 0 over 10..20 ms,
//   gR 0 -> 1 over 120..180 ms, gB = 1 - gT - gR.
//     T chain (input gT * T source): snap shaper > drive > click burst > crush > high-pass filter
//     B chain (input gB * B source): comb > formant > phaser > grain pitch shift (+-12 st) > ring modulator > saturation; beside it the resonator bank
//                                    (6 modes, excited by the whole hit (1 - gR) * xd) rings
//     L chain: chorus / flanger on gR * B source; sends of xd (open 200 ms after the hit): reverb, delay, slapback, convolver (10 built-in IRs, each input
//              block remembers the IR it was captured with)
//     Envelope mode: T source = B source = xd. Spectral mode: T = the stage's percussive part, B = xd - T (T + B = xd exactly).
//   out = soft_limit( xd + Mix * limit( T residue + env(age) * (B + resonator + L + sends residue) ) ); every chain returns residue fx(in) - in, so Mix 0
//   (and every neutral setting) is a bit-exact delayed dry.
// Ring law: env(age) = 1 for 150 ms, then -66 dB at Tr (= 0.05 .. 1.83 s from Ring), then a 20 ms fade to exactly 0, so nothing is audible 2.0 s after
// a hit. Every in-loop decay (reverb, delay feedback, comb, resonator) is derived from Tr (at most 0.9 Tr) so the envelope's restart on the next hit cannot
// pump old residue. Chains run only from the apply sample until the envelope has ended, and an effect only while its smoothed wet is above 0.02. An effect
// that stops running (wet <= 0.02, its window over, or the life ended) is CLEARED: small states at once, delay / reverb / grain rings in 192 slices (1 per
// sample), and one that wakes before its ring is clean finishes the clear first (so a re-enabled effect never replays old residue and a new life never
// meets a half-wiped ring). The convolver is armed 256 samples before the page applies and wiped (rings at once, slot tags to 0) at the end of a life.
//
// Timing of a hit: t0 is the sample of the (undelayed) input at which the detector fires. Draw at t0. Page applied at
// t0 + LAT - 96 (age 0 of the Ring envelope). The hit reaches the output at t0 + LAT (ONSET_AGE counts from there).
// Windows: gT / gB / gR from the applied page, time measured from the arrival of the hit at the output (age - 96 samples).
//
// Split mode change (dvsplit): the output fades to 0 over 256 samples, the delay tap moves 256 <-> 1279 at gain 0, then the
// output fades back in over 256 samples (no click, no NaN). The first dvsplit value after load is taken as is (no fade).
//
// Baselines: dvreroll, dvmtrig and dvplay start at -1 / -1 / 0. The FIRST value received of dvreroll / dvmtrig only sets the
// baseline (a message resent by the engine after the gen compiled is not an event); afterwards a rising edge 0 -> 1 of dvreroll
// is one forced re-roll, every CHANGE of dvmtrig is one MIDI hit, a rising edge of dvplay resets the draw hit counter.
//
// Sleep: input below 1e-5 for 16384 samples and nothing pending (no lockout, no page waiting, Ring envelope finished) skips
// the effect work and the telemetry except FRAMES / ALIVE / ASLEEP; the output is the delayed dry (exact zeros for digital silence); any input or hit wakes it.
//
// Telemetry (buffer scope, slots in DV_SCOPE): written every 64 samples. HITS, HIT_GATE, HIT_SRC, DRAW_SERIAL, METAS / DRAWS,
// REROLL and PAGE_APPLIED are ALSO written on the sample of the event (sample-accurate for the tests). HITS is a monotonic
// counter (mod 100000), not the draw hit counter (which restarts on transport start and on a restore).
//
// GenExpr rules (AGENTS 8 and the gotcha lists): helpers before declarations before statements, one return at function level,
// no user call inside poke() / if conditions, no identifier e<digit>, never name a Param mix / noise / hold / rise / fall / bias,
// variables first assigned inside an `if` are invisible after it, x - floor(x) never fract(), bare calls for work functions.

// Soft output limiter: the identity up to |x| = 2, a tanh knee above (max 6).
dv_soft(x) {
	a = abs(x);
	return a <= 2 ? x : (x < 0 ? -1 : 1) * (2 + 4 * tanh((a - 2) * 0.25));
}

// One draw event; mirrors dvStep of src/deviate_config.js exactly (exact integer hash: seed mix + four squarings mod 67108859).
//   pv / pr / lk = Values, Ranges, Lock flags (Data 8), st = state (0 valid, 1 hits, 2 reroll counter, 3 serial, 4 gate, 5 drew),
//   tT / tE = target draw T and drifted draw E (Data 8, 0..100), ev = 0 hit, 1 reroll.
// Returns drew (1 when a draw happened). The same values are in st[5].
dv_draw(pv, pr, lk, st, tT, tE, seedIn, chanceIn, driftIn, ev) {
	k = floor(seedIn + 0.5);
	valid = peek(st, 0);
	hits = peek(st, 1);
	rerl = peek(st, 2);
	serial = peek(st, 3);
	oldGate = peek(st, 4);
	if (valid < 0.5) {
		for (i = 0; i < 8; i += 1) {
			pvi = peek(pv, i);
			v0 = clip(pvi, 0, 100);
			poke(tT, v0, i);
			poke(tE, v0, i);
		}
	}
	rerl = rerl + ev;
	rmod = rerl - 4096 * floor(rerl / 4096);
	idx = hits * 4096 + rmod;
	cx = idx * 7919 + k * 104729 + 8 * 3571 + 12345;
	cx = cx - 67108859 * floor(cx / 67108859);
	cx = cx * cx + 40503;
	cx = cx - 67108859 * floor(cx / 67108859);
	cx = cx * cx + 40503;
	cx = cx - 67108859 * floor(cx / 67108859);
	cx = cx * cx + 40503;
	cx = cx - 67108859 * floor(cx / 67108859);
	cx = cx * cx + 40503;
	cx = cx - 67108859 * floor(cx / 67108859);
	cc = cx / 67108859;
	gateV = (valid < 0.5) ? 1 : ((cc * 100 < chanceIn) ? 1 : 0);
	gateV = (ev > 0.5) ? 1 : gateV;
	hits = hits + (1 - ev);
	newGate = (ev > 0.5) ? oldGate : gateV;
	if (gateV > 0.5) {
		for (i = 0; i < 8; i += 1) {
			lkv = peek(lk, i);
			pvi = peek(pv, i);
			pri = peek(pr, i);
			told = peek(tT, i);
			hx = idx * 7919 + k * 104729 + i * 3571 + 12345;
			hx = hx - 67108859 * floor(hx / 67108859);
			hx = hx * hx + 40503;
			hx = hx - 67108859 * floor(hx / 67108859);
			hx = hx * hx + 40503;
			hx = hx - 67108859 * floor(hx / 67108859);
			hx = hx * hx + 40503;
			hx = hx - 67108859 * floor(hx / 67108859);
			hx = hx * hx + 40503;
			hx = hx - 67108859 * floor(hx / 67108859);
			hh = hx / 67108859;
			tn = clip(pvi + (2 * hh - 1) * pri, 0, 100);
			keep = (valid > 0.5 && lkv > 0.5) ? 1 : 0;
			poke(tT, keep > 0.5 ? told : tn, i);
		}
		serial = serial + 1;
	}
	valid = max(valid, gateV);
	kd = 1 - 0.56 * clip(driftIn, 0, 100) / 100;
	for (i = 0; i < 8; i += 1) {
		te = peek(tE, i);
		tt = peek(tT, i);
		poke(tE, te + kd * (tt - te), i);
	}
	poke(st, valid, 0);
	poke(st, hits, 1);
	poke(st, rerl, 2);
	poke(st, serial, 3);
	poke(st, newGate, 4);
	poke(st, gateV, 5);
	return gateV;
}

// ---- hidden values (dvHV, DV_HIDDEN rows) -> the smoothed parameter vector targets (dvQT) ---------------------------------------------
// pv layout (indexes into dvQ / dvQT; the gl_* / dv_* helpers read b + n):
//   0 snap amt | 1 click level | 2 click Hz | 8 drive: wet, mode, dB, tone | 12 crush: wet, bits, factor, jitter | 16 filter: wet, type, Hz, res
//   20 resonator: wet, f0, stretch, t60 | 24 comb: wet, Hz, fb, damp | 28 formant: wet, vowel, shift, res | 32 phaser: wet, stages, sync, rate,
//   sync rate, depth, fb | 40 grain: wet, semitones, ms, spray | 44 ring: wet, mode, Hz | 47 sat amt | 48 chorus: wet, Hz, ms, depth
//   52 reverb: wet, size, rt60, damp | 56 delay: wet, ms, fb, ping-pong, damp | 61 slap: wet, ms, tone, offset | 65 conv wet | 66 conv IR tag
//   67 tape: wet, st, glide st, glide ms, loop ms, loop step | 73 gate: wet, Hz, duty | 76 zap: wet, f0, f1, ms, res | 81 bend st, ms | 83 ring sweep
//   84 vowel sweep | 85 resonator kind, drop | 87 spectral: wet, op, amount (67..89 = hidden rows 36..58, dv_pg4)
//   90 lfo Hz | 91 lfo depth | 92 lfo shape | 93 lfo target | 94 tape reverse | 95 dry replacement (90..95 = hidden rows 64..69, dv_pg5)
//   rows 70 / 71 (Ring hold ms, send-close ms) are latched at a hit, not part of pv; hidden rows 64..79 are echoed at scope HIDDEN2 (160..)
// Every in-loop decay is derived from the Ring time Tr (hidden row 35): at most 0.9 Tr, so a restarted Ring envelope never meets old residue.
// Hidden row indexes (DV_HIDDEN): 0 snap_amt 1 click_lvl 2 click_hz 3 tfilt_hz 5 pitch_st 6 pitch_wet 7 grain_ms 8 res_wet 9 res_f0 10 res_stretch
//   11 comb_wet 12 comb_hz 13 form_wet 14 form_vowel 16 phas_wet 17 phas_hz 18 chor_wet 19 chor_hz 20 chor_ms 21 conv_wet 22 conv_ir 23 rev_wet
//   24 rev_size 25 dly_wet 26 dly_ms 27 dly_fb 28 slap_wet 29 drive_amt 30 crush_wet 31 crush_bits 32 ring_wet 33 ring_hz 34 sat_amt 35 tr_s
//   36..58 -> pv 67..89 (dv_pg4) 59 drive_shape 60 crush_sr 61 grain_spray 62 dly_pp 63 form_shift
dv_pg1(hv, qt) {
	snapA = peek(hv, 0);
	clkL = peek(hv, 1);
	clkH = peek(hv, 2);
	flH = peek(hv, 3);
	drA = peek(hv, 29);
	cW = peek(hv, 30);
	cB = peek(hv, 31);
	dShp = peek(hv, 59);
	cSr = peek(hv, 60);
	poke(qt, snapA, 0);
	poke(qt, clkL, 1);
	poke(qt, clkH, 2);
	poke(qt, clip(drA * 2, 0, 1), 8);
	poke(qt, clip(drA * 1.7 + dShp, 0, 3), 9);
	poke(qt, 6 + drA * 26, 10);
	poke(qt, 9000 - drA * 4500, 11);
	poke(qt, cW, 12);
	poke(qt, 12 - 1.25 * cB, 13);
	poke(qt, (1 + 0.75 * cB) * max(cSr, 1), 14);
	poke(qt, 0.1, 15);
	poke(qt, clip((flH - 22) * 0.05, 0, 1), 16);
	poke(qt, 2, 17);
	poke(qt, flH, 18);
	poke(qt, 0.15, 19);
	return 0;
}

dv_pg2(hv, qt) {
	h8 = peek(hv, 8);
	h9 = peek(hv, 9);
	h10 = peek(hv, 10);
	h11 = peek(hv, 11);
	h13 = peek(hv, 13);
	h14 = peek(hv, 14);
	h16 = peek(hv, 16);
	h17 = peek(hv, 17);
	h6 = peek(hv, 6);
	h5 = peek(hv, 5);
	h7 = peek(hv, 7);
	h32 = peek(hv, 32);
	h33 = peek(hv, 33);
	h34 = peek(hv, 34);
	t9 = 0.9 * peek(hv, 35);
	cmbHz = peek(hv, 12);
	fmSh = peek(hv, 63);
	grSp = peek(hv, 61);
	poke(qt, h8, 20);
	poke(qt, h9, 21);
	poke(qt, h10, 22);
	t60c = (peek(hv, 35) > 1.84) ? 6.6 : 1.2;
	poke(qt, clip(t9, 0.05, t60c), 23);
	poke(qt, h11, 24);
	poke(qt, cmbHz, 25);
	poke(qt, clip(pow(10, -3 / (cmbHz * max(t9, 0.02))), 0, 0.95), 26);
	poke(qt, 6000, 27);
	poke(qt, h13, 28);
	poke(qt, h14, 29);
	poke(qt, fmSh, 30);
	poke(qt, 0.55, 31);
	poke(qt, h16, 32);
	poke(qt, 1, 33);
	poke(qt, 0, 34);
	poke(qt, h17, 35);
	poke(qt, 0, 36);
	poke(qt, 0.8, 37);
	poke(qt, 0.4, 38);
	poke(qt, h6, 40);
	poke(qt, h5, 41);
	poke(qt, h7, 42);
	poke(qt, grSp, 43);
	poke(qt, h32, 44);
	poke(qt, 0, 45);
	poke(qt, h33, 46);
	poke(qt, h34, 47);
	return 0;
}

dv_pg3(hv, qt) {
	h18 = peek(hv, 18);
	h19 = peek(hv, 19);
	h20 = peek(hv, 20);
	h23 = peek(hv, 23);
	h24 = peek(hv, 24);
	h25 = peek(hv, 25);
	h28 = peek(hv, 28);
	h21 = peek(hv, 21);
	h22 = peek(hv, 22);
	t9 = 0.9 * peek(hv, 35);
	dlMs = peek(hv, 26);
	dlFb = peek(hv, 27);
	dlPp = peek(hv, 62);
	poke(qt, h18, 48);
	poke(qt, h19, 49);
	poke(qt, h20, 50);
	poke(qt, 0.6, 51);
	poke(qt, h23, 52);
	poke(qt, h24, 53);
	poke(qt, max(t9, 0.03), 54);
	poke(qt, 5500, 55);
	poke(qt, h25, 56);
	poke(qt, dlMs, 57);
	poke(qt, min(dlFb, pow(10, -3 * dlMs * 0.001 / max(t9, 0.03))), 58);
	poke(qt, dlPp, 59);
	poke(qt, 4500, 60);
	poke(qt, h28, 61);
	poke(qt, 70, 62);
	poke(qt, 5000, 63);
	poke(qt, 0.5, 64);
	poke(qt, h21, 65);
	poke(qt, h22, 66);
	return 0;
}

// Rows 36..58 (tape, gate, zap, bend, sweeps, resonator kind / drop, spectral) -> pv 67..89, in row order.
dv_pg4(hv, qt) {
	for (i = 0; i < 23; i += 1) {
		hvx = peek(hv, 36 + i);
		poke(qt, hvx, 67 + i);
	}
	return 0;
}

// Rows 64..69 (lfo hz / depth / shape / target, tape direction, dry replacement) -> pv 90..95.
dv_pg5(hv, qt) {
	for (i = 0; i < 6; i += 1) {
		hvx = peek(hv, 64 + i);
		poke(qt, hvx, 90 + i);
	}
	return 0;
}

// Move q toward qt (every 8th sample): a continuous parameter by `k`, snapping when closer than 1e-5 + 1e-4 |qt|; hard = 1 copies qt.
dv_pvsm(q, qt, k, hard) {
	for (i = 0; i < 96; i += 1) {
		a = peek(q, i);
		b = peek(qt, i);
		d = b - a;
		nv = (hard > 0.5 || abs(d) < 0.00001 + 0.0001 * abs(b)) ? b : a + d * k;
		poke(q, nv, i);
	}
	return 0;
}

//@hidden

Buffer scope("deviatescope");
Buffer ctl("deviatectl");
Buffer ir("deviateir");
Buffer spec("deviatespec");
Buffer dmap("deviatemap");

// Values 0..100, Ranges 0..100, Locks 0 / 1 (one Param each: a Param cannot be indexed).
Param dvv0(30);
Param dvv1(50);
Param dvv2(30);
Param dvv3(20);
Param dvv4(30);
Param dvv5(20);
Param dvv6(20);
Param dvv7(10);
Param dvr0(50);
Param dvr1(50);
Param dvr2(50);
Param dvr3(50);
Param dvr4(50);
Param dvr5(50);
Param dvr6(50);
Param dvr7(50);
Param dvl0(0);
Param dvl1(0);
Param dvl2(0);
Param dvl3(0);
Param dvl4(0);
Param dvl5(0);
Param dvl6(0);
Param dvl7(0);
Param dvsens(0.5);
Param dvthr(-36);
Param dvchance(100);
Param dvwet(1);
Param dvseed(0);
Param dvdrift(0);
Param dvreroll(-1);
Param dvsplit(0);
Param dvmtrig(-1);
Param dvplay(0);

Data dvPV(8);
Data dvPR(8);
Data dvLK(8);
Data dvST(8);
Data dvT(8);
Data dvE(8);
Data dvAT(8);
Data dvAE(8);
Data dvHV(80);
Data dvMp(640);
Data dvQ(96);
Data dvQT(96);
Data dvGp(4);
Data dvRgp(4);
Data dvFp(4);
Data dvRsp(6);
Data stZap(8);
Data stTap(12);
Data rbTap(65536, 2);
Data dvIoP(2);
Data dvSx(512, 2);
Data dvSy(257, 2);
Data dvSin(512);
Data dvSacc(1024, 2);
Data dvSw(512);
Data dvSmg(257);
Data dvSph(257);
Data dvSst(10);
Data dvIoT(2);
Data dvIoB(2);
Data dvIoR(2);
Data dvIoQ(2);
Data dvIoV(2);
Data dvIoD(2);
Data dvIoS(2);
Data stSnap(4);
Data stDrv(8);
Data stCrs(8);
Data stFlt(8);
Data stRes(48);
Data stCmb(8);
Data rbCmb(8192);
Data stFrm(16);
Data stPha(24);
Data stGrn(16);
Data rbGrn(16384, 2);
Data stRng(4);
Data stChr(4);
Data rbChr(8192, 2);
Data stRev(16);
Data rbRev(65536);
Data stDly(8);
Data rbDly(65536, 2);
Data stSlp(8);
Data rbSlp(65536);
Data dvTab(4096, 3);
Data dvCvr(8192, 2);
Data dvCxh(256, 2);
Data dvCxt(4096, 2);
Data dvFdh(16512);
Data dvFdt(393408);
Data dvOhr(512, 2);
Data dvOtr(8192, 2);
Data dvCp(4);
Data dvTgH(32, 3);
Data dvTgT(48, 3);
Data dvAch(192);
Data dvCout(2);
Data dvHs(256, 2);
Data dvRj(8);
Data dvAc(16);

Delay dlyL(2048);
Delay dlyR(2048);

History inited(0);
History cacheSr(0);
History cacheThr(1000000000);
History cacheSens(-1);
History thrLin(0.0158);
History ratio(2);
History relC(0);
History slowC(0);
History lockAud(1440);
History holdS(7200);
History closeS(9600);
History fadeS(960);
History fast(0);
History slow(0);
History armed(1);
History lock(0);
History mtLast(-1);
History rrLast(-1);
History playLast(0);
History rrq(0);
History hitSrc(0);
History lastCtlGen(0);
History preKey(-1);
History modeCur(0);
History latCur(256);
History swState(0);
History swGain(1);
History wsm(1);
History pendApply(0);
History outWait(0);
History outAge(-1);
History age(1000000000);
History envRec(1);
History decayK(1);
History endS(0);
History winT(10);
History winR(150);
History trS(0.05);
History irTag(0);
History hitCount(0);
History pageCnt(0);
History quietCnt(0);
History tickC(0);
History alive(0);
History frames(0);
History pkIn(0);
History pkT(0);
History pkB(0);
History pkL(0);
History pkOut(0);
History pkDry(0);
History pkFast(0);
History blkC(0);
History blkInMin(0);
History blkInMax(0);
History blkOutMin(0);
History blkOutMax(0);
History blkFlag(0);
History waveHead(0);
History specHead(0);
History specOn(0);
History hidC(0);
History qInit(0);
History q8(0);
History pvT(0);
History clkT(1000000000);
History clkAmp(0.3);
History pkAcc(0);
History lifePrev(0);
History wipeBusy(0);
History cvN(0);
History cvArm(0);
History cvWant(0);
History hsP(0);
History envLast(0);
History mapVer(0);
History md16(0);
History gtS(1);
History drPT(1);
History drPB(1);
History drPR(1);

// History discipline: a History read after a write in the same sample returns the OLD value (AGENTS 16 / 21), so every History
// is read into a local, computed on, and written back exactly once per sample (never read again after its write).
sr = max(samplerate, 1);
first = (inited < 0.5) ? 1 : 0;
inited = 1;
if (first > 0.5) {
	poke(dvST, 1, 4);
	poke(stFlt, 2, 0);
	for (i = 0; i < 8; i += 1) {
		poke(dvRj, -1, i);
	}
	for (i = 0; i < 512; i += 1) {
		poke(dvSw, 0.5 - 0.5 * cos(6.283185307179586 * i / 512), i);
	}
}

// ---- cached coefficients (pow / exp only when an input moved) ----
thrN = thrLin;
ratN = ratio;
relN = relC;
slwN = slowC;
lkaN = lockAud;
hldN = holdS;
clsN = closeS;
fdN = fadeS;
if (dvthr != cacheThr) {
	cacheThr = dvthr;
	thrN = pow(10, clip(dvthr, -60, 0) / 20);
	thrLin = thrN;
}
if (dvsens != cacheSens) {
	cacheSens = dvsens;
	ratN = pow(10, (1 - clip(dvsens, 0, 1)) * 12 / 20);
	ratio = ratN;
}
if (sr != cacheSr) {
	cacheSr = sr;
	relN = exp(-1000 / (15 * sr));
	relC = relN;
	slwN = exp(-1000 / (60 * sr));
	slowC = slwN;
	lkaN = floor(30 * sr / 1000);
	lockAud = lkaN;
	hldN = 0.15 * sr;
	holdS = hldN;
	clsN = 0.2 * sr;
	closeS = clsN;
	fdN = 0.02 * sr;
	fadeS = fdN;
}

// ---- Split Mode: the first value is taken as is; a change fades out, moves the tap at gain 0, fades in ----
wantMode = (dvsplit > 0.5) ? 1 : 0;
modeN = modeCur;
latN = latCur;
ssN = swState;
sgN = swGain;
if (first > 0.5) {
	modeN = wantMode;
	latN = (modeN > 0.5) ? 1279 : 256;
	ssN = 0;
	sgN = 1;
}
if (ssN < 0.5 && wantMode != modeN) {
	ssN = 1;
}
if (ssN > 0.5 && ssN < 1.5) {
	sgN = max(sgN - 0.00390625, 0);
	if (sgN <= 0) {
		modeN = wantMode;
		latN = (modeN > 0.5) ? 1279 : 256;
		ssN = 2;
	}
} else if (ssN > 1.5) {
	sgN = min(sgN + 0.00390625, 1);
	if (sgN >= 1) {
		ssN = 0;
	}
}
modeCur = modeN;
latCur = latN;
swState = ssN;
swGain = sgN;

// ---- detector on the mono sum of the UNDELAYED input ----
inPk = max(abs(in1), abs(in2));
inMono = (in1 + in2) * 0.5;
ax = abs(inMono);
nf = (ax > fast) ? ax : fast * relN;
fastN = (nf < 0.000000000001) ? 0 : nf;
ns = fastN + (slow - fastN) * slwN;
slowN = (ns < 0.000000000001) ? 0 : ns;
fast = fastN;
slow = slowN;
lockN = max(lock - 1, 0);

// MIDI source: every change of dvmtrig after the first value is one hit (only outside the lockout).
midiFire = 0;
mtN = mtLast;
if (dvmtrig != mtLast) {
	if (mtLast > -0.5 && lockN <= 0) {
		midiFire = 1;
	}
	mtN = dvmtrig;
}
mtLast = mtN;
// Audio source. An onset inside the lockout is swallowed (disarmed), so it is not re-fired when the lockout ends.
audioFire = 0;
armedN = armed;
if (armed > 0.5 && fastN > thrN && fastN > slowN * ratN) {
	armedN = 0;
	if (lockN <= 0 && midiFire < 0.5) {
		audioFire = 1;
	}
} else if (armed < 0.5 && (fastN < thrN * 0.7 || fastN < slowN * 1.12)) {
	armedN = 1;
}
armed = armedN;
hitNow = max(midiFire, audioFire);

// Reroll: rising edge 0 -> 1 after the baseline; transport start resets the draw hit counter.
rq = rrq;
if (dvreroll != rrLast) {
	if (rrLast > -0.5 && rrLast < 0.5 && dvreroll > 0.5) {
		rq = rq + 1;
	}
	rrLast = dvreroll;
}
if (dvplay > 0.5 && playLast < 0.5) {
	poke(dvST, 0, 1);
}
playLast = (dvplay > 0.5) ? 1 : 0;

// ---- the hidden map (Architecture): the engine writes a bank of ---deviatemap, then its index (1), then a new version (0, last).
// A new version is copied into dvMp in one sample; until a map exists (version 0) no page is applied and the convolver does not start.
mvN = mapVer;
mvB = peek(dmap, 0, 0);
if (mvB > 0.5 && mvB != mvN) {
	mvO = 16 + 640 * clip(floor(peek(dmap, 1, 0) + 0.5), 0, 1);
	for (i = 0; i < 640; i += 1) {
		mvq = peek(dmap, mvO + i, 0);
		poke(dvMp, mvq, i);
	}
	mvN = mvB;
}
mapVer = mvN;
mapOk = (mvN > 0.5) ? 1 : 0;

// ---- page timing (locals; written back after the event block) ----
applyNow = 0;
applyCount = 0;
ageReset = 0;
wake = 0;
pa = pendApply;
ow = outWait;
oa = outAge;
if (pa > 0) {
	pa = pa - 1;
	if (pa < 0.5) {
		applyNow = 1;
		applyCount = 1;
		ageReset = 1;
	}
}
if (ow > 0) {
	ow = ow - 1;
	if (ow < 0.5) {
		oa = 0;
	}
} else if (oa >= 0) {
	oa = oa + 1;
	if (oa > 2.5 * sr) {
		oa = -1;
	}
}

// ---- control tick (every 64 samples): restore from ctl, pre-draw page from the Values ----
lcN = lastCtlGen;
if (tickC < 0.5) {
	pkey = preKey;
	cg = peek(ctl, 0, 0);
	if (cg != lastCtlGen) {
		lcN = cg;
		if (cg > 0.5) {
			fl = peek(ctl, 1, 0);
			vflag = fl - 2 * floor(fl / 2);
			rrv = peek(ctl, 2, 0);
			poke(dvST, (vflag > 0.5) ? 1 : 0, 0);
			poke(dvST, 0, 1);
			poke(dvST, rrv, 2);
			for (i = 0; i < 8; i += 1) {
				ct = peek(ctl, 4 + i, 0);
				ce = peek(ctl, 12 + i, 0);
				poke(dvT, ct, i);
				poke(dvE, ce, i);
			}
			pkey = -1;
			applyNow = 1;
			wake = 1;
		}
	}
	vld = peek(dvST, 0);
	if (vld < 0.5 && pa < 0.5) {
		key = dvv0 + dvv1 * 3 + dvv2 * 5 + dvv3 * 7 + dvv4 * 11 + dvv5 * 13 + dvv6 * 17 + dvv7 * 19;
		if (key != pkey) {
			pkey = key;
			poke(dvT, clip(dvv0, 0, 100), 0);
			poke(dvT, clip(dvv1, 0, 100), 1);
			poke(dvT, clip(dvv2, 0, 100), 2);
			poke(dvT, clip(dvv3, 0, 100), 3);
			poke(dvT, clip(dvv4, 0, 100), 4);
			poke(dvT, clip(dvv5, 0, 100), 5);
			poke(dvT, clip(dvv6, 0, 100), 6);
			poke(dvT, clip(dvv7, 0, 100), 7);
			for (i = 0; i < 8; i += 1) {
				tv = peek(dvT, i);
				poke(dvE, tv, i);
			}
			applyNow = 1;
		}
	}
	preKey = pkey;
}
lastCtlGen = lcN;

// ---- the draw event: a hit (0) or a reroll (1); a reroll that meets a hit waits one sample ----
evNow = -1;
if (hitNow > 0.5) {
	evNow = 0;
} else if (rq > 0.5) {
	evNow = 1;
	rq = rq - 1;
}
rrq = rq;
hcN = hitCount;
hsN = hitSrc;
bfl = blkFlag;
cvWN = cvWant;
if (evNow > -0.5) {
	poke(dvPV, dvv0, 0);
	poke(dvPV, dvv1, 1);
	poke(dvPV, dvv2, 2);
	poke(dvPV, dvv3, 3);
	poke(dvPV, dvv4, 4);
	poke(dvPV, dvv5, 5);
	poke(dvPV, dvv6, 6);
	poke(dvPV, dvv7, 7);
	poke(dvPR, dvr0, 0);
	poke(dvPR, dvr1, 1);
	poke(dvPR, dvr2, 2);
	poke(dvPR, dvr3, 3);
	poke(dvPR, dvr4, 4);
	poke(dvPR, dvr5, 5);
	poke(dvPR, dvr6, 6);
	poke(dvPR, dvr7, 7);
	poke(dvLK, dvl0 > 0.5 ? 1 : 0, 0);
	poke(dvLK, dvl1 > 0.5 ? 1 : 0, 1);
	poke(dvLK, dvl2 > 0.5 ? 1 : 0, 2);
	poke(dvLK, dvl3 > 0.5 ? 1 : 0, 3);
	poke(dvLK, dvl4 > 0.5 ? 1 : 0, 4);
	poke(dvLK, dvl5 > 0.5 ? 1 : 0, 5);
	poke(dvLK, dvl6 > 0.5 ? 1 : 0, 6);
	poke(dvLK, dvl7 > 0.5 ? 1 : 0, 7);
	dv_draw(dvPV, dvPR, dvLK, dvST, dvT, dvE, dvseed, dvchance, dvdrift, evNow);
	gateV = peek(dvST, 4);
	serV = peek(dvST, 3);
	rerV = peek(dvST, 2);
	poke(scope, serV, 3, 0);
	for (i = 0; i < 8; i += 1) {
		me = peek(dvE, i);
		mt = peek(dvT, i);
		poke(scope, me, 16 + i, 0);
		poke(scope, mt, 24 + i, 0);
	}
	if (evNow < 0.5) {
		hsN = (midiFire > 0.5) ? 1 : 0;
		hcN = wrap(hcN + 1, 0, 100000);
		poke(scope, hcN, 2, 0);
		poke(scope, gateV, 39, 0);
		poke(scope, hsN, 40, 0);
		pa = latN - 96;
		ow = latN;
		oa = -1;
		lockN = max(lkaN, latN + 96);
		bfl = 1;
		// the convolver's page values, known now: it has to start before the page applies (its stream begins 256 samples before the apply)
		dv_hidden(dvE, dvT, dvHV, dvMp);
		cwE = peek(dvHV, 21);
		tgE = clip(floor(peek(dvHV, 22) + 0.5), 0, 9);
		eCnt = peek(ir, 1, 0);
		eRdy = peek(ir, 3, 0);
		eSr = peek(ir, 2, 0);
		eOff = peek(ir, 16 + 4 * tgE, 0);
		eNh = peek(ir, 18 + 4 * tgE, 0);
		eNt = peek(ir, 19 + 4 * tgE, 0);
		eLd = (eRdy > 0.5 && tgE < eCnt && abs(eSr - sr) < 1) ? 1 : 0;
		cvWN = (cwE >= 0.02 && eLd > 0.5 && mapOk > 0.5) ? 1 : 0;
		if (cvWN > 0.5) {
			poke(dvCp, 1, 0);
			poke(dvCp, eOff, 1);
			poke(dvCp, eNh, 2);
			poke(dvCp, eNt, 3);
		}
	} else {
		poke(scope, rerV, 8, 0);
		applyNow = 1;
		applyCount = 1;
	}
	wake = 1;
}
pkaN = pkAcc;
if (evNow > -0.5 && evNow < 0.5) {
	pkaN = fastN;
} else if (pa > 0) {
	pkaN = max(pkaN, fastN);
}
pkAcc = pkaN;
hitCount = hcN;
hitSrc = hsN;
pendApply = pa;
outWait = ow;
outAge = oa;
lock = lockN;

// ---- apply the page: hidden values, windows and Ring envelope parameters ----
wtN = winT;
wrN = winR;
trN = trS;
irN = irTag;
dkN = decayK;
esN = endS;
pcN = pageCnt;
hardNow = 0;
ckAmpN = clkAmp;
ckTN = clkT;
pvTN = pvT;
applyNow = (mapOk > 0.5) ? applyNow : 0;
if (applyNow > 0.5) {
	for (i = 0; i < 8; i += 1) {
		te = peek(dvE, i);
		tt = peek(dvT, i);
		poke(dvAE, te, i);
		poke(dvAT, tt, i);
	}
	dv_hidden(dvAE, dvAT, dvHV, dvMp);
	wtN = peek(dvHV, 4);
	wrN = peek(dvHV, 15);
	trN = peek(dvHV, 35);
	irN = peek(dvHV, 22);
	// Ring hold and send-close window: latched on a hit (a Reroll keeps the running ones); 150 / 200 are the Classic constants
	hvHd = peek(dvHV, 70);
	hvCl = peek(dvHV, 71);
	hldN = (ageReset > 0.5) ? ((hvHd == 150) ? 0.15 * sr : hvHd * sr / 1000) : hldN;
	clsN = (ageReset > 0.5) ? ((hvCl == 200) ? 0.2 * sr : hvCl * sr / 1000) : clsN;
	trN = min(trN, 7.98 - hldN / sr);
	dkN = pow(10, -3.3 / (max(trN, 0.001) * sr));
	esN = hldN + trN * sr;
	for (i = 0; i < 64; i += 1) {
		hvv = peek(dvHV, i);
		poke(scope, hvv, 64 + i, 0);
	}
	for (i = 0; i < 8; i += 1) {
		hvv2 = peek(dvHV, 64 + i);
		poke(scope, hvv2, 160 + i, 0);
	}
	poke(scope, irN, 11, 0);
	dv_pg1(dvHV, dvQT);
	dv_pg2(dvHV, dvQT);
	dv_pg3(dvHV, dvQT);
	dv_pg4(dvHV, dvQT);
	dv_pg5(dvHV, dvQT);
	hardNow = (qInit < 0.5) ? 1 : 0;
	qInit = 1;
	pvTN = 4000;
	tagI = clip(floor(irN + 0.5), 0, 9);
	irCnt = peek(ir, 1, 0);
	irRdy = peek(ir, 3, 0);
	irSr = peek(ir, 2, 0);
	irOff = peek(ir, 16 + 4 * tagI, 0);
	irNh = peek(ir, 18 + 4 * tagI, 0);
	irNt = peek(ir, 19 + 4 * tagI, 0);
	cpLd = (irRdy > 0.5 && tagI < irCnt && abs(irSr - sr) < 1) ? 1 : 0;
	poke(dvCp, cpLd, 0);
	poke(dvCp, irOff, 1);
	poke(dvCp, irNh, 2);
	poke(dvCp, irNt, 3);
	if (ageReset > 0.5) {
		ckAmpN = max(pkAcc, 0.15);
		ckTN = -96;
		cvWN = 0;
	}
	if (applyCount > 0.5) {
		pcN = wrap(pcN + 1, 0, 100000);
		poke(scope, pcN, 38, 0);
	}
	wake = 1;
}
winT = wtN;
winR = wrN;
trS = trN;
irTag = irN;
decayK = dkN;
endS = esN;
holdS = hldN;
closeS = clsN;
pageCnt = pcN;
clkAmp = ckAmpN;
cvWant = cvWN;

// ---- smoothed parameter vector: toward the targets every 8th sample; discrete entries and the very first page at once ----
q8N = wrap(q8 + 1, 0, 8);
q8 = q8N;
pvT = max(pvTN - 1, 0);
if (hardNow > 0.5 || (q8N < 0.5 && pvTN > 0)) {
	dv_pvsm(dvQ, dvQT, 0.05, hardNow);
}
if (applyNow > 0.5) {
	di13 = peek(dvQT, 13);
	di14 = peek(dvQT, 14);
	di29 = peek(dvQT, 29);
	di66 = peek(dvQT, 66);
	di71 = peek(dvQT, 71);
	di85 = peek(dvQT, 85);
	di88 = peek(dvQT, 88);
	di92 = peek(dvQT, 92);
	di93 = peek(dvQT, 93);
	di94 = peek(dvQT, 94);
	poke(dvQ, di13, 13);
	poke(dvQ, di14, 14);
	poke(dvQ, di29, 29);
	poke(dvQ, di66, 66);
	poke(dvQ, di71, 71);
	poke(dvQ, di85, 85);
	poke(dvQ, di88, 88);
	poke(dvQ, di92, 92);
	poke(dvQ, di93, 93);
	poke(dvQ, di94, 94);
}

// ---- sleep decision ----
qc = (inPk < 0.00001 && wake < 0.5) ? min(quietCnt + 1, 1000000) : 0;
quietCnt = qc;
agN = age;
erN = envRec;
if (ageReset > 0.5) {
	agN = 0;
	erN = 1;
}
busy = (pa > 0 || lockN > 0 || ow > 0 || ssN > 0.5 || agN < esN + fdN + 64 || wipeBusy > 0.5 || envLast > 0.000001) ? 1 : 0;
asleep = (qc >= 16384 && busy < 0.5) ? 1 : 0;

// ---- delayed dry (always written, so a wake-up is seamless) ----
dlyL.write(in1);
dlyR.write(in2);
xdL = dlyL.read(latN);
xdR = dlyR.read(latN);

// ---- Ring envelope and windows (restart at the apply sample; measured from the arrival of the hit at the output) ----
envV = 0;
gT = 0;
gB = 0;
gR = 1;
xdPk = max(abs(xdL), abs(xdR));
xdM = (xdL + xdR) * 0.5;
if (asleep < 0.5) {
	if (agN <= hldN) {
		envV = 1;
		erN = 1;
	} else if (agN <= esN) {
		erN = erN * dkN;
		envV = erN;
	} else if (agN <= esN + fdN) {
		envV = 0.0005011872336272725 * (1 - (agN - esN) / fdN);
	}
	tw = max(agN - 96, 0) * 1000 / sr;
	uT = clip(tw / max(wtN, 1), 0, 1);
	uR = clip(tw / max(wrN, 1), 0, 1);
	gT = 1 - uT * uT * (3 - 2 * uT);
	gR = uR * uR * (3 - 2 * uR);
	gB = max(0, 1 - gT - gR);
}
// A page that moves the end of the Ring envelope before the current age (a Reroll that shortens Ring mid-tail) would drop it to 0 at once: the
// envelope may fall at most as fast as its own decay plus 1 / fade length per sample (a full-scale drop takes about 20 ms); a normal tail is untouched.
envT = envV;
envDrop = envLast * (1 - dkN) + 1 / max(fdN, 1);
envV = max(envT, envLast - envDrop);
envLast = envV;
age = min(agN + 1, 1000000000);
envRec = erN;

// ---- life of the effect tails: they run from the apply sample until the Ring envelope has faded to exact 0 ----
fft_init(dvTab);
lifeNow = (agN < esN + fdN || envV > 0.000001) ? 1 : 0;
lifeOld = lifePrev;
lifePrev = lifeNow;
startWipe = (lifeOld > 0.5 && lifeNow < 0.5) ? 1 : 0;

// ---- skip / wake bookkeeping: an effect that stops running is cleared (small states at once, rings in 192 slices, 1 per sample), and an effect that
// wakes before its ring is clean finishes the clear first, so a re-enabled effect never replays old residue and a new life never meets a half-wiped ring ----
lifeRun = (lifeNow > 0.5 && asleep < 0.5) ? 1 : 0;
tEndE = 96 + (wtN * ((modeN > 0.5) ? 3 : 1) + 14) * 0.001 * sr;
tRun = (lifeRun > 0.5 && agN < tEndE) ? 1 : 0;
fa = (tRun > 0.5 && peek(dvQ, 0) > 0.02) ? 1 : 0;
fp = peek(dvAc, 0);
if (fa < 0.5 && fp > 0.5) {
	dv_wipe(stSnap, 0, 4, 4, 0);
}
poke(dvAc, fa, 0);
fa = (tRun > 0.5 && peek(dvQ, 8) > 0.02) ? 1 : 0;
fp = peek(dvAc, 1);
if (fa < 0.5 && fp > 0.5) {
	dv_wipe(stDrv, 0, 8, 8, 0);
}
poke(dvAc, fa, 1);
fa = (tRun > 0.5 && peek(dvQ, 12) > 0.02) ? 1 : 0;
fp = peek(dvAc, 2);
if (fa < 0.5 && fp > 0.5) {
	dv_wipe(stCrs, 0, 8, 8, 0);
}
poke(dvAc, fa, 2);
fa = (tRun > 0.5 && peek(dvQ, 16) > 0.02) ? 1 : 0;
fp = peek(dvAc, 3);
if (fa < 0.5 && fp > 0.5) {
	dv_wipe(stFlt, 0, 8, 8, 0);
	poke(stFlt, 2, 0);
}
poke(dvAc, fa, 3);
fa = (lifeRun > 0.5 && peek(dvQ, 20) > 0.02) ? 1 : 0;
fp = peek(dvAc, 4);
if (fa < 0.5 && fp > 0.5) {
	dv_wipe(stRes, 0, 48, 48, 0);
}
poke(dvAc, fa, 4);
fa = (lifeRun > 0.5 && peek(dvQ, 28) > 0.02) ? 1 : 0;
fp = peek(dvAc, 6);
if (fa < 0.5 && fp > 0.5) {
	dv_wipe(stFrm, 0, 16, 16, 0);
}
poke(dvAc, fa, 6);
fa = (lifeRun > 0.5 && peek(dvQ, 32) > 0.02) ? 1 : 0;
fp = peek(dvAc, 7);
if (fa < 0.5 && fp > 0.5) {
	dv_wipe(stPha, 0, 24, 24, 0);
}
poke(dvAc, fa, 7);
fa = (lifeRun > 0.5 && peek(dvQ, 44) > 0.02) ? 1 : 0;
fp = peek(dvAc, 9);
if (fa < 0.5 && fp > 0.5) {
	dv_wipe(stRng, 0, 4, 4, 0);
}
poke(dvAc, fa, 9);
// ring effects: small state at once, ring started (dvRj = next slice)
fa = (lifeRun > 0.5 && peek(dvQ, 24) > 0.02) ? 1 : 0;
fp = peek(dvAc, 5);
if (fa < 0.5 && fp > 0.5) {
	dv_wipe(stCmb, 0, 8, 8, 0);
	poke(dvRj, 0, 0);
}
poke(dvAc, fa, 5);
rs0 = (fa > 0.5 && fp < 0.5) ? 1 : 0;
fa = (lifeRun > 0.5 && peek(dvQ, 40) > 0.02) ? 1 : 0;
fp = peek(dvAc, 8);
if (fa < 0.5 && fp > 0.5) {
	dv_wipe(stGrn, 0, 16, 16, 0);
	poke(dvRj, 0, 1);
}
poke(dvAc, fa, 8);
rs1 = (fa > 0.5 && fp < 0.5) ? 1 : 0;
fa = (lifeRun > 0.5 && peek(dvQ, 48) > 0.02) ? 1 : 0;
fp = peek(dvAc, 10);
if (fa < 0.5 && fp > 0.5) {
	dv_wipe(stChr, 0, 4, 4, 0);
	poke(dvRj, 0, 2);
}
poke(dvAc, fa, 10);
rs2 = (fa > 0.5 && fp < 0.5) ? 1 : 0;
fa = (lifeRun > 0.5 && peek(dvQ, 52) > 0.02) ? 1 : 0;
fp = peek(dvAc, 11);
if (fa < 0.5 && fp > 0.5) {
	dv_wipe(stRev, 0, 16, 16, 0);
	poke(dvRj, 0, 3);
}
poke(dvAc, fa, 11);
rs3 = (fa > 0.5 && fp < 0.5) ? 1 : 0;
fa = (lifeRun > 0.5 && peek(dvQ, 56) > 0.02) ? 1 : 0;
fp = peek(dvAc, 12);
if (fa < 0.5 && fp > 0.5) {
	dv_wipe(stDly, 0, 8, 8, 0);
	poke(dvRj, 0, 4);
}
poke(dvAc, fa, 12);
rs4 = (fa > 0.5 && fp < 0.5) ? 1 : 0;
fa = (lifeRun > 0.5 && peek(dvQ, 61) > 0.02) ? 1 : 0;
fp = peek(dvAc, 13);
if (fa < 0.5 && fp > 0.5) {
	dv_wipe(stSlp, 0, 8, 8, 0);
	poke(dvRj, 0, 5);
}
poke(dvAc, fa, 13);
rs5 = (fa > 0.5 && fp < 0.5) ? 1 : 0;
fa = (lifeRun > 0.5 && peek(dvQ, 76) > 0.02) ? 1 : 0;
fp = peek(dvAc, 14);
if (fa < 0.5 && fp > 0.5) {
	dv_wipe(stZap, 0, 8, 8, 0);
}
poke(dvAc, fa, 14);
fa = (lifeRun > 0.5 && peek(dvQ, 87) > 0.02) ? 1 : 0;
fp = peek(dvAc, 15);
if (fa < 0.5 && fp > 0.5) {
	dv_wipe(dvSin, 0, 512, 512, 0);
	dv_wipe(dvSacc, 0, 1024, 1024, 1);
	dv_wipe(dvSmg, 0, 257, 257, 0);
	dv_wipe(dvSph, 0, 257, 257, 0);
	poke(dvSst, 0, 1);
	poke(dvSst, 0, 9);
}
poke(dvAc, fa, 15);
// ring slices (a ring's slice is 1/192 of it; an effect that wakes finishes what is left first)
jr = peek(dvRj, 0);
nI = 0;
if (jr > -0.5) {
	nI = (rs0 > 0.5) ? 192 - jr : 1;
}
for (wk = 0; wk < nI; wk += 1) {
	dv_wipe(rbCmb, jr + wk, 48, 8192, 0);
}
jr = (jr < -0.5 || jr + nI >= 192) ? -1 : jr + nI;
poke(dvRj, jr, 0);
wbs = (jr > -0.5) ? 1 : 0;
jr = peek(dvRj, 1);
nI = 0;
if (jr > -0.5) {
	nI = (rs1 > 0.5) ? 192 - jr : 1;
}
for (wk = 0; wk < nI; wk += 1) {
	dv_wipe(rbGrn, jr + wk, 88, 16384, 1);
}
jr = (jr < -0.5 || jr + nI >= 192) ? -1 : jr + nI;
poke(dvRj, jr, 1);
wbs += (jr > -0.5) ? 1 : 0;
jr = peek(dvRj, 2);
nI = 0;
if (jr > -0.5) {
	nI = (rs2 > 0.5) ? 192 - jr : 1;
}
for (wk = 0; wk < nI; wk += 1) {
	dv_wipe(rbChr, jr + wk, 48, 8192, 1);
}
jr = (jr < -0.5 || jr + nI >= 192) ? -1 : jr + nI;
poke(dvRj, jr, 2);
wbs += (jr > -0.5) ? 1 : 0;
jr = peek(dvRj, 3);
nI = 0;
if (jr > -0.5) {
	nI = (rs3 > 0.5) ? 192 - jr : 1;
}
for (wk = 0; wk < nI; wk += 1) {
	dv_wipe(rbRev, jr + wk, 344, 65536, 0);
}
jr = (jr < -0.5 || jr + nI >= 192) ? -1 : jr + nI;
poke(dvRj, jr, 3);
wbs += (jr > -0.5) ? 1 : 0;
jr = peek(dvRj, 4);
nI = 0;
if (jr > -0.5) {
	nI = (rs4 > 0.5) ? 192 - jr : 1;
}
for (wk = 0; wk < nI; wk += 1) {
	dv_wipe(rbDly, jr + wk, 344, 65536, 1);
}
jr = (jr < -0.5 || jr + nI >= 192) ? -1 : jr + nI;
poke(dvRj, jr, 4);
wbs += (jr > -0.5) ? 1 : 0;
jr = peek(dvRj, 5);
nI = 0;
if (jr > -0.5) {
	nI = (rs5 > 0.5) ? 192 - jr : 1;
}
for (wk = 0; wk < nI; wk += 1) {
	dv_wipe(rbSlp, jr + wk, 344, 65536, 0);
}
jr = (jr < -0.5 || jr + nI >= 192) ? -1 : jr + nI;
poke(dvRj, jr, 5);
wbs += (jr > -0.5) ? 1 : 0;
wipeBusy = (wbs > 0.5) ? 1 : 0;

// ---- the convolver's stream. Its tap is the input delayed to match the other sends (undelayed in Envelope mode, 1023 in Spectral), and the stream starts 256
// samples before the page applies (the convolver's own latency), so the whole hit, including the pre-roll the detector needed, goes in and the output
// of its first sample lands exactly on the first sample of the delayed dry. It starts when the hit is detected (Envelope: the 96 samples before it come
// from the tap history) or 256 samples before the apply (Spectral); a stream that was wiped meanwhile starts again the same way. ----
tapL = in1;
tapR = in2;
if (modeN > 0.5) {
	tapL = dlyL.read(1023);
	tapR = dlyR.read(1023);
}
cvA = cvArm;
cvNc = cvN;
if (startWipe > 0.5) {
	if (cvA > 0.5) {
		dv_wipe(dvCvr, 0, 8192, 8192, 1);
		dv_wipe(dvOtr, 0, 8192, 8192, 1);
		dv_wipe(dvOhr, 0, 512, 512, 1);
		for (i = 0; i < 32; i += 1) {
			poke(dvTgH, 0, i, 0);
			poke(dvTgH, 0, i, 1);
			poke(dvTgH, 0, i, 2);
		}
		for (i = 0; i < 48; i += 1) {
			poke(dvTgT, 0, i, 0);
			poke(dvTgT, 0, i, 1);
			poke(dvTgT, 0, i, 2);
		}
	}
	cvA = 0;
	cvNc = 0;
}
hpN = hsP;
if (cvWN > 0.5 && cvA < 0.5 && pa > 0.5 && pa < 256.5) {
	kk = min(256 - pa, 128);
	for (i = 0; i < kk; i += 1) {
		hix = hpN - kk + i + 256;
		hix = hix - 256 * floor(hix / 256);
		hpL = peek(dvHs, hix, 0);
		hpR = peek(dvHs, hix, 1);
		poke(dvCvr, hpL, 8192 - kk + i, 0);
		poke(dvCvr, hpR, 8192 - kk + i, 1);
	}
	cvA = 1;
	cvNc = 0;
}
cvOL = 0;
cvOR = 0;
sgC = (pa > 0.5) ? 1 : clip(1 - (agN - 0.2 * sr) / (0.02 * sr), 0, 1);
if (asleep < 0.5 && cvA > 0.5) {
	cn0 = cvNc;
	dvc_tick(cn0, tapL * sgC, tapR * sgC, dvTab, dvCvr, dvCxh, dvCxt, dvFdh, dvFdt, dvOhr, dvOtr, ir, dvCp, dvTgH, dvTgT, dvAch, dvCout);
	cvNc = wrap(cn0 + 1, 0, 4194304);
	cvOL = peek(dvCout, 0);
	cvOR = peek(dvCout, 1);
}
cvArm = cvA;
cvN = cvNc;
poke(dvHs, tapL, hpN, 0);
poke(dvHs, tapR, hpN, 1);
hsP = (hpN + 1 >= 256) ? 0 : hpN + 1;

// ---- modulated copies of the grain shifter (pitch bend), ring modulator (Hz sweep), formant (vowel sweep), resonator (kind, strike drop)
// parameters and the zap's cutoff, made every 16th sample (and at a page) from the time since the hit reached the output ----
dpT = drPT;
dpB = drPB;
dpR = drPR;
m16 = wrap(md16 + 1, 0, 16);
md16 = m16;
if (lifeRun > 0.5 && (m16 < 0.5 || applyNow > 0.5)) {
	tsec = max(agN - 96, 0) / sr;
	q41 = peek(dvQ, 41);
	q81 = peek(dvQ, 81);
	q82 = max(peek(dvQ, 82), 1);
	q42 = peek(dvQ, 42);
	q43 = peek(dvQ, 43);
	// LFO from the hit (pv 90 Hz, 91 depth, 92 shape, 93 target): sine, triangle (starts at 0), square, sample & hold; only the chosen target receives it
	lfp = peek(dvQ, 90) * tsec;
	lfq = lfp - floor(lfp);
	lfi = floor(lfp);
	lfh = gl_hash(lfi, 3.3);
	lfs = sin(6.283185307179586 * lfp);
	lft = (lfq < 0.25) ? 4 * lfq : ((lfq < 0.75) ? 2 - 4 * lfq : 4 * lfq - 4);
	lfr = (lfq < 0.5) ? 1 : -1;
	lfv = peek(dvQ, 92);
	lfx = (lfv < 0.5) ? lfs : ((lfv < 1.5) ? lft : ((lfv < 2.5) ? lfr : lfh * 2 - 1));
	lfw = peek(dvQ, 91) * lfx;
	lfg = peek(dvQ, 93);
	lfwZ = (lfg < 0.5) ? lfw : 0;
	lfwG = (lfg > 0.5 && lfg < 1.5) ? lfw : 0;
	lfwV = (lfg > 1.5 && lfg < 2.5) ? lfw : 0;
	lfwR = (lfg > 2.5 && lfg < 3.5) ? lfw : 0;
	lfwO = (lfg > 3.5) ? lfw : 0;
	poke(dvGp, q41 + q81 * exp(-tsec * 1000 / q82) + 7 * lfwG, 1);
	poke(dvGp, q42, 2);
	poke(dvGp, q43, 3);
	q46 = peek(dvQ, 46);
	q83 = peek(dvQ, 83);
	poke(dvRgp, clip(q46 * pow(2, q83 * tsec) * pow(2, 1.5 * lfwR), 1, sr * 0.45), 2);
	vw = peek(dvQ, 29) + peek(dvQ, 84) * tsec + 2 * lfwV;
	vp = vw - 8 * floor(vw / 8);
	q30 = peek(dvQ, 30);
	q31 = peek(dvQ, 31);
	poke(dvFp, clip(vp < 4 ? vp : 8 - vp, 0, 4), 1);
	poke(dvFp, q30, 2);
	poke(dvFp, q31, 3);
	q21 = peek(dvQ, 21);
	q86 = peek(dvQ, 86);
	q22 = peek(dvQ, 22);
	q23 = peek(dvQ, 23);
	q85 = peek(dvQ, 85);
	poke(dvRsp, q21 * (1 + q86 * exp(-tsec / 0.06)) * pow(2, lfwO), 1);
	poke(dvRsp, q22, 2);
	poke(dvRsp, q23, 3);
	poke(dvRsp, q85, 4);
	zf0 = max(peek(dvQ, 77), 20);
	zf1 = max(peek(dvQ, 78), 20);
	zu = min(tsec * 1000 / max(peek(dvQ, 79), 1), 1);
	poke(dvRsp, zf0 * pow(zf1 / zf0, zu) * pow(2, 2 * lfwZ), 5);
	// remaining-dry products of each chain's serial effects (an effect below its 0.02 skip threshold counts 0; wet w blends as (1 - w) x + w fx; snap and click add, the sat's blend is clip(1.5 q))
	zqA = peek(dvQ, 8);
	zqB = peek(dvQ, 12);
	zqC = peek(dvQ, 16);
	dpT = (1 - (zqA > 0.02 ? zqA : 0)) * (1 - (zqB > 0.02 ? zqB : 0)) * (1 - (zqC > 0.02 ? zqC : 0));
	zqA = peek(dvQ, 24);
	zqB = peek(dvQ, 28);
	zqC = peek(dvQ, 76);
	zqD = peek(dvQ, 32);
	zqE = peek(dvQ, 40);
	zqF = peek(dvQ, 44);
	zqG = peek(dvQ, 47);
	dpB = (1 - (zqA > 0.02 ? zqA : 0)) * (1 - (zqB > 0.02 ? zqB : 0)) * (1 - (zqC > 0.02 ? zqC : 0)) * (1 - (zqD > 0.02 ? zqD : 0)) * (1 - (zqE > 0.02 ? zqE : 0)) * (1 - (zqF > 0.02 ? zqF : 0)) * (1 - (zqG > 0.02 ? clip(zqG * 1.5, 0, 1) : 0));
	zqA = peek(dvQ, 48);
	dpR = 1 - (zqA > 0.02 ? zqA : 0);
	drPT = dpT;
	drPB = dpB;
	drPR = dpR;
}

// ---- tape: varispeed / tape stop / stutter of the whole delayed dry (its ring is written every awake sample; a hit restarts its head) ----
rTpL = 0;
rTpR = 0;
if (asleep < 0.5) {
	qTp = peek(dvQ, 67);
	tpA = (lifeRun > 0.5 && qTp > 0.02) ? 1 : 0;
	poke(dvIoP, xdL, 0);
	poke(dvIoP, xdR, 1);
	rvT = peek(dvQ, 94);
	dv_tape(dvIoP, dvQ, 67, stTap, rbTap, sr, tpA, ageReset, rvT);
	if (tpA > 0.5) {
		tpL = peek(dvIoP, 0);
		tpR = peek(dvIoP, 1);
		rTpL = qTp * (tpL - xdL);
		rTpR = qTp * (tpR - xdR);
	}
}
gsN = gtS;

// ---- the chains (T transient, B body, L long tail + sends); every one returns residue  fx(in) - in  ----
resL = 0;
resR = 0;
pkTv = 0;
pkBv = 0;
pkLv = 0;
ckN = ckTN;
if (asleep < 0.5 && lifeNow > 0.5) {
	tkW = (modeN > 0.5) ? 3 : 1;
	twMs = max(agN - 96, 0) * 1000 / sr;
	gTs = gT;
	if (modeN > 0.5) {
		uT3 = clip(twMs / max(wtN * 3, 1), 0, 1);
		gTs = 1 - uT3 * uT3 * (3 - 2 * uT3);
	}
	srcTL = xdL;
	srcTR = xdR;
	srcBL = xdL;
	srcBR = xdR;
	if (modeN > 0.5) {
		srcTL = in3;
		srcTR = in4;
		srcBL = xdL - in3;
		srcBR = xdR - in4;
	}
	xTL = gTs * srcTL;
	xTR = gTs * srcTR;
	xBL = gB * srcBL;
	xBR = gB * srcBR;
	xRL = gR * srcBL;
	xRR = gR * srcBR;
	sgS = clip(1 - (agN - clsN) / (0.02 * sr), 0, 1);
	sndL = xdL * sgS;
	sndR = xdR * sgS;

	// ---- T: snap > drive > click > crush > filter ----
	rTL = 0;
	rTR = 0;
	tEnd = 96 + (wtN * tkW + 14) * 0.001 * sr;
	if (agN < tEnd) {
		poke(dvIoT, xTL, 0);
		poke(dvIoT, xTR, 1);
		qSn = peek(dvQ, 0);
		if (qSn > 0.02) {
			dv_snap(dvIoT, qSn, stSnap, sr);
		}
		qDr = peek(dvQ, 8);
		if (qDr > 0.02) {
			gl_drive(dvIoT, dvQ, 8, qDr, stDrv, sr);
		}
		qCk = peek(dvQ, 1);
		if (qCk > 0.01 && ckN >= 0 && ckN < 0.012 * sr) {
			qCh = peek(dvQ, 2);
			dv_click(dvIoT, qCk, qCh, clkAmp, ckN, sr);
		}
		qCr = peek(dvQ, 12);
		if (qCr > 0.02) {
			gl_crush(dvIoT, dvQ, 12, qCr, stCrs, sr);
		}
		qFl = peek(dvQ, 16);
		if (qFl > 0.02) {
			gl_filter(dvIoT, dvQ, 16, qFl, stFlt, sr);
		}
		oTL = peek(dvIoT, 0);
		oTR = peek(dvIoT, 1);
		rTL = dv_wsoft(oTL - xTL);
		rTR = dv_wsoft(oTR - xTR);
	}

	// ---- B: comb > formant > phaser > pitch > ring modulator > saturation; the resonator bank rings beside it, excited by the whole hit (T + B windows) ----
	rBL = 0;
	rBR = 0;
	rsL = 0;
	rsR = 0;
	qRs = peek(dvQ, 20);
	if (qRs > 0.02) {
		xqL = (1 - gR) * xdL;
		xqR = (1 - gR) * xdR;
		poke(dvIoQ, xqL, 0);
		poke(dvIoQ, xqR, 1);
		dv_res(dvIoQ, dvRsp, 0, qRs, stRes, sr);
		oQL = peek(dvIoQ, 0);
		oQR = peek(dvIoQ, 1);
		rsL = oQL - xqL;
		rsR = oQR - xqR;
	}
	poke(dvIoB, xBL, 0);
	poke(dvIoB, xBR, 1);
	qCb = peek(dvQ, 24);
	if (qCb > 0.02) {
		gl_comb(dvIoB, dvQ, 24, qCb, stCmb, rbCmb, sr);
	}
	qFm = peek(dvQ, 28);
	if (qFm > 0.02) {
		gl_form(dvIoB, dvFp, 0, qFm, stFrm, sr);
	}
	qZp = peek(dvQ, 76);
	if (qZp > 0.02) {
		zpF = peek(dvRsp, 5);
		zpR = peek(dvQ, 80);
		dv_zap(dvIoB, zpF, zpR, qZp, stZap, sr);
	}
	qPh = peek(dvQ, 32);
	if (qPh > 0.02) {
		dv_phas(dvIoB, dvQ, 32, qPh, stPha, sr);
	}
	qGr = peek(dvQ, 40);
	if (qGr > 0.02) {
		dv_grain(dvIoB, dvGp, 0, qGr, stGrn, rbGrn, sr, 1);
	}
	qRg = peek(dvQ, 44);
	if (qRg > 0.02) {
		dv_ring(dvIoB, dvRgp, 0, qRg, stRng, sr);
	}
	qSt = peek(dvQ, 47);
	if (qSt > 0.02) {
		sG = 1 + 4 * qSt;
		sW = clip(qSt * 1.5, 0, 1);
		sbL = peek(dvIoB, 0);
		sbR = peek(dvIoB, 1);
		syL = tanh(sG * sbL) / (1 + 0.7 * (sG - 1));
		syR = tanh(sG * sbR) / (1 + 0.7 * (sG - 1));
		poke(dvIoB, sbL + (syL - sbL) * sW, 0);
		poke(dvIoB, sbR + (syR - sbR) * sW, 1);
	}
	oBL = peek(dvIoB, 0);
	oBR = peek(dvIoB, 1);
	rBL = dv_wsoft(oBL - xBL);
	rBR = dv_wsoft(oBR - xBR);

	// ---- L: chorus / flanger on the late part ----
	rRL = 0;
	rRR = 0;
	qCo = peek(dvQ, 48);
	if (qCo > 0.02) {
		poke(dvIoR, xRL, 0);
		poke(dvIoR, xRR, 1);
		dv_chor(dvIoR, dvQ, 48, qCo, stChr, rbChr, sr);
		oRL = peek(dvIoR, 0);
		oRR = peek(dvIoR, 1);
		rRL = dv_wsoft(oRL - xRL);
		rRR = dv_wsoft(oRR - xRR);
	}

	// ---- sends: reverb, delay, slap, convolver (their input closes 200 ms after the hit) ----
	sdL = 0;
	sdR = 0;
	qRv = peek(dvQ, 52);
	if (qRv > 0.02) {
		poke(dvIoV, sndL, 0);
		poke(dvIoV, sndR, 1);
		dv_rev(dvIoV, dvQ, 52, qRv, stRev, rbRev, sr);
		vL = peek(dvIoV, 0);
		vR = peek(dvIoV, 1);
		sdL += vL - sndL;
		sdR += vR - sndR;
	}
	qDl = peek(dvQ, 56);
	if (qDl > 0.02) {
		poke(dvIoD, sndL, 0);
		poke(dvIoD, sndR, 1);
		dv_dly(dvIoD, dvQ, 56, qDl, stDly, rbDly, sr);
		dL = peek(dvIoD, 0);
		dR = peek(dvIoD, 1);
		sdL += dL - sndL;
		sdR += dR - sndR;
	}
	qSl = peek(dvQ, 61);
	if (qSl > 0.02) {
		poke(dvIoS, sndL, 0);
		poke(dvIoS, sndR, 1);
		gl_slap(dvIoS, dvQ, 61, qSl, stSlp, rbSlp, sr);
		lpL = peek(dvIoS, 0);
		lpR = peek(dvIoS, 1);
		sdL += lpL - sndL;
		sdR += lpR - sndR;
	}
	qCv = peek(dvQ, 65);
	sdL += 0.7 * qCv * cvOL;
	sdR += 0.7 * qCv * cvOR;
	// spectral send: 512-point STFT, one job per sample, 640 samples late (dv_specjob)
	qSp = peek(dvQ, 87);
	if (qSp > 0.02) {
		sw0 = peek(dvSst, 0);
		poke(dvSin, 0.5 * (sndL + sndR), sw0);
		sw0 = sw0 + 1;
		poke(dvSst, sw0 >= 512 ? 0 : sw0, 0);
		so0 = peek(dvSst, 4);
		spL = peek(dvSacc, so0, 0);
		spR = peek(dvSacc, so0, 1);
		poke(dvSacc, 0, so0, 0);
		poke(dvSacc, 0, so0, 1);
		so0 = so0 + 1;
		poke(dvSst, so0 >= 1024 ? 0 : so0, 4);
		sjb = peek(dvSst, 1);
		spOp = peek(dvQ, 88);
		spAm = peek(dvQ, 89);
		dv_specjob(sjb, dvSx, dvSy, dvTab, dvSin, dvSacc, dvSw, dvSmg, dvSph, dvSst, spOp, spAm);
		sjb = sjb + 1;
		poke(dvSst, sjb >= 128 ? 0 : sjb, 1);
		sdL += 0.9 * qSp * spL;
		sdR += 0.9 * qSp * spR;
	}

	// ---- the sum: T un-enveloped (its own window), everything else under the Ring envelope ----
	wtL = rTL + envV * (rBL + rsL + rRL + sdL + rTpL);
	wtR = rTR + envV * (rBR + rsR + rRR + sdR + rTpR);
	resL = dv_wsoft(wtL);
	resR = dv_wsoft(wtR);
	// gate: chops the whole output (dry included) in a square of gate Hz and duty, from the hit, faded out with the Ring envelope
	qGt = peek(dvQ, 73);
	gsq = 1;
	if (qGt > 0.02) {
		gph = twMs * 0.001 * peek(dvQ, 74);
		gsq = (gph - floor(gph) < peek(dvQ, 75)) ? 1 : 0;
	}
	gsN = gsN + (gsq - gsN) * min(1, 1000 / sr);
	gtE = 1 - qGt * envV * (1 - gsN);
	// dry replacement (pv 95): part of the dry is taken away while the Ring envelope runs, least inside the transient window
	// only the dry the effects have not already replaced is taken away: D = (1 - tape) x (gT PT + gB PB + gR PR)
	dkD = (1 - peek(dvQ, 67)) * (gTs * dpT + gB * dpB + gR * dpR);
	dkE = peek(dvQ, 95) * envV * dkD * (1 - 0.5 * gTs);
	resL = resL * gtE - xdL * (1 - gtE * (1 - dkE));
	resR = resR * gtE - xdR * (1 - gtE * (1 - dkE));
	pkTv = max(abs(xTL), abs(xTR));
	pkBv = max(max(abs(xBL), abs(xBR)), max(abs(rsL), abs(rsR)));
	pkLv = envV * max(max(abs(xRL), abs(xRR)), max(abs(sndL), abs(sndR)));
}
gtS = gsN;
clkT = (ckN < 1000000000) ? ckN + 1 : ckN;

// Mix: the smoother snaps onto its target (Mix 0 is exactly 0, not a decaying tail), the limiters and fixnan act on the residue only, and at Mix 0 the
// output is the delayed dry itself (no soft limit above |x| 2, no sleep zeroing, a bad residue cannot touch it).
wsmT = clip(dvwet, 0, 1);
wsmO = (first > 0.5) ? wsmT : wsm;
wsmN = wsmO + (wsmT - wsmO) * 0.002;
wsmN = (abs(wsmN - wsmT) < 0.0000001) ? wsmT : wsmN;
wsm = wsmN;
resL = fixnan(resL);
resR = fixnan(resR);
sumL = xdL + wsmN * resL;
sumR = xdR + wsmN * resR;
limSL = dv_soft(sumL);
limSR = dv_soft(sumR);
limL = (wsmN > 0) ? limSL : xdL;
limR = (wsmN > 0) ? limSR : xdR;
o1 = fixnan(limL * sgN);
o2 = fixnan(limR * sgN);

// ---- per-sample telemetry work (awake only) ----
pkInN = pkIn;
pkFastN = pkFast;
pkTN = pkT;
pkBN = pkB;
pkLN = pkL;
pkOutN = pkOut;
pkDryN = pkDry;
whN = waveHead;
shN = specHead;
if (asleep < 0.5) {
	pkInN = max(pkIn, inPk);
	pkFastN = max(pkFast, fastN);
	pkTN = max(pkT, pkTv);
	pkBN = max(pkB, pkBv);
	pkLN = max(pkL, pkLv);
	pkOutN = max(pkOut, max(abs(o1), abs(o2)));
	pkDryN = max(pkDry, xdPk);
	outM = (o1 + o2) * 0.5;
	bc0 = blkC;
	bimin = (bc0 < 0.5) ? inMono : min(blkInMin, inMono);
	bimax = (bc0 < 0.5) ? inMono : max(blkInMax, inMono);
	bomin = (bc0 < 0.5) ? outM : min(blkOutMin, outM);
	bomax = (bc0 < 0.5) ? outM : max(blkOutMax, outM);
	bcN = bc0 + 1;
	if (bcN >= 512) {
		bcN = 0;
		wb = 256 + whN * 5;
		poke(scope, clip(bimin, -1.5, 1.5), wb + 0, 0);
		poke(scope, clip(bimax, -1.5, 1.5), wb + 1, 0);
		poke(scope, clip(bomin, -1.5, 1.5), wb + 2, 0);
		poke(scope, clip(bomax, -1.5, 1.5), wb + 3, 0);
		poke(scope, bfl, wb + 4, 0);
		bfl = 0;
		whN = wrap(whN + 1, 0, 256);
		poke(scope, whN, 41, 0);
	}
	blkC = bcN;
	blkInMin = bimin;
	blkInMax = bimax;
	blkOutMin = bomin;
	blkOutMax = bomax;
	if (specOn > 0.5) {
		poke(spec, inMono, shN, 0);
		poke(spec, gT * xdM, shN, 1);
		poke(spec, gB * xdM, shN, 2);
		poke(spec, gR * xdM * envV, shN, 3);
		poke(spec, outM, shN, 4);
		shN = wrap(shN + 1, 0, 2048);
	}
}
blkFlag = bfl;
waveHead = whN;
specHead = shN;

// ---- telemetry tick (every 64 samples; ALIVE / FRAMES / ASLEEP also when asleep) ----
tcN = wrap(tickC + 1, 0, 64);
tickC = tcN;
tickKeep = 1;
if (tcN < 0.5) {
	alN = wrap(alive + 1, 0, 100000);
	frN = wrap(frames + 1, 0, 100000);
	alive = alN;
	frames = frN;
	poke(scope, frN, 0, 0);
	poke(scope, alN, 48, 0);
	poke(scope, asleep, 7, 0);
	if (asleep < 0.5) {
		tickKeep = 0;
		specOn = (dim(spec) >= 2048) ? 1 : 0;
		stSer = peek(dvST, 3);
		stRer = peek(dvST, 2);
		stGate = peek(dvST, 4);
		onsetMs = (oa < 0) ? -1 : oa * 1000 / sr;
		poke(scope, sr, 1, 0);
		poke(scope, hcN, 2, 0);
		poke(scope, stSer, 3, 0);
		poke(scope, onsetMs, 4, 0);
		poke(scope, modeN, 5, 0);
		poke(scope, latN, 6, 0);
		poke(scope, stRer, 8, 0);
		poke(scope, trN, 9, 0);
		poke(scope, envV, 10, 0);
		poke(scope, irN, 11, 0);
		poke(scope, pkFastN, 12, 0);
		poke(scope, slowN, 13, 0);
		poke(scope, thrN, 14, 0);
		poke(scope, mtN, 15, 0);
		for (i = 0; i < 8; i += 1) {
			me = peek(dvE, i);
			mt = peek(dvT, i);
			poke(scope, me, 16 + i, 0);
			poke(scope, mt, 24 + i, 0);
		}
		poke(scope, pkInN, 32, 0);
		poke(scope, pkTN, 33, 0);
		poke(scope, pkBN, 34, 0);
		poke(scope, pkLN, 35, 0);
		poke(scope, pkOutN, 36, 0);
		poke(scope, pkDryN, 37, 0);
		poke(scope, pcN, 38, 0);
		poke(scope, stGate, 39, 0);
		poke(scope, hsN, 40, 0);
		poke(scope, whN, 41, 0);
		poke(scope, shN, 42, 0);
		// ECHO block (128..159): what this gen runs with
		poke(scope, dvv0, 128, 0);
		poke(scope, dvv1, 129, 0);
		poke(scope, dvv2, 130, 0);
		poke(scope, dvv3, 131, 0);
		poke(scope, dvv4, 132, 0);
		poke(scope, dvv5, 133, 0);
		poke(scope, dvv6, 134, 0);
		poke(scope, dvv7, 135, 0);
		poke(scope, dvr0, 136, 0);
		poke(scope, dvr1, 137, 0);
		poke(scope, dvr2, 138, 0);
		poke(scope, dvr3, 139, 0);
		poke(scope, dvr4, 140, 0);
		poke(scope, dvr5, 141, 0);
		poke(scope, dvr6, 142, 0);
		poke(scope, dvr7, 143, 0);
		lockMask = (dvl0 > 0.5 ? 1 : 0) + (dvl1 > 0.5 ? 2 : 0) + (dvl2 > 0.5 ? 4 : 0) + (dvl3 > 0.5 ? 8 : 0) + (dvl4 > 0.5 ? 16 : 0) + (dvl5 > 0.5 ? 32 : 0) + (dvl6 > 0.5 ? 64 : 0) + (dvl7 > 0.5 ? 128 : 0);
		poke(scope, lockMask, 144, 0);
		poke(scope, dvsens, 145, 0);
		poke(scope, dvthr, 146, 0);
		poke(scope, dvchance, 147, 0);
		poke(scope, dvwet, 148, 0);
		poke(scope, dvseed, 149, 0);
		poke(scope, dvdrift, 150, 0);
		poke(scope, dvsplit, 151, 0);
		poke(scope, dvreroll, 152, 0);
		poke(scope, lcN, 153, 0);
		// the hidden values and the IR tag are repeated every 16th tick (a scope buffer bound after the page was applied)
		hdN = wrap(hidC + 1, 0, 16);
		hidC = hdN;
		if (hdN < 0.5) {
			for (i = 0; i < 64; i += 1) {
				hvr = peek(dvHV, i);
				poke(scope, hvr, 64 + i, 0);
			}
			for (i = 0; i < 8; i += 1) {
				hvr2 = peek(dvHV, 64 + i);
				poke(scope, hvr2, 160 + i, 0);
			}
		}
	}
}
// peaks restart after a write (a tick that wrote them), otherwise they keep accumulating
pkIn = (tickKeep > 0.5) ? pkInN : 0;
pkFast = (tickKeep > 0.5) ? pkFastN : 0;
pkT = (tickKeep > 0.5) ? pkTN : 0;
pkB = (tickKeep > 0.5) ? pkBN : 0;
pkL = (tickKeep > 0.5) ? pkLN : 0;
pkOut = (tickKeep > 0.5) ? pkOutN : 0;
pkDry = (tickKeep > 0.5) ? pkDryN : 0;

out1 = o1;
out2 = o2;
