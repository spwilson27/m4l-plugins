// Amp+ tone stack and cabinet, after the NAM capture.
// 50 on Bass / Mid / Treble / Presence is flat. Volume 100 is unity, 0 is silence.
// Cabinet is a speaker-sized highpass, a cone lowpass and one presence peak.
// Mic and position darken or open that lowpass. Functions come before Param.

slew(target, ms, rateHz) {
	History held(0);
	History primed(0);
	coef = 1 - exp(-1 / (max(ms, 0.1) * 0.001 * rateHz));
	held = (primed == 0) ? target : held + (target - held) * coef;
	primed = 1;
	return held;
}

toneDb(knob, span) {
	return (clip(knob, 0, 100) - 50) * span;
}

volCurve(knob) {
	unit = clip(knob, 0, 100) / 100;
	amp = 0;
	amp = (unit > 0) ? pow(unit, 2.5) : 0;
	return amp;
}

// RBJ biquad. kind: 0 low shelf, 1 high shelf, 2 peak, 3 highpass, 4 lowpass.
// coef: 0 b0, 1 b1, 2 b2, 3 a1, 4 a2. Shelves use slope 1 and ignore q.
filt(kind, freq, q, db, rateHz, coef) {
	freqHz = clip(freq, 15, rateHz * 0.45);
	qq = max(q, 0.05);
	ampA = pow(10, db / 40);
	omega = 6.283185307179586 * freqHz / rateHz;
	cosW = cos(omega);
	sinW = sin(omega);
	alpha = sinW / (2 * qq);
	shelfA = sinW * 0.7071067811865476;
	rootA = sqrt(ampA);
	twoRoot = 2 * rootA * shelfA;
	aPlus = ampA + 1;
	aMinus = ampA - 1;
	b0 = 1;
	b1 = 0;
	b2 = 0;
	a0 = 1;
	a1 = 0;
	a2 = 0;
	if (kind == 0) {
		b0 = ampA * (aPlus - aMinus * cosW + twoRoot);
		b1 = 2 * ampA * (aMinus - aPlus * cosW);
		b2 = ampA * (aPlus - aMinus * cosW - twoRoot);
		a0 = aPlus + aMinus * cosW + twoRoot;
		a1 = -2 * (aMinus + aPlus * cosW);
		a2 = aPlus + aMinus * cosW - twoRoot;
	} else if (kind == 1) {
		b0 = ampA * (aPlus + aMinus * cosW + twoRoot);
		b1 = -2 * ampA * (aMinus + aPlus * cosW);
		b2 = ampA * (aPlus + aMinus * cosW - twoRoot);
		a0 = aPlus - aMinus * cosW + twoRoot;
		a1 = 2 * (aMinus - aPlus * cosW);
		a2 = aPlus - aMinus * cosW - twoRoot;
	} else if (kind == 2) {
		b0 = 1 + alpha * ampA;
		b1 = -2 * cosW;
		b2 = 1 - alpha * ampA;
		a0 = 1 + alpha / ampA;
		a1 = -2 * cosW;
		a2 = 1 - alpha / ampA;
	} else if (kind == 3) {
		b0 = (1 + cosW) * 0.5;
		b1 = -(1 + cosW);
		b2 = (1 + cosW) * 0.5;
		a0 = 1 + alpha;
		a1 = -2 * cosW;
		a2 = 1 - alpha;
	} else {
		b0 = (1 - cosW) * 0.5;
		b1 = 1 - cosW;
		b2 = (1 - cosW) * 0.5;
		a0 = 1 + alpha;
		a1 = -2 * cosW;
		a2 = 1 - alpha;
	}
	inv = 1 / max(a0, 0.000000001);
	picked = b0 * inv;
	picked = (coef == 1) ? b1 * inv : picked;
	picked = (coef == 2) ? b2 * inv : picked;
	picked = (coef == 3) ? a1 * inv : picked;
	picked = (coef == 4) ? a2 * inv : picked;
	return picked;
}

biq(x, b0, b1, b2, a1, a2) {
	History xm1(0);
	History xm2(0);
	History ym1(0);
	History ym2(0);
	y = b0 * x + b1 * xm1 + b2 * xm2 - a1 * ym1 - a2 * ym2;
	xm2 = xm1;
	xm1 = x;
	ym2 = ym1;
	ym1 = y;
	return y;
}

cabHpHz(kind, pos) {
	kk = round(clip(kind, 0, 5));
	hz = 95;
	hz = (kk == 1) ? 80 : hz;
	hz = (kk == 2) ? 70 : hz;
	hz = (kk == 3) ? 72 : hz;
	hz = (kk == 4) ? 42 : hz;
	hz = (kk == 5) ? 48 : hz;
	pp = clip(pos, 0, 1);
	return hz * (1 + 0.35 * pp);
}

cabLpHz(kind, micIdx, pos) {
	kk = round(clip(kind, 0, 5));
	hz = 5400;
	hz = (kk == 1) ? 4900 : hz;
	hz = (kk == 2) ? 5800 : hz;
	hz = (kk == 3) ? 4300 : hz;
	hz = (kk == 4) ? 3200 : hz;
	hz = (kk == 5) ? 3800 : hz;
	pp = clip(pos, 0, 1);
	micScale = (micIdx > 0.5) ? 1.25 : 0.78;
	hz = hz * micScale * (1 - 0.62 * pp);
	return max(hz, 800);
}

cabPeakHz(kind) {
	kk = round(clip(kind, 0, 5));
	hz = 2000;
	hz = (kk == 1) ? 1400 : hz;
	hz = (kk == 2) ? 2800 : hz;
	hz = (kk == 3) ? 1100 : hz;
	hz = (kk == 4) ? 700 : hz;
	hz = (kk == 5) ? 900 : hz;
	return hz;
}

cabPeakDb(kind, micIdx, pos) {
	kk = round(clip(kind, 0, 5));
	gainDb = 2.2;
	gainDb = (kk == 1) ? 2.4 : gainDb;
	gainDb = (kk == 2) ? 3.2 : gainDb;
	gainDb = (kk == 3) ? 3.6 : gainDb;
	gainDb = (kk == 4) ? 2.0 : gainDb;
	gainDb = (kk == 5) ? 2.8 : gainDb;
	pp = clip(pos, 0, 1);
	gainDb = (micIdx > 0.5) ? gainDb * 0.55 : gainDb + 2.2;
	return gainDb * (1 - 0.75 * pp);
}

cabPeakQ(kind) {
	kk = round(clip(kind, 0, 5));
	qq = 1.1;
	qq = (kk == 1) ? 0.9 : qq;
	qq = (kk == 2) ? 1.5 : qq;
	qq = (kk == 3) ? 0.85 : qq;
	qq = (kk == 4) ? 0.7 : qq;
	qq = (kk == 5) ? 0.8 : qq;
	return qq;
}

Param bass(50);
Param mid(50);
Param treble(50);
Param presence(50);
Param volume(80);
Param cab(1);
Param cabtype(1);
Param mic(0);
Param position(0);

bassSm = slew(bass, 20, samplerate);
midSm = slew(mid, 20, samplerate);
trebSm = slew(treble, 20, samplerate);
presSm = slew(presence, 20, samplerate);
volSm = slew(volume, 20, samplerate);
posSm = slew(position, 20, samplerate);
cabSm = slew((cab > 0.5) ? 1 : 0, 12, samplerate);

bassDb = toneDb(bassSm, 0.24);
midDb = toneDb(midSm, 0.24);
trebDb = toneDb(trebSm, 0.24);
presDb = toneDb(presSm, 0.16);

dry = dcblock(in1);
// Each biq() call is its own filter. A wrapper would share one History across every band.
dry = biq(dry, filt(0, 110, 0.707, bassDb, samplerate, 0), filt(0, 110, 0.707, bassDb, samplerate, 1), filt(0, 110, 0.707, bassDb, samplerate, 2), filt(0, 110, 0.707, bassDb, samplerate, 3), filt(0, 110, 0.707, bassDb, samplerate, 4));
dry = biq(dry, filt(2, 750, 0.8, midDb, samplerate, 0), filt(2, 750, 0.8, midDb, samplerate, 1), filt(2, 750, 0.8, midDb, samplerate, 2), filt(2, 750, 0.8, midDb, samplerate, 3), filt(2, 750, 0.8, midDb, samplerate, 4));
dry = biq(dry, filt(1, 2200, 0.707, trebDb, samplerate, 0), filt(1, 2200, 0.707, trebDb, samplerate, 1), filt(1, 2200, 0.707, trebDb, samplerate, 2), filt(1, 2200, 0.707, trebDb, samplerate, 3), filt(1, 2200, 0.707, trebDb, samplerate, 4));
dry = biq(dry, filt(1, 4500, 0.707, presDb, samplerate, 0), filt(1, 4500, 0.707, presDb, samplerate, 1), filt(1, 4500, 0.707, presDb, samplerate, 2), filt(1, 4500, 0.707, presDb, samplerate, 3), filt(1, 4500, 0.707, presDb, samplerate, 4));

kindIdx = round(clip(cabtype, 0, 5));
micIdx = (mic > 0.5) ? 1 : 0;
pos01 = clip(posSm, 0, 100) / 100;
hpHz = cabHpHz(kindIdx, pos01);
lpHz = cabLpHz(kindIdx, micIdx, pos01);
pkHz = cabPeakHz(kindIdx);
pkDb = cabPeakDb(kindIdx, micIdx, pos01);
pkQv = cabPeakQ(kindIdx);
wet = biq(dry, filt(3, hpHz, 0.707, 0, samplerate, 0), filt(3, hpHz, 0.707, 0, samplerate, 1), filt(3, hpHz, 0.707, 0, samplerate, 2), filt(3, hpHz, 0.707, 0, samplerate, 3), filt(3, hpHz, 0.707, 0, samplerate, 4));
wet = biq(wet, filt(4, lpHz, 0.707, 0, samplerate, 0), filt(4, lpHz, 0.707, 0, samplerate, 1), filt(4, lpHz, 0.707, 0, samplerate, 2), filt(4, lpHz, 0.707, 0, samplerate, 3), filt(4, lpHz, 0.707, 0, samplerate, 4));
wet = biq(wet, filt(2, pkHz, pkQv, pkDb, samplerate, 0), filt(2, pkHz, pkQv, pkDb, samplerate, 1), filt(2, pkHz, pkQv, pkDb, samplerate, 2), filt(2, pkHz, pkQv, pkDb, samplerate, 3), filt(2, pkHz, pkQv, pkDb, samplerate, 4));

y = dry + (wet - dry) * cabSm;
y = y * volCurve(volSm);
out1 = y;
out2 = y;
