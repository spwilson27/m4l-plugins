// Freq Split core (appended after src/cepstrum_lib.genexpr + src/spectral_split_lib.genexpr + src/spectral_split_rack.genexpr at build time, so every
// library function sits ahead of everything here; scripts/build_freqsplit.py expands the rack template src/spectral_split_rack_main.genexpr at the
// two marker lines (SS_DECL, SS_MAIN) near the end of this file). Reference of the maths: src/freqsplit_config.js (fsPattern, fsMaskAt).
//
// A spectral sorter (Bitwig Freq Split (Spectral)). The log-frequency axis 20 Hz .. 20 kHz is cut by `nsplit` (1..1024, continuous)
// splits into many regions that are dealt to four channels (1 red, 2 blue, 3 yellow, 4 magenta) in rotation. The four per-bin masks
// sum to 1 (partition of unity), so the chains of a rack sum back to the input delayed by the constant latency (5120 samples: 4096 + the host
// block margin of the rack machinery). There is NO signal analysis: the masks only depend on the parameters, the FFT size and the sample rate.
//
// ONE COMPUTATION PER RACK (src/spectral_split_rack_main.genexpr, AGENTS.md sections 22 and 26): the instance that leads a rack frames the signal,
// runs the forward FFT once, applies each served channel's mask, inverse-transforms and overlap-adds, and publishes the channel signals in its ring;
// the other chains read their channel from it (their own gen runs no FFT at all). A lone instance computes only its own channel. Mix, the dry path
// and the output stage are the template's: out = mix * wet + (1 - mix) * dry / K with K = 4 while the instance outputs one channel (the rack sums
// four chains, so the rack sum is mix * wet + (1 - mix) * dry) and K = 1 for Output All.
//
// fs_pattern  parameters -> pc Data (pattern constants): K = floor(nsplit), f = fraction, F = K + 1 full regions of weight 1 plus one
//             PARTIAL region of weight f inserted at the insertion point (High: at the end, Mid: in the middle, Low: at the start),
//             total weight T = F + f; Bend / Pinch warp constants, Spin, crossfade, Nudge (integer part a + fraction phv).
// fs_masks    pc -> per-bin masks fsd channels 0..3 (+ channel 4 = all ones, and the same values again in 5..9 = the final masks), evaluated at the
//             bin centres: axis position x (log frequency) -> inverse Bend / Pinch warp -> Spin shift with wrap -> slot of the pattern and its
//             raised-cosine crossfade with the neighbouring slot -> channel (slot base + Nudge), the fractional Nudge crossfading to the next channel.
// fs_limit    Spectral Limiter: per bin, g = min(1, thr / (mask * amp)), amp = max(|L|, |R|) amplitude of the bin; limited masks in
//             fsd channels 5..8 (per channel) and 9 (All). Only used while the limiter is on (explicit gain, breaks the sum).
//
// Data fsd(2049, 11): 0..3 raw channel masks, 4 ones, 5..8 final channel masks, 9 final All, 10 bin amplitude. The template applies row MKB + c = 5 + c.
// Data pc(32): 0 K, 1 f, 2 F, 3 T, 4 partial slot, 5 direction, 6 Lc, 7 crossfade, 8 nudge int, 9 nudge fraction, 10 spin, 11 bend
//   midpoint, 12 1 / gamma, 13 1 / pinch exponent, 14 3 - F, 15 channel base of the partial slot (Mid).
//
// Telemetry buffer (bound by the face's `scope <name>` message, resent until the deferred gen~ runs), FS_SCOPE_SAMPS floats:
//   0..127 input (Mid) level per log column, 128..639 the four channels after the masks (and the limiter), 4 x 128, all 0..1 over
//   -100..0 dB (written by the computing instance only), 640 frame counter, 641 samplerate, 642 N, 643 awake, 644 input peak, 646 latency,
//   647 output selection, 648..657 rack scalars (template: computing, following, aligned, fallback, counter offset, underruns, lag, serve mask,
//   role, alive counter), 658 limiter on.
//
// GenExpr rules: functions first, then Buffer / Data / Param / History / Delay, then statements. No identifier e<digit>, phi, pi.
// No user function call inside poke() arguments or if conditions, one return per function at function level.

// Position x (0..1) of bin k on the log axis 20 Hz .. 20 kHz (bins below 20 Hz and above 20 kHz clamp to the edges).
fs_xof(k, n, sr) {
	return clip(log(max(k * sr / n, 20) * 0.05) * 0.14476482730108395, 0, 1);
}

// Channel base (before Nudge) of slot s: High s, Low s + 3 - F, Mid lower part from the bottom, upper part from the top.
fs_base(s, dd, lc, ofs, pmd) {
	bHi = s;
	bLo = s + ofs;
	bMd = s < lc ? s : (s > lc ? s + ofs : pmd);
	b = dd < 0.5 ? bHi : (dd > 1.5 ? bLo : bMd);
	return b;
}

// Pattern constants from the parameters into pc.
fs_pattern(pc, ns, dr, xfa, nudge, spin, bend, pinch) {
	nn = clip(ns, 1, 1024);
	kk = floor(nn);
	ff = nn - kk;
	nFull = kk + 1;
	dd = clip(floor(dr + 0.5), 0, 2);
	lc = floor((nFull + 1) * 0.5);
	spp = dd < 0.5 ? nFull : (dd > 1.5 ? 0 : lc);
	nd = nudge - 4 * floor(nudge * 0.25);
	aa = floor(nd);
	mm = 0.5 + 0.4 * clip(bend, -1, 1);
	gam = log(mm) / log(0.5);
	qq = exp(clip(pinch, -1, 1) * 1.0986122886681098);
	evenF = nFull - 2 * floor(nFull * 0.5);
	pmd = evenF < 0.5 ? lc : 3 - nFull + lc;
	pc.poke(kk, 0);
	pc.poke(ff, 1);
	pc.poke(nFull, 2);
	pc.poke(nFull + ff, 3);
	pc.poke(spp, 4);
	pc.poke(dd, 5);
	pc.poke(lc, 6);
	pc.poke(clip(xfa, 0, 1), 7);
	pc.poke(aa, 8);
	pc.poke(nd - aa, 9);
	pc.poke(clip(spin, -0.5, 0.5), 10);
	pc.poke(mm, 11);
	pc.poke(1 / gam, 12);
	pc.poke(1 / qq, 13);
	pc.poke(3 - nFull, 14);
	pc.poke(pmd, 15);
	return nFull;
}

// Per-bin masks from the pattern constants (evaluated at the bin centres). Channels 0..3 + 4 (ones) are the raw masks; channels 5..9 get the same
// values here and are what the rack template applies (the FINAL masks: fs_limit overwrites them per frame while the limiter is on).
fs_masks(fsd, pc, n, sr) {
	half = n * 0.5;
	ff = pc.peek(1);
	nFull = pc.peek(2);
	tT = pc.peek(3);
	spp = pc.peek(4);
	dd = pc.peek(5);
	lc = pc.peek(6);
	xfa = pc.peek(7);
	aa = pc.peek(8);
	phv = pc.peek(9);
	spn = pc.peek(10);
	mm = pc.peek(11);
	gi = pc.peek(12);
	qi = pc.peek(13);
	ofs = pc.peek(14);
	pmd = pc.peek(15);
	for (k = 0; k <= half; k += 1) {
		x = fs_xof(k, n, sr);
		below = x < mm ? 1 : 0;
		tq = below > 0.5 ? (mm - x) / mm : (x - mm) / (1 - mm);
		t0 = pow(max(tq, 0), qi);
		wv = below > 0.5 ? mm - mm * t0 : mm + (1 - mm) * t0;
		pp = pow(max(wv, 0), gi);
		q = pp - spn;
		q = q < 0 ? q + 1 : (q > 1 ? q - 1 : q);
		t = q * tT;
		sA = floor(t);
		sB = spp + 1 + floor(t - spp - ff);
		s = t < spp ? sA : (t < spp + ff ? spp : sB);
		s = max(0, min(s, nFull));
		s = (s == spp && ff <= 0) ? s - 1 : s;
		eg = s < spp ? s : (s == spp ? spp : s + ff - 1);
		wd = s == spp ? ff : 1;
		wl = (s - 1) == spp ? ff : 1;
		wu = (s + 1) == spp ? ff : 1;
		hl = s > 0 ? xfa * 0.5 * min(wl, wd) : 0;
		hu = s < nFull ? xfa * 0.5 * min(wd, wu) : 0;
		dl = t - eg;
		du = eg + wd - t;
		inl = dl < hl ? 1 : 0;
		inu = (inl < 0.5 && du < hu) ? 1 : 0;
		nb = inl > 0.5 ? s - 1 : (inu > 0.5 ? s + 1 : s);
		tt = inl > 0.5 ? (dl + hl) / (2 * max(hl, 1e-12)) : (inu > 0.5 ? (hu - du) / (2 * max(hu, 1e-12)) : 0);
		sw = 0.5 - 0.5 * cos(3.141592653589793 * tt);
		ws = inl > 0.5 ? sw : (inu > 0.5 ? 1 - sw : 1);
		wn = 1 - ws;
		bs = fs_base(s, dd, lc, ofs, pmd);
		bn = fs_base(nb, dd, lc, ofs, pmd);
		cs = bs + aa;
		cs = cs - 4 * floor(cs * 0.25);
		cn = bn + aa;
		cn = cn - 4 * floor(cn * 0.25);
		cs1 = cs > 2.5 ? cs - 3 : cs + 1;
		cn1 = cn > 2.5 ? cn - 3 : cn + 1;
		a0 = (1 - phv) * ws;
		a1 = (1 - phv) * wn;
		a2 = phv * ws;
		a3 = phv * wn;
		m0 = (cs == 0 ? a0 : 0) + (cn == 0 ? a1 : 0) + (cs1 == 0 ? a2 : 0) + (cn1 == 0 ? a3 : 0);
		m1 = (cs == 1 ? a0 : 0) + (cn == 1 ? a1 : 0) + (cs1 == 1 ? a2 : 0) + (cn1 == 1 ? a3 : 0);
		m2 = (cs == 2 ? a0 : 0) + (cn == 2 ? a1 : 0) + (cs1 == 2 ? a2 : 0) + (cn1 == 2 ? a3 : 0);
		m3 = (cs == 3 ? a0 : 0) + (cn == 3 ? a1 : 0) + (cs1 == 3 ? a2 : 0) + (cn1 == 3 ? a3 : 0);
		fsd.poke(m0, k, 0);
		fsd.poke(m1, k, 1);
		fsd.poke(m2, k, 2);
		fsd.poke(m3, k, 3);
		fsd.poke(1, k, 4);
		fsd.poke(m0, k, 5);
		fsd.poke(m1, k, 6);
		fsd.poke(m2, k, 7);
		fsd.poke(m3, k, 8);
		fsd.poke(1, k, 9);
	}
	return half;
}

// Spectral Limiter. After the forward FFT: amplitude of each bin (max of the left and right spectrum, a full-scale sine reads
// its amplitude) in fsd channel 10 and the limited masks in channels 5..9.
fs_limit(fx, fsd, thr, n) {
	half = n * 0.5;
	sc = 4 / n;
	for (k = 0; k <= half; k += 1) {
		k2 = k == 0 ? 0 : n - k;
		ar = fx.peek(k, 0);
		ai = fx.peek(k, 1);
		br = fx.peek(k2, 0);
		bi = fx.peek(k2, 1);
		lr = (ar + br) * 0.5;
		li = (ai - bi) * 0.5;
		rr = (ai + bi) * 0.5;
		ri = (br - ar) * 0.5;
		amp = sc * sqrt(max(lr * lr + li * li, rr * rr + ri * ri));
		fsd.poke(amp, k, 10);
		for (c = 0; c < 4; c += 1) {
			mm = fsd.peek(k, c);
			gg = min(1, thr / max(mm * amp, 1e-12));
			fsd.poke(mm * gg, k, 5 + c);
		}
		fsd.poke(min(1, thr / max(amp, 1e-12)), k, 9);
	}
	return half;
}

//@SS_DECL

Buffer scope("freqsplitscope");

Data fsd(2049, 11);
Data pc(32);

Param nsplit(16);
Param sdir(0);
Param xfadeamt(0);
Param nudgeamt(0);
Param spinamt(0);
Param bendamt(0);
Param pinchamt(0);
Param limon(0);
Param limdb(0);

History nsH(16);
History sdH(0);
History xfH(0);
History ndH(0);
History spH(0);
History bdH(0);
History pnH(0);
History loH(0);
History thH(1);
History nsU(-1);
History sdU(-1);
History xfU(-1);
History ndU(-1);
History spU(-1);
History bdU(-1);
History pnU(-1);
History loU(-1);
History nU(0);
History srU(0);

//@hook ctl
nsH = clip(nsplit, 1, 1024);
sdH = clip(floor(sdir + 0.5), 0, 2);
xfH = clip(xfadeamt, 0, 1);
ndH = clip(nudgeamt, -64, 64);
spH = clip(spinamt, -0.5, 0.5);
bdH = clip(bendamt, -1, 1);
pnH = clip(pinchamt, -1, 1);
loH = limon > 0.5 ? 1 : 0;
thH = pow(10, clip(limdb, -120, 12) * 0.05);
//@endhook

// The masks only change with the controls, the FFT size or the sample rate (and the limiter switch: it decides which rows hold the final masks):
// refill them only then. A follower never gets here; a follower that becomes the leader (or falls back) finds U != H and refills.
//@hook frame
chg = abs(nsH - nsU) + abs(sdH - sdU) + abs(xfH - xfU) + abs(ndH - ndU) + abs(spH - spU) + abs(bdH - bdU) + abs(pnH - pnU) + abs(loH - loU) + abs(n - nU) + abs(sr - srU);
if (chg > 0.000000001) {
fs_pattern(pc, nsH, sdH, xfH, ndH, spH, bdH, pnH);
fs_masks(fsd, pc, n, sr);
nsU = nsH;
sdU = sdH;
xfU = xfH;
ndU = ndH;
spU = spH;
bdU = bdH;
pnU = pnH;
loU = loH;
nU = n;
srU = sr;
}
if (loH > 0.5) {
fs_limit(fx, fsd, thH, n);
}
//@endhook

// cols holds 4 slots (the template's Data cols(512)): input + channels 1..3, then channel 4 through slot 0 again.
//@hook tele
ss_cols(ms, 0, fsd, -1, cols, 0, n, sr, 128, 20, 20000);
ss_cols(ms, 0, fsd, 5, cols, 1, n, sr, 128, 20, 20000);
ss_cols(ms, 0, fsd, 6, cols, 2, n, sr, 128, 20, 20000);
ss_cols(ms, 0, fsd, 7, cols, 3, n, sr, 128, 20, 20000);
ss_tele(cols, scope, 128, 4, 0);
ss_cols(ms, 0, fsd, 8, cols, 0, n, sr, 128, 20, 20000);
ss_tele(cols, scope, 128, 1, 512);
poke(scope, loH, 658, 0);
//@endhook

//@SS_MAIN
