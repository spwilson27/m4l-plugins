// Sand — differential compander.
// The wet path differentiates (or integrates) the input, then expands quiet
// parts of that signal and soft-limits the peaks. Order 0 is the raw signal.
// Order -1 integrates. Orders 1..15 cascade a differentiator whose gain is
// at most 1, at Nyquist (nrm = 0.5). Higher orders keep only the top of the
// spectrum without amplifying float rounding error into a full-scale oscillation.
// Amount is 0..140 dB of extra quiet-lift.
//
// Transcendentals (exp, sin, cos) are cached in History and recomputed only
// when a slewed parameter or samplerate actually moves. Order, stages, filter
// mode, placement, and out mode are integer selects: they gate work, they do
// not enter the cache. L and R stay two separate call sites of channel so p1..p15 and
// q1..q15 (and each filter / compander / integrator History) stay per channel.
// A for-loop around one call site would share that History.
//
// Maintenance invariants for future contributors:
// 1. GenExpr requires every function before Buffer, Param, and assignments.
// 2. Do not name a variable "e" followed by digits: the lexer reads that as Euler's constant.
// 3. Keep p1..p15 and q1..q15 unrolled inside channel() so each derivative stage
//    gets its own independent History state per channel() call site (L/R), and
//    q1..q15 suppress the sample-0 startup impulse. Stages with ord <= 0 or
//    ord < k are not stepped (their History stays put until that order is used).
// 4. Buffer wave("sandwave") memory map (2 channels, bound via `wave #0-sandwave`):
//    - frames 0..127:   ch 0 = out1 (L), ch 1 = out2 (R) circular ring buffer
//    - frames 128..255: ch 0 = mono dry input, ch 1 = mono wet grit
//    - frames 256..259: ch 0 = [pkIn, pkWet, pkOut, wpos] telemetry for v8ui scope
//      wpos increments every 32 samples even when the input is silent, so the
//      deferred-DSP confirm can see that gen~ is running.

slew(target, coef) {
	History sw(0);
	History swinit(0);
	sw = (swinit == 0) ? target : mix(target, sw, coef);
	swinit = 1;
	return sw;
}

integ(x, coef) {
	History ig(0);
	ig = coef * ig + (1 - coef) * x * 125;
	return clip(ig, -8, 8);
}

compand(x, maxG, atk, rel, knee, soft01, brick01, mildGain) {
	History en(0);
	ax = abs(x);
	en = mix(ax, en, (ax > en) ? atk : rel);
	quiet = knee / max(knee + en, 1e-8);
	g = 1 + (maxG - 1) * quiet;
	y = x * g;
	hard = clip(y, -1.2, 1.2);
	shaped = mix(hard, tanh(y), soft01);
	mild = tanh(x * mildGain);
	return mix(shaped, mild, clip(brick01, 0, 1));
}

filt(x, coef, mode) {
	History fs(0);
	History fb(0);
	fs = mix(x, fs, coef);
	high = x - fs;
	fb = mix(high, fb, coef);
	low = fs;
	band = fb;
	return (mode < 0.5) ? low : ((mode < 1.5) ? band : high);
}

limit(x) {
	History le(0);
	ax = abs(x);
	le = (ax > le) ? ax : mix(ax, le, 0.9995);
	g = 0.89 / max(le, 0.89);
	return x * g;
}

// fpos 0 filters the input, 1 filters the derivative, 2 filters the companded wet.
// Only the active placement runs filt(), and only derivative / compander stages
// at or below the current order / stage count are stepped.
channel(x, ord, stg, maxG, atk, rel, knee, soft01, brick01, mildGain, coef, coefI, ftype, fpos) {
	History p1(0); History q1(0);
	History p2(0); History q2(0);
	History p3(0); History q3(0);
	History p4(0); History q4(0);
	History p5(0); History q5(0);
	History p6(0); History q6(0);
	History p7(0); History q7(0);
	History p8(0); History q8(0);
	History p9(0); History q9(0);
	History p10(0); History q10(0);
	History p11(0); History q11(0);
	History p12(0); History q12(0);
	History p13(0); History q13(0);
	History p14(0); History q14(0);
	History p15(0); History q15(0);
	preOn = (fpos < 0.5) ? 1 : 0;
	src = x;
	if (preOn > 0.5) {
		src = filt(x, coef, ftype);
	}
	d = src;
	nrm = 0.5;
	nxt = d;
	if (ord > 0.5) {
		nxt = (q1 == 0) ? 0 : clip((d - p1) * nrm, -8, 8);
		p1 = d;
		q1 = 1;
		d = nxt;
	}
	if (ord > 1.5) {
		nxt = (q2 == 0) ? 0 : clip((d - p2) * nrm, -8, 8);
		p2 = d;
		q2 = 1;
		d = nxt;
	}
	if (ord > 2.5) {
		nxt = (q3 == 0) ? 0 : clip((d - p3) * nrm, -8, 8);
		p3 = d;
		q3 = 1;
		d = nxt;
	}
	if (ord > 3.5) {
		nxt = (q4 == 0) ? 0 : clip((d - p4) * nrm, -8, 8);
		p4 = d;
		q4 = 1;
		d = nxt;
	}
	if (ord > 4.5) {
		nxt = (q5 == 0) ? 0 : clip((d - p5) * nrm, -8, 8);
		p5 = d;
		q5 = 1;
		d = nxt;
	}
	if (ord > 5.5) {
		nxt = (q6 == 0) ? 0 : clip((d - p6) * nrm, -8, 8);
		p6 = d;
		q6 = 1;
		d = nxt;
	}
	if (ord > 6.5) {
		nxt = (q7 == 0) ? 0 : clip((d - p7) * nrm, -8, 8);
		p7 = d;
		q7 = 1;
		d = nxt;
	}
	if (ord > 7.5) {
		nxt = (q8 == 0) ? 0 : clip((d - p8) * nrm, -8, 8);
		p8 = d;
		q8 = 1;
		d = nxt;
	}
	if (ord > 8.5) {
		nxt = (q9 == 0) ? 0 : clip((d - p9) * nrm, -8, 8);
		p9 = d;
		q9 = 1;
		d = nxt;
	}
	if (ord > 9.5) {
		nxt = (q10 == 0) ? 0 : clip((d - p10) * nrm, -8, 8);
		p10 = d;
		q10 = 1;
		d = nxt;
	}
	if (ord > 10.5) {
		nxt = (q11 == 0) ? 0 : clip((d - p11) * nrm, -8, 8);
		p11 = d;
		q11 = 1;
		d = nxt;
	}
	if (ord > 11.5) {
		nxt = (q12 == 0) ? 0 : clip((d - p12) * nrm, -8, 8);
		p12 = d;
		q12 = 1;
		d = nxt;
	}
	if (ord > 12.5) {
		nxt = (q13 == 0) ? 0 : clip((d - p13) * nrm, -8, 8);
		p13 = d;
		q13 = 1;
		d = nxt;
	}
	if (ord > 13.5) {
		nxt = (q14 == 0) ? 0 : clip((d - p14) * nrm, -8, 8);
		p14 = d;
		q14 = 1;
		d = nxt;
	}
	if (ord > 14.5) {
		nxt = (q15 == 0) ? 0 : clip((d - p15) * nrm, -8, 8);
		p15 = d;
		q15 = 1;
		d = nxt;
	}
	body = d;
	if (ord < -0.5) {
		body = integ(src, coefI);
	}
	midOn = (fpos > 0.5) ? ((fpos < 1.5) ? 1 : 0) : 0;
	mid = body;
	if (midOn > 0.5) {
		mid = filt(body, coef, ftype);
	}
	wet = compand(mid, maxG, atk, rel, knee, soft01, brick01, mildGain);
	if (stg > 1.5) {
		wet = compand(wet, maxG, atk, rel, knee, soft01, brick01, mildGain);
	}
	if (stg > 2.5) {
		wet = compand(wet, maxG, atk, rel, knee, soft01, brick01, mildGain);
	}
	if (stg > 3.5) {
		wet = compand(wet, maxG, atk, rel, knee, soft01, brick01, mildGain);
	}
	postOn = (fpos > 1.5) ? 1 : 0;
	if (postOn > 0.5) {
		wet = filt(wet, coef, ftype);
	}
	return wet;
}

Buffer wave("sandwave");

Param amount(18);
Param stages(1);
Param dorder(1);
Param soft(35);
Param debrick(0);
Param ftype(0);
Param ffreq(14000);
Param fpos(2);
Param mix(50);
Param outmode(0);

History hop(0);
History wpos(0);
History pkIn(0);
History pkWet(0);
History pkOut(0);
// Coefficient cache. coefOk stays 0 until the first sample fills it.
History coefOk(0);
History cAmt(-1);
History cSoft(-1);
History cFreq(-1);
History cMix(-1);
History cSr(0);
History cMaxG(1);
History cAtk(0.15);
History cRel(0.98);
History cKnee(0.03);
History cMild(8);
History cFilt(0);
History cInteg(0);
History cDry(1);
History cWet(0);

amountS = slew(amount, 0.999);
softS = slew(soft, 0.999);
brickS = slew(debrick, 0.999);
freqS = slew(ffreq, 0.9992);
mixS = slew(mix, 0.999);

amt01 = clip(amountS, 0, 140) / 140;
soft01 = clip(softS, 0, 100) / 100;
brick01 = clip(brickS, 0, 100) / 100;
ordN = clip(dorder, -1, 15);
stgN = clip(stages, 1, 4);
freqN = clip(freqS, 20, 18000);
typeN = clip(ftype, 0, 2);
posN = clip(fpos, 0, 2);

// Recompute exp / sin / cos only when a slewed knob or the sample rate moved.
// Thresholds sit under the slew (a held knob is bit-exact after sample 0, because
// slew() returns the target on its first sample and stays there).
refresh = (coefOk < 0.5) ? 1 : 0;
if (abs(amountS - cAmt) > 0.01) refresh = 1;
if (abs(softS - cSoft) > 0.01) refresh = 1;
if (abs(freqS - cFreq) > 0.05) refresh = 1;
if (abs(mixS - cMix) > 0.01) refresh = 1;
if (samplerate != cSr) refresh = 1;
maxG = cMaxG;
atkC = cAtk;
relC = cRel;
kneeC = cKnee;
mildC = cMild;
filtC = cFilt;
integC = cInteg;
dryG = cDry;
wetG = cWet;
if (refresh > 0.5) {
	integC = exp(-6.28318530718 * 8 / samplerate);
	filtC = exp(-6.28318530718 * freqN / samplerate);
	maxG = exp(clip(amt01, 0, 1) * 16.11809565095832);
	atkC = mix(0.15, 0.7, soft01);
	relC = mix(0.98, 0.9997, soft01);
	kneeC = mix(0.03, 0.45, soft01);
	mildC = mix(8, 1.5, soft01);
	ang = clip(mixS, 0, 100) / 100 * 1.57079632679;
	dryG = cos(ang);
	wetG = sin(ang);
	cMaxG = maxG;
	cAtk = atkC;
	cRel = relC;
	cKnee = kneeC;
	cMild = mildC;
	cFilt = filtC;
	cInteg = integC;
	cDry = dryG;
	cWet = wetG;
	cAmt = amountS;
	cSoft = softS;
	cFreq = freqS;
	cMix = mixS;
	cSr = samplerate;
	coefOk = 1;
}

wetL = channel(in1, ordN, stgN, maxG, atkC, relC, kneeC, soft01, brick01, mildC, filtC, integC, typeN, posN);
wetR = channel(in2, ordN, stgN, maxG, atkC, relC, kneeC, soft01, brick01, mildC, filtC, integC, typeN, posN);

mixL = in1 * dryG + wetL * wetG;
mixR = in2 * dryG + wetR * wetG;

// Limiter History always runs, including when Out is Off or Hard.
limL = limit(mixL);
limR = limit(mixR);
mode = clip(outmode, 0, 2);
out1 = (mode < 0.5) ? mixL : ((mode < 1.5) ? clip(mixL, -1, 1) : limL);
out2 = (mode < 0.5) ? mixR : ((mode < 1.5) ? clip(mixR, -1, 1) : limR);
out1 = fixnan(out1);
out2 = fixnan(out2);

inAbs = max(abs(in1), abs(in2));
wetAbs = max(abs(wetL), abs(wetR));
outAbs = max(abs(out1), abs(out2));
pkIn = max(inAbs, pkIn * 0.996);
pkWet = max(wetAbs, pkWet * 0.996);
pkOut = max(outAbs, pkOut * 0.996);

// Unconditional: wpos at frame 259 advances every 32 samples in silence too.
hop = wrap(hop + 1, 0, 32);
if (hop == 0) {
	poke(wave, out1, wpos, 0);
	poke(wave, out2, wpos, 1);
	poke(wave, 0.5 * (in1 + in2), 128 + wpos, 0);
	poke(wave, 0.5 * (wetL + wetR), 128 + wpos, 1);
	poke(wave, pkIn, 256, 0);
	poke(wave, pkWet, 257, 0);
	poke(wave, pkOut, 258, 0);
	poke(wave, wpos, 259, 0);
	wpos = wrap(wpos + 1, 0, 128);
}
