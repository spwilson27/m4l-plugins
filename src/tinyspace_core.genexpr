// Tiny Space — 20-line feedback delay network.
// Config buffer (buffer~ ---tsconfig), indices match src/tinyspace_config.js:
//   0 activeCount, 1 character,
//   2..5 allpass lengths (ms), 6..9 allpass gains,
//   10..29 nominal delay (ms), 30..49 damp offset, 50..69 mod Hz, 70 model.
// Meter buffer (buffer~ ---tsmeters): slots 0..19 are line envelopes, slot 20 is a
// frame counter that increments every 32 samples even when the input is silent.
// Filter, crossfeed, wet/dry, RT60, loop-gain and damping coefficients are cached
// and recomputed only when size, fbk, damp, hp, lp, xfeed, wet, samplerate or the
// seed config changes.
// GenExpr requires every function to appear before Buffer, Param, and assignments.

slew(target, coef) {
	History s(0);
	History init(0);
	s = (init == 0) ? target : mix(target, s, coef);
	init = 1;
	return s;
}

// steps is 1 at audio rate, or 32 when the phase is sampled once per block.
lfo(hz, steps) {
	History ph(0);
	ph = wrap(ph + hz * steps / samplerate, 0, 1);
	return sin(ph * 6.283185307179586);
}

lp(x, coef) {
	History s(0);
	s = mix(x, s, coef);
	return s;
}

hp(x, coef) {
	History s(0);
	s = mix(x, s, coef);
	return x - s;
}

// Schroeder allpass. Delay holds the samples; History holds the previous tap
// so the feedback coefficient is applied to a delayed sample.
allpass(x, t, g) {
	Delay line(4096);
	History mem(0);
	y = -g * x + mem;
	line.write(x + g * y);
	mem = line.read(clip(t, 1, 4000), interp="linear");
	return y;
}

// Whole-sample taps. Linear interpolation would shave a little high end off
// every pass, and a 1 ms comb passes often enough that the tone dies.
lineTime(lenMs, lfoVal, sizeNow, modNow) {
	sc = 0.22 + clip(sizeNow, 0, 1) * 1.93;
	base = clip(lenMs * sc * samplerate / 1000, 1, 16000);
	depth = min(base * 0.28, samplerate * 0.0012) * clip(modNow, 0, 1);
	return round(clip(base + lfoVal * depth, 1, 16000));
}

follow(x) {
	History s(0);
	ax = abs(x);
	s = mix(ax, s, (ax > s) ? 0.45 : 0.992);
	return s;
}

// Delay-style RT60. 50% is a short slap (~0.7 s); 100% is about 27.5 s to -60 dB.
// Matches feedbackRt60() in tinyspace_config.js. fbk 0 returns 0 (no recirculation).
feedbackRt(fbkNow) {
	k = clip(fbkNow, 0, 1);
	k2 = k * k;
	k4 = k2 * k2;
	k6 = k4 * k2;
	k10 = k6 * k4;
	k16 = k10 * k6;
	rtRaw = 2.90663 * k2 - 0.81561 * k4 + 7.05921 * k6 - 1.60268 * k10 + 19.9526 * k16;
	return (k < 0.001) ? 0 : rtRaw;
}

// Per-line loop gain from an RT60 already computed by feedbackRt.
ringGain(delaySamps, rt) {
	secs = max(delaySamps, 1) / samplerate;
	safe = (rt > 0.00001) ? rt : 1;
	g = exp(-6.90775527898 * secs / safe);
	quiet = (rt > 0.00001) ? g : 0;
	return clip(quiet, 0, 0.9999995);
}

// One-pole lowpass coefficient. Damp 0 is a bypass (pole 0), so a bright comb
// stays metallic. Matches dampPole() in tinyspace_config.js.
dampCoef(delaySamps, dampNow, offset) {
	amtIn = clip(dampNow, 0, 1);
	pole = 0;
	if (amtIn >= 0.001) {
		off = clip(offset, 0, 0.35);
		amt = clip(amtIn * (0.85 + 0.30 * off), 0, 1);
		amtPow = pow(max(amt, 0.00001), 0.75);
		fcBase = 16000 * pow(0.015, amtPow);
		span = max(delaySamps, 1);
		scale = pow(0.008 * samplerate / span, 0.45);
		scale = clip(scale, 0.6, 3.2);
		fcNow = fcBase * scale;
		pole = exp(-6.28318530718 * fcNow / samplerate);
	}
	return clip(pole, 0, 0.995);
}

// Rotate three samples inside the plane orthogonal to (1, 1, 1).
spin3(x0, x1, x2, c, s) {
	u0 = 0.7071067811865476;
	u1 = -0.7071067811865476;
	v0 = 0.40824829046386302;
	v1 = 0.40824829046386302;
	v2 = -0.81649658092772603;
	pu = x0 * u0 + x1 * u1;
	pv = x0 * v0 + x1 * v1 + x2 * v2;
	f = c - 1;
	y0 = x0 + f * (pu * u0 + pv * v0) + s * (pu * v0 - pv * u0);
	y1 = x1 + f * (pu * u1 + pv * v1) + s * (pu * v1 - pv * u1);
	y2 = x2 + f * (pv * v2) + s * (pu * v2);
	return y0, y1, y2;
}

tap(i, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9) {
	return (i < 0.5) ? a0 : ((i < 1.5) ? a1 : ((i < 2.5) ? a2 : ((i < 3.5) ? a3 : ((i < 4.5) ? a4 : ((i < 5.5) ? a5 : ((i < 6.5) ? a6 : ((i < 7.5) ? a7 : ((i < 8.5) ? a8 : a9))))))));
}

// Eight orthogonal room topologies (2 ROOM = Householder reflection).
house(o0, o1, o2, o3, o4, o5, o6, o7, o8, o9, n, model, hc, hs, kk) {
	z0 = (0 < n) ? o0 : 0;
	z1 = (1 < n) ? o1 : 0;
	z2 = (2 < n) ? o2 : 0;
	z3 = (3 < n) ? o3 : 0;
	z4 = (4 < n) ? o4 : 0;
	z5 = (5 < n) ? o5 : 0;
	z6 = (6 < n) ? o6 : 0;
	z7 = (7 < n) ? o7 : 0;
	z8 = (8 < n) ? o8 : 0;
	z9 = (9 < n) ? o9 : 0;
	m0 = z0;
	m1 = z1;
	m2 = z2;
	m3 = z3;
	m4 = z4;
	m5 = z5;
	m6 = z6;
	m7 = z7;
	m8 = z8;
	m9 = z9;

	if (model == 0) {
		m0 = z0;
	} else if (model == 1) {
		q0, q1, q2 = spin3(z0, z1, z2, hc, hs);
		m0 = (2 < n) ? q0 : z0;
		m1 = (2 < n) ? q1 : z1;
		m2 = (2 < n) ? q2 : z2;
		q0, q1, q2 = spin3(z3, z4, z5, hc, hs);
		m3 = (5 < n) ? q0 : z3;
		m4 = (5 < n) ? q1 : z4;
		m5 = (5 < n) ? q2 : z5;
		q0, q1, q2 = spin3(z6, z7, z8, hc, hs);
		m6 = (8 < n) ? q0 : z6;
		m7 = (8 < n) ? q1 : z7;
		m8 = (8 < n) ? q2 : z8;
	} else if (model == 2) {
		sum = z0 + z1 + z2 + z3 + z4 + z5 + z6 + z7 + z8 + z9;
		m0 = (0 < n) ? (z0 - sum * kk) : 0;
		m1 = (1 < n) ? (z1 - sum * kk) : 0;
		m2 = (2 < n) ? (z2 - sum * kk) : 0;
		m3 = (3 < n) ? (z3 - sum * kk) : 0;
		m4 = (4 < n) ? (z4 - sum * kk) : 0;
		m5 = (5 < n) ? (z5 - sum * kk) : 0;
		m6 = (6 < n) ? (z6 - sum * kk) : 0;
		m7 = (7 < n) ? (z7 - sum * kk) : 0;
		m8 = (8 < n) ? (z8 - sum * kk) : 0;
		m9 = (9 < n) ? (z9 - sum * kk) : 0;
	} else if (model == 3) {
		sum = z0 + z1 + z2 + z3 + z4 + z5 + z6 + z7 + z8 + z9;
		hh0 = (0 < n) ? (z0 - sum * kk) : 0;
		hh1 = (1 < n) ? (z1 - sum * kk) : 0;
		hh2 = (2 < n) ? (z2 - sum * kk) : 0;
		hh3 = (3 < n) ? (z3 - sum * kk) : 0;
		hh4 = (4 < n) ? (z4 - sum * kk) : 0;
		hh5 = (5 < n) ? (z5 - sum * kk) : 0;
		hh6 = (6 < n) ? (z6 - sum * kk) : 0;
		hh7 = (7 < n) ? (z7 - sum * kk) : 0;
		hh8 = (8 < n) ? (z8 - sum * kk) : 0;
		lastH = tap(n - 1, hh0, hh1, hh2, hh3, hh4, hh5, hh6, hh7, hh8, (9 < n) ? (z9 - sum * kk) : 0);
		m0 = (0 < n) ? -lastH : 0;
		m1 = (1 < n) ? -hh0 : 0;
		m2 = (2 < n) ? -hh1 : 0;
		m3 = (3 < n) ? -hh2 : 0;
		m4 = (4 < n) ? -hh3 : 0;
		m5 = (5 < n) ? -hh4 : 0;
		m6 = (6 < n) ? -hh5 : 0;
		m7 = (7 < n) ? -hh6 : 0;
		m8 = (8 < n) ? -hh7 : 0;
		m9 = (9 < n) ? -hh8 : 0;
	} else if (model == 4) {
		lastZ = tap(n - 1, z0, z1, z2, z3, z4, z5, z6, z7, z8, z9);
		m0 = (0 < n) ? -lastZ : 0;
		m1 = (1 < n) ? -z0 : 0;
		m2 = (2 < n) ? -z1 : 0;
		m3 = (3 < n) ? -z2 : 0;
		m4 = (4 < n) ? -z3 : 0;
		m5 = (5 < n) ? -z4 : 0;
		m6 = (6 < n) ? -z5 : 0;
		m7 = (7 < n) ? -z6 : 0;
		m8 = (8 < n) ? -z7 : 0;
		m9 = (9 < n) ? -z8 : 0;
	} else if (model == 5) {
		sum = z0 + z1 + z2 + z3 + z4 + z5 + z6 + z7 + z8 + z9;
		hh0 = (0 < n) ? (z0 - sum * kk) : 0;
		hh1 = (1 < n) ? (z1 - sum * kk) : 0;
		hh2 = (2 < n) ? (z2 - sum * kk) : 0;
		hh3 = (3 < n) ? (z3 - sum * kk) : 0;
		hh4 = (4 < n) ? (z4 - sum * kk) : 0;
		hh5 = (5 < n) ? (z5 - sum * kk) : 0;
		hh6 = (6 < n) ? (z6 - sum * kk) : 0;
		hh7 = (7 < n) ? (z7 - sum * kk) : 0;
		hh8 = (8 < n) ? (z8 - sum * kk) : 0;
		hh9 = (9 < n) ? (z9 - sum * kk) : 0;
		m0 = (1 < n) ? -hh1 : ((0 < n) ? -hh0 : 0);
		m1 = (1 < n) ? -hh0 : 0;
		m2 = (3 < n) ? -hh3 : ((2 < n) ? -hh2 : 0);
		m3 = (3 < n) ? -hh2 : 0;
		m4 = (5 < n) ? -hh5 : ((4 < n) ? -hh4 : 0);
		m5 = (5 < n) ? -hh4 : 0;
		m6 = (7 < n) ? -hh7 : ((6 < n) ? -hh6 : 0);
		m7 = (7 < n) ? -hh6 : 0;
		m8 = (9 < n) ? -hh9 : ((8 < n) ? -hh8 : 0);
		m9 = (9 < n) ? -hh8 : 0;
	} else if (model == 6) {
		sc = 0.40848744088415739;
		ss = 0.91276394026052099;
		u0 = z0;
		u1 = z1;
		u2 = z2;
		u3 = z3;
		u4 = z4;
		u5 = z5;
		u6 = z6;
		u7 = z7;
		u8 = z8;
		u9 = z9;
		q0, q1, q2 = spin3(u0, u1, u2, sc, ss);
		u0 = (2 < n) ? q0 : u0;
		u1 = (2 < n) ? q1 : u1;
		u2 = (2 < n) ? q2 : u2;
		q0, q1, q2 = spin3(u1, u2, u3, sc, ss);
		u1 = (3 < n) ? q0 : u1;
		u2 = (3 < n) ? q1 : u2;
		u3 = (3 < n) ? q2 : u3;
		q0, q1, q2 = spin3(u2, u3, u4, sc, ss);
		u2 = (4 < n) ? q0 : u2;
		u3 = (4 < n) ? q1 : u3;
		u4 = (4 < n) ? q2 : u4;
		q0, q1, q2 = spin3(u3, u4, u5, sc, ss);
		u3 = (5 < n) ? q0 : u3;
		u4 = (5 < n) ? q1 : u4;
		u5 = (5 < n) ? q2 : u5;
		q0, q1, q2 = spin3(u4, u5, u6, sc, ss);
		u4 = (6 < n) ? q0 : u4;
		u5 = (6 < n) ? q1 : u5;
		u6 = (6 < n) ? q2 : u6;
		q0, q1, q2 = spin3(u5, u6, u7, sc, ss);
		u5 = (7 < n) ? q0 : u5;
		u6 = (7 < n) ? q1 : u6;
		u7 = (7 < n) ? q2 : u7;
		q0, q1, q2 = spin3(u6, u7, u8, sc, ss);
		u6 = (8 < n) ? q0 : u6;
		u7 = (8 < n) ? q1 : u7;
		u8 = (8 < n) ? q2 : u8;
		q0, q1, q2 = spin3(u7, u8, u9, sc, ss);
		u7 = (9 < n) ? q0 : u7;
		u8 = (9 < n) ? q1 : u8;
		u9 = (9 < n) ? q2 : u9;
		m0 = (2 < n) ? u0 : ((0 < n) ? -z0 : 0);
		m1 = (2 < n) ? u1 : ((1 < n) ? -z1 : 0);
		m2 = (2 < n) ? u2 : 0;
		m3 = (2 < n) ? u3 : 0;
		m4 = (2 < n) ? u4 : 0;
		m5 = (2 < n) ? u5 : 0;
		m6 = (2 < n) ? u6 : 0;
		m7 = (2 < n) ? u7 : 0;
		m8 = (2 < n) ? u8 : 0;
		m9 = (2 < n) ? u9 : 0;
	} else {
		m0 = (0 < n) ? -tap(n - 1, z0, z1, z2, z3, z4, z5, z6, z7, z8, z9) : 0;
		m1 = (1 < n) ? -tap(n - 2, z0, z1, z2, z3, z4, z5, z6, z7, z8, z9) : 0;
		m2 = (2 < n) ? -tap(n - 3, z0, z1, z2, z3, z4, z5, z6, z7, z8, z9) : 0;
		m3 = (3 < n) ? -tap(n - 4, z0, z1, z2, z3, z4, z5, z6, z7, z8, z9) : 0;
		m4 = (4 < n) ? -tap(n - 5, z0, z1, z2, z3, z4, z5, z6, z7, z8, z9) : 0;
		m5 = (5 < n) ? -tap(n - 6, z0, z1, z2, z3, z4, z5, z6, z7, z8, z9) : 0;
		m6 = (6 < n) ? -tap(n - 7, z0, z1, z2, z3, z4, z5, z6, z7, z8, z9) : 0;
		m7 = (7 < n) ? -tap(n - 8, z0, z1, z2, z3, z4, z5, z6, z7, z8, z9) : 0;
		m8 = (8 < n) ? -tap(n - 9, z0, z1, z2, z3, z4, z5, z6, z7, z8, z9) : 0;
		m9 = (9 < n) ? -tap(n - 10, z0, z1, z2, z3, z4, z5, z6, z7, z8, z9) : 0;
	}
	return m0, m1, m2, m3, m4, m5, m6, m7, m8, m9;
}

Buffer cfg("tsconfig");
Buffer meters("tsmeters");
Data gLine(20);
Data cLine(20);
Data tLine(20);

Param size(0.45);
Param damp(0.2);
Param width(0.7);
Param wet(0.35);
Param fbk(0.4);
Param predly(0);
Param modamt(0.15);
Param xfeed(0.25);
Param hp(40);
Param lp(14000);
Param duck(1);

History tick(0);
History o0(0);
History o1(0);
History o2(0);
History o3(0);
History o4(0);
History o5(0);
History o6(0);
History o7(0);
History o8(0);
History o9(0);
History o10(0);
History o11(0);
History o12(0);
History o13(0);
History o14(0);
History o15(0);
History o16(0);
History o17(0);
History o18(0);
History o19(0);
History awake(1);
History idleCount(0);
History tankE(0);
History initDone(0);
History activeCount(0);
History frame(0);

History cSize(-1);
History cFbk(-1);
History cDamp(-1);
History cHp(-1);
History cLp(-1);
History cXfeed(-1);
History cWet(-1);
History cSr(-1);
History cCfg0(-1);
History cCfg1(-1);
History cModel(-1);
History cLen0(-1);
History cAp0(-1);
History lpCoef(0);
History hpCoef(0);
History hc(1);
History hs(0);
History cth(1);
History sth(0);
History dryG(1);
History wetG(0);
History invL(1);
History invR(1);
History kkL(2);
History kkR(2);
History nL(0);
History nR(0);
History modelI(0);
History apT0(1);
History apT1(1);
History apT2(1);
History apT3(1);
History apG0(0);
History apG1(0);
History apG2(0);
History apG3(0);

Delay preDL(65536);
Delay preDR(65536);
Delay del0(16384);
Delay del1(16384);
Delay del2(16384);
Delay del3(16384);
Delay del4(16384);
Delay del5(16384);
Delay del6(16384);
Delay del7(16384);
Delay del8(16384);
Delay del9(16384);
Delay del10(16384);
Delay del11(16384);
Delay del12(16384);
Delay del13(16384);
Delay del14(16384);
Delay del15(16384);
Delay del16(16384);
Delay del17(16384);
Delay del18(16384);
Delay del19(16384);

sizeS = slew(size, 0.9992);
dampS = slew(damp, 0.9992);
widthS = slew(width, 0.9992);
wetS = slew(wet, 0.9992);
fbkS = slew(fbk, 0.9992);
predlyS = slew(predly, 0.9992);
modS = slew(modamt, 0.9992);
xfeedS = slew(xfeed, 0.9992);
hpS = slew(hp, 0.9992);
lpS = slew(lp, 0.9992);
duckG = slew(clip(duck, 0, 1), 0.9992);
sr = max(samplerate, 1);
inAbs = abs(in1) + abs(in2);
awake = (inAbs > 1e-7) ? 1 : awake;
idleCount = (inAbs > 1e-7) ? 0 : (idleCount + 1);

preDL.write(in1);
preDR.write(in2);

wetL = 0;
wetR = 0;
tankE = 0;
env0 = 0;
env1 = 0;
env2 = 0;
env3 = 0;
env4 = 0;
env5 = 0;
env6 = 0;
env7 = 0;
env8 = 0;
env9 = 0;
env10 = 0;
env11 = 0;
env12 = 0;
env13 = 0;
env14 = 0;
env15 = 0;
env16 = 0;
env17 = 0;
env18 = 0;
env19 = 0;

if (awake > 0.5) {
	cfg0 = peek(cfg, 0);
	cfg1 = peek(cfg, 1);
	cfgM = peek(cfg, 70);
	cfgL = peek(cfg, 10);
	cfgA = peek(cfg, 2);
	modNow = clip(modS, 0, 1);
	l0 = 0;
	l1 = 0;
	l2 = 0;
	l3 = 0;
	l4 = 0;
	l5 = 0;
	l6 = 0;
	l7 = 0;
	l8 = 0;
	l9 = 0;
	l10 = 0;
	l11 = 0;
	l12 = 0;
	l13 = 0;
	l14 = 0;
	l15 = 0;
	l16 = 0;
	l17 = 0;
	l18 = 0;
	l19 = 0;
	if (modNow > 0.001) {
		l0 = lfo(peek(cfg, 50), 1);
		l1 = lfo(peek(cfg, 51), 1);
		l2 = lfo(peek(cfg, 52), 1);
		l3 = lfo(peek(cfg, 53), 1);
		l4 = lfo(peek(cfg, 54), 1);
		l5 = lfo(peek(cfg, 55), 1);
		l6 = lfo(peek(cfg, 56), 1);
		l7 = lfo(peek(cfg, 57), 1);
		l8 = lfo(peek(cfg, 58), 1);
		l9 = lfo(peek(cfg, 59), 1);
		l10 = lfo(peek(cfg, 60), 1);
		l11 = lfo(peek(cfg, 61), 1);
		l12 = lfo(peek(cfg, 62), 1);
		l13 = lfo(peek(cfg, 63), 1);
		l14 = lfo(peek(cfg, 64), 1);
		l15 = lfo(peek(cfg, 65), 1);
		l16 = lfo(peek(cfg, 66), 1);
		l17 = lfo(peek(cfg, 67), 1);
		l18 = lfo(peek(cfg, 68), 1);
		l19 = lfo(peek(cfg, 69), 1);
	}
	t0 = lineTime(peek(cfg, 10), l0, sizeS, modS);
	t1 = lineTime(peek(cfg, 11), l1, sizeS, modS);
	t2 = lineTime(peek(cfg, 12), l2, sizeS, modS);
	t3 = lineTime(peek(cfg, 13), l3, sizeS, modS);
	t4 = lineTime(peek(cfg, 14), l4, sizeS, modS);
	t5 = lineTime(peek(cfg, 15), l5, sizeS, modS);
	t6 = lineTime(peek(cfg, 16), l6, sizeS, modS);
	t7 = lineTime(peek(cfg, 17), l7, sizeS, modS);
	t8 = lineTime(peek(cfg, 18), l8, sizeS, modS);
	t9 = lineTime(peek(cfg, 19), l9, sizeS, modS);
	t10 = lineTime(peek(cfg, 20), l10, sizeS, modS);
	t11 = lineTime(peek(cfg, 21), l11, sizeS, modS);
	t12 = lineTime(peek(cfg, 22), l12, sizeS, modS);
	t13 = lineTime(peek(cfg, 23), l13, sizeS, modS);
	t14 = lineTime(peek(cfg, 24), l14, sizeS, modS);
	t15 = lineTime(peek(cfg, 25), l15, sizeS, modS);
	t16 = lineTime(peek(cfg, 26), l16, sizeS, modS);
	t17 = lineTime(peek(cfg, 27), l17, sizeS, modS);
	t18 = lineTime(peek(cfg, 28), l18, sizeS, modS);
	t19 = lineTime(peek(cfg, 29), l19, sizeS, modS);

	doCoef = ((initDone == 0) || (sizeS != cSize) || (fbkS != cFbk) || (dampS != cDamp) || (hpS != cHp) || (lpS != cLp) || (xfeedS != cXfeed) || (sr != cSr) || (cfg0 != cCfg0) || (cfg1 != cCfg1) || (cfgM != cModel) || (cfgL != cLen0) || (cfgA != cAp0) || (modNow > 0.001)) ? 1 : 0;
	if (doCoef > 0.5) {
		initDone = 1;
		cSize = sizeS;
		cFbk = fbkS;
		cDamp = dampS;
		cHp = hpS;
		cLp = lpS;
		cXfeed = xfeedS;
		cSr = sr;
		cCfg0 = cfg0;
		cCfg1 = cfg1;
		cModel = cfgM;
		cLen0 = cfgL;
		cAp0 = cfgA;
		activeCount = cfg0;
		lpCoef = exp(-6.28318530718 * clip(lpS, 400, 18000) / sr);
		hpCoef = exp(-6.28318530718 * clip(hpS, 20, 4000) / sr);
		nL = activeCount * 0.5;
		nR = nL;
		invL = 1 / sqrt(max(nL, 1));
		invR = 1 / sqrt(max(nR, 1));
		kkL = 2 / max(nL, 1);
		kkR = 2 / max(nR, 1);
		chClip = clip(cfg1, 0, 1);
		hc = cos(chClip * 3.141592653589793);
		hs = sin(chClip * 3.141592653589793);
		xf = clip(xfeedS, 0, 1);
		cth = cos(xf * 1.5707963267948966);
		sth = sin(xf * 1.5707963267948966);
		rtNow = feedbackRt(fbkS);
		apT0 = clip(peek(cfg, 2) * sr / 1000, 1, sr * 0.02);
		apT1 = clip(peek(cfg, 3) * sr / 1000, 1, sr * 0.02);
		apT2 = clip(peek(cfg, 4) * sr / 1000, 1, sr * 0.02);
		apT3 = clip(peek(cfg, 5) * sr / 1000, 1, sr * 0.02);
		apG0 = clip(peek(cfg, 6), 0, 0.7);
		apG1 = clip(peek(cfg, 7), 0, 0.7);
		apG2 = clip(peek(cfg, 8), 0, 0.7);
		apG3 = clip(peek(cfg, 9), 0, 0.7);
		modelI = round(clip(cfgM, 0, 7));
		poke(tLine, t0, 0); poke(tLine, t1, 1); poke(tLine, t2, 2); poke(tLine, t3, 3); poke(tLine, t4, 4);
		poke(tLine, t5, 5); poke(tLine, t6, 6); poke(tLine, t7, 7); poke(tLine, t8, 8); poke(tLine, t9, 9);
		poke(tLine, t10, 10); poke(tLine, t11, 11); poke(tLine, t12, 12); poke(tLine, t13, 13); poke(tLine, t14, 14);
		poke(tLine, t15, 15); poke(tLine, t16, 16); poke(tLine, t17, 17); poke(tLine, t18, 18); poke(tLine, t19, 19);
		for (li = 0; li < 20; li += 1) {
			tl = peek(tLine, li);
			rg = ringGain(tl, rtNow);
			dc = dampCoef(tl, dampS, peek(cfg, 30 + li));
			poke(gLine, rg, li);
			poke(cLine, dc, li);
		}
	}
	g0 = peek(gLine, 0); g1 = peek(gLine, 1); g2 = peek(gLine, 2); g3 = peek(gLine, 3); g4 = peek(gLine, 4);
	g5 = peek(gLine, 5); g6 = peek(gLine, 6); g7 = peek(gLine, 7); g8 = peek(gLine, 8); g9 = peek(gLine, 9);
	g10 = peek(gLine, 10); g11 = peek(gLine, 11); g12 = peek(gLine, 12); g13 = peek(gLine, 13); g14 = peek(gLine, 14);
	g15 = peek(gLine, 15); g16 = peek(gLine, 16); g17 = peek(gLine, 17); g18 = peek(gLine, 18); g19 = peek(gLine, 19);
	c0 = peek(cLine, 0); c1 = peek(cLine, 1); c2 = peek(cLine, 2); c3 = peek(cLine, 3); c4 = peek(cLine, 4);
	c5 = peek(cLine, 5); c6 = peek(cLine, 6); c7 = peek(cLine, 7); c8 = peek(cLine, 8); c9 = peek(cLine, 9);
	c10 = peek(cLine, 10); c11 = peek(cLine, 11); c12 = peek(cLine, 12); c13 = peek(cLine, 13); c14 = peek(cLine, 14);
	c15 = peek(cLine, 15); c16 = peek(cLine, 16); c17 = peek(cLine, 17); c18 = peek(cLine, 18); c19 = peek(cLine, 19);
	a0 = (0 < nL) ? 1 : 0;
	a1 = (1 < nL) ? 1 : 0;
	a2 = (2 < nL) ? 1 : 0;
	a3 = (3 < nL) ? 1 : 0;
	a4 = (4 < nL) ? 1 : 0;
	a5 = (5 < nL) ? 1 : 0;
	a6 = (6 < nL) ? 1 : 0;
	a7 = (7 < nL) ? 1 : 0;
	a8 = (8 < nL) ? 1 : 0;
	a9 = (9 < nL) ? 1 : 0;
	a10 = (0 < nR) ? 1 : 0;
	a11 = (1 < nR) ? 1 : 0;
	a12 = (2 < nR) ? 1 : 0;
	a13 = (3 < nR) ? 1 : 0;
	a14 = (4 < nR) ? 1 : 0;
	a15 = (5 < nR) ? 1 : 0;
	a16 = (6 < nR) ? 1 : 0;
	a17 = (7 < nR) ? 1 : 0;
	a18 = (8 < nR) ? 1 : 0;
	a19 = (9 < nR) ? 1 : 0;

	preSamps = clip(predlyS, 0, 250) * sr / 1000;
	preSamps = clip(preSamps, 0, 48000);
	preL = preDL.read(preSamps, interp="linear");
	preR = preDR.read(preSamps, interp="linear");
	toneL = hp(lp(preL, lpCoef), hpCoef);
	toneR = hp(lp(preR, lpCoef), hpCoef);
	aL = allpass(toneL, apT0, apG0);
	aL = allpass(aL, apT1, apG1);
	aL = allpass(aL, apT2, apG2);
	aL = allpass(aL, apT3, apG3);
	aR = allpass(toneR, apT0, apG0);
	aR = allpass(aR, apT1, apG1);
	aR = allpass(aR, apT2, apG2);
	aR = allpass(aR, apT3, apG3);
	injL = aL * invL;
	injR = aR * invR;
	m0, m1, m2, m3, m4, m5, m6, m7, m8, m9 = house(o0, o1, o2, o3, o4, o5, o6, o7, o8, o9, nL, modelI, hc, hs, kkL);
	m10, m11, m12, m13, m14, m15, m16, m17, m18, m19 = house(o10, o11, o12, o13, o14, o15, o16, o17, o18, o19, nR, modelI, hc, hs, kkR);
	x0 = cth * m0 + sth * m10;
	x1 = cth * m1 + sth * m11;
	x2 = cth * m2 + sth * m12;
	x3 = cth * m3 + sth * m13;
	x4 = cth * m4 + sth * m14;
	x5 = cth * m5 + sth * m15;
	x6 = cth * m6 + sth * m16;
	x7 = cth * m7 + sth * m17;
	x8 = cth * m8 + sth * m18;
	x9 = cth * m9 + sth * m19;
	x10 = -sth * m0 + cth * m10;
	x11 = -sth * m1 + cth * m11;
	x12 = -sth * m2 + cth * m12;
	x13 = -sth * m3 + cth * m13;
	x14 = -sth * m4 + cth * m14;
	x15 = -sth * m5 + cth * m15;
	x16 = -sth * m6 + cth * m16;
	x17 = -sth * m7 + cth * m17;
	x18 = -sth * m8 + cth * m18;
	x19 = -sth * m9 + cth * m19;
	z0 = a0 * (clip(x0, -2, 2) * g0 * duckG + injL);
	z1 = a1 * (clip(x1, -2, 2) * g1 * duckG + injL);
	z2 = a2 * (clip(x2, -2, 2) * g2 * duckG + injL);
	z3 = a3 * (clip(x3, -2, 2) * g3 * duckG + injL);
	z4 = a4 * (clip(x4, -2, 2) * g4 * duckG + injL);
	z5 = a5 * (clip(x5, -2, 2) * g5 * duckG + injL);
	z6 = a6 * (clip(x6, -2, 2) * g6 * duckG + injL);
	z7 = a7 * (clip(x7, -2, 2) * g7 * duckG + injL);
	z8 = a8 * (clip(x8, -2, 2) * g8 * duckG + injL);
	z9 = a9 * (clip(x9, -2, 2) * g9 * duckG + injL);
	z10 = a10 * (clip(x10, -2, 2) * g10 * duckG + injR);
	z11 = a11 * (clip(x11, -2, 2) * g11 * duckG + injR);
	z12 = a12 * (clip(x12, -2, 2) * g12 * duckG + injR);
	z13 = a13 * (clip(x13, -2, 2) * g13 * duckG + injR);
	z14 = a14 * (clip(x14, -2, 2) * g14 * duckG + injR);
	z15 = a15 * (clip(x15, -2, 2) * g15 * duckG + injR);
	z16 = a16 * (clip(x16, -2, 2) * g16 * duckG + injR);
	z17 = a17 * (clip(x17, -2, 2) * g17 * duckG + injR);
	z18 = a18 * (clip(x18, -2, 2) * g18 * duckG + injR);
	z19 = a19 * (clip(x19, -2, 2) * g19 * duckG + injR);
	del0.write(z0);
	del1.write(z1);
	del2.write(z2);
	del3.write(z3);
	del4.write(z4);
	del5.write(z5);
	del6.write(z6);
	del7.write(z7);
	del8.write(z8);
	del9.write(z9);
	del10.write(z10);
	del11.write(z11);
	del12.write(z12);
	del13.write(z13);
	del14.write(z14);
	del15.write(z15);
	del16.write(z16);
	del17.write(z17);
	del18.write(z18);
	del19.write(z19);
	o0 = lp(del0.read(t0, interp="linear") * a0, c0);
	o1 = lp(del1.read(t1, interp="linear") * a1, c1);
	o2 = lp(del2.read(t2, interp="linear") * a2, c2);
	o3 = lp(del3.read(t3, interp="linear") * a3, c3);
	o4 = lp(del4.read(t4, interp="linear") * a4, c4);
	o5 = lp(del5.read(t5, interp="linear") * a5, c5);
	o6 = lp(del6.read(t6, interp="linear") * a6, c6);
	o7 = lp(del7.read(t7, interp="linear") * a7, c7);
	o8 = lp(del8.read(t8, interp="linear") * a8, c8);
	o9 = lp(del9.read(t9, interp="linear") * a9, c9);
	o10 = lp(del10.read(t10, interp="linear") * a10, c10);
	o11 = lp(del11.read(t11, interp="linear") * a11, c11);
	o12 = lp(del12.read(t12, interp="linear") * a12, c12);
	o13 = lp(del13.read(t13, interp="linear") * a13, c13);
	o14 = lp(del14.read(t14, interp="linear") * a14, c14);
	o15 = lp(del15.read(t15, interp="linear") * a15, c15);
	o16 = lp(del16.read(t16, interp="linear") * a16, c16);
	o17 = lp(del17.read(t17, interp="linear") * a17, c17);
	o18 = lp(del18.read(t18, interp="linear") * a18, c18);
	o19 = lp(del19.read(t19, interp="linear") * a19, c19);
	env0 = follow(o0);
	env1 = follow(o1);
	env2 = follow(o2);
	env3 = follow(o3);
	env4 = follow(o4);
	env5 = follow(o5);
	env6 = follow(o6);
	env7 = follow(o7);
	env8 = follow(o8);
	env9 = follow(o9);
	env10 = follow(o10);
	env11 = follow(o11);
	env12 = follow(o12);
	env13 = follow(o13);
	env14 = follow(o14);
	env15 = follow(o15);
	env16 = follow(o16);
	env17 = follow(o17);
	env18 = follow(o18);
	env19 = follow(o19);
	tankE = env0 + env1 + env2 + env3 + env4 + env5 + env6 + env7 + env8 + env9 + env10 + env11 + env12 + env13 + env14 + env15 + env16 + env17 + env18 + env19;
	sumL = (o0 + o1 + o2 + o3 + o4 + o5 + o6 + o7 + o8 + o9) * invL;
	sumR = (o10 + o11 + o12 + o13 + o14 + o15 + o16 + o17 + o18 + o19) * invR;
	mid = (sumL + sumR) * 0.5;
	side = (sumL - sumR) * 0.5 * clip(widthS, 0, 1);
	wetL = (mid + side) * duckG;
	wetR = (mid - side) * duckG;
} else {
	o0 = 0;
	o1 = 0;
	o2 = 0;
	o3 = 0;
	o4 = 0;
	o5 = 0;
	o6 = 0;
	o7 = 0;
	o8 = 0;
	o9 = 0;
	o10 = 0;
	o11 = 0;
	o12 = 0;
	o13 = 0;
	o14 = 0;
	o15 = 0;
	o16 = 0;
	o17 = 0;
	o18 = 0;
	o19 = 0;
}
if (wetS != cWet) {
	cWet = wetS;
	ang = clip(wetS, 0, 1) * 1.57079632679;
	dryG = cos(ang);
	wetG = sin(ang);
}
out1 = fixnan(in1 * dryG + wetL * wetG);
out2 = fixnan(in2 * dryG + wetR * wetG);

tick = wrap(tick + 1, 0, 32);
if (tick == 0) {
	idleCount = ((inAbs > 1e-7) || (tankE > 1e-7)) ? 0 : idleCount;
	awake = ((inAbs > 1e-7) || (tankE > 1e-7)) ? 1 : ((idleCount > 32768) ? 0 : awake);
	frame = wrap(frame + 1, 0, 1024);
	poke(meters, frame, 20, 0);
	poke(meters, env0, 0, 0);
	poke(meters, env1, 1, 0);
	poke(meters, env2, 2, 0);
	poke(meters, env3, 3, 0);
	poke(meters, env4, 4, 0);
	poke(meters, env5, 5, 0);
	poke(meters, env6, 6, 0);
	poke(meters, env7, 7, 0);
	poke(meters, env8, 8, 0);
	poke(meters, env9, 9, 0);
	poke(meters, env10, 10, 0);
	poke(meters, env11, 11, 0);
	poke(meters, env12, 12, 0);
	poke(meters, env13, 13, 0);
	poke(meters, env14, 14, 0);
	poke(meters, env15, 15, 0);
	poke(meters, env16, 16, 0);
	poke(meters, env17, 17, 0);
	poke(meters, env18, 18, 0);
	poke(meters, env19, 19, 0);
}
