// Tiny Space reverb core (GenExpr for gen.codebox~)
// in1 = L audio, in2 = R audio
// in3 = size, in4 = damp, in5 = width, in6 = mix, in7 = feedback
// in8 = freeze, in9 = predelay, in10 = ingain, in11 = outgain
// in12 = hp, in13 = lp, in14 = mod, in15 = crossfeed
// out1 = L out, out2 = R out
// out3..out22 = per-line meters (post-damping)
// Buffer cfg = [activeCount, len0..19, char0..19]

Buffer cfg(`#0-tsconfig`);

Data linesL(4800, 20);
Data linesR(4800, 20);
Data wptrL(20);
Data wptrR(20);
Data dampStateL(20);
Data dampStateR(20);
Data meters(20);

History modPhase(0);
History apBufL(0);
History apBufR(0);
History apWptrL(0);
History apWptrR(0);
History pdBufL(0);
History pdBufR(0);
History pdWptrL(0);
History pdWptrR(0);

// smoother histories
History sizeS(0.5);
History dampS(0.5);
History widthS(1.0);
History mixS(0.5);
History fbS(0.5);
History crossS(0.3);
History modS(0.0);
History hpS(0.0);
History lpS(1.0);
History ingainS(1.0);
History outgainS(1.0);
History predelayS(0.1);

// allpass delay buffer
Data apDelayL(32);
Data apDelayR(32);

// predelay buffer
Data pdDelayL(2400);
Data pdDelayR(2400);

// ---- config ----
activeCount = peek(cfg, 0);
if (activeCount < 1) activeCount = 10;
if (activeCount > 20) activeCount = 20;

// ---- smooth controls ----
sizeS = sizeS + (in3 - sizeS) * 0.002;
dampS = dampS + (in4 - dampS) * 0.002;
widthS = widthS + (in5 - widthS) * 0.002;
mixS = mixS + (in6 - mixS) * 0.002;
fbS = fbS + (in7 - fbS) * 0.002;
crossS = crossS + (in15 - crossS) * 0.002;
modS = modS + (in14 - modS) * 0.002;
hpS = hpS + (in12 - hpS) * 0.002;
lpS = lpS + (in13 - lpS) * 0.002;
ingainS = ingainS + (in10 - ingainS) * 0.002;
outgainS = outgainS + (in11 - outgainS) * 0.002;
predelayS = predelayS + (in9 - predelayS) * 0.002;
freezeV = in8;

sizeV = sizeS;
dampV = dampS;
widthV = widthS;
mixV = mixS;
fbV = fbS;
crossV = crossS;
modV = modS;
hpV = hpS;
lpV = lpS;
ingainV = ingainS;
outgainV = outgainS;
predelayV = predelayS;

// ---- input gain ----
inL = in1 * ingainV;
inR = in2 * ingainV;

// ---- HP / LP (one-pole) ----
// lowpass state
History lpStateL(0);
History lpStateR(0);
History hpStateL(0);
History hpStateR(0);
lpCoeff = 0.01 + lpV * 0.98;
hpCoeff = hpV * 0.5;
lpStateL = lpStateL + (inL - lpStateL) * lpCoeff;
lpStateR = lpStateR + (inR - lpStateR) * lpCoeff;
hpL = inL - lpStateL * hpCoeff;
hpR = inR - lpStateR * hpCoeff;
filtL = hpL;
filtR = hpR;

// ---- input allpass diffusion ----
g = 0.5;
apDelay = 12;
// L
apInL = filtL;
apIdxL = apWptrL;
apReadL = apIdxL - apDelay;
if (apReadL < 0) apReadL = apReadL + 32;
apXprevL = peek(apDelayL, apReadL);
apYnewL = -g * apInL + apXprevL + g * apBufL;
poke(apDelayL, apInL, apIdxL);
apBufL = apYnewL;
apWptrL = apWptrL + 1;
if (apWptrL >= 32) apWptrL = 0;
diffL = apYnewL;

// R
apInR = filtR;
apIdxR = apWptrR;
apReadR = apIdxR - apDelay;
if (apReadR < 0) apReadR = apReadR + 32;
apXprevR = peek(apDelayR, apReadR);
apYnewR = -g * apInR + apXprevR + g * apBufR;
poke(apDelayR, apInR, apIdxR);
apBufR = apYnewR;
apWptrR = apWptrR + 1;
if (apWptrR >= 32) apWptrR = 0;
diffR = apYnewR;

// ---- predelay ----
pdSamps = predelayV * 2400.0;
if (pdSamps < 1.0) pdSamps = 1.0;
if (pdSamps > 2390.0) pdSamps = 2390.0;
// L
pdWpL = pdWptrL;
pdRpL = pdWpL - pdSamps;
if (pdRpL < 0) pdRpL = pdRpL + 2400.0;
pdRp0L = floor(pdRpL);
pdRp1L = pdRp0L + 1;
if (pdRp1L >= 2400.0) pdRp1L = 0;
pdFracL = pdRpL - pdRp0L;
pdY0L = peek(pdDelayL, pdRp0L);
pdY1L = peek(pdDelayL, pdRp1L);
pdOutL = pdY0L * (1.0 - pdFracL) + pdY1L * pdFracL;
poke(pdDelayL, diffL, pdWpL);
pdWptrL = pdWpL + 1;
if (pdWptrL >= 2400.0) pdWptrL = 0;
// R
pdWpR = pdWptrR;
pdRpR = pdWpR - pdSamps;
if (pdRpR < 0) pdRpR = pdRpR + 2400.0;
pdRp0R = floor(pdRpR);
pdRp1R = pdRp0R + 1;
if (pdRp1R >= 2400.0) pdRp1R = 0;
pdFracR = pdRpR - pdRp0R;
pdY0R = peek(pdDelayR, pdRp0R);
pdY1R = peek(pdDelayR, pdRp1R);
pdOutR = pdY0R * (1.0 - pdFracR) + pdY1R * pdFracR;
poke(pdDelayR, diffR, pdWpR);
pdWptrR = pdWpR + 1;
if (pdWptrR >= 2400.0) pdWptrR = 0;

// ---- mod LFO ----
modPhase = modPhase + 1.0 / 48000.0 * 0.3;
if (modPhase >= 1.0) modPhase = modPhase - 1.0;
modLfo = sin(modPhase * 6.2831853);

// ---- FDN: 20 lines ----
sumL = 0;
sumR = 0;
for (i = 0; i < 20; i += 1) {
    lenNorm = peek(cfg, 1 + i);
    charV = peek(cfg, 21 + i);
    active = (i < activeCount) ? 1 : 0;

    // delay time
    baseMs = 1.0 + charV * 49.0;
    delayMs = baseMs * sizeV;
    delaySamps = delayMs * 48.0;
    if (delaySamps < 1.0) delaySamps = 1.0;
    if (delaySamps > 4790.0) delaySamps = 4790.0;

    // damping
    dampK = 0.1 + dampV * 0.85 + (charV - 0.5) * 0.1;
    if (dampK < 0.01) dampK = 0.01;
    if (dampK > 0.99) dampK = 0.99;

    // feedback gain (clamped below 1.0 to prevent infinite ringing)
    fbGain = fbV * (0.8 + charV * 0.4);
    if (fbGain > 0.95) fbGain = 0.95;
    if (freezeV > 0.5) fbGain = 0.995;

    // mod
    lineMod = modLfo * modV * (0.5 + charV * 0.5) * delaySamps * 0.02;

    isLeft = (i < 10) ? 1 : 0;
    inputV = isLeft ? pdOutL : pdOutR;

    // crossfeed: add opposite side contribution
    // (approximated: add crossV * (sum of opposite) * 0.05)
    // We'll handle crossfeed by adding crossV * inputV * 0.1 for right->left coupling
    // Simplified: crossfeed adds crossV * (isLeft ? pdOutR : pdOutL) * 0.1
    crossTerm = crossV * (isLeft ? pdOutR : pdOutL) * 0.1;
    inputV = inputV + crossTerm;

    // read position (fractional)
    if (isLeft) {
        wp = peek(wptrL, i);
        rp = wp - delaySamps + lineMod;
        if (rp < 0) rp = rp + 4800.0;
        if (rp >= 4800.0) rp = rp - 4800.0;
        rp0 = floor(rp);
        rp1 = rp0 + 1;
        if (rp1 >= 4800.0) rp1 = 0;
        frac = rp - rp0;
        y0 = peek(linesL, rp0, i);
        y1 = peek(linesL, rp1, i);
        outLine = y0 * (1.0 - frac) + y1 * frac;

        ds = peek(dampStateL, i);
        d = outLine * (1.0 - dampK) + ds * dampK;
        poke(dampStateL, d, i);

        fbTerm = d * fbGain;
        poke(linesL, inputV + fbTerm, wp, i);

        wpNew = wp + 1;
        if (wpNew >= 4800.0) wpNew = 0;
        poke(wptrL, wpNew, i);
    } else {
        ii = i - 10;
        wp = peek(wptrR, ii);
        rp = wp - delaySamps + lineMod;
        if (rp < 0) rp = rp + 4800.0;
        if (rp >= 4800.0) rp = rp - 4800.0;
        rp0 = floor(rp);
        rp1 = rp0 + 1;
        if (rp1 >= 4800.0) rp1 = 0;
        frac = rp - rp0;
        y0 = peek(linesR, rp0, ii);
        y1 = peek(linesR, rp1, ii);
        outLine = y0 * (1.0 - frac) + y1 * frac;

        ds = peek(dampStateR, ii);
        d = outLine * (1.0 - dampK) + ds * dampK;
        poke(dampStateR, d, ii);

        fbTerm = d * fbGain;
        poke(linesR, inputV + fbTerm, wp, ii);

        wpNew = wp + 1;
        if (wpNew >= 4800.0) wpNew = 0;
        poke(wptrR, wpNew, ii);
    }

    if (active < 1) {
        d = 0;
        poke(meters, 0, i);
    } else {
        poke(meters, d, i);
    }

    if (isLeft) {
        sumL = sumL + d;
    } else {
        sumR = sumR + d;
    }
}

// ---- width (M/S) ----
mid = (sumL + sumR) * 0.5;
side = (sumL - sumR) * 0.5;
wetL = mid + side * widthV;
wetR = mid - side * widthV;

// ---- dry/wet mix ----
outL = in1 * (1.0 - mixV) + wetL * mixV;
outR = in2 * (1.0 - mixV) + wetR * mixV;

// ---- output gain ----
out1 = outL * outgainV;
out2 = outR * outgainV;

// ---- meters ----
out3 = peek(meters, 0);
out4 = peek(meters, 1);
out5 = peek(meters, 2);
out6 = peek(meters, 3);
out7 = peek(meters, 4);
out8 = peek(meters, 5);
out9 = peek(meters, 6);
out10 = peek(meters, 7);
out11 = peek(meters, 8);
out12 = peek(meters, 9);
out13 = peek(meters, 10);
out14 = peek(meters, 11);
out15 = peek(meters, 12);
out16 = peek(meters, 13);
out17 = peek(meters, 14);
out18 = peek(meters, 15);
out19 = peek(meters, 16);
out20 = peek(meters, 17);
out21 = peek(meters, 18);
out22 = peek(meters, 19);
