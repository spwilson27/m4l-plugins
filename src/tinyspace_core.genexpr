// Tiny Space — 20-line feedback delay network.
// Config buffer (buffer~ #0-tsconfig), indices match src/tinyspace_config.js:
//   0 activeCount, 1 character,
//   2..5 allpass lengths (ms), 6..9 allpass gains,
//   10..29 nominal delay (ms), 30..49 damp offset, 50..69 mod Hz.
// Meter buffer (buffer~ #0-tsmeters) is one envelope per line.
// GenExpr rejects the old delay operator. Each line is declared with Delay, then written
// and read as a tap. Tank and pre-delay lines are 65536 samples, longer than
// the longest tap plus a signal vector, so a short comb keeps recirculating.
// Full feedback holds a line to about -60 dB in 80 seconds (see ringGain).
// Short combs stay bright: delay taps are whole samples, and Damp 0 does not
// lowpass the loop, so a small Size rings as a metallic tone instead of a thud.
// The coefficient depends on that line's delay so short combs do not die
// in a fraction of a second. It is clipped just under 1, so the tail ends.
// Every room mix is orthogonal and keeps the all-ones mode at magnitude 1,
// and crossfeed is a rotation, so neither one shortens that tail.
// GenExpr requires every function to appear before Buffer, Param, and assignments.

slew(target, coef) {
	History s(0);
	History init(0);
	s = (init == 0) ? target : mix(target, s, coef);
	init = 1;
	return s;
}

lfo(hz) {
	History ph(0);
	ph = wrap(ph + hz / samplerate, 0, 1);
	return sin(ph * 6.283185307179586);
}

lp(x, coef) {
	History s(0);
	s = mix(x, s, coef);
	return s;
}

hp(x, coef) {
	History s(0);
	s = mix(x, s, coef);
	return x - s;
}

// Schroeder allpass. Delay holds the samples; History holds the previous tap
// so the feedback coefficient is applied to a delayed sample.
// g near 0 (comb seeds) is a short delay of about t samples.
allpass(x, t, g) {
	Delay line(4096);
	History mem(0);
	y = -g * x + mem;
	line.write(x + g * y);
	mem = line.read(clip(t, 1, 4000), interp="linear");
	return y;
}

lineTime(lenMs, lfoVal, sizeNow, modNow) {
	sc = 0.22 + clip(sizeNow, 0, 1) * 1.93;
	base = clip(lenMs * sc * samplerate / 1000, 1, 16000);
	depth = min(base * 0.28, samplerate * 0.0012) * clip(modNow, 0, 1);
	// Whole-sample taps. Linear interpolation would shave a little high end
	// off every pass, and a 1 ms comb passes often enough that the tone dies.
	return round(clip(base + lfoVal * depth, 1, 16000));
}

follow(x) {
	History s(0);
	ax = abs(x);
	s = mix(ax, s, (ax > s) ? 0.45 : 0.992);
	return s;
}

// fbk 1 reaches about -60 dB after 80 seconds. A 1-sample comb needs a gain
// extremely close to 1 to last that long, so the ceiling sits just under 1.
// fbk 0 does not recirculate. The denominator is never zero, so a feedback
// of 0 cannot fall through into a gain of 1.
ringGain(delaySamps, fbkNow) {
	k = clip(fbkNow, 0, 1);
	secs = max(delaySamps, 1) / samplerate;
	rt = max(k * 80, 0.05);
	g = exp(-6.90775527898 * secs / rt);
	quiet = (k < 0.001) ? 0 : g;
	return clip(quiet, 0, 0.9999995);
}

// One-pole pole for a loop of delaySamps. Damp 0 leaves the comb bright.
// The bright partials then fade over a time set by the knob, not by how
// many times a short line happens to recirculate.
dampCoef(delaySamps, dampNow, offset) {
	amt = clip(dampNow, 0, 1) * (1 + clip(offset, 0, 0.35));
	amt = clip(amt, 0, 1);
	tau = 0.15 / max(amt * amt, 0.00001);
	T = max(delaySamps, 1) / samplerate;
	bright = exp(-T / tau);
	pole = (1 - bright) / max(1 + bright, 0.001);
	return clip(pole, 0, 0.995);
}

// Parallel combs (character 0) blended into a per-side Householder mix (character 1),
// plus selectable room topologies (3 = PLATE, 4 = TANK, 5 = BOX, 6 = SPRING, 7 = BOUNCE).
house(o0, o1, o2, o3, o4, o5, o6, o7, o8, o9, n, character, model) {
	sum = o0 + o1 + o2 + o3 + o4 + o5 + o6 + o7 + o8 + o9;
	k = 2 / max(n, 1);

	// Standard Comb <-> Householder blend (models 0..2, 6, 7)
	h0 = (0 < n) ? mix(o0, o0 - sum * k, character) : 0;
	h1 = (1 < n) ? mix(o1, o1 - sum * k, character) : 0;
	h2 = (2 < n) ? mix(o2, o2 - sum * k, character) : 0;
	h3 = (3 < n) ? mix(o3, o3 - sum * k, character) : 0;
	h4 = (4 < n) ? mix(o4, o4 - sum * k, character) : 0;
	h5 = (5 < n) ? mix(o5, o5 - sum * k, character) : 0;
	h6 = (6 < n) ? mix(o6, o6 - sum * k, character) : 0;
	h7 = (7 < n) ? mix(o7, o7 - sum * k, character) : 0;
	h8 = (8 < n) ? mix(o8, o8 - sum * k, character) : 0;
	h9 = (9 < n) ? mix(o9, o9 - sum * k, character) : 0;

	// PLATE (model 3): Hadamard-style parity + Householder reflection
	alt = o0 - o1 + o2 - o3 + o4 - o5 + o6 - o7 + o8 - o9;
	p0 = (0 < n) ? ((o0 - sum * k) * 0.72 + (o1 - alt * k * 0.5) * 0.28) : 0;
	p1 = (1 < n) ? ((o1 - sum * k) * 0.72 - (o0 - alt * k * 0.5) * 0.28) : 0;
	p2 = (2 < n) ? ((o2 - sum * k) * 0.72 + (o3 - alt * k * 0.5) * 0.28) : 0;
	p3 = (3 < n) ? ((o3 - sum * k) * 0.72 - (o2 - alt * k * 0.5) * 0.28) : 0;
	p4 = (4 < n) ? ((o4 - sum * k) * 0.72 + (o5 - alt * k * 0.5) * 0.28) : 0;
	p5 = (5 < n) ? ((o5 - sum * k) * 0.72 - (o4 - alt * k * 0.5) * 0.28) : 0;
	p6 = (6 < n) ? ((o6 - sum * k) * 0.72 + (o7 - alt * k * 0.5) * 0.28) : 0;
	p7 = (7 < n) ? ((o7 - sum * k) * 0.72 - (o6 - alt * k * 0.5) * 0.28) : 0;
	p8 = (8 < n) ? ((o8 - sum * k) * 0.72 + (o9 - alt * k * 0.5) * 0.28) : 0;
	p9 = (9 < n) ? ((o9 - sum * k) * 0.72 - (o8 - alt * k * 0.5) * 0.28) : 0;

	// TANK (model 4): Dattorro-style daisy-chained ring loop across active lines
	last = (n <= 2) ? o1 : ((n <= 3) ? o2 : ((n <= 4) ? o3 : ((n <= 5) ? o4 : ((n <= 6) ? o5 : ((n <= 7) ? o6 : ((n <= 8) ? o7 : ((n <= 9) ? o8 : o9)))))));
	r0 = (0 < n) ? (last * 0.84 + h0 * 0.16) : 0;
	r1 = (1 < n) ? (-o0  * 0.84 + h1 * 0.16) : 0;
	r2 = (2 < n) ? (o1   * 0.84 + h2 * 0.16) : 0;
	r3 = (3 < n) ? (-o2  * 0.84 + h3 * 0.16) : 0;
	r4 = (4 < n) ? (o3   * 0.84 + h4 * 0.16) : 0;
	r5 = (5 < n) ? (-o4  * 0.84 + h5 * 0.16) : 0;
	r6 = (6 < n) ? (o5   * 0.84 + h6 * 0.16) : 0;
	r7 = (7 < n) ? (-o6  * 0.84 + h7 * 0.16) : 0;
	r8 = (8 < n) ? (o7   * 0.84 + h8 * 0.16) : 0;
	r9 = (9 < n) ? (-o8  * 0.84 + h9 * 0.16) : 0;

	// BOX (model 5): 3D Shoebox phase-inverted wall boundary reflections
	b0 = -h0;
	b1 =  h1;
	b2 = -h2;
	b3 =  h3;
	b4 = -h4;
	b5 =  h5;
	b6 = -h6;
	b7 =  h7;
	b8 = -h8;
	b9 =  h9;

	isPlate = (model == 3);
	isTank  = (model == 4);
	isBox   = (model == 5);

	m0 = isPlate ? p0 : (isTank ? r0 : (isBox ? b0 : h0));
	m1 = isPlate ? p1 : (isTank ? r1 : (isBox ? b1 : h1));
	m2 = isPlate ? p2 : (isTank ? r2 : (isBox ? b2 : h2));
	m3 = isPlate ? p3 : (isTank ? r3 : (isBox ? b3 : h3));
	m4 = isPlate ? p4 : (isTank ? r4 : (isBox ? b4 : h4));
	m5 = isPlate ? p5 : (isTank ? r5 : (isBox ? b5 : h5));
	m6 = isPlate ? p6 : (isTank ? r6 : (isBox ? b6 : h6));
	m7 = isPlate ? p7 : (isTank ? r7 : (isBox ? b7 : h7));
	m8 = isPlate ? p8 : (isTank ? r8 : (isBox ? b8 : h8));
	m9 = isPlate ? p9 : (isTank ? r9 : (isBox ? b9 : h9));
	return m0, m1, m2, m3, m4, m5, m6, m7, m8, m9;
}

Buffer cfg("tsconfig");
Buffer meters("tsmeters");

Param size(0.45);
Param damp(0.2);
Param width(0.7);
Param wet(0.35);
Param fbk(0.4);
Param predly(0);
Param modamt(0.15);
Param xfeed(0.25);
Param hp(40);
Param lp(14000);
Param duck(1);
History tick(0);
History o0(0);
History o1(0);
History o2(0);
History o3(0);
History o4(0);
History o5(0);
History o6(0);
History o7(0);
History o8(0);
History o9(0);
History o10(0);
History o11(0);
History o12(0);
History o13(0);
History o14(0);
History o15(0);
History o16(0);
History o17(0);
History o18(0);
History o19(0);
Delay preDL(65536);
Delay preDR(65536);
Delay del0(65536);
Delay del1(65536);
Delay del2(65536);
Delay del3(65536);
Delay del4(65536);
Delay del5(65536);
Delay del6(65536);
Delay del7(65536);
Delay del8(65536);
Delay del9(65536);
Delay del10(65536);
Delay del11(65536);
Delay del12(65536);
Delay del13(65536);
Delay del14(65536);
Delay del15(65536);
Delay del16(65536);
Delay del17(65536);
Delay del18(65536);
Delay del19(65536);

sizeS = slew(size, 0.9992);
dampS = slew(damp, 0.9992);
widthS = slew(width, 0.9992);
wetS = slew(wet, 0.9992);
fbkS = slew(fbk, 0.9992);
predlyS = slew(predly, 0.9992);
modS = slew(modamt, 0.9992);
xfeedS = slew(xfeed, 0.9992);
hpS = slew(hp, 0.9992);
lpS = slew(lp, 0.9992);

activeCount = peek(cfg, 0);
character = clip(peek(cfg, 1), 0, 1);
model = round(clip(peek(cfg, 70), 0, 7));
nL = activeCount * 0.5;
nR = nL;
sr = max(samplerate, 1);
duckG = clip(duck, 0, 1);

preSamps = clip(predlyS, 0, 250) * sr / 1000;
preSamps = clip(preSamps, 0, 48000);
preDL.write(in1);
preDR.write(in2);
preL = preDL.read(preSamps, interp="linear");
preR = preDR.read(preSamps, interp="linear");

lpCoef = exp(-6.28318530718 * clip(lpS, 400, 18000) / sr);
hpCoef = exp(-6.28318530718 * clip(hpS, 20, 4000) / sr);
toneL = hp(lp(preL, lpCoef), hpCoef);
toneR = hp(lp(preR, lpCoef), hpCoef);

apT0 = clip(peek(cfg, 2) * sr / 1000, 1, sr * 0.02);
apT1 = clip(peek(cfg, 3) * sr / 1000, 1, sr * 0.02);
apT2 = clip(peek(cfg, 4) * sr / 1000, 1, sr * 0.02);
apT3 = clip(peek(cfg, 5) * sr / 1000, 1, sr * 0.02);
apG0 = clip(peek(cfg, 6), 0, 0.7);
apG1 = clip(peek(cfg, 7), 0, 0.7);
apG2 = clip(peek(cfg, 8), 0, 0.7);
apG3 = clip(peek(cfg, 9), 0, 0.7);
aL = allpass(toneL, apT0, apG0);
aL = allpass(aL, apT1, apG1);
aL = allpass(aL, apT2, apG2);
aL = allpass(aL, apT3, apG3);
aR = allpass(toneR, apT0, apG0);
aR = allpass(aR, apT1, apG1);
aR = allpass(aR, apT2, apG2);
aR = allpass(aR, apT3, apG3);

invL = 1 / sqrt(max(nL, 1));
invR = 1 / sqrt(max(nR, 1));
injL = aL * invL;
injR = aR * invR;

lfo0 = lfo(peek(cfg, 50));
lfo1 = lfo(peek(cfg, 51));
lfo2 = lfo(peek(cfg, 52));
lfo3 = lfo(peek(cfg, 53));
lfo4 = lfo(peek(cfg, 54));
lfo5 = lfo(peek(cfg, 55));
lfo6 = lfo(peek(cfg, 56));
lfo7 = lfo(peek(cfg, 57));
lfo8 = lfo(peek(cfg, 58));
lfo9 = lfo(peek(cfg, 59));
lfo10 = lfo(peek(cfg, 60));
lfo11 = lfo(peek(cfg, 61));
lfo12 = lfo(peek(cfg, 62));
lfo13 = lfo(peek(cfg, 63));
lfo14 = lfo(peek(cfg, 64));
lfo15 = lfo(peek(cfg, 65));
lfo16 = lfo(peek(cfg, 66));
lfo17 = lfo(peek(cfg, 67));
lfo18 = lfo(peek(cfg, 68));
lfo19 = lfo(peek(cfg, 69));

t0 = lineTime(peek(cfg, 10), lfo0, sizeS, modS);
t1 = lineTime(peek(cfg, 11), lfo1, sizeS, modS);
t2 = lineTime(peek(cfg, 12), lfo2, sizeS, modS);
t3 = lineTime(peek(cfg, 13), lfo3, sizeS, modS);
t4 = lineTime(peek(cfg, 14), lfo4, sizeS, modS);
t5 = lineTime(peek(cfg, 15), lfo5, sizeS, modS);
t6 = lineTime(peek(cfg, 16), lfo6, sizeS, modS);
t7 = lineTime(peek(cfg, 17), lfo7, sizeS, modS);
t8 = lineTime(peek(cfg, 18), lfo8, sizeS, modS);
t9 = lineTime(peek(cfg, 19), lfo9, sizeS, modS);
t10 = lineTime(peek(cfg, 20), lfo10, sizeS, modS);
t11 = lineTime(peek(cfg, 21), lfo11, sizeS, modS);
t12 = lineTime(peek(cfg, 22), lfo12, sizeS, modS);
t13 = lineTime(peek(cfg, 23), lfo13, sizeS, modS);
t14 = lineTime(peek(cfg, 24), lfo14, sizeS, modS);
t15 = lineTime(peek(cfg, 25), lfo15, sizeS, modS);
t16 = lineTime(peek(cfg, 26), lfo16, sizeS, modS);
t17 = lineTime(peek(cfg, 27), lfo17, sizeS, modS);
t18 = lineTime(peek(cfg, 28), lfo18, sizeS, modS);
t19 = lineTime(peek(cfg, 29), lfo19, sizeS, modS);

m0, m1, m2, m3, m4, m5, m6, m7, m8, m9 = house(o0, o1, o2, o3, o4, o5, o6, o7, o8, o9, nL, character, model);
m10, m11, m12, m13, m14, m15, m16, m17, m18, m19 = house(o10, o11, o12, o13, o14, o15, o16, o17, o18, o19, nR, character, model);

xf = clip(xfeedS, 0, 1);
x0 = m0 * (1 - xf) + m10 * xf;
x1 = m1 * (1 - xf) + m11 * xf;
x2 = m2 * (1 - xf) + m12 * xf;
x3 = m3 * (1 - xf) + m13 * xf;
x4 = m4 * (1 - xf) + m14 * xf;
x5 = m5 * (1 - xf) + m15 * xf;
x6 = m6 * (1 - xf) + m16 * xf;
x7 = m7 * (1 - xf) + m17 * xf;
x8 = m8 * (1 - xf) + m18 * xf;
x9 = m9 * (1 - xf) + m19 * xf;
x10 = m10 * (1 - xf) + m0 * xf;
x11 = m11 * (1 - xf) + m1 * xf;
x12 = m12 * (1 - xf) + m2 * xf;
x13 = m13 * (1 - xf) + m3 * xf;
x14 = m14 * (1 - xf) + m4 * xf;
x15 = m15 * (1 - xf) + m5 * xf;
x16 = m16 * (1 - xf) + m6 * xf;
x17 = m17 * (1 - xf) + m7 * xf;
x18 = m18 * (1 - xf) + m8 * xf;
x19 = m19 * (1 - xf) + m9 * xf;

c0 = dampCoef(t0, dampS, peek(cfg, 30));
c1 = dampCoef(t1, dampS, peek(cfg, 31));
c2 = dampCoef(t2, dampS, peek(cfg, 32));
c3 = dampCoef(t3, dampS, peek(cfg, 33));
c4 = dampCoef(t4, dampS, peek(cfg, 34));
c5 = dampCoef(t5, dampS, peek(cfg, 35));
c6 = dampCoef(t6, dampS, peek(cfg, 36));
c7 = dampCoef(t7, dampS, peek(cfg, 37));
c8 = dampCoef(t8, dampS, peek(cfg, 38));
c9 = dampCoef(t9, dampS, peek(cfg, 39));
c10 = dampCoef(t10, dampS, peek(cfg, 40));
c11 = dampCoef(t11, dampS, peek(cfg, 41));
c12 = dampCoef(t12, dampS, peek(cfg, 42));
c13 = dampCoef(t13, dampS, peek(cfg, 43));
c14 = dampCoef(t14, dampS, peek(cfg, 44));
c15 = dampCoef(t15, dampS, peek(cfg, 45));
c16 = dampCoef(t16, dampS, peek(cfg, 46));
c17 = dampCoef(t17, dampS, peek(cfg, 47));
c18 = dampCoef(t18, dampS, peek(cfg, 48));
c19 = dampCoef(t19, dampS, peek(cfg, 49));

d0 = lp(x0, c0);
d1 = lp(x1, c1);
d2 = lp(x2, c2);
d3 = lp(x3, c3);
d4 = lp(x4, c4);
d5 = lp(x5, c5);
d6 = lp(x6, c6);
d7 = lp(x7, c7);
d8 = lp(x8, c8);
d9 = lp(x9, c9);
d10 = lp(x10, c10);
d11 = lp(x11, c11);
d12 = lp(x12, c12);
d13 = lp(x13, c13);
d14 = lp(x14, c14);
d15 = lp(x15, c15);
d16 = lp(x16, c16);
d17 = lp(x17, c17);
d18 = lp(x18, c18);
d19 = lp(x19, c19);

a0 = (0 < nL) ? 1 : 0;
a1 = (1 < nL) ? 1 : 0;
a2 = (2 < nL) ? 1 : 0;
a3 = (3 < nL) ? 1 : 0;
a4 = (4 < nL) ? 1 : 0;
a5 = (5 < nL) ? 1 : 0;
a6 = (6 < nL) ? 1 : 0;
a7 = (7 < nL) ? 1 : 0;
a8 = (8 < nL) ? 1 : 0;
a9 = (9 < nL) ? 1 : 0;
a10 = (0 < nR) ? 1 : 0;
a11 = (1 < nR) ? 1 : 0;
a12 = (2 < nR) ? 1 : 0;
a13 = (3 < nR) ? 1 : 0;
a14 = (4 < nR) ? 1 : 0;
a15 = (5 < nR) ? 1 : 0;
a16 = (6 < nR) ? 1 : 0;
a17 = (7 < nR) ? 1 : 0;
a18 = (8 < nR) ? 1 : 0;
a19 = (9 < nR) ? 1 : 0;

// Per-line loop gain. Short lines need a higher coefficient to ring as long.
g0 = ringGain(t0, fbkS);
z0 = a0 * (clip(d0, -2, 2) * g0 * duckG + injL);
g1 = ringGain(t1, fbkS);
z1 = a1 * (clip(d1, -2, 2) * g1 * duckG + injL);
g2 = ringGain(t2, fbkS);
z2 = a2 * (clip(d2, -2, 2) * g2 * duckG + injL);
g3 = ringGain(t3, fbkS);
z3 = a3 * (clip(d3, -2, 2) * g3 * duckG + injL);
g4 = ringGain(t4, fbkS);
z4 = a4 * (clip(d4, -2, 2) * g4 * duckG + injL);
g5 = ringGain(t5, fbkS);
z5 = a5 * (clip(d5, -2, 2) * g5 * duckG + injL);
g6 = ringGain(t6, fbkS);
z6 = a6 * (clip(d6, -2, 2) * g6 * duckG + injL);
g7 = ringGain(t7, fbkS);
z7 = a7 * (clip(d7, -2, 2) * g7 * duckG + injL);
g8 = ringGain(t8, fbkS);
z8 = a8 * (clip(d8, -2, 2) * g8 * duckG + injL);
g9 = ringGain(t9, fbkS);
z9 = a9 * (clip(d9, -2, 2) * g9 * duckG + injL);
g10 = ringGain(t10, fbkS);
z10 = a10 * (clip(d10, -2, 2) * g10 * duckG + injR);
g11 = ringGain(t11, fbkS);
z11 = a11 * (clip(d11, -2, 2) * g11 * duckG + injR);
g12 = ringGain(t12, fbkS);
z12 = a12 * (clip(d12, -2, 2) * g12 * duckG + injR);
g13 = ringGain(t13, fbkS);
z13 = a13 * (clip(d13, -2, 2) * g13 * duckG + injR);
g14 = ringGain(t14, fbkS);
z14 = a14 * (clip(d14, -2, 2) * g14 * duckG + injR);
g15 = ringGain(t15, fbkS);
z15 = a15 * (clip(d15, -2, 2) * g15 * duckG + injR);
g16 = ringGain(t16, fbkS);
z16 = a16 * (clip(d16, -2, 2) * g16 * duckG + injR);
g17 = ringGain(t17, fbkS);
z17 = a17 * (clip(d17, -2, 2) * g17 * duckG + injR);
g18 = ringGain(t18, fbkS);
z18 = a18 * (clip(d18, -2, 2) * g18 * duckG + injR);
g19 = ringGain(t19, fbkS);
z19 = a19 * (clip(d19, -2, 2) * g19 * duckG + injR);

del0.write(z0);
del1.write(z1);
del2.write(z2);
del3.write(z3);
del4.write(z4);
del5.write(z5);
del6.write(z6);
del7.write(z7);
del8.write(z8);
del9.write(z9);
del10.write(z10);
del11.write(z11);
del12.write(z12);
del13.write(z13);
del14.write(z14);
del15.write(z15);
del16.write(z16);
del17.write(z17);
del18.write(z18);
del19.write(z19);
o0 = del0.read(t0, interp="linear") * a0;
o1 = del1.read(t1, interp="linear") * a1;
o2 = del2.read(t2, interp="linear") * a2;
o3 = del3.read(t3, interp="linear") * a3;
o4 = del4.read(t4, interp="linear") * a4;
o5 = del5.read(t5, interp="linear") * a5;
o6 = del6.read(t6, interp="linear") * a6;
