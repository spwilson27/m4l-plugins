// spectral_split_mida.genexpr — amplitude-only Mid analysis for the Spectral Split devices that never read the Mid phase (Loud Split, Freq Split).
// Same as ss_mid (src/spectral_split_lib.genexpr) without the atan2 per bin: ms row 1 (phase) is NOT written (stays 0). Included through the
// device's libs (scripts/spectral_common.py gen_code_rack(libs=...)) only where used, because gen charges compile time for every function.
ss_mida(fx, ms, n) {
	half = n * 0.5;
	sc = 4 / n;
	for (k = 0; k <= half; k += 1) {
		k2 = k == 0 ? 0 : n - k;
		ar = fx.peek(k, 0);
		ai = fx.peek(k, 1);
		br = fx.peek(k2, 0);
		bi = 0 - fx.peek(k2, 1);
		xr = ((ar + ai) + (br - bi)) * 0.25;
		xi = ((ai - ar) + (bi + br)) * 0.25;
		ms.poke(sqrt(xr * xr + xi * xi) * sc, k, 0);
	}
	return half;
}
