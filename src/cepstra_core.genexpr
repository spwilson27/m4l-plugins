// Cepstra — true cepstral formant shifter (STFT overlap-add, M/S, Hann/Hann, 75% overlap).
//
// Buffer (bound on loadbang via `scope ---cepscope`), 272 samples:
//   0..191   : signed Mid cepstrum c[n] on 192 LINEAR quefrency columns, n = 0 .. 20 ms (largest |c| per column, 9999 = beyond N/2)
//   256      : current lifter cutoff L in samples
//   257      : f0 estimate in Hz (0 = unvoiced / unknown)
//   258      : input level (linear peak, 0 while asleep)
//   259      : rolling frame counter
//   260      : FFT size N
//   261      : voiced flag
//   262      : resmode in use
//   263      : Ceps-gate threshold for Mid in |c| units (0 when the cepstral gate is inactive)
//   264      : alive counter. Slots 0..263 are unchanged. This one increments every hop, including silence sleep,
//              so a deferred gen~ on a quiet track still shows that it is running.
//
// Frame work (about 71 jobs per frame at 4k) is time-sliced across the first half of each hop, so no single
// sample runs more than one FFT pass. Packed-FFT trick: Mid + j*Side share one complex FFT, and because
// both log-spectra / cepstra are real and symmetric, the same packing carries them through every stage.
// Latency = N + N/8 samples (dry path is delayed by the same amount).
//
// GenExpr rules strictly enforced:
//   - All functions appear before Buffer, Data, Param, History, and expression statements.
//   - No identifier is named e<digit> (Euler's constant lexer bug).

// In-place radix-2 DIT pass `s` (1..log2 n) over bit-reversed input. sgn = +1 forward, -1 inverse (unscaled).
fft_pass(re, im, twr, twi, n, s, sgn) {
	hlf = pow(2, s - 1);
	blk = hlf * 2;
	tstep = 4096 / blk;
	nb = n * 0.5;
	invHlf = 1 / hlf;
	for (b = 0; b < nb; b += 1) {
		grp = floor(b * invHlf);
		j = b - grp * hlf;
		i0 = grp * blk + j;
		i1 = i0 + hlf;
		tIdx = j * tstep;
		wr = peek(twr, tIdx);
		wi = sgn * peek(twi, tIdx);
		ar = peek(re, i0);
		ai = peek(im, i0);
		br = peek(re, i1);
		bi = peek(im, i1);
		tr = br * wr - bi * wi;
		tm = br * wi + bi * wr;
		poke(re, ar - tr, i1);
		poke(im, ai - tm, i1);
		poke(re, ar + tr, i0);
		poke(im, ai + tm, i0);
	}
	return 0;
}

// One-time tables: twiddles exp(-2*pi*i*k/4096) for k = 0..2048 and the 12-bit bit-reversal table.
init_tables(twr, twi, brv) {
	for (k = 0; k <= 2048; k += 1) {
		a = 6.28318530718 * k / 4096;
		poke(twr, cos(a), k);
		poke(twi, 0 - sin(a), k);
	}
	for (i = 0; i < 4096; i += 1) {
		t = i;
		r = 0;
		for (q = 0; q < 12; q += 1) {
			r = r * 2 + (t % 2);
			t = floor(t / 2);
		}
		poke(brv, r, i);
	}
	return 0;
}

clear_rings(ra, rb) {
	for (i = 0; i < 8192; i += 1) {
		poke(ra, 0, i);
		poke(rb, 0, i);
	}
	return 0;
}

// Job: Hann-window the last n samples of Mid (real) and Side (imag), writing bit-reversed for the forward FFT.
job_capture(xre, xim, inM, inS, brv, twr, n, stride, capPos) {
	nh = n * 0.5;
	for (i = 0; i < n; i += 1) {
		ci = (i <= nh) ? i : (n - i);
		w = 0.5 - 0.5 * peek(twr, ci * stride);
		src = wrap(capPos - n + i, 0, 8192);
		r = floor(peek(brv, i) / stride);
		poke(xre, w * peek(inM, src), r);
		poke(xim, w * peek(inS, src), r);
	}
	return 0;
}

// Job: logmag[k] = log(|X[k]| + 1e-9) for Mid and Side (separated from the packed FFT).
// Stores them natural-order (lre/lim, kept for the harmonic split) and bit-reversed (wre/wim) for the cepstrum IFFT.
job_logmag(xre, xim, lre, lim, wre, wim, brv, n, stride, part, nparts) {
	nh = n * 0.5;
	k0 = floor((nh + 1) * part / nparts);
	k1 = floor((nh + 1) * (part + 1) / nparts);
	invStride = 1 / stride;
	for (k = k0; k < k1; k += 1) {
		kk = (n - k) % n;
		ar = peek(xre, k);
		ai = peek(xim, k);
		br = peek(xre, kk);
		bi = peek(xim, kk);
		mr = 0.5 * (ar + br);
		mi = 0.5 * (ai - bi);
		sr = 0.5 * (ai + bi);
		si = 0.5 * (br - ar);
		lm = log(sqrt(mr * mr + mi * mi) + 0.000000001);
		ls = log(sqrt(sr * sr + si * si) + 0.000000001);
		poke(lre, lm, k);
		poke(lre, lm, kk);
		poke(lim, ls, k);
		poke(lim, ls, kk);
		r1 = floor(peek(brv, k) * invStride);
		r2 = floor(peek(brv, kk) * invStride);
		poke(wre, lm, r1);
		poke(wre, lm, r2);
		poke(wim, ls, r1);
		poke(wim, ls, r2);
	}
	return 0;
}

// Job: cutoff quefrency L (Manual / Auto f0 / MIDI note), then lifter the Mid+Side cepstra into ere/eim (bit-reversed).
// State lives in stat[]: 0 = L smoothed, 1 = f0 Hz, 2 = voiced, 4 = held target L.
job_lift(wre, wim, ere, eim, brv, stat, n, stride, srVal, modeNow, res01, midiNote) {
	invN = 1.0 / n;
	nh = n * 0.5;
	r01 = clip(res01, 0, 1);
	kscale = 0.3 + 0.7 * r01;
	held = peek(stat, 4);
	f0v = peek(stat, 1);
	voiced = 0;
	if (modeNow < 0.5) {
		held = 0.0003 * pow(50, r01) * srVal;
		f0v = 0;
	} else if (modeNow < 1.5) {
		qlo = max(floor(srVal * 0.001), 4);
		qhi = min(floor(srVal / 60), nh - 3);
		best = 0;
		bestQ = 0;
		yL = 0;
		yR = 0;
		prv = peek(wre, qlo - 1) * invN;
		cur = peek(wre, qlo) * invN;
		for (q = qlo; q <= qhi; q += 1) {
			nxt = peek(wre, q + 1) * invN;
			isPk = (cur > prv) && (cur >= nxt);
			if (isPk && (cur > best)) {
				best = cur;
				bestQ = q;
				yL = prv;
				yR = nxt;
			}
			prv = cur;
			cur = nxt;
		}
		if (best > 0.06) {
			den = yL - 2 * best + yR;
			dl = (abs(den) > 0.0000001) ? (0.5 * (yL - yR) / den) : 0;
			period = bestQ + clip(dl, -0.5, 0.5);
			held = kscale * period;
			f0v = srVal / period;
			voiced = 1;
		} else {
			f0v = 0;
		}
	} else {
		if (midiNote >= 0) {
			period = srVal / (440 * pow(2, (midiNote - 69) / 12));
			held = kscale * period;
			f0v = srVal / period;
			voiced = 1;
		} else {
			f0v = 0;
		}
	}
	poke(stat, held, 4);
	sm = peek(stat, 0);
	sm = sm + 0.4 * (held - sm);
	lc = clip(sm, 2, nh - 4);
	poke(stat, sm, 0);
	poke(stat, lc, 3);
	poke(stat, f0v, 1);
	poke(stat, voiced, 2);

	tw = clip(lc * 0.25, 2, 6);
	invTw = 1 / tw;
	piInvTw = 3.14159265359 * invTw;
	lcEdge = lc - tw;
	invStride = 1 / stride;
	for (i = 0; i < n; i += 1) {
		q2 = (i <= nh) ? i : (n - i);
		wgt = 0;
		if (q2 < lc) {
			wgt = 1;
			if (q2 > lcEdge) {
				wgt = 0.5 + 0.5 * cos(piInvTw * (q2 - lcEdge));
			}
		}
		r = floor(peek(brv, i) * invStride);
		poke(ere, wgt * peek(wre, i) * invN, r);
		poke(eim, wgt * peek(wim, i) * invN, r);
	}
	return 0;
}

// Linear interpolation of a real, symmetric log-envelope at fractional bin kf (held flat above Nyquist).
interp_env(arr, kf, nh) {
	kc = clip(kf, 0, nh);
	i0 = floor(kc);
	i1 = min(i0 + 1, nh);
	fr = kc - i0;
	return mix(peek(arr, i0), peek(arr, i1), fr);
}

// Harmonic gate on the fine structure h (nepers above the envelope).
// bias = range + 0.6 and invK = 1 / 1.2 are constant for a Gate value (filled when Gate changes, not per bin).
// range = 8 + 40 * (1 - g)^3 dB: 48 dB (barely acts) at 0+, ~17 dB at 40%, 8 dB at 100%.
// depth 0 is the bypass. No early return: GenExpr falls through a `return` inside an `if` block.
gate_h(h, p, bias, invK, depth) {
	t = clip((h - p + bias) * invK, 0, 1);
	g = t * t * (3 - 2 * t);
	return h - (1 - g) * depth;
}

// Job (Gate Mode = Ceps, Gate > 0): gate the HARMONIC cepstrum coefficients (|n| >= L, kept symmetric). The threshold is
// Gate * (frame peak |c| in the harmonic region, smoothed across frames). The gated harmonic cepstrum
// c_h = c * (1 - lifter) is written bit-reversed into hre/him for the FFT that rebuilds the harmonic log-spectrum.
// Ceps gate = voicing-keyed gate. Pitchedness v = (largest Mid cepstral peak in max(L, 1 ms)..1/60 s) / (RMS of the
// same region): about 3-4.5 for noise at any level, about 9 for noisy voicing, about 16 for a clean vowel. Frames with
// v below Tv = 3.5 + 11*Gate (3.5 .. 14.5, soft knee +/-1) are attenuated by up to 60 dB on both channels
// (stereo-linked), smoothed across frames (open 0.7, close 0.25), so unpitched content (breaths, hiss, noise) is gated
// while pitched content passes.
// stat[5] = 0 (the harmonic-FFT slots stay idle), stat[6] = openness 0..1, stat[8] = Tv * RMS (display threshold
// in |c| units), stat[9] = log gain applied in job_spec.
job_cgate(wre, stat, n, gate01, srVal) {
	// gate01 is already 0 unless Gate Mode = Ceps (decided at the call site).
	// if / else, not an early return: GenExpr falls through a `return` inside an `if` block.
	poke(stat, 0, 5);
	if (gate01 <= 0.0005) {
		poke(stat, 1, 6);
		poke(stat, 0, 8);
		poke(stat, 0, 9);
	} else {
		invN = 1.0 / n;
		nh = n * 0.5;
		lc = peek(stat, 3);
		qlo = max(ceil(lc), floor(srVal / 1000));
		qhi = min(nh - 2, floor(srVal / 60));
		pk = 0;
		ss = 0;
		cnt = 0;
		for (i = qlo; i <= qhi; i += 1) {
			cv = peek(wre, i);
			pk = max(pk, cv);
			ss = ss + cv * cv;
			cnt = cnt + 1;
		}
		invCnt = 1 / max(cnt, 1);
		pk = pk * invN;
		rms = sqrt(ss * invN * invN * invCnt + 0.00000000000000000001);
		vv = pk / rms;
		tv = 3.5 + 11 * gate01;
		t = clip((vv - tv + 1) / 2, 0, 1);
		tgt = t * t * (3 - 2 * t);
		op = peek(stat, 6);
		op = op + (tgt - op) * ((tgt > op) ? 0.7 : 0.25);
		poke(stat, op, 6);
		poke(stat, tv * rms, 8);
		poke(stat, -(1 - op) * 6.9 * clip(gate01 * 10, 0, 1), 9);
	}
	return 0;
}

// Job: formant shift + harmonic gate, original phase, written bit-reversed for the synthesis IFFT.
job_spec(xre, xim, lre, lim, ere, eim, hre, him, ore, oim, brv, stat, n, stride, part, nparts, iRM, iRS, gate01, bias, invK, depth, idM, idS) {
	cg = peek(stat, 5);
	nh = n * 0.5;
	// Shift 0: k * iRM is the integer bin, and interp_env of an integer is that bin. Spec gate off:
	// gate_h returns its input. Using the bin itself is the same magnitude the full path would produce.
	plain = (idM > 0.5) && (idS > 0.5) && (gate01 <= 0.0005) && (cg < 0.5);
	invStride = 1 / stride;
	// Part 0, Spec gate: peak envelope P[k] = max_j (H[j] - d |k - j|) of the fine structure (two O(N) passes),
	// d = 1 neper per half harmonic spacing implied by the lifter (W = N / 2L). Stored in hre (Mid) / him (Side),
	// which only the Ceps gate uses otherwise.
	if ((part == 0) && (cg < 0.5) && (gate01 > 0.0005)) {
		dd = 1 / max(1, 0.5 * n / max(peek(stat, 3), 2));
		runM = -1000;
		runS = -1000;
		for (k = 0; k <= nh; k += 1) {
			runM = max(peek(lre, k) - peek(ere, k), runM - dd);
			runS = max(peek(lim, k) - peek(eim, k), runS - dd);
			poke(hre, runM, k);
			poke(him, runS, k);
		}
		runM = -1000;
		runS = -1000;
		for (k = nh; k >= 0; k -= 1) {
			runM = max(peek(lre, k) - peek(ere, k), runM - dd);
			runS = max(peek(lim, k) - peek(eim, k), runS - dd);
			poke(hre, max(peek(hre, k), runM), k);
			poke(him, max(peek(him, k), runS), k);
		}
	}
	vg = peek(stat, 9);
	k0 = floor((nh + 1) * part / nparts);
	k1 = floor((nh + 1) * (part + 1) / nparts);
	for (k = k0; k < k1; k += 1) {
		kk = (n - k) % n;
		ar = peek(xre, k);
		ai = peek(xim, k);
		br = peek(xre, kk);
		bi = peek(xim, kk);
		mr = 0.5 * (ar + br);
		mi = 0.5 * (ai - bi);
		sr = 0.5 * (ai + bi);
		si = 0.5 * (br - ar);
		am = sqrt(mr * mr + mi * mi);
		asv = sqrt(sr * sr + si * si);
		pmr = (am > 0.000000000001) ? (mr / am) : 1;
		pmi = (am > 0.000000000001) ? (mi / am) : 0;
		psr = (asv > 0.000000000001) ? (sr / asv) : 1;
		psi = (asv > 0.000000000001) ? (si / asv) : 0;

		lm = peek(lre, k);
		ls = peek(lim, k);
		emv = peek(ere, k);
		esv = peek(eim, k);
		epm = emv;
		eps = esv;
		hm = lm - emv;
		hs = ls - esv;
		if (!plain) {
			epm = (idM > 0.5) ? emv : interp_env(ere, k * iRM, nh);
			eps = (idS > 0.5) ? esv : interp_env(eim, k * iRS, nh);
			hm = (cg > 0.5) ? peek(hre, k) : ((gate01 > 0.0005) ? gate_h(lm - emv, peek(hre, k), bias, invK, depth) : (lm - emv));
			hs = (cg > 0.5) ? peek(him, k) : ((gate01 > 0.0005) ? gate_h(ls - esv, peek(him, k), bias, invK, depth) : (ls - esv));
		}
		omv = clip(epm + hm + vg, -21, 12);
		osv = clip(eps + hs + vg, -21, 12);
		magM = exp(omv);
		magS = exp(osv);
		ymr = magM * pmr;
		ymi = magM * pmi;
		ysr = magS * psr;
		ysi = magS * psi;
		if ((k == 0) || (k == nh)) {
			ymi = 0;
			ysi = 0;
		}
		r1 = floor(peek(brv, k) * invStride);
		r2 = floor(peek(brv, kk) * invStride);
		poke(ore, ymr - ysi, r1);
		poke(oim, ymi + ysr, r1);
		poke(ore, ymr + ysi, r2);
		poke(oim, ysr - ymi, r2);
	}
	return 0;
}

// Job: signed Mid cepstrum c[n] on a LINEAR quefrency axis, 192 columns covering n = 0 .. 20 ms.
// A column spanning several bins keeps the bin with the largest |c| and its sign (pitch peaks survive).
// Columns at or beyond N/2 (the 1k setting) write the sentinel 9999.
job_tele(wre, scope, stat, n, srVal, levelIn, frameNo, modeNow) {
	nh = n * 0.5;
	invN = 1.0 / n;
	qmax = 0.02 * srVal;
	qScale = qmax / 192;
	for (b = 0; b < 192; b += 1) {
		qlo = b * qScale;
		qhi = qlo + qScale;
		k0 = floor(qlo);
		k1 = max(k0, ceil(qhi) - 1);
		v = 9999;
		if (k0 < nh - 1) {
			best = 0;
			k1c = min(k1, nh - 2);
			for (k = k0; k <= k1c; k += 1) {
				cv = peek(wre, k);
				if (abs(cv) > abs(best)) {
					best = cv;
				}
			}
			v = best * invN;
		}
		poke(scope, v, b, 0);
	}
	poke(scope, peek(stat, 3), 256, 0);
	poke(scope, peek(stat, 1), 257, 0);
	poke(scope, levelIn, 258, 0);
	poke(scope, frameNo, 259, 0);
	poke(scope, n, 260, 0);
	poke(scope, peek(stat, 2), 261, 0);
	poke(scope, modeNow, 262, 0);
	poke(scope, peek(stat, 8), 263, 0);
	return 0;
}

// Job: synthesis Hann window and overlap-add into the Mid / Side output rings (Hann^2 at 75% overlap = 1.5).
job_ola(ore, oim, oM, oS, twr, n, stride, outStart) {
	nh = n * 0.5;
	scl = 1.0 / (n * 1.5);
	for (i = 0; i < n; i += 1) {
		ci = (i <= nh) ? i : (n - i);
		w = (0.5 - 0.5 * peek(twr, ci * stride)) * scl;
		pos = wrap(outStart + i, 0, 8192);
		poke(oM, peek(oM, pos) + w * peek(ore, i), pos);
		poke(oS, peek(oS, pos) + w * peek(oim, i), pos);
	}
	return 0;
}

Buffer scope("cepscope");

Data inM(8192);
Data inS(8192);
Data dryL(8192);
Data dryR(8192);
Data oM(8192);
Data oS(8192);
Data xre(4096);
Data xim(4096);
Data lre(4096);
Data lim(4096);
Data wre(4096);
Data wim(4096);
Data ere(4096);
Data eim(4096);
Data hre(4096);
Data him(4096);
Data ore(4096);
Data oim(4096);
Data twr(2049);
Data twi(2049);
Data brv(4096);
Data stat(16);

Param res(0.57);
Param midshift(0.0);
Param sideshift(0.0);
Param gate(0.0);
Param resmode(0);
Param quality(1);
Param wet(1.0);
Param midinote(-1);
Param gatemode(0);

History initDone(0);
History nCur(0);
History llog(11);
History stride(2);
History hopN(512);
History wLat(256);
History ltot(2304);
History jobCount(54);
History spacing(4);
History hopCtr(0);
History jobId(54);
History jobWait(0);
History wp(0);
History capPos(0);
History outStart(0);
History quietCount(0);
History levelPk(0);
History frameNo(0);
History muteCnt(0);
History sleepNote(0);
History tick(0);
History dryG(0.0);
History wetG(1.0);
History wetSm(1.0);
History wetLast(1);
History ratM(1);
History ratS(1);
History invRatM(1);
History invRatS(1);
History gateSpec(0);
History specBias(0);
History specInv(0.833333333333);
History specDepth(0);
History midHeld(0);
History sideHeld(0);
History gateHeld(0);
History gmodeHeld(0);
History alive(0);

sr = max(samplerate, 1);

if (initDone == 0) {
	init_tables(twr, twi, brv);
	poke(stat, 100, 0);
	poke(stat, 100, 4);
	initDone = 1;
}

// Quality (FFT size) change: abort jobs, clear the overlap-add rings, brief mute then fade-in.
qIdx = round(clip(quality, 0, 2));
nWant = 1024 * pow(2, qIdx);
if (nWant != nCur) {
	nCur = nWant;
	llog = 10 + qIdx;
	stride = 4096 / nWant;
	hopN = nWant * 0.25;
	wLat = nWant * 0.125;
	ltot = nWant + wLat;
	jobCount = 5 * llog + 11;
	// one job runs every (spacing + 1) samples, so all jobs finish inside the N/8 latency window
	spacing = max(0, floor((wLat - 2) / jobCount) - 1);
	hopCtr = 0;
	jobId = jobCount;
	jobWait = 0;
	clear_rings(oM, oS);
	muteCnt = ltot + 3 * hopN + 256;
}

// Shift ratios and the spec-gate knee depend only on the knobs. pow / the 8+40*(1-g)^3 range run when they change.
if ((midshift != midHeld) || (sideshift != sideHeld) || (gate != gateHeld) || (gatemode != gmodeHeld)) {
	midHeld = midshift;
	sideHeld = sideshift;
	gateHeld = gate;
	gmodeHeld = gatemode;
	ratM = pow(2, midshift / 12);
	ratS = pow(2, sideshift / 12);
	invRatM = 1 / ratM;
	invRatS = 1 / ratS;
	gateSpec = (gatemode > 0.5) ? 0 : clip(gate, 0, 1);
	om = 1 - gateSpec;
	specRng = (8 + 40 * om * om * om) / 8.685889638;
	specKn = 0.6;
	specBias = specRng + specKn;
	specInv = 1 / (2 * specKn);
	specDepth = (gateSpec > 0.0005) ? 6.9 * clip(gateSpec * 10, 0, 1) : 0;
}

// Equal-power dry/wet. cos/sin only while Mix is still moving; a parked Mix keeps the cached gains.
if (tick == 0) {
	wetNow = clip(wet, 0, 1);
	if (wetNow != wetSm) {
		wetSm = wetSm + 0.05 * (wetNow - wetSm);
		ang = wetSm * 1.57079632679;
		dryG = cos(ang);
		wetG = sin(ang);
	}
}
tick = wrap(tick + 1, 0, 16);

// Read the finished output sample, then record the new input.
yM = peek(oM, wp);
yS = peek(oS, wp);
poke(oM, 0, wp);
poke(oS, 0, wp);
dL = peek(dryL, wrap(wp - ltot, 0, 8192));
dR = peek(dryR, wrap(wp - ltot, 0, 8192));
poke(inM, (in1 + in2) * 0.5, wp);
poke(inS, (in1 - in2) * 0.5, wp);
poke(dryL, in1, wp);
poke(dryR, in2, wp);
wp = wrap(wp + 1, 0, 8192);

// Silence sleep gate: input below -100 dB for a whole frame skips all FFT work.
inAbs = max(abs(in1), abs(in2));
loud = (inAbs > 0.00001) ? 1 : 0;
quietCount = (loud > 0) ? 0 : min(quietCount + 1, 100000000);
levelPk = max(inAbs, levelPk * 0.9995);

hopCtr = hopCtr + 1;
if (hopCtr >= hopN) {
	hopCtr = 0;
	alive = wrap(alive + 1, 0, 16777216);
	poke(scope, alive, 264, 0);
	if (quietCount < nCur) {
		if (jobId >= jobCount) {
			jobId = 0;
			jobWait = 0;
			capPos = wp;
			outStart = wrap(wp + wLat, 0, 8192);
			frameNo = wrap(frameNo + 1, 0, 100000);
		}
		sleepNote = 0;
	} else {
		if (sleepNote == 0) {
			poke(scope, 0, 258, 0);
			poke(scope, 0, 257, 0);
			sleepNote = 1;
		}
	}
}

// Time-sliced frame pipeline
if (jobId < jobCount) {
	if (jobWait <= 0) {
		j = jobId;
		if (j == 0) {
			job_capture(xre, xim, inM, inS, brv, twr, nCur, stride, capPos);
		} else if (j <= llog) {
			fft_pass(xre, xim, twr, twi, nCur, j, 1);
		} else if (j <= llog + 2) {
			job_logmag(xre, xim, lre, lim, wre, wim, brv, nCur, stride, j - llog - 1, 2);
		} else if (j <= 2 * llog + 2) {
			fft_pass(wre, wim, twr, twi, nCur, j - llog - 2, -1);
		} else if (j == 2 * llog + 3) {
			job_lift(wre, wim, ere, eim, brv, stat, nCur, stride, sr, resmode, res, midinote);
		} else if (j <= 3 * llog + 3) {
			fft_pass(ere, eim, twr, twi, nCur, j - 2 * llog - 3, 1);
		} else if (j == 3 * llog + 4) {
			job_cgate(wre, stat, nCur, (gatemode > 0.5) ? clip(gate, 0, 1) : 0, sr);
		} else if (j <= 4 * llog + 4) {
			if (peek(stat, 5) > 0.5) {
				fft_pass(hre, him, twr, twi, nCur, j - 3 * llog - 4, 1);
			}
		} else if (j <= 4 * llog + 8) {
			job_spec(xre, xim, lre, lim, ere, eim, hre, him, ore, oim, brv, stat, nCur, stride, j - 4 * llog - 5, 4, invRatM, invRatS, gateSpec, specBias, specInv, specDepth, (midshift == 0) ? 1 : 0, (sideshift == 0) ? 1 : 0);
		} else if (j == 4 * llog + 9) {
			job_tele(wre, scope, stat, nCur, sr, levelPk, frameNo, resmode);
		} else if (j <= 5 * llog + 9) {
			fft_pass(ore, oim, twr, twi, nCur, j - 4 * llog - 9, -1);
		} else {
			job_ola(ore, oim, oM, oS, twr, nCur, stride, outStart);
		}
		jobId = jobId + 1;
		jobWait = spacing;
	} else {
		jobWait = jobWait - 1;
	}
}

wetL = yM + yS;
wetR = yM - yS;
outL = dL * dryG + wetL * wetG;
outR = dR * dryG + wetR * wetG;

// Quality-switch mute with a 256-sample fade-in
outGain = 1;
if (muteCnt > 0) {
	outGain = (muteCnt > 256) ? 0 : (1 - muteCnt / 256);
	muteCnt = muteCnt - 1;
}

out1 = fixnan(fixdenorm(outL * outGain));
out2 = fixnan(fixdenorm(outR * outGain));
